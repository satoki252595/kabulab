&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblR" style="orphans:0;widows:0;"&gt;普通株式&lt;/p&gt;&lt;p class="smt_tblR" style="orphans:0;widows:0;"&gt;9,000&lt;/p&gt;&lt;p class="smt_tblR" style="orphans:0;widows:0;"&gt;Ａ種優先株式&lt;/p&gt;&lt;p class="smt_tblR" style="orphans:0;widows:0;"&gt;7,812&lt;/p&gt;
&lt;/td&gt;
