&lt;td style="vertical-align: top; width: 287.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 3.3333333333333333333333333333px; text-align: left"&gt;
&lt;span style="font-size: 12px"&gt; &lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td colspan="2" style="vertical-align: top; width: 150.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt;前連結会計年度&lt;/p&gt;
&lt;p style="margin-right: 12px; text-align: center"&gt;（自　2022年４月１日&lt;/p&gt;
