&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 240.46666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 6.6px; padding-right: 6.6px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 1; text-align: center"&gt;種類&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
