&lt;td style="vertical-align:bottom;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="bottom"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;"&gt;（特別口座）&lt;/p&gt;
