&lt;col style="width:45.4pt;min-width:45.4pt;"/&gt;
&lt;col style="width:60pt;min-width:60pt;"/&gt;
&lt;col style="width:57pt;min-width:57pt;"/&gt;
&lt;col style="width:57.8pt;min-width:57.8pt;"/&gt;
&lt;col style="width:77.3pt;min-width:77.3pt;"/&gt;
