&lt;td style="vertical-align: top; width: 74.666666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 16.666666666666666666666666667px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;2018年７月&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 165.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 5px; line-height: 16.666666666666666666666666667px; margin-right: 2px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;デロイトトーマツグループボード内エシックス委員会委員長&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td style="vertical-align: top; width: 74.666666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 16.666666666666666666666666667px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;2021年５月&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
