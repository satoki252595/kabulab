&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 180px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 1.3333333333333333333333333333px; line-height: 15px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;株式会社ルック社外取締役退任&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td style="vertical-align: top; width: 70px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 1.3333333333333333333333333333px; line-height: 15px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;2023年３月&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 180px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 1.3333333333333333333333333333px; line-height: 15px; margin-bottom: 5px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;当社監査役就任（現任）&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
