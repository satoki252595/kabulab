&lt;p class="MsoNormal" style="margin-right:44.0pt"&gt;&lt;span style="font-size:10.0pt; font-family:&amp;apos;ＭＳ 明朝&amp;apos;,serif"&gt; &lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width:127.6pt; border-top:solid windowtext 0.5pt; border-left:none; border-bottom:solid windowtext 0.5pt; border-right:none; padding:4.0pt 2.0pt 4.0pt 2.0pt"&gt;
