  <jpsps_cor:NotesToFinancialStatementsTextBlock contextRef="CurrentYearDuration" id="p103_002">
&lt;p style="margin:0pt; margin-bottom:.0001pt; line-height:125%"&gt;&lt;span style="line-height:125%; font-family:&amp;apos;ＭＳ 明朝&amp;apos;,serif"&gt;（３）【注記表】&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin:0pt; margin-bottom:.0001pt; line-height:125%"&gt;&lt;span style="font-size:10.0pt; line-height:125%; font-family:&amp;apos;ＭＳ 明朝&amp;apos;,serif"&gt;　&lt;br/&gt;
（重要な会計方針に係る事項に関する注記）&lt;/span&gt;&lt;/p&gt;
&lt;table border="0" cellpadding="0" cellspacing="0" style="width:495.0pt; border-collapse:collapse" width="660"&gt;
&lt;tr&gt;
&lt;td style="width:159.0pt; border:solid black 0.5pt; padding:0pt 0pt 0pt 0pt"&gt;
&lt;p style="margin:0pt; margin-bottom:.0001pt; text-align:right; "&gt;&lt;span style="font-size:9.0pt; font-family:&amp;apos;ＭＳ 明朝&amp;apos;,serif"&gt;期別&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin:0pt; margin-bottom:.0001pt"&gt;&lt;span style="font-size:9.0pt; font-family:&amp;apos;ＭＳ 明朝&amp;apos;,serif"&gt;項目&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width:336.0pt; border:solid black 0.5pt; border-left:none; padding:0pt 0pt 0pt 0pt"&gt;
&lt;p style="margin:0pt; margin-bottom:.0001pt; text-align:center; "&gt;&lt;span style="font-size:9.0pt; font-family:&amp;apos;ＭＳ 明朝&amp;apos;,serif"&gt;第12期&lt;br/&gt;
自 2022年10月 1日&lt;br/&gt;
至 2023年10月 2日&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td rowspan="2" style="width:159.0pt; border-top:none; border-left:solid black 0.5pt; border-bottom:none; border-right:solid black 0.5pt; padding:0pt 0pt 0pt 0pt" valign="top"&gt;
&lt;p style="margin-top:0pt; margin-right:0pt; margin-bottom:0pt; margin-left:15.0pt; margin-bottom:.0001pt; text-indent:-15.0pt"&gt;&lt;span style="font-size:9.0pt; font-family:&amp;apos;ＭＳ 明朝&amp;apos;,serif"&gt;１.有価証券の評価基準及び評価方法&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width:336.0pt; border:none; border-right:solid black 0.5pt; padding:0pt 0pt 0pt 0pt"&gt;
&lt;p style="margin:0pt; margin-bottom:.0001pt"&gt;&lt;span style="font-size:9.0pt; font-family:&amp;apos;ＭＳ 明朝&amp;apos;,serif"&gt;親投資信託受益証券&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td style="width:336.0pt; border:none; border-right:solid black 0.5pt; padding:0pt 0pt 0pt 0pt" valign="top"&gt;
&lt;p style="margin:0pt; margin-bottom:.0001pt"&gt;&lt;span style="font-size:9.0pt; font-family:&amp;apos;ＭＳ 明朝&amp;apos;,serif"&gt;移動平均法に基づき、原則として時価で評価しております。時価評価にあたっては、親投資信託受益証券の基準価額に基づいて評価しております。&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin:0pt; margin-bottom:.0001pt"&gt;&lt;span style="font-size:9.0pt; font-family:&amp;apos;ＭＳ 明朝&amp;apos;,serif"&gt; &lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
