&lt;/td&gt;
&lt;td style="width:81.0pt; border-top:none; border-left:none; border-bottom:solid black 0.5pt; border-right:solid black 0.5pt; padding:0pt 0pt 0pt 0pt; height:17.25pt"&gt;
