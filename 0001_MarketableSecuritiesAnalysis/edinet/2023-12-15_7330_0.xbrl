&lt;p class="MsoNormal" style="line-height:12.0pt; background:white"&gt;　&lt;/p&gt;
&lt;p class="MsoNormal" style="line-height:3.0pt; background:white"&gt;&lt;span style="font-size:10.5pt"&gt; &lt;/span&gt;&lt;/p&gt;
