&lt;/td&gt;
&lt;td style="width:56.7pt; border-top:none; border-left:none; border-bottom:solid windowtext 0.5pt; border-right:solid windowtext 0.5pt; padding:0pt 5.4pt 0pt 5.4pt"&gt;
&lt;p class="MsoNormal" style="text-align:center; line-height:14.5pt; "&gt;&lt;span style="font-size:10.0pt; font-family:&amp;apos;ＭＳ 明朝&amp;apos;,serif"&gt;レベル２&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width:56.7pt; border-top:none; border-left:none; border-bottom:solid windowtext 0.5pt; border-right:solid windowtext 0.5pt; padding:0pt 5.4pt 0pt 5.4pt"&gt;
&lt;p class="MsoNormal" style="text-align:center; line-height:14.5pt; "&gt;&lt;span style="font-size:10.0pt; font-family:&amp;apos;ＭＳ 明朝&amp;apos;,serif"&gt;レベル３&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width:56.7pt; border-top:none; border-left:none; border-bottom:solid windowtext 0.5pt; border-right:solid windowtext 0.5pt; padding:0pt 5.4pt 0pt 5.4pt"&gt;
&lt;p class="MsoNormal" style="text-align:center; line-height:14.5pt; "&gt;&lt;span style="font-size:10.0pt; font-family:&amp;apos;ＭＳ 明朝&amp;apos;,serif"&gt;合計&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:19.4pt"&gt;
&lt;td style="width:161.1pt; border-top:none; border-left:solid windowtext 0.5pt; border-bottom:none; border-right:solid windowtext 0.5pt; padding:0pt 5.4pt 0pt 5.4pt; height:19.4pt"&gt;
&lt;p class="MsoNormal" style="text-indent:10.0pt; line-height:14.5pt"&gt;&lt;span style="font-size:10.0pt; font-family:&amp;apos;ＭＳ 明朝&amp;apos;,serif"&gt;敷金&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
