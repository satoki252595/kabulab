&lt;td style="width:98.4pt; border-top:none; border-left:none; border-bottom:solid black 0.5pt; border-right:solid black 0.5pt; padding:3.0pt 2.0pt 3.0pt 2.0pt" valign="top"&gt;
&lt;p class="MsoNormal" style="text-align:right; layout-grid-mode:char; "&gt;&lt;span style="color:black; border:none white 0.5pt; padding:0pt"&gt;19,934,280,510&lt;/span&gt;&lt;/p&gt;
