&lt;/td&gt;
&lt;td style="width:104.85pt; border-top:none; border-left:none; border-bottom:solid black 0.5pt; border-right:solid black 0.5pt; padding:3.0pt 2.0pt 3.0pt 2.0pt" valign="top"&gt;
&lt;p class="MsoNormal" style="text-align:right; layout-grid-mode:char; "&gt;&lt;span style="color:black; border:none white 0.5pt; padding:0pt"&gt;23,824,400,259&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width:98.4pt; border-top:none; border-left:none; border-bottom:solid black 0.5pt; border-right:solid black 0.5pt; padding:3.0pt 2.0pt 3.0pt 2.0pt" valign="top"&gt;
&lt;p class="MsoNormal" style="text-align:right; layout-grid-mode:char; "&gt;&lt;span style="color:black; border:none white 0.5pt; padding:0pt"&gt;11,754,408,991&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td style="width:107.9pt; border:solid black 0.5pt; border-top:none; padding:3.0pt 2.0pt 3.0pt 2.0pt" valign="top"&gt;
&lt;p class="MsoNormal" style="text-align:center; layout-grid-mode:char"&gt;&lt;span style="color:black; border:none white 0.5pt; padding:0pt"&gt;第12期計算期間&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width:183.85pt; border-top:none; border-left:none; border-bottom:solid black 0.5pt; border-right:solid black 0.5pt; padding:3.0pt 2.0pt 3.0pt 2.0pt" valign="top"&gt;
&lt;p class="MsoNormal" style="text-align:center; layout-grid-mode:char"&gt;&lt;span style="color:black; border:none white 0.5pt; padding:0pt"&gt;2022&lt;/span&gt;&lt;span style="color:black; border:none white 0.5pt; padding:0pt"&gt;年10月 1日～2023年10月 2日&lt;/span&gt;&lt;/p&gt;
