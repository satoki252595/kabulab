&lt;td rowspan="2" style="width:159.0pt; border-top:none; border-left:solid black 0.5pt; border-bottom:none; border-right:solid black 0.5pt; padding:0pt 0pt 0pt 0pt" valign="top"&gt;
&lt;p style="margin-top:0pt; margin-right:0pt; margin-bottom:0pt; margin-left:15.0pt; margin-bottom:.0001pt; text-indent:-15.0pt"&gt;&lt;span style="font-size:9.0pt; font-family:&amp;apos;ＭＳ 明朝&amp;apos;,serif"&gt;２.収益及び費用の計上基準&lt;/span&gt;&lt;/p&gt;
