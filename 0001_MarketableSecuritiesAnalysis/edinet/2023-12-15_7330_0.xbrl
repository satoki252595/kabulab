&lt;/td&gt;
&lt;td colspan="2" style="width:222.8pt; border-top:none; border-left:none; border-bottom:solid windowtext 0.5pt; border-right:solid windowtext 0.5pt; padding:0pt 0pt 0pt 0pt"&gt;
&lt;p class="MsoNormal" style="margin-top:0pt; margin-right:4.5pt; margin-bottom:0pt; margin-left:4.5pt; margin-bottom:.0001pt; line-height:14.5pt"&gt;&lt;span style="font-family:&amp;apos;ＭＳ 明朝&amp;apos;,serif; color:black"&gt;ＳＢＩファイナンシャルサービシーズ（株）&lt;/span&gt;&lt;/p&gt;
