&lt;p style="margin-left: 96px; line-height: 6px; text-align: left"&gt; &lt;/p&gt;
&lt;p style="margin-left: 96px; text-align: left"&gt;上記の主な内訳は以下のとおりです。&lt;/p&gt;
&lt;div style="margin-left: 96px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 554.26666666666666666666666666px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 208px"/&gt;
&lt;col style="width: 173.13333333333333333333333333px"/&gt;
&lt;col style="width: 173.13333333333333333333333333px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr&gt;
&lt;td style="border-left: 0px none #000000; border-top: 1px solid #000000; border-right: 0px none #000000; border-bottom: 1px solid #000000; width: 208px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: left"&gt;
&lt;span style="font-size: 12px"&gt; &lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 0px none #000000; border-top: 1px solid #000000; border-right: 0px none #000000; border-bottom: 1px solid #000000; width: 173.13333333333333333333333333px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
