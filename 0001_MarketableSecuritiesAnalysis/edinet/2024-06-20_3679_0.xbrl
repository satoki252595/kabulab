&lt;col style="width:52.7pt;min-width:52.7pt;"/&gt;
&lt;col style="width:52.7pt;min-width:52.7pt;"/&gt;
&lt;col style="width:52.7pt;min-width:52.7pt;"/&gt;
&lt;col style="width:52.7pt;min-width:52.7pt;"/&gt;
