&lt;/td&gt;
&lt;td style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;line-height:13pt;font-size:13pt;"&gt; &lt;/p&gt;
&lt;/td&gt;
