&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:double;border-top-width:2.25pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblR" style="orphans:0;widows:0;padding-right:19.9pt;letter-spacing:0pt;line-height:10pt;"&gt;―&lt;/p&gt;
