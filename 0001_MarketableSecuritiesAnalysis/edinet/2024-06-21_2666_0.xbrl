&lt;p style="margin-left: 6px; line-height: 15.333333333333333333333333333px; margin-right: 6px; text-align: center"&gt;出席回数&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 16.67px"&gt;
&lt;td style="vertical-align: middle; width: 106.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; line-height: 15.333333333333333333333333333px; margin-right: 6px; text-align: center"&gt;廣岡　大介&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 200px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; line-height: 15.333333333333333333333333333px; margin-right: 6px; text-align: center"&gt;12回&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 200px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; line-height: 15.333333333333333333333333333px; margin-right: 6px; text-align: center"&gt;12回&lt;/p&gt;
&lt;/td&gt;
