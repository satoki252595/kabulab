&lt;tr style="height:15pt;min-height:15pt;"&gt;
&lt;td style="vertical-align:top;border-bottom-style:solid;border-bottom-width:1.5pt;border-left-style:solid;border-left-width:1.5pt;border-right-style:solid;border-right-width:1.5pt;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;text-align:center;padding-left:0pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:10pt;"&gt;2022年10月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:top;border-bottom-style:solid;border-bottom-width:1.5pt;border-left-style:solid;border-left-width:1.5pt;border-right-style:solid;border-right-width:1.5pt;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;"&gt;代表取締役会長兼社長にサチエ オオシマが就任&lt;/p&gt;
&lt;/td&gt;
