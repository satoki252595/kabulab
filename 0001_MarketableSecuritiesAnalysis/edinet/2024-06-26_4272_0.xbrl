&lt;td style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblR" style="orphans:0;widows:0;letter-spacing:0pt;line-height:11pt;"&gt;1945年12月&lt;/p&gt;
&lt;/td&gt;
