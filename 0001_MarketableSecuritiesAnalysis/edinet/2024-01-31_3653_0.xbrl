&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 77.333333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;退職慰労金&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 28px"&gt;
&lt;td style="vertical-align: middle; width: 117.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;取締役&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 6px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;(社外取締役を除く)&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
