&lt;p style="line-height: 11.333333333333333333333333333px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;略歴&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 32px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;
&lt;p style="line-height: 11.333333333333333333333333333px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;任期&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 63px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;
&lt;p style="line-height: 11.333333333333333333333333333px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;所有株式数&lt;/span&gt;
&lt;/p&gt;
&lt;p style="line-height: 11.333333333333333333333333333px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;（千株）&lt;/span&gt;
