&lt;p style="margin-left: 12px; margin-right: 3.3333333333333333333333333333px; text-align: left"&gt;融資未実行残高&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 124px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: right"&gt;1,394,678&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 76px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-right: 36px; text-align: justify; text-justify: inter-ideograph"&gt;百万円&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 124px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: right"&gt;1,351,268&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 76px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-right: 36px; text-align: justify; text-justify: inter-ideograph"&gt;百万円&lt;/p&gt;
