&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 180px; vertical-align: middle; padding-bottom: 2.6666666666666666666666666667px; padding-top: 2.6666666666666666666666666667px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 12px; margin-right: 12px; text-align: center; line-height: 13.333333333333333333333333333px"&gt;前事業年度&lt;/p&gt;
