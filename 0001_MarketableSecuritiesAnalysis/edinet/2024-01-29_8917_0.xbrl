&lt;p style="margin-left: 12px; margin-right: 12px; text-align: justify; line-height: 13.333333333333333333333333333px; text-justify: inter-ideograph"&gt;
&lt;span style="font-size: 12px"&gt; &lt;/span&gt;
&lt;/p&gt;
