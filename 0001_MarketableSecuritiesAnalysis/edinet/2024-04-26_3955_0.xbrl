&lt;/thead&gt;
&lt;tbody&gt;
&lt;tr style="height: 21.33px"&gt;
&lt;td style="vertical-align: middle; width: 88px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="line-height: 18.666666666666666666666666667px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;1950年２月&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 560px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 5px; line-height: 18.666666666666666666666666667px; margin-right: 3px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;井村荷札封筒株式会社を資本金150万円で奈良県北葛城郡新庄町（現奈良県葛城市）に設立&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 21.33px"&gt;
&lt;td style="vertical-align: middle; width: 88px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="line-height: 18.666666666666666666666666667px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;1958年１月&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 560px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 5px; line-height: 18.666666666666666666666666667px; margin-right: 3px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;東京都世田谷区に東京連絡所（現東京本社）を設置&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 21.33px"&gt;
&lt;td style="vertical-align: middle; width: 88px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="line-height: 18.666666666666666666666666667px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;1959年１月&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
