&lt;p style="margin-left: 32px; line-height: 18px; margin-right: 6px; text-align: left"&gt;流動資産&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 152px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 32px; line-height: 18px; margin-right: 4px; text-align: right"&gt;252百万円&lt;/p&gt;
&lt;/td&gt;
