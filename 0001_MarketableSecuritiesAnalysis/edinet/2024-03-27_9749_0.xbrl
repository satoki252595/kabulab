&lt;col style="width:61pt;min-width:61pt;"/&gt;
&lt;col style="width:61pt;min-width:61pt;"/&gt;
&lt;col style="width:60.8pt;min-width:60.8pt;"/&gt;
&lt;col style="width:61pt;min-width:61pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:37.5pt;min-height:37.5pt;"&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;line-height:11.5pt;"&gt;年月日&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;line-height:11.5pt;"&gt;発行済株式&lt;br/&gt;総数増減数&lt;br/&gt;(株)&lt;/p&gt;
&lt;/td&gt;
