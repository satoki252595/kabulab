&lt;tr style="height: 92px"&gt;
&lt;td style="vertical-align: top; width: 168px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: left"&gt; メカトロシステム事業&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 192px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; margin-right: 3.3333333333333333333333333333px; text-align: left"&gt;半導体製造システム（ハンダボールマウンタ、ワイヤボンダ、ＬＥＤ検査装置など）、医療機器（レーザ手術および治療装置、人工透析装置など）、切断加工システム（レーザ加工機、ウォータジェット切断加工機など）、超音波発生装置、油圧プレス機など&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 288px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; text-align: left"&gt;当社&lt;/p&gt;
&lt;p style="margin-left: 6px; text-align: left"&gt;株式会社カイジョー&lt;/p&gt;
&lt;p style="margin-left: 6px; text-align: left"&gt;Shibuya Kaijo(Thailand)Co.,Ltd.&lt;/p&gt;
&lt;p style="margin-left: 6px; text-align: left"&gt;上海楷捷半導体科技有限公司&lt;/p&gt;
&lt;p style="margin-left: 6px; text-align: left"&gt;台湾海上希歩洋股份有限公司&lt;/p&gt;
&lt;p style="margin-left: 6px; text-align: left"&gt;Kaijo Shibuya America Inc.&lt;/p&gt;
&lt;p style="margin-left: 6px; text-align: left"&gt;Kaijo Shibuya Europe GmbH&lt;/p&gt;
&lt;p style="margin-left: 6px; text-align: left"&gt;上海希歩洋工業科技有限公司&lt;/p&gt;
&lt;p style="margin-left: 6px; text-align: left"&gt;株式会社根上シブヤ&lt;/p&gt;
&lt;p style="margin-left: 6px; text-align: left"&gt;株式会社沖縄シブヤ&lt;/p&gt;
&lt;p style="margin-left: 6px; text-align: left"&gt;Shibuya Kaijo(Malaysia)Sdn.Bhd.&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 18px"&gt;
&lt;td style="vertical-align: top; width: 168px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: left"&gt; 農業用設備事業&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 192px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; margin-right: 3.3333333333333333333333333333px; text-align: left"&gt;農業用選果・選別システムなど&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 288px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; text-align: left"&gt;シブヤ精機株式会社&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
