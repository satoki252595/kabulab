  <jpcrp_cor:NotesRegardingAmountsOfReductionEntryOfPropertyPlantAndEquipmentTextBlock contextRef="CurrentYearInstant">
&lt;p style="margin-left: 30px; text-align: left; text-indent: -24px"&gt; &lt;/p&gt;
&lt;p style="margin-left: 30px; text-align: left; text-indent: -24px"&gt;※２．有形固定資産の取得価額から直接控除している圧縮記帳額&lt;/p&gt;
&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 648px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 240px"/&gt;
&lt;col style="width: 204px"/&gt;
&lt;col style="width: 204px"/&gt;
&lt;/colgroup&gt;
