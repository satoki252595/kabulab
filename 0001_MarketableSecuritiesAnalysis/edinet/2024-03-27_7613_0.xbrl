  <jpcrp_cor:NotesRelatedPartiesConsolidatedFinancialStatementsTextBlock contextRef="CurrentYearDuration">&lt;p style="page-break-before:always; line-height:0.75pt; width:100%; font-size:0.75pt;"&gt; &lt;/p&gt;
&lt;h5 class="smt_head5" style="padding-left:9pt;line-height:15pt;"&gt;【関連当事者情報】&lt;/h5&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:18pt;"&gt;前連結会計年度（自　&lt;span&gt;2022年１月１日&lt;/span&gt;　至　&lt;span&gt;2022年12月31日&lt;/span&gt;）&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:27pt;line-height:14pt;"&gt;重要性が乏しいため、記載を省略しております。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;line-height:10pt;font-size:10pt;"&gt; &lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:18pt;"&gt;当連結会計年度（自　&lt;span&gt;2023年１月１日&lt;/span&gt;　至　&lt;span&gt;2023年12月31日&lt;/span&gt;）&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:27pt;line-height:14pt;"&gt;重要性が乏しいため、記載を省略しております。&lt;/p&gt;&lt;p class="smt_text1" style="orphans:0;widows:0;line-height:12pt;font-size:12pt;"&gt; &lt;/p&gt;</jpcrp_cor:NotesRelatedPartiesConsolidatedFinancialStatementsTextBlock>
  <jpcrp_cor:NotesPerShareInformationConsolidatedFinancialStatementsTextBlock contextRef="CurrentYearDuration">
