&lt;col style="width:97pt;min-width:97pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:22pt;min-height:22pt;"&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:0pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;letter-spacing:0pt;line-height:12pt;"&gt;決議年月日&lt;/p&gt;
&lt;/td&gt;
