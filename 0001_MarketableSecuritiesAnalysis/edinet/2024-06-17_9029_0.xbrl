&lt;td style="vertical-align:top;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:right;padding-left:0pt;padding-right:0.5pt;text-justify:inter-ideograph;text-indent:-3.7pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;line-height:10pt;font-size:7.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;（注）１.&lt;/span&gt;&lt;/p&gt;
