  <jpigp_cor:NotesIntangibleAssetsConsolidatedFinancialStatementsIFRSTextBlock contextRef="CurrentYearDuration">&lt;p class="smt_head6" style="orphans:0;widows:0;"&gt;12．無形資産&lt;/p&gt;
