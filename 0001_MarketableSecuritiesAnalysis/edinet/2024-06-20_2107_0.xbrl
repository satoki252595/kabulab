  <jpcrp030000-asr_E00354-000:NotesChangesInAccountingPoliciesFinancialStatementsTextBlock contextRef="CurrentYearDuration">
&lt;h5 class="smt_head5" style="padding-left:21pt;line-height:18pt;font-size:10.5pt;"&gt;(会計方針の変更)&lt;/h5&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:16.5pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:10.5pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:18pt;font-size:10.5pt;"&gt;該当事項はありません。&lt;/p&gt;</jpcrp030000-asr_E00354-000:NotesChangesInAccountingPoliciesFinancialStatementsTextBlock>
  <jpcrp_cor:NotesChangesInAccountingEstimatesFinancialStatementsTextBlock contextRef="CurrentYearDuration">
&lt;h5 class="smt_head5" style="padding-left:21pt;line-height:18pt;font-size:10.5pt;"&gt;(会計上の見積りの変更)&lt;/h5&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:16.5pt;text-indent:10.5pt;line-height:18pt;font-size:10.5pt;"&gt;該当事項はありません。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:12pt;font-size:10.5pt;"&gt;　&lt;/p&gt;</jpcrp_cor:NotesChangesInAccountingEstimatesFinancialStatementsTextBlock>
  <jpcrp_cor:NotesAdditionalInformationFinancialStatementsTextBlock contextRef="CurrentYearDuration">
