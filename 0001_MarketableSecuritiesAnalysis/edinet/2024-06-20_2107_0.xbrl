  <jpcrp_cor:NotesBusinessCombinationsConsolidatedFinancialStatementsTextBlock contextRef="CurrentYearDuration">
&lt;h6 class="smt_head5" style="padding-left:21pt;line-height:18pt;font-size:10.5pt;"&gt;(企業結合等関係)&lt;/h6&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:25.5pt;line-height:18pt;font-size:10.5pt;"&gt;該当事項はありません。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:25.5pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:18pt;font-size:18pt;"&gt; &lt;/p&gt;</jpcrp_cor:NotesBusinessCombinationsConsolidatedFinancialStatementsTextBlock>
  <jpcrp_cor:NotesRevenueRecognitionConsolidatedFinancialStatementsTextBlock contextRef="CurrentYearDuration">&lt;p style="page-break-before:always; line-height:0.75pt; width:100%; font-size:0.75pt;"&gt; &lt;/p&gt;&lt;p class="smt_head5" style="orphans:0;widows:0;padding-left:21pt;line-height:18pt;font-size:10.5pt;"&gt;(収益認識関係)&lt;/p&gt;
&lt;h3 class="smt_head2" style="line-height:18pt;"&gt;&lt;span style="font-size:10.5pt;"&gt;１．&lt;/span&gt;&lt;span style="font-family:&amp;apos;ＭＳ 明朝&amp;apos;;font-size:10.5pt;"&gt;顧客との契約から生じる収益を分解した情報&lt;/span&gt;
