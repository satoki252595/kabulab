  <jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock contextRef="FilingDateInstant_jpcrp030000-asr_E31056-000IwasakiHiroyukiMember">
&lt;p style="margin-left: 65px; line-height: 15px; margin-right: 3px; text-align: left; text-indent: -60px"&gt;
