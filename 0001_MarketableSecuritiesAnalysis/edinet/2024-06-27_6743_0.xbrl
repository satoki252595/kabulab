&lt;tr style="height:41.3pt;min-height:41.3pt;"&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:11.3pt;padding-right:2.3pt;text-justify:inter-ideograph;text-indent:-9pt;letter-spacing:0pt;"&gt;　大同信号電器株式会社&lt;/p&gt;
