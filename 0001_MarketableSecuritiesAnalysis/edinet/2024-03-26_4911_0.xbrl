&lt;tr style="height:21.2pt;min-height:21.2pt;"&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:5.4pt;padding-right:5.4pt;text-justify:inter-ideograph;text-indent:0.7pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;line-height:18pt;font-size:9pt;"&gt;CO&lt;sub&gt;2&lt;/sub&gt;排出量削減 &amp;lt;SBTi, Scope 3&amp;gt;&lt;/p&gt;
