&lt;col style="width:51pt;min-width:51pt;"/&gt;
&lt;col style="width:3.5pt;min-width:3.5pt;"/&gt;
&lt;col style="width:60pt;min-width:60pt;"/&gt;
&lt;col style="width:3.5pt;min-width:3.5pt;"/&gt;
