&lt;p style="margin-left: 6px; margin-right: 3.3333333333333333333333333333px; text-align: center"&gt;種類&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 0px none #000000; border-top: 0px none #000000; border-right: 0px none #000000; border-bottom: 1px solid #000000; width: 152px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 6px; margin-right: 3.3333333333333333333333333333px; text-align: center"&gt;減損損失&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
