&lt;p style="margin-left: 0px; margin-right: 0px; text-align: left; line-height: 1"&gt; &lt;img alt="0102010_010.png" src="images/0102010_010.png" style="height: 31.68px; width: 182.73px"/&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;/div&gt;
