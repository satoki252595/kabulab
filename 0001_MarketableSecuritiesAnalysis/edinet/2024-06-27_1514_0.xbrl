&lt;img alt="0102010_003.png" src="images/0102010_003.png" style="height: 66.67px; width: 66.67px"/&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 0px none ; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 88px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center; line-height: 1"&gt;
&lt;span style="font-size: 12px"&gt; &lt;/span&gt;
