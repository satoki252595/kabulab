&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 624px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 200px"/&gt;
&lt;col style="width: 211.6px"/&gt;
&lt;col style="width: 212.4px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr&gt;
