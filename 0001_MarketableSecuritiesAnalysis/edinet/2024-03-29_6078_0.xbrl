&lt;colgroup&gt;
&lt;col style="width: 188.26666666666666666666666667px"/&gt;
&lt;col style="width: 95.2px"/&gt;
&lt;col style="width: 280px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
