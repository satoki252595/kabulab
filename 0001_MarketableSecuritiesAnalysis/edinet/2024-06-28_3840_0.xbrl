&lt;colgroup&gt;
&lt;col style="width: 205.26666666666666666666666667px"/&gt;
&lt;col style="width: 204.53333333333333333333333333px"/&gt;
&lt;col style="width: 204.53333333333333333333333333px"/&gt;
