&lt;/colgroup&gt;
&lt;thead&gt;
&lt;tr style="height: 22.67px"&gt;
&lt;td rowspan="2" style="vertical-align: middle; width: 63.466666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 11.333333333333333333333333333px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;子会社名&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td rowspan="2" style="vertical-align: middle; width: 128.4px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 11.333333333333333333333333333px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;事業所名&lt;/span&gt;
&lt;/p&gt;
&lt;p style="line-height: 11.333333333333333333333333333px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;（所在地）&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td rowspan="2" style="vertical-align: middle; width: 56.266666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 5px; line-height: 11.333333333333333333333333333px; margin-right: 5px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;セグメントの名称&lt;/span&gt;
