&lt;colgroup&gt;
&lt;col style="width: 60px"/&gt;
&lt;col style="width: 102.13333333333333333333333333px"/&gt;
&lt;col style="width: 72px"/&gt;
&lt;col style="width: 90.13333333333333333333333333px"/&gt;
&lt;col style="width: 72px"/&gt;
