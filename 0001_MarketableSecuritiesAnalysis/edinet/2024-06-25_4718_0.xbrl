  <jpcrp_cor:InformationAboutEmployeesTextBlock contextRef="FilingDateInstant">
&lt;h3&gt;５【従業員の状況】&lt;/h3&gt;
&lt;p style="margin-left: 72px; line-height: 16.666666666666666666666666667px; text-align: left; text-indent: -72px"&gt;(1）連結会社の状況&lt;/p&gt;
&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 648px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 648px"/&gt;
