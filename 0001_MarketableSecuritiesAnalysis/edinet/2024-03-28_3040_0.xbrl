&lt;col style="width: 256px"/&gt;
&lt;col style="width: 168.93333333333333333333333333px"/&gt;
&lt;col style="width: 168.93333333333333333333333333px"/&gt;
&lt;/colgroup&gt;
&lt;thead&gt;
