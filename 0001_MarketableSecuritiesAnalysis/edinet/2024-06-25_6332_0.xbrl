&lt;/td&gt;
&lt;td style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:0pt;line-height:15pt;"&gt;JFEエンジニアリング株式会社&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
