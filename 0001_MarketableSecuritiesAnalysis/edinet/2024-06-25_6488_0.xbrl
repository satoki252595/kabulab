&lt;tr style="height: 13.33px"&gt;
&lt;td style="vertical-align: middle; width: 400px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; line-height: 13.333333333333333333333333333px; text-align: right"&gt;（単位：千円）&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;/div&gt;
&lt;p style="margin-left: 60px; line-height: 1.3333333333333333333333333333px; text-align: justify; text-justify: inter-ideograph"&gt; &lt;/p&gt;
&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 399.99999999999999999999999999px; margin-left: auto; margin-right: auto"&gt;
&lt;colgroup&gt;
&lt;col style="width: 133.33333333333333333333333333px"/&gt;
