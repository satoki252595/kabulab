</jpcrp_cor:NotesRegardingPromissoryNotesDueOnBalanceSheetDateTextBlock>
  <jpcrp_cor:NotesRegardingPledgedAssetsTextBlock contextRef="CurrentYearInstant_NonConsolidatedMember">
&lt;p style="margin-left: 84px; text-align: left; text-indent: -24px"&gt;※２　担保資産及び担保付債務&lt;/p&gt;
&lt;p style="margin-left: 84px; text-align: left"&gt;　担保に供している資産は、次のとおりであります。&lt;/p&gt;
&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 648px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 240px"/&gt;
&lt;col style="width: 204px"/&gt;
&lt;col style="width: 204px"/&gt;
&lt;/colgroup&gt;
&lt;thead&gt;
