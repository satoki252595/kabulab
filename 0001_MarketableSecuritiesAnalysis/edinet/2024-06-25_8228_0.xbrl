&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 38.87px"&gt;
&lt;td style="vertical-align: middle; width: 139px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
