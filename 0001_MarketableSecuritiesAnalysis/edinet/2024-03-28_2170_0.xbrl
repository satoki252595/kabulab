&lt;p style="margin-left: 72px; text-align: left"&gt; &lt;/p&gt;
&lt;p style="margin-left: 72px; line-height: 1; text-align: left"&gt;
&lt;img alt="0102010_003.png" src="images/0102010_003.png" style="height: 267.33px; width: 576px"/&gt;
&lt;/p&gt;
&lt;p style="margin-left: 72px; text-align: left"&gt; &lt;/p&gt;
