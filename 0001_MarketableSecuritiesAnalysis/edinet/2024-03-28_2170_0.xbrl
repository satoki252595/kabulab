&lt;tr style="height: 27px"&gt;
&lt;td rowspan="4" style="border-left: 1px solid #000000; border-top: 2px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 108px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 6px; margin-right: 4px; text-align: left"&gt;提起された苦情の種類と件数&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 2px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 144px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 6px; margin-right: 4px; text-align: left"&gt;合計&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 2px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 48px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 0px; margin-right: 0px; text-align: center"&gt;件&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 2px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 66px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 0px; margin-right: 6px; text-align: right"&gt;3&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 2px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 66px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 0px; margin-right: 6px; text-align: right"&gt;11&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 2px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 66px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 0px; margin-right: 6px; text-align: right"&gt;13&lt;/p&gt;
&lt;/td&gt;
