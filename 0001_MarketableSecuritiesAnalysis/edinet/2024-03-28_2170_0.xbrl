&lt;td colspan="7" style="border-left: 1px solid #000000; border-top: 2px solid #000000; border-right: 1px solid #000000; border-bottom: 2px solid #000000; width: 648px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px; background-color: #D9D9D9"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: left"&gt;
&lt;span style="font-weight: bold"&gt;１．倫理とコンプライアンス&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
