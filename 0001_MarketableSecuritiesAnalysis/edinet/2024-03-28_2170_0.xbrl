&lt;/td&gt;
&lt;td style="vertical-align: top; width: 281.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 5px; line-height: 15px; margin-right: 5px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;当社設立、代表取締役社長&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
