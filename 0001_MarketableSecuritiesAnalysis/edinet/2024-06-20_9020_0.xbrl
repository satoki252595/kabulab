&lt;/td&gt;
&lt;td style="border-left: 0px none #000000; border-top: 0px none #000000; border-right: 0px none #000000; border-bottom: 0px none #000000; width: 294px; vertical-align: top; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 0px; margin-right: 0px; text-align: left; line-height: 13.333333333333333333333333333px"&gt;(第37期第１四半期)　自　2023年４月１日&lt;/p&gt;
&lt;p style="margin-left: 0px; margin-right: 0px; text-align: left; line-height: 13.333333333333333333333333333px; margin-bottom: 13.333333333333333333333333333px"&gt;　　　　 　　　　　 至　2023年６月30日&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 0px none #000000; border-top: 0px none #000000; border-right: 0px none #000000; border-bottom: 0px none #000000; width: 156px; vertical-align: top; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 0px; margin-right: 0px; text-align: left; line-height: 13.333333333333333333333333333px"&gt;2023年８月３日&lt;/p&gt;
&lt;p style="margin-left: 0px; margin-right: 0px; text-align: left; line-height: 13.333333333333333333333333333px; margin-bottom: 13.333333333333333333333333333px"&gt;関東財務局長に提出&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td style="border-left: 0px none #000000; border-top: 0px none #000000; border-right: 0px none #000000; border-bottom: 0px none #000000; width: 174px; vertical-align: top; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 0px; margin-right: 0px; text-align: left; line-height: 13.333333333333333333333333333px"&gt;(5)　四半期報告書&lt;/p&gt;
&lt;p style="margin-left: 30px; margin-right: 0px; text-align: left; line-height: 13.333333333333333333333333333px; margin-bottom: 13.333333333333333333333333333px"&gt;および確認書&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 0px none #000000; border-top: 0px none #000000; border-right: 0px none #000000; border-bottom: 0px none #000000; width: 294px; vertical-align: top; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 0px; margin-right: 0px; text-align: left; line-height: 13.333333333333333333333333333px"&gt;(第37期第２四半期)　自　2023年７月１日&lt;/p&gt;
&lt;p style="margin-left: 0px; margin-right: 0px; text-align: left; line-height: 13.333333333333333333333333333px; margin-bottom: 13.333333333333333333333333333px"&gt;　　　　 　　　　　 至　2023年９月30日&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 0px none #000000; border-top: 0px none #000000; border-right: 0px none #000000; border-bottom: 0px none #000000; width: 156px; vertical-align: top; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 0px; margin-right: 0px; text-align: left; line-height: 13.333333333333333333333333333px"&gt;2023年11月８日&lt;/p&gt;
&lt;p style="margin-left: 0px; margin-right: 0px; text-align: left; line-height: 13.333333333333333333333333333px; margin-bottom: 13.333333333333333333333333333px"&gt;関東財務局長に提出&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td style="border-left: 0px none #000000; border-top: 0px none #000000; border-right: 0px none #000000; border-bottom: 0px none #000000; width: 174px; vertical-align: top; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 0px; margin-right: 6px; text-align: left; line-height: 13.333333333333333333333333333px"&gt;(6)　臨時報告書&lt;/p&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: left; line-height: 13.333333333333333333333333333px"&gt; &lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 0px none #000000; border-top: 0px none #000000; border-right: 0px none #000000; border-bottom: 0px none #000000; width: 294px; vertical-align: top; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: left; line-height: 13.333333333333333333333333333px"&gt;企業内容等の開示に関する内閣府令第19条&lt;/p&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: left; line-height: 13.333333333333333333333333333px"&gt;第２項第９号(代表取締役の異動)の規定に&lt;/p&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: left; line-height: 13.333333333333333333333333333px"&gt;基づくもの&lt;/p&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: left; line-height: 13.333333333333333333333333333px"&gt; &lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 0px none #000000; border-top: 0px none #000000; border-right: 0px none #000000; border-bottom: 0px none #000000; width: 156px; vertical-align: top; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 0px; margin-right: 6px; text-align: left; line-height: 13.333333333333333333333333333px"&gt;2024年１月17日&lt;/p&gt;
&lt;p style="margin-left: 0px; margin-right: 6px; text-align: left; line-height: 13.333333333333333333333333333px"&gt;関東財務局長に提出&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td style="border-left: 0px none #000000; border-top: 0px none #000000; border-right: 0px none #000000; border-bottom: 0px none #000000; width: 174px; vertical-align: top; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 0px; margin-right: 0px; text-align: left; line-height: 13.333333333333333333333333333px"&gt;(7)　四半期報告書&lt;/p&gt;
&lt;p style="margin-left: 30px; margin-right: 0px; text-align: left; line-height: 13.333333333333333333333333333px; margin-bottom: 13.333333333333333333333333333px"&gt;および確認書&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 0px none #000000; border-top: 0px none #000000; border-right: 0px none #000000; border-bottom: 0px none #000000; width: 294px; vertical-align: top; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 0px; margin-right: 0px; text-align: left; line-height: 13.333333333333333333333333333px"&gt;(第37期第３四半期)　自　2023年10月１日&lt;/p&gt;
&lt;p style="margin-left: 0px; margin-right: 0px; text-align: left; line-height: 13.333333333333333333333333333px; margin-bottom: 13.333333333333333333333333333px"&gt;　　　　 　　　　　 至　2023年12月31日&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 0px none #000000; border-top: 0px none #000000; border-right: 0px none #000000; border-bottom: 0px none #000000; width: 156px; vertical-align: top; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 0px; margin-right: 0px; text-align: left; line-height: 13.333333333333333333333333333px"&gt;2024年２月５日&lt;/p&gt;
&lt;p style="margin-left: 0px; margin-right: 0px; text-align: left; line-height: 13.333333333333333333333333333px; margin-bottom: 13.333333333333333333333333333px"&gt;関東財務局長に提出&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;/div&gt;
&lt;p style="text-align: left"&gt; &lt;/p&gt;
</jpcrp_cor:OtherReferenceInformationTextBlock>
