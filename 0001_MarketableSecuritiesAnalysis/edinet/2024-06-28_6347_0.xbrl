&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:34.5pt;min-height:34.5pt;"&gt;
&lt;td style="vertical-align:top;border-top-color:#a9a9a9;border-bottom-color:#a9a9a9;border-left-color:#a9a9a9;border-right-color:#a9a9a9;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;margin-top:2pt;line-height:16pt;"&gt;2010年10月&lt;/p&gt;
