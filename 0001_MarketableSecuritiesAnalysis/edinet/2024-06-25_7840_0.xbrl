&lt;p style="margin-right: 12px; text-align: center"&gt;有限責任監査法人トーマツ&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 125px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
