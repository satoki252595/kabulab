  <jpcrp_cor:NotesRegardingDividendTextBlock contextRef="Prior1YearDuration">&lt;p class="smt_head6" style="orphans:0;widows:0;padding-left:36pt;line-height:13pt;"&gt;２．配当に関する事項&lt;/p&gt;
