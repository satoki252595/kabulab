&lt;col style="width: 80px"/&gt;
&lt;col style="width: 80px"/&gt;
&lt;col style="width: 80px"/&gt;
&lt;col style="width: 69.333333333333333333333333333px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr style="height: 20px"&gt;
&lt;td rowspan="2" style="vertical-align: middle; width: 140px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;
&lt;p style="line-height: 14.666666666666666666666666667px; text-align: center"&gt;役員区分&lt;/p&gt;
&lt;/td&gt;
&lt;td rowspan="2" style="vertical-align: middle; width: 82.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;
&lt;p style="line-height: 14.666666666666666666666666667px; text-align: center"&gt;報酬等の総額&lt;/p&gt;
&lt;p style="line-height: 14.666666666666666666666666667px; text-align: center"&gt;（百万円）&lt;/p&gt;
&lt;/td&gt;
