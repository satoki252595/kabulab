  <jpcrp_cor:InformationAboutEmployeesTextBlock contextRef="FilingDateInstant">
&lt;h3&gt;５【従業員の状況】&lt;/h3&gt;
&lt;p style="margin-left: 24px; text-align: left"&gt;（１）提出会社の状況&lt;/p&gt;
&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 640px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 93.33333333333333333333333333px"/&gt;
&lt;col style="width: 66.666666666666666666666666667px"/&gt;
&lt;col style="width: 160px"/&gt;
&lt;col style="width: 160px"/&gt;
&lt;col style="width: 160px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr style="height: 20px"&gt;
&lt;td style="vertical-align: middle; width: 93.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;
&lt;p style="text-align: right"&gt;
