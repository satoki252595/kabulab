&lt;tr&gt;
&lt;td style="vertical-align: top; width: 452px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: left"&gt;株式会社日本カストディ銀行（信託Ｅ口）への当社株式の処分による減少&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 92px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
