  <jpcrp030000-asr_E36353-000:DescriptionOfMetricsRelatedToPolicyOnHumanResourceDevelopmentAndImprovementOfInternalEnvironmentAndTargetsAndResultsUsingSuchMetricsMetricsAndTargetsTextBlock contextRef="FilingDateInstant">
&lt;p style="margin-left: 36px; line-height: 6px; text-align: left"&gt; &lt;/p&gt;
