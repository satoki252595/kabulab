&lt;td style="vertical-align:bottom;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-color:#a9a9a9;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="bottom"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:right;"&gt;（4,058）&lt;/p&gt;
