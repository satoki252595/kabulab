&lt;td style="vertical-align:top;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:7.2pt;padding-right:7.2pt;line-height:15pt;"&gt;&lt;span style="font-size:9pt;"&gt;降水パターンの変化と気象パターンの極端な変化&lt;/span&gt;&lt;/p&gt;
