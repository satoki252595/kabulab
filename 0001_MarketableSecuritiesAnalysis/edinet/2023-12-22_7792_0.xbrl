&lt;col style="width:70pt;min-width:70pt;"/&gt;
&lt;col style="width:190pt;min-width:190pt;"/&gt;
&lt;col style="width:28pt;min-width:28pt;"/&gt;
&lt;col style="width:43pt;min-width:43pt;"/&gt;
&lt;/colgroup&gt;
