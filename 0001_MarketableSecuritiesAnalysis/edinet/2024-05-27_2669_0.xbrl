&lt;p style="margin-left: 6px; line-height: 13.333333333333333333333333333px; margin-right: 12px; text-align: right"&gt;39.4&lt;/p&gt;
&lt;p style="margin-left: 12px; line-height: 13.333333333333333333333333333px; margin-right: 6px; text-align: right"&gt; &lt;/p&gt;
&lt;/td&gt;
