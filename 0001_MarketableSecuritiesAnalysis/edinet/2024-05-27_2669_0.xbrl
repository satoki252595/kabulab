&lt;td style="vertical-align: middle; width: 162px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;非監査業務に基づく報酬&lt;/p&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;（千円）&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 162px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;監査証明業務に基づく報酬&lt;/p&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;（千円）&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 162px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;非監査業務に基づく報酬&lt;/p&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;（千円）&lt;/p&gt;
&lt;/td&gt;
