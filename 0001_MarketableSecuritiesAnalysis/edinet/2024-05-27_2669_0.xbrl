&lt;tr style="height: 24px"&gt;
&lt;td style="vertical-align: middle; width: 186.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 16.666666666666666666666666667px; text-align: left"&gt;時価ベースの自己資本比率（％）&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 89.86666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 16.666666666666666666666666667px; margin-right: 22.8px; text-align: right"&gt;80.9&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 89.86666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 16.666666666666666666666666667px; margin-right: 22.8px; text-align: right"&gt;89.3&lt;/p&gt;
&lt;/td&gt;
