&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 252.66666666666666666666666667px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 70px"/&gt;
&lt;col style="width: 182.66666666666666666666666667px"/&gt;
&lt;/colgroup&gt;
