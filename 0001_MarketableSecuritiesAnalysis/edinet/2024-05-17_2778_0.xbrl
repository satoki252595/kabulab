&lt;/div&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:66.5pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:-27pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;font-size:15pt;"&gt; &lt;/p&gt;
&lt;h4 class="smt_head3" style="padding-left:34pt;"&gt;ｂ　販売実績&lt;/h4&gt;
&lt;h5 class="smt_head4" style="padding-left:46.5pt;"&gt;イ　区分別販売実績&lt;/h5&gt;
&lt;div class="tbld" style="margin-left:30pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:450pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
&lt;col style="width:150pt;min-width:150pt;"/&gt;
&lt;col style="width:150pt;min-width:150pt;"/&gt;
&lt;col style="width:150pt;min-width:150pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:33.8pt;min-height:33.8pt;"&gt;
