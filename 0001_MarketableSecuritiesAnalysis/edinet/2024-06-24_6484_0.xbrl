&lt;td style="vertical-align: middle; width: 155px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 0px none ; background-color: #FFFFFF"&gt;
&lt;p style="text-align: center"&gt;
2023年10月27日
&lt;/p&gt;
&lt;/td&gt;
