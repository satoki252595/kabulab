&lt;td style="vertical-align: middle; width: 194.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; line-height: 13.333333333333333333333333333px; margin-right: 6px; text-align: left"&gt;Ⅲ　連結売上収益に占める&lt;/p&gt;
&lt;p style="margin-left: 30px; line-height: 13.333333333333333333333333333px; margin-right: 6px; text-align: left"&gt;海外売上収益の割合（％）&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 90px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 18px; text-align: right"&gt;64.2&lt;/p&gt;
&lt;/td&gt;
