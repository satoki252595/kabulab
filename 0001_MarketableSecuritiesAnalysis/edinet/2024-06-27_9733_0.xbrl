&lt;col style="width: 52px"/&gt;
&lt;/colgroup&gt;
&lt;thead&gt;
&lt;tr style="height: 62.33px"&gt;
&lt;td style="vertical-align: middle; width: 48px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 15.333333333333333333333333333px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;種類&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 69.533333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 15.333333333333333333333333333px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;会社等の名称又は氏名&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 33.866666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 15.333333333333333333333333333px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;所在地&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 41.333333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 5px; line-height: 15.333333333333333333333333333px; margin-right: 5px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;資本金又は出資金&lt;/span&gt;
&lt;/p&gt;
&lt;p style="line-height: 15.333333333333333333333333333px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;（百万円）&lt;/span&gt;
&lt;/p&gt;
