  <jpcrp_cor:NameOfShareholderTreasurySharesEtc contextRef="CurrentYearInstant_Row1Member">平和不動産株式会社</jpcrp_cor:NameOfShareholderTreasurySharesEtc>
  <jpcrp_cor:AddressOfShareholderTreasurySharesEtc contextRef="CurrentYearInstant_Row1Member">
東京都中央区
