&lt;td style="vertical-align: middle; width: 152px; padding-top: 0px; padding-bottom: 0px; padding-left: 6.6px; padding-right: 6.6px; border-left: 0px none ; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #E2EFDA"&gt;
&lt;p style="line-height: 12px; text-align: left"&gt;
&lt;span style="font-family: &amp;apos;ＭＳ ゴシック&amp;apos;; font-size: 10px"&gt;テナント・入居者の需要変化&lt;br/&gt;（より気候変動への対応が進んだ物件を選択する、または対応していない物件を避ける）&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 184px; padding-top: 0px; padding-bottom: 0px; padding-left: 6.6px; padding-right: 6.6px; border-left: 0px none ; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 10.666666666666666666666666667px; line-height: 12px; text-align: left; text-indent: -10.666666666666666666666666667px"&gt;
