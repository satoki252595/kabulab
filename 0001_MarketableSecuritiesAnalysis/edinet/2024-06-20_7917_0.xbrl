&lt;p style="text-align: right"&gt;218&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 72px; padding-top: 0px; padding-bottom: 0px; padding-left: 6.6px; padding-right: 6.6px; border-left: 0px none ; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 3px double #000000"&gt;
&lt;p style="text-align: right"&gt;7.7&lt;/p&gt;
