&lt;td style="vertical-align:middle;border-top-color:#a9a9a9;border-bottom-color:#a9a9a9;border-left-color:#a9a9a9;border-right-color:#a9a9a9;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblR" style="orphans:0;widows:0;padding-right:0pt;letter-spacing:0pt;line-height:10pt;font-size:10pt;"&gt; &lt;/p&gt;
