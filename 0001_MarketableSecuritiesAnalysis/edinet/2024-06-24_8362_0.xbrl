  <jpcrp_cor:InformationAboutEmployeesTextBlock contextRef="FilingDateInstant">&lt;p style="page-break-before:always; line-height:0.75pt; width:100%; font-size:0.75pt;"&gt; &lt;/p&gt;
&lt;h3 class="smt_head2" style="font-family:&amp;apos;ＭＳ ゴシック&amp;apos;;"&gt;５ 【従業員の状況】&lt;/h3&gt;
&lt;h4 class="smt_head3"&gt;(1) 連結会社における従業員数&lt;/h4&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:368.2pt;line-height:9.5pt;"&gt;&lt;span&gt;2024年３月31日&lt;/span&gt;現在&lt;/p&gt;
&lt;div class="tbld" style="margin-left:0pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:466.5pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
&lt;col style="width:220pt;min-width:220pt;"/&gt;
