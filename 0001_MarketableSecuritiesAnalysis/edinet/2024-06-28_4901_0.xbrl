&lt;tr style="height: 21px"&gt;
&lt;td style="vertical-align: middle; width: 187px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 3px double #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 7px; line-height: 21px; margin-right: 7px; text-align: left"&gt;
&lt;span style="font-size: 14px"&gt;売上高&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
