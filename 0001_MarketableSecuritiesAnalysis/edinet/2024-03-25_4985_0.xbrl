  <jpcrp_cor:RevenuesFromExternalCustomersInformationForEachRegionTextBlock contextRef="Prior1YearDuration">&lt;p class="smt_text1" style="orphans:0;widows:0;text-align:justify;padding-left:4.5pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:9pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;"&gt;(1) 売上高&lt;/p&gt;&lt;p class="smt_text2" style="orphans:0;widows:0;padding-left:13.5pt;"&gt;日本の外部顧客への売上高が連結損益計算書の売上高の90％を超えるため、記載を省略しております。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;"&gt; &lt;/p&gt;</jpcrp_cor:RevenuesFromExternalCustomersInformationForEachRegionTextBlock>
  <jpcrp_cor:PropertyPlantAndEquipmentInformationForEachRegionTextBlock contextRef="Prior1YearDuration">&lt;p class="smt_text1" style="orphans:0;widows:0;text-align:justify;padding-left:4.5pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:9pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;"&gt;(2) 有形固定資産&lt;/p&gt;
&lt;div class="tbld" style="margin-left:0pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:484pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
&lt;col style="width:96.8pt;min-width:96.8pt;"/&gt;
