&lt;/div&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:4.5pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:14pt;font-size:14pt;"&gt; &lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:4.5pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:14pt;font-size:14pt;"&gt; &lt;/p&gt;</jpcrp_cor:NotesRegardingAssetsAndLiabilitiesIncurredFromTransactionsWithAffiliatedEntitiesTextBlock>
  <jpcrp_cor:NotesRegardingGuaranteeObligationsTextBlock contextRef="CurrentYearInstant_NonConsolidatedMember">&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:12pt;"&gt;２  保証債務&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:30.5pt;"&gt;関係会社の金融機関からの借入に対し、次のとおり債務保証を行っております。&lt;/p&gt;
&lt;div class="tbld" style="margin-left:30.1pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:437.3pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
&lt;col style="width:155.3pt;min-width:155.3pt;"/&gt;
&lt;col style="width:64pt;min-width:64pt;"/&gt;
&lt;col style="width:77pt;min-width:77pt;"/&gt;
&lt;col style="width:64pt;min-width:64pt;"/&gt;
&lt;col style="width:77pt;min-width:77pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:22.5pt;min-height:22.5pt;"&gt;
