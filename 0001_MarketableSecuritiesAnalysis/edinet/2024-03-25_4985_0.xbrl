&lt;col style="width:97.5pt;min-width:97.5pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:16.5pt;min-height:16.5pt;"&gt;
&lt;td style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:justify;padding-left:4.5pt;padding-right:4.5pt;line-height:10pt;"&gt;流動資産&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:right;padding-left:4.5pt;padding-right:4.5pt;line-height:10pt;"&gt;&lt;span style="font-size:9pt;"&gt;470百万円&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
