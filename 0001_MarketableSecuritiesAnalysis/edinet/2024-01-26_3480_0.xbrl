&lt;p style="margin-left: 54px; margin-top: 6px; text-align: left"&gt;成長投資&lt;/p&gt;
&lt;div style="margin-left: 54px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 353.59999999999999999999999999px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 113.33333333333333333333333333px"/&gt;
&lt;col style="width: 120.13333333333333333333333333px"/&gt;
