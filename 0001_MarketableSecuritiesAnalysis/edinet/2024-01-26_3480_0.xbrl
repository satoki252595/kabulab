&lt;/colgroup&gt;
&lt;thead&gt;
&lt;tr style="height: 63.67px"&gt;
&lt;td style="vertical-align: middle; width: 61.866666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 5.3333333333333333333333333333px; line-height: 13.333333333333333333333333333px; margin-right: 5.3333333333333333333333333333px; text-align: center"&gt;種 類&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 76px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 5.3333333333333333333333333333px; line-height: 13.333333333333333333333333333px; margin-right: 5.3333333333333333333333333333px; text-align: center"&gt;会社等の名&lt;/p&gt;
&lt;p style="margin-left: 5.3333333333333333333333333333px; line-height: 13.333333333333333333333333333px; margin-right: 5.3333333333333333333333333333px; text-align: center"&gt;称又は氏名&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 69.6px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;事業の内容又は職業&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 64px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;議決権等&lt;/p&gt;
&lt;p style="margin-left: 5.3333333333333333333333333333px; line-height: 13.333333333333333333333333333px; margin-right: 5.3333333333333333333333333333px; text-align: center"&gt;の所有&lt;/p&gt;
