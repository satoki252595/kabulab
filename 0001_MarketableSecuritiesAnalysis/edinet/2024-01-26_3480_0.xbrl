&lt;p style="margin-left: 54px; margin-top: 6px; text-align: left"&gt;資本効率及び財務安全性&lt;/p&gt;
&lt;div style="margin-left: 54px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 453.33333333333333333333333332px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 113.33333333333333333333333333px"/&gt;
&lt;col style="width: 113.33333333333333333333333333px"/&gt;
&lt;col style="width: 113.33333333333333333333333333px"/&gt;
&lt;col style="width: 113.33333333333333333333333333px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr style="height: 29.33px"&gt;
&lt;td style="vertical-align: middle; width: 113.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center"&gt;ＲＯＥ&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 113.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center"&gt;ＲＯＩＣ&lt;/p&gt;
&lt;/td&gt;
