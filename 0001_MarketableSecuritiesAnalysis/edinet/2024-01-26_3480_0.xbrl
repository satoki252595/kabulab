&lt;tr style="height: 20px"&gt;
&lt;td style="vertical-align: top; width: 86.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; line-height: 14.666666666666666666666666667px; margin-right: 6px; text-align: center"&gt;2002年７月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 561.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; line-height: 14.666666666666666666666666667px; margin-right: 6px; text-align: justify; text-justify: inter-ideograph"&gt;九州地方への進出を目的として、㈱ジェイ・エス・ビー九州を設立する。&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 20px"&gt;
&lt;td style="vertical-align: top; width: 86.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; line-height: 14.666666666666666666666666667px; margin-right: 6px; text-align: center"&gt;2002年12月&lt;/p&gt;
