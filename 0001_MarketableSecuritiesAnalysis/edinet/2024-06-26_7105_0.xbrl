  <jpcrp_cor:InformationForEachProductOrServiceTextBlock contextRef="Prior1YearDuration">
&lt;p style="margin-left: 36px; line-height: 16px; margin-right: 0px; text-align: left"&gt;１．製品及びサービスごとの情報&lt;/p&gt;
