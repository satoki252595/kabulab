&lt;td colspan="2" style="vertical-align: middle; width: 141.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; line-height: 14.666666666666666666666666667px; margin-right: 6px; text-align: left"&gt;特記事項&lt;/p&gt;
