&lt;td colspan="3" style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:right;"&gt;(百万円)&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
