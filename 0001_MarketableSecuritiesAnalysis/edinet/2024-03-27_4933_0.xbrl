  <jpcrp_cor:InformationAboutOfficersTextBlock contextRef="FilingDateInstant">&lt;p style="page-break-before:always; line-height:0.75pt; width:100%; font-size:0.75pt;"&gt; &lt;/p&gt;
&lt;h3 class="smt_head3"&gt;(2) 【役員の状況】&lt;/h3&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:18pt;margin-bottom:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;line-height:14.5pt;font-size:9pt;"&gt;男性5名　女性2名　（役員のうち女性の比率28.5％）&lt;/p&gt;
&lt;div class="tbld" style="margin-left:0pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:482.3pt;table-layout:fixed;"&gt;
