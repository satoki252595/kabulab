&lt;/colgroup&gt;
&lt;tr style="height:25pt;min-height:25pt;"&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;background-color:#f2f2f2;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:2pt;padding-right:2pt;font-family:&amp;apos;ＭＳ Ｐゴシック&amp;apos;;font-size:7.5pt;"&gt;区分&lt;/p&gt;
&lt;/td&gt;
