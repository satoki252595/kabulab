&lt;/td&gt;
&lt;td style="vertical-align:top;border-top-style:dotted;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:dotted;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;line-height:12pt;"&gt;・正社員離職率：5.3%&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:30.1pt;min-height:30.1pt;"&gt;
