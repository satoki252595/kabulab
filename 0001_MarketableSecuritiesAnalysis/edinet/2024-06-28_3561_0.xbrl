&lt;p style="margin-left: 6px; margin-right: 3.3333333333333333333333333333px; text-align: justify; text-justify: inter-ideograph"&gt;全社（共通）&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 252px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none ; background-color: #FFFFFF"&gt;
&lt;p style="text-align: right"&gt;
19
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 72px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none ; background-color: #FFFFFF"&gt;
