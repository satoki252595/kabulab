  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E02030-000AbeYuichiMember">1961-10-30</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock contextRef="FilingDateInstant_jpcrp030000-asr_E02030-000AbeYuichiMember">
&lt;p style="margin-left: 55px; line-height: 14px; text-align: left; text-indent: -50px"&gt;
&lt;span style="font-size: 10px"&gt;1984年４月 東京エレクトロン㈱入社&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 55px; line-height: 14px; text-align: left; text-indent: -50px"&gt;
&lt;span style="font-size: 10px"&gt;2010年４月 同社 ＴＳプロジェクトプロジェクトリーダー&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 55px; line-height: 14px; text-align: left; text-indent: -50px"&gt;
