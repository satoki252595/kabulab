&lt;td style="vertical-align:top;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;text-align:justify;padding-left:19.9pt;text-justify:inter-ideograph;text-indent:0pt;line-height:16pt;"&gt;1992年12月&lt;/p&gt;
