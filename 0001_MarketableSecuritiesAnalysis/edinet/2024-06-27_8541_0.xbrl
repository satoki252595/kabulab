&lt;td style="vertical-align:top;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:10.0pt;padding-right:0pt;line-height:16pt;"&gt;フルディーリング業務開始&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:16pt;min-height:16pt;"&gt;
&lt;td style="vertical-align:top;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;text-align:justify;padding-left:19.9pt;line-height:16pt;"&gt;1989年２月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:top;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:10.0pt;padding-right:0pt;line-height:16pt;"&gt;普通銀行に転換、株式会社愛媛銀行に商号変更&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
