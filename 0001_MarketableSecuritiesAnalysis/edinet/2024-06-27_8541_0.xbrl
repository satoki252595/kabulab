&lt;col style="width:41.1pt;min-width:41.1pt;"/&gt;
&lt;col style="width:29.3pt;min-width:29.3pt;"/&gt;
&lt;col style="width:32.6pt;min-width:32.6pt;"/&gt;
&lt;col style="width:52.5pt;min-width:52.5pt;"/&gt;
