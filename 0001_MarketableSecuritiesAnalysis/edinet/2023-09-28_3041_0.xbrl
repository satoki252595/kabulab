  <jpcrp_cor:StatementOfChangesInEquityTextBlock contextRef="CurrentYearDuration">&lt;p style="page-break-before:always; line-height:0.75pt; width:100%; font-size:0.75pt;"&gt; &lt;/p&gt;
&lt;h5 class="smt_head4"&gt;③ 【株主資本等変動計算書】&lt;/h5&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;"&gt;  前事業年度(自 2021年７月１日　至 2022年６月30日)&lt;/p&gt;
&lt;div class="tbld"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;width:342pt;table-layout:fixed;"&gt;
