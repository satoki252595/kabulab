&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:36.0pt;min-height:36.0pt;"&gt;
&lt;td style="vertical-align:top;border-top-color:#a9a9a9;border-bottom-color:#a9a9a9;border-left-color:#a9a9a9;border-right-color:#a9a9a9;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:1pt;padding-right:0pt;line-height:18pt;"&gt;2000年８月&lt;/p&gt;
