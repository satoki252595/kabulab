&lt;col style="width:149pt;min-width:149pt;"/&gt;
&lt;col style="width:149pt;min-width:149pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:22.5pt;min-height:22.5pt;"&gt;
