&lt;col style="width: 100px"/&gt;
&lt;col style="width: 62.666666666666666666666666667px"/&gt;
&lt;col style="width: 62.666666666666666666666666667px"/&gt;
&lt;col style="width: 62.666666666666666666666666667px"/&gt;
&lt;col style="width: 62.666666666666666666666666667px"/&gt;
&lt;col style="width: 62.666666666666666666666666667px"/&gt;
&lt;col style="width: 33.333333333333333333333333333px"/&gt;
&lt;/colgroup&gt;
