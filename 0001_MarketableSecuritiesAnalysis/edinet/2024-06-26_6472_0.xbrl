  <jpcrp_cor:NotesRegardingGuaranteeObligationsTextBlock contextRef="CurrentYearInstant">
&lt;p style="margin-left: 0px; line-height: 18px; margin-right: 0px; text-align: left"&gt; &lt;/p&gt;
&lt;p style="margin-left: 0px; line-height: 18px; margin-right: 0px; text-align: left"&gt;　３　偶発債務等&lt;/p&gt;
