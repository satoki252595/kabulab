&lt;td rowspan="2" style="vertical-align:bottom;border-top-color:#000000;border-bottom-color:#000000;border-left-color:#000000;border-right-color:#000000;overflow:hidden;" valign="bottom"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:justify;padding-left:0pt;padding-right:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;line-height:9pt;font-size:9pt;"&gt;&lt;span style="font-size:7.5pt;"&gt;既発行&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:justify;padding-left:0pt;padding-right:0pt;margin-bottom:4.5pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;line-height:9pt;font-size:9pt;"&gt;&lt;span style="font-size:7.5pt;"&gt;株式数&lt;/span&gt;&lt;/p&gt;
