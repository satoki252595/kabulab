&lt;col style="width: 69.333333333333333333333333333px"/&gt;
&lt;col style="width: 61.666666666666666666666666667px"/&gt;
&lt;/colgroup&gt;
&lt;thead&gt;
&lt;tr style="height: 27px"&gt;
