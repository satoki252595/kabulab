&lt;p style="margin-right: 16px; text-align: right"&gt;70,438&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 132.53333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
