&lt;p style="margin-left: 0px; margin-right: 0px; text-align: right"&gt;2024年３月31日現在&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;/div&gt;
&lt;p style="margin-left: 8px; line-height: 1.3333333333333333333333333333px; margin-right: 8px; text-align: right"&gt; &lt;/p&gt;
&lt;div style="margin-left: 0.4666666666666666666666666667px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 646.99999999999999999999999998px"&gt;
&lt;colgroup&gt;
