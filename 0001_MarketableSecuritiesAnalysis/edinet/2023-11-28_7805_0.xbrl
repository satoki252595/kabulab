  <jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock contextRef="FilingDateInstant_jpcrp030000-asr_E34363-000SatouSeiichiMember">
&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 217.33333333333333333333333334px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 68.666666666666666666666666667px"/&gt;
&lt;col style="width: 148.66666666666666666666666667px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr style="height: 15px"&gt;
