  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E05267-000TaizouYokosimaMember">1960-06-09</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
