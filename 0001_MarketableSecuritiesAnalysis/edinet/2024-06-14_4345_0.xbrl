&lt;thead&gt;
&lt;tr style="height: 28.07px"&gt;
&lt;td style="vertical-align: middle; width: 102.93333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
