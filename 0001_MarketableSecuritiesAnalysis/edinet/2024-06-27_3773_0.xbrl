&lt;td style="vertical-align: middle; width: 326.46666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 12px; text-align: left"&gt;現金及び現金同等物増減額（△は減少）&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 156.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 60px; text-align: right"&gt;△985&lt;/p&gt;
