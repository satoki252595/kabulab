&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 222.33333333333333333333333334px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 71.666666666666666666666666667px"/&gt;
