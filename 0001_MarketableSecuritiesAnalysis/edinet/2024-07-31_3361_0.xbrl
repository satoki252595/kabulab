&lt;colgroup&gt;
&lt;col style="width:141pt;min-width:141pt;"/&gt;
&lt;col style="width:54pt;min-width:54pt;"/&gt;
&lt;col style="width:54pt;min-width:54pt;"/&gt;
&lt;col style="width:54pt;min-width:54pt;"/&gt;
&lt;col style="width:54pt;min-width:54pt;"/&gt;
