&lt;td colspan="5" style="vertical-align: middle; width: 593.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;
&lt;p style="margin-left: 321.33333333333333333333333333px; line-height: 15px; text-align: center"&gt;
