  <jpcrp_cor:NotesPerShareInformationFinancialStatementsTextBlock contextRef="CurrentYearDuration">&lt;p style="page-break-before:always; line-height:0.75pt; width:100%; font-size:0.75pt;"&gt; &lt;/p&gt;
&lt;h6 class="smt_head5" style="padding-left:13.5pt;line-height:13pt;font-size:10.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;(１株当たり情報)&lt;/span&gt;
&lt;/h6&gt;&lt;p class="smt_unitR" style="orphans:0;widows:0;line-height:3pt;"&gt;　&lt;/p&gt;
&lt;div class="tbld"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:468pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
&lt;col style="width:156pt;min-width:156pt;"/&gt;
&lt;col style="width:156pt;min-width:156pt;"/&gt;
