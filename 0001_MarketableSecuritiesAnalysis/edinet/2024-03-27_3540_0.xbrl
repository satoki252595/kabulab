&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr style="height: 34px"&gt;
&lt;td style="vertical-align: middle; width: 143.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;
&lt;p style="line-height: 11.333333333333333333333333333px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;役職名&lt;/span&gt;
