  <jpcrp_cor:NotesSignificantAccountingPoliciesFinancialStatementsTextBlock contextRef="CurrentYearDuration">
&lt;h5 class="smt_head4" style="padding-left:18pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;text-align:justify;letter-spacing:0pt;line-height:15pt;"&gt;(重要な会計方針)&lt;/h5&gt;&lt;p class="smt_head6" style="orphans:0;widows:0;line-height:14pt;"&gt;１．資産の評価基準及び評価方法&lt;/p&gt;
&lt;h4 class="smt_head3" style="padding-right:0pt;margin-top:0pt;margin-bottom:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;text-align:justify;letter-spacing:0pt;line-height:14pt;"&gt;(1) 有価証券の評価基準及び評価方法&lt;/h4&gt;
&lt;div class="tbld" style="margin-left:18pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:448.9pt;table-layout:fixed;"&gt;
