  <jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E01879-000SoneHirozumiMember">曽禰　寛純</jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E01879-000SoneHirozumiMember">1955-01-16</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
