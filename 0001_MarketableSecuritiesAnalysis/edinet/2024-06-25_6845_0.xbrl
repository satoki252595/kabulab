&lt;p style="margin-left: 60px; line-height: 13.333333333333333333333333333px; margin-right: 2px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;1986年４月 当社入社&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; line-height: 13.333333333333333333333333333px; margin-right: 2px; text-align: left; text-indent: -55px"&gt;
