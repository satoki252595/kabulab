  <jpcrp_cor:NotesRegardingGuaranteeObligationsTextBlock contextRef="CurrentYearInstant_NonConsolidatedMember">&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:9pt;"&gt;  ２  保証債務&lt;/p&gt;
&lt;div class="tbld" style="margin-left:30pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
