&lt;td style="border-left: 0px none #000000; border-top: 0px none #000000; border-right: 0px none #000000; border-bottom: 0px none #000000; width: 306px; vertical-align: bottom; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 0px; margin-right: 0px; text-align: left; line-height: 18px"&gt;
&lt;img alt="0101010_003.png" src="images/0101010_003.png" style="height: 197.23px; width: 300px"/&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 0px none #000000; border-top: 0px none #000000; border-right: 0px none #000000; border-bottom: 0px none #000000; width: 306px; vertical-align: bottom; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 0px; margin-right: 0px; text-align: right; line-height: 18px"&gt;
&lt;img alt="0101010_004.png" src="images/0101010_004.png" style="height: 189.85px; width: 300px"/&gt;
&lt;/p&gt;
&lt;/td&gt;
