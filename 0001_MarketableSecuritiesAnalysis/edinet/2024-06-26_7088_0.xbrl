  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E35487-000MotohataHirotoMember">1964-01-17</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
