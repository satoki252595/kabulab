&lt;/colgroup&gt;
&lt;tr style="height:15pt;min-height:15pt;"&gt;
&lt;td colspan="3" style="vertical-align:middle;border-top-color:#a9a9a9;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-color:#a9a9a9;border-right-color:#a9a9a9;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:right;"&gt;(単位：百万円)&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
