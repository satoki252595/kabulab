&lt;col style="width:120pt;min-width:120pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:14.3pt;min-height:14.3pt;"&gt;
&lt;td colspan="4" style="vertical-align:middle;border-top-color:#a9a9a9;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-color:#a9a9a9;border-right-color:#a9a9a9;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:right;line-height:12pt;"&gt;　(単位：百万円) &lt;/p&gt;
&lt;/td&gt;
