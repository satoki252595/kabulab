&lt;tr style="height:14pt;min-height:14pt;"&gt;
&lt;td style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;"&gt;2024年５月&lt;/p&gt;
&lt;/td&gt;
