&lt;p style="margin-left: 18px; margin-right: 6px; text-align: left; line-height: 6.6666666666666666666666666667px; text-indent: -12px"&gt; &lt;/p&gt;
&lt;p style="margin-left: 18px; margin-right: 6px; text-align: left; line-height: 6.6666666666666666666666666667px; text-indent: -12px"&gt; &lt;/p&gt;
