  <jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E00464-000NakashimaAmaneMember">中島  周</jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E00464-000NakashimaAmaneMember">1959-09-26</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock contextRef="FilingDateInstant_jpcrp030000-asr_E00464-000NakashimaAmaneMember">
&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 258.66666666666666666666666667px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 58.666666666666666666666666667px"/&gt;
&lt;col style="width: 200px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
