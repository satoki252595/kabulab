  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E05219-000HaibaraYoshioMember">1955-12-14</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
