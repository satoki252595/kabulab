  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditorsProposal contextRef="FilingDateInstant_jpcrp030000-asr_E01002-000YamamotoYuzuruMember">1953-03-08</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditorsProposal>
