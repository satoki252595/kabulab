</jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock>
  <jpcrp_cor:TermOfOfficeInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E37502-000OuchiSatoshiMember">（注）２</jpcrp_cor:TermOfOfficeInformationAboutDirectorsAndCorporateAuditors>
