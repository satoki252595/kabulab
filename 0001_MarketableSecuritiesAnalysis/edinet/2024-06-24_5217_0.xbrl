&lt;tr style="height:21pt;min-height:21pt;"&gt;
&lt;td colspan="5" style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblR" style="orphans:0;widows:0;text-align:center;line-height:8.5pt;font-size:7.5pt;"&gt;計&lt;/p&gt;
