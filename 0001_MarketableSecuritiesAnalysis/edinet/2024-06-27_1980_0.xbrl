&lt;p style="line-height: 18px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;短&lt;/span&gt;
&lt;/p&gt;
&lt;p style="line-height: 18px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;期&lt;/span&gt;
&lt;/p&gt;
&lt;p style="line-height: 18px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;～&lt;/span&gt;
&lt;/p&gt;
&lt;p style="line-height: 18px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;長&lt;/span&gt;
&lt;/p&gt;
