&lt;td style="vertical-align: middle; width: 48px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="line-height: 18px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;小&lt;/span&gt;
