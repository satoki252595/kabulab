  <jpcrp_cor:NotesRegardingNewShareSubscriptionRightsEtcTextBlock contextRef="Prior1YearDuration">
&lt;h3 class="smt_head2" style="font-size:9pt;"&gt;３．新株予約権等に関する事項&lt;/h3&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:18pt;"&gt;該当事項はありません。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;line-height:12.5pt;font-size:12.5pt;"&gt; &lt;/p&gt;</jpcrp_cor:NotesRegardingNewShareSubscriptionRightsEtcTextBlock>
