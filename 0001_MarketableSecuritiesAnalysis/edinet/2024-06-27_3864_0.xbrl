  <jpcrp_cor:AnnexedDetailedScheduleOfPropertyPlantAndEquipmentEtcTextBlock contextRef="CurrentYearDuration">
&lt;h6 class="smt_head5" style="padding-left:40.5pt;"&gt;【有形固定資産等明細表】&lt;/h6&gt;&lt;p class="smt_text5" style="orphans:0;widows:0;text-align:right;padding-left:36pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:0pt;letter-spacing:0pt;line-height:11pt;"&gt;&lt;span style="font-size:9.0pt;"&gt;（単位：百万円）&lt;/span&gt;&lt;/p&gt;
&lt;div class="tbld" style="margin-left:0pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:482.3pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
