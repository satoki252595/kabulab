&lt;p style="line-height: 16px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;又は出資金&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size: 10px"&gt;(千円)&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 57.333333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
