&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 44.866666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 11.333333333333333333333333333px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;所在地&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 54px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 3.3333333333333333333333333333px; line-height: 11.333333333333333333333333333px; margin-right: 3.3333333333333333333333333333px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;資本金又&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 3.3333333333333333333333333333px; line-height: 11.333333333333333333333333333px; margin-right: 3.3333333333333333333333333333px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;は出資金&lt;/span&gt;
&lt;/p&gt;
&lt;p style="line-height: 11.333333333333333333333333333px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;（千円）&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 58.466666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 3.3333333333333333333333333333px; line-height: 11.333333333333333333333333333px; margin-right: 3.3333333333333333333333333333px; text-align: left"&gt;
