&lt;span style="font-size: 10px"&gt;*3　&lt;/span&gt;&lt;span style="font-size: 10px; text-decoration: underline"&gt;A&lt;/span&gt;&lt;span style="font-size: 10px"&gt;dvanced &lt;/span&gt;&lt;span style="font-size: 10px; text-decoration: underline"&gt;D&lt;/span&gt;&lt;span style="font-size: 10px"&gt;river &lt;/span&gt;&lt;span style="font-size: 10px; text-decoration: underline"&gt;A&lt;/span&gt;&lt;span style="font-size: 10px"&gt;ssistance &lt;/span&gt;&lt;span style="font-size: 10px; text-decoration: underline"&gt;S&lt;/span&gt;&lt;span style="font-size: 10px"&gt;ystemの略：先進運転支援システム&lt;/span&gt;
