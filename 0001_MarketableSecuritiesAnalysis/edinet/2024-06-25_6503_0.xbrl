&lt;/tr&gt;
&lt;tr style="height: 26.87px"&gt;
&lt;td style="vertical-align: middle; width: 110.06666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 20px; text-align: justify; text-justify: inter-ideograph"&gt;内、ユーロ&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 153.4px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 20px; text-align: right"&gt;142円&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 151.4px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 20px; text-align: right"&gt;158円&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 138.8px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 20px; text-align: right"&gt;約610億円増&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 26.87px"&gt;
&lt;td style="vertical-align: middle; width: 110.06666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 20px; text-align: justify; text-justify: inter-ideograph"&gt;内、人民元&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 153.4px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 20px; text-align: right"&gt;19.7円&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 151.4px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 20px; text-align: right"&gt;20.2円&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 138.8px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 20px; text-align: right"&gt;約90億円増&lt;/p&gt;
&lt;/td&gt;
