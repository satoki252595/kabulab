&lt;span style="font-size: 10px"&gt;*24　&lt;/span&gt;&lt;span style="font-size: 10px; text-decoration: underline"&gt;H&lt;/span&gt;&lt;span style="font-size: 10px"&gt;igh &lt;/span&gt;&lt;span style="font-size: 10px; text-decoration: underline"&gt;E&lt;/span&gt;&lt;span style="font-size: 10px"&gt;lectron &lt;/span&gt;&lt;span style="font-size: 10px; text-decoration: underline"&gt;M&lt;/span&gt;&lt;span style="font-size: 10px"&gt;obility &lt;/span&gt;&lt;span style="font-size: 10px; text-decoration: underline"&gt;T&lt;/span&gt;&lt;span style="font-size: 10px"&gt;ransistorの略:高電子移動度トランジスタ&lt;/span&gt;
