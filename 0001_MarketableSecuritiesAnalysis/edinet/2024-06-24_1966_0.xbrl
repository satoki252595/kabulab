&lt;/p&gt;
&lt;p style="margin-left: 70.333333333333333333333333333px; line-height: 15px; margin-right: 2px; text-align: left; text-indent: -65.333333333333333333333333333px"&gt;
&lt;span style="font-size: 10px"&gt;令和元年５月 ㈱きょくとう社外監査役(現任)&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 70.333333333333333333333333333px; line-height: 15px; margin-right: 2px; text-align: left; text-indent: -65.333333333333333333333333333px"&gt;
&lt;span style="font-size: 10px"&gt;令和２年６月 ㈱ウチヤマホールディングス社外取締役（監査等委員）(現任)&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 70.333333333333333333333333333px; line-height: 15px; margin-right: 2px; text-align: left; text-indent: -65.333333333333333333333333333px"&gt;
&lt;span style="font-size: 10px"&gt;令和４年６月 当社補欠社外監査役（現任）&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 66.533333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 18px; text-align: right"&gt;
&lt;span style="font-size: 10px"&gt;8&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
