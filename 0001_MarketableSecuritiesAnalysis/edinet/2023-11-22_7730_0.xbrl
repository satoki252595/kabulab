&lt;p style="text-align: center"&gt;差引額&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 164.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
