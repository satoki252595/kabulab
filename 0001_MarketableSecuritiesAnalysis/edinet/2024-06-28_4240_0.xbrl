&lt;col style="width:89.3pt;min-width:89.3pt;"/&gt;
&lt;col style="width:72.8pt;min-width:72.8pt;"/&gt;
&lt;col style="width:65.3pt;min-width:65.3pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:17.9pt;min-height:17.9pt;"&gt;
