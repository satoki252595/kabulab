&lt;/td&gt;
&lt;td style="vertical-align:top;border-top-color:#a9a9a9;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:5.4pt;padding-right:5.4pt;line-height:11pt;"&gt;&lt;span style="font-size:7.5pt;"&gt;常務取締役管理本部長（現任）&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
