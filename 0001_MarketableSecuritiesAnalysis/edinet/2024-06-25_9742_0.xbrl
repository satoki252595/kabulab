&lt;td colspan="5" style="vertical-align: middle; width: 593.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 2px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 2px solid #000000; background-color: #FFFFFF"&gt;
&lt;p style="margin-left: 5px; margin-right: 158.66666666666666666666666667px; text-align: right"&gt;
