&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 54.666666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 2px solid #000000; border-bottom: 2px solid #000000; background-color: #FFFFFF"&gt;
&lt;p style="margin-right: 5px; text-align: right"&gt;
&lt;span style="font-size: 10px"&gt;614&lt;/span&gt;
