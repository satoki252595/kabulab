  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E00766-000AgaEijiMember">1963-01-01</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock contextRef="FilingDateInstant_jpcrp030000-asr_E00766-000AgaEijiMember">
&lt;p style="margin-left: 60px; line-height: 15px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;1985年４月 当社入社&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; line-height: 15px; text-align: left; text-indent: -55px"&gt;
