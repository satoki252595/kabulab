&lt;/tr&gt;
&lt;tr style="height: 1.33px"&gt;
&lt;td style="vertical-align: top; width: 84px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="line-height: 16.666666666666666666666666667px; margin-right: 6px; text-align: right"&gt;７月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 552px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; line-height: 16.666666666666666666666666667px; margin-right: 6px; text-align: justify; text-justify: inter-ideograph"&gt;Novofermグループにおいて、TST Tor-System-Technik GmbH,Duren（現　連結子会社）ほか１社を買収。&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 1.33px"&gt;
&lt;td style="vertical-align: top; width: 84px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="line-height: 16.666666666666666666666666667px; margin-right: 6px; text-align: right"&gt;2005年11月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 552px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
