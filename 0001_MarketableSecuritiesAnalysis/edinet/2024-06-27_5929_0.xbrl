&lt;/div&gt;
&lt;p style="margin-left: 84px; text-align: justify; text-justify: inter-ideograph"&gt; &lt;/p&gt;
&lt;div style="margin-left: 84px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 566.33333333333333333333333334px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 131.46666666666666666666666667px"/&gt;
&lt;col style="width: 434.86666666666666666666666667px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 131.46666666666666666666666667px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: justify; text-justify: inter-ideograph"&gt;ポイント数&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 434.86666666666666666666666667px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
