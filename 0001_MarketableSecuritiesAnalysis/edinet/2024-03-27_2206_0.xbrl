&lt;/tr&gt;
&lt;tr style="height: 25.07px"&gt;
&lt;td style="vertical-align: middle; width: 303.4px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; line-height: 13.333333333333333333333333333px; text-align: justify; text-justify: inter-ideograph"&gt;新株予約権の譲渡に関する事項&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 344.06666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; line-height: 13.333333333333333333333333333px; text-align: justify; text-justify: inter-ideograph"&gt;―&lt;/p&gt;
