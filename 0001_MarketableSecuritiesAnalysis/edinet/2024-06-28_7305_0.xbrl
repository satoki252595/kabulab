&lt;col style="width:340.5pt;min-width:340.5pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:17.9pt;min-height:17.9pt;"&gt;
&lt;td colspan="3" style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:0pt;padding-right:0pt;margin-top:2pt;margin-bottom:2pt;font-family:&amp;apos;ＭＳ Ｐゴシック&amp;apos;;font-size:10.5pt;"&gt;基本方針&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:0pt;padding-right:0pt;margin-top:2pt;margin-bottom:2pt;text-justify:inter-ideograph;text-indent:0pt;font-family:&amp;apos;ＭＳ Ｐゴシック&amp;apos;;letter-spacing:0pt;line-height:14pt;font-size:12pt;"&gt;&lt;b&gt;経営基盤強化と成長戦略の基盤構築&lt;/b&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:6pt;min-height:6pt;"&gt;
