</jpcrp_cor:NotesRegardingNewShareSubscriptionRightsEtcTextBlock>
  <jpcrp_cor:NotesRegardingDividendTextBlock contextRef="Prior1YearDuration_NonConsolidatedMember">
&lt;p style="margin-left: 60px; text-align: left"&gt;３．配当に関する事項&lt;/p&gt;
&lt;p style="margin-left: 72px; text-align: left"&gt;(1）配当金支払額&lt;/p&gt;
&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 648px"&gt;
&lt;colgroup&gt;
