  <jpcrp_cor:NotesRegardingDividendTextBlock contextRef="Prior1YearDuration">
&lt;p style="margin-left: 72.666666666666666666666666667px; text-align: left; text-indent: -60.666666666666666666666666667px"&gt;３．配当に関する事項&lt;/p&gt;
