&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center"&gt;氏名又は名称&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 202.2px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center"&gt;住所&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 82.2px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
