  <jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E04036-000YamamotoTakuyaMember">山本　卓也</jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E04036-000YamamotoTakuyaMember">1954-03-17</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
