  <jpcrp_cor:MajorShareholdersTextBlock contextRef="FilingDateInstant">&lt;p style="page-break-before:always; line-height:0.75pt; width:100%; font-size:0.75pt;"&gt; &lt;/p&gt;
&lt;h4 class="smt_head3"&gt;(6) 【大株主の状況】&lt;/h4&gt;&lt;p class="smt_text1" style="orphans:0;widows:0;padding-left:377.3pt;padding-right:0pt;text-indent:0pt;line-height:10pt;"&gt;&lt;span&gt;2024年２月29日&lt;/span&gt;現在&lt;/p&gt;
&lt;div class="tbld" style="margin-left:0pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:475.5pt;table-layout:fixed;"&gt;
