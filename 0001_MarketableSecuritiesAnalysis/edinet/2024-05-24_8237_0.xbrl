&lt;/tr&gt;
&lt;tr style="height:13.5pt;min-height:13.5pt;"&gt;
&lt;td style="vertical-align:top;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;padding-left:10.0pt;line-height:23pt;"&gt;1986年11月&lt;/p&gt;
&lt;/td&gt;
