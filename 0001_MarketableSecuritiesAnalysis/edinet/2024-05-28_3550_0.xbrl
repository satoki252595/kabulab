  <jpcrp_cor:NotesRegardingNewShareSubscriptionRightsEtcTextBlock contextRef="CurrentYearDuration_NonConsolidatedMember">&lt;p class="smt_head6" style="orphans:0;widows:0;padding-left:0pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;text-align:justify;letter-spacing:0pt;line-height:15pt;font-size:9pt;"&gt;３　新株予約権等に関する事項&lt;/p&gt;&lt;p class="smt_text2" style="orphans:0;widows:0;"&gt;該当事項はありません。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;"&gt; &lt;/p&gt;</jpcrp_cor:NotesRegardingNewShareSubscriptionRightsEtcTextBlock>
