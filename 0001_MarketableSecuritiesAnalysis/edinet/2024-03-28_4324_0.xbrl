&lt;/td&gt;
&lt;td style="vertical-align:top;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:right;padding-left:9pt;padding-right:0pt;text-justify:inter-ideograph;text-indent:0pt;line-height:15pt;"&gt;&lt;span style="font-size:9pt;"&gt;（単位：百万円）&lt;/span&gt;&lt;/p&gt;
