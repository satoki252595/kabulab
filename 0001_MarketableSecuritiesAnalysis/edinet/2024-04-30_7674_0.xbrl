&lt;td style="vertical-align:top;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:0pt;padding-right:3.7pt;line-height:9pt;font-size:7.5pt;"&gt;株式会社Resolve&amp;amp;Capital創業　取締役（現任）&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:9pt;min-height:9pt;"&gt;
&lt;td style="vertical-align:top;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:3.7pt;padding-right:0pt;line-height:9pt;font-size:7.5pt;"&gt;2023年９月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:top;border-bottom-style:solid;border-bottom-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:0pt;padding-right:3.7pt;line-height:9pt;font-size:7.5pt;"&gt;株式会社Long・Time・Capital創業　代表取締役（現任）&lt;/p&gt;
&lt;/td&gt;
