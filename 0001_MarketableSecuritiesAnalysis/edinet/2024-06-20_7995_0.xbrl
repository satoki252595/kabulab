&lt;/div&gt;
&lt;p style="margin-left: 48px; line-height: 1.3333333333333333333333333333px; text-align: justify; text-justify: inter-ideograph"&gt; &lt;/p&gt;
&lt;div style="margin-left: 71.466666666666666666666666667px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 392px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 136px"/&gt;
&lt;col style="width: 128px"/&gt;
