&lt;div class="tbld" style="text-align:right;margin-left:0pt;margin-right:3.8pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" class="align_right" style="border-collapse:collapse;border:solid 0pt #000000;width:49.4pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
