&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 180px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 60px; line-height: 13.333333333333333333333333333px; text-align: center"&gt;当事業年度&lt;/p&gt;
&lt;p style="margin-left: 60px; line-height: 13.333333333333333333333333333px; text-align: center"&gt;（2024年３月31日）&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/thead&gt;
&lt;tbody&gt;
&lt;tr style="height: 1.33px"&gt;
&lt;td style="vertical-align: middle; width: 220px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; margin-right: 4px; text-align: left"&gt;再評価を行った土地の期末における時価と再評価後の帳簿価額との差額&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 180px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
