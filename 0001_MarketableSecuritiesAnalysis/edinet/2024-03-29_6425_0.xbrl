&lt;col style="width: 104px"/&gt;
&lt;col style="width: 88px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr style="height: 19px"&gt;
&lt;td rowspan="2" style="vertical-align: middle; width: 145.46666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;
&lt;p style="margin-left: 6px; text-align: center"&gt;役員区分&lt;/p&gt;
&lt;/td&gt;
