  <jpcrp_cor:DateOfResolutionDividendsOfSurplus contextRef="FilingDateInstant_Row1Member">2023-10-06</jpcrp_cor:DateOfResolutionDividendsOfSurplus>
  <jpcrp_cor:ResolutionDividendsOfSurplus contextRef="FilingDateInstant_Row1Member"> 取締役会決議</jpcrp_cor:ResolutionDividendsOfSurplus>
  <jpcrp_cor:DateOfResolutionDividendsOfSurplus contextRef="FilingDateInstant_Row2Member">2024-04-12</jpcrp_cor:DateOfResolutionDividendsOfSurplus>
