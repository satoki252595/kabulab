&lt;/td&gt;
&lt;td style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:0pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:0pt;letter-spacing:0pt;line-height:18pt;"&gt;&lt;span style="font-size:9.0pt;"&gt;粉末冶金製品の製造販売&lt;/span&gt;&lt;/p&gt;
