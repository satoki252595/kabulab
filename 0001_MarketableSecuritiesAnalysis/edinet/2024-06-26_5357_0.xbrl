&lt;col style="width:30pt;min-width:30pt;"/&gt;
&lt;col style="width:30pt;min-width:30pt;"/&gt;
&lt;col style="width:30pt;min-width:30pt;"/&gt;
&lt;col style="width:45pt;min-width:45pt;"/&gt;
&lt;/colgroup&gt;
