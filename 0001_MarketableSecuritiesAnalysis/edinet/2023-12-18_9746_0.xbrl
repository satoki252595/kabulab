&lt;p style="text-align: left"&gt; &lt;/p&gt;
&lt;p style="text-align: left"&gt; &lt;/p&gt;
&lt;p style="text-align: left"&gt; &lt;/p&gt;
&lt;div style="margin-left: 24px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 613.33333333333333333333333334px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 66.666666666666666666666666667px"/&gt;
&lt;col style="width: 106.66666666666666666666666667px"/&gt;
