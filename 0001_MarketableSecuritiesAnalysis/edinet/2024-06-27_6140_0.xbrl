&lt;/tr&gt;
&lt;tr style="height:14.3pt;min-height:14.3pt;"&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-color:#a9a9a9;border-left-color:#a9a9a9;border-right-color:#a9a9a9;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;letter-spacing:0pt;line-height:10pt;"&gt;差引額&lt;/p&gt;
