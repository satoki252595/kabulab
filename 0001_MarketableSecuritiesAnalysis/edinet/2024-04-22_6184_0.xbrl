&lt;td style="vertical-align:top;border-top-color:#a9a9a9;border-left-color:#a9a9a9;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;font-size:7.5pt;"&gt;&lt;span style="font-size:7.5pt;"&gt;2017年３月&lt;/span&gt;&lt;/p&gt;
