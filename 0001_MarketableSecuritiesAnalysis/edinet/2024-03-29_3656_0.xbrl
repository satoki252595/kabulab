  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E25867-000MoritaHidekatsuMember">1974-08-14</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
