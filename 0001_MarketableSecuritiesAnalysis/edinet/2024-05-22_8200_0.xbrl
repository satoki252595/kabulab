&lt;p style="line-height: 17.333333333333333333333333333px; text-align: left"&gt;建物及び構築物&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 118px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 17.333333333333333333333333333px; margin-right: 1.6px; text-align: right"&gt;223,939千円&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
