  <jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E03099-000FukuharaFumioMember">福原　扶美勇</jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E03099-000FukuharaFumioMember">1962-09-14</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock contextRef="FilingDateInstant_jpcrp030000-asr_E03099-000FukuharaFumioMember">
&lt;p style="margin-left: 60px; line-height: 15px; margin-right: 2px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;1997年９月 当社入社&lt;/span&gt;
