&lt;td style="vertical-align: top; width: 165.46666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 5px; line-height: 12px; margin-right: 5px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;類法律会計事務所開設　代表&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 5px; line-height: 12px; margin-right: 5px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;弁護士・公認会計士（現任）&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;/div&gt;

&lt;p style="line-height: 1.3333333333333333333333333333px; text-align: center"&gt;　&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 42px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;
