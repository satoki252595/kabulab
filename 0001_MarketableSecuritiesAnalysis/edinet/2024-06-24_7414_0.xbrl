&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 77.933333333333333333333333333px; padding-top: 1px; padding-bottom: 1px; padding-left: 6.6px; padding-right: 6.6px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
