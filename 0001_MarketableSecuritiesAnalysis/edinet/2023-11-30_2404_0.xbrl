&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-color:#000000;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:right;line-height:10pt;font-size:10.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;(単位：千円)&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
