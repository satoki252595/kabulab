&lt;div class="tbld" style="margin-left:30pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:408.6pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
&lt;col style="width:161pt;min-width:161pt;"/&gt;
&lt;col style="width:123.8pt;min-width:123.8pt;"/&gt;
&lt;col style="width:123.8pt;min-width:123.8pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:17.9pt;min-height:17.9pt;"&gt;
