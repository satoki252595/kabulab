&lt;/td&gt;
&lt;td style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:right;padding-right:40.5pt;"&gt;△8,145&lt;/p&gt;
&lt;/td&gt;
