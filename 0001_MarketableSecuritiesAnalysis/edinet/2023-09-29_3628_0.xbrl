&lt;p style="margin-left: 12px; line-height: 17.333333333333333333333333333px; margin-right: 12px; text-align: left"&gt;2012年10月&lt;/p&gt;
&lt;p style="margin-left: 12px; line-height: 17.333333333333333333333333333px; margin-right: 12px; text-align: left"&gt;2013年３月&lt;/p&gt;
&lt;p style="margin-left: 12px; line-height: 17.333333333333333333333333333px; margin-right: 12px; text-align: left"&gt;2014年９月&lt;/p&gt;
