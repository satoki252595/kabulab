&lt;td style="vertical-align: top; width: 88.2px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 12px; line-height: 17.333333333333333333333333333px; margin-right: 12px; text-align: left"&gt;2022年８月&lt;/p&gt;
&lt;p style="margin-left: 12px; line-height: 17.333333333333333333333333333px; margin-right: 12px; text-align: left"&gt;2022年10月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 556.8px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 12px; line-height: 17.333333333333333333333333333px; margin-right: 12px; text-align: left"&gt;㈱ディー・エヌ・エーの連結子会社となる。（現：親会社）&lt;/p&gt;
&lt;p style="margin-left: 12px; line-height: 17.333333333333333333333333333px; margin-right: 12px; text-align: left"&gt;㈱ディー・エヌ・エーよりＤｅＳＣヘルスケア㈱の株式を取得し子会社とする。（現：連結子会社）&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
