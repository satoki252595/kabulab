&lt;td style="vertical-align: top; width: 59.066666666666666666666666667px; padding-top: 6.6666666666666666666666666667px; padding-bottom: 6.6666666666666666666666666667px; padding-left: 6.6666666666666666666666666667px; padding-right: 6.6666666666666666666666666667px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt;
&lt;span style="font-weight: bold"&gt;項目&lt;/span&gt;
&lt;/p&gt;
