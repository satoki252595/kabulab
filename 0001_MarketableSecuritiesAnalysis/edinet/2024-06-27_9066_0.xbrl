&lt;col style="width:29pt;min-width:29pt;"/&gt;
&lt;col style="width:29pt;min-width:29pt;"/&gt;
&lt;col style="width:66.8pt;min-width:66.8pt;"/&gt;
&lt;col style="width:65pt;min-width:65pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:22.5pt;min-height:22.5pt;"&gt;
&lt;td rowspan="3" style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;letter-spacing:0pt;font-size:7.5pt;"&gt;名称&lt;/p&gt;
&lt;/td&gt;
