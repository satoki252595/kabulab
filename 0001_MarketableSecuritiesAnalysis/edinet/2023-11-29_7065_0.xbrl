  <jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E31743-000SakataYoshiyaMember">酒田　義矢</jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E31743-000SakataYoshiyaMember">1964-05-30</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock contextRef="FilingDateInstant_jpcrp030000-asr_E31743-000SakataYoshiyaMember">
&lt;p style="margin-left: 65px; line-height: 15px; margin-right: 3px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;1988年４月　積水化学工業㈱入社&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 15px; margin-right: 3px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;1994年11月　ウベパレット㈱（現当社）&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 15px; margin-right: 3px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;　　　　　　専務取締役&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 15px; margin-right: 3px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;1998年11月　同社（現当社）&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 15px; margin-right: 3px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;　　　　　　代表取締役社長&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 15px; margin-right: 3px; text-align: left; text-indent: -60px"&gt;
