&lt;colgroup&gt;
&lt;col style="width:160.4pt;min-width:160.4pt;"/&gt;
&lt;col style="width:170.1pt;min-width:170.1pt;"/&gt;
&lt;col style="width:138.8pt;min-width:138.8pt;"/&gt;
