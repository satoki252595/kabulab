&lt;col style="width:80.3pt;min-width:80.3pt;"/&gt;
&lt;col style="width:80.3pt;min-width:80.3pt;"/&gt;
&lt;col style="width:80.3pt;min-width:80.3pt;"/&gt;
&lt;col style="width:80.3pt;min-width:80.3pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:17.9pt;min-height:17.9pt;"&gt;
