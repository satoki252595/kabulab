  <jpcrp_cor:MajorShareholdersTextBlock contextRef="FilingDateInstant">&lt;p style="page-break-before:always; line-height:0.75pt; width:100%; font-size:0.75pt;"&gt; &lt;/p&gt;
&lt;h4 class="smt_head3" style="line-height:14pt;"&gt;(6)【大株主の状況】&lt;/h4&gt;&lt;p class="smt_unitR" style="orphans:0;widows:0;padding-left:387.3pt;"&gt;&lt;span&gt;2024年３月31日&lt;/span&gt;現在&lt;/p&gt;
&lt;div class="tbld" style="text-align:right;margin-left:0pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
