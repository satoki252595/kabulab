&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;background-color:#ebf1dd;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:5pt;padding-right:5pt;margin-bottom:0pt;line-height:21pt;font-size:10.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;パートナーシップと&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:9pt;"&gt;イノベーションの推進&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;background-color:#ebf1dd;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:5pt;padding-right:5pt;margin-bottom:0pt;line-height:16pt;font-size:10.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;●デジタル技術の活用&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:9pt;"&gt;(ＡＩ,ＩоＴ,ロボットなど)&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:9pt;"&gt;●開かれたパートナーシップ&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:9pt;"&gt;●イノベーションの推進&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;background-color:#ebf1dd;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:5pt;padding-right:5pt;margin-bottom:0pt;line-height:14pt;font-size:10.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;●施設やプラントの付加価値向上&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:9pt;"&gt;●ＥＰＣ業務、運転管理・メンテナンスサービスにおける競争力強化&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:9pt;"&gt;●オープンイノベーションの推進&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:9pt;"&gt;●既存事業やサービス拡充に資する新事業の推進&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:9pt;"&gt;●社会やお客様に求められる技術や製品の開発&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:62pt;min-height:62pt;"&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;background-color:#ebf1dd;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:5pt;padding-right:5pt;margin-bottom:0pt;line-height:21pt;font-size:10.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;人材の活躍促進&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;background-color:#ebf1dd;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:5pt;padding-right:5pt;margin-bottom:0pt;line-height:16pt;font-size:10.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;●人材の確保・育成&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:9pt;"&gt;●ダイバーシティの推進&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:9pt;"&gt;●従業員満足度の向上&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;background-color:#ebf1dd;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:5pt;padding-right:5pt;margin-bottom:0pt;line-height:14pt;font-size:10.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;●新卒・キャリア採用の推進&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:9pt;"&gt;●社会変化に応じた最適な人事諸制度の構築&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:9pt;"&gt;●効果的な育成システムの構築&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:9pt;"&gt;●多様な人材の雇用促進と就労支援体制の整備&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:49.5pt;min-height:49.5pt;"&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;background-color:#ebf1dd;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:5pt;padding-right:5pt;margin-bottom:0pt;line-height:21pt;font-size:10.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;安全と健康の確保&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;background-color:#ebf1dd;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:5pt;padding-right:5pt;margin-bottom:0pt;line-height:16pt;font-size:10.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;●労働安全衛生の確保&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:9pt;"&gt;●従業員の健康管理&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:9pt;"&gt;●働きやすい環境の整備&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;background-color:#ebf1dd;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:5pt;padding-right:5pt;margin-bottom:0pt;line-height:14pt;font-size:10.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;●労働災害発生の抑制&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:9pt;"&gt;●健康障がいの防止および過重労働の是正&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:9pt;"&gt;●働き方改革の推進&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:88pt;min-height:88pt;"&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;background-color:#fbd5b5;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:5pt;padding-right:5pt;margin-bottom:0pt;line-height:21pt;font-size:10.5pt;"&gt;&lt;span style="font-size:13.5pt;"&gt;&lt;b&gt;G&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;background-color:#fdeada;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:5pt;padding-right:5pt;margin-bottom:0pt;line-height:21pt;font-size:10.5pt;"&gt;&lt;span style="font-family:&amp;apos;ＭＳ 明朝&amp;apos;;font-size:9pt;"&gt;コーポレート・ガバナンスの強化&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;background-color:#fdeada;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:5pt;padding-right:5pt;margin-bottom:0pt;line-height:16pt;font-size:10.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;●コーポレート・ガバナンスの強化&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:9pt;"&gt;●リスクマネジメントの強化&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:9pt;"&gt;●コンプライアンスの徹底&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;background-color:#fdeada;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:5pt;padding-right:5pt;margin-bottom:0pt;line-height:14pt;font-size:10.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;●取締役会実効性評価等を通じた継続的改善&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:9pt;"&gt;●適正な内部監査の継続&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:9pt;"&gt;●リスクマネジメント活動のさらなる実効性向上&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:9pt;"&gt;●プロジェクトリスク管理のさらなる徹底&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:9pt;"&gt;●ＢＣＰの運用と継続的な見直し&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:9pt;"&gt;●コンプライアンス教育の継続的な推進&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/table&gt;&lt;p style="clear:both; line-height:0.75pt; width:100%; font-size:0.75pt;"&gt; &lt;/p&gt;
&lt;/div&gt;&lt;p class="smt_text3" style="orphans:0;widows:0;padding-right:9pt;text-indent:-9pt;"&gt;&lt;span style="font-size:9pt;"&gt;※優先的に取り組むべき重要課題の１つとして「気候変動対策への貢献」を掲げるとともに、気候関連財務情報開示タスクフォース（ＴＣＦＤ）提言に賛同し、気候変動に関するリスク低減と機会創出に向けた対応策を策定しております。なお、最新の取り組み状況等については、&lt;/span&gt;&lt;span style="font-size:9pt;"&gt;当社ウェブサイト&lt;/span&gt;&lt;span style="font-size:9pt;"&gt;等を通じて情報発信してまいります。&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_text3" style="orphans:0;widows:0;text-align:justify;padding-left:18pt;padding-right:9pt;margin-top:0pt;margin-bottom:0pt;text-indent:-9pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;font-size:15pt;"&gt; &lt;/p&gt;</jpcrp_cor:StrategyTextBlock>
  <jpcrp_cor:ReferenceToOtherInformationStrategy contextRef="FilingDateInstant">&lt;span style="font-size:9pt;"&gt;当社ウェブサイト&lt;/span&gt;</jpcrp_cor:ReferenceToOtherInformationStrategy>
  <jpcrp_cor:MetricsAndTargetsTextBlock contextRef="FilingDateInstant">&lt;p style="page-break-before:always; line-height:0.75pt; width:100%; font-size:0.75pt;"&gt; &lt;/p&gt;
&lt;h4 class="smt_head3"&gt;&lt;span style="font-size:9pt;"&gt;・指標及び目標&lt;/span&gt;
&lt;/h4&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:18pt;margin-bottom:0pt;text-indent:9pt;line-height:15pt;font-size:10.5pt;"&gt;&lt;span style="font-family:&amp;apos;ＭＳ 明朝&amp;apos;;font-size:9pt;"&gt;ＫＰＩ及びそれに対する2023年度末時点の進捗状況は以下のとおりです。&lt;/span&gt;&lt;/p&gt;
&lt;div class="tbld" style="margin-left:-0.3pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:480.4pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
&lt;col style="width:90.4pt;min-width:90.4pt;"/&gt;
&lt;col style="width:195pt;min-width:195pt;"/&gt;
&lt;col style="width:195pt;min-width:195pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:5.4pt;padding-right:5.4pt;margin-bottom:0pt;line-height:15pt;font-size:10.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;重要課題&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:5.4pt;padding-right:5.4pt;margin-bottom:0pt;line-height:15pt;font-size:10.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;ＫＰＩ&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:5.4pt;padding-right:5.4pt;margin-bottom:0pt;line-height:15pt;font-size:10.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;進捗&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:5.4pt;padding-right:5.4pt;margin-bottom:0pt;line-height:15pt;font-size:10.5pt;"&gt;&lt;span style="font-family:&amp;apos;ＭＳ 明朝&amp;apos;;font-size:9pt;"&gt;（2023年度末時点）&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td style="vertical-align:top;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:justify;padding-left:5.4pt;padding-right:5.4pt;margin-bottom:0pt;line-height:15pt;font-size:10.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;気候変動対策への貢献&lt;/span&gt;&lt;/p&gt;
