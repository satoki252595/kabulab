&lt;td style="vertical-align:top;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:5.4pt;padding-right:5.4pt;margin-top:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:14pt;font-size:9pt;"&gt;&lt;span style="font-size:9pt;"&gt;男性労働者の&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:9pt;"&gt;育児休業等&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:9pt;"&gt;取得率&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:9pt;"&gt;（注）２&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
