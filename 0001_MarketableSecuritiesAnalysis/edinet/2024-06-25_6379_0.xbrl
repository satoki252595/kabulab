&lt;tr style="height:14.5pt;min-height:14.5pt;"&gt;
&lt;td style="vertical-align:top;border-top-color:#a9a9a9;border-bottom-color:#a9a9a9;border-left-color:#a9a9a9;border-right-color:#a9a9a9;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblR" style="orphans:0;widows:0;padding-right:0pt;line-height:14.5pt;"&gt;1938年７月&lt;/p&gt;
&lt;/td&gt;
