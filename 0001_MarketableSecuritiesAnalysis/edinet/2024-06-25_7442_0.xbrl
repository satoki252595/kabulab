&lt;td style="vertical-align: middle; width: 153.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none ; background-color: #FFFFFF"&gt;
&lt;p style="line-height: 15.6px; margin-right: 3px; text-align: right"&gt;
4,993,572
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 153.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none ; background-color: #FFFFFF"&gt;
&lt;p style="line-height: 15.6px; margin-right: 3px; text-align: right"&gt;
5,756,887
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 1.33px"&gt;
&lt;td style="vertical-align: middle; width: 320px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none ; background-color: #CCEEFF"&gt;
&lt;p style="margin-left: 10px; line-height: 15.6px; text-align: left"&gt;現金及び現金同等物の期末残高&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 153.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000; background-color: #CCEEFF"&gt;
&lt;p style="line-height: 15.6px; margin-right: 3px; text-align: right"&gt;
&lt;span style="font-size: 8px"&gt;※&lt;/span&gt;&lt;span style="font-size: 8px"&gt; &lt;/span&gt;5,756,887
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 153.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000; background-color: #CCEEFF"&gt;
&lt;p style="line-height: 15.6px; margin-right: 3px; text-align: right"&gt;
&lt;span style="font-size: 8px"&gt;※&lt;/span&gt;&lt;span style="font-size: 8px"&gt; &lt;/span&gt;6,435,242
&lt;/p&gt;
