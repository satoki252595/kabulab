&lt;/div&gt;
&lt;p style="margin-left: 48px; line-height: 1; text-align: left"&gt; &lt;/p&gt;
&lt;p style="margin-left: 48px; line-height: 1; text-align: left"&gt;（下写真）グループ各社のトップのメッセージを掲載&lt;/p&gt;
&lt;div style="margin-left: 48px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 612.00000000000000000000000001px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 201.86666666666666666666666667px"/&gt;
&lt;col style="width: 219.86666666666666666666666667px"/&gt;
&lt;col style="width: 190.26666666666666666666666667px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr style="height: 133.33px"&gt;
&lt;td style="border-left: 0px none #000000; border-top: 0px none #000000; border-right: 0px none #000000; border-bottom: 0px none #000000; width: 201.86666666666666666666666667px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 0px; margin-right: 0px; text-align: left; line-height: 1"&gt;
&lt;img alt="0102010_025.png" src="images/0102010_025.png" style="height: 119px; width: 197.87px"/&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 0px none #000000; border-top: 0px none #000000; border-right: 0px none #000000; border-bottom: 0px none #000000; width: 219.86666666666666666666666667px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
