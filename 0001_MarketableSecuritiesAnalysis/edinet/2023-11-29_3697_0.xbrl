&lt;h6 class="smt_head5"&gt;③　単価情報&lt;/h6&gt;
&lt;div class="tbld" style="margin-left:17pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:465.4pt;table-layout:fixed;"&gt;
