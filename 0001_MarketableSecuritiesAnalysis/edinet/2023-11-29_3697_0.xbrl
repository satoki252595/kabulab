&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:16.8pt;min-height:16.8pt;"&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:9pt;padding-right:0pt;margin-top:2pt;margin-bottom:0pt;line-height:10pt;"&gt;投資有価証券&lt;/p&gt;
&lt;/td&gt;
