&lt;col style="width:63.8pt;min-width:63.8pt;"/&gt;
&lt;col style="width:63.8pt;min-width:63.8pt;"/&gt;
&lt;col style="width:63.8pt;min-width:63.8pt;"/&gt;
&lt;col style="width:63.8pt;min-width:63.8pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:22.7pt;min-height:22.7pt;"&gt;
&lt;td rowspan="3" style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;"&gt;役員区分&lt;/p&gt;
