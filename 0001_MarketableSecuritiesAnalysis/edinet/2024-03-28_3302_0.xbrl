  <jpcrp_cor:DetailsOfEmployeeShareOptionProgramTextBlock contextRef="FilingDateInstant">
&lt;h5&gt;①【ストックオプション制度の内容】&lt;/h5&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: left"&gt; &lt;/p&gt;
&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 647.99999999999999999999999999px"&gt;
&lt;colgroup&gt;
