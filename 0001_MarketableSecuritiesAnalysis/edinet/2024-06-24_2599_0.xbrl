&lt;p style="line-height: 17.333333333333333333333333333px; margin-right: 6px; text-align: right"&gt;1,431&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 150.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 17.333333333333333333333333333px; margin-right: 6px; text-align: right"&gt;3,061&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 125.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 17.333333333333333333333333333px; margin-right: 6px; text-align: right"&gt;1,630&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 36px"&gt;
&lt;td style="vertical-align: middle; width: 185.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; line-height: 17.333333333333333333333333333px; text-align: left"&gt;投資活動による&lt;/p&gt;
&lt;p style="margin-left: 6px; line-height: 17.333333333333333333333333333px; text-align: left"&gt;キャッシュ・フロー&lt;/p&gt;
&lt;/td&gt;
