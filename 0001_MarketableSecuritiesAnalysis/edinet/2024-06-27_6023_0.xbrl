&lt;td style="vertical-align:middle;border-bottom-style:solid;border-bottom-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblR" style="orphans:0;widows:0;padding-right:43pt;letter-spacing:0pt;line-height:10pt;"&gt;1,577,595&lt;/p&gt;
&lt;/td&gt;
