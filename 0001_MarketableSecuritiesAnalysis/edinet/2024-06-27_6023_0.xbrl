&lt;col style="width:18pt;min-width:18pt;"/&gt;
&lt;col style="width:72.8pt;min-width:72.8pt;"/&gt;
&lt;col style="width:108.8pt;min-width:108.8pt;"/&gt;
&lt;col style="width:283.5pt;min-width:283.5pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:17.3pt;min-height:17.3pt;"&gt;
