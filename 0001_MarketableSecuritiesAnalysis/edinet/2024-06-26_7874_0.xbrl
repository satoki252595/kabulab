&lt;tr style="height:9.8pt;min-height:9.8pt;"&gt;
&lt;td style="vertical-align:top;border-bottom-color:#a9a9a9;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;padding-left:0pt;padding-right:0pt;margin-top:0pt;letter-spacing:0pt;line-height:10.5pt;font-size:7.5pt;"&gt;1972年４月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:top;border-bottom-color:#a9a9a9;border-left-style:solid;border-left-width:0.75pt;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:4.0pt;padding-right:4.0pt;line-height:10.5pt;font-size:7.5pt;"&gt;ジェーアイシー㈱入社&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:9.8pt;min-height:9.8pt;"&gt;
&lt;td style="vertical-align:top;border-top-color:#a9a9a9;border-bottom-color:#a9a9a9;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;padding-left:0pt;padding-right:0pt;margin-top:0pt;letter-spacing:0pt;line-height:10.5pt;font-size:7.5pt;"&gt;1983年３月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:top;border-top-color:#a9a9a9;border-bottom-color:#a9a9a9;border-left-style:solid;border-left-width:0.75pt;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:4.0pt;padding-right:4.0pt;line-height:10.5pt;font-size:7.5pt;"&gt;当社設立  代表取締役社長&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:9.8pt;min-height:9.8pt;"&gt;
