&lt;/td&gt;
&lt;td style="vertical-align:bottom;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="bottom"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;"&gt;(自　&lt;span&gt;2023年４月１日&lt;/span&gt;&lt;br/&gt;　至　&lt;span&gt;2024年３月31日&lt;/span&gt;)&lt;/p&gt;
