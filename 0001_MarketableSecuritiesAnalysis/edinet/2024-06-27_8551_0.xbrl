&lt;/td&gt;
&lt;td colspan="2" style="vertical-align:top;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-left-color:#a9a9a9;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;line-height:12pt;"&gt;前事業年度&lt;/p&gt;
