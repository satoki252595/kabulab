&lt;p style="margin-left: 8px; margin-right: 8px; text-align: right"&gt;2,067,639&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: bottom; width: 212px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
