&lt;col style="width: 93.8px"/&gt;
&lt;col style="width: 93.8px"/&gt;
&lt;col style="width: 115px"/&gt;
&lt;col style="width: 91px"/&gt;
&lt;col style="width: 91px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
