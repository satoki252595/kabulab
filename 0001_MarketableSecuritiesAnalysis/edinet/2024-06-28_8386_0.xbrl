&lt;col style="width:38.8pt;min-width:38.8pt;"/&gt;
&lt;col style="width:39pt;min-width:39pt;"/&gt;
&lt;col style="width:39pt;min-width:39pt;"/&gt;
&lt;col style="width:39pt;min-width:39pt;"/&gt;
