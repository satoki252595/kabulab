&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblR" style="orphans:0;widows:0;padding-left:0pt;padding-right:34pt;letter-spacing:0pt;line-height:10pt;"&gt;13,259百万円&lt;/p&gt;
&lt;/td&gt;
