&lt;span style="font-size: 10px"&gt;1,063,940&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 51.333333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 15px; margin-right: 1.3333333333333333333333333333px; text-align: right"&gt;
&lt;span style="font-size: 10px"&gt;22,744&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 59.333333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 15px; margin-right: 1.3333333333333333333333333333px; text-align: right"&gt;
&lt;span style="font-size: 10px"&gt;1,086,685&lt;/span&gt;
&lt;/p&gt;
