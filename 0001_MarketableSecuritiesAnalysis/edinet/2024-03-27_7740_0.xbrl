  <jpcrp030000-asr_E02308-000:DescriptionOfMetricsRelatedToPolicyOnHumanResourceDevelopmentAndImprovementOfInternalEnvironmentAndTargetsAndResultsUsingSuchMetricsMetricsAndTargetsTextBlock contextRef="FilingDateInstant">
&lt;p style="margin-left: 36px; text-align: left"&gt;＜人的資本経営＞&lt;/p&gt;
&lt;p style="margin-left: 36px; text-align: left"&gt;人的資本経営に関する指標及び目標は以下のとおりに設定しております。&lt;/p&gt;
&lt;div style="margin-left: 36px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 614.73333333333333333333333333px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 204.06666666666666666666666667px"/&gt;
&lt;col style="width: 205.33333333333333333333333333px"/&gt;
&lt;col style="width: 205.33333333333333333333333333px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 204.06666666666666666666666667px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center"&gt;
&lt;span style="font-weight: bold"&gt;指標&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
