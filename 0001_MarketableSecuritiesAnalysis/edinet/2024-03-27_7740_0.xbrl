&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 254.66666666666666666666666666px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 71.333333333333333333333333333px"/&gt;
&lt;col style="width: 183.33333333333333333333333333px"/&gt;
&lt;/colgroup&gt;
