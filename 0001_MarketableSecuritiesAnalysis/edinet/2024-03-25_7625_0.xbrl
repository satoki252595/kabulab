&lt;table cellpadding="0" cellspacing="0" class="align_center" style="border-collapse:collapse;border:solid 0pt #000000;width:348pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
&lt;col style="width:174pt;min-width:174pt;"/&gt;
