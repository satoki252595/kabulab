&lt;p style="margin-left: 18px; margin-right: 8px; text-align: left"&gt;のれん&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 128px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
