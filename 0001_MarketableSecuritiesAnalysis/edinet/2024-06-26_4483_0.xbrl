&lt;p style="text-align: center"&gt;2020年４月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 578.46666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
