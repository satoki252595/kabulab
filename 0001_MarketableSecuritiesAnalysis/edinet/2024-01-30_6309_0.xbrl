&lt;col style="width:48.7pt;min-width:48.7pt;"/&gt;
&lt;col style="width:48.8pt;min-width:48.8pt;"/&gt;
&lt;col style="width:48.7pt;min-width:48.7pt;"/&gt;
&lt;col style="width:48.7pt;min-width:48.7pt;"/&gt;
&lt;col style="width:48.8pt;min-width:48.8pt;"/&gt;
