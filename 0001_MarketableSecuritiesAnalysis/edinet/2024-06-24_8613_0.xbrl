  <jpcrp_cor:NotesLeasesConsolidatedFinancialStatementsTextBlock contextRef="CurrentYearDuration">&lt;p class="smt_head6" style="orphans:0;widows:0;padding-left:18pt;"&gt;(リース取引関係)&lt;/p&gt;
