&lt;/colgroup&gt;
&lt;tr style="height:11.3pt;min-height:11.3pt;"&gt;
&lt;td style="vertical-align:top;border-bottom-color:#a9a9a9;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;padding-left:0pt;padding-right:0pt;margin-top:0pt;letter-spacing:0pt;line-height:10pt;font-size:7.5pt;"&gt;1986年４月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:top;border-bottom-color:#a9a9a9;border-left-style:solid;border-left-width:0.75pt;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;line-height:9.4pt;font-size:7.5pt;"&gt;当社入社&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:11.3pt;min-height:11.3pt;"&gt;
&lt;td style="vertical-align:top;border-top-color:#a9a9a9;border-bottom-color:#a9a9a9;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;padding-left:0pt;padding-right:0pt;margin-top:0pt;letter-spacing:0pt;line-height:10pt;font-size:7.5pt;"&gt;2003年４月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:top;border-top-color:#a9a9a9;border-bottom-color:#a9a9a9;border-left-style:solid;border-left-width:0.75pt;border-right-color:#a9a9a9;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;line-height:9.4pt;font-size:7.5pt;"&gt;当社人事部長&lt;/p&gt;
&lt;/td&gt;
