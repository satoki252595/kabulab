&lt;col style="width:17.3pt;min-width:17.3pt;"/&gt;
&lt;col style="width:70.5pt;min-width:70.5pt;"/&gt;
&lt;col style="width:34.5pt;min-width:34.5pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:37.5pt;min-height:37.5pt;"&gt;
