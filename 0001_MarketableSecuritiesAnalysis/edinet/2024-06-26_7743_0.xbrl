&lt;p style="text-align: center"&gt;区分&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 170px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
