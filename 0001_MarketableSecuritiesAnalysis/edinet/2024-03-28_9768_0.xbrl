&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:1.5pt;border-bottom-style:solid;border-bottom-width:1.5pt;border-left-style:solid;border-left-width:1.5pt;border-right-style:solid;border-right-width:1.5pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;line-height:9pt;font-size:7.5pt;"&gt;氏名&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:1.5pt;border-bottom-style:solid;border-bottom-width:1.5pt;border-left-style:solid;border-left-width:1.5pt;border-right-style:solid;border-right-width:1.5pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;line-height:9pt;font-size:7.5pt;"&gt;生年月日&lt;/p&gt;
