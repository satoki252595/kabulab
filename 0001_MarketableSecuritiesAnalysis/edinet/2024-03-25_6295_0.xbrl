  <jpcrp_cor:NotesAssetRetirementObligationsFinancialStatementsTextBlock contextRef="CurrentYearDuration">
&lt;h6 class="smt_head5" style="padding-left:18pt;"&gt;(資産除去債務関係)&lt;/h6&gt;&lt;p class="smt_text2" style="orphans:0;widows:0;text-align:justify;padding-left:9pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:9pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;"&gt;　該当事項はありません。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;line-height:20pt;font-size:20pt;"&gt; &lt;/p&gt;</jpcrp_cor:NotesAssetRetirementObligationsFinancialStatementsTextBlock>
  <jpcrp_cor:NotesRealEstateForLeaseEtcFinancialStatementsTextBlock contextRef="CurrentYearDuration">
&lt;h6 class="smt_head5" style="padding-left:18pt;"&gt;(賃貸等不動産関係)&lt;/h6&gt;&lt;p class="smt_text2" style="orphans:0;widows:0;text-align:justify;padding-left:9pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:9pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;font-size:9pt;"&gt;　重要性が乏しいため記載を省略しております。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;line-height:20pt;font-size:20pt;"&gt; &lt;/p&gt;</jpcrp_cor:NotesRealEstateForLeaseEtcFinancialStatementsTextBlock>
