&lt;/td&gt;
&lt;td style="vertical-align:bottom;border-top-color:#a9a9a9;border-bottom-color:#a9a9a9;border-left-color:#a9a9a9;border-right-color:#a9a9a9;overflow:hidden;" valign="bottom"&gt;&lt;p class="smt_tblR" style="orphans:0;widows:0;padding-left:0.5pt;padding-right:32pt;line-height:12pt;"&gt;17&lt;/p&gt;
