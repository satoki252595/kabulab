&lt;colgroup&gt;
&lt;col style="width:447pt;min-width:447pt;"/&gt;
&lt;col style="width:36pt;min-width:36pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:9.8pt;min-height:9.8pt;"&gt;
&lt;td colspan="2" style="vertical-align:middle;border-top-color:#a9a9a9;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-color:#a9a9a9;border-right-color:#a9a9a9;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblR" style="orphans:0;widows:0;padding-right:9pt;"&gt;&lt;span&gt;2023年６月30日&lt;/span&gt;現在&lt;/p&gt;
