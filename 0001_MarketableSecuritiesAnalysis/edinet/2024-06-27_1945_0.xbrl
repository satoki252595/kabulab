&lt;td style="vertical-align: top; width: 100.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 21px; text-align: center"&gt;
&lt;span style="font-size: 14px"&gt;事業年度&lt;/span&gt;
&lt;/p&gt;
&lt;p style="line-height: 21px; text-align: center"&gt;
&lt;span style="font-size: 14px"&gt;(第76期)&lt;/span&gt;
