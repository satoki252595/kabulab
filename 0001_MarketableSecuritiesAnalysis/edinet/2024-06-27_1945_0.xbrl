&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr style="height: 63px"&gt;
&lt;td style="vertical-align: top; width: 28px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 21px; text-align: left"&gt;
&lt;span style="font-size: 14px"&gt;(1)&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 126px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 21px; text-align: left"&gt;
&lt;span style="font-size: 14px"&gt;有価証券報告書&lt;/span&gt;
&lt;/p&gt;
&lt;p style="line-height: 21px; text-align: left"&gt;
&lt;span style="font-size: 14px"&gt;及びその添付書類&lt;/span&gt;
&lt;/p&gt;
&lt;p style="line-height: 21px; text-align: left"&gt;
&lt;span style="font-size: 14px"&gt;並びに確認書&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 24px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 21px; text-align: left"&gt;
&lt;span style="font-size: 14px"&gt; &lt;/span&gt;
&lt;/p&gt;
