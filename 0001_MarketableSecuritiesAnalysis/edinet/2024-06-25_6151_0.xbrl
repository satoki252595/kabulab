  <jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock contextRef="FilingDateInstant_jpcrp030000-asr_E01509-000OgataAkinobuMember">
&lt;p style="margin-left: 60px; line-height: 15px; margin-right: 5px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;1978年４月 三菱商事株式会社入社&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; line-height: 15px; margin-right: 5px; text-align: left; text-indent: -55px"&gt;
