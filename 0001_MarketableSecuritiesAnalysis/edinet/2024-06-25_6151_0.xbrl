&lt;p style="margin-left: 6px; margin-right: 3.3333333333333333333333333333px; text-align: left; line-height: 16px"&gt;
&lt;span style="font-size: 12px"&gt; &lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
