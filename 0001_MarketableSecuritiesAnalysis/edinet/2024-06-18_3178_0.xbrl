  <jpcrp_cor:ConsolidatedStatementOfChangesInEquityTextBlock contextRef="CurrentYearDuration">&lt;p class="smt_head4" style="orphans:0;widows:0;padding-left:18pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;text-align:justify;letter-spacing:0pt;line-height:15pt;font-size:9pt;"&gt;③ 【連結株主資本等変動計算書】&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;"&gt;  前連結会計年度(自  2022年４月１日  至  2023年３月31日)&lt;/p&gt;
&lt;div class="tbld"&gt;
