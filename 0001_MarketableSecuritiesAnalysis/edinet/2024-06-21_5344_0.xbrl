&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 16.67px"&gt;
&lt;td style="vertical-align: middle; width: 126.06666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 12px; line-height: 15.333333333333333333333333333px; margin-right: 6px; text-align: left"&gt;光岡　正彦&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 219.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; line-height: 15.333333333333333333333333333px; margin-right: 6px; text-align: left"&gt;監査等委員会12回&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 230.6px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; line-height: 15.333333333333333333333333333px; margin-right: 6px; text-align: left"&gt;監査等委員会12回&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 16.67px"&gt;
&lt;td style="vertical-align: middle; width: 126.06666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 12px; line-height: 15.333333333333333333333333333px; margin-right: 6px; text-align: left"&gt;加藤　晶英&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 219.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; line-height: 15.333333333333333333333333333px; margin-right: 6px; text-align: left"&gt;監査等委員会12回&lt;/p&gt;
&lt;/td&gt;
