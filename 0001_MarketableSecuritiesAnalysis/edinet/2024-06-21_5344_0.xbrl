&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 16px"&gt;
&lt;td style="vertical-align: top; width: 94px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-right: 12px; text-align: right"&gt;2000年12月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 525px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
