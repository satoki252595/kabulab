&lt;/colgroup&gt;
&lt;tr style="height:10.5pt;min-height:10.5pt;"&gt;
&lt;td style="vertical-align:top;border-bottom-color:#a9a9a9;border-right-color:#a9a9a9;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;line-height:10.8pt;font-size:7.5pt;"&gt;1981年４月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:top;border-bottom-color:#a9a9a9;border-left-color:#a9a9a9;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:2.9pt;padding-right:2.9pt;line-height:10.8pt;font-size:7.5pt;"&gt;当社入社&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
