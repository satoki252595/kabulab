</jpcrp030000-asr_E05340-000:MetricsAndTargetsTextBlock>
  <jpcrp030000-asr_E05340-000:DescriptionOfMetricsRelatedToPolicyOnHumanResourceDevelopmentAndImprovementOfInternalEnvironmentAndTargetsAndResultsUsingSuchMetricsMetricsAndTargetsTextBlock contextRef="FilingDateInstant">
