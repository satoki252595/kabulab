&lt;/div&gt;
&lt;p style="margin-left: 16px; line-height: 1.3333333333333333333333333333px; text-align: justify; text-justify: inter-ideograph"&gt; &lt;/p&gt;
&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 544px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 272px"/&gt;
