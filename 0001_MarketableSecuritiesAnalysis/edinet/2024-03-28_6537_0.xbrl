  <jpcrp_cor:NotesAssetRetirementObligationsConsolidatedFinancialStatementsTextBlock contextRef="CurrentYearDuration">
&lt;h5 class="smt_head4"&gt;(資産除去債務関係)&lt;/h5&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:18pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:9pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;font-size:9pt;"&gt;重要性が乏しいため、記載を省略しております。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:0pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;font-size:15pt;"&gt; &lt;/p&gt;</jpcrp_cor:NotesAssetRetirementObligationsConsolidatedFinancialStatementsTextBlock>
  <jpcrp_cor:NotesRealEstateForLeaseEtcConsolidatedFinancialStatementsTextBlock contextRef="CurrentYearDuration">
