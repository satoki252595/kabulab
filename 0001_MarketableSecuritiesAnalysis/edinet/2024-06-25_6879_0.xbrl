  <jpcrp_cor:NotesRegardingNewShareSubscriptionRightsEtcTextBlock contextRef="Prior1YearDuration">&lt;p class="smt_head6" style="orphans:0;widows:0;padding-left:9pt;line-height:13pt;"&gt;２　新株予約権等に関する事項&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:31.5pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:13pt;font-size:9pt;"&gt;該当事項はありません。&lt;/p&gt;&lt;p class="smt_text1" style="orphans:0;widows:0;text-align:justify;padding-left:18pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:13pt;font-size:13pt;"&gt; &lt;/p&gt;</jpcrp_cor:NotesRegardingNewShareSubscriptionRightsEtcTextBlock>
  <jpcrp_cor:NotesRegardingDividendTextBlock contextRef="Prior1YearDuration">&lt;p class="smt_head6" style="orphans:0;widows:0;padding-left:9pt;line-height:13pt;"&gt;３　配当に関する事項&lt;/p&gt;&lt;p class="smt_head6" style="orphans:0;widows:0;padding-left:18pt;line-height:13pt;"&gt;(1) 配当金支払額&lt;/p&gt;
&lt;div class="tbld" style="margin-left:0pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
