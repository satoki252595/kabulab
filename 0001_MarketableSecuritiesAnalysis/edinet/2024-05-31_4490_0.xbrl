&lt;p style="margin-left: 6px; line-height: 16px; margin-right: 4px; text-align: left"&gt;Ａ種種類株式&lt;/p&gt;
&lt;p style="margin-left: 6px; line-height: 16px; margin-right: 4px; text-align: right"&gt;75,000&lt;/p&gt;
&lt;p style="margin-left: 6px; line-height: 16px; margin-right: 4px; text-align: left"&gt;Ｂ種種類株式&lt;/p&gt;
&lt;p style="line-height: 16px; margin-right: 6px; text-align: right"&gt;13,817&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 80px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 16px; margin-right: 6px; text-align: right"&gt;12,667&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 72.533333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 16px; margin-right: 6px; text-align: right"&gt;467,710&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 84px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 16px; margin-right: 6px; text-align: right"&gt;－&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 84px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
