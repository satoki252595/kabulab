  <jpcrp_cor:NotesRelatedPartiesConsolidatedFinancialStatementsTextBlock contextRef="CurrentYearDuration">
&lt;h6&gt;【関連当事者情報】&lt;/h6&gt;
&lt;p style="margin-left: 48px; text-align: left"&gt;　１．関連当事者との取引&lt;/p&gt;
&lt;p style="margin-left: 72px; text-align: left"&gt;　連結財務諸表提出会社と関連当事者との取引&lt;/p&gt;
&lt;p style="margin-left: 84px; text-align: left"&gt;　連結財務諸表提出会社の非連結子会社及び関連会社等&lt;/p&gt;
&lt;p style="margin-left: 84px; text-align: left"&gt;　前連結会計年度（自2022年４月１日　至2023年３月31日）&lt;/p&gt;
&lt;div style="margin-left: 40px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 607.99999999999999999999999999px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 50px"/&gt;
&lt;col style="width: 60px"/&gt;
&lt;col style="width: 53.333333333333333333333333333px"/&gt;
&lt;col style="width: 53.333333333333333333333333333px"/&gt;
&lt;col style="width: 56.666666666666666666666666667px"/&gt;
&lt;col style="width: 65.333333333333333333333333333px"/&gt;
&lt;col style="width: 53.333333333333333333333333333px"/&gt;
&lt;col style="width: 62.666666666666666666666666667px"/&gt;
&lt;col style="width: 53.333333333333333333333333333px"/&gt;
&lt;col style="width: 46.666666666666666666666666667px"/&gt;
&lt;col style="width: 53.333333333333333333333333333px"/&gt;
&lt;/colgroup&gt;
&lt;thead&gt;
&lt;tr style="height: 45px"&gt;
&lt;td style="vertical-align: middle; width: 50px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 11.333333333333333333333333333px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;種類&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 60px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 5px; line-height: 11.333333333333333333333333333px; margin-right: 10px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;会社等の名称又は氏名&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 53.333333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
