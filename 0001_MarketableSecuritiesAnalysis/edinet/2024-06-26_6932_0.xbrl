&lt;tr style="height:6.2pt;min-height:6.2pt;"&gt;
&lt;td style="vertical-align:middle;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;margin-top:1.5pt;margin-bottom:1.5pt;letter-spacing:0pt;line-height:13pt;"&gt;1984年６月&lt;/p&gt;
