&lt;td style="vertical-align:top;border-top-color:#a9a9a9;border-left-style:solid;border-left-width:0.75pt;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:5.4pt;padding-right:5.4pt;line-height:10.5pt;font-size:7.5pt;"&gt;&lt;span style="font-size:7.5pt;"&gt;当社監査役(現任)&lt;/span&gt;&lt;/p&gt;
