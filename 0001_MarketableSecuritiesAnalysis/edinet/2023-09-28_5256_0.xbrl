  <jpcrp_cor:RevenuesFromExternalCustomersInformationForEachRegionTextBlock contextRef="Prior1YearDuration_NonConsolidatedMember">&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:45pt;line-height:15pt;"&gt;（1）売上高&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:63pt;line-height:15pt;"&gt;本邦の外部顧客への売上高が損益計算書の売上高の90%を超えるため、記載を省略しております。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;line-height:15pt;font-size:15pt;"&gt; &lt;/p&gt;</jpcrp_cor:RevenuesFromExternalCustomersInformationForEachRegionTextBlock>
