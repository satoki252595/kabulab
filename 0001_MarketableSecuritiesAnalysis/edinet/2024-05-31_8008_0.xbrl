&lt;span style="font-size: 10px"&gt;ジュエリー事業&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 67.666666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="line-height: 15px; margin-right: 10px; text-align: right"&gt;
&lt;span style="font-size: 10px"&gt;100.0&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td rowspan="2" style="vertical-align: middle; width: 192.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 5px; line-height: 15px; margin-right: 5px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;当社の役員が1名兼務しております。&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 5px; line-height: 15px; margin-right: 5px; text-align: left"&gt;
