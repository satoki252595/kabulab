  <jpcrp_cor:NotesRegardingDividendTextBlock contextRef="CurrentYearDuration">&lt;p class="smt_text6" style="orphans:0;widows:0;"&gt;４　配当に関する事項&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:9pt;margin-bottom:2pt;line-height:13pt;"&gt;(1) 配当金支払額&lt;/p&gt;
