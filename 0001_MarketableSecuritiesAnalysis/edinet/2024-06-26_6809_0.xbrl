  <jpcrp_cor:RevenuesFromExternalCustomersInformationForEachRegionTextBlock contextRef="Prior1YearDuration">
&lt;p style="margin-left: 60px; text-align: left; text-indent: -12px"&gt;(1）売上高&lt;/p&gt;
&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 624px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 624px"/&gt;
