&lt;tr style="height: 26.67px"&gt;
&lt;td style="vertical-align: middle; width: 392px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: left"&gt;1.00+0.15×(中期最終年度実績値％-中期当初目標値％)&lt;/p&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: left"&gt;max＝2.0　min＝0.0&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;/div&gt;
&lt;p style="margin-left: 64px; text-align: justify; text-justify: inter-ideograph"&gt; &lt;/p&gt;
&lt;p style="margin-left: 64px; text-align: justify; text-justify: inter-ideograph"&gt;・係数（TSR）&lt;/p&gt;
&lt;div style="margin-left: 63.466666666666666666666666667px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 392px"&gt;
&lt;colgroup&gt;
