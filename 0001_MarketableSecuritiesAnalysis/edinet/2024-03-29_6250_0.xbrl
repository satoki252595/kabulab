&lt;/p&gt;
&lt;/td&gt;
&lt;td colspan="2" style="vertical-align: middle; width: 64px; padding-top: 1px; padding-bottom: 0px; padding-left: 1px; padding-right: 1px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;シナリオ影響&lt;/span&gt;
&lt;/p&gt;
&lt;p style="text-align: center"&gt;
&lt;span style="font-size: 8px"&gt;（注）1&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td rowspan="2" style="vertical-align: middle; width: 40px; padding-top: 1px; padding-bottom: 0px; padding-left: 1px; padding-right: 1px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;対象&lt;br/&gt;製品&lt;/span&gt;
&lt;/p&gt;
&lt;p style="text-align: center"&gt;
&lt;span style="font-size: 8px"&gt;（注）2&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td colspan="3" style="vertical-align: middle; width: 96px; padding-top: 1px; padding-bottom: 0px; padding-left: 1px; padding-right: 1px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;発現時期&lt;/span&gt;
&lt;/p&gt;
&lt;p style="text-align: center"&gt;
