  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E27585-000KushidaTakanoriMember">1977-01-12</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
