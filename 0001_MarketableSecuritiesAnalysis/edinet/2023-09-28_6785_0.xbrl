  <jpcrp_cor:OfficialTitleOrPositionInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E02058-000MatsumotoMitsuhiroMember">

取締役


(監査等委員)

</jpcrp_cor:OfficialTitleOrPositionInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E02058-000MatsumotoMitsuhiroMember">松本　光博</jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E02058-000MatsumotoMitsuhiroMember">1969-05-07</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock contextRef="FilingDateInstant_jpcrp030000-asr_E02058-000MatsumotoMitsuhiroMember">
&lt;p style="margin-left: 60px; line-height: 14.666666666666666666666666667px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;1992年10月 青山監査法人入所&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; line-height: 14.666666666666666666666666667px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;1999年10月 公認会計士・税理士 松本会計事務所（現フィンポート会計グループ）代表（現任）&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; line-height: 14.666666666666666666666666667px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;2008年９月 当社監査役就任&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; line-height: 14.666666666666666666666666667px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;2010年７月 鈴木東新電子(中山)有限公司監察人就任（現任）&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; line-height: 14.666666666666666666666666667px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;2013年12月 PT.SUGINDO INTERNATIONAL監査役就任（現任）&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; line-height: 14.666666666666666666666666667px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;2014年８月 ㈱放電精密加工研究所社外監査役（現社外取締役監査等委員）就任&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; line-height: 14.666666666666666666666666667px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;2015年９月 当社取締役（監査等委員）就任（現任）&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; line-height: 14.666666666666666666666666667px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;2019年６月 ㈱ニフコ社外監査役（現社外取締役監査等委員）就任（現任）&lt;/span&gt;
&lt;/p&gt;
</jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock>
  <jpcrp_cor:TermOfOfficeInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E02058-000MatsumotoMitsuhiroMember">(注)５</jpcrp_cor:TermOfOfficeInformationAboutDirectorsAndCorporateAuditors>
