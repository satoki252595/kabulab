&lt;col style="width:211.5pt;min-width:211.5pt;"/&gt;
&lt;col style="width:24.8pt;min-width:24.8pt;"/&gt;
&lt;col style="width:27pt;min-width:27pt;"/&gt;
&lt;/colgroup&gt;
