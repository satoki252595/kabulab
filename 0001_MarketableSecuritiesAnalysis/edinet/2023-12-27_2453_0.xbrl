&lt;col style="width: 118.73333333333333333333333333px"/&gt;
&lt;col style="width: 213.6px"/&gt;
&lt;col style="width: 208.66666666666666666666666667px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr style="height: 18.53px"&gt;
