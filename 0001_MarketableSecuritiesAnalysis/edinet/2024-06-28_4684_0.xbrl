  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E05025-000TanakaTakeoMember">1973-12-12</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock contextRef="FilingDateInstant_jpcrp030000-asr_E05025-000TanakaTakeoMember">
&lt;p style="margin-left: 65px; line-height: 13.333333333333333333333333333px; margin-right: 2px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;1997年４月　株式会社日立製作所入社&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 13.333333333333333333333333333px; margin-right: 2px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;1998年11月　株式会社日立製作所退社&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 13.333333333333333333333333333px; margin-right: 2px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;2005年４月　最高裁判所司法研修所入所&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 13.333333333333333333333333333px; margin-right: 2px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;2006年10月　最高裁判所司法研修生過程終了（59期）&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 13.333333333333333333333333333px; margin-right: 2px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;2006年10月　弁護士登録（東京弁護士会所属）&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 13.333333333333333333333333333px; margin-right: 2px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;2006年10月　弁護士法人松尾綜合法律事務所入所（現任）&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 13.333333333333333333333333333px; margin-right: 2px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;2021年６月　当社社外監査役（現任）&lt;/span&gt;
&lt;/p&gt;
</jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock>
