  <jpigp_cor:NotesSubsidiariesConsolidatedFinancialStatementsIFRSTextBlock contextRef="CurrentYearDuration">&lt;p class="smt_head6" style="orphans:0;widows:0;"&gt;36．主要な子会社&lt;/p&gt;
