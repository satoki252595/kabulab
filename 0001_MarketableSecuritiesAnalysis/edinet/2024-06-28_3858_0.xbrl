&lt;tr style="height: 1.33px"&gt;
&lt;td style="vertical-align: middle; width: 348px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: left"&gt;取得の対価&lt;/p&gt;
&lt;/td&gt;
