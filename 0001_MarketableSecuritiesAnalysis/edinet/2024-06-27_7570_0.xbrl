&lt;col style="width: 114.66666666666666666666666667px"/&gt;
&lt;col style="width: 114.66666666666666666666666667px"/&gt;
&lt;col style="width: 114.66666666666666666666666667px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr style="height: 33.33px"&gt;
&lt;td style="vertical-align: middle; width: 128px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center"&gt;役職名&lt;/p&gt;
&lt;/td&gt;
