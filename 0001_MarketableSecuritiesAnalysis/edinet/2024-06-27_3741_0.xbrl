&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center"&gt;中村 彰&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 168.26666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center"&gt;3&lt;/p&gt;
