&lt;p style="margin-left: 7px; line-height: 14px; margin-right: 7px; text-align: left"&gt;負債合計&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 126.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 30px; line-height: 14px; margin-right: 6.3333333333333333333333333333px; text-align: left"&gt;1,768&lt;/p&gt;
