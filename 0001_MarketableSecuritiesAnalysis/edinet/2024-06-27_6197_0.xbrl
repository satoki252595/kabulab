&lt;td style="vertical-align: middle; width: 244.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; line-height: 15px; margin-right: 6px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;Berlitz International, Inc.（現：Berlitz Corporation）会長、社長兼ＣＥＯ&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
