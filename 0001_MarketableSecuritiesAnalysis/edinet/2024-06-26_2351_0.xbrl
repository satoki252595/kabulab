&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 254px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 60px"/&gt;
&lt;col style="width: 194px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr style="height: 21.33px"&gt;
