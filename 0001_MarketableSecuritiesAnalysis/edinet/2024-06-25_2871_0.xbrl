&lt;span style="font-size: 10px"&gt;51&lt;/span&gt;
&lt;/p&gt;
&lt;p style="line-height: 15px; text-align: right"&gt;
&lt;span style="font-size: 10px"&gt;(-)&lt;/span&gt;
