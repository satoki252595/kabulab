&lt;col style="width:129.8pt;min-width:129.8pt;"/&gt;
&lt;col style="width:123.8pt;min-width:123.8pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:20.3pt;min-height:20.3pt;"&gt;
