  <jpcrp_cor:MajorFacilitiesTextBlock contextRef="FilingDateInstant">&lt;p style="page-break-before:always; line-height:0.75pt; width:100%; font-size:0.75pt;"&gt; &lt;/p&gt;
&lt;h3 class="smt_head2"&gt;２ 【主要な設備の状況】&lt;/h3&gt;
&lt;h4 class="smt_head3"&gt;(1) 提出会社&lt;/h4&gt;&lt;p class="smt_unitR" style="orphans:0;widows:0;text-align:right;padding-left:0pt;padding-right:9pt;"&gt;&lt;span&gt;2023年６月30日&lt;/span&gt;現在&lt;/p&gt;
&lt;div class="tbld" style="margin-left:0.2pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:481.8pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
