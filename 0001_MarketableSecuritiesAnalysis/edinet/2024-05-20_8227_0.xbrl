&lt;td style="vertical-align: middle; width: 253px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-right: 56.666666666666666666666666667px; text-align: right"&gt;29,821&lt;/p&gt;
