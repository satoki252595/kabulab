  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E05162-000KusabirakiChihitoMember">1965-03-18</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock contextRef="FilingDateInstant_jpcrp030000-asr_E05162-000KusabirakiChihitoMember">
&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 301.33333333333333333333333334px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 58.666666666666666666666666667px"/&gt;
&lt;col style="width: 242.66666666666666666666666667px"/&gt;
&lt;/colgroup&gt;
