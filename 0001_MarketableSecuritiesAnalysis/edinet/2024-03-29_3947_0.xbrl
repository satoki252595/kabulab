</jpcrp_cor:InformationForEachOfMainCustomersTextBlock>
  <jpcrp_cor:NotesRelatedPartiesConsolidatedFinancialStatementsTextBlock contextRef="CurrentYearDuration">
&lt;h6&gt;【関連当事者情報】&lt;/h6&gt;
&lt;p style="margin-left: 72px; line-height: 17.6px; text-align: left; text-indent: -12px"&gt;関連当事者との取引&lt;/p&gt;
&lt;p style="margin-left: 84px; line-height: 17.6px; text-align: left; text-indent: -12px"&gt;連結財務諸表提出会社と関連当事者との取引&lt;/p&gt;
&lt;p style="margin-left: 108px; line-height: 17.6px; text-align: left; text-indent: -24px"&gt;連結財務諸表提出会社の親会社及び主要株主（会社等の場合に限る。）等&lt;/p&gt;
&lt;p style="margin-left: 96px; line-height: 17.6px; text-align: left"&gt;前連結会計年度（自　2022年１月１日　至　2022年12月31日）&lt;/p&gt;
&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 650px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 50px"/&gt;
&lt;col style="width: 50px"/&gt;
&lt;col style="width: 50px"/&gt;
&lt;col style="width: 60px"/&gt;
&lt;col style="width: 100px"/&gt;
&lt;col style="width: 60px"/&gt;
&lt;col style="width: 60px"/&gt;
&lt;col style="width: 60px"/&gt;
&lt;col style="width: 60px"/&gt;
&lt;col style="width: 40px"/&gt;
&lt;col style="width: 60px"/&gt;
&lt;/colgroup&gt;
&lt;thead&gt;
