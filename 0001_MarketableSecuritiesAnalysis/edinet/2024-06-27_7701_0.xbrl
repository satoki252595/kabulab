&lt;/p&gt;
&lt;p style="margin-left: 12px; line-height: 1; text-align: left; text-indent: -12px"&gt; &lt;/p&gt;
&lt;p style="margin-left: 12px; line-height: 1; text-align: left; text-indent: -12px"&gt; &lt;/p&gt;
&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 642.06666666666666666666666667px"&gt;
&lt;colgroup&gt;
