&lt;/tr&gt;
&lt;tr style="height: 22px"&gt;
&lt;td style="vertical-align: top; width: 112.86666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 18px; margin-right: 4px; text-align: left"&gt;2020年４月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 535.13333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
