  <jpcrp_cor:DescriptionOfBusinessTextBlock contextRef="FilingDateInstant">&lt;p style="page-break-before:always; line-height:0.75pt; width:100%; font-size:0.75pt;"&gt; &lt;/p&gt;
&lt;h3 class="smt_head2"&gt;３ 【事業の内容】&lt;/h3&gt;
&lt;h4 class="smt_head3"&gt;(1) 当社グループの事業内容&lt;/h4&gt;&lt;p class="smt_text3" style="orphans:0;widows:0;"&gt;当社グループは、以下のとおり、当社、連結子会社７社、持分法適用関連会社１社より構成されております。&lt;/p&gt;&lt;p class="smt_unitR" style="orphans:0;widows:0;"&gt; &lt;/p&gt;
&lt;div class="tbld" style="margin-left:20pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:462.9pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
&lt;col style="width:128.3pt;min-width:128.3pt;"/&gt;
&lt;col style="width:63.8pt;min-width:63.8pt;"/&gt;
&lt;col style="width:270.8pt;min-width:270.8pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:18pt;min-height:18pt;"&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;"&gt;会社区分&lt;/p&gt;
&lt;/td&gt;
