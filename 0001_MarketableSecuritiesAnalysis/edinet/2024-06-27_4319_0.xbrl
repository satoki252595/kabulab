  <jpcrp_cor:DescriptionIssuedSharesVotingRights contextRef="CurrentYearInstant_OrdinarySharesSharesWithFullVotingRightsOtherMember" xsi:nil="true"/>
  <jpcrp_cor:DescriptionIssuedSharesVotingRights contextRef="CurrentYearInstant_OrdinarySharesSharesLessThanOneUnitMember" xsi:nil="true"/>
  <jpcrp_cor:TreasurySharesEtcTextBlock contextRef="FilingDateInstant">
&lt;h5 class="smt_head4"&gt;② 【自己株式等】&lt;/h5&gt;
&lt;div class="tbld" style="margin-left:0pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:481.9pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
&lt;col style="width:118.3pt;min-width:118.3pt;"/&gt;
&lt;col style="width:118.2pt;min-width:118.2pt;"/&gt;
