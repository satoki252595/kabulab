&lt;col style="width:44pt;min-width:44pt;"/&gt;
&lt;col style="width:44.3pt;min-width:44.3pt;"/&gt;
&lt;col style="width:45.8pt;min-width:45.8pt;"/&gt;
&lt;col style="width:41.3pt;min-width:41.3pt;"/&gt;
