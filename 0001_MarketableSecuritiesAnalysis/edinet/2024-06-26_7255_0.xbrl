&lt;p style="text-align: center"&gt;42,439&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 188px; padding-top: 1px; padding-bottom: 0px; padding-left: 1px; padding-right: 1px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt;46,274&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 24px"&gt;
&lt;td style="vertical-align: middle; width: 272px; padding-top: 1px; padding-bottom: 0px; padding-left: 1px; padding-right: 1px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt;契約負債（期末残高）&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 188px; padding-top: 1px; padding-bottom: 0px; padding-left: 1px; padding-right: 1px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt;46,274&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 188px; padding-top: 1px; padding-bottom: 0px; padding-left: 1px; padding-right: 1px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt;27,802&lt;/p&gt;
