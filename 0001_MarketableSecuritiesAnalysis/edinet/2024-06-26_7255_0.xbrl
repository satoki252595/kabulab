&lt;p style="margin-left: 20px; line-height: 1.3333333333333333333333333333px; text-align: justify; text-justify: inter-ideograph"&gt; &lt;/p&gt;
&lt;div style="margin-left: 36px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 400px"&gt;
&lt;colgroup&gt;
