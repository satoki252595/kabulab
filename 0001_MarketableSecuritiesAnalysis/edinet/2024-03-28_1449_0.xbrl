&lt;span style="font-size: 10px"&gt;1995年８月　㈲新日本開発取締役就任&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 75px; line-height: 15px; margin-right: 3px; text-align: left; text-indent: -70px"&gt;
&lt;span style="font-size: 10px"&gt;1995年８月　㈱富士建材入社&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 75px; line-height: 15px; margin-right: 3px; text-align: left; text-indent: -70px"&gt;
&lt;span style="font-size: 10px"&gt;2001年４月　同社取締役就任&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 75px; line-height: 15px; margin-right: 3px; text-align: left; text-indent: -70px"&gt;
&lt;span style="font-size: 10px"&gt;2005年３月　当社設立　代表取締役就任&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 75px; line-height: 15px; margin-right: 3px; text-align: left; text-indent: -70px"&gt;
&lt;span style="font-size: 10px"&gt;　　　　　 （現任）&lt;/span&gt;
&lt;/p&gt;

&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 35px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;
&lt;p style="line-height: 15px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;(注)３&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 60px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;
&lt;p style="line-height: 15px; margin-right: 5px; text-align: right"&gt;
