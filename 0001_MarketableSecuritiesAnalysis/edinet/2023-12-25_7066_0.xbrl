&lt;tr style="height: 24px"&gt;
&lt;td rowspan="2" style="vertical-align: middle; width: 27px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center"&gt;＋&lt;/p&gt;
