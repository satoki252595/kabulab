&lt;span style="font-size: 12px"&gt; &lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td rowspan="5" style="vertical-align: middle; width: 27px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-right: 6px; text-align: center"&gt; &lt;/p&gt;
&lt;p style="margin-right: 6px; text-align: center"&gt;×&lt;/p&gt;
&lt;/td&gt;
&lt;td rowspan="2" style="vertical-align: bottom; width: 53px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: left"&gt;既発行&lt;/p&gt;
