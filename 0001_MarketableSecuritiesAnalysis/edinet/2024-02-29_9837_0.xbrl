&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-color:#a9a9a9;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-color:#a9a9a9;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:5.4pt;padding-right:5.4pt;margin-top:1pt;margin-bottom:1pt;line-height:10pt;font-size:7.5pt;"&gt;当社入社&lt;/p&gt;
