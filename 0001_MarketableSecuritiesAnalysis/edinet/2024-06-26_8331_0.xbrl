&lt;td style="vertical-align: middle; width: 109.2px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 18.666666666666666666666666667px; text-align: center"&gt;
