  <jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E02045-000ReiichiroHoriMember">堀　礼一郎</jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E02045-000ReiichiroHoriMember">1979-12-14</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock contextRef="FilingDateInstant_jpcrp030000-asr_E02045-000ReiichiroHoriMember">
&lt;p style="margin-left: 65.333333333333333333333333333px; line-height: 13.333333333333333333333333333px; margin-right: 5.3333333333333333333333333333px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;2004年４月　株式会社バックスグループ入社 &lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65.333333333333333333333333333px; line-height: 13.333333333333333333333333333px; margin-right: 5.3333333333333333333333333333px; text-align: left; text-indent: -60px"&gt;
