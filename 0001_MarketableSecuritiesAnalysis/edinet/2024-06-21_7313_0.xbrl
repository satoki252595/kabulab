&lt;div class="tbld" style="text-align:left;margin-left:32.4pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" class="align_left" style="border-collapse:collapse;border:solid 0pt #000000;width:441.0pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
