&lt;/p&gt;
&lt;p style="margin-left: 14.666666666666666666666666667px; margin-right: 3.3333333333333333333333333333px; text-align: left; text-indent: -10px"&gt;
&lt;span style="font-size: 10px"&gt;　及び保守サービスの提供&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 97.93333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 4.6666666666666666666666666667px; margin-right: 3.3333333333333333333333333333px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;―&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 27px"&gt;
&lt;td rowspan="2" style="vertical-align: middle; width: 129.6px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 4.6666666666666666666666666667px; margin-right: 3.3333333333333333333333333333px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;DX・システム開発&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 341.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 14.666666666666666666666666667px; margin-right: 3.3333333333333333333333333333px; text-align: left; text-indent: -10px"&gt;
&lt;span style="font-size: 10px"&gt;・設計からソフトウェア開発、保守運用までワンストップのシステム開発&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 14.666666666666666666666666667px; margin-right: 3.3333333333333333333333333333px; text-align: left; text-indent: -10px"&gt;
&lt;span style="font-size: 10px"&gt;　の提供&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 97.93333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 4.6666666666666666666666666667px; margin-right: 3.3333333333333333333333333333px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;システムデザイン開発㈱&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 27px"&gt;
&lt;td style="vertical-align: middle; width: 341.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 14.666666666666666666666666667px; margin-right: 3.3333333333333333333333333333px; text-align: left; text-indent: -10px"&gt;
