  <jpcrp030000-asr_E02043-000:NotesRegardingSubsidyIncomeTextBlock contextRef="CurrentYearDuration">&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:18pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:11pt;font-size:9pt;"&gt;※４　補助金収入&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:27pt;text-indent:0pt;line-height:15pt;"&gt;&lt;span style="font-family:&amp;apos;ＭＳ 明朝&amp;apos;;font-size:9pt;"&gt;前連結会計年度（自　&lt;/span&gt;&lt;span&gt;&lt;span style="font-size:9pt;"&gt;2022年４月１日&lt;/span&gt;&lt;/span&gt;&lt;span style="font-family:&amp;apos;ＭＳ 明朝&amp;apos;;font-size:9pt;"&gt;　至　&lt;/span&gt;&lt;span&gt;&lt;span style="font-size:9pt;"&gt;2023年３月31日&lt;/span&gt;&lt;/span&gt;&lt;span style="font-family:&amp;apos;ＭＳ 明朝&amp;apos;;font-size:9pt;"&gt;）&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:27pt;text-indent:0pt;line-height:15pt;"&gt;&lt;span style="font-family:&amp;apos;ＭＳ 明朝&amp;apos;;font-size:9pt;"&gt;補助金収入は、熊本事業所における設備投資に対する&lt;/span&gt;熊本県企業立地促進補助金であります。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:27pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;font-size:15pt;"&gt; &lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:27pt;text-indent:0pt;line-height:15pt;"&gt;&lt;span style="font-family:&amp;apos;ＭＳ 明朝&amp;apos;;font-size:9pt;"&gt;当連結会計年度（自　&lt;/span&gt;&lt;span&gt;&lt;span style="font-size:9pt;"&gt;2023年４月１日&lt;/span&gt;&lt;/span&gt;&lt;span style="font-family:&amp;apos;ＭＳ 明朝&amp;apos;;font-size:9pt;"&gt;　至　&lt;/span&gt;&lt;span&gt;&lt;span style="font-size:9pt;"&gt;2024年３月31日&lt;/span&gt;&lt;/span&gt;&lt;span style="font-family:&amp;apos;ＭＳ 明朝&amp;apos;;font-size:9pt;"&gt;）&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:27pt;text-indent:0pt;line-height:15pt;"&gt;該当事項はありません。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:27pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;font-size:15pt;"&gt; &lt;/p&gt;</jpcrp030000-asr_E02043-000:NotesRegardingSubsidyIncomeTextBlock>
