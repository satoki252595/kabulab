  <jpcrp_cor:NotesBusinessCombinationsConsolidatedFinancialStatementsTextBlock contextRef="CurrentYearDuration">
&lt;h6 class="smt_head3" style="padding-left:9pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;text-align:justify;letter-spacing:0pt;line-height:15pt;font-size:9pt;"&gt;(企業結合等関係)&lt;/h6&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:23pt;"&gt;該当事項はありません。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:0pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:9pt;font-size:9pt;"&gt; &lt;/p&gt;</jpcrp_cor:NotesBusinessCombinationsConsolidatedFinancialStatementsTextBlock>
