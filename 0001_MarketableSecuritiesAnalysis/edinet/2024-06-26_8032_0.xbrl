    <link:footnote xlink:label="footnote" xlink:role="http://disclosure.edinet-fsa.go.jp/role/jppfs/role/NotesNumber" xlink:type="resource" xml:lang="ja">※４</link:footnote>
    <link:loc xlink:href="#fact98" xlink:label="fact" xlink:type="locator"/>
