&lt;colgroup&gt;
&lt;col style="width:97.4pt;min-width:97.4pt;"/&gt;
&lt;col style="width:100.5pt;min-width:100.5pt;"/&gt;
&lt;col style="width:57pt;min-width:57pt;"/&gt;
