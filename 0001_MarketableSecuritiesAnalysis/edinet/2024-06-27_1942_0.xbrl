&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr style="height: 33px"&gt;
&lt;td colspan="2" style="vertical-align: middle; width: 228px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; margin-top: 2.6666666666666666666666666667px; text-align: left"&gt;１  有価証券報告書及びその添付書類&lt;/p&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; margin-bottom: 2.6666666666666666666666666667px; text-align: left; text-indent: 24px"&gt;並びに確認書&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 108px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;事業年度&lt;/p&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;（第109期）&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 144px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: left"&gt;自  2022年４月１日&lt;/p&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: left"&gt;至  2023年３月31日&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 144px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 12px; text-align: left"&gt;2023年６月29日提出&lt;/p&gt;
&lt;/td&gt;
