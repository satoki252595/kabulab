&lt;p style="margin-left: 36px; margin-bottom: 6px; text-align: left"&gt;（連結）&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: bottom; width: 324px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
