&lt;/td&gt;
&lt;td style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;"&gt;&lt;span style="font-size:9pt;"&gt;2,520&lt;/span&gt;(注1)&lt;/p&gt;
