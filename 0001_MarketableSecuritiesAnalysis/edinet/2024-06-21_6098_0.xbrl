&lt;/td&gt;
&lt;td colspan="2" style="vertical-align:middle;background-color:#548dd4;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;"&gt;&lt;span style="color:#ffffff;"&gt;㈱リクルート&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
