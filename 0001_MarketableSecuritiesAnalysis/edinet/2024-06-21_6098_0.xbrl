&lt;/td&gt;
&lt;td style="vertical-align:middle;background-color:#548dd4;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;text-align:center;padding-left:3.5pt;padding-right:3.5pt;margin-top:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:10pt;font-size:9pt;"&gt;&lt;span style="font-family:&amp;apos;ＭＳ 明朝&amp;apos;;color:#ffffff;"&gt;&lt;b&gt;2022年&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;
