&lt;tr style="height:12pt;min-height:12pt;"&gt;
&lt;td style="vertical-align:top;border-top-color:#000000;border-bottom-color:#000000;border-left-color:#000000;border-right-color:#000000;background-color:#548dd4;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:4.5pt;padding-right:0pt;line-height:15pt;"&gt;&lt;span style="color:#ffffff;"&gt;指標&lt;/span&gt;&lt;/p&gt;
