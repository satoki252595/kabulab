&lt;col style="width:124.5pt;min-width:124.5pt;"/&gt;
&lt;col style="width:124.5pt;min-width:124.5pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:40.8pt;min-height:40.8pt;"&gt;
