&lt;td colspan="5" style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#bfbfbf;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#bfbfbf;border-left-style:solid;border-left-width:0.75pt;border-left-color:#bfbfbf;border-right-style:solid;border-right-width:0.75pt;border-right-color:#bfbfbf;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblR" style="orphans:0;widows:0;text-align:center;padding-right:4.5pt;font-size:7.5pt;"&gt;&lt;span style="font-size:7.5pt;"&gt;計&lt;/span&gt;&lt;/p&gt;
