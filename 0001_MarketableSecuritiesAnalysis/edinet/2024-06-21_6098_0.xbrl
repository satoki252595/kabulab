&lt;td style="vertical-align:middle;background-color:#548dd4;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;text-align:center;padding-left:0pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:10pt;"&gt;&lt;span style="color:#f2f2f2;"&gt;提出日の前月末現在&lt;/span&gt;&lt;br/&gt;&lt;span style="color:#f2f2f2;"&gt;(2024年5月31日)&lt;/span&gt;&lt;/p&gt;
