&lt;td style="vertical-align:top;border-top-style:solid;border-top-width:0.75pt;border-top-color:#bfbfbf;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#bfbfbf;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:0pt;padding-right:0pt;line-height:22pt;font-size:12pt;"&gt;1960年3月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:top;border-top-style:solid;border-top-width:0.75pt;border-top-color:#bfbfbf;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#bfbfbf;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:0pt;padding-right:0pt;"&gt; &lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:top;border-top-style:solid;border-top-width:0.75pt;border-top-color:#bfbfbf;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#bfbfbf;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:0pt;padding-right:0pt;line-height:5pt;font-size:5pt;"&gt; &lt;/p&gt;
&lt;div&gt;&lt;img alt="" height="16" src="fuzoku/m_00_c_s_906580010_01.gif" width="20"/&gt;&lt;br/&gt;
&lt;/div&gt;
&lt;/td&gt;
&lt;td style="vertical-align:top;border-top-style:solid;border-top-width:0.75pt;border-top-color:#bfbfbf;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#bfbfbf;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:0pt;padding-right:0pt;line-height:22pt;"&gt;&lt;b&gt;大学新聞広告社として創業&lt;/b&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:40pt;min-height:40pt;"&gt;
&lt;td style="vertical-align:top;border-top-style:solid;border-top-width:0.75pt;border-top-color:#bfbfbf;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#bfbfbf;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:0pt;padding-right:0pt;line-height:22pt;font-size:12pt;"&gt;1962年&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:top;border-top-style:solid;border-top-width:0.75pt;border-top-color:#bfbfbf;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#bfbfbf;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:0pt;padding-right:0pt;"&gt; &lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:top;border-top-style:solid;border-top-width:0.75pt;border-top-color:#bfbfbf;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#bfbfbf;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:0pt;padding-right:0pt;line-height:5pt;font-size:5pt;"&gt; &lt;/p&gt;
&lt;div&gt;&lt;img alt="" height="15" src="fuzoku/m_01_c_s_906580010_01.gif" width="20"/&gt;&lt;br/&gt;
&lt;/div&gt;
&lt;/td&gt;
&lt;td style="vertical-align:top;border-top-style:solid;border-top-width:0.75pt;border-top-color:#bfbfbf;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#bfbfbf;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:0pt;padding-right:0pt;line-height:22pt;"&gt;&lt;b&gt;「企業への招待」を創刊&lt;/b&gt;&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:0pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;font-size:9pt;"&gt;大学生への求人情報だけを集めた就職情報誌を創刊。個人ユーザーと企業クライアントを結ぶマッチングプラットフォームを提供するビジネスモデルを確立&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:20pt;min-height:20pt;"&gt;
&lt;td style="vertical-align:top;border-top-style:solid;border-top-width:0.75pt;border-top-color:#bfbfbf;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#bfbfbf;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:0pt;padding-right:0pt;line-height:22pt;font-size:12pt;"&gt;1963年8月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:top;border-top-style:solid;border-top-width:0.75pt;border-top-color:#bfbfbf;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#bfbfbf;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:0pt;padding-right:0pt;"&gt; &lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:top;border-top-style:solid;border-top-width:0.75pt;border-top-color:#bfbfbf;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#bfbfbf;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:0pt;padding-right:0pt;line-height:5pt;font-size:5pt;"&gt; &lt;/p&gt;
&lt;div&gt;&lt;img alt="" height="16" src="fuzoku/m_00_c_s_906580010_01.gif" width="20"/&gt;&lt;br/&gt;
&lt;/div&gt;
&lt;/td&gt;
&lt;td style="vertical-align:top;border-top-style:solid;border-top-width:0.75pt;border-top-color:#bfbfbf;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#bfbfbf;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:0pt;padding-right:0pt;line-height:22pt;"&gt;&lt;b&gt;㈱日本リクルートセンターとして当社を設立&lt;/b&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:40pt;min-height:40pt;"&gt;
&lt;td style="vertical-align:top;border-top-style:solid;border-top-width:0.75pt;border-top-color:#bfbfbf;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#bfbfbf;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:0pt;padding-right:0pt;line-height:22pt;font-size:12pt;"&gt;1968年&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:top;border-top-style:solid;border-top-width:0.75pt;border-top-color:#bfbfbf;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#bfbfbf;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:0pt;padding-right:0pt;line-height:10pt;font-size:10pt;"&gt; &lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:top;border-top-style:solid;border-top-width:0.75pt;border-top-color:#bfbfbf;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#bfbfbf;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:0pt;padding-right:0pt;line-height:5pt;font-size:5pt;"&gt; &lt;/p&gt;
&lt;div&gt;&lt;img alt="" height="16" src="fuzoku/m_02_c_s_906580010_01.gif" width="20"/&gt;&lt;br/&gt;
&lt;/div&gt;
&lt;/td&gt;
&lt;td style="vertical-align:top;border-top-style:solid;border-top-width:0.75pt;border-top-color:#bfbfbf;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#bfbfbf;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:0pt;padding-right:0pt;line-height:22pt;"&gt;&lt;b&gt;IBM 1130を導入&lt;/b&gt;&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:0pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;font-size:9pt;"&gt;コンピュータ「IBM 1130」を日本企業として初めて導入し、テスト事業等で活用。情報を取り扱う企業として、最新のIT環境を追求・整備&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:32pt;min-height:32pt;"&gt;
