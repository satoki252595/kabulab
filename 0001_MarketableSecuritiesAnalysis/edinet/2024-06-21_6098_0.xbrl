&lt;/td&gt;
&lt;td rowspan="2" style="vertical-align:middle;border-left-style:solid;border-left-width:0.75pt;border-left-color:#f2f2f2;background-color:#548dd4;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;"&gt;&lt;span style="color:#ffffff;"&gt;固定報酬&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;"&gt;&lt;span style="color:#ffffff;"&gt;(金銭報酬)&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td rowspan="2" style="vertical-align:middle;border-left-style:solid;border-left-width:0.75pt;border-left-color:#f2f2f2;border-right-style:solid;border-right-width:0.75pt;border-right-color:#f2f2f2;background-color:#548dd4;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;"&gt;&lt;span style="color:#ffffff;"&gt;短期インセン&lt;/span&gt;&lt;br/&gt;&lt;span style="color:#ffffff;"&gt;ティブ&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;"&gt;&lt;span style="color:#ffffff;"&gt;(金銭報酬)&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td colspan="2" style="vertical-align:middle;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#f2f2f2;border-left-style:solid;border-left-width:0.75pt;border-left-color:#f2f2f2;background-color:#548dd4;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;"&gt;&lt;span style="color:#ffffff;"&gt;長期インセンティブ&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;"&gt;&lt;span style="color:#ffffff;"&gt;(株式報酬)&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:24pt;min-height:24pt;"&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#f2f2f2;border-left-style:solid;border-left-width:0.75pt;border-left-color:#f2f2f2;border-right-style:solid;border-right-width:0.75pt;border-right-color:#f2f2f2;background-color:#548dd4;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;padding-left:0pt;padding-right:1pt;margin-top:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:10pt;font-size:9pt;"&gt;&lt;span style="color:#ffffff;"&gt;BIP信託&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#f2f2f2;border-left-style:solid;border-left-width:0.75pt;border-left-color:#f2f2f2;background-color:#548dd4;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;padding-right:1pt;"&gt;&lt;span style="color:#ffffff;"&gt;ストックオプション&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
