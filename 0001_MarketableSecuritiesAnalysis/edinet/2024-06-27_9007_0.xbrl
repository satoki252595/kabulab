&lt;p style="margin-left: 6px; line-height: 15.333333333333333333333333333px; margin-right: 3.3333333333333333333333333333px; text-align: left"&gt;
&lt;span style="font-size: 14px"&gt;営業キロ&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
