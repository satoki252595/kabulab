&lt;td style="vertical-align: top; width: 539px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 54.666666666666666666666666667px; margin-right: 12px; text-align: left"&gt;ストック・オプションの権利行使による減少&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 65px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: right"&gt;6,000&lt;/p&gt;
&lt;/td&gt;
