&lt;p style="margin-left: 70px; text-align: left"&gt; &lt;/p&gt;
&lt;p style="margin-left: 84px; text-align: left"&gt; &lt;/p&gt;
&lt;p style="margin-left: 42px; text-align: left"&gt;
&lt;span style="font-size: 14px"&gt;　※2024年度の業績評価指標の目標値&lt;/span&gt;
&lt;/p&gt;
&lt;div style="margin-left: 69.666666666666666666666666667px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 338.13333333333333333333333333px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 170.13333333333333333333333333px"/&gt;
&lt;col style="width: 168px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr style="height: 24.8px"&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 170.13333333333333333333333333px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center; line-height: 1"&gt;
&lt;span style="font-size: 14px"&gt;　業績評価指標&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 168px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center; line-height: 1"&gt;
&lt;span style="font-size: 14px"&gt;目標値（予算値）&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 23.2px"&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 170.13333333333333333333333333px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center; line-height: 1"&gt;
&lt;span style="font-size: 14px"&gt;ＥＢＩＴＤＡ&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 168px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center; line-height: 1"&gt;
&lt;span style="font-size: 14px"&gt;97,000百万円&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 23.2px"&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 170.13333333333333333333333333px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center; line-height: 1"&gt;
&lt;span style="font-size: 14px"&gt;ＲＯＥ&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 168px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center; line-height: 1"&gt;
&lt;span style="font-size: 14px"&gt;5.9％&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
