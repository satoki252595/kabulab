&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 210.2px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-right: 6px; text-align: left"&gt; ―&lt;/p&gt;
