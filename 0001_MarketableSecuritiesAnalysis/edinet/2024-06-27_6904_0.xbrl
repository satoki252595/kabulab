&lt;p style="margin-left: 5px; line-height: 15px; margin-right: 5px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;代表取締役会長&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 73.333333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;
&lt;p style="line-height: 15px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;原田　章二&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
