&lt;/td&gt;
&lt;td style="vertical-align:middle;border-bottom-style:solid;border-bottom-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;line-height:8.5pt;font-size:7.5pt;"&gt;(注)３&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:middle;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblR" style="orphans:0;widows:0;padding-right:2.3pt;line-height:8pt;font-size:7.5pt;"&gt;百万円&lt;/p&gt;&lt;p class="smt_tblR" style="orphans:0;widows:0;padding-right:4.0pt;line-height:8.5pt;font-size:7.5pt;"&gt;174,762&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:middle;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:2.9pt;padding-right:2.9pt;line-height:8.5pt;font-size:7.5pt;"&gt;コンポーネント&lt;br/&gt;電子情報機器&lt;/p&gt;
&lt;/td&gt;
