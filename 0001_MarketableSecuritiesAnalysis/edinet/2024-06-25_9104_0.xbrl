&lt;/tr&gt;
&lt;tr style="height: 37px"&gt;
&lt;td style="vertical-align: middle; width: 280px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 12px; margin-right: 12px; text-align: left"&gt;新株予約権の行使期間　※&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 367.46666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 12px; margin-right: 12px; text-align: center"&gt;2016年８月２日から&lt;/p&gt;
&lt;p style="margin-left: 12px; margin-right: 12px; text-align: center"&gt;2024年６月23日まで&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 37px"&gt;
&lt;td style="vertical-align: middle; width: 280px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 12px; margin-right: 12px; text-align: left"&gt;新株予約権の行使により株式を発行する場合&lt;/p&gt;
&lt;p style="margin-left: 12px; margin-right: 12px; text-align: left"&gt;の株式の発行価格及び資本組入額　※&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 367.46666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 12px; margin-right: 12px; text-align: center"&gt;発行価格   　1,374円&lt;/p&gt;
&lt;p style="margin-left: 12px; margin-right: 12px; text-align: center"&gt;資本組入額     687円&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 27px"&gt;
&lt;td style="vertical-align: middle; width: 280px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 12px; margin-right: 12px; text-align: left"&gt;新株予約権の行使の条件　※&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 367.46666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
