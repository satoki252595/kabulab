&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center"&gt;ソフトウェア等&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 128px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 6px; text-align: right"&gt;3,204百万円&lt;/p&gt;
&lt;p style="margin-right: 6px; text-align: right"&gt;192百万円&lt;/p&gt;
