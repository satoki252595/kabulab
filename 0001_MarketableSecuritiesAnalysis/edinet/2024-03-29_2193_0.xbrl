&lt;h3 class="smt_head2"&gt;４ 【関係会社の状況】&lt;/h3&gt;
&lt;div class="tbld" style="margin-left:0pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:483.8pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
&lt;col style="width:127.5pt;min-width:127.5pt;"/&gt;
&lt;col style="width:85.5pt;min-width:85.5pt;"/&gt;
&lt;col style="width:63pt;min-width:63pt;"/&gt;
&lt;col style="width:82.5pt;min-width:82.5pt;"/&gt;
&lt;col style="width:57.8pt;min-width:57.8pt;"/&gt;
&lt;col style="width:67.5pt;min-width:67.5pt;"/&gt;
