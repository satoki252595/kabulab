</jpcrp030000-asr_E01256-000:MetricsAndTargetsTextBlock>
  <jpcrp030000-asr_E01256-000:DescriptionOfMetricsRelatedToPolicyOnHumanResourceDevelopmentAndImprovementOfInternalEnvironmentAndTargetsAndResultsUsingSuchMetricsMetricsAndTargetsTextBlock contextRef="FilingDateInstant">
&lt;p style="margin-left: 56px; line-height: 21px; text-align: left; text-indent: -14px"&gt;
&lt;span style="font-size: 14px"&gt;ｂ．指標と目標&lt;/span&gt;
&lt;/p&gt;
&lt;div style="margin-left: 57px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 566.26666666666666666666666666px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 188.73333333333333333333333333px"/&gt;
&lt;col style="width: 188.73333333333333333333333333px"/&gt;
&lt;col style="width: 188.8px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr style="height: 4.33px"&gt;
