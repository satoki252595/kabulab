  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E01465-000MaedaToshikazuMember">1966-11-20</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
