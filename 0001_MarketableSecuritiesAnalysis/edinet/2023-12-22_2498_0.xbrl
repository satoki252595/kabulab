&lt;tr style="height: 19px"&gt;
&lt;td rowspan="2" style="vertical-align: middle; width: 250.13333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: left"&gt; 当社&lt;/p&gt;
