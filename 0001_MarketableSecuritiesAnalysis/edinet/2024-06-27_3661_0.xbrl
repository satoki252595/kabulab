  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E26332-000OkiKazuoMember">1968-05-23</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock contextRef="FilingDateInstant_jpcrp030000-asr_E26332-000OkiKazuoMember">
&lt;p style="margin-left: 75px; line-height: 15px; margin-right: 2.3333333333333333333333333333px; text-align: left; text-indent: -70px"&gt;
&lt;span style="font-size: 10px"&gt;1997年４月 環境庁国立環境研究所　重点研究支援協力員&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 75px; line-height: 15px; margin-right: 2.3333333333333333333333333333px; text-align: left; text-indent: -70px"&gt;
&lt;span style="font-size: 10px"&gt;1997年７月 　　群馬大学工学部 助手&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 75px; line-height: 15px; margin-right: 2.3333333333333333333333333333px; text-align: left; text-indent: -70px"&gt;
&lt;span style="font-size: 10px"&gt;1999年９月 東京大学大学院農学生命科学研究科 講師&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 75px; line-height: 15px; margin-right: 2.3333333333333333333333333333px; text-align: left; text-indent: -70px"&gt;
