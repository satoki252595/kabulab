&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:376.6pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
&lt;col style="width:165pt;min-width:165pt;"/&gt;
&lt;col style="width:105.8pt;min-width:105.8pt;"/&gt;
