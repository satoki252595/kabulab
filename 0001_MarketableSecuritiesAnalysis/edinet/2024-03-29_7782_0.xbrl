  <jpcrp_cor:AddressOfShareholderTreasurySharesEtc contextRef="CurrentYearInstant_Row1Member">東京都文京区本郷１丁目28番34号</jpcrp_cor:AddressOfShareholderTreasurySharesEtc>
  <jpcrp_cor:ClassesOfSharesEtcTextBlock contextRef="FilingDateInstant">&lt;p class="smt_head6" style="orphans:0;widows:0;padding-left:29pt;line-height:15pt;"&gt;【株式の種類等】　　会社法第155条第７号及び会社法第155条第13号に該当する普通株式の取得&lt;/p&gt;&lt;p class="smt_text1" style="orphans:0;widows:0;text-align:justify;padding-left:0pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:29pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;font-size:15pt;"&gt; &lt;/p&gt;</jpcrp_cor:ClassesOfSharesEtcTextBlock>
  <jpcrp_cor:AcquisitionsByResolutionOfShareholdersMeetingTextBlock contextRef="FilingDateInstant">
