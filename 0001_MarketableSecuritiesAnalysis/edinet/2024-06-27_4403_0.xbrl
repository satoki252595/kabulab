&lt;tr&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 274.4px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px; background-color: #FEE1D5"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: justify; line-height: 1; text-justify: inter-ideograph"&gt;
新卒総合職女性の採用比率
&lt;/p&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: justify; line-height: 1; text-justify: inter-ideograph"&gt;（(a)多様な人材確保）&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 78.133333333333333333333333333px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: justify; line-height: 1; text-justify: inter-ideograph"&gt;提出会社&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 163.8px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: justify; line-height: 1; text-justify: inter-ideograph"&gt;目標年度：毎年度&lt;/p&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: justify; line-height: 1; text-justify: inter-ideograph"&gt;
30％以上&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 105.93333333333333333333333333px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center; line-height: 16px"&gt;
32.7％&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
