&lt;td style="vertical-align: middle; width: 80px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: left"&gt;１株当たり&lt;/p&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: left"&gt;払込金額&lt;/p&gt;
