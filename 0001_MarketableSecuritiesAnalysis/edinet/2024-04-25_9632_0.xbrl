&lt;tbody&gt;
&lt;tr style="height: 18px"&gt;
&lt;td rowspan="5" style="vertical-align: middle; width: 103.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
