  <jpcrp_cor:InformationAboutParentCompanyEtcOfReportingCompanyTextBlock contextRef="FilingDateInstant">
&lt;h3 class="smt_head2"&gt;１ 【提出会社の親会社等の情報】&lt;/h3&gt;&lt;p class="smt_text2" style="orphans:0;widows:0;"&gt;当社には親会社等はありません。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;"&gt; &lt;/p&gt;</jpcrp_cor:InformationAboutParentCompanyEtcOfReportingCompanyTextBlock>
