&lt;td style="border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none ; width: 50.666666666666666666666666667px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
