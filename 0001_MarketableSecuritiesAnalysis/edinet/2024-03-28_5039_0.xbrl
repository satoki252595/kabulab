&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 522.13333333333333333333333333px; margin-left: auto; margin-right: auto"&gt;
&lt;colgroup&gt;
&lt;col style="width: 434.13333333333333333333333333px"/&gt;
