  <jpcrp_cor:NotesRegardingPledgedAssetsTextBlock contextRef="CurrentYearInstant">
&lt;p style="margin-left: 24px; text-align: left; text-indent: -24px"&gt;※２　担保に供している資産&lt;/p&gt;
&lt;div style="margin-left: 36px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 612px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 240px"/&gt;
&lt;col style="width: 186px"/&gt;
&lt;col style="width: 186px"/&gt;
&lt;/colgroup&gt;
&lt;thead&gt;
&lt;tr style="height: 40px"&gt;
&lt;td style="vertical-align: middle; width: 240px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: left"&gt;
&lt;span style="font-size: 12px"&gt; &lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 186px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
