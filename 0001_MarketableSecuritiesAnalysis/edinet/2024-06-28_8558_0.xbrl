&lt;td style="vertical-align: top; width: 244px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 18px; margin-right: 3.3333333333333333333333333333px; text-align: left"&gt;株式&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 185.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-right: 60px; text-align: right"&gt;－百万円&lt;/p&gt;
&lt;/td&gt;
