&lt;/td&gt;
&lt;td style="border-left: 3px double #000000; border-top: 3px double #000000; border-right: 3px double #000000; border-bottom: 3px double #000000; width: 137.26666666666666666666666667px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px; background-color: #E8EEF8"&gt;
