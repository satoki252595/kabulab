&lt;/table&gt;&lt;p style="clear:both; line-height:0.75pt; width:100%; font-size:0.75pt;"&gt; &lt;/p&gt;
&lt;/div&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:0pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;font-size:15pt;"&gt; &lt;/p&gt;</jpcrp_cor:NotesRegardingAssetsAndLiabilitiesIncurredFromTransactionsWithAffiliatedEntitiesTextBlock>
  <jpcrp_cor:NotesRegardingGuaranteeObligationsTextBlock contextRef="CurrentYearInstant_NonConsolidatedMember">&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:9pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:0pt;letter-spacing:0pt;line-height:15pt;"&gt;&lt;span style="font-size:9pt;"&gt;２  保証債務&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_text3" style="orphans:0;widows:0;"&gt;関係会社の金融機関等からの借入債務に対し、保証を行っております。&lt;/p&gt;&lt;p class="smt_unitR" style="orphans:0;widows:0;padding-left:359.2pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:0pt;line-height:9.5pt;font-size:9.5pt;"&gt; &lt;/p&gt;
&lt;div class="tbld" style="margin-left:0pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:483pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
&lt;col style="width:222pt;min-width:222pt;"/&gt;
&lt;col style="width:85.5pt;min-width:85.5pt;"/&gt;
&lt;col style="width:45pt;min-width:45pt;"/&gt;
&lt;col style="width:85.5pt;min-width:85.5pt;"/&gt;
&lt;col style="width:45pt;min-width:45pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:20.7pt;min-height:20.7pt;"&gt;
