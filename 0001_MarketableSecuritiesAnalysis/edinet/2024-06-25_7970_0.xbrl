&lt;tr style="height:19.9pt;min-height:19.9pt;"&gt;
&lt;td colspan="3" style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;"&gt;第24回(2018年８月28日取締役会決議)&lt;br/&gt;(付与対象者の区分及び人数：当社取締役10名)&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
