  <jpcrp_cor:OtherInformationOnShareAcquisitionRightsTextBlock contextRef="FilingDateInstant">&lt;p class="smt_head4" style="orphans:0;widows:0;"&gt;③ 【その他の新株予約権等の状況】&lt;/p&gt;&lt;p class="smt_text3" style="orphans:0;widows:0;text-indent:13.5pt;"&gt;該当事項はありません。&lt;/p&gt;&lt;p class="smt_text3" style="orphans:0;widows:0;"&gt; &lt;/p&gt;</jpcrp_cor:OtherInformationOnShareAcquisitionRightsTextBlock>
