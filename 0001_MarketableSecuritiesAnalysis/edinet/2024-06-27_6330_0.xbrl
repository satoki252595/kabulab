&lt;/td&gt;
&lt;td style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;line-height:12pt;"&gt;内部統制報告書&lt;br/&gt;およびその添付書類&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;line-height:12pt;"&gt;事業年度　&lt;span&gt;第68期&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;line-height:12pt;"&gt;自　&lt;span&gt;2022年４月１日&lt;/span&gt;&lt;br/&gt;至　&lt;span&gt;2023年３月31日&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;line-height:12pt;"&gt;2023年６月28日&lt;br/&gt;関東財務局長に提出。&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:39.8pt;min-height:39.8pt;"&gt;
&lt;td style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;line-height:12pt;"&gt;(3)&lt;/p&gt;
&lt;/td&gt;
