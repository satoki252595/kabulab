&lt;p style="margin-left: 66px; text-align: left"&gt;④配当性向30％～40％の堅持&lt;/p&gt;
&lt;div style="margin-left: 76px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 315.66666666666666666666666667px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 155.46666666666666666666666667px"/&gt;
&lt;col style="width: 160.2px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 155.46666666666666666666666667px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 0px; margin-right: 6px; text-align: left"&gt;
&lt;span style="font-size: 12px"&gt; &lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 160.2px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
