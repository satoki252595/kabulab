&lt;td style="vertical-align:top;border-top-color:#a9a9a9;border-left-color:#a9a9a9;border-right-color:#a9a9a9;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:3pt;"&gt;&lt;span style="text-decoration:underline;"&gt;会社法第155条第７号及び第13号による普通株式の取得&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
