&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;background-color:#f2dcdb;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:2pt;padding-right:2pt;line-height:7.5pt;"&gt;&lt;span style="font-family:&amp;apos;ＭＳ ゴシック&amp;apos;;font-size:6pt;"&gt;4℃&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:2pt;padding-right:2pt;margin-top:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:7.5pt;font-size:9pt;"&gt;&lt;span style="font-family:&amp;apos;ＭＳ ゴシック&amp;apos;;font-size:6pt;"&gt;シナリオ&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:2pt;padding-right:2pt;margin-top:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:7.5pt;font-size:9pt;"&gt;&lt;span style="font-family:&amp;apos;ＭＳ ゴシック&amp;apos;;font-size:6pt;"&gt;重要度&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:2pt;padding-right:2pt;margin-top:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:7.5pt;font-size:9pt;"&gt;&lt;span style="font-family:&amp;apos;ＭＳ ゴシック&amp;apos;;font-size:6pt;"&gt;※2&lt;/span&gt;&lt;/p&gt;
