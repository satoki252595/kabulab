&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:34pt;min-height:34pt;"&gt;
&lt;td style="vertical-align:top;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:0pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;letter-spacing:0.0pt;line-height:17pt;"&gt;1973年10月&lt;/p&gt;
