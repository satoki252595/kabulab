&lt;/td&gt;
&lt;td style="vertical-align:middle;border-left-color:#000000;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:0pt;padding-right:0pt;"&gt;円&lt;/p&gt;
