&lt;col style="width:72.8pt;min-width:72.8pt;"/&gt;
&lt;col style="width:84pt;min-width:84pt;"/&gt;
&lt;col style="width:120.8pt;min-width:120.8pt;"/&gt;
&lt;col style="width:49.6pt;min-width:49.6pt;"/&gt;
&lt;col style="width:123pt;min-width:123pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr&gt;
&lt;td rowspan="2" style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;background-color:#c6d9f0;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:5.4pt;padding-right:5.4pt;line-height:13pt;"&gt;重要課題&lt;/p&gt;
&lt;/td&gt;
