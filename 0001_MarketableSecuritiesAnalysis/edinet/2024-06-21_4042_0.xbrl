&lt;col style="width:51.8pt;min-width:51.8pt;"/&gt;
&lt;col style="width:51.8pt;min-width:51.8pt;"/&gt;
&lt;col style="width:51.8pt;min-width:51.8pt;"/&gt;
&lt;col style="width:51.8pt;min-width:51.8pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:41.3pt;min-height:41.3pt;"&gt;
