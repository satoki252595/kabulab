  <jpcrp_cor:NotesSignificantAccountingPoliciesFinancialStatementsTextBlock contextRef="CurrentYearDuration">
&lt;h5 class="smt_head5" style="padding-left:9pt;"&gt;（重要な会計方針）&lt;/h5&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:31pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:-27.5pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:14pt;font-size:10.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;（1）資産の評価基準及び評価方法&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:31.5pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:14pt;font-size:10.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;有価証券の評価基準及び評価方法&lt;/span&gt;&lt;/p&gt;
