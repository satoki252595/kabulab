&lt;td style="vertical-align:top;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;line-height:11pt;font-size:7.5pt;"&gt;2015年３月&lt;/p&gt;
&lt;/td&gt;
