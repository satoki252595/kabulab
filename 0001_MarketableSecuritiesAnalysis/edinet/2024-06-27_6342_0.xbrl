  <jpcrp_cor:MajorComponentsOfSellingGeneralAndAdministrativeExpensesTextBlock contextRef="CurrentYearDuration">
&lt;p style="margin-left: 84px; text-align: left; text-indent: -24px"&gt;※１．販売費及び一般管理費のうち主要な費目及び金額は次のとおりであります。&lt;/p&gt;
&lt;div style="margin-left: 60px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 586.66666666666666666666666666px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 200px"/&gt;
&lt;col style="width: 193.33333333333333333333333333px"/&gt;
&lt;col style="width: 193.33333333333333333333333333px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr style="height: 53.33px"&gt;
&lt;td style="vertical-align: middle; width: 200px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;
&lt;span style="font-size: 12px"&gt; &lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
