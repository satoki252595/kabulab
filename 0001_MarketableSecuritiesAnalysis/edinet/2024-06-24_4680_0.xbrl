&lt;p style="line-height: 14px; margin-right: 48px; text-align: right"&gt;159,181&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 154px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
