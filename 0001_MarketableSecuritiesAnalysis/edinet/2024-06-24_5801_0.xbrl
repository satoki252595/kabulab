&lt;col style="width:52.5pt;min-width:52.5pt;"/&gt;
&lt;col style="width:52.5pt;min-width:52.5pt;"/&gt;
&lt;col style="width:28.3pt;min-width:28.3pt;"/&gt;
&lt;col style="width:45pt;min-width:45pt;"/&gt;
&lt;col style="width:45pt;min-width:45pt;"/&gt;
