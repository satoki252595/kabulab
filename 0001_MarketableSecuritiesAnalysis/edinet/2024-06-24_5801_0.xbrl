&lt;col style="width:55.8pt;min-width:55.8pt;"/&gt;
&lt;col style="width:55.8pt;min-width:55.8pt;"/&gt;
&lt;col style="width:55.8pt;min-width:55.8pt;"/&gt;
&lt;col style="width:55.8pt;min-width:55.8pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:1pt;min-height:1pt;"&gt;
&lt;td rowspan="2" style="vertical-align:middle;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:0pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;line-height:12pt;font-size:12pt;"&gt; &lt;/p&gt;
&lt;/td&gt;
&lt;td colspan="2" rowspan="2" style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:0pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;line-height:10pt;"&gt; 役員区分&lt;/p&gt;
&lt;/td&gt;
