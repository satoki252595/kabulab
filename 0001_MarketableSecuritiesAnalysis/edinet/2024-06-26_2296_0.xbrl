  <jpcrp_cor:NotesRegardingGuaranteeObligationsTextBlock contextRef="CurrentYearInstant_NonConsolidatedMember">&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:18pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;font-size:9pt;"&gt;※２．偶発債務&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:45pt;"&gt;次の各会社の金融機関等からの借入金に対して、次のとおり債務保証を行っております。&lt;/p&gt;
&lt;div class="tbld" style="margin-left:54pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:416.3pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
&lt;col style="width:138pt;min-width:138pt;"/&gt;
&lt;col style="width:139.5pt;min-width:139.5pt;"/&gt;
&lt;col style="width:138.8pt;min-width:138.8pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:22.5pt;min-height:22.5pt;"&gt;
