&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:31.5pt;min-height:31.5pt;"&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;"&gt;時価ベースの自己資本比率（％）&lt;br/&gt;（注）２&lt;/p&gt;
&lt;/td&gt;
