&lt;/td&gt;
&lt;td rowspan="2" style="border-left: 0px none #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000; width: 153.86666666666666666666666667px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;9つのマテリアリティ&lt;/span&gt;
&lt;/p&gt;
