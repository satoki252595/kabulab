&lt;td style="vertical-align: middle; width: 104px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt;2023年11月30日&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
