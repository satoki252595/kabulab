  <jpcrp_cor:StatementOfChangesInEquityTextBlock contextRef="CurrentYearDuration">
&lt;h5&gt;③【株主資本等変動計算書】&lt;/h5&gt;
&lt;p style="margin-left: 60px; text-align: left"&gt;前事業年度（自　2022年４月１日　至　2023年３月31日）&lt;/p&gt;
&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 645px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 155px"/&gt;
&lt;col style="width: 70px"/&gt;
&lt;col style="width: 70px"/&gt;
&lt;col style="width: 70px"/&gt;
&lt;col style="width: 70px"/&gt;
&lt;col style="width: 70px"/&gt;
&lt;col style="width: 70px"/&gt;
&lt;col style="width: 70px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr style="height: 15px"&gt;
