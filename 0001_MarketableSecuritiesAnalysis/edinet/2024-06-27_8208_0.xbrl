&lt;p style="margin-left: 3px; text-align: left"&gt;総資産&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 116px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 6px; text-align: right"&gt;36,726&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 116px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 6px; text-align: right"&gt;100.0&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 116px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 6px; text-align: right"&gt;36,547&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 116px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 6px; text-align: right"&gt;100.0&lt;/p&gt;
