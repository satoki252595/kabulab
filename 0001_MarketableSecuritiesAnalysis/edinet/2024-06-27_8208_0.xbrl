&lt;p style="line-height: 15.333333333333333333333333333px; text-align: center"&gt;指標&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: bottom; width: 181.2px; padding-top: 0px; padding-bottom: 0px; padding-left: 6.6px; padding-right: 6.6px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 15.333333333333333333333333333px; text-align: center"&gt;実績&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 34px"&gt;
&lt;td style="vertical-align: bottom; width: 200px; padding-top: 0px; padding-bottom: 0px; padding-left: 6.6px; padding-right: 6.6px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 15.333333333333333333333333333px; text-align: left"&gt;従業員数に占める&lt;/p&gt;
&lt;p style="line-height: 15.333333333333333333333333333px; text-align: left"&gt;ＤＩＹアドバイザーの割合&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: bottom; width: 181.2px; padding-top: 0px; padding-bottom: 0px; padding-left: 6.6px; padding-right: 6.6px; border-left: 0px none ; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 15.333333333333333333333333333px; text-align: center"&gt;26.6％&lt;/p&gt;
&lt;/td&gt;
