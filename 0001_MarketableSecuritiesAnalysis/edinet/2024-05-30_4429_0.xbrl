  <jpcrp_cor:TreasurySharesEtcTextBlock contextRef="FilingDateInstant">
&lt;h5 class="smt_head4"&gt;② 【自己株式等】&lt;/h5&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:right;padding-left:18pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;font-size:9pt;"&gt;&lt;span&gt;&lt;span style="font-size:9pt;"&gt;2024年２月29日&lt;/span&gt;&lt;/span&gt;&lt;span style="font-size:9pt;"&gt;現在&lt;/span&gt;&lt;/p&gt;
&lt;div class="tbld"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:484.9pt;table-layout:fixed;"&gt;
