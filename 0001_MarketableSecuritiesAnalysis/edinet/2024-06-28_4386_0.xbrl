&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 149.06666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center"&gt;当連結会計年度&lt;/p&gt;
&lt;p style="margin-right: 12px; text-align: center"&gt;（自　2023年４月１日&lt;/p&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center"&gt;　至　2024年３月31日）&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 85.93333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
