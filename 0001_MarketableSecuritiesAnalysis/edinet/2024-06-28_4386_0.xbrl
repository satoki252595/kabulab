&lt;td style="vertical-align: middle; width: 180px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 24px; line-height: 13.333333333333333333333333333px; margin-right: 10px; text-align: left"&gt;株主名簿管理人&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 468px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 12px; line-height: 13.333333333333333333333333333px; margin-right: 22px; text-align: left"&gt;東京都千代田区丸の内一丁目４番１号　三井住友信託銀行株式会社&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 29.33px"&gt;
&lt;td style="vertical-align: middle; width: 180px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 24px; line-height: 13.333333333333333333333333333px; margin-right: 10px; text-align: left"&gt;取次所&lt;/p&gt;
