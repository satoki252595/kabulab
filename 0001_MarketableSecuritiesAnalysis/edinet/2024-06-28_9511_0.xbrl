&lt;tr style="height:18pt;min-height:18pt;"&gt;
&lt;td rowspan="7" style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;"&gt;連結貸借対照表計上額が&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;"&gt;取得原価を超えるもの&lt;/p&gt;
&lt;/td&gt;
