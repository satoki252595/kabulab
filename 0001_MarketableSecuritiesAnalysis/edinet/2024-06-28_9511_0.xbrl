&lt;col style="width:58pt;min-width:58pt;"/&gt;
&lt;col style="width:58pt;min-width:58pt;"/&gt;
&lt;col style="width:58pt;min-width:58pt;"/&gt;
&lt;col style="width:58pt;min-width:58pt;"/&gt;
&lt;col style="width:58pt;min-width:58pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:10pt;min-height:10pt;"&gt;
