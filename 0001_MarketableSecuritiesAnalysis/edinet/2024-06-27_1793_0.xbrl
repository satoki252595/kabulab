  <jpcrp_cor:NotesRegardingIssuedSharesAndTreasurySharesTextBlock contextRef="Prior1YearDuration_NonConsolidatedMember">&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:13.5pt;"&gt;１．発行済株式に関する事項&lt;/p&gt;
&lt;div class="tbld" style="text-align:left;"&gt;
&lt;table cellpadding="0" cellspacing="0" class="align_left" style="border-collapse:collapse;border:solid 0pt #000000;width:480pt;table-layout:fixed;"&gt;
