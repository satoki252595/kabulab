&lt;col style="width:56.7pt;min-width:56.7pt;"/&gt;
&lt;col style="width:153pt;min-width:153pt;"/&gt;
&lt;col style="width:153pt;min-width:153pt;"/&gt;
&lt;/colgroup&gt;
