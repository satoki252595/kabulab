&lt;tr&gt;
&lt;td style="vertical-align:top;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:10pt;padding-right:5.4pt;line-height:14pt;font-size:10.5pt;"&gt;&lt;span style="font-family:&amp;apos;ＭＳ Ｐ明朝&amp;apos;;font-size:9pt;"&gt;社外取締役&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
