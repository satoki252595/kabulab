</jpcrp030000-asr_E04914-000:StrategyTextBlock>
  <jpcrp030000-asr_E04914-000:PolicyOnHumanResourceDevelopmentAndImprovementOfInternalEnvironmentStrategyTextBlock contextRef="FilingDateInstant">
