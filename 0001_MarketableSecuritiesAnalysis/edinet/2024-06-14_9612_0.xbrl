&lt;col style="width: 211px"/&gt;
&lt;col style="width: 211px"/&gt;
&lt;/colgroup&gt;
&lt;thead&gt;
&lt;tr style="height: 27px"&gt;
&lt;td style="vertical-align: middle; width: 184.53333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;関連部門の名称&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 211px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
