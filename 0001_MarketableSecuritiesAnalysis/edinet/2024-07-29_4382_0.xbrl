&lt;td style="vertical-align: middle; width: 159.46666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; line-height: 17.333333333333333333333333333px; margin-right: 6px; text-align: left"&gt;バリオセキュア㈱&lt;/p&gt;
&lt;p style="margin-left: 6px; line-height: 17.333333333333333333333333333px; margin-right: 6px; text-align: left"&gt;（注）１、２、３&lt;/p&gt;
