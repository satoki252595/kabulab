&lt;p style="line-height: 16.666666666666666666666666667px; text-align: left"&gt;負債合計&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 97px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
