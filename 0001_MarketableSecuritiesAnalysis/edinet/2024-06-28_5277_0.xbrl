&lt;p style="margin-right: 6px; text-align: right"&gt;5,230&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;/div&gt;
</jpcrp_cor:AnnexedDetailedScheduleOfProvisionsTextBlock>
