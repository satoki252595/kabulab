&lt;p style="margin-left: 120px; margin-right: 6px; text-align: center"&gt;18,550千円&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 202.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 120px; margin-right: 6px; text-align: center"&gt;－千円&lt;/p&gt;
