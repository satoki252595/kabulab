&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 225.46666666666666666666666667px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 68.466666666666666666666666667px"/&gt;
&lt;col style="width: 157px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr style="height: 15px"&gt;
