&lt;p style="margin-left: 0px; margin-right: 0px; text-align: right"&gt;2024年３月31日現在&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;/div&gt;
&lt;p style="margin-left: 72px; line-height: 1.3333333333333333333333333333px; text-align: right; text-indent: -24px"&gt; &lt;/p&gt;
