  <jpcrp_cor:NotesRegardingOperatingExpensesIncurredFromTransactionsWithAffiliatedEntitiesTextBlock contextRef="CurrentYearDuration_NonConsolidatedMember">&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:0pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;font-size:9pt;"&gt;※２　営業費用のうち関係会社との取引&lt;/p&gt;&lt;p class="smt_unitR" style="orphans:0;widows:0;"&gt; &lt;/p&gt;
