&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:12pt;min-height:12pt;"&gt;
&lt;td style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:9pt;padding-right:0pt;line-height:12pt;"&gt;　(4) 資本合計&lt;/p&gt;
&lt;/td&gt;
