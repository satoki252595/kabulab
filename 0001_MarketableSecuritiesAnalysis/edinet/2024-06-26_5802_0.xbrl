&lt;td style="vertical-align: bottom; width: 152px; padding-top: 1px; padding-bottom: 0px; padding-left: 1px; padding-right: 1px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;
