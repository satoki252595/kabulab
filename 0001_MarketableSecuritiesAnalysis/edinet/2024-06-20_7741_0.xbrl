&lt;td style="vertical-align: top; width: 72px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 5px; margin-right: 4.4px; text-align: right"&gt;
&lt;span style="font-size: 10px"&gt;2014年６月&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 148px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 1.3333333333333333333333333333px; margin-right: 4.4px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;当社代表執行役&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 1.3333333333333333333333333333px; margin-right: 4.4px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;最高財務責任者(ＣＦＯ)&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td style="vertical-align: top; width: 72px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 5px; margin-right: 4.4px; text-align: right"&gt;
&lt;span style="font-size: 10px"&gt;2022年６月&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 148px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 1.3333333333333333333333333333px; margin-right: 4.4px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;当社取締役　代表執行役　最高財務責任者(ＣＦＯ)（現任）&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
