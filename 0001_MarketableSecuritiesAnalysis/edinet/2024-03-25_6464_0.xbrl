&lt;/tr&gt;
&lt;tr style="height:19.5pt;min-height:19.5pt;"&gt;
&lt;td rowspan="8" style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-color:#a9a9a9;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;"&gt;有&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;"&gt;形&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;"&gt;固&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;"&gt;定&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;"&gt;資&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;"&gt;産&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-color:#a9a9a9;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;"&gt; 建物&lt;/p&gt;
&lt;/td&gt;
