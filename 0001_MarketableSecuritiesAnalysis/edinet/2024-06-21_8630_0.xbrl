  <jpcrp_cor:AcquisitionsByResolutionOfShareholdersMeetingTextBlock contextRef="FilingDateInstant">
&lt;h4 class="smt_head3"&gt;&lt;b&gt;(1) 【株主総会決議による取得の状況】&lt;/b&gt;
&lt;/h4&gt;&lt;p class="smt_text3" style="orphans:0;widows:0;text-indent:18pt;"&gt;該当事項はありません。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;"&gt; &lt;/p&gt;</jpcrp_cor:AcquisitionsByResolutionOfShareholdersMeetingTextBlock>
