&lt;p style="line-height: 13.333333333333333333333333333px; margin-right: 9.333333333333333333333333333px; text-align: right"&gt;
&lt;span style="font-size: 10px"&gt;11,589&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
