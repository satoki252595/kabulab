&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 64px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 17.866666666666666666666666667px; margin-right: 4px; text-align: right"&gt;22,717&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 53.333333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 17.866666666666666666666666667px; margin-right: 4px; text-align: right"&gt;995&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 68px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 17.866666666666666666666666667px; margin-right: 4px; text-align: right"&gt;77,596&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 68px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 17.866666666666666666666666667px; margin-right: 4px; text-align: right"&gt;87,032&lt;/p&gt;
