&lt;p style="margin-left: 48px; margin-right: 6.6666666666666666666666666667px; text-align: right; text-indent: -1.3333333333333333333333333333px"&gt;30,933&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 154.33333333333333333333333333px; padding-top: 1px; padding-bottom: 0px; padding-left: 1px; padding-right: 1px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 48px; margin-right: 6.6666666666666666666666666667px; text-align: right; text-indent: -1.3333333333333333333333333333px"&gt;22,778&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 23.2px"&gt;
&lt;td style="vertical-align: middle; width: 225.46666666666666666666666667px; padding-top: 1px; padding-bottom: 0px; padding-left: 1px; padding-right: 1px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: left; text-indent: 6.4px"&gt;持分法投資損失&lt;/p&gt;
&lt;p style="text-align: left; text-indent: 6.4px"&gt;（オーストアジア社持分に関する&lt;/p&gt;
&lt;p style="text-align: left; text-indent: 6.4px"&gt;　持分法投資損失額）&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 154.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 48px; margin-right: 6.6666666666666666666666666667px; text-align: right; text-indent: -1.3333333333333333333333333333px"&gt;3,049&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 154.33333333333333333333333333px; padding-top: 1px; padding-bottom: 0px; padding-left: 1px; padding-right: 1px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 48px; margin-right: 6.6666666666666666666666666667px; text-align: right; text-indent: -1.3333333333333333333333333333px"&gt;9,714&lt;/p&gt;
