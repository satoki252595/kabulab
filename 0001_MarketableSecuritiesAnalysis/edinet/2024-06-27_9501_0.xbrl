&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-color:#000000;border-bottom-color:#000000;border-left-color:#000000;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblR" style="orphans:0;widows:0;padding-right:31.5pt;"&gt;7,447&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
