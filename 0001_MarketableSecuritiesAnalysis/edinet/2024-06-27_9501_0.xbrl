&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:13pt;min-height:13pt;"&gt;
&lt;td style="vertical-align:top;border-top-color:#000000;border-bottom-color:#000000;border-left-color:#000000;border-right-color:#000000;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;line-height:13pt;"&gt;2022年８月&lt;/p&gt;
&lt;/td&gt;
