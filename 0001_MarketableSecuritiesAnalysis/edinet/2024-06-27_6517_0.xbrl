  <jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E01758-000KotoMakotoMember">古東　誠</jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E01758-000KotoMakotoMember">1959-06-18</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock contextRef="FilingDateInstant_jpcrp030000-asr_E01758-000KotoMakotoMember">
&lt;p style="margin-left: 65px; line-height: 13.333333333333333333333333333px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;1983年４月　三井物産株式会社入社&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 13.333333333333333333333333333px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;2000年９月　同社人事部給与企画室長&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 13.333333333333333333333333333px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;2008年10月　米国三井物産株式会社SVP&amp;amp;CHRO&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 13.333333333333333333333333333px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;2011年12月　アジア・大洋州三井物産株式会社SVP&amp;amp;CHRO&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 13.333333333333333333333333333px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;2013年４月　三井物産株式会社　秘書室長&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 13.333333333333333333333333333px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;2016年４月　同社理事秘書室長&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 13.333333333333333333333333333px; text-align: left; text-indent: -60px"&gt;
