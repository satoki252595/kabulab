&lt;td style="vertical-align: middle; width: 243px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 12px; text-align: left"&gt;投資有価証券（＊２）&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 135px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-right: 12px; text-align: right"&gt;
&lt;span style="font-size: 12px"&gt; &lt;/span&gt;
