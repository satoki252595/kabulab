  <jpcrp_cor:NotesRegardingGuaranteeObligationsTextBlock contextRef="CurrentYearInstant_NonConsolidatedMember">&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:9pt;"&gt;２．偶発債務&lt;/p&gt;&lt;p class="smt_text3" style="orphans:0;widows:0;"&gt;(訴訟事項)&lt;/p&gt;&lt;p class="smt_unitR" style="orphans:0;widows:0;"&gt; &lt;/p&gt;
