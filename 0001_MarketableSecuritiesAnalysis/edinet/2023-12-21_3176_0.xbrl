&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:17pt;min-height:17pt;"&gt;
&lt;td style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;padding-left:0pt;padding-right:0pt;margin-top:1.5pt;margin-bottom:1.5pt;letter-spacing:0pt;line-height:11pt;"&gt;2004年１月&lt;/p&gt;
