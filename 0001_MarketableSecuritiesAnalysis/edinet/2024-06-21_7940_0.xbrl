  <jpcrp_cor:DisposalsOrHoldingOfAcquiredTreasurySharesTextBlock contextRef="FilingDateInstant">
&lt;h4&gt;（４）【取得自己株式の処理状況及び保有状況】&lt;/h4&gt;
&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 617.33333333333333333333333335px; margin-left: auto; margin-right: auto"&gt;
&lt;colgroup&gt;
&lt;col style="width: 206.66666666666666666666666667px"/&gt;
&lt;col style="width: 102.66666666666666666666666667px"/&gt;
