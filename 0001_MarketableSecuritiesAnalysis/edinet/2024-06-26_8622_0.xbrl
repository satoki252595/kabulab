&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:4.5pt;padding-right:0pt;line-height:10pt;"&gt;&lt;span style="font-family:&amp;apos;ＭＳ Ｐ明朝&amp;apos;;font-size:9pt;"&gt;(1)トレーディング商品&lt;/span&gt;&lt;/p&gt;
