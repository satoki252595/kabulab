&lt;td style="vertical-align:top;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:justify;padding-left:15.9pt;padding-right:5.4pt;margin-bottom:0pt;line-height:14pt;font-size:10.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;小林克徳（代表取締役社長）※&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:9pt;"&gt;魚津亨&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:9pt;"&gt;須田恭通&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:justify;padding-left:15.9pt;padding-right:5.4pt;margin-top:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:14pt;font-size:10.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;毛塚徹也&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:justify;padding-left:15.9pt;padding-right:5.4pt;margin-top:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:14pt;font-size:10.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;菅原昭仁&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:justify;padding-left:15.9pt;padding-right:5.4pt;margin-top:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:14pt;font-size:9pt;"&gt;&lt;span style="font-size:9pt;"&gt;井口英樹（常勤（監））&lt;/span&gt;&lt;/p&gt;
