&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center"&gt;役職名&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 139px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center"&gt;氏名&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 92px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center"&gt;開催回数&lt;/p&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center"&gt;（回）&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 92px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center"&gt;出席回数&lt;/p&gt;
