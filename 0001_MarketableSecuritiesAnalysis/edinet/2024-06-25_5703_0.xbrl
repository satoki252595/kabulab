  <jpcrp_cor:NotesRegardingGuaranteeObligationsTextBlock contextRef="CurrentYearInstant">
&lt;p style="text-align: left"&gt;　３　偶発債務&lt;/p&gt;
&lt;p style="margin-left: 24px; text-align: left"&gt;（1）保証債務&lt;/p&gt;
