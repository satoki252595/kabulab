&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr style="height: 37.8px"&gt;
&lt;td style="vertical-align: middle; width: 145.4px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 2px solid #000000; border-bottom: 2px solid #000000"&gt;
&lt;p style="margin-left: 1.9333333333333333333333333333px; text-align: center"&gt;
&lt;span style="font-size: 12px"&gt; &lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 98.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 2px solid #000000; border-top: 1px solid #000000; border-right: 3px double #000000; border-bottom: 2px solid #000000"&gt;
&lt;p style="text-align: center"&gt;2023年&lt;/p&gt;
&lt;p style="text-align: center"&gt;３月期&lt;/p&gt;
&lt;p style="text-align: center"&gt;（実績）&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 98.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 3px double #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 2px solid #000000"&gt;
&lt;p style="text-align: center"&gt;2024年&lt;/p&gt;
&lt;p style="text-align: center"&gt;３月期&lt;/p&gt;
&lt;p style="text-align: center"&gt;（実績）&lt;/p&gt;
&lt;/td&gt;
