&lt;td style="vertical-align: middle; width: 123px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 42px; text-align: right"&gt;△4.9&lt;/p&gt;
