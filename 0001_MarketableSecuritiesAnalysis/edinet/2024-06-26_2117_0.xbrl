&lt;td rowspan="2" style="vertical-align: top; width: 13.333333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 12px; line-height: 18.666666666666666666666666667px; text-align: left"&gt; &lt;/p&gt;
&lt;p style="margin-left: 12px; line-height: 18.666666666666666666666666667px; text-align: left"&gt; &lt;/p&gt;
