  <jpcrp_cor:AnnexedDetailedScheduleOfPropertyPlantAndEquipmentEtcTextBlock contextRef="CurrentYearDuration">
&lt;h6 class="smt_head5" style="padding-left:45pt;"&gt;【有形固定資産等明細表】&lt;/h6&gt;&lt;p class="smt_unitR" style="orphans:0;widows:0;line-height:6pt;"&gt;　&lt;/p&gt;
&lt;div class="tbld" style="margin-left:2.5pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:462pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
