&lt;tr style="height: 27px"&gt;
&lt;td style="vertical-align: middle; width: 190.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; margin-right: 3.3333333333333333333333333333px; text-align: left"&gt;最低株価&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 49.333333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt;（円）&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 82.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 8.666666666666666666666666667px; text-align: right"&gt;352&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 82.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 8.666666666666666666666666667px; text-align: right"&gt;368&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 82.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 8.666666666666666666666666667px; text-align: right"&gt;515&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 82.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 8.666666666666666666666666667px; text-align: right"&gt;505&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 82.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 8.666666666666666666666666667px; text-align: right"&gt;527&lt;/p&gt;
&lt;/td&gt;
