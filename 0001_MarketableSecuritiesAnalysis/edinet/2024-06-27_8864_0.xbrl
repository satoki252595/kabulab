&lt;p style="margin-right: 8.666666666666666666666666667px; text-align: right"&gt;615&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 82.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 8.666666666666666666666666667px; text-align: right"&gt;696&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 82.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 8.666666666666666666666666667px; text-align: right"&gt;579&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 82.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 8.666666666666666666666666667px; text-align: right"&gt;662&lt;/p&gt;
&lt;/td&gt;
