&lt;td style="vertical-align: middle; width: 176px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: left"&gt;１株当たり四半期純利益又は　１株当たり四半期純損失（△）（円）&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 118px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 6px; text-align: right"&gt;3.12&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 118px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 6px; text-align: right"&gt;△3.54&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 118px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 6px; text-align: right"&gt;15.18&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 118px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 6px; text-align: right"&gt;12.26&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;/div&gt;
</jpcrp_cor:OtherInformationFinancialStatementsEtcTextBlock>
  <jpcrp_cor:OverviewOfOperationalProceduresForSharesTextBlock contextRef="FilingDateInstant">
&lt;h2&gt;第６【提出会社の株式事務の概要】&lt;/h2&gt;
