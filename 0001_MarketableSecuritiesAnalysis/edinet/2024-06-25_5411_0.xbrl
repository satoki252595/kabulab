  <jpcrp_cor:InformationAboutCompaniesOtherThanGuaranteeCompanyTextBlock contextRef="FilingDateInstant">&lt;p style="page-break-before:always; line-height:0.75pt; width:100%; font-size:0.75pt;"&gt; &lt;/p&gt;&lt;p class="smt_head1" style="orphans:0;widows:0;"&gt;第２ 【保証会社以外の会社の情報】&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;"&gt; &lt;/p&gt;&lt;p class="smt_text1" style="orphans:0;widows:0;font-size:10.5pt;"&gt;該当事項はありません。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;"&gt; &lt;/p&gt;</jpcrp_cor:InformationAboutCompaniesOtherThanGuaranteeCompanyTextBlock>
  <jpcrp_cor:InformationAboutIndexEtcTextBlock contextRef="FilingDateInstant">&lt;p class="smt_head1" style="orphans:0;widows:0;"&gt;第３ 【指数等の情報】&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;"&gt; &lt;/p&gt;&lt;p class="smt_text1" style="orphans:0;widows:0;font-size:10.5pt;"&gt;該当事項はありません。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;"&gt; &lt;/p&gt;</jpcrp_cor:InformationAboutIndexEtcTextBlock>
