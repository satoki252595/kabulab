&lt;col style="width:117.8pt;min-width:117.8pt;"/&gt;
&lt;col style="width:91.3pt;min-width:91.3pt;"/&gt;
&lt;col style="width:91.3pt;min-width:91.3pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr&gt;
&lt;td style="vertical-align:top;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:5.4pt;padding-right:5.4pt;text-justify:inter-ideograph;text-indent:0pt;line-height:14pt;"&gt;&lt;span style="font-size:9pt;"&gt;区分&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td colspan="2" style="vertical-align:top;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:5.4pt;padding-right:5.4pt;text-justify:inter-ideograph;text-indent:0pt;line-height:14pt;"&gt;&lt;span style="font-size:9pt;"&gt;目標指標&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:top;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:5.4pt;padding-right:5.4pt;text-justify:inter-ideograph;text-indent:0pt;line-height:14pt;"&gt;&lt;span style="font-size:9pt;"&gt;2024年度目標&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:top;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:5.4pt;padding-right:5.4pt;text-justify:inter-ideograph;text-indent:0pt;line-height:14pt;"&gt;&lt;span style="font-size:9pt;"&gt;2030年度目標&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td rowspan="2" style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:5.4pt;padding-right:5.4pt;text-justify:inter-ideograph;text-indent:0pt;line-height:14pt;"&gt;&lt;span style="font-size:9pt;"&gt;環境対応&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td colspan="2" style="vertical-align:top;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:5.4pt;padding-right:5.4pt;text-justify:inter-ideograph;text-indent:0pt;line-height:14pt;"&gt;&lt;span style="font-size:9pt;"&gt;CO2排出量　削減率（対2013年度比）&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
