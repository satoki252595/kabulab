&lt;td style="vertical-align: top; width: 558px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; line-height: 17.333333333333333333333333333px; margin-right: 6px; text-align: left"&gt;静岡県富士宮市山宮に第２テクニカルセンターを開設。&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td style="vertical-align: top; width: 88px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="line-height: 17.333333333333333333333333333px; margin-right: 6px; text-align: right"&gt;2007年４月&lt;/p&gt;
