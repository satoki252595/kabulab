  <jpcrp_cor:CriticalContractsForOperationTextBlock contextRef="FilingDateInstant">&lt;p style="page-break-before:always; line-height:0.75pt; width:100%; font-size:0.75pt;"&gt; &lt;/p&gt;
&lt;h3 class="smt_head2"&gt;５ 【経営上の重要な契約等】&lt;/h3&gt;
&lt;h4 class="smt_head3"&gt;(1) 主要技術導入契約&lt;/h4&gt;
&lt;h5 class="smt_head4"&gt;(提出会社)&lt;/h5&gt;
&lt;div class="tbld" style="margin-left:0pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:483.1pt;table-layout:fixed;"&gt;
