  <jpcrp_cor:NameOfGroupCompanyHoldingLargestAmountOfInvestmentSharesInGroup contextRef="CurrentYearInstant">株式会社サイバージムジャパン</jpcrp_cor:NameOfGroupCompanyHoldingLargestAmountOfInvestmentSharesInGroup>
