&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:22.6pt;min-height:22.6pt;"&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;"&gt;フジ日本精糖㈱&lt;/p&gt;
&lt;/td&gt;
