&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 107px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none ; background-color: #FFFFFF"&gt;
&lt;p style="margin-right: 60px; text-align: right"&gt;(6)&lt;/p&gt;
