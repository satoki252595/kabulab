&lt;/td&gt;
&lt;td style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblR" style="orphans:0;widows:0;padding-right:1.7pt;line-height:10.5pt;font-size:10.5pt;"&gt; &lt;/p&gt;
