&lt;/td&gt;
&lt;td style="border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 1px solid #000000; width: 160.93333333333333333333333333px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 8px; margin-right: 6px; text-align: right; line-height: 18px"&gt;（単位：千円）&lt;/p&gt;
&lt;/td&gt;
