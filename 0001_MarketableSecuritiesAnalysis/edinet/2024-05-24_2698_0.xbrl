&lt;tr&gt;
&lt;td style="vertical-align: middle; width: 74.4px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px dashed #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt;（５）&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 111.53333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 1px dashed #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p class="text_align_justify"&gt;払込期日&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 446.06666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: left"&gt;2023年７月12日&lt;/p&gt;
