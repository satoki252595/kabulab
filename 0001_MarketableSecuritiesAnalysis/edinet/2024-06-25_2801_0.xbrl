&lt;td style="vertical-align: middle; width: 138px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; margin-right: 4.6666666666666666666666666667px; text-align: left"&gt;1990年１月９日から&lt;/p&gt;
&lt;p style="margin-left: 6px; margin-right: 4.6666666666666666666666666667px; text-align: left"&gt;永久&lt;/p&gt;
