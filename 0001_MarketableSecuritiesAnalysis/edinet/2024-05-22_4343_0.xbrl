&lt;td style="vertical-align:top;border-top-color:#a9a9a9;border-left-color:#a9a9a9;border-right-color:#a9a9a9;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:5.5pt;padding-right:5.5pt;line-height:11pt;font-size:7.5pt;"&gt;同社董事長総経理&lt;/p&gt;
