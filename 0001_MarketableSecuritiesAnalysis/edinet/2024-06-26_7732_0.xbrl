  <jpcrp_cor:DescriptionIssuedSharesVotingRights contextRef="CurrentYearInstant_OrdinarySharesTreasurySharesSharesWithFullVotingRightsTreasurySharesEtcMember">―――</jpcrp_cor:DescriptionIssuedSharesVotingRights>
  <jpcrp_cor:DescriptionIssuedSharesVotingRights contextRef="CurrentYearInstant_OrdinarySharesSharesWithFullVotingRightsOtherMember">―――</jpcrp_cor:DescriptionIssuedSharesVotingRights>
