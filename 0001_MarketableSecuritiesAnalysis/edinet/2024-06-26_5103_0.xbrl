&lt;col style="width:180pt;min-width:180pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:14.2pt;min-height:14.2pt;"&gt;
&lt;td style="vertical-align:middle;border-top-color:#a9a9a9;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-color:#a9a9a9;border-right-color:#a9a9a9;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:9.1pt;padding-right:0pt;text-justify:inter-ideograph;text-indent:-9.1pt;line-height:11pt;"&gt;勤務費用&lt;/p&gt;
&lt;/td&gt;
