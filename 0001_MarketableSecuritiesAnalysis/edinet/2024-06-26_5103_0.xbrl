&lt;td style="vertical-align:top;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;line-height:14.5pt;"&gt;2008年６月&lt;/p&gt;
&lt;/td&gt;
