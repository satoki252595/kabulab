&lt;td style="vertical-align:top;border-top-style:solid;border-top-width:0.75pt;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblR" style="orphans:0;widows:0;padding-right:5.4pt;line-height:14pt;"&gt;840,855千円&lt;/p&gt;
