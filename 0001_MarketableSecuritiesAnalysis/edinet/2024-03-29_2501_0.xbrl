&lt;p style="margin-left: 5px; line-height: 16.666666666666666666666666667px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;2009年10月&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 259.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 5px; line-height: 16.666666666666666666666666667px; margin-right: 3px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;株式会社企業再生支援機構（現株式会社地域経済活性化支援機構）出向&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 1.33px"&gt;
&lt;td style="vertical-align: top; width: 60px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 5px; line-height: 16.666666666666666666666666667px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;2020年１月&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 259.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 5px; line-height: 16.666666666666666666666666667px; margin-right: 3px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;当社　社外監査役&lt;/span&gt;
&lt;/p&gt;
