&lt;p style="margin-left: 6px; margin-right: 6px; text-align: left"&gt;インタレスト・カバレッジ・レシオ（倍）&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 93px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 36px; margin-right: 6px; text-align: right"&gt;4.5&lt;/p&gt;
&lt;/td&gt;
