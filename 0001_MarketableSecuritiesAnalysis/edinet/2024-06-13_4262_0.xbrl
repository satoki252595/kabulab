&lt;/td&gt;
&lt;td style="vertical-align:top;border-top-color:#a9a9a9;border-bottom-color:#a9a9a9;border-left-style:solid;border-left-width:0.75pt;border-right-color:#a9a9a9;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:justify;padding-left:4.8pt;padding-right:4.8pt;font-size:7.5pt;"&gt;株式会社リビングプラットフォーム社外監査役(現任）&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
