&lt;p style="text-align: left"&gt; &lt;/p&gt;
</jpcrp030000-asr_E36722-000:GovernanceTextBlock>
  <jpcrp030000-asr_E36722-000:StrategyTextBlock contextRef="FilingDateInstant">
