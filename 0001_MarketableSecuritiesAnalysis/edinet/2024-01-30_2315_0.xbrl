&lt;/td&gt;
&lt;td style="vertical-align:top;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:right;padding-right:9pt;font-size:9pt;"&gt;57,587,800千円&lt;/p&gt;
