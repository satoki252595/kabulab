&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:right;padding-right:27pt;font-size:9pt;"&gt;56,588,023&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
