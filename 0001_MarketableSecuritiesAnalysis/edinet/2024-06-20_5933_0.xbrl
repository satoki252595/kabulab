&lt;/tr&gt;
&lt;tr style="height: 26.67px"&gt;
&lt;td style="vertical-align: middle; width: 127.2px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 54px; text-align: right"&gt;4.9&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 127.2px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 54px; text-align: right"&gt;88.2&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 127.2px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 54px; text-align: right"&gt;63.4&lt;/p&gt;
&lt;/td&gt;
