&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;"&gt;&lt;span style="font-size:7.5pt;"&gt;取締役社長 社長執行役員&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:7.5pt;"&gt;(代表取締役)&lt;/span&gt;&lt;/p&gt;
