&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:1.5pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;
