&lt;colgroup&gt;
&lt;col style="width: 120px"/&gt;
&lt;col style="width: 169.33333333333333333333333333px"/&gt;
&lt;col style="width: 169.33333333333333333333333333px"/&gt;
&lt;/colgroup&gt;
