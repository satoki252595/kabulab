&lt;tr style="height: 1.33px"&gt;
&lt;td style="vertical-align: middle; width: 292px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 1; text-align: left"&gt;見積りの変更による減少額&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 130px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-right: 5.3333333333333333333333333333px; text-align: right"&gt;－ 〃&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 130px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-right: 5.3333333333333333333333333333px; text-align: right"&gt;△3,383 〃&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 1.33px"&gt;
&lt;td style="vertical-align: middle; width: 292px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 1; text-align: left"&gt;資産除去債務の履行による減少額&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 130px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-right: 5.3333333333333333333333333333px; text-align: right"&gt;－ 〃&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 130px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-right: 5.3333333333333333333333333333px; text-align: right"&gt;△3,000 〃&lt;/p&gt;
