&lt;p style="line-height: 15px; margin-right: 5px; text-align: right"&gt;
&lt;span style="font-size: 10px"&gt;155&lt;/span&gt;
&lt;/p&gt;
&lt;p style="line-height: 15px; text-align: right"&gt;
