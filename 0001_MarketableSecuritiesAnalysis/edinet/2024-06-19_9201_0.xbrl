&lt;/td&gt;
&lt;td rowspan="2" style="vertical-align: middle; width: 41.333333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 17.333333333333333333333333333px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;設備の&lt;/span&gt;
&lt;/p&gt;
&lt;p style="line-height: 17.333333333333333333333333333px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;賃貸借&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 48px"&gt;
&lt;td style="vertical-align: middle; width: 37.333333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 17.333333333333333333333333333px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;直接（％）&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 37.333333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 17.333333333333333333333333333px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;間接（％）&lt;/span&gt;
