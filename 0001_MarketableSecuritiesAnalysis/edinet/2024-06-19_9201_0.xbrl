&lt;p style="margin-left: 36px; text-align: left"&gt; &lt;/p&gt;
&lt;p style="margin-left: 36px; text-align: left"&gt;1987年11月&lt;/p&gt;
&lt;p style="margin-left: 36px; text-align: left"&gt;1988年４月&lt;/p&gt;
&lt;p style="margin-left: 36px; text-align: left"&gt;1993年１月&lt;/p&gt;
&lt;p style="margin-left: 36px; text-align: left"&gt;2002年９月&lt;/p&gt;
&lt;p style="margin-left: 36px; text-align: left"&gt; &lt;/p&gt;
&lt;p style="margin-left: 36px; text-align: left"&gt; &lt;/p&gt;
