&lt;col style="width:29.9pt;min-width:29.9pt;"/&gt;
&lt;col style="width:84pt;min-width:84pt;"/&gt;
&lt;col style="width:84pt;min-width:84pt;"/&gt;
&lt;col style="width:84pt;min-width:84pt;"/&gt;
