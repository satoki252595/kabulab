  <jpcrp_cor:ShareholdingByShareholderCategoryTextBlock contextRef="FilingDateInstant">
&lt;h4 class="smt_head3"&gt;(5) 【所有者別状況】&lt;/h4&gt;&lt;p class="smt_unitR" style="orphans:0;widows:0;padding-left:377.3pt;line-height:10pt;"&gt;&lt;span&gt;2024年３月31日&lt;/span&gt;現在&lt;/p&gt;
&lt;div class="tbld" style="margin-left:0.1pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:468pt;table-layout:fixed;"&gt;
