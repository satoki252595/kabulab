&lt;tr style="height:12pt;min-height:12pt;"&gt;
&lt;td colspan="5" style="vertical-align:middle;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:right;line-height:12pt;font-size:10.5pt;"&gt;&lt;span style="font-family:&amp;apos;ＭＳ 明朝&amp;apos;;font-size:9pt;"&gt;（単位：&lt;/span&gt;&lt;span style="font-size:9pt;"&gt;t-ＣＯ&lt;/span&gt;&lt;span style="font-size:9pt;"&gt;&lt;sub&gt;２&lt;/sub&gt;&lt;/span&gt;&lt;span style="font-family:&amp;apos;ＭＳ 明朝&amp;apos;;font-size:9pt;"&gt;）&lt;/span&gt;&lt;/p&gt;
