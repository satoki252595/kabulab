  <jpcrp_cor:ChangesInNumberOfIssuedSharesStatedCapitalEtcTextBlock contextRef="FilingDateInstant">
&lt;h4&gt;（４）【発行済株式総数、資本金等の推移】&lt;/h4&gt;
&lt;div style="margin-left: 24px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 623.86666666666666666666666665px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 111.86666666666666666666666667px"/&gt;
&lt;col style="width: 85.33333333333333333333333333px"/&gt;
&lt;col style="width: 85.33333333333333333333333333px"/&gt;
&lt;col style="width: 85.33333333333333333333333333px"/&gt;
&lt;col style="width: 85.33333333333333333333333333px"/&gt;
&lt;col style="width: 85.33333333333333333333333333px"/&gt;
&lt;col style="width: 85.33333333333333333333333333px"/&gt;
&lt;/colgroup&gt;
