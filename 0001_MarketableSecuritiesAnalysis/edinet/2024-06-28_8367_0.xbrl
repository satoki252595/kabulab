&lt;/td&gt;
&lt;td style="vertical-align:top;border-top-color:#a9a9a9;border-bottom-color:#a9a9a9;border-left-color:#a9a9a9;border-right-color:#a9a9a9;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;margin-top:3pt;line-height:11pt;"&gt;事業年度&lt;br/&gt;(&lt;span&gt;第135期&lt;/span&gt;)&lt;/p&gt;
