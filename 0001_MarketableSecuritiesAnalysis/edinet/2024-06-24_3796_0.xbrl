&lt;tbody&gt;
&lt;tr style="height: 17px"&gt;
&lt;td style="vertical-align: top; width: 64px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 16px; text-align: center"&gt;（1）&lt;/p&gt;
&lt;/td&gt;
