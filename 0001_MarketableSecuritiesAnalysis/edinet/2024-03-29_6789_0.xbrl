&lt;tr style="height:12.4pt;min-height:12.4pt;"&gt;
&lt;td style="vertical-align:top;border-top-color:#a9a9a9;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblR" style="orphans:0;widows:0;font-size:7.5pt;"&gt;(32)&lt;/p&gt;
&lt;/td&gt;
