  <jpcrp_cor:MajorShareholdersTextBlock contextRef="FilingDateInstant">&lt;p style="page-break-before:always; line-height:0.75pt; width:100%; font-size:0.75pt;"&gt; &lt;/p&gt;
&lt;h4 class="smt_head3"&gt;(6) 【大株主の状況】&lt;/h4&gt;&lt;p class="smt_unitR" style="orphans:0;widows:0;padding-left:377.3pt;line-height:10pt;"&gt;&lt;span&gt;&lt;span style="font-family:&amp;apos;ＭＳ 明朝&amp;apos;;font-size:9pt;"&gt;2023年９月30日&lt;/span&gt;&lt;/span&gt;&lt;span style="font-family:&amp;apos;ＭＳ 明朝&amp;apos;;font-size:9pt;"&gt;現在&lt;/span&gt;&lt;/p&gt;
