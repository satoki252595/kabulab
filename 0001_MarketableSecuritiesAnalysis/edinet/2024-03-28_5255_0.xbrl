&lt;p style="line-height: 15px; text-align: right"&gt;
&lt;span style="font-size: 10px"&gt;2023年12月31日現在&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;/div&gt;
&lt;p style="line-height: 1.3333333333333333333333333333px; text-align: left"&gt; &lt;/p&gt;
&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 648.00000000000000000000000002px"&gt;
&lt;colgroup&gt;
