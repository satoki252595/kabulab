&lt;/td&gt;
&lt;td style="vertical-align:top;border-top-color:#a9a9a9;border-left-color:#a9a9a9;border-right-color:#a9a9a9;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:5.7pt;padding-right:5.7pt;margin-top:0pt;margin-bottom:0pt;line-height:11pt;"&gt;&lt;span style="font-size:7.5pt;"&gt;当社 監査役（現任）&lt;/span&gt;&lt;/p&gt;
