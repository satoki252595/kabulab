&lt;p style="text-align: center"&gt;
0.21
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 33.333333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none ; background-color: #FFFFFF"&gt;
