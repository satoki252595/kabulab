&lt;p style="margin-left: 24px; line-height: 14.666666666666666666666666667px; text-align: left; text-indent: 12px"&gt; &lt;/p&gt;
&lt;p style="line-height: 1.3333333333333333333333333333px; text-align: left"&gt; &lt;/p&gt;
</jpcrp_cor:NotesSecuritiesFinancialStatementsTextBlock>
