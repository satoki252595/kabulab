&lt;p style="margin-left: 6px; line-height: 14px; margin-right: 3.3333333333333333333333333333px; text-align: left"&gt;受取手形&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 200px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 14px; margin-right: 6px; text-align: right"&gt;－千円&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 200.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 14px; margin-right: 6px; text-align: right"&gt;5,287千円&lt;/p&gt;
