&lt;/table&gt;
&lt;/div&gt;
</jpcrp_cor:NotesRegardingPromissoryNotesDueOnBalanceSheetDateTextBlock>
  <jpcrp_cor:MajorComponentsOfSellingGeneralAndAdministrativeExpensesTextBlock contextRef="CurrentYearDuration">
&lt;p style="margin-left: 12px; line-height: 14.666666666666666666666666667px; margin-right: 0px; text-align: left"&gt;※１　販売費及び一般管理費のうち主要な費目及び金額は次のとおりであります。&lt;/p&gt;
&lt;div style="margin-left: 42px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 608px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 208px"/&gt;
&lt;col style="width: 200px"/&gt;
&lt;col style="width: 200px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr style="height: 40px"&gt;
&lt;td style="vertical-align: middle; width: 208px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 0px; text-align: center"&gt;
&lt;span style="font-size: 12px"&gt; &lt;/span&gt;
