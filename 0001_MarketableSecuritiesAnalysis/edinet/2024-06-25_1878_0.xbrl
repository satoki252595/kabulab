&lt;colgroup&gt;
&lt;col style="width:233.6pt;min-width:233.6pt;"/&gt;
&lt;col style="width:233.6pt;min-width:233.6pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:13.5pt;min-height:13.5pt;"&gt;
&lt;td colspan="2" style="vertical-align:top;border-top-color:#a9a9a9;border-bottom-color:#a9a9a9;border-left-color:#a9a9a9;border-right-color:#a9a9a9;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:32.3pt;padding-right:0pt;line-height:13.5pt;"&gt;事業年度  &lt;span&gt;第49期&lt;/span&gt;（自 &lt;span&gt;2022年４月１日&lt;/span&gt;  至 &lt;span&gt;2023年３月31日&lt;/span&gt;）2023年６月28日関東財務局長に提出。&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/table&gt;&lt;p style="clear:both; line-height:0.75pt; width:100%; font-size:0.75pt;"&gt; &lt;/p&gt;
