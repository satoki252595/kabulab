&lt;td style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:13pt;"&gt;固定負債&lt;/p&gt;
&lt;/td&gt;
