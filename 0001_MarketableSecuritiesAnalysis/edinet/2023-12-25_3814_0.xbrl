&lt;td style="vertical-align: top; width: 120px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 16.933333333333333333333333333px; margin-right: 13.333333333333333333333333333px; text-align: right"&gt;△2,960.6&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 120px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 16.933333333333333333333333333px; margin-right: 13.333333333333333333333333333px; text-align: right"&gt;△5,639.9&lt;/p&gt;
