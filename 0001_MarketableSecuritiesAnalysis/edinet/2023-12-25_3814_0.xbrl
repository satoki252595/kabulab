&lt;tr style="height: 26.67px"&gt;
&lt;td style="vertical-align: middle; width: 324.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; line-height: 18px; margin-right: 6px; text-align: left"&gt;
&lt;span style="font-size: 12px"&gt; &lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 163.13333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; line-height: 18px; margin-right: 6px; text-align: center"&gt;第４四半期会計期間&lt;/p&gt;
&lt;p style="margin-left: 6px; line-height: 18px; margin-right: 6px; text-align: center"&gt;(2023年７月１日から&lt;/p&gt;
&lt;p style="margin-left: 6px; line-height: 18px; margin-right: 6px; text-align: center"&gt;  2023年９月30日まで)&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 163.13333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; line-height: 18px; margin-right: 6px; text-align: center"&gt;第30期&lt;/p&gt;
&lt;p style="margin-left: 6px; line-height: 18px; margin-right: 6px; text-align: center"&gt;(2022年10月１日から&lt;/p&gt;
&lt;p style="margin-left: 6px; line-height: 18px; margin-right: 6px; text-align: center"&gt;  2023年９月30日まで)&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/thead&gt;
&lt;tbody&gt;
&lt;tr style="height: 26.67px"&gt;
&lt;td style="vertical-align: middle; width: 324.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
