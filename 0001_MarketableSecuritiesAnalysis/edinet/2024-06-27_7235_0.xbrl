&lt;tr style="height: 24px"&gt;
&lt;td style="vertical-align: middle; width: 260.13333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 18px; text-align: left"&gt;セグメント利益&lt;/p&gt;
&lt;/td&gt;
