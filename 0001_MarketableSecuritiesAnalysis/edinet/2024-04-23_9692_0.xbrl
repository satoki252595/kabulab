&lt;colgroup&gt;
&lt;col style="width: 88.13333333333333333333333333px"/&gt;
&lt;col style="width: 88.13333333333333333333333333px"/&gt;
&lt;col style="width: 124.26666666666666666666666667px"/&gt;
&lt;col style="width: 124.26666666666666666666666667px"/&gt;
&lt;col style="width: 124.26666666666666666666666667px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr style="height: 40px"&gt;
&lt;td colspan="2" style="vertical-align: middle; width: 176.26666666666666666666666666px; padding-top: 1px; padding-bottom: 0px; padding-left: 1px; padding-right: 1px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt;データ年度&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 124.26666666666666666666666667px; padding-top: 1px; padding-bottom: 0px; padding-left: 1px; padding-right: 1px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt;2016年度&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 124.26666666666666666666666667px; padding-top: 1px; padding-bottom: 0px; padding-left: 1px; padding-right: 1px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt;2023年度&lt;/p&gt;
