&lt;p style="margin-left: 0px; margin-right: 0px; text-align: center; line-height: 13.333333333333333333333333333px"&gt;
&lt;span style="font-size: 10px"&gt;大&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 40px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 0px; margin-right: 0px; text-align: center; line-height: 13.333333333333333333333333333px"&gt;
&lt;span style="font-size: 10px"&gt;9&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td rowspan="2" style="border-left: 0px none ; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 0px none ; width: 130px; vertical-align: top; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 14px; margin-right: 4px; text-align: justify; line-height: 13.333333333333333333333333333px; text-justify: inter-ideograph; text-indent: -10px"&gt;
&lt;span style="font-size: 10px"&gt;・人命に関わるレベル&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td rowspan="3" style="border-left: 0px none ; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 130px; vertical-align: top; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 14px; margin-right: 4px; text-align: justify; line-height: 13.333333333333333333333333333px; text-justify: inter-ideograph; text-indent: -10px"&gt;
&lt;span style="font-size: 10px"&gt;・全事業所での活動停止レベル&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 14px; margin-right: 4px; text-align: justify; line-height: 13.333333333333333333333333333px; text-justify: inter-ideograph; text-indent: -10px"&gt;
&lt;span style="font-size: 10px"&gt;・営業所単位での活動停止レベル&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td rowspan="3" style="border-left: 0px none ; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 130px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 14px; margin-right: 4px; text-align: left; line-height: 13.333333333333333333333333333px; text-indent: -10px"&gt;
&lt;span style="font-size: 10px"&gt;・新聞、テレビ等の主要マスメディアで全国的に報道されるレベル&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 14px; margin-right: 4px; text-align: left; line-height: 13.333333333333333333333333333px; text-indent: -10px"&gt;
&lt;span style="font-size: 10px"&gt;・消費者団体等にボイコット（不買）運動されるレベル&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td rowspan="3" style="border-left: 0px none ; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 130px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 4px; margin-right: 4px; text-align: center; line-height: 13.333333333333333333333333333px"&gt;
&lt;span style="font-size: 10px"&gt;５％以上&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 21.33px"&gt;
