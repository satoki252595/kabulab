&lt;td colspan="2" rowspan="3" style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 80px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 4px; margin-right: 4px; text-align: center; line-height: 13.333333333333333333333333333px"&gt;
&lt;span style="font-size: 10px"&gt;影響度&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td colspan="4" style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 520px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 4px; margin-right: 4px; text-align: center; line-height: 13.333333333333333333333333333px"&gt;
&lt;span style="font-size: 10px"&gt;評価の目安&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 21.33px"&gt;
&lt;td colspan="3" style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 390px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 4px; margin-right: 4px; text-align: center; line-height: 13.333333333333333333333333333px"&gt;
&lt;span style="font-size: 10px"&gt;定性評価&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 130px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 4px; margin-right: 4px; text-align: center; line-height: 13.333333333333333333333333333px"&gt;
&lt;span style="font-size: 10px"&gt;定量評価&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 44px"&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 130px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 4px; margin-right: 4px; text-align: center; line-height: 13.333333333333333333333333333px"&gt;
&lt;span style="font-size: 10px"&gt;人の安全・衛生&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 130px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 4px; margin-right: 4px; text-align: center; line-height: 13.333333333333333333333333333px"&gt;
&lt;span style="font-size: 10px"&gt;民事・刑事・行政上の処分&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 130px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 4px; margin-right: 4px; text-align: center; line-height: 13.333333333333333333333333333px"&gt;
&lt;span style="font-size: 10px"&gt;社会的批判&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 130px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 4px; margin-right: 4px; text-align: center; line-height: 13.333333333333333333333333333px"&gt;
&lt;span style="font-size: 10px"&gt;営業利益の&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 4px; margin-right: 4px; text-align: center; line-height: 13.333333333333333333333333333px"&gt;
&lt;span style="font-size: 10px"&gt;計画に対する&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 4px; margin-right: 4px; text-align: center; line-height: 13.333333333333333333333333333px"&gt;
&lt;span style="font-size: 10px"&gt;損失の割合&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 21.33px"&gt;
&lt;td rowspan="3" style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 40px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 0px; margin-right: 0px; text-align: center; line-height: 13.333333333333333333333333333px"&gt;
&lt;span style="font-size: 10px"&gt;大&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 40px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 0px; margin-right: 0px; text-align: center; line-height: 13.333333333333333333333333333px"&gt;
