&lt;p style="margin-left: 0px; margin-right: 0px; text-align: center; line-height: 13.333333333333333333333333333px"&gt;
&lt;span style="font-size: 10px"&gt;8&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 21.33px"&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 40px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 0px; margin-right: 0px; text-align: center; line-height: 13.333333333333333333333333333px"&gt;
&lt;span style="font-size: 10px"&gt;7&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 130px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 14px; margin-right: 4px; text-align: left; line-height: 13.333333333333333333333333333px; text-indent: -10px"&gt;
&lt;span style="font-size: 10px"&gt;・重傷レベル&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 21.33px"&gt;
&lt;td rowspan="3" style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 40px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 0px; margin-right: 0px; text-align: center; line-height: 13.333333333333333333333333333px"&gt;
&lt;span style="font-size: 10px"&gt;中&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 40px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 0px; margin-right: 0px; text-align: center; line-height: 13.333333333333333333333333333px"&gt;
&lt;span style="font-size: 10px"&gt;6&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 0px none ; width: 130px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 14px; margin-right: 4px; text-align: left; line-height: 13.333333333333333333333333333px; text-indent: -10px"&gt;
&lt;span style="font-size: 10px"&gt;・軽傷レベル&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td rowspan="3" style="border-left: 0px none ; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 130px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 14px; margin-right: 4px; text-align: left; line-height: 13.333333333333333333333333333px; text-indent: -10px"&gt; &lt;/p&gt;
&lt;p style="margin-left: 14px; margin-right: 4px; text-align: left; line-height: 13.333333333333333333333333333px; text-indent: -10px"&gt;
&lt;span style="font-size: 10px"&gt;・活動停止には至らないレベル（改善命令・罰金レベル）&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td rowspan="3" style="border-left: 0px none ; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 130px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 14px; margin-right: 4px; text-align: left; line-height: 13.333333333333333333333333333px; text-indent: -10px"&gt;
&lt;span style="font-size: 10px"&gt;・一部メディア、地域で報道されるレベル&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 14px; margin-right: 4px; text-align: left; line-height: 13.333333333333333333333333333px; text-indent: -10px"&gt;
&lt;span style="font-size: 10px"&gt;・苦情、問合せがコールセンターに多数寄せられるレベル&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td rowspan="3" style="border-left: 0px none ; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 130px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 4px; margin-right: 4px; text-align: center; line-height: 13.333333333333333333333333333px"&gt;
&lt;span style="font-size: 10px"&gt;１％以上&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 4px; margin-right: 4px; text-align: center; line-height: 13.333333333333333333333333333px"&gt;
&lt;span style="font-size: 10px"&gt;５％未満&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
