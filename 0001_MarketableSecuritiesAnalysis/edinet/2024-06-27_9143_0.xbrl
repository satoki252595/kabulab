&lt;td style="vertical-align: middle; width: 322.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;

&lt;p style="margin-left: 65px; line-height: 2.6666666666666666666666666667px; margin-right: 2.6666666666666666666666666667px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 12px"&gt; &lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 13.333333333333333333333333333px; margin-right: 2.6666666666666666666666666667px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;1977年１月　東京佐川急便㈱（現　佐川急便㈱）入社&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 13.333333333333333333333333333px; margin-right: 2.6666666666666666666666666667px; text-align: left; text-indent: -60px"&gt;
