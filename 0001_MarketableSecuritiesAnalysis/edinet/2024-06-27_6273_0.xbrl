&lt;/colgroup&gt;
&lt;tr style="height:13.5pt;min-height:13.5pt;"&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-color:#a9a9a9;border-right-color:#a9a9a9;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;"&gt; &lt;/p&gt;
&lt;/td&gt;
&lt;td colspan="2" style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-color:#a9a9a9;border-right-color:#a9a9a9;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;margin-top:1.5pt;"&gt;前連結会計年度&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;"&gt;(自 &lt;span&gt;2022年４月１日&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;margin-bottom:1.5pt;"&gt;　至 &lt;span&gt;2023年３月31日&lt;/span&gt;)&lt;/p&gt;
&lt;/td&gt;
&lt;td colspan="2" style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-color:#a9a9a9;border-right-color:#a9a9a9;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;margin-top:1.5pt;"&gt;当連結会計年度&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;"&gt;(自 &lt;span&gt;2023年４月１日&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;margin-bottom:1.5pt;"&gt;  至 &lt;span&gt;2024年３月31日&lt;/span&gt;)&lt;/p&gt;
