&lt;col style="width:60pt;min-width:60pt;"/&gt;
&lt;col style="width:59.3pt;min-width:59.3pt;"/&gt;
&lt;col style="width:53.4pt;min-width:53.4pt;"/&gt;
&lt;col style="width:1.5pt;min-width:1.5pt;"/&gt;
&lt;col style="width:60pt;min-width:60pt;"/&gt;
&lt;col style="width:60pt;min-width:60pt;"/&gt;
&lt;col style="width:54.8pt;min-width:54.8pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:37.5pt;min-height:37.5pt;"&gt;
&lt;td rowspan="2" style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;line-height:12pt;font-size:10.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;指標&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
