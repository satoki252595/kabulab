&lt;p class="style_pb_after" style="line-height: 1; text-align: left"&gt; &lt;/p&gt;
</jpcrp_cor:NotesRegardingNewShareSubscriptionRightsEtcTextBlock>
  <jpcrp_cor:NotesRegardingDividendTextBlock contextRef="CurrentYearDuration">
