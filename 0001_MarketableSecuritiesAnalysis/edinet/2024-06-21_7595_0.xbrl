&lt;td style="vertical-align: middle; width: 158.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 5px; line-height: 14px; margin-right: 2.3333333333333333333333333333px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;役員の兼任等－無&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;/div&gt;
&lt;p style="margin-left: 60px; line-height: 17.333333333333333333333333333px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;（注）１　特定子会社であります。&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 54px; line-height: 17.333333333333333333333333333px; text-align: left; text-indent: -24px"&gt;
&lt;span style="font-size: 10px"&gt;２　有価証券報告書を提出しております。&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 54px; line-height: 17.333333333333333333333333333px; text-align: left; text-indent: -24px"&gt;
&lt;span style="font-size: 10px"&gt;３　議決権所有割合の（　）内は間接所有の議決権の合計の割合を内書として記載しております。&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 58px; line-height: 17.333333333333333333333333333px; text-align: left; text-indent: -24px"&gt; &lt;/p&gt;
</jpcrp_cor:OverviewOfAffiliatedEntitiesTextBlock>
  <jpcrp_cor:InformationAboutEmployeesTextBlock contextRef="FilingDateInstant">
