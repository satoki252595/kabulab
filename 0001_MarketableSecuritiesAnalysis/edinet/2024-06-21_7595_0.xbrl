&lt;p style="line-height: 14.666666666666666666666666667px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;2023年７月&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 199.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 5px; line-height: 14.666666666666666666666666667px; margin-right: 2.3333333333333333333333333333px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;一般財団法人地方債協会　会長（現任）&lt;/span&gt;
&lt;/p&gt;
