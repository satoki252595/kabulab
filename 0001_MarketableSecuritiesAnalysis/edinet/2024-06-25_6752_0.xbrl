&lt;tr style="height: 16px"&gt;
&lt;td style="vertical-align: middle; width: 648px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 16px; margin-right: 12px; text-align: right"&gt;2024年３月31日現在&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;/div&gt;
&lt;p style="line-height: 16px; text-align: center"&gt;
&lt;img alt="0101010_001.png" src="images/0101010_001.png" style="height: 521px; width: 626.67px"/&gt;
&lt;/p&gt;
</jpcrp_cor:DescriptionOfBusinessTextBlock>
