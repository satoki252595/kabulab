&lt;/td&gt;
&lt;td style="vertical-align:middle;border-bottom-style:solid;border-bottom-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:25pt;"&gt;61百万円&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
