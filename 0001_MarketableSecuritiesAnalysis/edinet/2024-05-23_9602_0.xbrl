&lt;col style="width:70pt;min-width:70pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:13pt;min-height:13pt;"&gt;
&lt;td style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;"&gt;譲渡制限付株式報酬としての自己株式の処分による減少&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblR" style="orphans:0;widows:0;"&gt;11,318株&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:13pt;min-height:13pt;"&gt;
