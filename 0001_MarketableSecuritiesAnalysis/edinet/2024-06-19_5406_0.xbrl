&lt;p style="margin-left: 6px; line-height: 12.666666666666666666666666667px; margin-right: 6px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;全社資産（※）&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 173.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
