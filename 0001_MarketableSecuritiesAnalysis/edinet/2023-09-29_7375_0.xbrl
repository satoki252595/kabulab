&lt;td rowspan="2" style="vertical-align: middle; width: 68.4px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p class="text_align_justify" style="line-height: 14.666666666666666666666666667px"&gt;調整後&lt;/p&gt;
&lt;p class="text_align_justify" style="line-height: 14.666666666666666666666666667px"&gt;行使価額&lt;/p&gt;
