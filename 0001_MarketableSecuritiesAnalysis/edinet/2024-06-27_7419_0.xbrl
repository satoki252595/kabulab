  <jpcrp_cor:TotalNumberOfSharesTextBlock contextRef="FilingDateInstant">
&lt;h5 class="smt_head4" style="padding-left:27pt;"&gt;①  【株式の総数】&lt;/h5&gt;
&lt;div class="tbld" style="margin-left:34.5pt;margin-right:0.5pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:441.8pt;table-layout:fixed;"&gt;
