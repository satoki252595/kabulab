&lt;td style="vertical-align: middle; width: 100px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 16.666666666666666666666666667px; text-align: center"&gt;年月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 545px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 16.666666666666666666666666667px; text-align: center"&gt;沿革&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/thead&gt;
&lt;tbody&gt;
&lt;tr style="height: 133.33px"&gt;
&lt;td style="vertical-align: top; width: 100px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 16.666666666666666666666666667px; text-align: center"&gt;2012年４月&lt;/p&gt;
&lt;p style="line-height: 16.666666666666666666666666667px; text-align: center"&gt;2012年８月&lt;/p&gt;
&lt;p style="line-height: 16.666666666666666666666666667px; text-align: center"&gt;2013年４月&lt;/p&gt;
&lt;p style="line-height: 16.666666666666666666666666667px; text-align: center"&gt;2013年７月&lt;/p&gt;
&lt;p style="line-height: 16.666666666666666666666666667px; text-align: center"&gt;2014年７月&lt;/p&gt;
&lt;p style="line-height: 16.666666666666666666666666667px; text-align: center"&gt; &lt;/p&gt;
&lt;p style="line-height: 16.666666666666666666666666667px; text-align: center"&gt;2014年８月&lt;/p&gt;
&lt;p style="line-height: 16.666666666666666666666666667px; text-align: center"&gt;2019年４月&lt;/p&gt;
&lt;p style="line-height: 16.666666666666666666666666667px; text-align: center"&gt;2021年９月&lt;/p&gt;
&lt;p style="line-height: 16.666666666666666666666666667px; text-align: center"&gt;2021年10月&lt;/p&gt;
&lt;p style="line-height: 16.666666666666666666666666667px; text-align: center"&gt;2022年４月&lt;/p&gt;
