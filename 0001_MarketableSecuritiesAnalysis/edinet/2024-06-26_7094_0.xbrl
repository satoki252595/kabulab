&lt;h5 class="smt_head4" style="padding-left:9pt;"&gt;②　単価情報&lt;/h5&gt;
&lt;div class="tbld" style="margin-left:21pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:348.8pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
&lt;col style="width:168pt;min-width:168pt;"/&gt;
