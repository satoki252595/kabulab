&lt;p style="margin-left: 65px; line-height: 14.666666666666666666666666667px; margin-right: 3px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;1979年11月　株式会社シスコン　入社&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 14.666666666666666666666666667px; margin-right: 3px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;1988年５月　株式会社ビィエスシィ　入社&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 14.666666666666666666666666667px; margin-right: 3px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;1990年１月　株式会社システムイオ設立　取締役&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 14.666666666666666666666666667px; margin-right: 3px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;2003年12月　同社　代表取締役社長&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 14.666666666666666666666666667px; margin-right: 3px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;2004年６月　株式会社NetValue　取締役会長（現任）&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 14.666666666666666666666666667px; margin-right: 3px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;2007年９月　株式会社ビーガル　取締役会長&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 14.666666666666666666666666667px; margin-right: 3px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;2009年12月　当社　代表取締役社長&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 14.666666666666666666666666667px; margin-right: 3px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;2012年12月　株式会社システムイオ　代表取締役会長&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 14.666666666666666666666666667px; margin-right: 3px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;2017年２月　株式会社システムイオ　取締役会長（現任）&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 14.666666666666666666666666667px; margin-right: 3px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;2018年10月　７ベルティーピー株式会社　代表取締役社長（現任）&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 14.666666666666666666666666667px; margin-right: 3px; text-align: left; text-indent: -60px"&gt;
