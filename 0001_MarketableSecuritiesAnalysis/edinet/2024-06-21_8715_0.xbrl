&lt;div style="text-align:center;"&gt;&lt;img alt="" height="242" src="fuzoku/songai.png" width="269"/&gt;&lt;br/&gt;
&lt;/div&gt;
&lt;/td&gt;
&lt;td style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;
&lt;div style="text-align:center;"&gt;&lt;img alt="" height="242" src="fuzoku/comb.png" width="269"/&gt;&lt;br/&gt;
&lt;/div&gt;
