</jpcrp030000-asr_E34276-000:MetricsAndTargetsTextBlock>
  <jpcrp030000-asr_E34276-000:DescriptionOfMetricsRelatedToPolicyOnHumanResourceDevelopmentAndImprovementOfInternalEnvironmentAndTargetsAndResultsUsingSuchMetricsMetricsAndTargetsTextBlock contextRef="FilingDateInstant">
