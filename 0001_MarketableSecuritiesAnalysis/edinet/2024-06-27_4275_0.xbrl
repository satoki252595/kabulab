&lt;tr&gt;
&lt;td style="vertical-align: middle; width: 624px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: right"&gt;（単位：百万円）&lt;/p&gt;
