  <jpcrp_cor:NotesBusinessCombinationsConsolidatedFinancialStatementsTextBlock contextRef="CurrentYearDuration">
&lt;h6 class="smt_head5" style="padding-left:18pt;"&gt;(企業結合等関係)&lt;/h6&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;"&gt; &lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;"&gt;　　　該当事項はありません。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;"&gt; &lt;/p&gt;</jpcrp_cor:NotesBusinessCombinationsConsolidatedFinancialStatementsTextBlock>
  <jpcrp_cor:NotesAssetRetirementObligationsConsolidatedFinancialStatementsTextBlock contextRef="CurrentYearDuration">
&lt;h6 class="smt_head5" style="padding-left:18pt;"&gt;(資産除去債務関係)&lt;/h6&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;"&gt; &lt;/p&gt;&lt;p class="smt_text3" style="orphans:0;widows:0;"&gt;重要性がないため記載を省略しております。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;"&gt; &lt;/p&gt;</jpcrp_cor:NotesAssetRetirementObligationsConsolidatedFinancialStatementsTextBlock>
