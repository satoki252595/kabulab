&lt;p style="text-align: left"&gt; &lt;/p&gt;
</jpcrp030000-asr_E01031-000:RiskManagementTextBlock>
  <jpcrp030000-asr_E01031-000:MetricsAndTargetsTextBlock contextRef="FilingDateInstant">
