&lt;p style="margin-right: 6px; text-align: right"&gt;11,028&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 99.2px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 3px double #000000"&gt;
&lt;p style="margin-right: 6px; text-align: right"&gt;33,680&lt;/p&gt;
&lt;/td&gt;
