&lt;/td&gt;
&lt;td style="vertical-align:top;border-bottom-color:#a9a9a9;border-left-style:solid;border-left-width:0.75pt;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:4.8pt;padding-right:4.8pt;font-size:7.5pt;"&gt;&lt;span style="font-size:7.5pt;"&gt;陸上自衛隊入隊&lt;/span&gt;&lt;/p&gt;
