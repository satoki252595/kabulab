&lt;tbody&gt;
&lt;tr style="height: 30px"&gt;
&lt;td style="vertical-align: middle; width: 173px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 12px; line-height: 13.333333333333333333333333333px; text-align: left"&gt;帳簿価額&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 85px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;のれん&lt;/p&gt;
&lt;/td&gt;
