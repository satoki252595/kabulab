  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E00492-000InadaNobuoMember">1956-08-14</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
