&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr style="height: 20px"&gt;
&lt;td rowspan="3" style="vertical-align: middle; width: 54px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 14px; text-align: center"&gt; &lt;/p&gt;
&lt;p style="line-height: 14px; text-align: center"&gt;調整後&lt;/p&gt;
&lt;p style="line-height: 14px; text-align: center"&gt;払込金額&lt;/p&gt;
