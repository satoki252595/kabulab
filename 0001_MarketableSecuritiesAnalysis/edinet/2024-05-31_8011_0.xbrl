&lt;colgroup&gt;
&lt;col style="width: 143.73333333333333333333333333px"/&gt;
&lt;col style="width: 139.86666666666666666666666667px"/&gt;
&lt;col style="width: 139.86666666666666666666666667px"/&gt;
&lt;col style="width: 142.86666666666666666666666667px"/&gt;
&lt;/colgroup&gt;
