&lt;/tr&gt;
&lt;tr style="height: 1.33px"&gt;
&lt;td style="vertical-align: top; width: 96px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="text-align: center"&gt;2013年３月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 552px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; margin-right: 4px; text-align: left"&gt;ネットイヤークラフト株式会社がネットイヤーモビー株式会社を吸収合併&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 1.33px"&gt;
&lt;td style="vertical-align: top; width: 96px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="text-align: center"&gt;2013年８月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 552px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; margin-right: 4px; text-align: left"&gt;クラウド領域における開発力の強化とプロダクト事業領域の強化を目的として、株式会社日本技芸の株式を取得し子会社化&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 18px"&gt;
&lt;td style="vertical-align: top; width: 96px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="text-align: center"&gt;2014年２月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 552px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; margin-right: 4px; text-align: left"&gt;本社を東京都中央区銀座に移転&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 72px"&gt;
&lt;td style="vertical-align: top; width: 96px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="text-align: center"&gt;2014年４月&lt;/p&gt;
&lt;p style="text-align: center"&gt;2015年11月&lt;/p&gt;
&lt;p style="text-align: center"&gt;2016年３月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 552px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; margin-right: 4px; text-align: left"&gt;ネットイヤーゼロ株式会社を吸収合併&lt;/p&gt;
&lt;p style="margin-left: 6px; margin-right: 4px; text-align: left"&gt;株式会社日本技芸の商号をrakumo株式会社に変更&lt;/p&gt;
&lt;p style="margin-left: 6px; margin-right: 4px; text-align: left"&gt;主要株主である筆頭株主がＴＩＳ株式会社からコニカミノルタビジネスソリューションズ株式会社（現　コニカミノルタジャパン㈱）へ異動&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 18px"&gt;
&lt;td style="vertical-align: top; width: 96px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="text-align: center"&gt;2016年12月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 552px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; margin-right: 4px; text-align: left"&gt;ネットイヤークラフト株式会社を吸収合併&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 18px"&gt;
&lt;td style="vertical-align: top; width: 96px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="text-align: center"&gt;2017年８月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 552px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; margin-right: 4px; text-align: left"&gt;rakumo株式会社の全株式を売却&lt;/p&gt;
