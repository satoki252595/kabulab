  <jpcrp_cor:InformationAboutOfficersTextBlock contextRef="FilingDateInstant">&lt;p style="page-break-before:always; line-height:0.75pt; width:100%; font-size:0.75pt;"&gt; &lt;/p&gt;
&lt;h3 class="smt_head3" style="padding-left:13.5pt;"&gt;(2) 【役員の状況】&lt;/h3&gt;&lt;p class="smt_head6" style="orphans:0;widows:0;"&gt;　　①役員一覧&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;"&gt;　男性9名　女性0名　（役員のうち女性の比率0.0％）&lt;/p&gt;
&lt;div class="tbld" style="margin-left:0pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:470.4pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
