&lt;col style="width:16.5pt;min-width:16.5pt;"/&gt;
&lt;col style="width:57.8pt;min-width:57.8pt;"/&gt;
&lt;col style="width:16.5pt;min-width:16.5pt;"/&gt;
&lt;col style="width:54pt;min-width:54pt;"/&gt;
