&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 101.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;
&lt;p style="line-height: 15px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;1951年２月21日&lt;/span&gt;&lt;span style="font-size: 10px"&gt;生&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 232px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;

&lt;p style="margin-left: 60px; line-height: 14.666666666666666666666666667px; margin-right: 5px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;1975年６月 津島町農業協同組合（現えひめ南農業協同組合）入組&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; line-height: 14.666666666666666666666666667px; margin-right: 5px; text-align: left; text-indent: -55px"&gt;
