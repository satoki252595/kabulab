&lt;div class="tbld" style="margin-left:0pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:483pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
&lt;col style="width:51.8pt;min-width:51.8pt;"/&gt;
&lt;col style="width:47.3pt;min-width:47.3pt;"/&gt;
&lt;col style="width:62.3pt;min-width:62.3pt;"/&gt;
&lt;col style="width:240pt;min-width:240pt;"/&gt;
&lt;col style="width:31.5pt;min-width:31.5pt;"/&gt;
