&lt;/colgroup&gt;
&lt;tr style="height:30.7pt;min-height:30.7pt;"&gt;
&lt;td rowspan="2" style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;"&gt;セグメントの名称&lt;/p&gt;
&lt;/td&gt;
&lt;td colspan="3" style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;"&gt;当事業年度&lt;/p&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;padding-right:4.5pt;"&gt;(自　&lt;span&gt;2023年４月１日&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;padding-left:4.6pt;"&gt;至　&lt;span&gt;2024年３月31日&lt;/span&gt;)&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:21.8pt;min-height:21.8pt;"&gt;
