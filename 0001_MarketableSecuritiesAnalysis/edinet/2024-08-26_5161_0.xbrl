&lt;/tr&gt;
&lt;tr style="height:21pt;min-height:21pt;"&gt;
&lt;td style="vertical-align:top;border-top-color:#a9a9a9;border-bottom-color:#a9a9a9;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;line-height:11pt;font-size:7.5pt;"&gt;2006年６月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:top;border-top-color:#a9a9a9;border-bottom-color:#a9a9a9;border-left-style:solid;border-left-width:0.75pt;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:5.4pt;padding-right:5.4pt;line-height:11pt;font-size:7.5pt;"&gt;あずさ監査法人(現 有限責任 あずさ監査法人)&lt;br/&gt;退所&lt;/p&gt;
&lt;/td&gt;
