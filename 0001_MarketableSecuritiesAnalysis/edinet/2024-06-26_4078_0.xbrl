  <jpcrp_cor:NotesRegardingGuaranteeObligationsTextBlock contextRef="CurrentYearInstant">
&lt;p style="margin-left: 18px; line-height: 14px; margin-right: 3.3333333333333333333333333333px; text-align: left"&gt;２　保証債務&lt;/p&gt;
&lt;p style="margin-left: 42px; margin-right: 3.3333333333333333333333333333px; margin-bottom: 4px; margin-top: 4px; text-align: left"&gt;次の銀行借入に対し、保証を行っております。&lt;/p&gt;
&lt;div style="margin-left: 42px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 590.66666666666666666666666667px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 206.66666666666666666666666667px"/&gt;
