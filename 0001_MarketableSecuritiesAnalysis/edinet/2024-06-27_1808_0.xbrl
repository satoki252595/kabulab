&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#f2f2f2;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#f2f2f2;border-left-style:solid;border-left-width:0.75pt;border-left-color:#f2f2f2;border-right-style:solid;border-right-width:0.75pt;border-right-color:#f2f2f2;background-color:#ffffff;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:right;"&gt;&lt;span style="font-family:&amp;apos;ＭＳ ゴシック&amp;apos;;font-size:9pt;"&gt;30.5&lt;/span&gt;&lt;/p&gt;
