  <jpcrp_cor:NotesRegardingGuaranteeObligationsTextBlock contextRef="CurrentYearInstant">&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:9pt;"&gt;３  保証債務&lt;/p&gt;
