  <jpcrp_cor:InformationAboutEmployeesTextBlock contextRef="FilingDateInstant">
&lt;h3 class="smt_head2"&gt;５ 【従業員の状況】&lt;/h3&gt;
&lt;h4 class="smt_head3"&gt;(1) 連結会社の状況&lt;/h4&gt;&lt;p class="smt_unitR" style="orphans:0;widows:0;text-align:right;padding-left:0pt;padding-right:1.5pt;"&gt;&lt;span&gt;2024年３月31日&lt;/span&gt;現在&lt;/p&gt;
&lt;div class="tbld" style="margin-left:14pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:468pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
&lt;col style="width:234pt;min-width:234pt;"/&gt;
