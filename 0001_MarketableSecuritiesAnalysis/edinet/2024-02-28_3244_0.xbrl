&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;line-height:8.5pt;font-size:7.5pt;"&gt;&lt;span style="font-size:7.5pt;"&gt;事業の内容&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:7.5pt;"&gt;又は職業&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;line-height:8.5pt;font-size:7.5pt;"&gt;&lt;span style="font-size:7.5pt;"&gt;議決権等&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:7.5pt;"&gt;の所有&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:7.5pt;"&gt;(被所有)&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:7.5pt;"&gt;割合(％)&lt;/span&gt;&lt;/p&gt;
