  <jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E00884-000HiguchiAkinoriMember">樋口　章憲</jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E00884-000HiguchiAkinoriMember">1959-11-07</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock contextRef="FilingDateInstant_jpcrp030000-asr_E00884-000HiguchiAkinoriMember">
&lt;p style="margin-left: 65px; line-height: 14.666666666666666666666666667px; margin-right: 5px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;1984年４月  当社入社&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 14.666666666666666666666666667px; margin-right: 5px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;1984年10月　サンノプコ㈱出向&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 14.666666666666666666666666667px; margin-right: 5px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;2005年10月　同社第１営業部長&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 14.666666666666666666666666667px; margin-right: 5px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;2012年６月　同社代表取締役社長兼営業総括部長&lt;/span&gt;
&lt;/p&gt;
