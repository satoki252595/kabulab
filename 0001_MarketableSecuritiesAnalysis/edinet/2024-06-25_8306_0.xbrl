&lt;td colspan="2" style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-color:#a9a9a9;border-right-color:#a9a9a9;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;letter-spacing:0pt;line-height:10pt;"&gt;当事業年度&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;letter-spacing:0pt;line-height:10pt;"&gt;(&lt;span&gt;2024年3月31日&lt;/span&gt;)&lt;/p&gt;
