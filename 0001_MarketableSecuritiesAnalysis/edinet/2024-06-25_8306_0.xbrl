&lt;col style="width:48pt;min-width:48pt;"/&gt;
&lt;col style="width:95pt;min-width:95pt;"/&gt;
&lt;col style="width:62.5pt;min-width:62.5pt;"/&gt;
&lt;col style="width:80pt;min-width:80pt;"/&gt;
