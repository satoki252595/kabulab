&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#ffffff;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#ffffff;border-left-style:solid;border-left-width:0.75pt;border-left-color:#ffffff;border-right-style:solid;border-right-width:0.75pt;border-right-color:#ffffff;background-color:#d7e3bc;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;"&gt;&lt;span style="font-size:6pt;"&gt;5年～&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
