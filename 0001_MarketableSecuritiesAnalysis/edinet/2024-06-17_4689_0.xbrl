  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditorsProposal contextRef="FilingDateInstant_jpcrp030000-asr_E05000-000TakahashiYukoMember">1965-12-19</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditorsProposal>
  <jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsProposalTextBlock contextRef="FilingDateInstant_jpcrp030000-asr_E05000-000TakahashiYukoMember">&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:32.7pt;text-justify:inter-ideograph;text-indent:-28.2pt;"&gt;&lt;span style="font-size:7.5pt;"&gt;1992年10月　センチュリー監査法人(現有限責任 &lt;/span&gt;&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:justify;padding-left:32.7pt;padding-right:4.5pt;margin-top:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:-28.2pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:10pt;font-size:9pt;"&gt;&lt;span style="font-size:7.5pt;"&gt;            あずさ監査法人)入所&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;line-height:9.5pt;font-size:9pt;"&gt;&lt;span style="font-size:7.5pt;"&gt;1996年４月　公認会計士登録&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;line-height:9.5pt;font-size:9pt;"&gt;&lt;span style="font-size:7.5pt;"&gt;2001年２月  ㈱電通入社&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;line-height:9.5pt;font-size:9pt;"&gt;&lt;span style="font-size:7.5pt;"&gt;2017年１月  同社経理局局長&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;line-height:9.5pt;font-size:9pt;"&gt;&lt;span style="font-size:7.5pt;"&gt;2020年１月　㈱電通グループ　執行役員&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;line-height:9.5pt;font-size:9pt;"&gt;&lt;span style="font-size:7.5pt;"&gt;2021年７月　髙橋祐子公認会計士事務所開設&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:7.5pt;"&gt;            (現任)&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;line-height:9.5pt;font-size:9pt;"&gt;&lt;span style="font-size:7.5pt;"&gt;2022年１月  17LIVE㈱ 社外監査役(現任)&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;line-height:9.5pt;font-size:9pt;"&gt;&lt;span style="font-size:7.5pt;"&gt;2022年３月  ㈱電通グループ 取締役&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;line-height:9.5pt;font-size:9pt;"&gt;&lt;span style="font-size:7.5pt;"&gt;2023年３月  ヒューリック㈱ 社外取締役　　　&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:7.5pt;"&gt;　　　　　  (現任)　　　　　　　&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:4.5pt;padding-right:4.5pt;margin-top:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:9.5pt;font-size:7.5pt;"&gt;2023年６月　マイクロ波化学㈱ 社外取締役&lt;br/&gt;　　　　　　(監査等委員)(現任)&lt;/p&gt;</jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsProposalTextBlock>
