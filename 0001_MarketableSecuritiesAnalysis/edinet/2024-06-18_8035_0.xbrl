&lt;/td&gt;
&lt;td style="vertical-align: top; width: 267.53333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 5px; line-height: 12.666666666666666666666666667px; margin-right: 3px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;当社TPS BUGM&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 1.33px"&gt;
&lt;td style="vertical-align: top; width: 54.666666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 12.666666666666666666666666667px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt; &lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 267.53333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 5px; line-height: 12.666666666666666666666666667px; margin-right: 3px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;当社SD BUGM&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
