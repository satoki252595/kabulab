&lt;td style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:5.4pt;padding-right:5.4pt;margin-bottom:0.0pt;font-size:10.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;議決権行使&lt;/span&gt;&lt;/p&gt;
