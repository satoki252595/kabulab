&lt;col style="width:36pt;min-width:36pt;"/&gt;
&lt;col style="width:44.6pt;min-width:44.6pt;"/&gt;
&lt;col style="width:36pt;min-width:36pt;"/&gt;
&lt;col style="width:42pt;min-width:42pt;"/&gt;
