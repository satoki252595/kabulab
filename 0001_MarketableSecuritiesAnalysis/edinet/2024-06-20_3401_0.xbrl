&lt;p style="line-height: 16px; margin-right: 11.333333333333333333333333333px; text-align: right"&gt;1991年10月&lt;/p&gt;
&lt;p style="line-height: 16px; margin-right: 11.333333333333333333333333333px; text-align: right"&gt; &lt;/p&gt;
&lt;p style="line-height: 16px; margin-right: 11.333333333333333333333333333px; text-align: right"&gt;1994年 3月&lt;/p&gt;
&lt;p style="line-height: 16px; margin-right: 11.333333333333333333333333333px; text-align: right"&gt;1995年10月&lt;/p&gt;
&lt;p style="line-height: 16px; margin-right: 11.333333333333333333333333333px; text-align: right"&gt;1997年 5月&lt;/p&gt;
&lt;p style="line-height: 16px; margin-right: 11.333333333333333333333333333px; text-align: right"&gt;1999年10月&lt;/p&gt;
&lt;p style="line-height: 16px; margin-right: 11.333333333333333333333333333px; text-align: right"&gt;2000年 1月&lt;/p&gt;
&lt;p style="line-height: 16px; margin-right: 11.333333333333333333333333333px; text-align: right"&gt; &lt;/p&gt;
