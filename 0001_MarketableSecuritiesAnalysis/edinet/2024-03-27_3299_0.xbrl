&lt;col style="width:156.8pt;min-width:156.8pt;"/&gt;
&lt;col style="width:129pt;min-width:129pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:22.5pt;min-height:22.5pt;"&gt;
