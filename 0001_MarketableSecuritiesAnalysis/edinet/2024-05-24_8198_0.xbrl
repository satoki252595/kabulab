&lt;p style="line-height: 9.333333333333333333333333333px; margin-right: 6px; text-align: left"&gt; &lt;/p&gt;
&lt;p style="margin-left: 45px; line-height: 12px; margin-right: 6px; text-align: left"&gt; &lt;/p&gt;
