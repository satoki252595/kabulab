&lt;td style="vertical-align: top; width: 77.333333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 6.6666666666666666666666666667px; text-align: right"&gt;1,296&lt;/p&gt;
