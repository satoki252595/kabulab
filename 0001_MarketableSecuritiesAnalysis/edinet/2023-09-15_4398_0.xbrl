  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E34288-000TakizawaTakashiMember">1966-06-15</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
