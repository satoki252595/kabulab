&lt;td style="vertical-align:top;border-top-color:#a9a9a9;border-bottom-color:#a9a9a9;border-left-color:#a9a9a9;border-right-color:#a9a9a9;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:4.8pt;padding-right:4.8pt;line-height:11pt;font-size:7.5pt;"&gt;同社顧問&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
