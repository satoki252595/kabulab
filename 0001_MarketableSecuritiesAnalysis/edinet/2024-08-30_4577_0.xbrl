&lt;td colspan="2" style="vertical-align: middle; width: 217.33333333333333333333333334px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;当連結会計年度&lt;/p&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; margin-right: 12px; text-align: center"&gt;（自　2023年６月１日&lt;/p&gt;
&lt;p style="margin-left: 12px; line-height: 13.333333333333333333333333333px; text-align: center"&gt;至　2024年５月31日）&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 26.67px"&gt;
&lt;td style="vertical-align: middle; width: 114.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
