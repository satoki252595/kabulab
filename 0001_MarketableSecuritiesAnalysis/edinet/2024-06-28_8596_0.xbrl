&lt;h6 class="smt_head5"&gt;（当事業年度において株式数が減少した銘柄）&lt;/h6&gt;
&lt;div class="tbld" style="margin-left:35pt;margin-right:0pt;margin-top:2.5pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:296.3pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
&lt;col style="width:123.8pt;min-width:123.8pt;"/&gt;
&lt;col style="width:60pt;min-width:60pt;"/&gt;
&lt;col style="width:112.5pt;min-width:112.5pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:24pt;min-height:24pt;"&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:0pt;"&gt; &lt;/p&gt;
&lt;/td&gt;
