&lt;col style="width:159.4pt;min-width:159.4pt;"/&gt;
&lt;col style="width:81.7pt;min-width:81.7pt;"/&gt;
&lt;col style="width:70.9pt;min-width:70.9pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr&gt;
