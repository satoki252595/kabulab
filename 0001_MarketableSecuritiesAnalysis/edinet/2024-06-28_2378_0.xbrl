&lt;col style="width:14.9pt;min-width:14.9pt;"/&gt;
&lt;col style="width:39pt;min-width:39pt;"/&gt;
&lt;col style="width:14.9pt;min-width:14.9pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:18pt;min-height:18pt;"&gt;
