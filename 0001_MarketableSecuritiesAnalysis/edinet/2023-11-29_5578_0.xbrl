&lt;td colspan="3" style="vertical-align: middle; width: 153.33333333333333333333333334px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 10.8px; line-height: 18px; margin-right: 10.8px; text-align: center"&gt;既発行株式数&lt;/p&gt;
