&lt;tr style="height: 1.33px"&gt;
&lt;td style="vertical-align: top; width: 100.2px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: center"&gt;2017年３月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 551.2px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: left"&gt;中日本方面の業務拡大を目的とし、愛知県名古屋市中村区名駅に名古屋支社を開設&lt;/p&gt;
&lt;/td&gt;
