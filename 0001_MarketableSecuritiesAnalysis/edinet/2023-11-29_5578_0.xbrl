&lt;tr style="height: 1.33px"&gt;
&lt;td style="vertical-align: top; width: 100.2px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: center"&gt;2017年８月&lt;/p&gt;
