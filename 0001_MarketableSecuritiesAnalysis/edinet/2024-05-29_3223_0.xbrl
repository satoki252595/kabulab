&lt;col style="width:45.3pt;min-width:45.3pt;"/&gt;
&lt;col style="width:46pt;min-width:46pt;"/&gt;
&lt;col style="width:44.2pt;min-width:44.2pt;"/&gt;
&lt;col style="width:45.3pt;min-width:45.3pt;"/&gt;
