&lt;p style="margin-left: 6px; margin-right: 6px; text-align: left"&gt;不動産賃貸等&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;/div&gt;

</jpcrp_cor:DescriptionOfReportableSegmentsTextBlock>
