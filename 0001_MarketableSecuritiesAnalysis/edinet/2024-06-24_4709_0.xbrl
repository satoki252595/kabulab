&lt;td style="vertical-align: middle; width: 231.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 3px double #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 23.333333333333333333333333333px; margin-right: 3.3333333333333333333333333333px; text-align: left"&gt;合計&lt;/p&gt;
