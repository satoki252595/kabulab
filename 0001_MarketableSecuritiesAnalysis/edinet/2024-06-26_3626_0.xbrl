&lt;p style="margin-right: 3.3333333333333333333333333333px; text-align: center"&gt;為替予約&lt;/p&gt;
&lt;p style="margin-right: 3.3333333333333333333333333333px; text-align: center"&gt;通貨スワップ&lt;/p&gt;
&lt;p style="margin-right: 3.3333333333333333333333333333px; text-align: center"&gt;金利スワップ&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 24px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-right: 3.3333333333333333333333333333px; text-align: left"&gt;
