&lt;td style="vertical-align:top;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:5.7pt;padding-right:5.7pt;margin-top:1.5pt;margin-bottom:1.5pt;letter-spacing:0pt;line-height:11pt;font-size:7.5pt;"&gt;同代表取締役社長&lt;/p&gt;
