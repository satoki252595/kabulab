&lt;td style="vertical-align: top; width: 92px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 1; text-align: center"&gt;2024年４月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 556px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; line-height: 1; margin-right: 4px; text-align: left"&gt;連結子会社(株)サムシングが所有する(株)アースプライムの全株式を取得し直接子会社化&lt;/p&gt;
&lt;/td&gt;
