&lt;colgroup&gt;
&lt;col style="width: 267.13333333333333333333333333px"/&gt;
&lt;col style="width: 267.13333333333333333333333333px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr style="height: 18.33px"&gt;
