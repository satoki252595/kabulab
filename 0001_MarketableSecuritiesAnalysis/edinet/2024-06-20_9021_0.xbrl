&lt;p style="line-height: 1.3333333333333333333333333333px; text-align: center"&gt;　&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 36px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;
&lt;p style="text-align: center"&gt;
注３
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 52px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;
&lt;p style="margin-right: 6px; text-align: right"&gt;
700
&lt;/p&gt;
&lt;/td&gt;
