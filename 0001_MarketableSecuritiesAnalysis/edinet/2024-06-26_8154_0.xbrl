&lt;p style="margin-left: 5px; line-height: 11.333333333333333333333333333px; margin-right: 3px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;当期末残高&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 60px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 11.333333333333333333333333333px; margin-right: 5px; text-align: right"&gt;
&lt;span style="font-size: 10px"&gt;2,760&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 60px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 11.333333333333333333333333333px; margin-right: 5px; text-align: right"&gt;
&lt;span style="font-size: 10px"&gt;19&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 60px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 11.333333333333333333333333333px; margin-right: 5px; text-align: right"&gt;
&lt;span style="font-size: 10px"&gt;2,780&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 60px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 11.333333333333333333333333333px; margin-right: 5px; text-align: right"&gt;
&lt;span style="font-size: 10px"&gt;60,300&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
