&lt;p style="margin-left: 5px; margin-right: 6px; text-align: justify; line-height: 16px; text-justify: inter-ideograph"&gt;
&lt;span style="font-size: 10px"&gt;５・８・10&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 168px; vertical-align: top; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 15.666666666666666666666666667px; margin-right: 6px; text-align: justify; line-height: 16px; text-justify: inter-ideograph; text-indent: -10.666666666666666666666666667px"&gt;
