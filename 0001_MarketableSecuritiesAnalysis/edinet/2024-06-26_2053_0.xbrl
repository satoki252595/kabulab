  <jpcrp_cor:RevenuesFromExternalCustomersInformationForEachRegionTextBlock contextRef="CurrentYearDuration">
&lt;p style="margin-left: 63px; line-height: 19.333333333333333333333333333px; text-align: left"&gt;
&lt;span style="font-size: 14px"&gt;(1）売上高&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 63px; line-height: 19.333333333333333333333333333px; text-align: justify; text-justify: inter-ideograph; text-indent: 14px"&gt;
&lt;span style="font-size: 14px"&gt;本邦の外部顧客への売上高が連結損益計算書の売上高の90％を超えるため、記載を省略しております。&lt;/span&gt;
&lt;/p&gt;
</jpcrp_cor:RevenuesFromExternalCustomersInformationForEachRegionTextBlock>
  <jpcrp_cor:PropertyPlantAndEquipmentInformationForEachRegionTextBlock contextRef="CurrentYearDuration">
&lt;p style="margin-left: 63px; line-height: 19.333333333333333333333333333px; text-align: left"&gt;
&lt;span style="font-size: 14px"&gt;(2）有形固定資産&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 63px; line-height: 19.333333333333333333333333333px; text-align: justify; text-justify: inter-ideograph; text-indent: 14px"&gt;
&lt;span style="font-size: 14px"&gt;本邦に所在している有形固定資産の金額が連結貸借対照表の有形固定資産の金額の90％を超えるため、記載を省略しております。&lt;/span&gt;
&lt;/p&gt;
</jpcrp_cor:PropertyPlantAndEquipmentInformationForEachRegionTextBlock>
  <jpcrp_cor:InformationForEachOfMainCustomersTextBlock contextRef="CurrentYearDuration">
&lt;p style="margin-left: 50px; line-height: 19.333333333333333333333333333px; text-align: left"&gt;
&lt;span style="font-size: 14px"&gt;３. 主要な顧客ごとの情報&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 49px; line-height: 19.333333333333333333333333333px; text-align: justify; text-justify: inter-ideograph; text-indent: 14px"&gt;
&lt;span style="font-size: 14px"&gt;連結損益計算書の売上高の10％以上を占める顧客が存在しないため、記載を省略しております。&lt;/span&gt;
&lt;/p&gt;
</jpcrp_cor:InformationForEachOfMainCustomersTextBlock>
