&lt;col style="width: 199.46666666666666666666666667px"/&gt;
&lt;col style="width: 168px"/&gt;
&lt;col style="width: 113.4px"/&gt;
&lt;col style="width: 113.4px"/&gt;
&lt;/colgroup&gt;
