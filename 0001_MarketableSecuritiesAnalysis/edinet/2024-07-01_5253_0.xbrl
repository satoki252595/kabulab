&lt;colgroup&gt;
&lt;col style="width:164.3pt;min-width:164.3pt;"/&gt;
&lt;col style="width:119.3pt;min-width:119.3pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:22.5pt;min-height:22.5pt;"&gt;
