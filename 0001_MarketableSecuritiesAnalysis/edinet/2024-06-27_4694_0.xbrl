&lt;/td&gt;
&lt;td style="vertical-align:top;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:5.4pt;padding-right:5.4pt;line-height:11pt;font-size:7.5pt;"&gt;Cocolive株式会社社外監査役(現任)&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
