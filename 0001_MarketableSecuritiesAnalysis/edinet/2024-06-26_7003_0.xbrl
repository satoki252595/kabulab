&lt;td style="vertical-align: middle; width: 48px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;
&lt;p style="text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;（注）11&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
