&lt;thead&gt;
&lt;tr style="height: 53.33px"&gt;
&lt;td colspan="2" style="vertical-align: middle; width: 325.2px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;前連結会計年度&lt;/p&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; margin-right: 12px; text-align: center"&gt;（自　2022年４月１日&lt;/p&gt;
