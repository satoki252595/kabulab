&lt;/div&gt;&lt;p class="smt_unitR" style="orphans:0;widows:0;line-height:6pt;"&gt;　&lt;/p&gt;
&lt;div class="tbld" style="margin-left:18pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:205.6pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
&lt;col style="width:129.1pt;min-width:129.1pt;"/&gt;
&lt;col style="width:76.5pt;min-width:76.5pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:18.5pt;min-height:18.5pt;"&gt;
&lt;td style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:0pt;padding-right:0.0pt;margin-top:0.0pt;margin-bottom:0.0pt;letter-spacing:0.0pt;line-height:11pt;"&gt;敷地面積&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblR" style="orphans:0;widows:0;padding-right:0pt;line-height:11pt;"&gt;71,819㎡&lt;/p&gt;
&lt;/td&gt;
