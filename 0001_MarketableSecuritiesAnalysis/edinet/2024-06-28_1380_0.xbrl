&lt;td style="vertical-align: middle; width: 180px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 14.666666666666666666666666667px; margin-right: 12px; text-align: left"&gt;秋川牧園（常州）農業有限公司&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 113.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 14.666666666666666666666666667px; text-align: center"&gt;12月31日&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td style="vertical-align: middle; width: 180px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 14.666666666666666666666666667px; margin-right: 12px; text-align: left"&gt;㈲菊川農場&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 113.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 14.666666666666666666666666667px; text-align: center"&gt;１月31日&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td style="vertical-align: middle; width: 180px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 14.666666666666666666666666667px; margin-right: 12px; text-align: left"&gt;㈱チキン食品&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 113.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 14.666666666666666666666666667px; text-align: center"&gt;１月31日&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 16.67px"&gt;
&lt;td style="vertical-align: middle; width: 180px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 14.666666666666666666666666667px; margin-right: 12px; text-align: left"&gt;㈲むつみ牧場&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 113.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 14.666666666666666666666666667px; text-align: center"&gt;２月29日&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
