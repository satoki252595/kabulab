&lt;/colgroup&gt;
&lt;tr style="height:30pt;min-height:30pt;"&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;padding-left:4.5pt;padding-right:4.5pt;margin-top:1pt;margin-bottom:1pt;font-size:7.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;名称&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;padding-left:4.5pt;padding-right:4.5pt;margin-top:1pt;margin-bottom:1pt;font-size:7.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;住所&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;padding-left:4.5pt;padding-right:4.5pt;margin-top:1pt;margin-bottom:1pt;line-height:8.5pt;font-size:7.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;資本金&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:9pt;"&gt;(百万円)&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
