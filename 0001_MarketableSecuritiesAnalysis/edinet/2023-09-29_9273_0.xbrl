  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E34071-000ShutoToshiyukiMember">1947-03-01</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock contextRef="FilingDateInstant_jpcrp030000-asr_E34071-000ShutoToshiyukiMember">
&lt;p style="margin-left: 77px; line-height: 15px; margin-right: 3px; text-align: left; text-indent: -72px"&gt;1972年１月　日本モンテジソン株式会社入社&lt;/p&gt;
&lt;p style="margin-left: 77px; line-height: 15px; margin-right: 3px; text-align: left; text-indent: -72px"&gt;1975年３月　日本ザンボン株式会社移籍&lt;/p&gt;
&lt;p style="margin-left: 77px; line-height: 15px; margin-right: 3px; text-align: left; text-indent: -72px"&gt;1991年２月　コーア商事株式会社設立同社取締役&lt;/p&gt;
&lt;p style="margin-left: 77px; line-height: 15px; margin-right: 3px; text-align: left; text-indent: -72px"&gt;1994年８月　同社代表取締役副社長&lt;/p&gt;
