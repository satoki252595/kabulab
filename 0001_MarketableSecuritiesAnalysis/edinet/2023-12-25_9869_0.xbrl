  <jpcrp_cor:NotesRegardingDividendTextBlock contextRef="CurrentYearDuration">
&lt;p style="margin-left: 24px; line-height: 18px; margin-right: 0px; text-align: left"&gt;３　配当に関する事項&lt;/p&gt;
