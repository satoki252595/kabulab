&lt;tr style="height: 16.47px"&gt;
&lt;td style="vertical-align: top; width: 101.2px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: center"&gt;2000年１月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 557.46666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 12px; text-align: left"&gt;ECに新しい標準を創造することを目的として、株式会社ネットプロテクションズ（旧ネットプロテクションズ）を設立&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 8.2px"&gt;
&lt;td style="vertical-align: top; width: 101.2px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: center"&gt;2002年３月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 557.46666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 12px; text-align: left"&gt;BtoCの通販事業者向けのBNPL決済サービスとして、「NP後払い」サービスの提供開始&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 16.47px"&gt;
&lt;td style="vertical-align: top; width: 101.2px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: center"&gt;2005年４月&lt;/p&gt;
&lt;p style="text-align: center"&gt;2006年８月&lt;/p&gt;
&lt;p style="text-align: center"&gt;2007年６月&lt;/p&gt;
&lt;p style="text-align: center"&gt;2007年11月&lt;/p&gt;
