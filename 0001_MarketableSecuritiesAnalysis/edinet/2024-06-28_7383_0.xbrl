&lt;td style="vertical-align: middle; width: 174px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-right: 4px; text-align: left"&gt;2024年３月31日&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 118.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 3px double #000000"&gt;
&lt;p style="margin-right: 6px; text-align: right"&gt;345,300,000&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 118.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 3px double #000000"&gt;
&lt;p style="margin-right: 6px; text-align: right"&gt;97,287,285&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 2.6666666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: left"&gt;
&lt;span style="font-size: 12px"&gt; &lt;/span&gt;
&lt;/p&gt;
