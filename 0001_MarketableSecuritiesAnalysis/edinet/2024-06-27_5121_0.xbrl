&lt;col style="width:97.5pt;min-width:97.5pt;"/&gt;
&lt;col style="width:97.5pt;min-width:97.5pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:22.7pt;min-height:22.7pt;"&gt;
