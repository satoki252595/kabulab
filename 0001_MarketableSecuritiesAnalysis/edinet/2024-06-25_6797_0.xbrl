&lt;td style="border-left: 0px none #000000; border-top: 1px solid #000000; border-right: 0px none #000000; border-bottom: 0px none #000000; width: 228px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px; background-color: #FFFFFF"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: left; line-height: 16px"&gt;差引：事業譲渡による収入&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 0px none #000000; border-top: 1px solid #000000; border-right: 0px none #000000; border-bottom: 0px none #000000; width: 144px; vertical-align: bottom; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px; background-color: #FFFFFF"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: right; line-height: 16px"&gt;137,280千円&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
