  <jpcrp_cor:NotesRegardingDividendTextBlock contextRef="CurrentYearDuration">
&lt;p style="text-align: left"&gt; &lt;/p&gt;
&lt;p style="margin-left: 12px; text-align: left"&gt;２．配当に関する事項&lt;/p&gt;
&lt;p style="margin-left: 36px; text-align: left; text-indent: -12px"&gt;(1）配当金支払額&lt;/p&gt;
&lt;div style="margin-left: 24px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 624px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 104px"/&gt;
&lt;col style="width: 104px"/&gt;
