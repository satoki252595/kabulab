&lt;tr style="height: 18px"&gt;
&lt;td style="vertical-align: top; width: 25.133333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: left"&gt;(5）&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 157.13333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: left"&gt;有価証券報告書の&lt;/p&gt;
&lt;p style="text-align: left"&gt;訂正報告書&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 98.2px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: center"&gt;事業年度&lt;/p&gt;
&lt;p style="text-align: center"&gt;（第66期）&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 144px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: center"&gt;自　2022年４月１日&lt;/p&gt;
&lt;p style="text-align: center"&gt;至　2023年３月31日&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 12px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: left"&gt;
&lt;span style="font-size: 12px"&gt; &lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 168px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: left"&gt;2024年３月６日&lt;/p&gt;
&lt;p style="text-align: left"&gt;東海財務局長に提出&lt;/p&gt;
&lt;p style="text-align: left"&gt;2023年６月23日提出の有価証券報告書に係る訂正報告書であります。&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
