&lt;p style="margin-left: 0px; margin-right: 0px; text-align: left; line-height: 84px"&gt; &lt;img alt="0102010_002.png" src="images/0102010_002.png" style="height: 80px; width: 80px; vertical-align: text-top"/&gt; &lt;img alt="0102010_003.png" src="images/0102010_003.png" style="height: 80px; width: 80px; vertical-align: text-top"/&gt; &lt;img alt="0102010_004.png" src="images/0102010_004.png" style="height: 80px; width: 80px; vertical-align: text-top"/&gt;&lt;/p&gt;
&lt;p style="margin-left: 0px; margin-right: 0px; text-align: left; line-height: 84px"&gt; &lt;img alt="0102010_005.png" src="images/0102010_005.png" style="height: 80px; width: 80px; vertical-align: text-top"/&gt; &lt;img alt="0102010_006.png" src="images/0102010_006.png" style="height: 80px; width: 80px; vertical-align: text-top"/&gt;&lt;/p&gt;
&lt;p style="margin-left: 0px; margin-right: 0px; text-align: left; line-height: 5.3333333333333333333333333333px"&gt; &lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 250.86666666666666666666666667px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: left"&gt;環境方針の策定・表明&lt;/p&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: left"&gt;温室効果ガス削減への貢献&lt;/p&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: left"&gt;資源循環型社会実現への取り組み（森林、林業、木材産業）&lt;/p&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: left"&gt;環境負荷低減への取り組み&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 91.46666666666666666666666667px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: left"&gt;Social&lt;/p&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: left"&gt;社会&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 272px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
