&lt;p style="margin-right: 6px; text-align: right"&gt;259&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;/div&gt;
&lt;p style="margin-left: 36px; text-align: left; text-indent: -12px"&gt; &lt;/p&gt;
