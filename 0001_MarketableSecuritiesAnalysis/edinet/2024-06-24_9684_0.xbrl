  <jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E04859-000ToyoshimaTadaoMember">豊島　忠夫</jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors>
