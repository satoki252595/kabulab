&lt;p style="margin-right: 12px; text-align: right"&gt;56&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 186px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 12px; text-align: right"&gt;245&lt;/p&gt;
&lt;/td&gt;
