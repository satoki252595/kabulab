  <jpcrp_cor:NotesRegardingGuaranteeObligationsTextBlock contextRef="CurrentYearInstant_NonConsolidatedMember">
&lt;p style="margin-left: 48px; text-align: left; text-indent: -24px"&gt;２　偶発債務&lt;/p&gt;
&lt;p style="margin-left: 48px; text-align: left; text-indent: -12px"&gt;(1) 保証債務&lt;/p&gt;
&lt;p style="margin-left: 48px; text-align: left"&gt;前事業年度(2022年12月31日)&lt;/p&gt;
