&lt;td style="vertical-align:bottom;border-left-style:solid;border-left-width:0.75pt;overflow:hidden;" valign="bottom"&gt;&lt;p class="smt_tblR" style="orphans:0;widows:0;text-align:left;padding-right:11.4pt;font-family:&amp;apos;ＭＳ Ｐゴシック&amp;apos;;"&gt; &lt;/p&gt;
