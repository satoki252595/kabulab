&lt;tbody&gt;
&lt;tr style="height: 326.47px"&gt;
&lt;td style="vertical-align: top; width: 180px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; margin-right: 3.3333333333333333333333333333px; margin-top: 2.6666666666666666666666666667px; text-align: left"&gt;モビリティ＆テレマティクスサービス分野&lt;/p&gt;
