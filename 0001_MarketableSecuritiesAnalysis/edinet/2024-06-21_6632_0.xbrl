  <jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E21320-000KOBASHIKAWAYasukoMember">小橋川　保子</jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E21320-000KOBASHIKAWAYasukoMember">1965-07-09</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
