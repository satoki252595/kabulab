&lt;col style="width:54pt;min-width:54pt;"/&gt;
&lt;col style="width:129.8pt;min-width:129.8pt;"/&gt;
&lt;col style="width:24pt;min-width:24pt;"/&gt;
&lt;col style="width:39.8pt;min-width:39.8pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:19.5pt;min-height:19.5pt;"&gt;
