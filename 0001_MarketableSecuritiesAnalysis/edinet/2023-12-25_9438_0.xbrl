&lt;/td&gt;
&lt;td style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:0pt;padding-right:0pt;"&gt;&lt;span style="font-size:9pt;"&gt;連結貸借対照表計上金額&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
