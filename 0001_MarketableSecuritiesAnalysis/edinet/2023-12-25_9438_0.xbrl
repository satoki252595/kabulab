&lt;tr style="height:10.8pt;min-height:10.8pt;"&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;margin-top:3pt;margin-bottom:3pt;letter-spacing:0pt;"&gt;事業所名&lt;br/&gt;(所在地)&lt;/p&gt;
