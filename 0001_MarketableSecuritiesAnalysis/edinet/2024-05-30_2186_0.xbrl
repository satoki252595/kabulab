&lt;/td&gt;
&lt;td colspan="2" style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;letter-spacing:0pt;"&gt;前事業年度&lt;/p&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;letter-spacing:0pt;"&gt;(&lt;span&gt;2023年２月28日&lt;/span&gt;)&lt;/p&gt;
