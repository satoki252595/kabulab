&lt;p class="text_align_justify"&gt;既発行&lt;/p&gt;
&lt;p class="text_align_justify" style="margin-bottom: 6px"&gt;株式数&lt;/p&gt;
&lt;/td&gt;
&lt;td rowspan="2" style="vertical-align: bottom; width: 25.333333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-bottom: 9px; text-align: center"&gt;＋&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 83.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p class="text_align_justify" style="margin-top: 3px"&gt;交付&lt;/p&gt;
&lt;p class="text_align_justify" style="margin-bottom: 3px"&gt;株式数&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 28.333333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: center"&gt;×&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 75.6px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p class="text_align_justify" style="margin-top: 3px"&gt;１株あたりの&lt;/p&gt;
&lt;p class="text_align_justify" style="margin-bottom: 3px"&gt;払込金額&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td rowspan="2" style="vertical-align: middle; width: 66.133333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p class="text_align_justify"&gt;調整後&lt;/p&gt;
&lt;p class="text_align_justify"&gt;行使価額&lt;/p&gt;
&lt;/td&gt;
&lt;td rowspan="2" style="vertical-align: middle; width: 22.466666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: center"&gt;＝&lt;/p&gt;
&lt;/td&gt;
&lt;td rowspan="2" style="vertical-align: middle; width: 62px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p class="text_align_justify"&gt;調整前&lt;/p&gt;
&lt;p class="text_align_justify"&gt;行使価額&lt;/p&gt;
&lt;/td&gt;
&lt;td rowspan="2" style="vertical-align: middle; width: 25.333333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: center"&gt;×&lt;/p&gt;
