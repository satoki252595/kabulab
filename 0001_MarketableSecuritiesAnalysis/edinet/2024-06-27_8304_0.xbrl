&lt;tr style="height: 18px"&gt;
&lt;td style="vertical-align: middle; width: 130px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; margin-right: 3.3333333333333333333333333333px; text-align: left"&gt;貸倒引当金&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 168px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-right: 24px; text-align: right"&gt;44,052百万円&lt;/p&gt;
