&lt;colgroup&gt;
&lt;col style="width: 111.26666666666666666666666667px"/&gt;
&lt;col style="width: 124.26666666666666666666666667px"/&gt;
&lt;col style="width: 174.26666666666666666666666667px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr style="height: 26.67px"&gt;
