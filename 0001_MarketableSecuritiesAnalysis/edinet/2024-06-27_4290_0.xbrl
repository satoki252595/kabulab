&lt;td style="vertical-align: middle; width: 296px; padding-top: 0px; padding-bottom: 0px; padding-left: 6.6px; padding-right: 6.6px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
