&lt;p style="margin-right: 6px; text-align: right"&gt;579,985&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 108px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 3px double #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
