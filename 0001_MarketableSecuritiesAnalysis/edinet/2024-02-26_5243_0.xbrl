&lt;col style="width:179pt;min-width:179pt;"/&gt;
&lt;col style="width:35.3pt;min-width:35.3pt;"/&gt;
&lt;col style="width:52.5pt;min-width:52.5pt;"/&gt;
&lt;/colgroup&gt;
