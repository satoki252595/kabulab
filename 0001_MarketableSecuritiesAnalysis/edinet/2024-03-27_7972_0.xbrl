  <jpcrp_cor:ConsolidatedStatementOfChangesInEquityTextBlock contextRef="CurrentYearDuration">
&lt;h4 class="smt_head4" style="padding-left:18pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;text-align:justify;letter-spacing:0pt;line-height:15pt;font-size:9pt;"&gt;③ 【連結株主資本等変動計算書】&lt;/h4&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;"&gt;  前連結会計年度（自2022年１月１日　至2022年12月31日）&lt;/p&gt;
&lt;div class="tbld" style="margin-left:0pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:372.8pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
