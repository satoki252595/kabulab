&lt;col style="width:171.8pt;min-width:171.8pt;"/&gt;
&lt;col style="width:171pt;min-width:171pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:19.7pt;min-height:19.7pt;"&gt;
