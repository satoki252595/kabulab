&lt;/colgroup&gt;
&lt;thead&gt;
&lt;tr style="height: 66.67px"&gt;
&lt;td style="vertical-align: middle; width: 224px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 14px; text-align: center"&gt;セグメントの名称&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 211px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 14px; text-align: center"&gt;前連結会計年度&lt;/p&gt;
&lt;p style="line-height: 14px; text-align: center"&gt;（自　2022年４月１日&lt;/p&gt;
&lt;p style="line-height: 14px; text-align: center"&gt;　  至　2023年３月31日）&lt;/p&gt;
&lt;p style="line-height: 14px; text-align: center"&gt;（百万円）&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 211px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 14px; text-align: center"&gt;当連結会計年度&lt;/p&gt;
&lt;p style="line-height: 14px; text-align: center"&gt;（自　2023年４月１日&lt;/p&gt;
&lt;p style="line-height: 14px; text-align: center"&gt;　  至　2024年３月31日）&lt;/p&gt;
&lt;p style="line-height: 14px; margin-right: 14.666666666666666666666666667px; text-align: right"&gt;（百万円）（増減率）&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/thead&gt;
