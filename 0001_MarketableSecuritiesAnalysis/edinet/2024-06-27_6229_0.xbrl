  <jpcrp_cor:TreasurySharesEtcTextBlock contextRef="FilingDateInstant">
&lt;h5 class="smt_head4"&gt;② 【自己株式等】&lt;/h5&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:36pt;"&gt;該当事項はありません。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:36pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;font-size:15pt;"&gt; &lt;/p&gt;</jpcrp_cor:TreasurySharesEtcTextBlock>
