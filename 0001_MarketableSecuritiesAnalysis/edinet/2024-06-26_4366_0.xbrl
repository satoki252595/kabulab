&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 296.13333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; line-height: 15.333333333333333333333333333px; margin-right: 6px; text-align: left"&gt;安部　将規（2023年６月23日就任）&lt;/p&gt;
&lt;/td&gt;
