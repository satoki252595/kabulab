&lt;/thead&gt;
&lt;tbody&gt;
&lt;tr style="height: 18px"&gt;
&lt;td style="vertical-align: top; width: 213.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 12px; margin-right: 3.3333333333333333333333333333px; text-align: left"&gt;有形固定資産&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 164px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-right: 12px; text-align: right"&gt;7,512百万円&lt;/p&gt;
