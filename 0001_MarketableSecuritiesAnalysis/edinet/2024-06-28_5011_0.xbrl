&lt;td colspan="2" style="vertical-align:top;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:4.4pt;padding-right:4.4pt;margin-top:0pt;margin-bottom:0pt;letter-spacing:0pt;line-height:18.0pt;"&gt;&lt;span style="font-size:9.0pt;"&gt;比較増減&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
