&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 90px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 15px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;柳澤　大輔&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 100px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 15px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;1974年２月19日&lt;/span&gt;&lt;span style="font-size: 10px"&gt;生&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 266.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;

&lt;p style="margin-left: 65px; margin-right: 3px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;1996年４月　株式会社ソニー・ミュージックエンタテインメント入社&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; margin-right: 3px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;1998年８月　合資会社カヤック設立　無限責任社員&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; margin-right: 3px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;2005年１月　株式会社カヤック設立　代表取締役就任（現任）&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; margin-right: 3px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;2015年９月　株式会社テー・オー・ダブリュー　取締役就任（現任）&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; margin-right: 3px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;2015年11月　株式会社プラコレ　取締役就任（現任）&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; margin-right: 3px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;2016年３月　クックパッド株式会社　社外取締役就任&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; margin-right: 3px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;2017年５月　稲村ガ崎三丁目不動産株式会社（現　鎌倉R不動産株式会社）　取締役就任（現任）&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; margin-right: 3px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;2017年６月　ウェルプレイド株式会社（現　ウェルプレイド・ライゼスト株式会社）　取締役就任&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; margin-right: 3px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;2019年10月　当社取締役就任（現任）&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; margin-right: 3px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;2021年５月　株式会社カヤックゼロ　代表取締役就任（現任）&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; margin-right: 3px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;2022年11月　株式会社リビングハウス　社外取締役就任（現任）&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; margin-right: 3px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;2023年２月　株式会社フィル・カンパニー　社外取締役就任（現任）&lt;/span&gt;
&lt;/p&gt;

&lt;/td&gt;
