&lt;col style="width:45.3pt;min-width:45.3pt;"/&gt;
&lt;col style="width:55pt;min-width:55pt;"/&gt;
&lt;col style="width:41.5pt;min-width:41.5pt;"/&gt;
&lt;col style="width:43.3pt;min-width:43.3pt;"/&gt;
&lt;col style="width:39.7pt;min-width:39.7pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:22.7pt;min-height:22.7pt;"&gt;
