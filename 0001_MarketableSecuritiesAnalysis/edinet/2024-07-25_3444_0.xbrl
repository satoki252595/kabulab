&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;text-align:justify;"&gt;&lt;span style="font-size:7.5pt;"&gt; ㈱セントラルファイナンス(現 ㈱セディナ)入社&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
