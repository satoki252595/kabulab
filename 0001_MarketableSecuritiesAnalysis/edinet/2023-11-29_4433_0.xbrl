&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:1.5pt;margin-top:0pt;text-justify:inter-ideograph;text-indent:0pt;"&gt;取得原価&lt;/p&gt;
