&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 188px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-right: 6px; text-align: right"&gt;－&lt;/p&gt;
&lt;/td&gt;
