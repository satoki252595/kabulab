&lt;p style="margin-left: 6px; margin-right: 6px; text-align: left; line-height: 20px"&gt;既発行株式数&lt;/p&gt;
&lt;/td&gt;
&lt;td rowspan="2" style="border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 1px solid #000000; width: 40px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
