&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px dashed #000000; width: 60px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center; line-height: 16px"&gt;中長期&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 28.47px"&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 1px dashed #000000; border-right: 1px solid #000000; border-bottom: 1px dashed #000000; width: 133.33333333333333333333333333px; vertical-align: top; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: left; line-height: 16px"&gt;
&lt;span style="font-size: 10px"&gt;エネルギーや原材料等サプライチェーンへの炭素価格導入による価格転嫁発生&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 1px dashed #000000; border-right: 1px solid #000000; border-bottom: 1px dashed #000000; width: 220px; vertical-align: top; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 14px; margin-right: 4px; text-align: left; line-height: 16px; text-indent: -10px"&gt;
