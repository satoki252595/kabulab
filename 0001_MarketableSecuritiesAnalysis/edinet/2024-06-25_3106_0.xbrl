&lt;td style="border-left: 1px solid #000000; border-top: 1px dashed #000000; border-right: 1px solid #000000; border-bottom: 1px dashed #000000; width: 133.33333333333333333333333333px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: justify; line-height: 16px; text-justify: inter-ideograph"&gt;
