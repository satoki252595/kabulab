  <jpcrp_cor:NotesRegardingPledgedAssetsTextBlock contextRef="CurrentYearInstant_NonConsolidatedMember">&lt;p class="smt_text1" style="orphans:0;widows:0;text-align:justify;padding-left:0pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:9pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;font-size:9pt;"&gt;２ 担保に供している資産&lt;/p&gt;&lt;p class="smt_unitR" style="orphans:0;widows:0;line-height:3pt;font-size:3pt;"&gt; &lt;/p&gt;
