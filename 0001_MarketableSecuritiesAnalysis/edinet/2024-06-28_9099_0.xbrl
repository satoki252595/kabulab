&lt;col style="width:43.5pt;min-width:43.5pt;"/&gt;
&lt;col style="width:41.3pt;min-width:41.3pt;"/&gt;
&lt;col style="width:41.3pt;min-width:41.3pt;"/&gt;
&lt;col style="width:48pt;min-width:48pt;"/&gt;
&lt;col style="width:33.8pt;min-width:33.8pt;"/&gt;
&lt;col style="width:33.8pt;min-width:33.8pt;"/&gt;
&lt;col style="width:42.8pt;min-width:42.8pt;"/&gt;
