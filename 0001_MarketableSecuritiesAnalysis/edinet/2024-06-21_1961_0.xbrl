&lt;col style="width:86.3pt;min-width:86.3pt;"/&gt;
&lt;col style="width:121.5pt;min-width:121.5pt;"/&gt;
&lt;col style="width:111.8pt;min-width:111.8pt;"/&gt;
&lt;col style="width:111.8pt;min-width:111.8pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:12pt;min-height:12pt;"&gt;
