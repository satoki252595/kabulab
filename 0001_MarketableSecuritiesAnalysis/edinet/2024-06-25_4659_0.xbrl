&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:22.5pt;min-height:22.5pt;"&gt;
&lt;td style="vertical-align:middle;border-top-color:#a9a9a9;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:22.6pt;text-justify:inter-ideograph;text-indent:-18pt;letter-spacing:0pt;"&gt;　　ホームセンター・ドラッグストア&lt;/p&gt;
&lt;/td&gt;
