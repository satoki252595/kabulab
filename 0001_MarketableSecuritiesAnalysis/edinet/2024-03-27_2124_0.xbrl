  <jpcrp_cor:DescriptionIssuedSharesVotingRights contextRef="CurrentYearInstant_SharesWithRestrictedVotingRightsOtherMember" xsi:nil="true"/>
  <jpcrp_cor:DescriptionIssuedSharesVotingRights contextRef="CurrentYearInstant_OrdinarySharesTreasurySharesSharesWithFullVotingRightsTreasurySharesEtcMember" xsi:nil="true"/>
  <jpcrp_cor:DescriptionIssuedSharesVotingRights contextRef="CurrentYearInstant_OrdinarySharesSharesWithFullVotingRightsOtherMember">(注)１、２</jpcrp_cor:DescriptionIssuedSharesVotingRights>
  <jpcrp_cor:DescriptionIssuedSharesVotingRights contextRef="CurrentYearInstant_OrdinarySharesSharesLessThanOneUnitMember">(注)３</jpcrp_cor:DescriptionIssuedSharesVotingRights>
  <jpcrp_cor:TreasurySharesEtcTextBlock contextRef="FilingDateInstant">
&lt;h5 class="smt_head4"&gt;② 【自己株式等】&lt;/h5&gt;&lt;p class="smt_unitR" style="orphans:0;widows:0;text-align:right;padding-left:0pt;padding-right:5pt;"&gt;&lt;span&gt;2023年12月31日&lt;/span&gt;現在&lt;/p&gt;
&lt;div class="tbld" style="margin-left:0pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
