  <jpcrp_cor:NotesRegardingDividendTextBlock contextRef="CurrentYearDuration">
&lt;p style="margin-left: 24px; text-align: left; text-indent: -12px"&gt;３．配当に関する事項&lt;/p&gt;
&lt;p style="margin-left: 30px; text-align: left; text-indent: -6px"&gt;(1)配当金支払額&lt;/p&gt;
&lt;div style="margin-left: 26.6px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 624px"&gt;
&lt;colgroup&gt;
