&lt;/colgroup&gt;
&lt;thead&gt;
&lt;tr style="height: 32px"&gt;
&lt;td style="vertical-align: middle; width: 300px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 16.666666666666666666666666667px; text-align: left"&gt;
&lt;span style="font-size: 12px"&gt; &lt;/span&gt;
