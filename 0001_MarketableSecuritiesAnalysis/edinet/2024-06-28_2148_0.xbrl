</jpigp_cor:InformationAboutMajorCustomersIFRSTextBlock>
  <jpigp_cor:InformationAboutGeographicalAreasIFRSTextBlock contextRef="CurrentYearDuration">
&lt;p style="margin-left: 60px; text-align: left"&gt;(4）地域別に関する情報&lt;/p&gt;
