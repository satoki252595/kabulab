&lt;/colgroup&gt;
&lt;tr&gt;
&lt;td style="vertical-align:top;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:2.9pt;padding-right:2.9pt;margin-bottom:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;line-height:18pt;font-size:9pt;"&gt;&lt;span style="font-size:9pt;"&gt;マテリアリティ&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:top;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:2.9pt;padding-right:2.9pt;margin-bottom:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;line-height:18pt;font-size:9pt;"&gt;&lt;span style="font-size:9pt;"&gt;目標&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:top;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:2.9pt;padding-right:2.9pt;margin-bottom:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;line-height:18pt;font-size:9pt;"&gt;&lt;span style="font-size:9pt;"&gt;主な取り組み&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:51pt;min-height:51pt;"&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:2.9pt;padding-right:2.9pt;margin-bottom:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;line-height:12pt;font-size:9pt;"&gt;&lt;span style="font-size:9pt;"&gt;ニーズを満たす特色ある製品の創出&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:2.9pt;padding-right:2.9pt;margin-bottom:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;line-height:12pt;font-size:9pt;"&gt;&lt;span style="font-size:9pt;"&gt;先見的特色ある製品を創出し、多様化する医療・健康ニーズを満たす&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:23.9pt;padding-right:2.9pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:-21pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;line-height:12pt;font-size:9pt;"&gt;&lt;span style="font-size:9pt;"&gt;・新規モダリティへの取り組み&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:32.9pt;padding-right:2.9pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:-18pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;line-height:12pt;font-size:9pt;"&gt;－&lt;span style="font-size:7.5pt;"&gt; &lt;/span&gt;&lt;span style="font-size:9pt;"&gt;研究開発プロジェクトの推進&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:32.9pt;padding-right:2.9pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:-18pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;line-height:12pt;font-size:9pt;"&gt;－&lt;span style="font-size:7.5pt;"&gt; &lt;/span&gt;&lt;span style="font-size:9pt;"&gt;サイエンス＆テクノロジーの基盤構築&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:23.9pt;padding-right:2.9pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:-21pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;line-height:12pt;font-size:9pt;"&gt;&lt;span style="font-size:9pt;"&gt;・オープンイノベーションの積極活用&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:39pt;min-height:39pt;"&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:2.9pt;padding-right:2.9pt;margin-bottom:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;line-height:12pt;font-size:9pt;"&gt;&lt;span style="font-size:9pt;"&gt;高品質な医薬品の安定供給&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:2.9pt;padding-right:2.9pt;margin-bottom:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;line-height:12pt;font-size:9pt;"&gt;&lt;span style="font-size:9pt;"&gt;製品の品質管理を適切に推進すると共に、安定供給に努める&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:23.9pt;padding-right:2.9pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:-21pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;line-height:12pt;font-size:9pt;"&gt;&lt;span style="font-size:9pt;"&gt;・サプライチェーンマネジメントの推進&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:23.9pt;padding-right:2.9pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:-21pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;line-height:12pt;font-size:9pt;"&gt;&lt;span style="font-size:9pt;"&gt;・製造現場における安定稼働の推進&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:23.9pt;padding-right:2.9pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:-21pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;line-height:12pt;font-size:9pt;"&gt;&lt;span style="font-size:9pt;"&gt;・信頼性保証体制の維持・強化&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:39.8pt;min-height:39.8pt;"&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:2.9pt;padding-right:2.9pt;margin-bottom:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;line-height:12pt;font-size:9pt;"&gt;&lt;span style="font-size:9pt;"&gt;適切な価値ある情報提供&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:2.9pt;padding-right:2.9pt;margin-bottom:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;line-height:12pt;font-size:9pt;"&gt;&lt;span style="font-size:9pt;"&gt;医療用医薬品の販売情報提供活動に関するガイドラインを遵守し、価値ある情報提供を行う&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:12.1pt;padding-right:2.9pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:-9.2pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;line-height:12pt;font-size:9pt;"&gt;&lt;span style="font-size:9pt;"&gt;・リアルとデジタルのチャネルミックスによる有用性の高い医薬情報提供の実施&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:23.9pt;padding-right:2.9pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:-21pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;line-height:12pt;font-size:9pt;"&gt;・販売情報提供活動に係る監督・モニタリングの実施&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/table&gt;&lt;p style="clear:both; line-height:0.75pt; width:100%; font-size:0.75pt;"&gt; &lt;/p&gt;
&lt;/div&gt;&lt;p class="smt_text2" style="orphans:0;widows:0;line-height:7pt;font-size:7pt;"&gt; &lt;/p&gt;&lt;p class="smt_text2" style="orphans:0;widows:0;padding-left:27pt;"&gt;(関連するSDGs)&lt;/p&gt;
&lt;div class="tbld" style="margin-left:30pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:412.6pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
&lt;col style="width:83.3pt;min-width:83.3pt;"/&gt;
&lt;col style="width:84pt;min-width:84pt;"/&gt;
&lt;col style="width:82.5pt;min-width:82.5pt;"/&gt;
&lt;col style="width:81.8pt;min-width:81.8pt;"/&gt;
&lt;col style="width:81pt;min-width:81pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:17.9pt;min-height:17.9pt;"&gt;
&lt;td style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;"&gt; &lt;/p&gt;
&lt;div&gt;&lt;img alt="" height="100" src="fuzoku/sdgs_3.jpg" width="100"/&gt;&lt;br/&gt;
&lt;/div&gt;
&lt;/td&gt;
&lt;td style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;"&gt; &lt;/p&gt;
&lt;div&gt;&lt;img alt="" height="100" src="fuzoku/sdgs_5.jpg" width="100"/&gt;&lt;br/&gt;
&lt;/div&gt;
&lt;/td&gt;
&lt;td style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;"&gt; &lt;/p&gt;
&lt;div&gt;&lt;img alt="" height="100" src="fuzoku/sdgs_8.jpg" width="100"/&gt;&lt;br/&gt;
&lt;/div&gt;
&lt;/td&gt;
&lt;td style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;"&gt; &lt;/p&gt;
&lt;div&gt;&lt;img alt="" height="100" src="fuzoku/sdgs_12.jpg" width="100"/&gt;&lt;br/&gt;
&lt;/div&gt;
&lt;/td&gt;
&lt;td style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;"&gt; &lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/table&gt;&lt;p style="clear:both; line-height:0.75pt; width:100%; font-size:0.75pt;"&gt; &lt;/p&gt;
&lt;/div&gt;&lt;p class="smt_text3" style="orphans:0;widows:0;text-align:justify;padding-left:0pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:9pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;font-size:15pt;"&gt; &lt;/p&gt;&lt;p class="smt_text3" style="orphans:0;widows:0;text-align:justify;padding-left:0pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:9pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;font-size:9pt;"&gt;(3) 気候変動&lt;/p&gt;&lt;p class="smt_text2" style="orphans:0;widows:0;"&gt;当社グループは、TCFD(気候関連財務情報開示タスクフォース)の提言に沿った開示を行うべく、気候変動に関連するリスクと機会の評価や管理を進めています。&lt;/p&gt;&lt;p class="smt_text2" style="orphans:0;widows:0;text-align:justify;padding-left:9pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:9pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;font-size:15pt;"&gt; &lt;/p&gt;&lt;p class="smt_text2" style="orphans:0;widows:0;"&gt;① 戦略&lt;/p&gt;&lt;p class="smt_text2" style="orphans:0;widows:0;padding-left:18pt;"&gt;気候変動が当社事業に及ぼす影響について、1.5℃シナリオおよび4℃シナリオを用いて、気候変動に関するリスクと機会を特定しました。脱炭素社会に向かう1.5℃シナリオは気候変動に関する政府間パネル(IPCC)によるSSP1-1.9を、温暖化が進む4℃シナリオはSSP5-8.5を参考にしました。&lt;/p&gt;&lt;p class="smt_text2" style="orphans:0;widows:0;padding-left:18pt;"&gt;特定したリスクと機会は財務的な影響度と発生頻度を考慮して分析を行い、対応策の評価を実施しました。&lt;/p&gt;&lt;p class="smt_text2" style="orphans:0;widows:0;text-align:justify;padding-left:18pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:9pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;font-size:15pt;"&gt; &lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:27pt;margin-bottom:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;line-height:18pt;font-size:9pt;"&gt;&lt;span style="font-size:9pt;"&gt;・リスク&lt;/span&gt;&lt;/p&gt;
&lt;div class="tbld" style="margin-left:25pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:455.3pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
&lt;col style="width:46.5pt;min-width:46.5pt;"/&gt;
&lt;col style="width:41.3pt;min-width:41.3pt;"/&gt;
&lt;col style="width:56.3pt;min-width:56.3pt;"/&gt;
&lt;col style="width:102pt;min-width:102pt;"/&gt;
&lt;col style="width:36.8pt;min-width:36.8pt;"/&gt;
&lt;col style="width:134.3pt;min-width:134.3pt;"/&gt;
&lt;col style="width:38.3pt;min-width:38.3pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:1pt;min-height:1pt;"&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:3.6pt;padding-right:3.6pt;margin-bottom:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;line-height:12pt;font-size:9pt;"&gt;&lt;span style="font-size:9pt;"&gt;シナリオ&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
