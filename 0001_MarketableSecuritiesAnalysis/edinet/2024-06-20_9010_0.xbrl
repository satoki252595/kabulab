&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:29.6pt;min-height:29.6pt;"&gt;
&lt;td style="vertical-align:middle;border-top-color:#a9a9a9;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:4pt;padding-right:4pt;font-size:7.5pt;"&gt;富士山麓電気鉄道㈱&lt;/p&gt;
&lt;/td&gt;
