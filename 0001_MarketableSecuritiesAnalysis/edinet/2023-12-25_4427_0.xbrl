&lt;p style="margin-left: 12px; margin-right: 12px; text-align: left"&gt;Edutech Lab AP Limited&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 90.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 12px; text-align: center"&gt;12月31日　＊&lt;/p&gt;
