&lt;tr style="height: 37.33px"&gt;
&lt;td style="vertical-align: middle; width: 293.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 3px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
