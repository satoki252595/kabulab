&lt;col style="width:84.8pt;min-width:84.8pt;"/&gt;
&lt;col style="width:200.9pt;min-width:200.9pt;"/&gt;
&lt;col style="width:183.8pt;min-width:183.8pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr&gt;
&lt;td style="vertical-align:top;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:0pt;padding-right:0pt;margin-bottom:0pt;line-height:18pt;font-size:18pt;"&gt; &lt;/p&gt;
