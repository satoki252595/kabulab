&lt;td style="vertical-align:bottom;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="bottom"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:7.1pt;padding-right:0pt;margin-bottom:0pt;line-height:18pt;font-size:9pt;"&gt;&lt;span style="font-size:9pt;"&gt;吸収分割会社&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:bottom;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="bottom"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:0pt;padding-right:0pt;margin-bottom:0pt;line-height:18pt;font-size:9pt;"&gt;&lt;span style="font-size:9pt;"&gt;吸収分割承継会社&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td style="vertical-align:top;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:0pt;padding-right:0pt;margin-bottom:0pt;line-height:18pt;font-size:9pt;"&gt;&lt;span style="font-size:9pt;"&gt;（１）名称&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:top;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:2pt;padding-right:0pt;margin-bottom:0pt;line-height:18pt;font-size:9pt;"&gt;&lt;span style="font-size:9pt;"&gt;日本ピグメント株式会社&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:2pt;padding-right:0pt;margin-bottom:0pt;line-height:18pt;font-size:9pt;"&gt;&lt;span style="font-size:9pt;"&gt;（2024年10月１日付で「株式会社日本ピグメントホールディングス」に商号変更予定です。）&lt;/span&gt;&lt;/p&gt;
