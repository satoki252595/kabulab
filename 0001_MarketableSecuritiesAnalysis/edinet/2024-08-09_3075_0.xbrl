&lt;col style="width: 53.333333333333333333333333333px"/&gt;
&lt;col style="width: 53.333333333333333333333333333px"/&gt;
&lt;col style="width: 53.333333333333333333333333333px"/&gt;
&lt;col style="width: 53.333333333333333333333333333px"/&gt;
&lt;col style="width: 53.333333333333333333333333333px"/&gt;
&lt;col style="width: 56px"/&gt;
&lt;col style="width: 49.333333333333333333333333333px"/&gt;
&lt;/colgroup&gt;
&lt;thead&gt;
&lt;tr style="height: 16px"&gt;
&lt;td rowspan="2" style="vertical-align: middle; width: 62.666666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 11.333333333333333333333333333px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;区分&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 53.333333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="line-height: 11.333333333333333333333333333px; text-align: center"&gt; &lt;/p&gt;
&lt;p style="line-height: 11.333333333333333333333333333px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;セグメント&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td rowspan="2" style="vertical-align: middle; width: 42.666666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 11.333333333333333333333333333px; text-align: center"&gt;
