&lt;td style="vertical-align: middle; width: 210px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 14px; text-align: center"&gt;セグメントの名称&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 196px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 14px; text-align: center"&gt;当事業年度&lt;/p&gt;
&lt;p style="margin-left: 6.5333333333333333333333333333px; line-height: 13.333333333333333333333333333px; margin-right: 6.5333333333333333333333333333px; text-align: left; text-indent: 24px"&gt;（自　2023年５月16日&lt;/p&gt;
&lt;p style="margin-left: 6.5333333333333333333333333333px; line-height: 13.333333333333333333333333333px; margin-right: 6.5333333333333333333333333333px; text-align: left; text-indent: 36px"&gt;至　2024年５月15日）&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 173px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 14px; text-align: center"&gt;前年同期比（％）&lt;/p&gt;
