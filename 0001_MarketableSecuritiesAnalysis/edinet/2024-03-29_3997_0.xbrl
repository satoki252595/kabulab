  <jpcrp_cor:TermOfOfficeInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E33553-000AsamiKatsuhiroMember">(注)３</jpcrp_cor:TermOfOfficeInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:OfficialTitleOrPositionInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E33553-000TokushimaNaoyaMember">取締役</jpcrp_cor:OfficialTitleOrPositionInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E33553-000TokushimaNaoyaMember">徳島　直哉</jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E33553-000TokushimaNaoyaMember">1978-06-05</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock contextRef="FilingDateInstant_jpcrp030000-asr_E33553-000TokushimaNaoyaMember">
&lt;p style="margin-left: 60px; line-height: 14.666666666666666666666666667px; margin-right: 3px; text-align: left; text-indent: -55px"&gt;
