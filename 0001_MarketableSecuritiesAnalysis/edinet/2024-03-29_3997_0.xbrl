&lt;td style="vertical-align: top; width: 102px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 12px; line-height: 20.666666666666666666666666667px; margin-right: 12px; text-align: center"&gt;2024年３月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 534px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 12px; line-height: 20.666666666666666666666666667px; margin-right: 12px; text-align: left"&gt;東京都港区赤坂に本店を移転&lt;/p&gt;
