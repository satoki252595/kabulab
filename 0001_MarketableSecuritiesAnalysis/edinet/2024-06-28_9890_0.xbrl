&lt;p style="margin-left: 6px; margin-right: 6px; text-align: left"&gt;期首残高&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none ; width: 173.33333333333333333333333333px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
