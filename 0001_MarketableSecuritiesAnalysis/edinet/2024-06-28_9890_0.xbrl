&lt;td style="vertical-align: middle; width: 101.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; margin-right: 12px; text-align: right"&gt;2,265,107&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 101.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; margin-right: 12px; text-align: right"&gt;886,064&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 101.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; margin-right: 12px; text-align: right"&gt;－&lt;/p&gt;
