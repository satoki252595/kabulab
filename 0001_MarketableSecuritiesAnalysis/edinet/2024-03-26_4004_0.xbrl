&lt;/td&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 45px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 5px; margin-right: 3px; text-align: left; line-height: 15px"&gt;
&lt;span style="font-size: 10px"&gt;短期～中期&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 180px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 5px; margin-right: 3px; text-align: left; line-height: 15px"&gt;
&lt;span style="font-size: 10px"&gt;低消費電力半導体・環境配慮型製品の需要増による売上増加&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td rowspan="2" style="border-left: 0px none ; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 180px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 5px; margin-right: 3px; text-align: left; line-height: 15px"&gt;
&lt;span style="font-size: 10px"&gt;・環境適合製品設計アセスメント&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 5px; margin-right: 3px; text-align: left; line-height: 15px"&gt;
&lt;span style="font-size: 10px"&gt;・低GWP値の半導体用エッチングガス開発&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 5px; margin-right: 3px; text-align: left; line-height: 15px"&gt;
&lt;span style="font-size: 10px"&gt;・GHG削減プロセスに貢献できる封止材の開発&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 5px; margin-right: 3px; text-align: left; line-height: 15px"&gt;
&lt;span style="font-size: 10px"&gt;・メモリ用途接着フィルムの薄膜化への対応&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 5px; margin-right: 3px; text-align: left; line-height: 15px"&gt;
