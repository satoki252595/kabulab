&lt;/td&gt;
&lt;td style="vertical-align:top;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;line-height:8pt;font-size:8pt;"&gt; &lt;/p&gt;
&lt;div style="text-align:center;"&gt;&lt;img alt="" height="203" src="fuzoku/1_jinji.png" width="320"/&gt;&lt;br/&gt;
&lt;/div&gt;
