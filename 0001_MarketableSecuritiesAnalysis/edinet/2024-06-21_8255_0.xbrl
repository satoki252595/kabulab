&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:9.0pt;min-height:9.0pt;"&gt;
&lt;td style="vertical-align:top;border-top-color:#a9a9a9;border-bottom-color:#a9a9a9;border-left-color:#a9a9a9;border-right-color:#a9a9a9;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:19.9pt;padding-right:0pt;line-height:16pt;"&gt;2005年３月&lt;/p&gt;
