&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;"&gt;翌連結会計年度見込値&lt;/p&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;"&gt;（2025年３月期見込値）&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;"&gt;当連結会計年度比&lt;/p&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;"&gt;（2024年３月期比）&lt;/p&gt;
&lt;/td&gt;
