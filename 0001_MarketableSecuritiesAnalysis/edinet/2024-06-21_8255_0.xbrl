&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblR" style="orphans:0;widows:0;padding-right:3.8pt;font-size:7.5pt;"&gt;3,132&lt;/p&gt;&lt;p class="smt_tblR" style="orphans:0;widows:0;padding-right:0pt;font-size:7.5pt;"&gt;&amp;lt;9&amp;gt;&lt;/p&gt;&lt;p class="smt_tblR" style="orphans:0;widows:0;padding-right:7.4pt;"&gt; &lt;/p&gt;
