  <jpcrp_cor:NameOfSecuritiesInvestmentEquitySecuritiesReclassifiedFromHeldForPurposesOtherThanPureInvestmentToHeldForPureInvestmentReportingCompany contextRef="CurrentYearInstant_Row1Member" xsi:nil="true"/>
