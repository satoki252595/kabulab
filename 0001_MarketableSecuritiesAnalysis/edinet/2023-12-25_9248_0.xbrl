&lt;col style="width:106.8pt;min-width:106.8pt;"/&gt;
&lt;col style="width:14.2pt;min-width:14.2pt;"/&gt;
&lt;col style="width:14.2pt;min-width:14.2pt;"/&gt;
&lt;col style="width:106.8pt;min-width:106.8pt;"/&gt;
&lt;col style="width:14.2pt;min-width:14.2pt;"/&gt;
