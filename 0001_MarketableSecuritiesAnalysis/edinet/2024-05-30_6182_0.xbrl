  <jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E31901-000GoishiJunichiMember">五石 順一</jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E31901-000GoishiJunichiMember">1964-12-25</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock contextRef="FilingDateInstant_jpcrp030000-asr_E31901-000GoishiJunichiMember">
&lt;p style="margin-left: 60px; line-height: 14.666666666666666666666666667px; margin-right: 3px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;1989年４月 株式会社ノヴァ入社&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; line-height: 14.666666666666666666666666667px; margin-right: 3px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;1991年４月 同社 経営企画課長&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; line-height: 14.666666666666666666666666667px; margin-right: 3px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;1993年４月 同社 経営企画室長&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; line-height: 14.666666666666666666666666667px; margin-right: 3px; text-align: left; text-indent: -55px"&gt;
