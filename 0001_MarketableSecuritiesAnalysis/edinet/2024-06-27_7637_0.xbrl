&lt;p style="line-height: 11.333333333333333333333333333px; text-align: right"&gt;
&lt;span style="font-size: 10px"&gt;2024年３月31日現在&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;/div&gt;
&lt;p style="line-height: 1.3333333333333333333333333333px; text-align: left"&gt; &lt;/p&gt;
&lt;div style="margin-left: 20px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 629.33333333333333333333333334px"&gt;
