&lt;/td&gt;
&lt;td style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:13.5pt;"&gt;100,133千円&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
