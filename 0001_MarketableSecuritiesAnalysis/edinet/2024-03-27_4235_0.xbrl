&lt;td rowspan="3" style="vertical-align: middle; width: 98.13333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 6.6px; padding-right: 6.6px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 10px; line-height: 1; margin-right: 2px; text-align: left"&gt;調整後&lt;/p&gt;
&lt;p style="margin-left: 10px; line-height: 1; margin-right: 2px; text-align: left"&gt;行使価額&lt;/p&gt;
