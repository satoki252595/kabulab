&lt;td style="vertical-align: middle; width: 108.13333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 5px; line-height: 15px; margin-right: 3px; text-align: right"&gt;
