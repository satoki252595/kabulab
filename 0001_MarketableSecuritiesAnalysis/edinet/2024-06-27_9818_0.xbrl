&lt;td style="vertical-align: top; width: 141.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: left"&gt;自　2023年10月１日&lt;/p&gt;
&lt;p style="text-align: left"&gt;至　2023年12月31日&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 24px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
