&lt;tr style="height: 21.33px"&gt;
&lt;td rowspan="2" style="vertical-align: middle; width: 296.26666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: right"&gt;調整後行使価額　＝　調整前行使価額　×&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 242.26666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center"&gt;１株当たりの時価&lt;/p&gt;
&lt;/td&gt;
