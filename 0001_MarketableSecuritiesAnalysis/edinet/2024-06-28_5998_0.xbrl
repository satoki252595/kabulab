&lt;/tr&gt;
&lt;tr style="height:15pt;min-height:15pt;"&gt;
&lt;td style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:9.1pt;padding-right:4.0pt;text-justify:inter-ideograph;text-indent:-9.1pt;"&gt;・Advanex (Dongguan) Inc.&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:0pt;padding-right:4.0pt;"&gt; &lt;/p&gt;
&lt;/td&gt;
