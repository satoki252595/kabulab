&lt;p style="margin-left: 24px; text-align: left"&gt; &lt;/p&gt;
&lt;div style="margin-left: 24px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 620.00000000000000000000000001px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 206.66666666666666666666666667px"/&gt;
&lt;col style="width: 206.66666666666666666666666667px"/&gt;
&lt;col style="width: 206.66666666666666666666666667px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr style="height: 26.67px"&gt;
&lt;td style="vertical-align: middle; width: 206.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 18px; text-align: justify; text-justify: inter-ideograph"&gt;第130期&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 206.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: center"&gt;自　2023年９月１日&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 206.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: justify; text-justify: inter-ideograph"&gt;2024年１月10日&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 26.67px"&gt;
&lt;td style="vertical-align: middle; width: 206.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 18px; text-align: justify; text-justify: inter-ideograph"&gt;第３四半期&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 206.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: center"&gt;至　2023年11月30日&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 206.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: justify; text-justify: inter-ideograph"&gt;関東財務局長に提出&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;/div&gt;
&lt;p style="margin-left: 24px; text-align: left"&gt; &lt;/p&gt;
&lt;p style="margin-left: 24px; text-align: justify; text-justify: inter-ideograph"&gt;（4）臨時報告書&lt;/p&gt;
&lt;div style="margin-left: 24px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 620px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 413.33333333333333333333333333px"/&gt;
&lt;col style="width: 206.66666666666666666666666667px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr style="height: 33.33px"&gt;
&lt;td style="vertical-align: middle; width: 413.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 18px; margin-right: 24px; text-align: justify; text-justify: inter-ideograph"&gt;企業内容等の開示に関する内閣府令第19条第２項第９号の２（株主総会における議決権の行使の結果）の規定に基づく臨時報告書であります。&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 206.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 6px; margin-right: 24px; text-align: justify; text-justify: inter-ideograph"&gt; &lt;/p&gt;
&lt;p style="line-height: 6px; margin-right: 24px; text-align: justify; text-justify: inter-ideograph"&gt; &lt;/p&gt;
&lt;p style="margin-right: 24px; text-align: justify; text-justify: inter-ideograph"&gt;2023年６月１日&lt;/p&gt;
&lt;p style="margin-right: 24px; text-align: justify; text-justify: inter-ideograph"&gt;関東財務局長に提出&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;/div&gt;
&lt;p style="text-align: left"&gt; &lt;/p&gt;
&lt;p style="margin-left: 24px; text-align: justify; text-justify: inter-ideograph"&gt;（5）臨時報告書の訂正報告書&lt;/p&gt;
&lt;div style="margin-left: 24px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 620px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 413.33333333333333333333333333px"/&gt;
&lt;col style="width: 206.66666666666666666666666667px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr style="height: 33.33px"&gt;
&lt;td style="vertical-align: middle; width: 413.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 18px; margin-right: 24px; text-align: justify; text-justify: inter-ideograph"&gt;2023年６月１日提出の臨時報告書（株主総会における議決権の行使の結果）に係る訂正報告書であります。&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 206.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 6px; margin-right: 24px; text-align: justify; text-justify: inter-ideograph"&gt; &lt;/p&gt;
&lt;p style="line-height: 6px; margin-right: 24px; text-align: justify; text-justify: inter-ideograph"&gt; &lt;/p&gt;
&lt;p style="margin-right: 24px; text-align: justify; text-justify: inter-ideograph"&gt;2023年７月19日&lt;/p&gt;
&lt;p style="margin-right: 24px; text-align: justify; text-justify: inter-ideograph"&gt;関東財務局長に提出&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;/div&gt;
&lt;p style="text-align: left"&gt; &lt;/p&gt;
</jpcrp_cor:OtherReferenceInformationTextBlock>
