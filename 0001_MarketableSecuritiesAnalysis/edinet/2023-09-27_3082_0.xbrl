&lt;tbody&gt;
&lt;tr style="height: 19px"&gt;
&lt;td style="vertical-align: top; width: 85.86666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 12px; margin-right: 12px; text-align: left"&gt;1998年７月&lt;/p&gt;
