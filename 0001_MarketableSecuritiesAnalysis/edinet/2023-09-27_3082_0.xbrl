&lt;p style="margin-left: 6px; line-height: 16.666666666666666666666666667px; margin-right: 6px; text-align: left"&gt;対象勤務期間&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 220px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 12px; line-height: 16.666666666666666666666666667px; margin-right: 6px; text-align: center; text-indent: -6px"&gt;－&lt;/p&gt;
