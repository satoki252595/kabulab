&lt;tr style="height: 17.33px"&gt;
&lt;td style="vertical-align: middle; width: 85.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; line-height: 20px; margin-right: 6px; text-align: center"&gt;1999年４月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 561.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; line-height: 20px; margin-right: 6px; text-align: left"&gt;日本証券業協会に株式を店頭登録。&lt;/p&gt;
