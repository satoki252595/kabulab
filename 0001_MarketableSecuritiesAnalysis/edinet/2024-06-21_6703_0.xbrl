&lt;/tr&gt;
&lt;tr style="height: 37px"&gt;
&lt;td style="vertical-align: top; width: 50px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; text-align: left"&gt;1949年&lt;/p&gt;
