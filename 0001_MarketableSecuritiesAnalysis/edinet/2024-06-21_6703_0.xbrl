&lt;tbody&gt;
&lt;tr style="height: 19px"&gt;
&lt;td style="vertical-align: top; width: 50px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
