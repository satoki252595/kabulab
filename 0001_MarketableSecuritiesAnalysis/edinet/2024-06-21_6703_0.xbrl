&lt;p style="margin-left: 6px; text-align: left"&gt;1907年&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 38px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-right: 12px; text-align: right"&gt;５月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 556.86666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
