  <jpcrp_cor:FootnotesDirectorsAndCorporateAuditorsTextBlock contextRef="FilingDateInstant_Row2Member">２．2021年６月から４年</jpcrp_cor:FootnotesDirectorsAndCorporateAuditorsTextBlock>
  <jpcrp_cor:FootnotesDirectorsAndCorporateAuditorsTextBlock contextRef="FilingDateInstant_Row3Member">３．2023年６月から４年</jpcrp_cor:FootnotesDirectorsAndCorporateAuditorsTextBlock>
