&lt;tr&gt;
&lt;td style="border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none ; width: 104px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: justify; line-height: 1; text-justify: inter-ideograph"&gt;
&lt;span style="font-size: 14px"&gt; &lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td colspan="2" style="border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none ; width: 296px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: right; line-height: 1"&gt;
&lt;span style="font-family: &amp;apos;ＭＳ Ｐゴシック&amp;apos;"&gt;2023年度　単体&lt;/span&gt;
&lt;/p&gt;
