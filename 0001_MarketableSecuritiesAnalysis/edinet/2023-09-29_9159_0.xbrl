&lt;td style="vertical-align: middle; width: 173.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 1.8666666666666666666666666667px; padding-right: 1.8666666666666666666666666667px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="line-height: 16px; margin-right: 6px; text-align: justify; text-justify: inter-ideograph"&gt;（２）リース債務　(※１)&lt;/p&gt;
&lt;/td&gt;
