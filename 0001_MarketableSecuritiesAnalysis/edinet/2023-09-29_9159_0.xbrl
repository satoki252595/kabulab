&lt;tr style="height: 22.2px"&gt;
&lt;td colspan="5" style="vertical-align: top; width: 460.4px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: center"&gt;既発行株式数　＋　新規発行株式数&lt;/p&gt;
&lt;/td&gt;
