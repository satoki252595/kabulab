&lt;td style="vertical-align:top;border-top-color:#a9a9a9;border-bottom-color:#a9a9a9;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-color:#a9a9a9;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:3.3pt;padding-right:3.3pt;line-height:9pt;"&gt;&lt;span style="font-size:7.5pt;"&gt;当社エナジー事業本部副事業本部長&lt;/span&gt;&lt;/p&gt;
