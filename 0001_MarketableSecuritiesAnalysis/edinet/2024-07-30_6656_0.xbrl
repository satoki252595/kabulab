&lt;tr style="height: 24px"&gt;
&lt;td style="vertical-align: top; width: 101.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="line-height: 16px; text-align: left; text-indent: 12px"&gt;2011年８月&lt;/p&gt;
