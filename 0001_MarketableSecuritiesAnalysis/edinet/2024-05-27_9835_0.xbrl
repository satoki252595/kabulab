&lt;p style="text-align: left"&gt;(1）&lt;/p&gt;
&lt;p style="text-align: left"&gt; &lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 122px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: left"&gt;有価証券報告書&lt;/p&gt;
&lt;p style="text-align: left"&gt;及びその添付書類&lt;/p&gt;
&lt;p style="text-align: left"&gt;並びに確認書&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 114.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
