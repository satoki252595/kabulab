&lt;col style="width:52.5pt;min-width:52.5pt;"/&gt;
&lt;col style="width:94pt;min-width:94pt;"/&gt;
&lt;col style="width:52.5pt;min-width:52.5pt;"/&gt;
&lt;/colgroup&gt;
