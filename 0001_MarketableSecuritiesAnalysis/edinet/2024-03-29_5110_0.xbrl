&lt;td style="vertical-align: top; width: 560px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; line-height: 16.666666666666666666666666667px; margin-right: 6px; text-align: left"&gt;東京証券取引所の市場区分の見直しにより、東京証券取引所の市場第一部からプライム市場に移行&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 18px"&gt;
&lt;td style="vertical-align: top; width: 88px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 16.666666666666666666666666667px; text-align: center"&gt;2024年１月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 560px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; line-height: 16.666666666666666666666666667px; margin-right: 6px; text-align: left"&gt;スイスのLonstroff AGを売却&lt;/p&gt;
&lt;/td&gt;
