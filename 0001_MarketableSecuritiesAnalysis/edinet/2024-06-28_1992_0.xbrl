&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-color:#a9a9a9;border-bottom-color:#a9a9a9;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;text-justify:inter-ideograph;text-indent:9pt;line-height:10pt;"&gt;決算期を９月30日から３月31日に変更。&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
