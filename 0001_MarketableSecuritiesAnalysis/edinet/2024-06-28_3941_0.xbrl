  <jpcrp_cor:AnnexedConsolidatedDetailedScheduleOfCorporateBondsTextBlock contextRef="CurrentYearDuration">
&lt;h6 class="smt_head5" style="padding-left:31.5pt;line-height:18pt;font-size:10.5pt;"&gt;【社債明細表】&lt;/h6&gt;&lt;p class="smt_unitR" style="orphans:0;widows:0;"&gt; &lt;/p&gt;
