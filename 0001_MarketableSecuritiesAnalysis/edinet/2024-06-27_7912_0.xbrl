  <jpcrp_cor:NotesRegardingTradeNotesReceivableDiscountedOrTransferredByEndorsementTextBlock contextRef="CurrentYearInstant_NonConsolidatedMember">&lt;p class="smt_text2" style="orphans:0;widows:0;padding-left:18pt;line-height:13pt;"&gt;２．受取手形割引高&lt;/p&gt;
