&lt;col style="width:207pt;min-width:207pt;"/&gt;
&lt;col style="width:26.3pt;min-width:26.3pt;"/&gt;
&lt;col style="width:39.8pt;min-width:39.8pt;"/&gt;
&lt;/colgroup&gt;
