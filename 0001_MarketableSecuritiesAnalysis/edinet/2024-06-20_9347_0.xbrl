&lt;col style="width:50.5pt;min-width:50.5pt;"/&gt;
&lt;col style="width:55.5pt;min-width:55.5pt;"/&gt;
&lt;col style="width:50.5pt;min-width:50.5pt;"/&gt;
&lt;col style="width:50.5pt;min-width:50.5pt;"/&gt;
&lt;col style="width:50.5pt;min-width:50.5pt;"/&gt;
&lt;col style="width:50.5pt;min-width:50.5pt;"/&gt;
