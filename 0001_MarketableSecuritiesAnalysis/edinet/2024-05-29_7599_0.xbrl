  <jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock contextRef="FilingDateInstant_jpcrp030000-asr_E02892-000HatoriYusukeMember">
&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 265.33333333333333333333333333px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 60px"/&gt;
&lt;col style="width: 205.33333333333333333333333333px"/&gt;
&lt;/colgroup&gt;
