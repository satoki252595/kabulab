&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 472px; padding-top: 2.6666666666666666666666666667px; padding-bottom: 2.6666666666666666666666666667px; padding-left: 2.6666666666666666666666666667px; padding-right: 2.6666666666666666666666666667px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #666666"&gt;
