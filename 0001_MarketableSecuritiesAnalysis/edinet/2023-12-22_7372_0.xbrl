&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 95.46666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 15px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;1959年３月19日&lt;/span&gt;&lt;span style="font-size: 10px"&gt;生&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 234.53333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;

&lt;p style="margin-left: 60px; line-height: 15px; margin-right: 3px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;1983年４月 住友海上火災保険株式会社（現三井住友海上火災保険株式会社）　入社&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; line-height: 15px; margin-right: 3px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;1989年１月 ゴールドマン・サックス証券会社東京支店　入社&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; line-height: 15px; margin-right: 3px; text-align: left; text-indent: -55px"&gt;
