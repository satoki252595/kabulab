&lt;colgroup&gt;
&lt;col style="width: 143.33333333333333333333333333px"/&gt;
&lt;col style="width: 219.33333333333333333333333333px"/&gt;
&lt;col style="width: 219.33333333333333333333333333px"/&gt;
&lt;/colgroup&gt;
