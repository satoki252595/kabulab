&lt;td style="vertical-align: middle; width: 242.53333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;

&lt;p style="margin-left: 60px; line-height: 14.666666666666666666666666667px; margin-right: 3px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;1990年４月 株式会社三和銀行（現株式会社三菱UFJ銀行）入行&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; line-height: 14.666666666666666666666666667px; margin-right: 3px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;2000年４月 タリーズコーヒージャパン株式会社入社　経営企画室長&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; line-height: 14.666666666666666666666666667px; margin-right: 3px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;2002年４月 同社執行役員経営企画部長&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; line-height: 14.666666666666666666666666667px; margin-right: 3px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;2007年３月 東京美装興業株式会社入社　経営企画部副部長&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; line-height: 14.666666666666666666666666667px; margin-right: 3px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;2009年４月 同社執行役員経営企画部長&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; line-height: 14.666666666666666666666666667px; margin-right: 3px; text-align: left; text-indent: -55px"&gt;
