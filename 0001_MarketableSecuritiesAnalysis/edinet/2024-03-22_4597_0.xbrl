&lt;img alt="0101010_005.png" src="images/0101010_005.png" style="height: 161.04px; width: 162.29px"/&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: bottom; width: 153.93333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 1; text-align: left"&gt;
&lt;img alt="0101010_006.png" src="images/0101010_006.png" style="height: 150.78px; width: 151.95px"/&gt;
&lt;/p&gt;
