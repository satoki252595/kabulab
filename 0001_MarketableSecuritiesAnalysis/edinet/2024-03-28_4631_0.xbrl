  <jpcrp_cor:OfficialTitleOrPositionInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E00901-000KeikoKishigamiMember">監査役</jpcrp_cor:OfficialTitleOrPositionInformationAboutDirectorsAndCorporateAuditors>
