&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 331.66666666666666666666666667px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 86px"/&gt;
&lt;col style="width: 13px"/&gt;
&lt;col style="width: 86px"/&gt;
