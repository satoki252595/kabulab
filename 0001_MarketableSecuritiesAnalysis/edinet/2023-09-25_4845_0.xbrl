&lt;td style="vertical-align: middle; width: 83.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: right"&gt;［72］&lt;/p&gt;
&lt;/td&gt;
