&lt;colgroup&gt;
&lt;col style="width:104pt;min-width:104pt;"/&gt;
&lt;col style="width:55pt;min-width:55pt;"/&gt;
&lt;col style="width:55pt;min-width:55pt;"/&gt;
&lt;col style="width:104pt;min-width:104pt;"/&gt;
