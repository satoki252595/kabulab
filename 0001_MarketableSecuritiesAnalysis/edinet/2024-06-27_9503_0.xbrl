&lt;/colgroup&gt;
&lt;tr style="height:35.3pt;min-height:35.3pt;"&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:1pt;padding-right:1pt;margin-top:0pt;margin-bottom:0pt;letter-spacing:0pt;line-height:10pt;font-size:10.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;分類&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:1.5pt;padding-right:1.5pt;margin-top:0pt;margin-bottom:0pt;letter-spacing:0pt;line-height:10pt;font-size:10.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;指標&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
