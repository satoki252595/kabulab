&lt;col style="width:184pt;min-width:184pt;"/&gt;
&lt;col style="width:125pt;min-width:125pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:35.3pt;min-height:35.3pt;"&gt;
