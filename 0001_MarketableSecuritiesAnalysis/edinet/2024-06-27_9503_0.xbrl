&lt;col style="width:124pt;min-width:124pt;"/&gt;
&lt;col style="width:24pt;min-width:24pt;"/&gt;
&lt;col style="width:24pt;min-width:24pt;"/&gt;
&lt;col style="width:24pt;min-width:24pt;"/&gt;
&lt;col style="width:3pt;min-width:3pt;"/&gt;
&lt;col style="width:43pt;min-width:43pt;"/&gt;
&lt;col style="width:124pt;min-width:124pt;"/&gt;
