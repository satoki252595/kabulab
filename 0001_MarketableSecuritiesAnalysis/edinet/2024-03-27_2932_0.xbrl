  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E35947-000JyumiYutakaMember">1953-09-25</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
