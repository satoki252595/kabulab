  <jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E33109-000TakayaEiichiMember">高谷　英一</jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E33109-000TakayaEiichiMember">1948-05-04</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
