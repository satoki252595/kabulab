&lt;td style="vertical-align: middle; width: 216.53333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; line-height: 16.666666666666666666666666667px; text-align: left"&gt;2020年5月22日から2050年5月21日まで&lt;/p&gt;
&lt;/td&gt;
