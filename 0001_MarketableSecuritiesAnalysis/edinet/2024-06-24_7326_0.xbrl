  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E33840-000OtobeTatsuyoshiMember">1958-04-21</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
