&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none #000000; border-bottom: 1px solid #000000; width: 176px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
