&lt;/table&gt;&lt;p style="clear:both; line-height:0.75pt; width:100%; font-size:0.75pt;"&gt; &lt;/p&gt;
&lt;/div&gt;
&lt;h5 class="smt_head4" style="padding-left:36pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;text-align:justify;line-height:15pt;font-size:15pt;"&gt; &lt;/h5&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:36pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;font-size:9pt;"&gt;④人的資本投資&lt;/p&gt;
&lt;div class="tbld" style="margin-left:36pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:430pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
&lt;col style="width:200pt;min-width:200pt;"/&gt;
