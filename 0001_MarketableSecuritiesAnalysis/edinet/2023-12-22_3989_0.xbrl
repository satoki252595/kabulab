  <jpcrp_cor:PlannedAdditionsRetirementsEtcOfFacilitiesTextBlock contextRef="FilingDateInstant">
&lt;h3 class="smt_head2"&gt;3【設備の新設、除却等の計画】&lt;/h3&gt;
&lt;h4 class="smt_head3" style="padding-left:9pt;line-height:15pt;"&gt;（1）重要な設備の新設等&lt;/h4&gt;&lt;p class="smt_text4" style="orphans:0;widows:0;"&gt;該当事項はありません。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:0pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:14pt;font-size:14pt;"&gt; &lt;/p&gt;
&lt;h4 class="smt_head3" style="padding-left:9pt;line-height:15pt;"&gt;（2）重要な設備の除却等&lt;/h4&gt;&lt;p class="smt_text4" style="orphans:0;widows:0;"&gt;該当事項はありません。&lt;/p&gt;&lt;p class="smt_anno1" style="orphans:0;widows:0;text-align:left;padding-left:36pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:-27pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:12pt;font-size:12pt;"&gt; &lt;/p&gt;</jpcrp_cor:PlannedAdditionsRetirementsEtcOfFacilitiesTextBlock>
  <jpcrp_cor:TotalNumberOfSharesTextBlock contextRef="FilingDateInstant">
