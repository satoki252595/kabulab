&lt;col style="width: 116px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr style="height: 18.67px"&gt;
&lt;td style="vertical-align: middle; width: 324.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: left"&gt;退職給付に係る負債の期首残高&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 116px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: right"&gt;74百万円&lt;/p&gt;
