&lt;colgroup&gt;
&lt;col style="width: 117.46666666666666666666666667px"/&gt;
&lt;col style="width: 488px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr style="height: 26.87px"&gt;
