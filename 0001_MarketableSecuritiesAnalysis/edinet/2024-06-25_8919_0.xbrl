&lt;p style="text-align: right"&gt;（単位：百万円）&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;/div&gt;
&lt;p style="margin-left: 60px; line-height: 1.3333333333333333333333333333px; text-align: left"&gt; &lt;/p&gt;
&lt;div style="margin-left: 60px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 536.99999999999999999999999999px"&gt;
&lt;colgroup&gt;
