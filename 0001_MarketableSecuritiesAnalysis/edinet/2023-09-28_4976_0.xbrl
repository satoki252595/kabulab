&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:41pt;min-height:41pt;"&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;"&gt;本　社&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;"&gt;(東京都世田谷区)&lt;/p&gt;
&lt;/td&gt;
