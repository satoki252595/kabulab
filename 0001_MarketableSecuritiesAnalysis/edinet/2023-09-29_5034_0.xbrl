&lt;td style="vertical-align:middle;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;font-size:7.5pt;"&gt;内閣サイバーセキュリティセンター&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;font-size:7.5pt;"&gt;サイバーセキュリティ関連法令の調査検討等を目的としたサブワーキンググループ　入職&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:9.8pt;min-height:9.8pt;"&gt;
&lt;td style="vertical-align:top;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;font-size:7.5pt;"&gt;2020年４月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:top;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;font-size:7.5pt;"&gt;当社　監査役(現任)&lt;/p&gt;
&lt;/td&gt;
