&lt;tr style="height: 1.33px"&gt;
&lt;td style="vertical-align: top; width: 56px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;2003年６月&lt;/span&gt;
&lt;/p&gt;
