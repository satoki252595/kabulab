&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 67px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 3px double #000000"&gt;
&lt;p style="margin-right: 6px; text-align: right"&gt;1,151,316&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 3px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: justify; text-justify: inter-ideograph"&gt;
