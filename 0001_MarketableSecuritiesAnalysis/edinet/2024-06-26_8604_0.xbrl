&lt;p style="margin-left: 0px; line-height: 12px; margin-right: 0px; margin-bottom: 0px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;金融商品&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 50px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 0px; line-height: 12px; margin-right: 0px; margin-bottom: 0px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;公正価値&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 0px; line-height: 12px; margin-right: 0px; margin-bottom: 0px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;（十億円）&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 67px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 0px; line-height: 12px; margin-right: 0px; margin-bottom: 0px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;評価手法&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 83px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 0px; line-height: 12px; margin-right: 0px; margin-bottom: 0px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;有意な&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 0px; line-height: 12px; margin-right: 0px; margin-bottom: 0px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;観察不能データ&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
