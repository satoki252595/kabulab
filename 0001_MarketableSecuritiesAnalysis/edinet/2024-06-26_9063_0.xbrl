&lt;td style="vertical-align: middle; width: 174px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 12px; margin-right: 12px; text-align: left"&gt;役員退職慰労引当金&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 117.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 6px; text-align: right"&gt;107,300&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 117.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 6px; text-align: right"&gt;19,100&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 117.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 6px; text-align: right"&gt;26,600&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 117.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 6px; text-align: right"&gt;99,800&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;/div&gt;
&lt;p style="margin-left: 72px; text-align: left; text-indent: -72px"&gt;　（注）引当金の計上基準は会計方針に記載している。&lt;/p&gt;
&lt;p style="margin-left: 72px; text-align: left; text-indent: -72px"&gt; &lt;/p&gt;
&lt;p style="margin-left: 72px; text-align: left; text-indent: -72px"&gt; &lt;/p&gt;
