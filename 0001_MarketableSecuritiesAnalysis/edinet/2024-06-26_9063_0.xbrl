  <jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E04195-000UmayaharaAkiraMember">馬屋原　章</jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E04195-000UmayaharaAkiraMember">1951-10-02</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
