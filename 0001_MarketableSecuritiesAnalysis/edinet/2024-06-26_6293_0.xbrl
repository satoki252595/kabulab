&lt;td style="vertical-align: top; width: 645px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 15px; text-align: right"&gt;（2024年３月31日現在）&lt;/p&gt;
&lt;/td&gt;
