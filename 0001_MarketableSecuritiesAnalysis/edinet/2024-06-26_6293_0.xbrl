&lt;td style="vertical-align: middle; width: 144px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: left"&gt;事業年度　第67期&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 312px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: left"&gt;（自　2022年４月１日　至　2023年３月31日）&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 144px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: left"&gt;2023年６月23日&lt;/p&gt;
&lt;p style="text-align: left"&gt;関東財務局長に提出&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;/div&gt;
&lt;p style="margin-left: 36px; text-align: left; text-indent: -12px"&gt;(2) 内部統制報告書&lt;/p&gt;
&lt;p style="margin-left: 36px; text-align: left"&gt;　2023年６月23日関東財務局長に提出&lt;/p&gt;
&lt;p style="margin-left: 36px; text-align: left; text-indent: -12px"&gt;(3) 四半期報告書及び確認書&lt;/p&gt;
&lt;div style="margin-left: 48px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 600px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 144px"/&gt;
