&lt;col style="width: 61.333333333333333333333333333px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr&gt;
&lt;td rowspan="2" style="border-left: 0px none #000000; border-top: 0px none #000000; border-right: 0px none #000000; border-bottom: 0px none #000000; width: 61.333333333333333333333333333px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px; background-color: #FFFFFF"&gt;
&lt;p style="margin-left: 12px; margin-right: 0px; text-align: left"&gt;達成率&lt;/p&gt;
&lt;/td&gt;
&lt;td rowspan="2" style="border-left: 0px none #000000; border-top: 0px none #000000; border-right: 0px none #000000; border-bottom: 0px none #000000; width: 48px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px; background-color: #FFFFFF"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center"&gt;＝ (&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 0px none #000000; border-top: 0px none #000000; border-right: 0px none #000000; border-bottom: 1px solid #000000; width: 248px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px; background-color: #FFFFFF"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center; line-height: 13.333333333333333333333333333px"&gt;業績判定期間の翌年５月までに&lt;/p&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center; line-height: 13.333333333333333333333333333px"&gt;対外公表する対象期の業績数値&lt;/p&gt;
&lt;/td&gt;
&lt;td rowspan="2" style="border-left: 0px none #000000; border-top: 0px none #000000; border-right: 0px none #000000; border-bottom: 0px none #000000; width: 26.666666666666666666666666667px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px; background-color: #FFFFFF"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center"&gt;－&lt;/p&gt;
&lt;/td&gt;
&lt;td rowspan="2" style="border-left: 0px none #000000; border-top: 0px none #000000; border-right: 0px none #000000; border-bottom: 0px none #000000; width: 48px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px; background-color: #FFFFFF"&gt;
&lt;p style="margin-left: 6px; margin-right: 0px; text-align: center"&gt;Ｘ )&lt;/p&gt;
&lt;/td&gt;
&lt;td rowspan="2" style="border-left: 0px none #000000; border-top: 0px none #000000; border-right: 0px none #000000; border-bottom: 0px none #000000; width: 26.666666666666666666666666667px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px; background-color: #FFFFFF"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center"&gt;×&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 0px none #000000; border-top: 0px none #000000; border-right: 0px none #000000; border-bottom: 1px solid #000000; width: 61.333333333333333333333333333px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px; background-color: #FFFFFF"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center"&gt;１&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td style="border-left: 0px none #000000; border-top: 1px solid #000000; border-right: 0px none #000000; border-bottom: 0px none #000000; width: 248px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px; background-color: #FFFFFF"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center; line-height: 13.333333333333333333333333333px"&gt;業績判定期間の５月までに&lt;/p&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center; line-height: 13.333333333333333333333333333px"&gt;対外公表する通期業績予想数値&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 0px none #000000; border-top: 1px solid #000000; border-right: 0px none #000000; border-bottom: 0px none #000000; width: 61.333333333333333333333333333px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px; background-color: #FFFFFF"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center"&gt;Ｙ－Ｘ&lt;/p&gt;
&lt;/td&gt;
