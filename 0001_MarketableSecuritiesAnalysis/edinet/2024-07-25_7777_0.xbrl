&lt;col style="width:18pt;min-width:18pt;"/&gt;
&lt;col style="width:72pt;min-width:72pt;"/&gt;
&lt;col style="width:18pt;min-width:18pt;"/&gt;
&lt;col style="width:90pt;min-width:90pt;"/&gt;
&lt;col style="width:18pt;min-width:18pt;"/&gt;
&lt;col style="width:99pt;min-width:99pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:13.5pt;min-height:13.5pt;"&gt;
&lt;td rowspan="3" style="vertical-align:middle;border-top-color:#a9a9a9;border-bottom-color:#a9a9a9;border-left-color:#a9a9a9;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;text-align:left;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:12pt;"&gt;調整後&lt;br/&gt;行使価額&lt;/p&gt;
&lt;/td&gt;
