&lt;tr style="height: 16.67px"&gt;
&lt;td style="vertical-align: middle; width: 93.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 12px; line-height: 15.333333333333333333333333333px; margin-right: 6px; text-align: left"&gt;社外監査役&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 93.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 12px; line-height: 15.333333333333333333333333333px; margin-right: 6px; text-align: left"&gt;木﨑　孝&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 70.666666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; line-height: 15.333333333333333333333333333px; margin-right: 6px; text-align: left"&gt;19回&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 70.133333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; line-height: 15.333333333333333333333333333px; margin-right: 6px; text-align: left"&gt;19回&lt;/p&gt;
