&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:right;line-height:9pt;font-size:10.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;360,486千円&lt;/span&gt;&lt;/p&gt;
