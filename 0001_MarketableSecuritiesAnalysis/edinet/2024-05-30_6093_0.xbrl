&lt;col style="width: 52px"/&gt;
&lt;col style="width: 48.666666666666666666666666667px"/&gt;
&lt;col style="width: 48.666666666666666666666666667px"/&gt;
&lt;col style="width: 48.666666666666666666666666667px"/&gt;
&lt;col style="width: 50.666666666666666666666666667px"/&gt;
&lt;col style="width: 49.333333333333333333333333333px"/&gt;
&lt;/colgroup&gt;
&lt;thead&gt;
&lt;tr style="height: 20px"&gt;
&lt;td rowspan="2" style="vertical-align: middle; width: 122.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 15px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;事業所名&lt;/span&gt;
