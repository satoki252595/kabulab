  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E36130-000SuzukiYukiMember">1979-10-01</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
