&lt;p style="line-height: 1.3333333333333333333333333333px; text-align: left"&gt; &lt;/p&gt;
&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 648.06666666666666666666666665px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 132px"/&gt;
