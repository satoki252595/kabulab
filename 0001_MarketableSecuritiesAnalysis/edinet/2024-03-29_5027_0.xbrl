&lt;col style="width:63pt;min-width:63pt;"/&gt;
&lt;col style="width:63pt;min-width:63pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:35pt;min-height:35pt;"&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;line-height:10pt;"&gt;&lt;span style="font-size:9pt;"&gt;年月日&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;line-height:10pt;"&gt;&lt;span style="font-size:9pt;"&gt;発行済株式&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:9pt;"&gt;総数増減数&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:9pt;"&gt;(株)&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;line-height:10pt;"&gt;&lt;span style="font-size:9pt;"&gt;発行済株式&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:9pt;"&gt;総数残高&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:9pt;"&gt;(株)&lt;/span&gt;&lt;/p&gt;
