  <jpcrp_cor:StatementOfChangesInEquityTextBlock contextRef="CurrentYearDuration">
&lt;h4 class="smt_head4"&gt;③ 【株主資本等変動計算書】&lt;/h4&gt;&lt;p class="smt_text3" style="orphans:0;widows:0;"&gt;前事業年度(自　2022年１月１日　至　2022年12月31日）&lt;/p&gt;
&lt;div class="tbld" style="margin-left:0pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:402.9pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
&lt;col style="width:100.5pt;min-width:100.5pt;"/&gt;
