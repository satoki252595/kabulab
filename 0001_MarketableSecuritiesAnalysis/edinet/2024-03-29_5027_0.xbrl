&lt;/td&gt;
&lt;td style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblR" style="orphans:0;widows:0;"&gt;2,239&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
