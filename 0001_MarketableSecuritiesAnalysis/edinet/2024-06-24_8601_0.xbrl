  <jpcrp_cor:IssuedSharesTotalNumberOfSharesEtcTextBlock contextRef="FilingDateInstant">
&lt;h5&gt;②【発行済株式】&lt;/h5&gt;
&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 648.00000000000000000000000001px"&gt;
&lt;colgroup&gt;
