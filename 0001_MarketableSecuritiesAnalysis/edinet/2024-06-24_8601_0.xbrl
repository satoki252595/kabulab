&lt;p style="text-align: left"&gt; &lt;/p&gt;
&lt;p style="margin-left: 54px; text-align: justify; text-justify: inter-ideograph"&gt;当連結会計年度（自　2023年４月１日　至　2024年３月31日）&lt;/p&gt;
&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 645px; margin-left: auto; margin-right: auto"&gt;
&lt;colgroup&gt;
&lt;col style="width: 215px"/&gt;
&lt;col style="width: 215px"/&gt;
&lt;col style="width: 215px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr style="height: 15px"&gt;
&lt;td style="vertical-align: middle; width: 215px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: right"&gt;
&lt;span style="font-size: 12px"&gt; &lt;/span&gt;
