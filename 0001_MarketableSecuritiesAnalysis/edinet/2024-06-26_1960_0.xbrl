&lt;p style="text-align: center"&gt;
&lt;span style="font-size: 12px"&gt; &lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 153px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt;2022年３月期&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 153px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt;2023年３月期&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 153px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt;2024年３月期&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td style="vertical-align: top; width: 81.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt;連結&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 153px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt;14.2％&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 153px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt;15.0％&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 153px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt;
16.6％
&lt;/p&gt;
&lt;/td&gt;
