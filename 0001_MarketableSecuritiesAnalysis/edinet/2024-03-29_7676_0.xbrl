&lt;p style="margin-left: 6px; line-height: 8.333333333333333333333333333px; margin-right: 6px; text-align: center"&gt;
&lt;span style="font-size: 12px"&gt; &lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
