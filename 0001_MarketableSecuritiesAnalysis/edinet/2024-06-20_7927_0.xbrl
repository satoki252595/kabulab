  <jpcrp_cor:PropertyPlantAndEquipmentInformationForEachRegionTextBlock contextRef="Prior1YearDuration">&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:18pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;"&gt;(2) 有形固定資産&lt;/p&gt;&lt;p class="smt_unitR" style="orphans:0;widows:0;text-align:right;padding-left:0pt;padding-right:15pt;"&gt;(単位：千円)&lt;/p&gt;
&lt;div class="tbld" style="margin-left:0pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
