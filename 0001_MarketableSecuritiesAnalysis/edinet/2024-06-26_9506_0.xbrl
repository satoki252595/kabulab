  <jpcrp_cor:InformationAboutParentCompanyEtcOfReportingCompanyTextBlock contextRef="FilingDateInstant">
&lt;h3 class="smt_head2" style="font-family:&amp;apos;ＭＳ ゴシック&amp;apos;;"&gt;１ 【提出会社の親会社等の情報】&lt;/h3&gt;&lt;p class="smt_text1" style="orphans:0;widows:0;padding-left:13.5pt;text-indent:0pt;"&gt;当社は、親会社等はありません。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;"&gt; &lt;/p&gt;</jpcrp_cor:InformationAboutParentCompanyEtcOfReportingCompanyTextBlock>
  <jpcrp_cor:OtherReferenceInformationTextBlock contextRef="FilingDateInstant">
