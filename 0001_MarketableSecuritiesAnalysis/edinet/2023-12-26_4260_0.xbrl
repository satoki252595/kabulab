&lt;/div&gt;
&lt;p style="line-height: 1.3333333333333333333333333333px; text-align: right"&gt; &lt;/p&gt;
&lt;div style="margin-left: 95.46666666666666666666666667px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 554.8px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 264px"/&gt;
