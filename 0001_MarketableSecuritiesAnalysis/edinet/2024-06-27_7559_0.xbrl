&lt;p style="margin-left: 12px; text-align: left"&gt;※１　関係会社との取引高&lt;/p&gt;
&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 647.99999999999999999999999999px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 241.33333333333333333333333333px"/&gt;
&lt;col style="width: 203.33333333333333333333333333px"/&gt;
&lt;col style="width: 203.33333333333333333333333333px"/&gt;
&lt;/colgroup&gt;
&lt;thead&gt;
&lt;tr style="height: 53.33px"&gt;
&lt;td style="vertical-align: middle; width: 241.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;
&lt;span style="font-size: 12px"&gt; &lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 203.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;前事業年度&lt;/p&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; margin-right: 12px; text-align: center"&gt;（自　2022年４月１日&lt;/p&gt;
&lt;p style="margin-left: 12px; line-height: 13.333333333333333333333333333px; text-align: center"&gt;至　2023年３月31日）&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 203.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;当事業年度&lt;/p&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; margin-right: 12px; text-align: center"&gt;（自　2023年４月１日&lt;/p&gt;
&lt;p style="margin-left: 12px; line-height: 13.333333333333333333333333333px; text-align: center"&gt;至　2024年３月31日）&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/thead&gt;
&lt;tbody&gt;
&lt;tr style="height: 18px"&gt;
&lt;td style="vertical-align: top; width: 241.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: left"&gt;営業取引による取引高&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 203.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
