  <jpcrp_cor:NotesRegardingNewShareSubscriptionRightsEtcTextBlock contextRef="Prior1YearDuration">&lt;p class="smt_text6" style="orphans:0;widows:0;line-height:18pt;"&gt;３  新株予約権等に関する事項&lt;/p&gt;&lt;p class="smt_text4" style="orphans:0;widows:0;padding-left:9pt;line-height:18pt;"&gt;該当事項はありません。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;line-height:18pt;"&gt;　&lt;/p&gt;</jpcrp_cor:NotesRegardingNewShareSubscriptionRightsEtcTextBlock>
