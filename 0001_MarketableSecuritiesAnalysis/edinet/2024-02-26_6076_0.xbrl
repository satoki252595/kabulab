  <jpcrp_cor:MajorShareholdersTextBlock contextRef="FilingDateInstant">
&lt;h4 class="smt_head3"&gt;（６）【大株主の状況】&lt;/h4&gt;&lt;p class="smt_unitR" style="orphans:0;widows:0;padding-left:368.3pt;line-height:10pt;"&gt;&lt;span&gt;令和５年11月30日&lt;/span&gt;現在&lt;/p&gt;
&lt;div class="tbld" style="margin-left:0.3pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:478.7pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
