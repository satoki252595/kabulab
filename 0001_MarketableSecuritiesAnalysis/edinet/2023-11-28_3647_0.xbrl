&lt;td style="vertical-align: top; width: 74px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 5px; line-height: 13px; margin-right: 5px; text-align: justify; text-justify: inter-ideograph"&gt;
