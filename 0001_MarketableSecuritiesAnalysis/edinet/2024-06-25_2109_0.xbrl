  <jpcrp_cor:ClassesOfSharesEtcTextBlock contextRef="FilingDateInstant">
&lt;p style="margin-left: 120px; text-align: left; text-indent: -96px"&gt;【株式の種類等】&lt;/p&gt;
&lt;p style="margin-left: 126px; text-align: left; text-indent: -96px"&gt;会社法第155条第７号に該当する普通株式の取得&lt;/p&gt;
