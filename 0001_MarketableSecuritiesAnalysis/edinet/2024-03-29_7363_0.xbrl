&lt;colgroup&gt;
&lt;col style="width: 87.33333333333333333333333333px"/&gt;
&lt;col style="width: 95.33333333333333333333333333px"/&gt;
&lt;col style="width: 96px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr&gt;
&lt;td style="vertical-align: middle; width: 87.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.6666666666666666666666666667px; padding-right: 7.6666666666666666666666666667px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt;
&lt;span style="font-size: 12px"&gt; &lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 95.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.6666666666666666666666666667px; padding-right: 7.6666666666666666666666666667px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt;男性&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 96px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.6666666666666666666666666667px; padding-right: 7.6666666666666666666666666667px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt;女性&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
