  <jpcrp_cor:ClassIssuedSharesTotalNumberOfSharesEtc contextRef="FilingDateInstant_ClassASharesMember">Ａ種種類株式</jpcrp_cor:ClassIssuedSharesTotalNumberOfSharesEtc>
