  <jpcrp_cor:CompanyHistoryTextBlock contextRef="FilingDateInstant">
&lt;h3&gt;２【沿革】&lt;/h3&gt;
&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 646.66666666666666666666666666px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 113.33333333333333333333333333px"/&gt;
&lt;col style="width: 533.33333333333333333333333333px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr&gt;
&lt;td style="vertical-align: top; width: 113.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-right: 12px; text-align: right"&gt;2008年６月７日&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 533.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 12px; text-align: left"&gt;大塚製薬㈱の取締役会において、株式移転による当社設立を決議し、株式移転計画を作成&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td style="vertical-align: top; width: 113.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-right: 12px; text-align: right"&gt;2008年６月25日&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 533.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 12px; text-align: left"&gt;大塚製薬㈱の定時株主総会において、株式移転による当社設立を承認&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td style="vertical-align: top; width: 113.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-right: 12px; text-align: right"&gt;2008年７月８日&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 533.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 12px; text-align: left"&gt;株式移転により当社設立&lt;/p&gt;
&lt;/td&gt;
