&lt;/td&gt;
&lt;td rowspan="8" style="vertical-align: top; width: 122.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; margin-right: 36px; text-align: justify; text-justify: inter-ideograph"&gt;
