  <jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E00030-000MoriShunichiroMember">森　俊一郎</jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors>
