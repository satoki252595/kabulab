  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E32679-000OgamiTomokoMember">1965-09-08</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
