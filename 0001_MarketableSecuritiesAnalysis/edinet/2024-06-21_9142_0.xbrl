  <jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock contextRef="FilingDateInstant_jpcrp030000-asr_E32679-000AoyagiToshihikoMember">
&lt;p style="margin-left: 65px; line-height: 15px; margin-right: 5px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;1977年４月　日本国有鉄道に入る&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 15px; margin-right: 5px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;1987年４月　当社入社&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 15px; margin-right: 5px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;1998年６月　同　技術・運行本部運輸部長&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 15px; margin-right: 5px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;2001年４月　同　鉄道事業本部運輸部長&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 15px; margin-right: 5px; text-align: left; text-indent: -60px"&gt;
