&lt;p style="line-height: 1; text-align: center"&gt;取        締        役&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 108.6px; padding-top: 0px; padding-bottom: 0px; padding-left: 6.6px; padding-right: 6.6px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
