&lt;td style="vertical-align: top; width: 225px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;

&lt;p style="margin-left: 60px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;1982年４月 名古屋国税局入局&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;2015年７月 大垣税務署　署長&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;2016年７月 名古屋国税局　調査部　調査開発課長&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;2017年７月 同　総務部　会計課長&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; text-align: left; text-indent: -55px"&gt;
