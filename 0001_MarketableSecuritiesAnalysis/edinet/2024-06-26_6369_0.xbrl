&lt;td rowspan="4" style="vertical-align: middle; width: 148px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 5.3333333333333333333333333333px; line-height: 11.333333333333333333333333333px; margin-right: 5.3333333333333333333333333333px; text-align: justify; text-justify: inter-ideograph"&gt;
