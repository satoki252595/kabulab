&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:14pt;min-height:14pt;"&gt;
&lt;td style="vertical-align:top;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;line-height:16pt;"&gt;2005年４月&lt;/p&gt;
