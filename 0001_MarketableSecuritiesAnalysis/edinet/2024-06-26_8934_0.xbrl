  <jpcrp_cor:NotesShareOptionsEtcConsolidatedFinancialStatementsTextBlock contextRef="CurrentYearDuration">&lt;p style="page-break-before:always; line-height:0.75pt; width:100%; font-size:0.75pt;"&gt; &lt;/p&gt;
&lt;h6 class="smt_head5" style="padding-left:18pt;line-height:18pt;"&gt;(ストック・オプション等関係)&lt;/h6&gt;&lt;p class="smt_text1" style="orphans:0;widows:0;"&gt;１　ストック・オプションにかかる費用計上額及び科目名&lt;/p&gt;
&lt;div class="tbld" style="margin-left:0pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:460pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
