&lt;td style="vertical-align: top; width: 189px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: justify; text-justify: inter-ideograph"&gt;監査役（社外監査役）&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 327.2px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
