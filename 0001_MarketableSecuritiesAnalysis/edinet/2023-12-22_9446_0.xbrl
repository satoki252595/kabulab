&lt;col style="width: 63px"/&gt;
&lt;col style="width: 63px"/&gt;
&lt;col style="width: 63px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr style="height: 17px"&gt;
