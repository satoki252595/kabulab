  <jpcrp_cor:CompanyNameCoverPage contextRef="FilingDateInstant">株式会社きんでん</jpcrp_cor:CompanyNameCoverPage>
  <jpcrp_cor:CompanyNameInEnglishCoverPage contextRef="FilingDateInstant">ＫＩＮＤＥＮ　ＣＯＲＰＯＲＡＴＩＯＮ</jpcrp_cor:CompanyNameInEnglishCoverPage>
