&lt;/div&gt;
&lt;p style="line-height: 1.3333333333333333333333333333px; text-align: left"&gt; &lt;/p&gt;
&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 645.33333333333333333333333332px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 160px"/&gt;
&lt;col style="width: 81.33333333333333333333333333px"/&gt;
&lt;col style="width: 81.33333333333333333333333333px"/&gt;
&lt;col style="width: 81.33333333333333333333333333px"/&gt;
&lt;col style="width: 81.33333333333333333333333333px"/&gt;
