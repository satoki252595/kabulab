&lt;tr style="height: 1.33px"&gt;
&lt;td style="vertical-align: top; width: 64px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt;2020年９月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 552px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; margin-right: 4px; text-align: left"&gt;味富士株式会社解散（2020年12月清算結了）。&lt;/p&gt;
&lt;/td&gt;
