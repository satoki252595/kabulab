  <jpcrp_cor:NotesRegardingPledgedAssetsTextBlock contextRef="CurrentYearInstant">&lt;p class="smt_text6" style="orphans:0;widows:0;"&gt;※２  担保資産&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:22.5pt;"&gt;(前連結会計年度)&lt;/p&gt;
