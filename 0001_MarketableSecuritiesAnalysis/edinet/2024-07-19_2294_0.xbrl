&lt;p style="margin-left: 6px; line-height: 13.333333333333333333333333333px; margin-right: 18px; margin-top: 6px; text-align: right"&gt;70&lt;/p&gt;
&lt;p style="margin-left: 6px; line-height: 13.333333333333333333333333333px; margin-right: 18px; margin-top: 6px; text-align: right"&gt; &lt;/p&gt;
