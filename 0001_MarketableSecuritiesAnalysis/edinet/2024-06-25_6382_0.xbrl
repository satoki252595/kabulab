&lt;td style="vertical-align: middle; width: 48px; padding-top: 0px; padding-bottom: 0px; padding-left: 6.6px; padding-right: 6.6px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="line-height: 1; text-align: left"&gt;
&lt;img alt="0102010_002.png" src="images/0102010_002.png" style="height: 86px; width: 34.8px"/&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 49px"&gt;
&lt;td rowspan="2" style="vertical-align: middle; width: 80.2px; padding-top: 0px; padding-bottom: 0px; padding-left: 6.6px; padding-right: 6.6px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 1; text-align: center"&gt;物理&lt;br/&gt;リスク&lt;/p&gt;
&lt;p style="line-height: 1; text-align: left"&gt; &lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 80px; padding-top: 0px; padding-bottom: 0px; padding-left: 6.6px; padding-right: 6.6px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 1; text-align: center"&gt;急性&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 232px; padding-top: 0px; padding-bottom: 0px; padding-left: 6.6px; padding-right: 6.6px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 1; text-align: left"&gt;・異常気象の風水害による人的・物的&lt;br/&gt;　被害発生とサプライチェーンの寸断&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 48px; padding-top: 0px; padding-bottom: 0px; padding-left: 6.6px; padding-right: 6.6px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="line-height: 1; text-align: left"&gt;
&lt;span style="font-size: 12px"&gt; &lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 31px"&gt;
&lt;td style="vertical-align: middle; width: 80px; padding-top: 0px; padding-bottom: 0px; padding-left: 6.6px; padding-right: 6.6px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 1; text-align: center"&gt;慢性&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 232px; padding-top: 0px; padding-bottom: 0px; padding-left: 6.6px; padding-right: 6.6px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 1; text-align: left"&gt;・熱中症等健康被害の増加&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 48px; padding-top: 0px; padding-bottom: 0px; padding-left: 6.6px; padding-right: 6.6px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="text-align: left"&gt;
&lt;span style="font-size: 12px"&gt; &lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
