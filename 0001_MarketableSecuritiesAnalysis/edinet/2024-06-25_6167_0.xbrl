&lt;col style="width:124.5pt;min-width:124.5pt;"/&gt;
&lt;col style="width:98.3pt;min-width:98.3pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:22.5pt;min-height:22.5pt;"&gt;
