  <jpcrp_cor:NotesAssetRetirementObligationsConsolidatedFinancialStatementsTextBlock contextRef="CurrentYearDuration">
&lt;h6 class="smt_head4" style="padding-left:18pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;text-align:justify;letter-spacing:0pt;line-height:15pt;font-size:9pt;"&gt;(資産除去債務関係)&lt;/h6&gt;&lt;p class="smt_text4" style="orphans:0;widows:0;padding-left:18pt;text-indent:0pt;"&gt;前連結会計年度（自　&lt;span&gt;2022年４月１日&lt;/span&gt;　至　&lt;span&gt;2023年３月31日&lt;/span&gt;）&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:18pt;text-indent:9pt;"&gt;資産除去債務の総額に重要性が乏しいため開示を省略しております。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;"&gt; &lt;/p&gt;&lt;p class="smt_text4" style="orphans:0;widows:0;padding-left:18pt;text-indent:0pt;"&gt;当連結会計年度（自　&lt;span&gt;2023年４月１日&lt;/span&gt;　至　&lt;span&gt;2024年３月31日&lt;/span&gt;）&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:18pt;text-indent:9pt;"&gt;資産除去債務の総額に重要性が乏しいため開示を省略しております。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;"&gt; &lt;/p&gt;</jpcrp_cor:NotesAssetRetirementObligationsConsolidatedFinancialStatementsTextBlock>
