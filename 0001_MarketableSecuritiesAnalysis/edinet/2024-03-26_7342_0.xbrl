&lt;col style="width:120.8pt;min-width:120.8pt;"/&gt;
&lt;col style="width:120.8pt;min-width:120.8pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:22.5pt;min-height:22.5pt;"&gt;
