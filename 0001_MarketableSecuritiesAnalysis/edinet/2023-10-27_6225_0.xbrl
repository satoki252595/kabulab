&lt;/table&gt;
&lt;/div&gt;
&lt;p style="margin-left: 80px; line-height: 1.3333333333333333333333333333px; text-align: left"&gt; &lt;/p&gt;
&lt;div style="margin-left: 80px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 573.20000000000000000000000001px"&gt;
&lt;colgroup&gt;
