&lt;p style="margin-left: 0px; margin-right: 0px; text-align: left; line-height: 6px"&gt;
&lt;span style="font-size: 12px"&gt; &lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 1.33px"&gt;
&lt;td style="border-left: 0px none #000000; border-top: 0px none #000000; border-right: 0px none #000000; border-bottom: 0px none #000000; width: 288px; vertical-align: top; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 9.333333333333333333333333333px; margin-right: 0px; text-align: left"&gt;排熱回収式熱交換器搭載型の省エネバーナー&lt;/p&gt;
&lt;p style="margin-left: 9.333333333333333333333333333px; margin-right: 0px; text-align: left"&gt;「ecoNext（エコネクスト）」&lt;/p&gt;
&lt;p style="margin-left: 9.333333333333333333333333333px; margin-right: 0px; text-align: left"&gt; &lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 0px none #000000; border-top: 0px none #000000; border-right: 0px none #000000; border-bottom: 0px none #000000; width: 252px; vertical-align: top; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 33.333333333333333333333333333px; margin-right: 0px; text-align: left"&gt;遠赤外線パネルヒーター&lt;/p&gt;
&lt;p style="margin-left: 33.333333333333333333333333333px; margin-right: 0px; text-align: left"&gt;「EIRヒーター」&lt;/p&gt;
