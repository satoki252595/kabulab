&lt;p style="margin-left: 12px; line-height: 18px; margin-right: 6px; text-align: center"&gt;非常勤監査等委員&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 154.86666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; line-height: 18px; margin-right: 6px; text-align: center"&gt;佐藤　信一&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 150.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; line-height: 18px; margin-right: 6px; text-align: center"&gt;監査等委員会14回&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 150.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; line-height: 18px; margin-right: 6px; text-align: center"&gt;監査等委員会14回&lt;/p&gt;
&lt;/td&gt;
