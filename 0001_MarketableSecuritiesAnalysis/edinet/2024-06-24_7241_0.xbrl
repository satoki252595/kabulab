&lt;/tr&gt;
&lt;tr style="height:16.5pt;min-height:16.5pt;"&gt;
&lt;td style="vertical-align:middle;border-top-color:#a9a9a9;border-bottom-color:#a9a9a9;border-left-color:#a9a9a9;border-right-color:#a9a9a9;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;margin-top:1.5pt;margin-bottom:1.5pt;line-height:11pt;"&gt;建設仮勘定&lt;/p&gt;
