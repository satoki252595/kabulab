&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 48px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 0px; margin-right: 0px; text-align: center; line-height: 16px"&gt;リスク&lt;/p&gt;
&lt;/td&gt;
&lt;td colspan="2" style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 204.06666666666666666666666667px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: left; line-height: 16px"&gt;・土壌汚染や水質の悪化により商品の品質に影響が生じ、製造の停止&lt;/p&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: left; line-height: 16px"&gt;・浄化設備の追加設置などのコスト増&lt;/p&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: left; line-height: 16px"&gt;※海外飲料事業&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 35.533333333333333333333333333px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center; line-height: 16px"&gt;
&lt;span style="font-size: 14px"&gt;↗&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 35.533333333333333333333333333px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 0px; margin-right: 0px; text-align: center; line-height: 16px"&gt;
&lt;span style="font-size: 14px"&gt;↑&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
