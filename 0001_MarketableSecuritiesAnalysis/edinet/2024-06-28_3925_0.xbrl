&lt;col style="width:43pt;min-width:43pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:13pt;min-height:13pt;"&gt;
&lt;td colspan="5" style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:right;padding-left:0pt;padding-right:0pt;"&gt;(連結従業員数117名)&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:right;padding-left:0pt;padding-right:0pt;"&gt; &lt;/p&gt;
