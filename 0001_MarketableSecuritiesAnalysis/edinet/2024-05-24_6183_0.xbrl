&lt;/td&gt;
&lt;td style="vertical-align:top;border-top-color:#A9A9A9;border-left-color:#A9A9A9;border-right-color:#A9A9A9;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:0pt;padding-right:4.4pt;font-size:7.5pt;"&gt;伊藤忠商事㈱入社&lt;/p&gt;
&lt;/td&gt;
