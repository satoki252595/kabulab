  <jpcrp_cor:PlaceForPublicInspectionCoverPageTextBlock contextRef="FilingDateInstant">&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:0pt;padding-right:0pt;margin-bottom:10pt;line-height:15pt;"&gt;株式会社東京証券取引所&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:10pt;padding-right:0pt;margin-bottom:10pt;line-height:15pt;"&gt;(東京都中央区日本橋兜町２番１号)&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:0pt;padding-right:0pt;margin-bottom:10pt;line-height:15pt;"&gt;証券会員制法人福岡証券取引所&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:10pt;padding-right:0pt;margin-bottom:10pt;line-height:15pt;"&gt;(福岡市中央区天神２丁目14番２号)&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:0pt;padding-right:0pt;margin-bottom:10pt;line-height:15pt;"&gt;株式会社南陽北関東支店&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:10pt;padding-right:0pt;margin-bottom:10pt;line-height:15pt;"&gt;(埼玉県熊谷市本町２丁目84番地　薬剤師会館１階)&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:0pt;padding-right:0pt;margin-bottom:10pt;line-height:15pt;"&gt;株式会社南陽東京支店&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:10pt;padding-right:0pt;margin-bottom:10pt;line-height:15pt;"&gt;(東京都中央区日本橋茅場町２丁目13番11号&lt;br/&gt; &lt;span style="font-size:9pt;"&gt;サンアイ茅場町ビル３階&lt;/span&gt;)&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:0pt;padding-right:0pt;margin-bottom:10pt;line-height:15pt;"&gt;株式会社南陽関西支店&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:10pt;padding-right:0pt;line-height:15pt;"&gt;(兵庫県西宮市甲子園七番町17番28号)&lt;/p&gt;</jpcrp_cor:PlaceForPublicInspectionCoverPageTextBlock>
