&lt;p style="margin-left: 5px; line-height: 12px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;2020年８月&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 165px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 12px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;弁護士法人創・佐藤法律事務所入所&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 16px"&gt;
&lt;td style="vertical-align: top; width: 70px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 5px; line-height: 12px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;2021年３月&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 165px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 12px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;医療法人伊部皮膚科クリニック監事就任(現任)&lt;/span&gt;
&lt;/p&gt;
