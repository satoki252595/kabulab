&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 97px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;
&lt;p style="margin-left: 2px; line-height: 15px; margin-right: 2px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;1952年４月10日&lt;/span&gt;&lt;span style="font-size: 10px"&gt;生&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 253.4px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;

&lt;p style="margin-left: 60px; line-height: 14px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;1975年４月 日綿實業株式会社（現双日株式会社）入社&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; line-height: 14px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;2006年４月 同社執行役員&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; line-height: 14px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;2008年４月 同社常務執行役員&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; line-height: 14px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;2012年４月 同社専務執行役員 ＣＦＯ&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; line-height: 14px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;2012年６月 同社代表取締役専務執行役員 ＣＦＯ&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; line-height: 14px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;2014年４月 同社代表取締役副社長執行役員 ＣＦＯ&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; line-height: 14px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;2014年７月 双日インフィニティ株式会社社外取締役&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; line-height: 14px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;2017年４月 双日株式会社代表取締役副社長執行役員兼ＣＣＯ&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; line-height: 14px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;2017年４月 双日リートアドバイザーズ株式会社取締役&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; line-height: 14px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;2018年４月 双日株式会社顧問&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; line-height: 14px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;2019年６月 当社社外取締役（監査等委員）（現任）&lt;/span&gt;
&lt;/p&gt;

