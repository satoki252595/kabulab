&lt;col style="width:63.8pt;min-width:63.8pt;"/&gt;
&lt;col style="width:306pt;min-width:306pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:12pt;min-height:12pt;"&gt;
&lt;td style="vertical-align:middle;border-top-color:#a9a9a9;border-bottom-color:#a9a9a9;border-left-color:#a9a9a9;border-right-color:#a9a9a9;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;line-height:10.5pt;"&gt;常務執行役員&lt;/p&gt;
&lt;/td&gt;
