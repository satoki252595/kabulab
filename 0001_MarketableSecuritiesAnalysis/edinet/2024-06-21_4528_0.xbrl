;&lt;span style="font-size:7.5pt;"&gt;　≧&lt;/span&gt;&lt;span style="font-size:7.5pt;"&gt;180&lt;/span&gt;&lt;span style="font-size:7.5pt;"&gt;人&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
