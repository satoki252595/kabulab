&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblR" style="orphans:0;widows:0;text-align:center;padding-left:3pt;padding-right:3pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;line-height:14pt;font-size:7.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;当社で定める&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_tblR" style="orphans:0;widows:0;text-align:center;padding-left:0pt;padding-right:4.5pt;margin-top:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:14pt;font-size:7.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;目標を達成&lt;/span&gt;&lt;/p&gt;
