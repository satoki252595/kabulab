&lt;col style="width:103.5pt;min-width:103.5pt;"/&gt;
&lt;col style="width:86.2pt;min-width:86.2pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:16.5pt;min-height:16.5pt;"&gt;
