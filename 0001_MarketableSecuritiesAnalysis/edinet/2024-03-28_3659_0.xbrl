&lt;/td&gt;
&lt;td style="vertical-align:top;border-top-color:#000000;border-bottom-color:#000000;border-left-color:#000000;border-right-color:#000000;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:0pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;line-height:15pt;font-size:9pt;"&gt;&lt;span style="font-size:9pt;"&gt;NEXON Korea Corporation&lt;/span&gt;; &lt;span style="font-size:9pt;"&gt;NEOPLE INC.;&lt;/span&gt; NEXON Games Co., Ltd.;&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:0pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;font-size:9pt;"&gt;VIP Global Super Growth Hedge Fund&lt;/p&gt;
