  <jpcrp_cor:NameOfFinancialInstrumentsExchangeOnWhichSecuritiesAreListedOrAuthorizedFinancialInstrumentsBusinessAssociationToWhichSecuritiesAreRegistered contextRef="FilingDateInstant_ClassBPreferredSharesMember">非上場</jpcrp_cor:NameOfFinancialInstrumentsExchangeOnWhichSecuritiesAreListedOrAuthorizedFinancialInstrumentsBusinessAssociationToWhichSecuritiesAreRegistered>
  <jpcrp_cor:DescriptionIssuedSharesTotalNumberOfSharesEtc contextRef="FilingDateInstant_ClassBPreferredSharesMember">(注)３～６</jpcrp_cor:DescriptionIssuedSharesTotalNumberOfSharesEtc>
  <jpcrp_cor:ClassIssuedSharesTotalNumberOfSharesEtc contextRef="FilingDateInstant_jpcrp030000-asr_E03673-000ClassDPreferredSharesMember">Ｄ種優先株式(行使価額修正条項付新株予約権付社債券等)</jpcrp_cor:ClassIssuedSharesTotalNumberOfSharesEtc>
  <jpcrp_cor:NameOfFinancialInstrumentsExchangeOnWhichSecuritiesAreListedOrAuthorizedFinancialInstrumentsBusinessAssociationToWhichSecuritiesAreRegistered contextRef="FilingDateInstant_jpcrp030000-asr_E03673-000ClassDPreferredSharesMember">非上場</jpcrp_cor:NameOfFinancialInstrumentsExchangeOnWhichSecuritiesAreListedOrAuthorizedFinancialInstrumentsBusinessAssociationToWhichSecuritiesAreRegistered>
  <jpcrp_cor:DescriptionIssuedSharesTotalNumberOfSharesEtc contextRef="FilingDateInstant_jpcrp030000-asr_E03673-000ClassDPreferredSharesMember">(注)１～５、７</jpcrp_cor:DescriptionIssuedSharesTotalNumberOfSharesEtc>
  <jpcrp_cor:ClassIssuedSharesTotalNumberOfSharesEtc contextRef="FilingDateInstant_jpcrp030000-asr_E03673-000ClassEPreferredSharesMember">Ｅ種優先株式</jpcrp_cor:ClassIssuedSharesTotalNumberOfSharesEtc>
  <jpcrp_cor:NameOfFinancialInstrumentsExchangeOnWhichSecuritiesAreListedOrAuthorizedFinancialInstrumentsBusinessAssociationToWhichSecuritiesAreRegistered contextRef="FilingDateInstant_jpcrp030000-asr_E03673-000ClassEPreferredSharesMember">非上場</jpcrp_cor:NameOfFinancialInstrumentsExchangeOnWhichSecuritiesAreListedOrAuthorizedFinancialInstrumentsBusinessAssociationToWhichSecuritiesAreRegistered>
  <jpcrp_cor:DescriptionIssuedSharesTotalNumberOfSharesEtc contextRef="FilingDateInstant_jpcrp030000-asr_E03673-000ClassEPreferredSharesMember">(注)３～５、８</jpcrp_cor:DescriptionIssuedSharesTotalNumberOfSharesEtc>
  <jpcrp_cor:ClassIssuedSharesTotalNumberOfSharesEtc contextRef="FilingDateInstant_jpcrp030000-asr_E03673-000ClassFPreferredSharesMember">Ｆ種優先株式</jpcrp_cor:ClassIssuedSharesTotalNumberOfSharesEtc>
  <jpcrp_cor:NameOfFinancialInstrumentsExchangeOnWhichSecuritiesAreListedOrAuthorizedFinancialInstrumentsBusinessAssociationToWhichSecuritiesAreRegistered contextRef="FilingDateInstant_jpcrp030000-asr_E03673-000ClassFPreferredSharesMember">非上場</jpcrp_cor:NameOfFinancialInstrumentsExchangeOnWhichSecuritiesAreListedOrAuthorizedFinancialInstrumentsBusinessAssociationToWhichSecuritiesAreRegistered>
  <jpcrp_cor:DescriptionIssuedSharesTotalNumberOfSharesEtc contextRef="FilingDateInstant_jpcrp030000-asr_E03673-000ClassFPreferredSharesMember">(注)３～５、９</jpcrp_cor:DescriptionIssuedSharesTotalNumberOfSharesEtc>
  <jpcrp_cor:DetailsOfEmployeeShareOptionProgramTextBlock contextRef="FilingDateInstant">
&lt;h4 class="smt_head4" style="padding-left:18pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;text-align:justify;letter-spacing:0pt;line-height:15pt;font-size:9pt;"&gt;① 【ストックオプション制度の内容】&lt;/h4&gt;&lt;p class="smt_text4" style="orphans:0;widows:0;"&gt;該当事項はありません。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:0pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;"&gt; &lt;/p&gt;</jpcrp_cor:DetailsOfEmployeeShareOptionProgramTextBlock>
  <jpcrp_cor:DescriptionOfRightsPlanTextBlock contextRef="FilingDateInstant">
&lt;h4 class="smt_head4" style="padding-left:18pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;text-align:justify;letter-spacing:0pt;line-height:15pt;font-size:9pt;"&gt;② 【ライツプランの内容】&lt;/h4&gt;&lt;p class="smt_text4" style="orphans:0;widows:0;"&gt;該当事項はありません。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:0pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;font-size:15pt;"&gt; &lt;/p&gt;</jpcrp_cor:DescriptionOfRightsPlanTextBlock>
  <jpcrp_cor:OtherInformationOnShareAcquisitionRightsTextBlock contextRef="FilingDateInstant">&lt;p class="smt_head4" style="orphans:0;widows:0;padding-left:18pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;text-align:justify;letter-spacing:0pt;line-height:15pt;font-size:9pt;"&gt;③ 【その他の新株予約権等の状況】&lt;/p&gt;&lt;p class="smt_text4" style="orphans:0;widows:0;text-align:justify;padding-left:27pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:9pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;"&gt;該当事項はありません。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:0pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;font-size:15pt;"&gt; &lt;/p&gt;</jpcrp_cor:OtherInformationOnShareAcquisitionRightsTextBlock>
  <jpcrp_cor:ExercisesEtcOfMovingStrikeConvertibleBondsEtcTextBlock contextRef="FilingDateInstant">
&lt;h4 class="smt_head3"&gt;(3) 【行使価額修正条項付新株予約権付社債券等の行使状況等】&lt;/h4&gt;&lt;p class="smt_unitR" style="orphans:0;widows:0;"&gt; &lt;/p&gt;
