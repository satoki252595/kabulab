&lt;tr style="height: 38px"&gt;
&lt;td style="vertical-align: middle; width: 231.6px; padding-top: 1px; padding-bottom: 0px; padding-left: 18px; padding-right: 1px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
