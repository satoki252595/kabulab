&lt;p style="margin-right: 8px; text-align: right"&gt;－&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 82.26666666666666666666666667px; padding-top: 1px; padding-bottom: 0px; padding-left: 1px; padding-right: 1px; border-left: 0px none ; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
