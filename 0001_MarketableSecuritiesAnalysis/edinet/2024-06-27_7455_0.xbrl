&lt;tr style="height: 39.13px"&gt;
&lt;td rowspan="3" style="vertical-align: middle; width: 61.533333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 18px; text-align: center"&gt;
