&lt;col style="width:117.8pt;min-width:117.8pt;"/&gt;
&lt;col style="width:32.3pt;min-width:32.3pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:30.0pt;min-height:30.0pt;"&gt;
