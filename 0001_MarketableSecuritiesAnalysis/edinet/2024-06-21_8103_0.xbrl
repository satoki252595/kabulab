&lt;td style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;text-align:right;padding-right:13pt;line-height:13pt;"&gt;12月&lt;/p&gt;
&lt;/td&gt;
