  <jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E37986-000AokiYasutakaMember">青木　泰岳</jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E37986-000AokiYasutakaMember">1979-05-07</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
