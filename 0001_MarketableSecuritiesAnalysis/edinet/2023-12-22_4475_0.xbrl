&lt;div class="tbld" style="text-align:center;margin-left:0pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" class="align_center" style="border-collapse:collapse;border:solid 0pt #000000;width:179.8pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
&lt;col style="width:53pt;min-width:53pt;"/&gt;
&lt;col style="width:126.8pt;min-width:126.8pt;"/&gt;
