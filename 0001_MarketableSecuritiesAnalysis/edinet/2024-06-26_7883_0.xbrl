  <jpcrp_cor:DateOfResolutionDividendsOfSurplus contextRef="FilingDateInstant_Row1Member">2023-11-01</jpcrp_cor:DateOfResolutionDividendsOfSurplus>
  <jpcrp_cor:ResolutionDividendsOfSurplus contextRef="FilingDateInstant_Row1Member">取締役会</jpcrp_cor:ResolutionDividendsOfSurplus>
  <jpcrp_cor:DateOfResolutionDividendsOfSurplus contextRef="FilingDateInstant_Row2Member">2024-05-17</jpcrp_cor:DateOfResolutionDividendsOfSurplus>
