&lt;p style="margin-left: 5px; line-height: 14.333333333333333333333333333px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;2024年８月&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 215px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 14.333333333333333333333333333px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;当社社外監査役就任（現任）&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
