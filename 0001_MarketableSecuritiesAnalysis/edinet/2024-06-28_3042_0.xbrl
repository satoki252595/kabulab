&lt;col style="width: 18.866666666666666666666666667px"/&gt;
&lt;col style="width: 67.466666666666666666666666667px"/&gt;
&lt;col style="width: 25.333333333333333333333333333px"/&gt;
&lt;col style="width: 54.066666666666666666666666667px"/&gt;
&lt;col style="width: 20.6px"/&gt;
&lt;col style="width: 83.33333333333333333333333333px"/&gt;
&lt;col style="width: 18.866666666666666666666666667px"/&gt;
&lt;col style="width: 98.86666666666666666666666667px"/&gt;
&lt;/colgroup&gt;
