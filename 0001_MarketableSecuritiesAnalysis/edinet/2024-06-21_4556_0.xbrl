&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 279px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 70px"/&gt;
&lt;col style="width: 209px"/&gt;
&lt;/colgroup&gt;
