&lt;td style="vertical-align:bottom;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-color:#000000;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="bottom"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;"&gt;400,000株&lt;/p&gt;
