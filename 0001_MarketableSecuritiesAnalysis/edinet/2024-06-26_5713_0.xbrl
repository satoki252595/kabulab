  <jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E00023-000TakebayashiMasaruMember">竹 林　　優</jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors>
