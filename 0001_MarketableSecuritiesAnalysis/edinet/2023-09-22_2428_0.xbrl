&lt;td style="vertical-align: middle; width: 97.26666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p class="text_align_justify" style="margin-left: 18px; line-height: 13.333333333333333333333333333px; margin-right: 6px"&gt;加藤　達也&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 325.26666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 18px; line-height: 13.333333333333333333333333333px; margin-right: 6px; text-align: left"&gt;（取締役決済イノベーション推進部長）&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 16.67px"&gt;
