</jpcrp_cor:OfficialTitleOrPositionInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E34114-000NakamuraTatsuoMember">中村　達生</jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E34114-000NakamuraTatsuoMember">1965-11-25</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock contextRef="FilingDateInstant_jpcrp030000-asr_E34114-000NakamuraTatsuoMember">
&lt;p style="margin-left: 77px; margin-right: 5px; text-align: left; text-indent: -72px"&gt;1991年４月　株式会社三菱総合研究所入社&lt;/p&gt;
&lt;p style="margin-left: 77px; margin-right: 5px; text-align: left; text-indent: -72px"&gt;1994年10月　東京大学工学部助手&lt;/p&gt;
&lt;p style="margin-left: 77px; margin-right: 5px; text-align: left; text-indent: -72px"&gt;1997年10月　株式会社三菱総合研究所復職&lt;/p&gt;
&lt;p style="margin-left: 77px; margin-right: 5px; text-align: left; text-indent: -72px"&gt;2006年８月　株式会社創知（現当社）設立&lt;/p&gt;
&lt;p style="margin-left: 77px; margin-right: 5px; text-align: left; text-indent: -72px"&gt;　　　　　　代表取締役社長就任（現任）&lt;/p&gt;
&lt;p style="margin-left: 77px; margin-right: 5px; text-align: left; text-indent: -72px"&gt;2014年２月　VALUENEX, Inc.設立&lt;/p&gt;
&lt;p style="margin-left: 77px; margin-right: 5px; text-align: left; text-indent: -72px"&gt;　　　　　　Board of Director(CEO)就任（現任）&lt;/p&gt;
&lt;p style="margin-left: 77px; margin-right: 5px; text-align: left; text-indent: -72px"&gt;2018年４月　当社CEO就任（現任）&lt;/p&gt;
&lt;p style="margin-left: 77px; margin-right: 5px; text-align: left; text-indent: -72px"&gt;2019年２月　当社社長執行役員就任&lt;/p&gt;
</jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock>
  <jpcrp_cor:TermOfOfficeInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E34114-000NakamuraTatsuoMember">(注)1</jpcrp_cor:TermOfOfficeInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:OfficialTitleOrPositionInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E34114-000SamejimaMasaakiMember">
