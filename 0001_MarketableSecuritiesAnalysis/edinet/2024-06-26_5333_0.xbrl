&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-color:#a9a9a9;border-left-color:#a9a9a9;border-right-color:#a9a9a9;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:5.7pt;padding-right:5.7pt;letter-spacing:0pt;font-size:7.5pt;"&gt;当社入社&lt;/p&gt;
