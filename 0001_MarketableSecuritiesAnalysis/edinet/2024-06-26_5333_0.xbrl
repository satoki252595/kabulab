&lt;/colgroup&gt;
&lt;tr style="height:34pt;min-height:34pt;"&gt;
&lt;td colspan="2" style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:5.4pt;padding-right:5.4pt;line-height:13pt;font-size:10.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;取組み事項及びその指標&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
