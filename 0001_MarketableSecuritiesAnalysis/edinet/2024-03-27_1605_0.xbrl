&lt;td rowspan="3" style="vertical-align: middle; width: 248px; padding-top: 0.6666666666666666666666666667px; padding-bottom: 0px; padding-left: 0.6666666666666666666666666667px; padding-right: 0.6666666666666666666666666667px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #F7F7FB"&gt;
