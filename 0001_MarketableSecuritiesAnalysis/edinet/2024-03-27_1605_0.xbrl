  <jpcrp_cor:ClassIssuedSharesTotalNumberOfSharesEtc contextRef="FilingDateInstant_jpcrp030000-asr_E00043-000ClassAStockMember">甲種類株式</jpcrp_cor:ClassIssuedSharesTotalNumberOfSharesEtc>
