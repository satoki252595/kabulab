&lt;td style="vertical-align: middle; width: 256px; padding-top: 0.6666666666666666666666666667px; padding-bottom: 0px; padding-left: 12px; padding-right: 0.6666666666666666666666666667px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #F7F7FB"&gt;
