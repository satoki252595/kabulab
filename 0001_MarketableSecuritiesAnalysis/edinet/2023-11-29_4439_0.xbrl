&lt;tr style="height: 33.73px"&gt;
&lt;td style="vertical-align: middle; width: 340.53333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 12px; line-height: 13.333333333333333333333333333px; margin-right: 12px; text-align: justify; text-justify: inter-ideograph"&gt;新株予約権の譲渡に関する事項 ※&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 307.06666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; line-height: 13.333333333333333333333333333px; margin-right: 6px; text-align: justify; text-justify: inter-ideograph"&gt;新株予約権を譲渡するには、当社取締役会の承認を要する。&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 26.67px"&gt;
&lt;td style="vertical-align: middle; width: 340.53333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 12px; line-height: 13.333333333333333333333333333px; margin-right: 12px; text-align: justify; text-justify: inter-ideograph"&gt;組織再編成行為に伴う新株予約権の交付に関する事項 ※&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 307.06666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; line-height: 13.333333333333333333333333333px; margin-right: 6px; text-align: justify; text-justify: inter-ideograph"&gt;（注）６&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
