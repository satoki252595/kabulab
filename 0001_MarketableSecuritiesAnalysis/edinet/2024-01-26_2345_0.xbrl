&lt;/td&gt;
&lt;td colspan="5" style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;line-height:10pt;font-size:7.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;帳簿価額(千円)&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td rowspan="2" style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;padding-left:1pt;padding-right:1pt;line-height:10pt;font-size:7.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;従業員数&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:9pt;"&gt;(外、平均臨時雇用者数)(名)&lt;/span&gt;&lt;/p&gt;
