</jpcrp030000-asr_E01435-000:PolicyOnHumanResourceDevelopmentAndImprovementOfInternalEnvironmentStrategyTextBlock>
  <jpcrp030000-asr_E01435-000:RiskManagementTextBlock contextRef="FilingDateInstant">
