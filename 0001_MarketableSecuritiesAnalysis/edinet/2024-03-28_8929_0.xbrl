&lt;p style="margin-left: 12px; text-align: left"&gt;第８回新株予約権&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 272px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;事業年度末現在&lt;/p&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;（2023年12月31日）&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/thead&gt;
&lt;tbody&gt;
&lt;tr style="height: 21.33px"&gt;
&lt;td style="vertical-align: middle; width: 340px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 12px; line-height: 16px; margin-right: 12px; text-align: left"&gt;決議年月日&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 272px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 12px; line-height: 16px; margin-right: 12px; text-align: center"&gt;2021年８月３日、2021年９月７日&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 23px"&gt;
&lt;td style="vertical-align: middle; width: 340px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 12px; line-height: 16px; margin-right: 12px; text-align: left"&gt;付与対象者の区分及び人数&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 272px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 12px; line-height: 16px; margin-right: 24px; text-align: left"&gt;当社取締役                       7&lt;/p&gt;
&lt;p style="margin-left: 12px; line-height: 16px; margin-right: 24px; text-align: left"&gt;当社監査役                       1&lt;/p&gt;
&lt;p style="margin-left: 12px; line-height: 16px; margin-right: 24px; text-align: left"&gt;当社従業員                       1&lt;/p&gt;
&lt;p style="margin-left: 12px; line-height: 16px; margin-right: 24px; text-align: left"&gt;当社関係会社取締役               3&lt;/p&gt;
&lt;p style="margin-left: 12px; line-height: 16px; margin-right: 24px; text-align: left"&gt;当社関係会社従業員               1&lt;/p&gt;
&lt;p style="margin-left: 12px; line-height: 16px; margin-right: 24px; text-align: left"&gt;当社及び当社関係会社外部協力者  15&lt;/p&gt;
