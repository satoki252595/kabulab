&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:justify;padding-left:0pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:10pt;"&gt;千円&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/table&gt;&lt;p style="clear:both; line-height:0.75pt; width:100%; font-size:0.75pt;"&gt; &lt;/p&gt;
&lt;/div&gt;</jpcrp_cor:ResearchAndDevelopmentExpensesIncludedInGeneralAndAdministrativeExpensesAndManufacturingCostForCurrentPeriodTextBlock>
  <jpcrp_cor:NotesRegardingIssuedSharesAndTreasurySharesTextBlock contextRef="CurrentYearDuration">
&lt;h4 class="smt_head3"&gt;１  発行済株式に関する事項&lt;/h4&gt;
&lt;div class="tbld" style="margin-left:0pt;margin-right:0pt;margin-top:4.5pt;margin-bottom:4.5pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:482pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
&lt;col style="width:106pt;min-width:106pt;"/&gt;
&lt;col style="width:94pt;min-width:94pt;"/&gt;
&lt;col style="width:94pt;min-width:94pt;"/&gt;
&lt;col style="width:94pt;min-width:94pt;"/&gt;
&lt;col style="width:94pt;min-width:94pt;"/&gt;
