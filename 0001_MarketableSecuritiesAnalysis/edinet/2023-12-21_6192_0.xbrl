&lt;p style="text-align: left"&gt; &lt;/p&gt;
</jpcrp030000-asr_E32220-000:GovernanceTextBlock>
  <jpcrp030000-asr_E32220-000:StrategyTextBlock contextRef="FilingDateInstant">
