&lt;p style="line-height: 16.666666666666666666666666667px; text-align: left"&gt; 権利行使期間&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 157.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; line-height: 16.666666666666666666666666667px; text-align: left; text-indent: -6px"&gt; 自 平成29年２月28日&lt;/p&gt;
&lt;p style="margin-left: 6px; line-height: 16.666666666666666666666666667px; text-align: left; text-indent: -6px"&gt; 至 令和19年２月27日&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 157.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
