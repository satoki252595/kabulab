&lt;p style="text-align: left"&gt;Scope3&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 189px; padding-top: 0px; padding-bottom: 0px; padding-left: 6.6px; padding-right: 6.6px; border-left: 0px none ; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;
&lt;p style="text-align: left"&gt;カテゴリ7（雇用者の通勤）&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 98.6px; padding-top: 0px; padding-bottom: 0px; padding-left: 6.6px; padding-right: 6.6px; border-left: 0px none ; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;
&lt;p style="text-align: right"&gt;62.93&lt;/p&gt;
