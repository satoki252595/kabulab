&lt;col style="width:157.5pt;min-width:157.5pt;"/&gt;
&lt;col style="width:156pt;min-width:156pt;"/&gt;
&lt;col style="width:156pt;min-width:156pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:15pt;min-height:15pt;"&gt;
&lt;td colspan="3" style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:41pt;"&gt;①　ストック・オプションの数&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/table&gt;&lt;p style="clear:both; line-height:0.75pt; width:100%; font-size:0.75pt;"&gt; &lt;/p&gt;
