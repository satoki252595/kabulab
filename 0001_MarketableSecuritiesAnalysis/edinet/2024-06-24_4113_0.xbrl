&lt;td style="vertical-align:top;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:2pt;padding-right:2pt;margin-top:0pt;margin-bottom:0pt;line-height:9pt;font-size:10.5pt;"&gt;&lt;span style="font-size:7.5pt;"&gt;役員指名諮問委員会&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
