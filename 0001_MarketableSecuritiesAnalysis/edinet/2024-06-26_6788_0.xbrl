&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:18.0pt;min-height:18.0pt;"&gt;
&lt;td colspan="2" style="vertical-align:top;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:0pt;padding-right:0pt;text-justify:inter-ideograph;text-indent:4pt;line-height:18pt;"&gt;（連結子会社５社）&lt;/p&gt;
