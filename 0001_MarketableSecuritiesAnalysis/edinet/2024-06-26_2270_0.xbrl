&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:2pt;padding-right:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:0pt;line-height:10pt;font-size:10.5pt;"&gt;&lt;span style="font-family:&amp;apos;ＭＳ 明朝&amp;apos;;font-size:9pt;"&gt;2020年度より隔年で実施&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:2pt;padding-right:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:0pt;line-height:10pt;font-size:10.5pt;"&gt;&lt;span style="font-family:&amp;apos;ＭＳ 明朝&amp;apos;;font-size:9pt;"&gt;調査対象の国内サプライヤー全社（約250社）から回答を受領し、分析シートを各社へフィードバックの上、意見交換&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:34.5pt;min-height:34.5pt;"&gt;
