&lt;td style="vertical-align:bottom;border-bottom-style:solid;border-bottom-width:0.75pt;overflow:hidden;" valign="bottom"&gt;&lt;p class="smt_tblR" style="orphans:0;widows:0;padding-right:9.1pt;"&gt;&lt;span style="font-size:9pt;"&gt;(単位：千円)&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
