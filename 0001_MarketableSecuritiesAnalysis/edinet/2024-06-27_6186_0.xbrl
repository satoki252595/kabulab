&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:4.5pt;padding-right:4.5pt;margin-top:0pt;margin-bottom:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;line-height:13.5pt;font-size:13.5pt;"&gt; &lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;line-height:10pt;font-size:9pt;"&gt;&lt;span style="font-size:9pt;"&gt;第１四半期&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;line-height:10pt;font-size:9pt;"&gt;&lt;span style="font-size:9pt;"&gt;連結会計期間&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;line-height:10pt;font-size:9pt;"&gt;&lt;span&gt;&lt;span style="font-size:9pt;"&gt;2023年４月１日&lt;/span&gt;&lt;/span&gt;&lt;span style="font-size:9pt;"&gt;～&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;line-height:10pt;font-size:9pt;"&gt;&lt;span&gt;&lt;span style="font-size:9pt;"&gt;2023年６月30日&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;line-height:10pt;font-size:9pt;"&gt;&lt;span style="font-size:9pt;"&gt;第２四半期&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;line-height:10pt;font-size:9pt;"&gt;&lt;span style="font-size:9pt;"&gt;連結会計期間&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;line-height:10pt;font-size:9pt;"&gt;&lt;span&gt;&lt;span style="font-size:9pt;"&gt;2023年７月１日&lt;/span&gt;&lt;/span&gt;&lt;span style="font-size:9pt;"&gt;～&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;line-height:10pt;font-size:9pt;"&gt;&lt;span&gt;&lt;span style="font-size:9pt;"&gt;2023年９月30日&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
