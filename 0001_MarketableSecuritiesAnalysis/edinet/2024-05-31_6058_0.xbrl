  <jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock contextRef="FilingDateInstant_jpcrp030000-asr_E26428-000NishieKeijiMember">
&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 261px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 55.333333333333333333333333333px"/&gt;
&lt;col style="width: 205.66666666666666666666666667px"/&gt;
