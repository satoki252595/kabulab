&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-color:#000000;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:right;font-family:&amp;apos;ＭＳ Ｐ明朝&amp;apos;;line-height:12pt;font-size:9pt;"&gt;654,558&lt;/p&gt;
