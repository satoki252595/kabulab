&lt;p style="margin-left: 6px; line-height: 15px; margin-right: 6px; margin-bottom: 2.6666666666666666666666666667px; margin-top: 2.6666666666666666666666666667px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;2022年４月&lt;/span&gt;
