&lt;td rowspan="2" style="border-left: 0px none ; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 128px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px; background-color: #BFBFBF"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center"&gt;取組テーマ&lt;/p&gt;
&lt;/td&gt;
