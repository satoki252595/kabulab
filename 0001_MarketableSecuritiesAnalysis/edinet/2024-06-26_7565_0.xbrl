  <jpcrp_cor:NotesRegardingTransactionsWithAffiliatedEntitiesTextBlock contextRef="CurrentYearDuration_NonConsolidatedMember">
&lt;p style="margin-left: 36px; text-align: left; text-indent: -24px"&gt;※1　関係会社に係る注記&lt;/p&gt;
&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 647.99999999999999999999999999px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 241.33333333333333333333333333px"/&gt;
&lt;col style="width: 203.33333333333333333333333333px"/&gt;
&lt;col style="width: 203.33333333333333333333333333px"/&gt;
&lt;/colgroup&gt;
