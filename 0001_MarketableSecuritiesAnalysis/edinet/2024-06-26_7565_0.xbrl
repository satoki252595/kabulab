  <jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E02875-000MatsuokaAkihiroMember">松岡昭博</jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E02875-000MatsuokaAkihiroMember">1968-07-15</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
