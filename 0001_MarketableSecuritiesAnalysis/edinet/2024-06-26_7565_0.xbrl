  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E02875-000HiraiToruMember">1965-05-11</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock contextRef="FilingDateInstant_jpcrp030000-asr_E02875-000HiraiToruMember">
&lt;p style="margin-left: 71.666666666666666666666666667px; line-height: 13.333333333333333333333333333px; margin-right: 3.6666666666666666666666666667px; text-align: left; text-indent: -66.666666666666666666666666667px"&gt;
