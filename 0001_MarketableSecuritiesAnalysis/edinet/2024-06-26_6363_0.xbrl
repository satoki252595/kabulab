&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 112.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;
&lt;p style="margin-left: 12px; margin-right: 3.3333333333333333333333333333px; text-align: left"&gt;
