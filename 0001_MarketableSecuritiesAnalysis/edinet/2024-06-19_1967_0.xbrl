&lt;/td&gt;
&lt;td style="vertical-align:top;border-bottom-color:#a9a9a9;border-left-style:solid;border-left-width:0.75pt;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;line-height:11pt;font-size:7.5pt;"&gt;&lt;span style="font-size:7.5pt;"&gt;当社に入社&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:13.5pt;min-height:13.5pt;"&gt;
