&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 141px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; margin-right: 16px; text-align: right"&gt;23億円&lt;/p&gt;
