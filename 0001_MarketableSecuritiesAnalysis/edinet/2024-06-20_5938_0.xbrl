&lt;td style="vertical-align: top; width: 63px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 5.3333333333333333333333333333px; line-height: 15px; margin-right: 5.3333333333333333333333333333px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;1983年４月&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 268px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 5.3333333333333333333333333333px; line-height: 15px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;住友商事株式会社入社&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
