&lt;td style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;line-height:1pt;font-size:1pt;"&gt; &lt;/p&gt;
&lt;div&gt;&lt;img alt="" height="147" src="fuzoku/0607_1.png" width="241"/&gt;&lt;br/&gt;
