&lt;tr style="height:31.5pt;min-height:31.5pt;"&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:3.1pt;padding-right:3.1pt;line-height:8.5pt;font-size:7.5pt;"&gt;カプコサーカス新潟東店&lt;br/&gt;(新潟県新潟市東区)&lt;br/&gt;ほか48ヵ所&lt;/p&gt;
&lt;/td&gt;
