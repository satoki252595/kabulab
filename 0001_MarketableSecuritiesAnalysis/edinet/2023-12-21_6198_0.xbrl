&lt;col style="width:9.1pt;min-width:9.1pt;"/&gt;
&lt;col style="width:56.3pt;min-width:56.3pt;"/&gt;
&lt;col style="width:9.1pt;min-width:9.1pt;"/&gt;
&lt;col style="width:153pt;min-width:153pt;"/&gt;
&lt;/colgroup&gt;
