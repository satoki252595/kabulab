&lt;tbody&gt;
&lt;tr style="height: 24px"&gt;
&lt;td style="vertical-align: middle; width: 250.13333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 12px; text-align: left"&gt;決議年月日&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 397.13333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 12px; text-align: left"&gt;2017年3月29日&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 36px"&gt;
&lt;td style="vertical-align: middle; width: 250.13333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 12px; text-align: left"&gt;付与対象者の区分及び人数&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 397.13333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 12px; text-align: left"&gt;取締役を兼務しない当社執行役員　2名&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 24px"&gt;
&lt;td style="vertical-align: middle; width: 250.13333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 12px; text-align: left"&gt;新株予約権の数　※&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 397.13333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 12px; text-align: left"&gt;36個&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 36px"&gt;
&lt;td style="vertical-align: middle; width: 250.13333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 12px; text-align: left"&gt;新株予約権の目的となる株式の種類、内容及び数　※&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 397.13333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 12px; text-align: left"&gt;普通株式　3,600株　（注）1&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 36px"&gt;
&lt;td style="vertical-align: middle; width: 250.13333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 12px; text-align: left"&gt;新株予約権の行使時の払込金額　※&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 397.13333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 12px; text-align: left"&gt;新株予約権を行使することにより交付を受けることができる&lt;/p&gt;
&lt;p style="margin-left: 12px; text-align: left"&gt;株式1株当たり1円とし、これに付与株式数を乗じた金額とする。&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 36px"&gt;
