&lt;td style="vertical-align: top; width: 96px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 12px; line-height: 17.333333333333333333333333333px; text-align: left"&gt;
&lt;span style="font-family: &amp;apos;ＭＳ ゴシック&amp;apos;"&gt;1946年11月&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 552px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; line-height: 17.333333333333333333333333333px; text-align: left"&gt;
&lt;span style="font-family: &amp;apos;ＭＳ ゴシック&amp;apos;"&gt;資本金18万円で東京都中央区に設立（商号　時田産業株式会社）。&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 19px"&gt;
&lt;td style="vertical-align: top; width: 96px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 12px; line-height: 17.333333333333333333333333333px; text-align: left"&gt;
&lt;span style="font-family: &amp;apos;ＭＳ ゴシック&amp;apos;"&gt;1973年９月&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 552px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; line-height: 17.333333333333333333333333333px; text-align: left"&gt;
&lt;span style="font-family: &amp;apos;ＭＳ ゴシック&amp;apos;"&gt;商号を宝塚ケーブル株式会社に変更、本店を兵庫県宝塚市栄町に移転。&lt;/span&gt;
&lt;/p&gt;
