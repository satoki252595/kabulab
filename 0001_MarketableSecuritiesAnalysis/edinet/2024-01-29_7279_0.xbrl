  <jpcrp_cor:InformationForEachProductOrServiceTextBlock contextRef="Prior1YearDuration">
&lt;p style="margin-left: 60px; line-height: 13.333333333333333333333333333px; margin-right: 0px; text-align: left; text-indent: -24px"&gt;
&lt;span style="font-family: &amp;apos;ＭＳ ゴシック&amp;apos;"&gt;１．製品及びサービスごとの情報&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 84px; line-height: 18px; margin-right: 6px; text-align: right"&gt;
