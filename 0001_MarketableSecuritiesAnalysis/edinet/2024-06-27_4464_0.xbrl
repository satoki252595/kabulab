  <jpcrp_cor:NotesRelatedPartiesConsolidatedFinancialStatementsTextBlock contextRef="CurrentYearDuration">
&lt;h6&gt;（関連当事者情報）&lt;/h6&gt;
&lt;p style="margin-left: 114px; line-height: 19.333333333333333333333333333px; text-align: left; text-indent: -72px"&gt;関連当事者との取引&lt;/p&gt;
