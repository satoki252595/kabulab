&lt;td style="vertical-align: top; width: 126px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 15.333333333333333333333333333px; text-align: left"&gt;2023年６月29日&lt;/p&gt;
&lt;p style="line-height: 15.333333333333333333333333333px; text-align: left"&gt;近畿財務局長に提出。&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;/div&gt;
</jpcrp_cor:OtherReferenceInformationTextBlock>
