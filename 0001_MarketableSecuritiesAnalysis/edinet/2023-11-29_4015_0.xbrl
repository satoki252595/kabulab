  <jpcrp_cor:NotesRegardingInventoriesTextBlock contextRef="CurrentYearInstant">&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:0pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;font-size:9pt;"&gt;※２　棚卸資産の内訳は、次のとおりであります。&lt;/p&gt;&lt;p class="smt_unitR" style="orphans:0;widows:0;padding-left:0pt;line-height:15pt;font-size:15pt;"&gt; &lt;/p&gt;
&lt;div class="tbld" style="margin-left:25.5pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:439.7pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
