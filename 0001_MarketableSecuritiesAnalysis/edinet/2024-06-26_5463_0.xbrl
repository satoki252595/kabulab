&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:10pt;padding-right:10pt;margin-top:0.0pt;margin-bottom:0.0pt;letter-spacing:0pt;line-height:18.0pt;"&gt;－&lt;/p&gt;
