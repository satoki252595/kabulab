&lt;td style="vertical-align: top; width: 260px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: left"&gt; (第52期第３四半期)　　 自2023年10月１日&lt;/p&gt;
&lt;p style="text-align: left"&gt;　　　　　　　　　　　　至2023年12月31日&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 147px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: left"&gt;　　　2024年２月14日&lt;/p&gt;
&lt;p style="text-align: left"&gt;　　　関東財務局長に提出&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;/div&gt;
&lt;p style="text-align: left"&gt; &lt;/p&gt;
&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 647px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 240px"/&gt;
&lt;col style="width: 260px"/&gt;
&lt;col style="width: 147px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr style="height: 54.53px"&gt;
&lt;td style="vertical-align: top; width: 240px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 36px; text-align: left; text-indent: -24px"&gt;（４）臨時報告書&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 260px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: left"&gt;企業内容等の開示に関する内閣府令第19条第2項第9号の2（株主総会における議決権行使の結果）に基づく臨時報告書であります。&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 147px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: left"&gt;　　　2023年６月26日&lt;/p&gt;
&lt;p style="text-align: left"&gt;　　　関東財務局長に提出&lt;/p&gt;
&lt;p style="text-align: left"&gt; &lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;/div&gt;
&lt;p style="text-align: left"&gt; &lt;/p&gt;
</jpcrp_cor:OtherReferenceInformationTextBlock>
