  <jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock contextRef="FilingDateInstant_jpcrp030000-asr_E01420-000TanakaShigeruMember">
&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 224px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 70px"/&gt;
&lt;col style="width: 154px"/&gt;
&lt;/colgroup&gt;
