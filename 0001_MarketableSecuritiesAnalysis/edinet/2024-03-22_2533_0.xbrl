&lt;td style="vertical-align:top;border-bottom-color:#a9a9a9;border-left-style:solid;border-left-width:0.75pt;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:0.5pt;padding-right:0.5pt;letter-spacing:0pt;line-height:10pt;font-size:7.5pt;"&gt;当社入社&lt;/p&gt;
