  <jpcrp_cor:InformationAboutEmployeesTextBlock contextRef="FilingDateInstant">&lt;p style="page-break-before:always; line-height:0.75pt; width:100%; font-size:0.75pt;"&gt; &lt;/p&gt;
&lt;h3 class="smt_head2"&gt;５ 【従業員の状況】&lt;/h3&gt;
&lt;h4 class="smt_head3" style="padding-left:13.5pt;"&gt;(1) 連結会社の状況&lt;/h4&gt;&lt;p class="smt_unitR" style="orphans:0;widows:0;text-align:right;padding-left:359.2pt;padding-right:23pt;line-height:10pt;"&gt;&lt;span&gt;2024年３月31日&lt;/span&gt;現在&lt;/p&gt;
&lt;div class="tbld"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:467.8pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
&lt;col style="width:233.9pt;min-width:233.9pt;"/&gt;
