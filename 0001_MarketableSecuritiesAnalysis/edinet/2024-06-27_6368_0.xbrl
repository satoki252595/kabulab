  <jpcrp_cor:NotesRegardingDividendTextBlock contextRef="Prior1YearDuration">&lt;p class="smt_text2" style="orphans:0;widows:0;padding-left:0pt;text-indent:0pt;"&gt;３　配当に関する事項&lt;/p&gt;&lt;p class="smt_text2" style="orphans:0;widows:0;text-indent:0pt;"&gt;(1) 配当金支払額&lt;/p&gt;
