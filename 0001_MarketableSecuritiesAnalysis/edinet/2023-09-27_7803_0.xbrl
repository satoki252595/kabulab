&lt;tr style="height: 14px"&gt;
&lt;td colspan="2" style="vertical-align: middle; width: 340.4px; padding-top: 0px; padding-bottom: 0px; padding-left: 6.6px; padding-right: 6.6px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 20px; margin-bottom: 0.3em; text-align: center"&gt;既発行株式数＋新規発行株式数&lt;/p&gt;
&lt;/td&gt;
