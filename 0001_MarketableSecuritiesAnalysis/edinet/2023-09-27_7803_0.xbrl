&lt;td rowspan="3" style="vertical-align: middle; width: 94.6px; padding-top: 0px; padding-bottom: 0px; padding-left: 6.6px; padding-right: 6.6px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 20px; margin-right: 15.533333333333333333333333333px; text-align: center"&gt;調 整 前&lt;/p&gt;
&lt;p style="line-height: 20px; margin-right: 15.533333333333333333333333333px; text-align: center"&gt;行使価額&lt;/p&gt;
&lt;/td&gt;
