<span style="font-size: 8px" xmlns="http://www.w3.org/1999/xhtml">※１</span>
</link:footnote>
    <link:loc xlink:href="#IdFact2032279768" xlink:label="fact" xlink:type="locator"/>
    <link:footnoteArc xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="fact" xlink:to="footnote" xlink:type="arc"/>
  </link:footnoteLink>
  <link:footnoteLink xlink:role="http://disclosure.edinet-fsa.go.jp/role/jppfs/rol_ConsolidatedStatementOfIncome" xlink:type="extended">
    <link:footnote xlink:label="footnote" xlink:role="http://disclosure.edinet-fsa.go.jp/role/jppfs/role/NotesNumber" xlink:type="resource" xml:lang="ja">
<span style="font-size: 8px" xmlns="http://www.w3.org/1999/xhtml">※２</span>
