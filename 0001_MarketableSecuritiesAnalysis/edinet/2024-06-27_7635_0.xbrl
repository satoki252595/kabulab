&lt;thead&gt;
&lt;tr style="height: 33.67px"&gt;
&lt;td style="vertical-align: middle; width: 93px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; line-height: 13.333333333333333333333333333px; margin-right: 6px; text-align: center"&gt;年月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 555px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; line-height: 13.333333333333333333333333333px; margin-right: 6px; text-align: center"&gt;事　項&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/thead&gt;
&lt;tbody&gt;
&lt;tr style="height: 29.33px"&gt;
&lt;td style="vertical-align: middle; width: 93px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 8px; line-height: 21.333333333333333333333333333px; margin-right: 6px; text-align: left"&gt;1948年９月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 555px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 8px; line-height: 21.333333333333333333333333333px; margin-right: 8px; text-align: left"&gt;錠前及び建築金物の販売を目的として、東京都葛飾区本田渋江町341番地に株式会社杉田金属を設立&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 29.33px"&gt;
&lt;td style="vertical-align: middle; width: 93px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 8px; line-height: 21.333333333333333333333333333px; margin-right: 6px; text-align: left"&gt;1961年４月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 555px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 8px; line-height: 21.333333333333333333333333333px; margin-right: 8px; text-align: left"&gt;東京都墨田区緑町二丁目４番地に本社社屋を新設し、本社を移転&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 29.33px"&gt;
&lt;td style="vertical-align: middle; width: 93px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
