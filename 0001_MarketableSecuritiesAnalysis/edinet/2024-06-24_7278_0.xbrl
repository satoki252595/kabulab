&lt;td style="vertical-align: top; width: 163.73333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; text-align: justify; text-justify: inter-ideograph"&gt;　計&lt;/p&gt;
