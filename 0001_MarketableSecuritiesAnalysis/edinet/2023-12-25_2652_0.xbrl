  <jpcrp_cor:DescriptionOfBusinessTextBlock contextRef="FilingDateInstant">&lt;p style="page-break-before:always; line-height:0.75pt; width:100%; font-size:0.75pt;"&gt; &lt;/p&gt;
&lt;h3 class="smt_head2"&gt;３ 【事業の内容】&lt;/h3&gt;&lt;p class="smt_text2" style="orphans:0;widows:0;"&gt;当社は、日本のまんが関連古書、グッズ、アニメ関連商品等の仕入、販売を行い、単一の事業を営んでおります。&lt;/p&gt;&lt;p class="smt_text2" style="orphans:0;widows:0;"&gt;事業の系統図は、次のとおりであります。&lt;/p&gt;
&lt;div style="text-align:center;"&gt;&lt;img alt="" height="206" src="fuzoku/50_0796600102312.gif" width="362"/&gt;&lt;br/&gt;
&lt;/div&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;"&gt; &lt;/p&gt;</jpcrp_cor:DescriptionOfBusinessTextBlock>
  <jpcrp_cor:OverviewOfAffiliatedEntitiesTextBlock contextRef="FilingDateInstant">
&lt;h3 class="smt_head2"&gt;４ 【関係会社の状況】&lt;/h3&gt;&lt;p class="smt_text4" style="orphans:0;widows:0;text-align:justify;padding-left:9pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:9pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;"&gt;該当事項はありません。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;"&gt; &lt;/p&gt;</jpcrp_cor:OverviewOfAffiliatedEntitiesTextBlock>
  <jpcrp_cor:InformationAboutEmployeesTextBlock contextRef="FilingDateInstant">
