&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 192px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 18px; margin-right: 4px; text-align: left; text-indent: -12px"&gt;・顧客のビジネスモデル変革&lt;/p&gt;
&lt;p style="margin-left: 18px; margin-right: 4px; text-align: left; text-indent: -12px"&gt;・社会・制度提言、情報発信&lt;/p&gt;
&lt;p style="margin-left: 18px; margin-right: 4px; text-align: left; text-indent: -12px"&gt;　など&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 26.67px"&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 60px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 6px; margin-right: 4px; text-align: left"&gt;最適社会の共創&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 192px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 18px; margin-right: 4px; text-align: left; text-indent: -12px"&gt;・顧客のビジネスプロセス変革&lt;/p&gt;
&lt;p style="margin-left: 18px; margin-right: 4px; text-align: left; text-indent: -12px"&gt;・ビジネスプラットフォームによる共同利用促進　など&lt;/p&gt;
&lt;/td&gt;
