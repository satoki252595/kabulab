&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:67.5pt;min-height:67.5pt;"&gt;
&lt;td style="vertical-align:top;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;margin-top:1pt;line-height:13pt;"&gt;ファッション関連事業&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:top;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;margin-top:1pt;text-justify:inter-ideograph;text-indent:8.5pt;line-height:13pt;"&gt;ファッション製品の企画、生産、販売及び海外ブランド商品の輸入販売及びライセンスビジネス&lt;/p&gt;
&lt;/td&gt;
