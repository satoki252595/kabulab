  <jpcrp_cor:NotesRegardingAmountOfContractLiabilitiesTextBlock contextRef="CurrentYearInstant">&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:0pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;font-size:9pt;"&gt;※２   流動負債「その他」のうち、契約負債の金額は以下のとおりであります。&lt;/p&gt;
&lt;div class="tbld" style="margin-left:30.5pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:438.1pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
&lt;col style="width:145.5pt;min-width:145.5pt;"/&gt;
&lt;col style="width:86.3pt;min-width:86.3pt;"/&gt;
&lt;col style="width:60pt;min-width:60pt;"/&gt;
&lt;col style="width:86.3pt;min-width:86.3pt;"/&gt;
&lt;col style="width:60pt;min-width:60pt;"/&gt;
