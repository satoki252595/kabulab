&lt;td style="vertical-align: middle; width: 211.06666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; line-height: 13.333333333333333333333333333px; margin-right: 6px; text-align: left"&gt;外部顧客への売上高&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: bottom; width: 77.733333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 16px; margin-right: 6px; margin-bottom: 4px; text-align: right"&gt;8,349&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: bottom; width: 77.733333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 16px; margin-right: 6px; margin-bottom: 4px; text-align: right"&gt;4,049&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: bottom; width: 77.8px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 16px; margin-right: 6px; margin-bottom: 4px; text-align: right"&gt;12,398&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: bottom; width: 77.733333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 16px; margin-right: 6px; margin-bottom: 4px; text-align: right"&gt;7&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: bottom; width: 77.733333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 16px; margin-right: 6px; margin-bottom: 4px; text-align: right"&gt;12,406&lt;/p&gt;
