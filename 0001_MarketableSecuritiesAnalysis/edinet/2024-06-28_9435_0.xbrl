&lt;tr style="height:15pt;min-height:15pt;"&gt;
&lt;td colspan="2" style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:3.7pt;padding-right:3.7pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;line-height:10pt;font-size:7.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;資産&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td colspan="2" style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;padding-left:3.7pt;padding-right:3.7pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;line-height:10pt;font-size:7.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;負債&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
