&lt;tr style="height: 24px"&gt;
&lt;td style="vertical-align: middle; width: 230.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 36px; margin-right: 6px; text-align: left; text-indent: -24px"&gt;(1）長期借入金（※２）&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 138.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
