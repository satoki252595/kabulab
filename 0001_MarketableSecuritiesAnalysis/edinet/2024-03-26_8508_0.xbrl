&lt;tr style="height: 20px"&gt;
&lt;td style="vertical-align: middle; width: 45px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: center"&gt;『Ｕ』&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 30px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: center"&gt;=&lt;/p&gt;
