  <jpcrp_cor:NameOfSecuritiesInvestmentEquitySecuritiesReclassifiedFromHeldForPurposesOtherThanPureInvestmentToHeldForPureInvestmentLargestHoldingCompany contextRef="CurrentYearInstant_Row3Member">中国電力株式会社</jpcrp_cor:NameOfSecuritiesInvestmentEquitySecuritiesReclassifiedFromHeldForPurposesOtherThanPureInvestmentToHeldForPureInvestmentLargestHoldingCompany>
