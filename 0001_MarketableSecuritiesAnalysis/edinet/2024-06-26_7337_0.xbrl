&lt;/td&gt;
&lt;td style="vertical-align:top;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;line-height:10pt;font-size:10pt;"&gt; &lt;/p&gt;
&lt;div&gt;&lt;img alt="" height="186" src="fuzoku/54_c_0657200102406-01.gif" width="295"/&gt;&lt;br/&gt;
&lt;/div&gt;
