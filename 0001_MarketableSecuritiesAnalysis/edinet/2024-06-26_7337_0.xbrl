  <jpcrp_cor:NotesRegardingAmountsOfReductionEntryOfPropertyPlantAndEquipmentTextBlock contextRef="CurrentYearInstant">&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:18pt;text-indent:-18pt;line-height:6pt;font-size:6pt;"&gt; &lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:18pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:-18pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:12pt;font-size:9pt;"&gt;※９．有形固定資産の圧縮記帳額&lt;/p&gt;
