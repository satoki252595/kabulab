&lt;/td&gt;
&lt;td style="vertical-align:middle;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-right:4.5pt;"&gt;&lt;span style="font-size:7.5pt;"&gt;㈱コパ（現　㈱チョイズ）設立　代表取締役（現任）&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
