&lt;td style="vertical-align:top;border-top-style:solid;border-top-width:0.75pt;border-top-color:#0070c0;border-left-style:solid;border-left-width:0.75pt;border-left-color:#0070c0;border-right-style:solid;border-right-width:0.75pt;border-right-color:#0070c0;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;text-align:right;margin-top:2pt;line-height:10pt;"&gt;&lt;span style="color:#4f81bd;"&gt;(億円)&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td colspan="5" style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#0070c0;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#0070c0;border-left-style:solid;border-left-width:0.75pt;border-left-color:#0070c0;border-right-style:solid;border-right-width:0.75pt;border-right-color:#0070c0;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;line-height:8pt;"&gt;&lt;span style="font-family:&amp;apos;ＭＳ 明朝&amp;apos;;color:#4f81bd;"&gt;受注高&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
