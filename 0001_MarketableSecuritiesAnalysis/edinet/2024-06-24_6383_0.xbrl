&lt;/td&gt;
&lt;td style="vertical-align:top;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:right;padding-left:15pt;padding-right:15pt;line-height:16pt;"&gt;&lt;span&gt;10.2％増&lt;/span&gt;)&lt;/p&gt;
