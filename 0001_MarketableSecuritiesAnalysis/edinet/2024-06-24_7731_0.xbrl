&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:right;padding-left:2.2pt;padding-right:2.2pt;margin-top:2pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;line-height:10pt;"&gt;&lt;span style="font-size:9pt;"&gt;67％&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
