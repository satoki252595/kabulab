  <jpcrp_cor:NotesRegardingPromissoryNotesDueOnBalanceSheetDateTextBlock contextRef="CurrentYearInstant">
&lt;p style="margin-left: 36px; text-align: justify; text-justify: inter-ideograph; text-indent: -24px"&gt;※5　期末日満期手形&lt;/p&gt;
