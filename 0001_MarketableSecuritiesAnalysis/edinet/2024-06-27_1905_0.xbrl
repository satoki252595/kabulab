&lt;tr&gt;
&lt;td style="vertical-align: middle; width: 366.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 18px; line-height: 17.333333333333333333333333333px; margin-right: 6px; text-align: left; text-indent: -12px"&gt;・取締役会決議による自己株式の取得による増加&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 114px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
