&lt;tr style="height:21pt;min-height:21pt;"&gt;
&lt;td style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;"&gt;ａ．グループ体制図&lt;/p&gt;
&lt;/td&gt;
&lt;td colspan="3" style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;"&gt;ｂ.サステナビリティ委員会&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:17.9pt;min-height:17.9pt;"&gt;
&lt;td rowspan="9" style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;
