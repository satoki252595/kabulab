  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E01464-000OgasawaraMinoruMember">1954-08-30</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
