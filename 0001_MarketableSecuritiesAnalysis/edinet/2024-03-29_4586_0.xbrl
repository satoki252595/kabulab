&lt;col style="width:93.6pt;min-width:93.6pt;"/&gt;
&lt;col style="width:94.1pt;min-width:94.1pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:18.5pt;min-height:18.5pt;"&gt;
