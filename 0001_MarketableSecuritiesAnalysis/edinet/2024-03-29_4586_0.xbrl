  <jpcrp_cor:ConsolidatedStatementOfChangesInEquityTextBlock contextRef="CurrentYearDuration">
&lt;h5 class="smt_head4"&gt;③【連結株主資本等変動計算書】&lt;/h5&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:0pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:9pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;font-size:9pt;"&gt;前連結会計年度(自 2022年１月１日　至 2022年12月31日)&lt;/p&gt;
&lt;div class="tbld" style="margin-left:0pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
