&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:9pt;padding-right:2pt;margin-top:1pt;margin-bottom:1pt;"&gt;発行価格     　105&lt;br/&gt;資本組入額   　 52.5(注)2&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
