&lt;tr style="height:35.3pt;min-height:35.3pt;"&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;line-height:12pt;"&gt;本社&lt;/p&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;text-align:justify;line-height:12pt;"&gt; (香川県&lt;br/&gt;　　東かがわ市)&lt;/p&gt;
&lt;/td&gt;
