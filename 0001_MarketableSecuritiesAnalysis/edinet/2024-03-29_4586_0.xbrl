  <jpcrp_cor:NotesLeasesConsolidatedFinancialStatementsTextBlock contextRef="CurrentYearDuration">&lt;p style="page-break-before:always; line-height:0.75pt; width:100%; font-size:0.75pt;"&gt; &lt;/p&gt;
&lt;h6 class="smt_head4" style="padding-left:18pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;text-align:justify;letter-spacing:0pt;line-height:15pt;font-size:9pt;"&gt;(リース取引関係)&lt;/h6&gt;&lt;p class="smt_text2" style="orphans:0;widows:0;padding-left:13.5pt;"&gt;オペレーティング・リース取引&lt;/p&gt;&lt;p class="smt_text2" style="orphans:0;widows:0;padding-left:13.5pt;"&gt;（借主側）&lt;/p&gt;&lt;p class="smt_text3" style="orphans:0;widows:0;padding-left:22.5pt;"&gt;オペレーティング・リース取引のうち、解約不能のものに係る未経過リース料&lt;/p&gt;
&lt;div class="tbld" style="margin-left:21.6pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:450.6pt;table-layout:fixed;"&gt;
