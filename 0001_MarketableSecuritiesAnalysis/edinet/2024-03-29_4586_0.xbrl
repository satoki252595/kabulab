&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:9pt;padding-right:2pt;margin-top:1pt;margin-bottom:1pt;"&gt;&lt;span style="font-size:9pt;"&gt;発行価格     　302&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:9pt;"&gt;資本組入額   　151 (注)2&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
