  <jpcrp_cor:MajorShareholdersTextBlock contextRef="FilingDateInstant">
&lt;h4&gt;（６）【大株主の状況】&lt;/h4&gt;
&lt;p style="line-height: 1.3333333333333333333333333333px; text-align: left"&gt; &lt;/p&gt;
&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 647px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 208px"/&gt;
&lt;col style="width: 241px"/&gt;
&lt;col style="width: 89px"/&gt;
