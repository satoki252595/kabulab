&lt;col style="width: 114.53333333333333333333333333px"/&gt;
&lt;col style="width: 28px"/&gt;
&lt;col style="width: 100.66666666666666666666666667px"/&gt;
&lt;col style="width: 28px"/&gt;
&lt;col style="width: 182.4px"/&gt;
