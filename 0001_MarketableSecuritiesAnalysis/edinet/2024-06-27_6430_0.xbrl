  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E02073-000ImaiNobuyukiMember">1961-02-25</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
