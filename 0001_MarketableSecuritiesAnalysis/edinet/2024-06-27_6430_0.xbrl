&lt;col style="width:65pt;min-width:65pt;"/&gt;
&lt;col style="width:43pt;min-width:43pt;"/&gt;
&lt;col style="width:51.1pt;min-width:51.1pt;"/&gt;
&lt;col style="width:55.7pt;min-width:55.7pt;"/&gt;
&lt;col style="width:43pt;min-width:43pt;"/&gt;
