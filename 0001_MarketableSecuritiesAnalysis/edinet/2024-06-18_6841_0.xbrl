&lt;div style="margin-left: 56px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 519.46666666666666666666666667px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 48px"/&gt;
&lt;col style="width: 471.46666666666666666666666667px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr&gt;
&lt;td style="border-left: 0px none #000000; border-top: 0px none #000000; border-right: 0px none #000000; border-bottom: 0px none #000000; width: 48px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: justify; line-height: 17.333333333333333333333333333px; text-justify: inter-ideograph"&gt;（注）&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 0px none #000000; border-top: 0px none #000000; border-right: 0px none #000000; border-bottom: 0px none #000000; width: 471.46666666666666666666666667px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: justify; line-height: 17.333333333333333333333333333px; text-justify: inter-ideograph"&gt;報酬等の総額が1億円以上であった役員を記載しています。&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
