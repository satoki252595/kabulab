&lt;tr style="height: 26.67px"&gt;
&lt;td style="vertical-align: middle; width: 215.46666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; margin-right: 4px; text-align: left"&gt;株主総利回り&lt;/p&gt;
