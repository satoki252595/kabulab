&lt;p style="margin-left: 0px; margin-right: 0px; text-align: left; line-height: 17.333333333333333333333333333px"&gt;負債合計&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 0px none #000000; border-top: 1px solid #000000; border-right: 0px none #000000; border-bottom: 1px solid #000000; width: 108px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 0px; margin-right: 36px; text-align: right; line-height: 17.333333333333333333333333333px"&gt;238&lt;/p&gt;
