&lt;p style="margin-left: 36px; text-align: left"&gt; &lt;/p&gt;
</jpcrp030000-asr_E01503-000:RiskManagementTextBlock>
  <jpcrp030000-asr_E01503-000:MetricsAndTargetsTextBlock contextRef="FilingDateInstant">
