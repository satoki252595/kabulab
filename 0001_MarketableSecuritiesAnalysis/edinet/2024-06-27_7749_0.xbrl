&lt;p style="margin-left: 12px; text-align: left"&gt;宮崎県日向市&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 220.86666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt;遊休資産&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 220.73333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt;土地&lt;/p&gt;
