&lt;tbody&gt;
&lt;tr style="height: 14.27px"&gt;
&lt;td style="vertical-align: top; width: 60.666666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
