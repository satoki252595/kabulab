&lt;td style="vertical-align: middle; width: 91px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 3px double #000000"&gt;
&lt;p style="margin-right: 12px; text-align: right"&gt;314,429&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 91px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 3px double #000000"&gt;
&lt;p style="margin-right: 12px; text-align: right"&gt;△31,236&lt;/p&gt;
&lt;/td&gt;
