  <jpcrp_cor:MajorFacilitiesTextBlock contextRef="FilingDateInstant">&lt;p style="page-break-before:always; line-height:0.75pt; width:100%; font-size:0.75pt;"&gt; &lt;/p&gt;
&lt;h3 class="smt_head2" style="line-height:18pt;"&gt;２ 【主要な設備の状況】&lt;/h3&gt;
&lt;h4 class="smt_head3" style="line-height:17pt;"&gt;(1)　提出会社&lt;/h4&gt;&lt;p class="smt_unitR" style="orphans:0;widows:0;text-align:right;padding-left:0pt;padding-right:2pt;"&gt;　 &lt;span&gt;2024年３月31日&lt;/span&gt;現在&lt;/p&gt;
&lt;div class="tbld" style="margin-left:20pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:463.7pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
&lt;col style="width:92.3pt;min-width:92.3pt;"/&gt;
&lt;col style="width:56.3pt;min-width:56.3pt;"/&gt;
&lt;col style="width:62.3pt;min-width:62.3pt;"/&gt;
&lt;col style="width:45pt;min-width:45pt;"/&gt;
&lt;col style="width:45pt;min-width:45pt;"/&gt;
&lt;col style="width:45pt;min-width:45pt;"/&gt;
&lt;col style="width:48.8pt;min-width:48.8pt;"/&gt;
&lt;col style="width:45pt;min-width:45pt;"/&gt;
&lt;col style="width:24pt;min-width:24pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:14.3pt;min-height:14.3pt;"&gt;
