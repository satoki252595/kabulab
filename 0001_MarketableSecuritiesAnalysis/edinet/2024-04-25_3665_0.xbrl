&lt;td style="vertical-align: middle; width: 160px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 36px; line-height: 13.333333333333333333333333333px; text-align: left; text-indent: -12px"&gt;取得期間&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 288px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 36px; line-height: 13.333333333333333333333333333px; text-align: left; text-indent: -12px"&gt;2022年３月18日～2023年２月28日&lt;/p&gt;
