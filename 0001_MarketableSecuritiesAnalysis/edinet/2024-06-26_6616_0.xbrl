&lt;p style="line-height: 14.666666666666666666666666667px; text-align: left"&gt;(ＶＤ：Voltage Ditector)&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 15.533333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px dashed #000000; border-right: 0px none ; border-bottom: 1px dashed #000000"&gt;
&lt;p style="line-height: 14.666666666666666666666666667px; text-align: left"&gt;
