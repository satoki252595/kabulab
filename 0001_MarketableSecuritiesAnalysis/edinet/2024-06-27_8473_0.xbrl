&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 302.66666666666666666666666667px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 60px"/&gt;
&lt;col style="width: 242.66666666666666666666666667px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr style="height: 12px"&gt;
