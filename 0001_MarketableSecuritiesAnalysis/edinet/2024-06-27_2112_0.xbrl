&lt;td style="vertical-align:top;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:5.4pt;padding-right:0pt;margin-top:0.0pt;margin-bottom:0.0pt;letter-spacing:0pt;line-height:13pt;"&gt;自　&lt;span&gt;2023年10月１日&lt;/span&gt;&lt;br/&gt;至　&lt;span&gt;2023年12月31日&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:top;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:5.4pt;padding-right:5.4pt;letter-spacing:0pt;line-height:13pt;font-size:13pt;"&gt; &lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:5.4pt;padding-right:5.4pt;margin-top:0.0pt;margin-bottom:0.0pt;letter-spacing:0.0pt;line-height:13pt;font-size:13pt;"&gt; &lt;/p&gt;
