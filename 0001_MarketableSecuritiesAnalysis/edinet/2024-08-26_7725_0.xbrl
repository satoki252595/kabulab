&lt;p style="margin-left: 54px; line-height: 12px; margin-top: 6px; text-align: left; text-indent: -54px"&gt; &lt;/p&gt;
</jpcrp_cor:NotesRegardingNewShareSubscriptionRightsEtcTextBlock>
