  <jpcrp_cor:AnnexedDetailedScheduleOfAssetRetirementObligationsFinancialStatementsTextBlock contextRef="CurrentYearDuration">
&lt;h6 class="smt_head5" style="padding-left:36pt;"&gt;【資産除去債務明細表】&lt;/h6&gt;&lt;p class="smt_text5" style="orphans:0;widows:0;"&gt;該当事項はありません。&lt;/p&gt;</jpcrp_cor:AnnexedDetailedScheduleOfAssetRetirementObligationsFinancialStatementsTextBlock>
