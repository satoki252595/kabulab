  <jpigp_cor:NotesRelatedPartiesConsolidatedFinancialStatementsIFRSTextBlock contextRef="CurrentYearDuration">&lt;p class="smt_head6" style="orphans:0;widows:0;"&gt;31．関連当事者&lt;/p&gt;
