&lt;td style="vertical-align: middle; width: 194px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt; 経営指標&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 143px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt;中期的な目標値&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 143px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt; 2023年３月期（実績）&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 143px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt; 2024年３月期（実績）&lt;/p&gt;
&lt;/td&gt;
