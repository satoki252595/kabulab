&lt;/td&gt;
&lt;td style="vertical-align:middle;border-bottom-style:solid;border-bottom-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:4.5pt;line-height:13pt;"&gt;&lt;span style="font-size:9pt;"&gt;現金&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
