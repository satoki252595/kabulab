&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:2.6pt;padding-right:2.6pt;margin-top:1.5pt;margin-bottom:1.5pt;letter-spacing:0pt;"&gt; &lt;/p&gt;
&lt;/td&gt;
