&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;letter-spacing:0pt;line-height:12pt;"&gt;前連結会計年度&lt;/p&gt;&lt;p class="smt_tblR" style="orphans:0;widows:0;text-align:center;padding-right:9.1pt;letter-spacing:0pt;"&gt;(自　&lt;span&gt;2022年４月１日&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_tblR" style="orphans:0;widows:0;text-align:center;letter-spacing:0pt;"&gt; 至　&lt;span&gt;2023年３月31日&lt;/span&gt;)&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:top;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;letter-spacing:0pt;line-height:12pt;"&gt;当連結会計年度&lt;/p&gt;&lt;p class="smt_tblR" style="orphans:0;widows:0;text-align:center;padding-right:9.1pt;letter-spacing:0pt;"&gt;(自　&lt;span&gt;2023年４月１日&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_tblR" style="orphans:0;widows:0;text-align:center;letter-spacing:0pt;"&gt; 至　&lt;span&gt;2024年３月31日&lt;/span&gt;)&lt;/p&gt;
