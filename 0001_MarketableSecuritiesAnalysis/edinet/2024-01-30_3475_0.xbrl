&lt;p style="margin-left: 6px; margin-right: 6px; text-align: left"&gt;社外監査役&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 86.06666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: left"&gt;小泉　始&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 66.6px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
