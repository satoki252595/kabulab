&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr style="height: 25.27px"&gt;
&lt;td style="vertical-align: middle; width: 199.46666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
