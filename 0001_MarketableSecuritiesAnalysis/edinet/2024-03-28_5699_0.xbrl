&lt;col style="width: 162px"/&gt;
&lt;col style="width: 162px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr style="height: 18px"&gt;
&lt;td style="vertical-align: middle; width: 95.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;
&lt;p style="text-align: right"&gt;
&lt;span style="font-size: 12px"&gt; &lt;/span&gt;
