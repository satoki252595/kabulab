</jpcrp030000-asr_E34130-000:StrategyTextBlock>
  <jpcrp030000-asr_E34130-000:PolicyOnHumanResourceDevelopmentAndImprovementOfInternalEnvironmentStrategyTextBlock contextRef="FilingDateInstant">
