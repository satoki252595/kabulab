&lt;col style="width:112.1pt;min-width:112.1pt;"/&gt;
&lt;col style="width:137.1pt;min-width:137.1pt;"/&gt;
&lt;col style="width:80pt;min-width:80pt;"/&gt;
&lt;/colgroup&gt;
