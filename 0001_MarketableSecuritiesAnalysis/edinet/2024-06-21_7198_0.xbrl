&lt;tbody&gt;
&lt;tr style="height: 34.67px"&gt;
&lt;td style="vertical-align: middle; width: 204.2px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
