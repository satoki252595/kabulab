&lt;td style="vertical-align:middle;border-top-color:#000000;border-bottom-color:#000000;border-left-color:#000000;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:right;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;line-height:12pt;font-size:7.5pt;"&gt;35&lt;/p&gt;
&lt;/td&gt;
