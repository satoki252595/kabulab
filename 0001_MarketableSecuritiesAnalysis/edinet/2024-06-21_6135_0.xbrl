&lt;div class="tbld" style="text-align:left;"&gt;
&lt;table cellpadding="0" cellspacing="0" class="align_left" style="border-collapse:collapse;border:solid 0pt #000000;width:473.3pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
