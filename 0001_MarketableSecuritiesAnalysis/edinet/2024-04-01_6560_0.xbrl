&lt;/td&gt;
&lt;td style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblR" style="orphans:0;widows:0;line-height:12pt;font-size:9pt;"&gt;1,963,200千円&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
