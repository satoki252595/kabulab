  <jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E00069-000TominagaTetsuoMember">冨永　哲夫</jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E00069-000TominagaTetsuoMember">1959-02-10</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock contextRef="FilingDateInstant_jpcrp030000-asr_E00069-000TominagaTetsuoMember">
&lt;p style="margin-left: 6px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;1982年４月　　大蔵省（現　財務省）入省&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 6px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;1988年７月　　伊丹税務署長&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 6px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;1999年１月　　在大韓民国日本国大使館参事官&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 6px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;2003年７月　　内閣官房長官秘書官事務取扱&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 6px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;2005年７月　　財務省主計局主計官&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 6px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;2008年７月　　内閣官房内閣参事官&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 6px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;2010年７月　　内閣府本府行政刷新会議事務局次長&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 6px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;2012年８月　　財務省理財局次長&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 6px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;2013年６月　　名古屋国税局長&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 6px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;2014年７月　　近畿財務局長&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 6px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;2015年７月　　財務総合政策研究所長&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 6px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;2016年６月　　国土交通省政策統括官&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 6px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;2019年４月　　三菱地所株式会社顧問&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 6px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;2019年４月　　三菱地所レジデンス株式会社監査役&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 6px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;2019年４月　　株式会社三菱地所設計監査役&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 76px; text-align: left; text-indent: -70px"&gt;
&lt;span style="font-size: 10px"&gt;2024年３月　　一般社団法人日本女子ソフトボールリーグ機構代表理事兼チェアマン&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 140px; text-align: left; text-indent: -70px"&gt;
&lt;span style="font-size: 10px"&gt;（現任）&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 76px; text-align: left; text-indent: -70px"&gt;
&lt;span style="font-size: 10px"&gt;2024年６月　　当社監査役（現任）&lt;/span&gt;
&lt;/p&gt;
</jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock>
