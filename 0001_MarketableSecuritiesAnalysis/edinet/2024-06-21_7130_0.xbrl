&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;text-align:center;padding-left:1.7pt;font-size:7.5pt;"&gt;&lt;span style="font-size:7.5pt;"&gt;食品関連&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:7.5pt;"&gt;糖粉・飼料&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:7.5pt;"&gt;畜産関連&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:7.5pt;"&gt;住宅・不動産&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:7.5pt;"&gt;関連&lt;/span&gt;&lt;/p&gt;
