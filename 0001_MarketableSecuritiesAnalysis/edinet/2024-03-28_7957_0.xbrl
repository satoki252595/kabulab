&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:188.8pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
&lt;col style="width:46.5pt;min-width:46.5pt;"/&gt;
