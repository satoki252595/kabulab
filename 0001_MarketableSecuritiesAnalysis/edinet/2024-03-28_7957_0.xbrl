&lt;tr style="height:17.8pt;min-height:17.8pt;"&gt;
&lt;td style="vertical-align:middle;border-top-style:double;border-top-width:2.25pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;"&gt;合計&lt;/p&gt;
