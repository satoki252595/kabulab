&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;padding-left:0pt;padding-right:0pt;margin-top:2pt;margin-bottom:2pt;line-height:11pt;font-size:7.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;土地&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:9pt;"&gt;(面積㎡)&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;padding-left:0pt;padding-right:0pt;line-height:11pt;font-size:7.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;その他&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
