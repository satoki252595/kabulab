&lt;/div&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:justify;padding-left:4.5pt;padding-right:4.5pt;margin-top:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:3pt;font-size:3pt;"&gt; &lt;/p&gt;
&lt;div style="padding-left:4.5pt;"&gt;&lt;img alt="" height="44" src="fuzoku/sdg_icon_09_ja_2.png" width="44"/&gt;&lt;br/&gt;
&lt;/div&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:justify;padding-left:4.5pt;padding-right:4.5pt;margin-top:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:3pt;font-size:3pt;"&gt; &lt;/p&gt;
&lt;div style="padding-left:4.5pt;"&gt;&lt;img alt="" height="44" src="fuzoku/sdg_icon_12_ja_2.png" width="44"/&gt;&lt;br/&gt;
&lt;/div&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:justify;padding-left:4.5pt;padding-right:4.5pt;margin-top:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:3pt;font-size:3pt;"&gt; &lt;/p&gt;
&lt;div style="padding-left:4.5pt;"&gt;&lt;img alt="" height="44" src="fuzoku/sdg_icon_17_ja_2.png" width="44"/&gt;&lt;br/&gt;
