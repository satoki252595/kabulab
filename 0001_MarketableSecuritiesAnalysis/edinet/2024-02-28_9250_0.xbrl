&lt;/tr&gt;
&lt;tr style="height: 1.33px"&gt;
&lt;td colspan="3" style="vertical-align: middle; width: 146.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; margin-bottom: 6px; margin-top: 6px; text-align: center"&gt;時価&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 1.33px"&gt;
&lt;td colspan="5" style="vertical-align: middle; width: 233.33333333333333333333333334px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p class="text_align_justify"&gt;既発行株式数 ＋ 新規発行株式数&lt;/p&gt;
