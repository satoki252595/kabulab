&lt;td style="vertical-align: bottom; width: 26.666666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; margin-bottom: 12px; text-align: center"&gt;×&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 60px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p class="text_align_justify" style="line-height: 13.333333333333333333333333333px"&gt;１株当たり&lt;/p&gt;
&lt;p class="text_align_justify" style="line-height: 13.333333333333333333333333333px; margin-bottom: 6px"&gt;払込金額&lt;/p&gt;
