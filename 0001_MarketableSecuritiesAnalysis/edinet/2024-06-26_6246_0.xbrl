&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center"&gt;平松　亜矢子&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 86.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; line-height: 25.333333333333333333333333333px; margin-right: 6px; text-align: right"&gt;12回&lt;/p&gt;
&lt;/td&gt;
