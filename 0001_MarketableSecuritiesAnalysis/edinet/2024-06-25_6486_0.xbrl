&lt;p style="margin-left: 18px; line-height: 6.6666666666666666666666666667px; text-align: left"&gt; &lt;/p&gt;
&lt;div style="margin-left: 12px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 624px"&gt;
