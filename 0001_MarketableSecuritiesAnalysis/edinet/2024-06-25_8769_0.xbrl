&lt;p style="margin-left: 6px; text-align: center"&gt;2022年３月31日&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 138.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; text-align: center"&gt;2022年６月29日&lt;/p&gt;
