  <jpcrp_cor:NotesLeasesConsolidatedFinancialStatementsTextBlock contextRef="CurrentYearDuration">
&lt;h6&gt;（リース取引関係）&lt;/h6&gt;
&lt;p style="margin-left: 12px; text-align: left"&gt;（借主側）&lt;/p&gt;
&lt;p style="margin-left: 12px; text-align: left"&gt;オペレーティング・リース取引&lt;/p&gt;
&lt;p style="margin-left: 24px; text-align: left"&gt;オペレーティング・リース取引のうち解約不能のものに係る未経過リース料&lt;/p&gt;
&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 648px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 648px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr&gt;
&lt;td style="vertical-align: middle; width: 648px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: right"&gt;（単位：千円）&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;/div&gt;
