  <jpcrp_cor:InformationAboutEmployeesTextBlock contextRef="FilingDateInstant">
&lt;h3 class="smt_head2"&gt;５ 【従業員の状況】&lt;/h3&gt;
&lt;h4 class="smt_head3"&gt;&lt;span style="font-family:&amp;apos;ＭＳ 明朝&amp;apos;;font-size:9pt;"&gt;(1) 連結会社の状況&lt;/span&gt;
&lt;/h4&gt;&lt;p class="smt_unitR" style="orphans:0;widows:0;padding-left:368.3pt;line-height:10pt;"&gt;&lt;span&gt;2023年12月31日&lt;/span&gt;現在&lt;/p&gt;
&lt;div class="tbld" style="margin-left:0pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:479.3pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
&lt;col style="width:262.5pt;min-width:262.5pt;"/&gt;
&lt;col style="width:201.5pt;min-width:201.5pt;"/&gt;
&lt;col style="width:15pt;min-width:15pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:22.5pt;min-height:22.5pt;"&gt;
