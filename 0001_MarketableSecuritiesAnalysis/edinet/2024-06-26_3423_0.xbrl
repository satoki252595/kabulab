&lt;p style="margin-left: 5.3333333333333333333333333333px; line-height: 15px; margin-right: 5.3333333333333333333333333333px; text-align: right"&gt;
&lt;span style="font-size: 10px"&gt;2024年３月31日現在&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
