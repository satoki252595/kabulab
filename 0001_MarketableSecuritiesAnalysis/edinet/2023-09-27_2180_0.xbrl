&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 70px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 14.666666666666666666666666667px; text-align: center"&gt;１株当たり&lt;br/&gt;配当額&lt;/p&gt;
&lt;p style="line-height: 14.666666666666666666666666667px; text-align: center"&gt;（円）&lt;/p&gt;
&lt;/td&gt;
