  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E21381-000HattoriKeikoMember">1976-01-29</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock contextRef="FilingDateInstant_jpcrp030000-asr_E21381-000HattoriKeikoMember">
&lt;p style="margin-left: 60px; line-height: 15px; margin-right: 2px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;1998年４月 株式会社富士銀行（現株式会社みずほ銀行）入行&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; line-height: 15px; margin-right: 2px; text-align: left; text-indent: -55px"&gt;
