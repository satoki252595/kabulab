  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E21381-000WatanabeNorihitoMember">1968-03-02</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock contextRef="FilingDateInstant_jpcrp030000-asr_E21381-000WatanabeNorihitoMember">
&lt;p style="margin-left: 60px; line-height: 15px; margin-right: 2px; text-align: left; text-indent: -55px"&gt;
