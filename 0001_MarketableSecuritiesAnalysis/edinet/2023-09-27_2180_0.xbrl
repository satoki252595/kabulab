&lt;tr style="height: 15.33px"&gt;
&lt;td style="vertical-align: middle; width: 293.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none ; background-color: #FFFFFF"&gt;
&lt;p style="margin-left: 10px; line-height: 15.333333333333333333333333333px; text-align: left"&gt;現金及び現金同等物の増減額（△は減少）&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 166.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;
&lt;p style="line-height: 15.333333333333333333333333333px; margin-right: 3px; text-align: right"&gt;
627,100
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 166.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;
&lt;p style="line-height: 15.333333333333333333333333333px; margin-right: 3px; text-align: right"&gt;△140,237&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 15.33px"&gt;
&lt;td style="vertical-align: middle; width: 293.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none ; background-color: #CCEEFF"&gt;
&lt;p style="margin-left: 10px; line-height: 15.333333333333333333333333333px; text-align: left"&gt;現金及び現金同等物の期首残高&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 166.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none ; background-color: #CCEEFF"&gt;
&lt;p style="line-height: 15.333333333333333333333333333px; margin-right: 3px; text-align: right"&gt;
2,587,272
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 166.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none ; background-color: #CCEEFF"&gt;
&lt;p style="line-height: 15.333333333333333333333333333px; margin-right: 3px; text-align: right"&gt;
3,214,372
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 15.33px"&gt;
&lt;td style="vertical-align: middle; width: 293.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none ; background-color: #FFFFFF"&gt;
&lt;p style="margin-left: 10px; line-height: 15.333333333333333333333333333px; text-align: left"&gt;現金及び現金同等物の期末残高&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 166.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;
