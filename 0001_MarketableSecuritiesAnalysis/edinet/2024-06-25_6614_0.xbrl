&lt;p style="line-height: 16px; margin-right: 36px; text-align: right"&gt;200,823&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 1.33px"&gt;
&lt;td style="vertical-align: top; width: 144px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 16px; text-align: justify; text-justify: inter-ideograph"&gt;負債合計&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 108px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 16px; margin-right: 36px; text-align: right"&gt;206,491&lt;/p&gt;
&lt;/td&gt;
