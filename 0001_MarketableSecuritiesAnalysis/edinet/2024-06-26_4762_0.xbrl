&lt;td style="vertical-align: middle; width: 160px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px dashed #000000"&gt;
&lt;p style="line-height: 1.5; margin-right: 8px; text-align: right"&gt;％&lt;/p&gt;
&lt;p style="margin-right: 48px; text-align: right"&gt;
&lt;span style="font-weight: bold"&gt;3.4&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
