&lt;tr style="height: 18.47px"&gt;
&lt;td style="vertical-align: middle; width: 165px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;
&lt;p style="margin-left: 12px; margin-right: 12px; text-align: left"&gt;
取締役会決議
&lt;/p&gt;
