&lt;tr style="height: 46.67px"&gt;
&lt;td style="vertical-align: top; width: 128px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: left"&gt;※１ ISP&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 16px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: left"&gt;：&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 448px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; text-align: justify; text-justify: inter-ideograph"&gt;Internet Service Providerの略。&lt;/p&gt;
&lt;p style="margin-left: 6px; text-align: justify; text-justify: inter-ideograph"&gt;公衆通信回線等を経由して契約者にインターネットへの接続を提供する事業者&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 64.27px"&gt;
&lt;td style="vertical-align: top; width: 128px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: left"&gt;※２ MSP&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 16px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: left"&gt;：&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 448px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; text-align: justify; text-justify: inter-ideograph"&gt;Managed Service Providerの略。&lt;/p&gt;
&lt;p style="margin-left: 6px; text-align: justify; text-justify: inter-ideograph"&gt;顧客の利用するコンピュータやネットワーク等のITシステムの運用や監視、保守等を行い、利用可能な状態に維持するサービスを提供する事業者&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;/div&gt;
</jpcrp_cor:DescriptionOfBusinessTextBlock>
  <jpcrp_cor:OverviewOfAffiliatedEntitiesTextBlock contextRef="FilingDateInstant">
&lt;h3&gt;４【関係会社の状況】&lt;/h3&gt;
&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 648px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 156px"/&gt;
&lt;col style="width: 84px"/&gt;
&lt;col style="width: 72px"/&gt;
&lt;col style="width: 131px"/&gt;
&lt;col style="width: 73px"/&gt;
&lt;col style="width: 132px"/&gt;
&lt;/colgroup&gt;
&lt;thead&gt;
&lt;tr style="height: 36.27px"&gt;
&lt;td style="vertical-align: middle; width: 156px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;名称&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 84px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;住所&lt;/p&gt;
&lt;/td&gt;
