&lt;p style="margin-left: 6px; margin-right: 6px; text-align: left; line-height: 17.333333333333333333333333333px"&gt; &lt;/p&gt;
&lt;p style="margin-left: 6.6666666666666666666666666667px; margin-right: 6.6666666666666666666666666667px; text-align: left; line-height: 17.333333333333333333333333333px"&gt; &lt;/p&gt;
&lt;p style="margin-left: 6.6666666666666666666666666667px; margin-right: 6.6666666666666666666666666667px; text-align: left; line-height: 17.333333333333333333333333333px"&gt; &lt;/p&gt;
