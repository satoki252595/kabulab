&lt;/colgroup&gt;
&lt;tr style="height:57pt;min-height:57pt;"&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;font-size:7.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;名称&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
