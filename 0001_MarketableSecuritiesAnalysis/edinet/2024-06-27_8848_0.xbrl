  <jpcrp_cor:NotesBusinessCombinationsConsolidatedFinancialStatementsTextBlock contextRef="CurrentYearDuration">&lt;p style="page-break-before:always; line-height:0.75pt; width:100%; font-size:0.75pt;"&gt; &lt;/p&gt;
&lt;h6 class="smt_head5" style="padding-left:0pt;"&gt;(企業結合等関係)&lt;/h6&gt;&lt;p class="smt_text2" style="orphans:0;widows:0;padding-left:4.5pt;margin-top:1pt;"&gt;該当事項はありません。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:9pt;padding-right:0pt;margin-top:2pt;margin-bottom:0pt;text-indent:9pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:10pt;font-size:10pt;"&gt; &lt;/p&gt;</jpcrp_cor:NotesBusinessCombinationsConsolidatedFinancialStatementsTextBlock>
  <jpcrp_cor:NotesAssetRetirementObligationsConsolidatedFinancialStatementsTextBlock contextRef="CurrentYearDuration">
&lt;h6 class="smt_head2"&gt;&lt;span style="font-size:9pt;"&gt;(資産除去債務関係)&lt;/span&gt;
