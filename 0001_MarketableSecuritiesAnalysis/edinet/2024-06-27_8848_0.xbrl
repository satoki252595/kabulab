&lt;/tr&gt;
&lt;tr style="height:16pt;min-height:16pt;"&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#d8d8d8;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#ffffff;border-left-style:solid;border-left-width:0.75pt;border-left-color:#d8d8d8;border-right-style:solid;border-right-width:0.75pt;border-right-color:#ffffff;background-color:#ebf1dd;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;line-height:9pt;"&gt;&lt;span style="font-family:&amp;apos;ＭＳ Ｐゴシック&amp;apos;;font-size:9pt;"&gt;スコープ１（t-CO&lt;/span&gt;&lt;span style="font-family:&amp;apos;ＭＳ Ｐゴシック&amp;apos;;font-size:9pt;"&gt;&lt;sub&gt;2&lt;/sub&gt;&lt;/span&gt;&lt;span style="font-family:&amp;apos;ＭＳ Ｐゴシック&amp;apos;;font-size:9pt;"&gt;）&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
