&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#ffffff;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#d8d8d8;border-left-style:solid;border-left-width:0.75pt;border-left-color:#ffffff;border-right-style:solid;border-right-width:0.75pt;border-right-color:#d8d8d8;background-color:#ebf1dd;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:right;line-height:9pt;font-size:9pt;"&gt;&lt;span style="font-family:&amp;apos;ＭＳ ゴシック&amp;apos;;font-size:9pt;"&gt;136.2&lt;/span&gt;&lt;/p&gt;
