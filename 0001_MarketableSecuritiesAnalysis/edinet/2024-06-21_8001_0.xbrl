&lt;td style="vertical-align: top; width: 159.2px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 23.533333333333333333333333333px; text-align: left"&gt;金属：&lt;/p&gt;
