&lt;td style="vertical-align: top; width: 159.2px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 23.533333333333333333333333333px; text-align: left"&gt;情報・金融：&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 472px; padding-top: 0px; padding-bottom: 0px; padding-left: 4px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p class="text_align_justify"&gt;ITソリューション・インターネット関連サービス事業、携帯流通及びアフターサービス事業等の情報・通信分野、各種金融サービス事業や保険事業等の金融・保険分野に&lt;/p&gt;
&lt;p style="text-align: justify; text-justify: inter-ideograph"&gt;おいて事業を行っております。&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 20px"&gt;
&lt;td style="vertical-align: top; width: 159.2px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
