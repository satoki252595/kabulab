&lt;/td&gt;
&lt;td style="vertical-align: top; width: 136.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px dashed #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-bottom: 2.6666666666666666666666666667px; margin-top: 2.6666666666666666666666666667px; text-align: center"&gt;営業利益率達成率&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 94.46666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-bottom: 2.6666666666666666666666666667px; margin-top: 2.6666666666666666666666666667px; text-align: center"&gt;業績連動係数&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 16px"&gt;
&lt;td style="vertical-align: top; width: 110.86666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-bottom: 2.6666666666666666666666666667px; margin-top: 2.6666666666666666666666666667px; text-align: justify; text-justify: inter-ideograph"&gt; 社長&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 126.73333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 23.8px; margin-bottom: 2.6666666666666666666666666667px; margin-top: 2.6666666666666666666666666667px; text-align: right"&gt;4,782&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 29.2px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-bottom: 2.6666666666666666666666666667px; margin-top: 2.6666666666666666666666666667px; text-align: justify; text-justify: inter-ideograph"&gt;
