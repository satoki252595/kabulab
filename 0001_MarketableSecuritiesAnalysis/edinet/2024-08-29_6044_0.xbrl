  <jpcrp_cor:TermOfOfficeInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E31379-000KitaokaAkiraMember">(注)４</jpcrp_cor:TermOfOfficeInformationAboutDirectorsAndCorporateAuditors>
