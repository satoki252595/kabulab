  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E02028-000InoueMakotoMember">1967-09-05</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
