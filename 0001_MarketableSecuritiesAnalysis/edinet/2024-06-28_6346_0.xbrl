</jpcrp_cor:NotesRegardingPromissoryNotesDueOnBalanceSheetDateTextBlock>
  <jpcrp_cor:NotesRegardingAccumulatedDepreciationOfPropertyPlantAndEquipmentTextBlock contextRef="CurrentYearInstant_NonConsolidatedMember">
&lt;p style="text-align: left; text-indent: 60px"&gt;※２．有形固定資産の減価償却累計額は、次のとおりであります。&lt;/p&gt;
&lt;div style="margin-left: 96px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 553.33333333333333333333333333px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 185.33333333333333333333333333px"/&gt;
&lt;col style="width: 184px"/&gt;
&lt;col style="width: 184px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr style="height: 40px"&gt;
&lt;td style="vertical-align: middle; width: 185.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;
&lt;span style="font-size: 12px"&gt; &lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 184px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;前事業年度&lt;/p&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;（2023年３月31日）&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 184px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;当事業年度&lt;/p&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;（2024年３月31日）&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 1.33px"&gt;
&lt;td style="vertical-align: middle; width: 185.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; margin-right: 4px; text-align: left"&gt;有形固定資産の減価償却累計額&lt;/p&gt;
&lt;/td&gt;
