  <jpcrp030000-asr_E35578-000:DescriptionOfMetricsRelatedToPolicyOnHumanResourceDevelopmentAndImprovementOfInternalEnvironmentAndTargetsAndResultsUsingSuchMetricsMetricsAndTargetsTextBlock contextRef="FilingDateInstant">&lt;p class="smt_text3" style="orphans:0;widows:0;"&gt; &lt;/p&gt;
