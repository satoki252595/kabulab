&lt;td style="vertical-align: top; width: 152.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 36px; line-height: 17.733333333333333333333333333px; text-align: right"&gt;1,052億59百万円&lt;/p&gt;
