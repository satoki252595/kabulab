  <jpcrp_cor:DateOfResolutionDividendsOfSurplus contextRef="FilingDateInstant_Row1Member">2023-02-08</jpcrp_cor:DateOfResolutionDividendsOfSurplus>
  <jpcrp_cor:ResolutionDividendsOfSurplus contextRef="FilingDateInstant_Row1Member">取締役会決議</jpcrp_cor:ResolutionDividendsOfSurplus>
