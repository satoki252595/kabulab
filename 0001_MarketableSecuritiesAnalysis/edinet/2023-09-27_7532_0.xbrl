&lt;p style="margin-left: 12px; margin-right: 12px; text-align: left"&gt;2022年１月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 562.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
