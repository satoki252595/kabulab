&lt;/div&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:0pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;font-size:15pt;"&gt; &lt;/p&gt;</jpcrp_cor:NotesRegardingPromissoryNotesDueOnBalanceSheetDateTextBlock>
  <jpcrp_cor:NotesRegardingNonOperatingIncomeAndNonOperatingExpensesIncurredFromTransactionsWithAffiliatedEntitiesTextBlock contextRef="CurrentYearDuration_NonConsolidatedMember">&lt;p class="smt_text6" style="orphans:0;widows:0;"&gt;※１　各科目に含まれている関係会社に対する営業外収益は、次のとおりであります。&lt;/p&gt;
&lt;div class="tbld" style="text-align:left;margin-left:30.1pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" class="align_left" style="border-collapse:collapse;border:solid 0pt #000000;width:437.7pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
&lt;col style="width:145.7pt;min-width:145.7pt;"/&gt;
&lt;col style="width:146pt;min-width:146pt;"/&gt;
&lt;col style="width:146pt;min-width:146pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:34pt;min-height:34pt;"&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;"&gt; &lt;/p&gt;
&lt;/td&gt;
