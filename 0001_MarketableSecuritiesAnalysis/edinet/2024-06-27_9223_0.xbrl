&lt;tr style="height:27pt;min-height:27pt;"&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;line-height:8.5pt;font-size:7.5pt;"&gt;本社&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;line-height:8.5pt;font-size:7.5pt;"&gt;(愛知県名古屋市中村区)&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;line-height:8.5pt;font-size:7.5pt;"&gt;［賃借店舗］(注)１&lt;/p&gt;
