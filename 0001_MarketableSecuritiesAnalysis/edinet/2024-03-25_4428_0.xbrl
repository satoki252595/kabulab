  <jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E34509-000MinamiyamaManabuMember">南山　学</jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E34509-000MinamiyamaManabuMember">1958-12-05</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
