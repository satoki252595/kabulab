&lt;/td&gt;
&lt;td rowspan="2" style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;"&gt;調整額&lt;/p&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;"&gt;(注)２&lt;/p&gt;
&lt;/td&gt;
&lt;td rowspan="2" style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;"&gt;連結&lt;/p&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;"&gt;財務諸表&lt;/p&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;"&gt;計上額&lt;/p&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;"&gt;(注)３&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
