  <jpcrp_cor:MajorShareholdersTextBlock contextRef="FilingDateInstant">
&lt;h4 class="smt_head3"&gt;(6) 【大株主の状況】&lt;/h4&gt;&lt;p class="smt_unitR" style="orphans:0;widows:0;padding-left:377.3pt;letter-spacing:0pt;line-height:10pt;"&gt;&lt;span&gt;2024年４月30日&lt;/span&gt;現在&lt;/p&gt;
