&lt;/td&gt;
&lt;td style="vertical-align:top;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;padding-left:4.8pt;padding-right:4.8pt;line-height:13pt;"&gt;事業年度&lt;/p&gt;
&lt;/td&gt;
