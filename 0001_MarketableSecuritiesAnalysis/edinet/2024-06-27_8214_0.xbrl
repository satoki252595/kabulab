&lt;/div&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;line-height:12pt;font-size:12pt;"&gt; &lt;/p&gt;</jpcrp_cor:NotesRegardingInventoriesTextBlock>
  <jpcrp_cor:NotesRegardingPledgedAssetsTextBlock contextRef="CurrentYearInstant">&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:22.5pt;text-indent:0pt;line-height:13pt;"&gt;※２　担保に供している資産は、次のとおりです。&lt;/p&gt;
&lt;div class="tbld" style="margin-left:25.1pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:443.4pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
&lt;col style="width:135.8pt;min-width:135.8pt;"/&gt;
