&lt;h4 class="smt_head3" style="padding-left:27pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;text-align:justify;letter-spacing:0pt;line-height:16pt;font-size:9pt;"&gt;該当事項はありません。&lt;/h4&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;line-height:16pt;font-size:16pt;"&gt; &lt;/p&gt;</jpcrp_cor:NotesRegardingNewShareSubscriptionRightsEtcTextBlock>
  <jpcrp_cor:NotesRegardingDividendTextBlock contextRef="CurrentYearDuration">
&lt;h4 class="smt_head3" style="line-height:16pt;"&gt;４　配当に関する事項&lt;/h4&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:27pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:16pt;"&gt;該当事項はありません。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:27pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:16pt;font-size:16pt;"&gt; &lt;/p&gt;</jpcrp_cor:NotesRegardingDividendTextBlock>
