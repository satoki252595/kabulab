&lt;p style="margin-left: 5px; line-height: 14.666666666666666666666666667px; margin-right: 3px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;当社監査役（現）&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;/div&gt;

&lt;p style="margin-left: 5px; line-height: 1.3333333333333333333333333333px; margin-right: 3px; text-align: left"&gt;　&lt;/p&gt;
