&lt;col style="width: 205.33333333333333333333333333px"/&gt;
&lt;col style="width: 352.26666666666666666666666667px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr style="height: 125.13px"&gt;
&lt;td style="vertical-align: middle; width: 205.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 18px; margin-right: 6px; text-align: left"&gt;製造・販売&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 352.26666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
