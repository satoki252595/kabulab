&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:11.6pt;padding-right:2.6pt;text-justify:inter-ideograph;text-indent:-7.7pt;line-height:8pt;font-size:8pt;"&gt; &lt;/p&gt;
