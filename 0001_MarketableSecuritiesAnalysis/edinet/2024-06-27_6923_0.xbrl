&lt;tr style="height:16.9pt;min-height:16.9pt;"&gt;
&lt;td style="vertical-align:top;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:22pt;padding-right:0pt;line-height:16.9pt;"&gt;1920年12月&lt;/p&gt;
