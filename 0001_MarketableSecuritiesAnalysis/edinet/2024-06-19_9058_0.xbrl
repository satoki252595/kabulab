&lt;td style="vertical-align: middle; width: 81.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 0px none ; background-color: #FFFFFF"&gt;
&lt;p style="margin-right: 12px; text-align: right"&gt;(14)&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
