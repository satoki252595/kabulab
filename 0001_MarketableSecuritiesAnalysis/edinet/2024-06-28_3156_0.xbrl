&lt;col style="width:71.5pt;min-width:71.5pt;"/&gt;
&lt;col style="width:49.3pt;min-width:49.3pt;"/&gt;
&lt;col style="width:249.8pt;min-width:249.8pt;"/&gt;
&lt;col style="width:36.8pt;min-width:36.8pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:17.9pt;min-height:17.9pt;"&gt;
