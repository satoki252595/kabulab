&lt;col style="width:85pt;min-width:85pt;"/&gt;
&lt;col style="width:52pt;min-width:52pt;"/&gt;
&lt;col style="width:109pt;min-width:109pt;"/&gt;
&lt;col style="width:135pt;min-width:135pt;"/&gt;
&lt;col style="width:103.8pt;min-width:103.8pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:20.3pt;min-height:20.3pt;"&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;line-height:12pt;"&gt;相手方の名称&lt;/p&gt;
&lt;/td&gt;
