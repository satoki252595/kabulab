  <jpcrp_cor:NotesRegardingLossOnConstructionContractsTextBlock contextRef="CurrentYearDuration">
&lt;p style="margin-left: 12px; text-align: left"&gt;※３　完成工事原価に含まれている工事損失引当金繰入額&lt;/p&gt;
&lt;p style="margin-left: 12px; text-align: left"&gt; &lt;/p&gt;
&lt;div style="margin-left: 6px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 636px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 318px"/&gt;
&lt;col style="width: 318px"/&gt;
&lt;/colgroup&gt;
