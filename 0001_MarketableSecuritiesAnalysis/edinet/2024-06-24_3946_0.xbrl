  <jpcrp_cor:InformationAboutOfficersTextBlock contextRef="FilingDateInstant">&lt;p style="page-break-before:always; line-height:0.75pt; width:100%; font-size:0.75pt;"&gt; &lt;/p&gt;
&lt;h3 class="smt_head3" style="padding-left:13.5pt;"&gt;(2) 【役員の状況】&lt;/h3&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:18pt;line-height:13pt;"&gt;① 役員一覧&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;"&gt;男性10名　女性3名　（役員のうち女性の比率23％）&lt;/p&gt;
