  <jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E02126-000MiyanagaShunichiMember">宮 永 俊 一</jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors>
