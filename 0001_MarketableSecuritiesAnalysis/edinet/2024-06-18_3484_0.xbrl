  <jpcrp_cor:NotesRegardingTransactionsWithAffiliatedEntitiesTextBlock contextRef="CurrentYearDuration_NonConsolidatedMember">
&lt;p style="margin-left: 84px; text-align: left; text-indent: -24px"&gt;※１　関係会社との取引高&lt;/p&gt;
