&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:13.5pt;min-height:13.5pt;"&gt;
&lt;td style="vertical-align:top;border-top-color:#A9A9A9;border-bottom-color:#A9A9A9;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblR" style="orphans:0;widows:0;padding-right:9.1pt;line-height:13.5pt;"&gt;2022年４月&lt;/p&gt;
&lt;/td&gt;
