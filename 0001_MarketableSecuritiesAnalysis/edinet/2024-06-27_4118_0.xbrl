  <jpcrp_cor:DescriptionOfMetricsRelatedToPolicyOnDevelopmentOfHumanResourcesAndInternalEnvironmentAndTargetsAndPerformanceUsingSuchMetricsMetricsAndTargetsTextBlock contextRef="FilingDateInstant">
&lt;h4 class="smt_head4" style="line-height:14pt;"&gt;- 指標目標 -&lt;/h4&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:18pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:14pt;font-size:9pt;"&gt;女性活躍推進 行動計画（計画期間 2021年４月１日～2026年３月31日）&lt;/p&gt;
&lt;div class="tbld"&gt;
