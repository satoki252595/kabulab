&lt;/div&gt;
&lt;p style="margin-left: 6px; text-align: left"&gt; &lt;/p&gt;
&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 647.33333333333333333333333333px"&gt;
