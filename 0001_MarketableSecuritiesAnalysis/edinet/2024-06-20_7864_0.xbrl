&lt;p style="text-align: center"&gt;2024年３月31日&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 102px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
