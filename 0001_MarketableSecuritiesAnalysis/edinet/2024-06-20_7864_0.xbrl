&lt;p style="margin-left: 6px; text-align: left"&gt;インタレスト・カバレッジ・レシオ（倍）&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 170px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 13.333333333333333333333333333px; text-align: right"&gt;79.4&lt;/p&gt;
&lt;/td&gt;
