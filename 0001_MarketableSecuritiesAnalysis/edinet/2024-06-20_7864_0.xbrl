  <jpcrp_cor:NotesRegardingDividendTextBlock contextRef="Prior1YearDuration">
&lt;p style="margin-left: 24px; text-align: justify; text-justify: inter-ideograph"&gt;３．配当に関する事項&lt;/p&gt;
&lt;p style="margin-left: 24px; text-align: justify; text-justify: inter-ideograph"&gt;（１）配当金支払額&lt;/p&gt;
&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 648px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 132px"/&gt;
&lt;col style="width: 96px"/&gt;
&lt;col style="width: 96px"/&gt;
