&lt;/td&gt;
&lt;td style="vertical-align:top;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:justify;padding-left:9pt;padding-right:9pt;margin-top:0pt;margin-bottom:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:13pt;"&gt;&lt;span style="font-size:7.5pt;"&gt;提出日の前月末現在&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:7.5pt;"&gt;（2024年５月31日）&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
