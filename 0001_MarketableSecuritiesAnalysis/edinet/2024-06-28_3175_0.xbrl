&lt;/colgroup&gt;
&lt;tr style="height:1pt;min-height:1pt;"&gt;
&lt;td colspan="3" style="vertical-align:top;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:0pt;padding-right:0pt;line-height:13pt;"&gt;&lt;span style="font-size:7.5pt;"&gt;2018年３月８日決議&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:7.5pt;"&gt;（付与対象者の区分及び人数：当社取締役１名）&lt;/span&gt;&lt;/p&gt;
