&lt;/td&gt;
&lt;td style="vertical-align:top;border-top-color:#a9a9a9;border-left-style:solid;border-left-width:0.75pt;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:5.6pt;padding-right:5.6pt;margin-top:0pt;margin-bottom:0pt;letter-spacing:0pt;line-height:9pt;"&gt;&lt;span style="font-size:7.5pt;"&gt;㈱新得ファーム　代表取締役(現任)&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:14.4pt;min-height:14.4pt;"&gt;
