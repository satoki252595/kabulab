&lt;/td&gt;
&lt;td colspan="2" style="vertical-align:middle;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:justify;padding-left:5.7pt;padding-right:5.7pt;font-size:7.5pt;"&gt;石垣公認会計士事務所 開業&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
