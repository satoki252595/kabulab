  <jpcrp_cor:NotesRegardingDividendTextBlock contextRef="CurrentYearDuration">
&lt;p style="margin-left: 12px; text-align: justify; text-justify: inter-ideograph"&gt;４. 配当に関する事項&lt;/p&gt;
&lt;p style="margin-left: 24px; text-align: justify; text-justify: inter-ideograph"&gt;①　配当金支払額&lt;/p&gt;
&lt;div&gt;
