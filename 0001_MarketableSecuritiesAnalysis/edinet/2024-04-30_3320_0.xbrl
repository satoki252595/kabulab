&lt;p style="margin-left: 6px; margin-right: 6px; text-align: right; line-height: 15.466666666666666666666666667px"&gt;550百万円&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td style="border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none ; width: 106.66666666666666666666666667px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
