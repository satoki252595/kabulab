&lt;p style="margin-left: 6px; margin-right: 3.3333333333333333333333333333px; text-align: left"&gt;コミットメントラインの総額&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 203.6px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: right"&gt;8,000,000千円&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 203.6px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: right"&gt;8,000,000千円&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
