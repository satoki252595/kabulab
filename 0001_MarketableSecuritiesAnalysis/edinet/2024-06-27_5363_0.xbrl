  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E01149-000SusumuUshigomeMember">1935-08-28</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
