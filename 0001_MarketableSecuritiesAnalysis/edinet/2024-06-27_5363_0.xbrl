&lt;p style="margin-right: 12px; text-align: right"&gt;△917&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 153px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 12px; text-align: right"&gt;849,308&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 153px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 12px; text-align: right"&gt;2,089,233&lt;/p&gt;
