&lt;/div&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:49pt;text-indent:-17.5pt;line-height:15pt;font-size:15pt;"&gt; &lt;/p&gt;
&lt;div class="tbld"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:479.3pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
&lt;col style="width:376.5pt;min-width:376.5pt;"/&gt;
&lt;col style="width:102.8pt;min-width:102.8pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:22.5pt;min-height:22.5pt;"&gt;
