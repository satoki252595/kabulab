&lt;col style="width:78pt;min-width:78pt;"/&gt;
&lt;col style="width:43.5pt;min-width:43.5pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:33pt;min-height:33pt;"&gt;
