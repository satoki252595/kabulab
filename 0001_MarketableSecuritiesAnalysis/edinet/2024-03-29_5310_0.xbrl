&lt;td style="vertical-align: middle; width: 78.666666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; line-height: 13.333333333333333333333333333px; margin-right: 6px; text-align: center"&gt;2022年４月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 569.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 4px; line-height: 13.333333333333333333333333333px; margin-right: 4px; text-align: justify; text-justify: inter-ideograph"&gt;東京証券取引所の市場区分の見直しにより、東京証券取引所市場第一部からプライム市場に移行&lt;/p&gt;
&lt;/td&gt;
