  <jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E02015-000IetsuguHisashiMember">家次　恒</jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E02015-000IetsuguHisashiMember">1949-09-17</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock contextRef="FilingDateInstant_jpcrp030000-asr_E02015-000IetsuguHisashiMember">
&lt;p style="margin-left: 57px; line-height: 13.333333333333333333333333333px; margin-right: 2px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;1973年４月 株式会社三和銀行（現株式会社三菱UFJ銀行）入行&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 57px; line-height: 13.333333333333333333333333333px; margin-right: 2px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;1986年９月 当社取締役就任&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 57px; line-height: 13.333333333333333333333333333px; margin-right: 2px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;1990年３月 当社常務取締役就任&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 57px; line-height: 13.333333333333333333333333333px; margin-right: 2px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;1996年２月 当社代表取締役就任（現任）&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 57px; line-height: 13.333333333333333333333333333px; margin-right: 2px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;1996年４月 当社専務取締役就任&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 57px; line-height: 13.333333333333333333333333333px; margin-right: 2px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;1996年６月 当社取締役社長就任&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 57px; line-height: 13.333333333333333333333333333px; margin-right: 2px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;2013年４月 当社取締役会長兼社長就任&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 57px; line-height: 13.333333333333333333333333333px; margin-right: 2px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;2018年４月 当社取締役会長兼社長 CEO就任&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 57px; line-height: 13.333333333333333333333333333px; margin-right: 2px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;2023年４月 当社取締役会長グループCEO就任（現任）&lt;/span&gt;
&lt;/p&gt;
</jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock>
  <jpcrp_cor:TermOfOfficeInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E02015-000IetsuguHisashiMember">（注）２</jpcrp_cor:TermOfOfficeInformationAboutDirectorsAndCorporateAuditors>
