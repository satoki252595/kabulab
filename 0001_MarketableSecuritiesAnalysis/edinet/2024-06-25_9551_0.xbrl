&lt;tr style="height:20.7pt;min-height:20.7pt;"&gt;
&lt;td style="vertical-align:top;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-right:0pt;"&gt;2021年６月&lt;/p&gt;
