&lt;p style="margin-left: 76px; text-align: left; text-indent: -36px"&gt; &lt;/p&gt;
&lt;p style="margin-left: 36px; text-align: left"&gt;年齢別従業員構成&lt;/p&gt;
&lt;div style="margin-left: 42px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 431.46666666666666666666666667px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 111.46666666666666666666666667px"/&gt;
&lt;col style="width: 112px"/&gt;
&lt;col style="width: 104px"/&gt;
&lt;col style="width: 104px"/&gt;
&lt;/colgroup&gt;
