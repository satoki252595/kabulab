  <jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E05292-000KeikoOishiMember">大石　圭子</jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E05292-000KeikoOishiMember">1957-01-03</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
