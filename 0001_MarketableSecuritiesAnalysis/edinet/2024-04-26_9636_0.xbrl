&lt;col style="width:105.0pt;min-width:105.0pt;"/&gt;
&lt;col style="width:105.0pt;min-width:105.0pt;"/&gt;
&lt;col style="width:105.0pt;min-width:105.0pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:22.5pt;min-height:22.5pt;"&gt;
