&lt;tr style="height: 20px"&gt;
&lt;td style="vertical-align: top; width: 76px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 17.333333333333333333333333333px; text-align: justify; text-justify: inter-ideograph"&gt;2022年４月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 532px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 17.333333333333333333333333333px; text-align: justify; text-justify: inter-ideograph"&gt;
&lt;span style="color: #333333"&gt;東京証券取引所の市場再編に伴い、スタンダード市場に上場&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 20px"&gt;
&lt;td style="vertical-align: top; width: 76px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 17.333333333333333333333333333px; text-align: justify; text-justify: inter-ideograph"&gt;2024年３月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 532px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 17.333333333333333333333333333px; text-align: justify; text-justify: inter-ideograph"&gt;㈱リンガ・フランカの清算結了&lt;/p&gt;
&lt;/td&gt;
