  <jpcrp_cor:FootnotesDirectorsAndCorporateAuditorsTextBlock contextRef="FilingDateInstant_Row9Member">&lt;p style="page-break-before:always; line-height:0.75pt; width:100%; font-size:0.75pt;"&gt; &lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:left;padding-left:49.5pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:-18pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;font-size:9pt;"&gt;&lt;span style="font-family:&amp;apos;ＭＳ 明朝&amp;apos;;font-size:9pt;"&gt;９．取締役及び執行役員に期待する分野（スキルマトリックス）は次のとおりであります。&lt;/span&gt;&lt;/p&gt;
