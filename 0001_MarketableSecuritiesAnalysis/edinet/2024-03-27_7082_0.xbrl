&lt;p style="margin-left: 36px; text-align: left"&gt; &lt;/p&gt;
</jpcrp030000-asr_E35289-000:RiskManagementTextBlock>
  <jpcrp030000-asr_E35289-000:GovernanceTextBlock contextRef="FilingDateInstant">
