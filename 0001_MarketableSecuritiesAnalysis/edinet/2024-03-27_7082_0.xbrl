&lt;p style="margin-right: 16.666666666666666666666666667px; text-align: right"&gt;6,480,000&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 100.6px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 3px double #000000"&gt;
