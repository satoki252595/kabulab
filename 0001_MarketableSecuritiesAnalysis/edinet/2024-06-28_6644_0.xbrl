&lt;col style="width:78pt;min-width:78pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:23.4pt;min-height:23.4pt;"&gt;
&lt;td style="vertical-align:top;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:justify;padding-left:5.4pt;padding-right:5.4pt;margin-bottom:0.0pt;font-size:10.5pt;"&gt;&lt;span style="font-size:9pt;"&gt; &lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
