&lt;td style="vertical-align: top; width: 70.666666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 5px; line-height: 15px; margin-right: 5px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;2003年３月&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
