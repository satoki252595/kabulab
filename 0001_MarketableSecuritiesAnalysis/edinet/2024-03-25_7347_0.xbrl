  <jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E36498-000ToyoshimaToshihiroMember">豊島　俊弘</jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E36498-000ToyoshimaToshihiroMember">1962-09-20</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
