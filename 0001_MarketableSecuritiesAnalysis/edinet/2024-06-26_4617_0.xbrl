  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E00897-000YamadaKieMember">1977-05-06</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
