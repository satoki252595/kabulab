&lt;/tr&gt;
&lt;tr style="height: 17.33px"&gt;
&lt;td style="vertical-align: middle; width: 71.466666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="line-height: 15.333333333333333333333333333px; text-align: center"&gt;2001年８月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 584px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 4px; line-height: 15.333333333333333333333333333px; margin-right: 2.6666666666666666666666666667px; text-align: left"&gt;本社を東京都文京区本郷に移転。&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 17.33px"&gt;
&lt;td style="vertical-align: middle; width: 71.466666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="line-height: 15.333333333333333333333333333px; text-align: center"&gt;2001年10月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 584px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 4px; line-height: 15.333333333333333333333333333px; margin-right: 2.6666666666666666666666666667px; text-align: left"&gt;病診連携支援システム「連携くん&lt;sup&gt;®&lt;/sup&gt;」発売。&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 17.33px"&gt;
&lt;td style="vertical-align: middle; width: 71.466666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="line-height: 15.333333333333333333333333333px; text-align: center"&gt;2001年10月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 584px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 4px; line-height: 15.333333333333333333333333333px; margin-right: 2.6666666666666666666666666667px; text-align: left"&gt;株式会社イー・ファーマを吸収合併。&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 17.33px"&gt;
&lt;td style="vertical-align: middle; width: 71.466666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="line-height: 15.333333333333333333333333333px; text-align: center"&gt;2001年11月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 584px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 4px; line-height: 15.333333333333333333333333333px; margin-right: 2.6666666666666666666666666667px; text-align: left"&gt;インターネットによる医薬営業支援システム「ｅディテーリング&lt;sup&gt;®&lt;/sup&gt;」サービス開始。&lt;/p&gt;
&lt;/td&gt;
