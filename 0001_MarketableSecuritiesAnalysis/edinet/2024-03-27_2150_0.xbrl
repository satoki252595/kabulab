&lt;tr style="height: 17.33px"&gt;
&lt;td style="vertical-align: middle; width: 71.466666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="line-height: 15.333333333333333333333333333px; text-align: center"&gt;2003年６月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 584px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 4px; line-height: 15.333333333333333333333333333px; margin-right: 2.6666666666666666666666666667px; text-align: left"&gt;総務省へ委託放送業務認定の廃止の届出をし、同省より電気通信役務利用放送の業務の登録を受ける。&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 17.33px"&gt;
&lt;td style="vertical-align: middle; width: 71.466666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="line-height: 15.333333333333333333333333333px; text-align: center"&gt;2003年８月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 584px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 4px; line-height: 15.333333333333333333333333333px; margin-right: 2.6666666666666666666666666667px; text-align: left"&gt;株式会社ケアネット・インターナショナルを吸収合併。&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 34.67px"&gt;
&lt;td style="vertical-align: middle; width: 71.466666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
