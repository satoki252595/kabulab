&lt;p style="line-height: 15px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;1965年３月８日&lt;/span&gt;&lt;span style="font-size: 10px"&gt;生&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 215px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;

&lt;p style="margin-left: 65px; line-height: 15px; margin-right: 5px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;1988年４月　㈱日本興業銀行（現㈱みずほ銀行）入行&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 15px; margin-right: 5px; text-align: left; text-indent: -60px"&gt;
