&lt;col style="width:90pt;min-width:90pt;"/&gt;
&lt;col style="width:90pt;min-width:90pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:13.4pt;min-height:13.4pt;"&gt;
