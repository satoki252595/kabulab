&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 95.93333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 56px; line-height: 18.666666666666666666666666667px; margin-right: 6px; text-align: right"&gt;3,454&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 65.2px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 18.666666666666666666666666667px; margin-right: 6px; text-align: left"&gt;百万円&lt;/p&gt;
