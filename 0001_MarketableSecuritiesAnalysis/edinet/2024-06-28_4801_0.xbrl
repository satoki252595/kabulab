&lt;td style="vertical-align: top; width: 159.73333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 51px; line-height: 18.666666666666666666666666667px; margin-right: 6px; text-align: left; text-indent: -24px"&gt;契約負債（期首残高）&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 95.93333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 56px; line-height: 18.666666666666666666666666667px; margin-right: 6px; text-align: right"&gt;3,225&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 65.2px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="line-height: 18.666666666666666666666666667px; margin-right: 6px; text-align: left"&gt;百万円&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 6.67px"&gt;
&lt;td style="vertical-align: top; width: 159.73333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
