&lt;td style="vertical-align: middle; width: 336px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 12px; margin-right: 12px; text-align: left"&gt;自  2028年１月１日  至  2029年12月31日&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 36px"&gt;
&lt;td style="vertical-align: middle; width: 256.53333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 12px; margin-right: 12px; text-align: left"&gt;新株予約権の行使により株式を発行する場合の株式の発行価格及び資本組入額（円）※&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 336px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 12px; text-align: left"&gt;発行価格      617&lt;/p&gt;
&lt;p style="margin-left: 12px; text-align: left"&gt;資本組入額    308.5&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 22.67px"&gt;
&lt;td style="vertical-align: middle; width: 256.53333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 12px; margin-right: 12px; text-align: left"&gt;新株予約権の行使の条件※&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 336px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 12px; margin-right: 6px; text-align: left"&gt;（注）２&lt;/p&gt;
