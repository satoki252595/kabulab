&lt;td style="vertical-align: top; width: 373.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 12px; line-height: 16.666666666666666666666666667px; text-align: left"&gt;取得原価&lt;/p&gt;
