&lt;tbody&gt;
&lt;tr style="height: 16px"&gt;
&lt;td style="vertical-align: top; width: 69.333333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 5.3333333333333333333333333333px; line-height: 15px; margin-right: 10.666666666666666666666666667px; text-align: right"&gt;
&lt;span style="font-size: 10px"&gt;1993年４月&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
