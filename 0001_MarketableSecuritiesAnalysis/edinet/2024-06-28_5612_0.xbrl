&lt;/td&gt;
&lt;td style="vertical-align:top;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;margin-top:0pt;letter-spacing:0pt;line-height:20pt;"&gt;５名&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:top;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblR" style="orphans:0;widows:0;line-height:12pt;font-size:12pt;"&gt; &lt;/p&gt;
