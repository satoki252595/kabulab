  <jpcrp_cor:DescriptionOfFactorsWhichLedToRecognitionOfGainOnBargainPurchaseTextBlock contextRef="CurrentYearDuration">&lt;p class="smt_head6" style="orphans:0;widows:0;padding-left:9pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;text-align:justify;letter-spacing:0pt;line-height:15pt;"&gt;【報告セグメントごとの負ののれん発生益に関する情報】&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;"&gt; &lt;/p&gt;&lt;p class="smt_text1" style="orphans:0;widows:0;padding-left:27pt;"&gt;該当事項はありません。&lt;/p&gt;</jpcrp_cor:DescriptionOfFactorsWhichLedToRecognitionOfGainOnBargainPurchaseTextBlock>
  <jpcrp_cor:NotesRelatedPartiesConsolidatedFinancialStatementsTextBlock contextRef="CurrentYearDuration">&lt;p style="page-break-before:always; line-height:0.75pt; width:100%; font-size:0.75pt;"&gt; &lt;/p&gt;
&lt;h6 class="smt_head5" style="padding-left:9pt;"&gt;【関連当事者情報】&lt;/h6&gt;&lt;p class="smt_text1" style="orphans:0;widows:0;padding-left:12.5pt;"&gt; &lt;/p&gt;&lt;p class="smt_text1" style="orphans:0;widows:0;text-align:justify;padding-left:12.5pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:9pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;font-size:9pt;"&gt;関連当事者との取引&lt;/p&gt;&lt;p class="smt_text1" style="orphans:0;widows:0;padding-left:21pt;"&gt;連結財務諸表提出会社と関連当事者との取引&lt;/p&gt;&lt;p class="smt_head6" style="orphans:0;widows:0;text-justify:inter-ideograph;text-indent:2pt;"&gt;（ア）連結財務諸表提出会社の親会社及び主要株主（会社等に限る。）等&lt;/p&gt;&lt;p class="smt_text1" style="orphans:0;widows:0;padding-left:20pt;text-indent:10pt;"&gt;前連結会計年度（自　&lt;span&gt;2022年４月１日&lt;/span&gt;　至　&lt;span&gt;2023年３月31日&lt;/span&gt;）&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;"&gt; &lt;/p&gt;
