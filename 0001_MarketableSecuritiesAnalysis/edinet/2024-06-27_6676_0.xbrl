  <jpcrp_cor:NotesRegardingGuaranteeObligationsTextBlock contextRef="CurrentYearInstant_NonConsolidatedMember">
&lt;p style="margin-left: 12px; text-align: left"&gt;※２．偶発債務&lt;/p&gt;
&lt;p style="margin-left: 48px; text-align: left"&gt;関係会社の仕入先に対する保証&lt;/p&gt;
&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 639.99999999999999999999999999px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 213.33333333333333333333333333px"/&gt;
