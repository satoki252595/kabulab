&lt;p style="margin-right: 12px; text-align: right"&gt;
99,096千円&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 200.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
