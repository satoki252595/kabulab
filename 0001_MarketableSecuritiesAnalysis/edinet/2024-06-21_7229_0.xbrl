  <jpigp_cor:NotesSubsequentEventsConsolidatedFinancialStatementsIFRSTextBlock contextRef="CurrentYearDuration">&lt;p class="smt_head6" style="orphans:0;widows:0;"&gt;34．後発事象&lt;/p&gt;&lt;p class="smt_text2" style="orphans:0;widows:0;"&gt;該当事項はありません。&lt;/p&gt;&lt;p class="smt_text2" style="orphans:0;widows:0;text-align:justify;padding-left:27pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:9pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;font-size:15pt;"&gt; &lt;/p&gt;</jpigp_cor:NotesSubsequentEventsConsolidatedFinancialStatementsIFRSTextBlock>
