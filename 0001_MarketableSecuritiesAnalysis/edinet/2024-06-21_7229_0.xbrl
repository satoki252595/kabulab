&lt;/div&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;"&gt; &lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:0pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;font-size:15pt;"&gt; &lt;/p&gt;</jpcrp_cor:DividendPolicyTextBlock>
  <jpcrp_cor:DateOfResolutionDividendsOfSurplus contextRef="FilingDateInstant_Row1Member">2023-10-31</jpcrp_cor:DateOfResolutionDividendsOfSurplus>
  <jpcrp_cor:ResolutionDividendsOfSurplus contextRef="FilingDateInstant_Row1Member">取締役会決議</jpcrp_cor:ResolutionDividendsOfSurplus>
