&lt;col style="width:40pt;min-width:40pt;"/&gt;
&lt;col style="width:40pt;min-width:40pt;"/&gt;
&lt;col style="width:84pt;min-width:84pt;"/&gt;
&lt;col style="width:84pt;min-width:84pt;"/&gt;
&lt;col style="width:102.5pt;min-width:102.5pt;"/&gt;
&lt;col style="width:102.5pt;min-width:102.5pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:17.9pt;min-height:17.9pt;"&gt;
&lt;td rowspan="2" style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:1pt;padding-right:1pt;line-height:6pt;font-size:6pt;"&gt; &lt;/p&gt;
&lt;/td&gt;
&lt;td rowspan="2" style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:1pt;padding-right:1pt;line-height:6pt;"&gt;&lt;span style="font-family:&amp;apos;ＭＳ ゴシック&amp;apos;;font-size:6pt;"&gt;マテリアリティ&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td rowspan="2" style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:1pt;padding-right:1pt;line-height:6pt;"&gt;&lt;span style="font-family:&amp;apos;ＭＳ ゴシック&amp;apos;;font-size:6pt;"&gt;項目&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td rowspan="2" style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:1pt;padding-right:1pt;line-height:6pt;"&gt;&lt;span style="font-family:&amp;apos;ＭＳ ゴシック&amp;apos;;font-size:6pt;"&gt;対応する&lt;/span&gt;&lt;br/&gt;&lt;span style="font-family:&amp;apos;ＭＳ ゴシック&amp;apos;;font-size:6pt;"&gt;SDGs&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td rowspan="2" style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:1pt;padding-right:1pt;line-height:6pt;"&gt;&lt;span style="font-family:&amp;apos;ＭＳ ゴシック&amp;apos;;font-size:6pt;"&gt;自社のリスク／機会&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
