&lt;td rowspan="2" style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:1pt;padding-right:1pt;line-height:6pt;"&gt;&lt;span style="font-family:&amp;apos;ＭＳ ゴシック&amp;apos;;font-size:6pt;"&gt;対応する&lt;/span&gt;&lt;br/&gt;&lt;span style="font-family:&amp;apos;ＭＳ ゴシック&amp;apos;;font-size:6pt;"&gt;SDGs&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td rowspan="2" style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:1pt;padding-right:1pt;line-height:6pt;"&gt;&lt;span style="font-family:&amp;apos;ＭＳ ゴシック&amp;apos;;font-size:6pt;"&gt;自社のリスク／機会&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td rowspan="2" style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:1pt;padding-right:1pt;line-height:6pt;"&gt;&lt;span style="font-family:&amp;apos;ＭＳ ゴシック&amp;apos;;font-size:6pt;"&gt;目指す姿&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:1pt;padding-right:1pt;line-height:6pt;"&gt;&lt;span style="font-family:&amp;apos;ＭＳ ゴシック&amp;apos;;font-size:6pt;"&gt;2025年度&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
