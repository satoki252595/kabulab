&lt;td style="vertical-align:top;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:right;padding-left:0pt;padding-right:6pt;margin-top:3pt;margin-bottom:3pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;line-height:9pt;font-size:9pt;"&gt;12月&lt;/p&gt;
