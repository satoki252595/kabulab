  <jpcrp_cor:TreasurySharesEtcTextBlock contextRef="FilingDateInstant">
&lt;h5 class="smt_head4"&gt;② 【自己株式等】&lt;/h5&gt;&lt;p class="smt_text4" style="orphans:0;widows:0;"&gt;該当事項はありません。&lt;/p&gt;</jpcrp_cor:TreasurySharesEtcTextBlock>
