&lt;/td&gt;
&lt;td style="vertical-align:top;border-top-color:#a9a9a9;border-bottom-color:#a9a9a9;border-left-style:solid;border-left-width:0.75pt;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:5.4pt;padding-right:5.4pt;margin-top:1pt;margin-bottom:1pt;line-height:8pt;font-size:7.5pt;"&gt;当社常務取締役就任&lt;/p&gt;
&lt;/td&gt;
