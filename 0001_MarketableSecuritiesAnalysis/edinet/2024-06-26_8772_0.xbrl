&lt;td style="vertical-align: middle; width: 153px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;
&lt;p style="margin-left: 2.6666666666666666666666666667px; line-height: 13.333333333333333333333333333px; margin-right: 2.6666666666666666666666666667px; text-align: left"&gt;監査証明業務に基づく報酬&lt;/p&gt;
&lt;p style="margin-left: 2.6666666666666666666666666667px; line-height: 13.333333333333333333333333333px; margin-right: 2.6666666666666666666666666667px; text-align: left"&gt;（千円）&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 153px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;
&lt;p style="margin-left: 6px; line-height: 13.333333333333333333333333333px; margin-right: 6px; text-align: left"&gt;非監査業務に基づく報酬&lt;/p&gt;
