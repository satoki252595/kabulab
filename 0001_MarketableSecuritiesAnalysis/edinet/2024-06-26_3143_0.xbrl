&lt;p style="text-align: center"&gt;2024年６月26日&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;/div&gt;
</jpcrp_cor:NotesRegardingDividendTextBlock>
