&lt;h6 class="smt_head5" style="padding-left:9pt;"&gt;(デリバティブ取引関係)&lt;/h6&gt;&lt;p class="smt_text2" style="orphans:0;widows:0;"&gt;該当事項はありません。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;"&gt; &lt;/p&gt;</jpcrp_cor:NotesDerivativesConsolidatedFinancialStatementsTextBlock>
  <jpcrp_cor:NotesRetirementBenefitsConsolidatedFinancialStatementsTextBlock contextRef="CurrentYearDuration">
