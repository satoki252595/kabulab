  <jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock contextRef="FilingDateInstant_jpcrp030000-asr_E03343-000YamadaJyunjiMember">
&lt;p style="margin-left: 60px; line-height: 15px; margin-right: 2px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;1994年４月 株式会社福井銀行入行&lt;/span&gt;
