&lt;tr style="height: 16px"&gt;
&lt;td style="vertical-align: top; width: 180px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 5.9333333333333333333333333333px; line-height: 17.333333333333333333333333333px; margin-right: 11.933333333333333333333333333px; text-align: left"&gt;建物及び構築物&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 80px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 17.333333333333333333333333333px; margin-right: 12px; text-align: right"&gt;25百万円&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 17.33px"&gt;
&lt;td style="vertical-align: top; width: 180px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 5.9333333333333333333333333333px; line-height: 17.333333333333333333333333333px; margin-right: 11.933333333333333333333333333px; text-align: left"&gt;その他&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 80px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 17.333333333333333333333333333px; margin-right: 12px; text-align: right"&gt;2百万円&lt;/p&gt;
