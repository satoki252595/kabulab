&lt;p style="margin-right: 30px; text-align: right"&gt;8,600,000千円&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 173.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 2px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
