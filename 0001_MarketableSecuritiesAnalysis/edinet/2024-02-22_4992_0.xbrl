&lt;tr style="height: 182px"&gt;
&lt;td style="vertical-align: middle; width: 140px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;
&lt;p style="line-height: 15px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;代表取締役社長&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 70px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;
&lt;p style="line-height: 15px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;佐野　健一&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 100px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;
&lt;p style="line-height: 15px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;1957年８月４日&lt;/span&gt;&lt;span style="font-size: 10px"&gt;生&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 240px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;

&lt;p style="margin-left: 65px; line-height: 15px; margin-right: 3px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;1981年４月　当社入社&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 15px; margin-right: 3px; text-align: left; text-indent: -60px"&gt;
