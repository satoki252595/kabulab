&lt;col style="width:17.1pt;min-width:17.1pt;"/&gt;
&lt;col style="width:67.8pt;min-width:67.8pt;"/&gt;
&lt;col style="width:21.3pt;min-width:21.3pt;"/&gt;
&lt;col style="width:92pt;min-width:92pt;"/&gt;
