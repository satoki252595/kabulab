  <jpcrp_cor:NotesSecuritiesConsolidatedFinancialStatementsTextBlock contextRef="CurrentYearDuration">
&lt;h6 class="smt_head5" style="padding-left:18pt;"&gt;(有価証券関係)&lt;/h6&gt;&lt;p class="smt_head6" style="orphans:0;widows:0;"&gt;１　満期保有目的の債券&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:18pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;"&gt;前連結会計年度(&lt;span&gt;2023年３月31日&lt;/span&gt;)&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:25pt;line-height:10pt;"&gt;該当事項はありません。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;line-height:10pt;font-size:10pt;"&gt; &lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:18pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;"&gt;当連結会計年度(&lt;span&gt;2024年３月31日&lt;/span&gt;)&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:25pt;line-height:10pt;"&gt;該当事項はありません。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:0pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:10pt;font-size:10pt;"&gt; &lt;/p&gt;&lt;p class="smt_head6" style="orphans:0;widows:0;"&gt;２. その他有価証券&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:18pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;"&gt;前連結会計年度(&lt;span&gt;2023年３月31日&lt;/span&gt;)&lt;/p&gt;
