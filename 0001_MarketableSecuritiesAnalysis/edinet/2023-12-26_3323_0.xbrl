  <jpigp_cor:NotesShareCapitalAndOtherEquityItemsConsolidatedFinancialStatementsIFRSTextBlock contextRef="CurrentYearDuration">&lt;p style="page-break-before:always; line-height:0.75pt; width:100%; font-size:0.75pt;"&gt; &lt;/p&gt;&lt;p class="smt_head6" style="orphans:0;widows:0;"&gt;21．資本金及びその他の資本項目&lt;/p&gt;
