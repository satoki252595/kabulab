  <jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E00066-000MorishitaKyouichiMember">森　下　協　一</jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors>
