&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 128.53333333333333333333333333px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center; line-height: 14px"&gt;
&lt;span style="font-size: 10px"&gt;東道　雅彦&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 70.933333333333333333333333333px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: right; line-height: 14px"&gt;
&lt;span style="font-size: 10px"&gt;1968年&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: right; line-height: 14px"&gt;
&lt;span style="font-size: 10px"&gt;7月17日生&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 344px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: left; line-height: 14px"&gt;
&lt;span style="font-size: 10px"&gt;1997年 4月 弁護士登録（第二東京弁護士会）&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 61.6px; margin-right: 6px; text-align: left; line-height: 14px"&gt;
&lt;span style="font-size: 10px"&gt;牛島法律事務所（現 牛島総合法律事務所）入所&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: left; line-height: 14px"&gt;
&lt;span style="font-size: 10px"&gt;2005年 1月 牛島総合法律事務所パートナー弁護士（現任）&lt;/span&gt;
