  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E00913-000SatoIkumiMember">1963-12-25</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
