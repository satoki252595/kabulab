  <jpcrp_cor:NotesRevenueRecognitionConsolidatedFinancialStatementsTextBlock contextRef="CurrentYearDuration">&lt;p style="page-break-before:always; line-height:0.75pt; width:100%; font-size:0.75pt;"&gt; &lt;/p&gt;&lt;p class="smt_head5" style="orphans:0;widows:0;padding-left:18pt;"&gt;(収益認識関係)&lt;/p&gt;&lt;p class="smt_head6" style="orphans:0;widows:0;"&gt;１．顧客との契約から生じる収益を分解した情報&lt;/p&gt;&lt;p class="smt_unitR" style="orphans:0;widows:0;text-align:right;padding-left:0pt;padding-right:3pt;line-height:16.5pt;"&gt;(単位:千円)&lt;/p&gt;
