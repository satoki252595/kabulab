&lt;col style="width:13pt;min-width:13pt;"/&gt;
&lt;col style="width:104.3pt;min-width:104.3pt;"/&gt;
&lt;col style="width:125.2pt;min-width:125.2pt;"/&gt;
&lt;col style="width:125.2pt;min-width:125.2pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:9pt;min-height:9pt;"&gt;
