&lt;col style="width:88.5pt;min-width:88.5pt;"/&gt;
&lt;col style="width:175.8pt;min-width:175.8pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:22.5pt;min-height:22.5pt;"&gt;
