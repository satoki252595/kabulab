  <jpcrp_cor:NotesRealEstateForLeaseEtcConsolidatedFinancialStatementsTextBlock contextRef="CurrentYearDuration">
&lt;h6 class="smt_head4" style="padding-left:18pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;text-align:justify;letter-spacing:0pt;line-height:15pt;font-size:9pt;"&gt;(賃貸等不動産関係)&lt;/h6&gt;&lt;p class="smt_text3" style="orphans:0;widows:0;"&gt;賃貸等不動産の総額に重要性が乏しいため、記載を省略しております。&lt;/p&gt;&lt;p class="smt_unitR" style="orphans:0;widows:0;"&gt; &lt;/p&gt;</jpcrp_cor:NotesRealEstateForLeaseEtcConsolidatedFinancialStatementsTextBlock>
  <jpcrp_cor:NotesRevenueRecognitionConsolidatedFinancialStatementsTextBlock contextRef="CurrentYearDuration">&lt;p class="smt_head4" style="orphans:0;widows:0;"&gt;(収益認識関係)&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:18pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:9pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;font-size:9pt;"&gt;１．顧客との契約から生じる収益を分解した情報&lt;/p&gt;
