  <jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock contextRef="FilingDateInstant_jpcrp030000-asr_E00640-000TakahashiEijiMember">
&lt;p style="margin-left: 70px; line-height: 15px; margin-right: 5px; text-align: left; text-indent: -65px"&gt;
