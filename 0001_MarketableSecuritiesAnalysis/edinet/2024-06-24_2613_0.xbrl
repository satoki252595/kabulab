&lt;tr style="height:38.5pt;min-height:38.5pt;"&gt;
&lt;td style="vertical-align:top;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:justify;padding-left:3pt;padding-right:3pt;margin-bottom:0pt;line-height:11pt;font-size:11pt;"&gt; &lt;/p&gt;
