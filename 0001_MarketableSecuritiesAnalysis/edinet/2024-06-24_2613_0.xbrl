&lt;col style="width:66.8pt;min-width:66.8pt;"/&gt;
&lt;col style="width:79.5pt;min-width:79.5pt;"/&gt;
&lt;col style="width:66.8pt;min-width:66.8pt;"/&gt;
&lt;/colgroup&gt;
