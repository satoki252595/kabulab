  <jpcrp_cor:NotesRegardingInventoriesTextBlock contextRef="CurrentYearInstant_NonConsolidatedMember">&lt;p class="smt_text6" style="orphans:0;widows:0;"&gt;&lt;span style="font-family:&amp;apos;ＭＳ 明朝&amp;apos;;font-size:9pt;"&gt;※１　棚卸資産の内訳&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_unitR" style="orphans:0;widows:0;"&gt; &lt;/p&gt;
