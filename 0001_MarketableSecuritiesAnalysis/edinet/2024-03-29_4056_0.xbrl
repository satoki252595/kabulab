&lt;col style="width:60.8pt;min-width:60.8pt;"/&gt;
&lt;col style="width:9pt;min-width:9pt;"/&gt;
&lt;col style="width:201pt;min-width:201pt;"/&gt;
&lt;/colgroup&gt;
