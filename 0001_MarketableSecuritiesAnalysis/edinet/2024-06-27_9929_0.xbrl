&lt;td style="vertical-align: bottom; width: 160px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: right"&gt;3,903,048&lt;/p&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: right"&gt;1,224,173&lt;/p&gt;
&lt;/td&gt;
