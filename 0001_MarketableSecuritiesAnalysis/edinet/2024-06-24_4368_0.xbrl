</jpcrp_cor:NotesAdditionalInformationFinancialStatementsTextBlock>
  <jpcrp_cor:NotesRegardingAssetsAndLiabilitiesIncurredFromTransactionsWithAffiliatedEntitiesTextBlock contextRef="CurrentYearInstant_NonConsolidatedMember">
&lt;p style="margin-left: 12px; text-align: justify; text-justify: inter-ideograph"&gt;※  関係会社に対する金銭債権および金銭債務（区分表示したものを除く）&lt;/p&gt;
&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 647.93333333333333333333333333px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 216.33333333333333333333333333px"/&gt;
&lt;col style="width: 215.8px"/&gt;
&lt;col style="width: 215.8px"/&gt;
&lt;/colgroup&gt;
&lt;thead&gt;
&lt;tr style="height: 40px"&gt;
