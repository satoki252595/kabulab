&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center; line-height: 13.333333333333333333333333333px"&gt;13回&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 24px"&gt;
