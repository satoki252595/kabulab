&lt;/td&gt;
&lt;td style="vertical-align: top; width: 125.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 18px; margin-right: 6px; text-align: right"&gt;956&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 48px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 18px; margin-right: 6px; text-align: right"&gt;
