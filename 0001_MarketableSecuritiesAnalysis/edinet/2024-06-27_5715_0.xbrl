&lt;p style="margin-left: 0px; line-height: 13.333333333333333333333333333px; margin-right: 0px; margin-bottom: 0px; text-align: center"&gt;（2023年3月31日）&lt;/p&gt;
&lt;/td&gt;
&lt;td colspan="2" style="vertical-align: middle; width: 204px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 0px; line-height: 13.333333333333333333333333333px; margin-right: 0px; margin-bottom: 0px; text-align: center"&gt;当連結会計年度&lt;/p&gt;
&lt;p style="margin-left: 0px; line-height: 13.333333333333333333333333333px; margin-right: 0px; margin-bottom: 0px; text-align: center"&gt;（2024年3月31日）&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 18px"&gt;
&lt;td style="vertical-align: middle; width: 240px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; line-height: 18px; margin-right: 6px; margin-bottom: 0px; text-align: left"&gt;受取手形&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 162px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 18px; margin-bottom: 0px; text-align: right"&gt;
6,657
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 42px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 18px; margin-bottom: 0px; text-align: left"&gt;百万円&lt;/p&gt;
