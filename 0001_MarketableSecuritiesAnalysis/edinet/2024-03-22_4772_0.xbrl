&lt;colgroup&gt;
&lt;col style="width: 319.46666666666666666666666667px"/&gt;
&lt;col style="width: 328px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr style="height: 26.67px"&gt;
