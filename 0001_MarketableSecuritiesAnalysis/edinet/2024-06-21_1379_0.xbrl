&lt;td style="vertical-align: middle; width: 111.93333333333333333333333333px; padding-top: 0.6666666666666666666666666667px; padding-bottom: 1.3333333333333333333333333333px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
