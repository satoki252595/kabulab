&lt;col style="width: 43.4px"/&gt;
&lt;col style="width: 204.53333333333333333333333333px"/&gt;
&lt;col style="width: 1.2666666666666666666666666667px"/&gt;
&lt;col style="width: 18px"/&gt;
&lt;col style="width: 18px"/&gt;
