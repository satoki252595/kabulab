&lt;td style="vertical-align: middle; width: 342.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 5.3333333333333333333333333333px; text-align: left"&gt;楽清香港有限公司&lt;/p&gt;
