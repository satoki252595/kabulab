&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 41.333333333333333333333333333px; vertical-align: top; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 4.6666666666666666666666666667px; margin-right: 4.6666666666666666666666666667px; text-align: center; line-height: 15px"&gt;
