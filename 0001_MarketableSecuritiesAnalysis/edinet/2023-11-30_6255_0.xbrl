&lt;td style="vertical-align: top; width: 232px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 12px; line-height: 14.666666666666666666666666667px; text-align: left; text-indent: -6px"&gt;自 2023年１月24日&lt;/p&gt;
&lt;p style="margin-left: 12px; line-height: 14.666666666666666666666666667px; text-align: left; text-indent: -6px"&gt;至 2053年１月23日&lt;/p&gt;
