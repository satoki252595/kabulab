&lt;p style="margin-left: 12px; line-height: 14.666666666666666666666666667px; text-align: right; text-indent: -6px"&gt;402円&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 152px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 12px; line-height: 14.666666666666666666666666667px; text-align: right; text-indent: -6px"&gt;709円&lt;/p&gt;
