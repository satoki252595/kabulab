&lt;p style="margin-left: 6px; line-height: 14.666666666666666666666666667px; text-align: left"&gt;譲渡制限期間&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 232px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
