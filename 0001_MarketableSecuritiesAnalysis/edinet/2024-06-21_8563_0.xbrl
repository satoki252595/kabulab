&lt;tbody&gt;
&lt;tr style="height: 29.33px"&gt;
&lt;td style="vertical-align: top; width: 132px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 36px; line-height: 26.666666666666666666666666667px; text-align: left"&gt;1942年８月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 516px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 26.666666666666666666666666667px; text-align: left"&gt;郡山無尽㈱・会津勧業無尽㈱・磐城無尽㈱の３社が合併して、大東無尽㈱を設立&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 29.33px"&gt;
&lt;td style="vertical-align: top; width: 132px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
