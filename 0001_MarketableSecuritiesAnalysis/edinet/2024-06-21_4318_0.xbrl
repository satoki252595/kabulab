  <jpcrp_cor:MajorShareholdersTextBlock contextRef="FilingDateInstant">
&lt;h4&gt;（６）【大株主の状況】&lt;/h4&gt;
&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 648px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 220.66666666666666666666666667px"/&gt;
&lt;col style="width: 215.33333333333333333333333333px"/&gt;
