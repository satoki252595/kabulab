&lt;td style="vertical-align: top; width: 84px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: right"&gt;122,949&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 38.666666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: left"&gt;
&lt;span style="font-size: 12px"&gt; &lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;/div&gt;
&lt;p style="margin-right: 6px; text-align: left; text-indent: 12px"&gt; &lt;/p&gt;
&lt;p style="margin-left: 36px; text-align: left"&gt;当連結会計年度（自　2023年４月１日  至　2024年３月31日）&lt;/p&gt;
&lt;p style="margin-left: 36px; margin-right: 6px; text-align: left; text-indent: 12px"&gt;該当事項はありません。&lt;/p&gt;
&lt;p style="margin-right: 6px; text-align: left; text-indent: 12px"&gt; &lt;/p&gt;
