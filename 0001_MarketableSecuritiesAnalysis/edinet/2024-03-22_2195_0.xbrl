&lt;tbody&gt;
&lt;tr&gt;
&lt;td style="border-left: 0px none #000000; border-top: 0px none #000000; border-right: 0px none #000000; border-bottom: 0px none #000000; width: 95.46666666666666666666666667px; vertical-align: top; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 24px; margin-right: 0px; text-align: justify; line-height: 16px; text-justify: inter-ideograph"&gt;1977年４月&lt;/p&gt;
