&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:12.8pt;min-height:12.8pt;"&gt;
&lt;td style="vertical-align:middle;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-right:0pt;"&gt;弘前屋株式会社&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:12.8pt;min-height:12.8pt;"&gt;
&lt;td style="vertical-align:middle;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-right:0pt;"&gt;株式会社向井珍味堂&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
