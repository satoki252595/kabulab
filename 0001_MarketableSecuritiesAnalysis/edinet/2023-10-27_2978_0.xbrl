&lt;td style="vertical-align:top;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:justify;padding-left:7pt;padding-right:0pt;line-height:20pt;font-size:9pt;"&gt;&lt;span style="font-size:9pt;"&gt;建物&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
