  <jpcrp_cor:InformationAboutEmployeesTextBlock contextRef="FilingDateInstant">&lt;p style="page-break-before:always; line-height:0.75pt; width:100%; font-size:0.75pt;"&gt; &lt;/p&gt;
&lt;h3 class="smt_head2" style="padding-right:0pt;"&gt;５ 【従業員の状況】&lt;/h3&gt;
&lt;h4 class="smt_head3"&gt;(1) 連結会社の状況&lt;/h4&gt;&lt;p class="smt_unitR" style="orphans:0;widows:0;padding-left:368.3pt;line-height:10pt;"&gt;  &lt;span&gt;2024年３月31日&lt;/span&gt;現在&lt;/p&gt;
