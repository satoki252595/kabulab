  <jpcrp_cor:MajorFacilitiesTextBlock contextRef="FilingDateInstant">
&lt;h3 class="smt_head2"&gt;２ 【主要な設備の状況】&lt;/h3&gt;
&lt;h4 class="smt_head3" style="line-height:14pt;"&gt;(1) 提出会社&lt;/h4&gt;&lt;p class="smt_unitR" style="orphans:0;widows:0;text-align:right;padding-left:0pt;padding-right:4.5pt;"&gt;&lt;span&gt;2023年12月31日&lt;/span&gt;現在&lt;/p&gt;
&lt;div class="tbld" style="margin-left:0pt;margin-right:0pt;margin-top:0pt;margin-bottom:2pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:484.8pt;table-layout:fixed;"&gt;
