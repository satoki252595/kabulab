&lt;td style="vertical-align: top; width: 177.26666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 15.733333333333333333333333333px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;同社取締役専務執行役員&lt;/span&gt;
&lt;/p&gt;
&lt;p style="line-height: 15.733333333333333333333333333px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;経営企画・商品戦略・商品収益管理&lt;/span&gt;
&lt;/p&gt;
&lt;p style="line-height: 15.733333333333333333333333333px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;担当、コスト革新担当補佐&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 18px"&gt;
&lt;td style="vertical-align: top; width: 70px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 5px; line-height: 15.733333333333333333333333333px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;2013年６月&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 177.26666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 15.733333333333333333333333333px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;同社代表取締役副社長執行役員&lt;/span&gt;
&lt;/p&gt;
&lt;p style="line-height: 15.733333333333333333333333333px; text-align: left"&gt;
