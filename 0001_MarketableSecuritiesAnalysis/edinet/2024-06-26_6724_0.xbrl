&lt;td style="vertical-align: middle; width: 63.133333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-right: 6px; text-align: right"&gt;13,139&lt;/p&gt;
&lt;/td&gt;
