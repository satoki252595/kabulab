&lt;col style="width: 133.33333333333333333333333333px"/&gt;
&lt;col style="width: 133.33333333333333333333333333px"/&gt;
&lt;col style="width: 362.66666666666666666666666667px"/&gt;
&lt;/colgroup&gt;
&lt;thead&gt;
&lt;tr style="height: 40px"&gt;
