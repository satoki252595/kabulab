&lt;tr&gt;
&lt;td rowspan="3" style="vertical-align: middle; width: 255.13333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 1.3333333333333333333333333333px; line-height: 20px; margin-right: 1.3333333333333333333333333333px; text-align: center"&gt; &lt;/p&gt;
