&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:10pt;min-height:10pt;"&gt;
&lt;td style="vertical-align:top;border-top-color:#a9a9a9;border-bottom-color:#a9a9a9;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;line-height:9pt;font-size:9pt;"&gt;2004年３月&lt;/p&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;line-height:9pt;font-size:9pt;"&gt; &lt;/p&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;line-height:9pt;font-size:9pt;"&gt; &lt;/p&gt;
