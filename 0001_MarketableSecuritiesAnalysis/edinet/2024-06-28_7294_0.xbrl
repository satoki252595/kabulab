&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:right;padding-right:0.5pt;line-height:13pt;"&gt;&lt;span style="font-size:9pt;"&gt;8.0&lt;/span&gt;&lt;/p&gt;
