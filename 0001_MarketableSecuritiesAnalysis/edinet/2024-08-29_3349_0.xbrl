  <jpcrp_cor:NotesRelatedPartiesConsolidatedFinancialStatementsTextBlock contextRef="CurrentYearDuration">
&lt;h5 class="smt_head3" style="padding-left:9pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;text-align:justify;letter-spacing:0pt;line-height:15pt;font-size:9pt;"&gt;【関連当事者情報】&lt;/h5&gt;
&lt;h2 class="smt_head2" style="padding-left:1.5pt;font-size:9pt;"&gt;関連当事者との取引&lt;/h2&gt;
&lt;h4 class="smt_head3" style="padding-left:10pt;"&gt;連結財務諸表提出会社と関連当事者との取引&lt;/h4&gt;&lt;p class="smt_text4" style="orphans:0;widows:0;text-align:justify;padding-left:10pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:9pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;"&gt;連結財務諸表提出会社の役員及び主要株主等&lt;/p&gt;&lt;p class="smt_text4" style="orphans:0;widows:0;text-align:justify;padding-left:19pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:9pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;"&gt;前連結会計年度（自　&lt;span&gt;2022年６月１日&lt;/span&gt;　至　&lt;span&gt;2023年５月31日&lt;/span&gt;）&lt;/p&gt;
&lt;div class="tbld" style="margin-left:0pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
