&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:16.1pt;min-height:16.1pt;"&gt;
&lt;td style="vertical-align:bottom;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;overflow:hidden;" valign="bottom"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:2pt;line-height:15pt;"&gt;&lt;span style="font-size:9pt;"&gt;　負債合計&lt;/span&gt;&lt;/p&gt;
