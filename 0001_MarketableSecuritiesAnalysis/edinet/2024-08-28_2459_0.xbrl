  <jpcrp_cor:NotesDerivativesConsolidatedFinancialStatementsTextBlock contextRef="CurrentYearDuration">
&lt;h5 class="smt_head5" style="padding-left:0pt;"&gt;(デリバティブ取引関係)&lt;/h5&gt;&lt;p class="smt_text3" style="orphans:0;widows:0;padding-left:0pt;"&gt;該当事項はありません。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;line-height:5pt;font-size:5pt;"&gt; &lt;/p&gt;</jpcrp_cor:NotesDerivativesConsolidatedFinancialStatementsTextBlock>
  <jpcrp_cor:NotesRetirementBenefitsConsolidatedFinancialStatementsTextBlock contextRef="CurrentYearDuration">
&lt;h5 class="smt_head5" style="padding-left:0pt;"&gt;(退職給付関係)&lt;/h5&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:0pt;"&gt;　該当事項はありません。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;line-height:5pt;font-size:5pt;"&gt; &lt;/p&gt;</jpcrp_cor:NotesRetirementBenefitsConsolidatedFinancialStatementsTextBlock>
