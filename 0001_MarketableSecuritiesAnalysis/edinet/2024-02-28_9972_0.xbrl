&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 245.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 5px; line-height: 13.333333333333333333333333333px; margin-right: 1.3333333333333333333333333333px; text-align: justify; text-justify: inter-ideograph"&gt;
