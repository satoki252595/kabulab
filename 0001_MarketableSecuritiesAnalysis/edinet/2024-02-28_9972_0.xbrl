&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 162.66666666666666666666666667px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center"&gt;70％&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 162.66666666666666666666666667px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center"&gt;50％&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;/div&gt;
&lt;p style="margin-left: 72px; text-align: justify; text-justify: inter-ideograph; text-indent: -12px"&gt;※提出会社のみの指標、目標および実績となっております。&lt;/p&gt;
&lt;p style="margin-left: 36px; text-align: left"&gt; &lt;/p&gt;

&lt;p style="text-align: left"&gt; &lt;/p&gt;
</jpcrp030000-asr_E02774-000:MetricsAndTargetsTextBlock>
  <jpcrp030000-asr_E02774-000:DescriptionOfMetricsRelatedToPolicyOnHumanResourceDevelopmentAndImprovementOfInternalEnvironmentAndTargetsAndResultsUsingSuchMetricsMetricsAndTargetsTextBlock contextRef="FilingDateInstant">
