&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr style="height: 19px"&gt;
&lt;td rowspan="3" style="vertical-align: middle; width: 99.2px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: center"&gt; &lt;/p&gt;
&lt;p style="text-align: center"&gt;調整後払込&lt;/p&gt;
&lt;p style="text-align: center"&gt;金額&lt;/p&gt;
&lt;/td&gt;
&lt;td rowspan="3" style="vertical-align: middle; width: 31.333333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: center"&gt; &lt;/p&gt;
&lt;p style="text-align: center"&gt;＝&lt;/p&gt;
&lt;/td&gt;
&lt;td rowspan="3" style="vertical-align: middle; width: 101.93333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
