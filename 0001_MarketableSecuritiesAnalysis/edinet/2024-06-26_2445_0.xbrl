  <jpcrp_cor:NotesRegardingImpairmentLossTextBlock contextRef="CurrentYearDuration_NonConsolidatedMember">
&lt;p style="margin-left: 12px; text-align: left"&gt; &lt;/p&gt;
&lt;p class="style_pb_after" style="line-height: 1; text-align: left"&gt; &lt;/p&gt;
&lt;p style="margin-left: 12px; text-align: left"&gt;※６　減損損失&lt;/p&gt;
