&lt;p style="line-height: 15.333333333333333333333333333px; text-align: center"&gt;既発行&lt;/p&gt;
&lt;p style="line-height: 15.333333333333333333333333333px; margin-bottom: 6px; text-align: center"&gt;株式数&lt;/p&gt;
&lt;/td&gt;
&lt;td rowspan="2" style="vertical-align: middle; width: 28px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 15.333333333333333333333333333px; margin-bottom: 9px; text-align: center"&gt;＋&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 57.333333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 15.333333333333333333333333333px; margin-top: 3px; text-align: center"&gt;新規発行&lt;/p&gt;
