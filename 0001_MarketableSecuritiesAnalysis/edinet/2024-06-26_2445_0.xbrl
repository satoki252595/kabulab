&lt;col style="width: 138.66666666666666666666666667px"/&gt;
&lt;col style="width: 186.33333333333333333333333333px"/&gt;
&lt;col style="width: 138.66666666666666666666666667px"/&gt;
&lt;/colgroup&gt;
&lt;thead&gt;
&lt;tr style="height: 18px"&gt;
&lt;td style="vertical-align: middle; width: 138.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt;場　所&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 138.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt;用　途&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 186.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt;種　類&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 138.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt;金　額&lt;/p&gt;
&lt;/td&gt;
