&lt;td style="border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 3px double #000000; width: 112px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: right; margin-top: 0.2666666666666666666666666667px"&gt;129,477百万円&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td style="border-left: 0px none ; border-top: 3px double #000000; border-right: 0px none ; border-bottom: 0px none ; width: 96px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: left; margin-top: 0.2666666666666666666666666667px"&gt;流動負債&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 0px none ; border-top: 3px double #000000; border-right: 0px none ; border-bottom: 0px none ; width: 112px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: right; margin-top: 0.2666666666666666666666666667px"&gt;101,007百万円&lt;/p&gt;
&lt;/td&gt;
