&lt;col style="width:93.8pt;min-width:93.8pt;"/&gt;
&lt;col style="width:374.3pt;min-width:374.3pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:18.0pt;min-height:18.0pt;"&gt;
&lt;td style="vertical-align:top;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:24.1pt;padding-right:0pt;line-height:16pt;"&gt;1935年７月&lt;/p&gt;
&lt;/td&gt;
