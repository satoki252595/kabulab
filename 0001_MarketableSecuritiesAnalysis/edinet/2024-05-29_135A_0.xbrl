  <jpcrp_cor:TreasurySharesEtcTextBlock contextRef="FilingDateInstant">
&lt;h5 class="smt_head4" style="padding-left:23pt;"&gt;② 【自己株式等】&lt;/h5&gt;&lt;p class="smt_text4" style="orphans:0;widows:0;"&gt;該当事項はありません。&lt;/p&gt;&lt;p class="smt_text4" style="orphans:0;widows:0;text-align:justify;padding-left:27pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:9pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;font-size:15pt;"&gt; &lt;/p&gt;</jpcrp_cor:TreasurySharesEtcTextBlock>
  <jpcrp_cor:ClassesOfSharesEtcTextBlock contextRef="FilingDateInstant">&lt;p class="smt_head6" style="orphans:0;widows:0;line-height:3pt;font-size:3pt;"&gt; &lt;/p&gt;
&lt;div class="tbld" style="margin-left:27pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:186.8pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
&lt;col style="width:96pt;min-width:96pt;"/&gt;
