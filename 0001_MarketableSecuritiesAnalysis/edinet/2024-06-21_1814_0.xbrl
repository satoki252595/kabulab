&lt;p style="text-align: right"&gt;
&lt;span style="font-size: 14px"&gt;（単位：百万円）&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;/div&gt;
