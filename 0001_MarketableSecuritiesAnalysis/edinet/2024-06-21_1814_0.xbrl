&lt;col style="width: 152.13333333333333333333333333px"/&gt;
&lt;col style="width: 152.13333333333333333333333333px"/&gt;
&lt;col style="width: 152.13333333333333333333333333px"/&gt;
&lt;col style="width: 152.13333333333333333333333333px"/&gt;
&lt;/colgroup&gt;
