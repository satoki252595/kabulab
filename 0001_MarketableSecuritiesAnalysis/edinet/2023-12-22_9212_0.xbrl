  <jpcrp_cor:NotesRegardingDividendTextBlock contextRef="CurrentYearDuration_NonConsolidatedMember">&lt;p class="smt_head6" style="orphans:0;widows:0;line-height:12pt;"&gt;４．配当に関する事項&lt;/p&gt;&lt;p class="smt_text2" style="orphans:0;widows:0;line-height:12pt;"&gt;該当事項はありません。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:0pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:12pt;font-size:12pt;"&gt; &lt;/p&gt;</jpcrp_cor:NotesRegardingDividendTextBlock>
