&lt;td style="vertical-align:top;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:right;padding-left:0pt;padding-right:3.8pt;margin-top:0pt;margin-bottom:0pt;line-height:18pt;"&gt;&lt;span style="font-size:9pt;"&gt;直接 12.52％&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:0pt;padding-right:3.8pt;margin-top:0pt;margin-bottom:0pt;line-height:18pt;"&gt;&lt;span style="font-size:9pt;"&gt;（注）１&lt;/span&gt;&lt;/p&gt;
