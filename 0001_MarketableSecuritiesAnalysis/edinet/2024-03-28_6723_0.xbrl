&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:0pt;margin-top:0pt;margin-bottom:0pt;line-height:11.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;アメリカに&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:0pt;margin-top:0pt;margin-bottom:0pt;line-height:11.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;本社を置く企業等&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:9pt;"&gt;(比較対象企業＝12)&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:0pt;margin-top:0pt;margin-bottom:0pt;line-height:11.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;ヨーロッパに&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:0pt;margin-top:0pt;margin-bottom:0pt;line-height:11.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;本社を置く企業等&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:9pt;"&gt;(比較対象企業＝４)&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:159.1pt;min-height:159.1pt;"&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:0pt;margin-top:0pt;margin-bottom:0pt;line-height:11.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;ソニーグループ㈱&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:0pt;margin-top:0pt;margin-bottom:0pt;line-height:11.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;㈱東芝&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:9pt;"&gt;三菱電機㈱&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:9pt;"&gt;東京エレクトロン㈱&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:9pt;"&gt;㈱アドバンテスト&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:9pt;"&gt;㈱ディスコ&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:0pt;margin-top:0pt;margin-bottom:0pt;line-height:11.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;㈱日立製作所&lt;/span&gt;&lt;br/&gt;&lt;span style="font-family:&amp;apos;ＭＳ 明朝&amp;apos;;font-size:9pt;"&gt;パナソニック ホールディングス&lt;/span&gt;&lt;span style="font-size:9pt;"&gt;㈱&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:9pt;"&gt;オリンパス㈱&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:9pt;"&gt;トレンドマイクロ㈱&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:0pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:0pt;line-height:11.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;㈱デンソー&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:0pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:0pt;line-height:11.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;TDK㈱&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:0pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:11.5pt;font-size:9pt;"&gt;&lt;span style="font-family:&amp;apos;ＭＳ 明朝&amp;apos;;font-size:9pt;"&gt;㈱村田製作所&lt;/span&gt;&lt;/p&gt;
