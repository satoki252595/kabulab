&lt;td style="vertical-align: middle; width: 230.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;

&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 229px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 70px"/&gt;
&lt;col style="width: 159px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr style="height: 30px"&gt;
&lt;td style="vertical-align: top; width: 70px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 5px; line-height: 15px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;2009年４月&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
