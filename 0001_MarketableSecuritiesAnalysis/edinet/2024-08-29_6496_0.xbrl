&lt;/colgroup&gt;
&lt;thead&gt;
&lt;tr style="height: 23px"&gt;
&lt;td rowspan="2" style="vertical-align: middle; width: 126px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 11.333333333333333333333333333px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;事業所名&lt;/span&gt;
&lt;/p&gt;
