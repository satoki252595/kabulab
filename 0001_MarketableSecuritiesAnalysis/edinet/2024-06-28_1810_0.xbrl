&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;padding-left:5.6pt;padding-right:5.6pt;margin-top:0pt;margin-bottom:0pt;letter-spacing:0pt;line-height:10.0pt;"&gt;河 野   明&lt;/p&gt;
