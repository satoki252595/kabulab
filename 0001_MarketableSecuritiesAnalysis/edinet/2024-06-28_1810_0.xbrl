&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;padding-left:0pt;padding-right:0pt;margin-top:1pt;margin-bottom:1pt;letter-spacing:0pt;line-height:7pt;"&gt;&lt;span style="font-size:6.0pt;"&gt;役職名&lt;/span&gt;&lt;/p&gt;
