&lt;p style="margin-right: 6px; text-align: right"&gt;8,215,618&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 144.53333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 6px; text-align: right"&gt;11,341,033&lt;/p&gt;
&lt;/td&gt;
