&lt;/div&gt;
&lt;p style="margin-left: 0px; line-height: 1.3333333333333333333333333333px; margin-right: 0px; text-align: left"&gt; &lt;/p&gt;
&lt;div style="margin-left: 84px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 557.99999999999999999999999999px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 133.33333333333333333333333333px"/&gt;
&lt;col style="width: 93.33333333333333333333333333px"/&gt;
&lt;col style="width: 331.33333333333333333333333333px"/&gt;
&lt;/colgroup&gt;
&lt;thead&gt;
