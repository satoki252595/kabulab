&lt;/div&gt;
&lt;p class="style_pb_after" style="margin-left: 60px; margin-right: 6px; text-align: left; text-indent: -24px"&gt; &lt;/p&gt;
&lt;p style="text-align: left"&gt; &lt;/p&gt;
&lt;div style="margin-left: 6px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 637.33333333333333333333333333px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 157.33333333333333333333333333px"/&gt;
&lt;col style="width: 160px"/&gt;
&lt;col style="width: 160px"/&gt;
