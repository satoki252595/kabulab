&lt;p style="line-height: 18.666666666666666666666666667px; margin-right: 12px; text-align: right"&gt;－&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;/div&gt;
&lt;p style="text-align: left"&gt; &lt;/p&gt;
</jpcrp_cor:NotesRegardingNewShareSubscriptionRightsEtcTextBlock>
  <jpcrp_cor:NotesRegardingDividendTextBlock contextRef="CurrentYearDuration_NonConsolidatedMember">
&lt;p style="margin-left: 60px; text-align: left"&gt;３．配当に関する事項&lt;/p&gt;
&lt;p style="margin-left: 72px; text-align: left"&gt;　該当事項はありません。&lt;/p&gt;
</jpcrp_cor:NotesRegardingDividendTextBlock>
