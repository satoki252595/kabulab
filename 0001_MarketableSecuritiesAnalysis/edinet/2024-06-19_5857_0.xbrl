&lt;p style="text-align: center"&gt;持分比率&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 127.4px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
