  <jpcrp_cor:MajorComponentsOfSellingGeneralAndAdministrativeExpensesTextBlock contextRef="CurrentYearDuration_NonConsolidatedMember">
&lt;p style="margin-left: 84px; text-align: left; text-indent: -24px"&gt;※２　販売費及び一般管理費&lt;/p&gt;
&lt;p style="margin-left: 108px; margin-bottom: 2.6666666666666666666666666667px; text-align: left; text-indent: -24px"&gt;イ　主要な費目の内訳&lt;/p&gt;
&lt;div style="margin-left: 84px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 564px"&gt;
&lt;colgroup&gt;
