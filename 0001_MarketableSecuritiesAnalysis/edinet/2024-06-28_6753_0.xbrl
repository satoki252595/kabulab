&lt;td style="vertical-align: top; width: 72px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; line-height: 13.333333333333333333333333333px; margin-right: 3.3333333333333333333333333333px; margin-bottom: 4px; text-align: center"&gt;2009年４月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 210.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p class="text_align_justify" style="margin-left: 6px; line-height: 13.333333333333333333333333333px; margin-right: 3.3333333333333333333333333333px"&gt;同 執行役副社長 兼 生産、物流、&lt;/p&gt;
&lt;p style="margin-left: 6px; line-height: 13.333333333333333333333333333px; margin-right: 3.3333333333333333333333333333px; margin-bottom: 4px; text-align: left"&gt;調達、ＣＳプラットフォーム担当&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 1.33px"&gt;
&lt;td style="vertical-align: top; width: 72px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; line-height: 13.333333333333333333333333333px; margin-right: 3.3333333333333333333333333333px; margin-bottom: 4px; text-align: center"&gt;2011年６月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 210.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; line-height: 13.333333333333333333333333333px; margin-right: 3.3333333333333333333333333333px; margin-bottom: 4px; text-align: left"&gt;同 業務執行役員 副会長 兼 生産、物流、調達、ＣＳプラットフォーム担当（2012年６月退任）&lt;/p&gt;
&lt;/td&gt;
