&lt;/thead&gt;
&lt;tbody&gt;
&lt;tr style="height: 16px"&gt;
&lt;td style="vertical-align: top; width: 63.466666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 2px; line-height: 16px; text-align: center"&gt;1912年９月&lt;/p&gt;
