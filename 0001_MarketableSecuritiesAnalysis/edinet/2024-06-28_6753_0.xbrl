&lt;td style="vertical-align: middle; width: 205.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 36px; text-align: left"&gt;資産合計&lt;/p&gt;
&lt;/td&gt;
