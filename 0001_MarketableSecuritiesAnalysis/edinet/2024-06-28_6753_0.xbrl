&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 144px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: right"&gt;477,269百万円&lt;/p&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: right"&gt;433,106百万円&lt;/p&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: right"&gt;9,890百万円&lt;/p&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: right"&gt;4,951百万円&lt;/p&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: right"&gt;76,682百万円&lt;/p&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: right"&gt;86,838百万円&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 144px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: right"&gt;433,106百万円&lt;/p&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: right"&gt;401,308百万円&lt;/p&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: right"&gt;4,951百万円&lt;/p&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: right"&gt;6,230百万円&lt;/p&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: right"&gt;86,838百万円&lt;/p&gt;
