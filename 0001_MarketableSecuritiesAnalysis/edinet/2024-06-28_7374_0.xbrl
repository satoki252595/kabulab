&lt;/td&gt;
&lt;td colspan="3" style="vertical-align: middle; width: 314px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 12px; text-align: center"&gt;時価&lt;/p&gt;
