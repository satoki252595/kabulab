&lt;/td&gt;
&lt;td style="border-left: 0px none #000000; border-top: 0px none #000000; border-right: 0px none #000000; border-bottom: 0px none #000000; width: 144px; vertical-align: top; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 0px; margin-right: 0px; text-align: center"&gt;
&lt;span style="font-size: 12px"&gt; &lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 0px none #000000; border-top: 0px none #000000; border-right: 0px none #000000; border-bottom: 0px none #000000; width: 168px; vertical-align: top; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 12px; margin-right: 0px; text-align: left"&gt;2024年３月12日&lt;/p&gt;
&lt;p style="margin-left: 12px; margin-right: 0px; text-align: left"&gt;関東財務局長に提出&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;/div&gt;
&lt;p style="text-align: left"&gt; &lt;/p&gt;
</jpcrp_cor:OtherReferenceInformationTextBlock>
