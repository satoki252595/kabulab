&lt;div style="margin-left: 36px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 566.26666666666666666666666667px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 152.66666666666666666666666667px"/&gt;
