&lt;p style="text-align: right"&gt;（単位：千円）&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;/div&gt;
&lt;p style="margin-left: 0px; line-height: 1.3333333333333333333333333333px; margin-right: 0px; text-align: left"&gt; &lt;/p&gt;
&lt;div style="margin-left: 87.46666666666666666666666667px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 560.53333333333333333333333333px"&gt;
&lt;colgroup&gt;
