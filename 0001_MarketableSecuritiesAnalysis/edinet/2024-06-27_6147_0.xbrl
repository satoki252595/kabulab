&lt;td style="vertical-align: top; width: 210px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 5px; line-height: 15px; margin-right: 3px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;原法律事務所（現弁護士法人原総合法律事務所）入所（現任）&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 1.33px"&gt;
&lt;td style="vertical-align: top; width: 58.666666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 5px; line-height: 15px; margin-right: 3px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;2024年６月&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 210px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 5px; line-height: 15px; margin-right: 3px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;当社取締役監査等委員就任（現任）&lt;/span&gt;
&lt;/p&gt;
