&lt;col style="width:44.4pt;min-width:44.4pt;"/&gt;
&lt;col style="width:43.8pt;min-width:43.8pt;"/&gt;
&lt;col style="width:47.3pt;min-width:47.3pt;"/&gt;
&lt;col style="width:48pt;min-width:48pt;"/&gt;
&lt;col style="width:41.4pt;min-width:41.4pt;"/&gt;
&lt;col style="width:39.7pt;min-width:39.7pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:17pt;min-height:17pt;"&gt;
