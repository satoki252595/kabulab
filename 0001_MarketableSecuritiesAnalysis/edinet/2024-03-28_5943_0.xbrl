&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center"&gt;低&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 66.866666666666666666666666667px; vertical-align: top; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center"&gt;高&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
