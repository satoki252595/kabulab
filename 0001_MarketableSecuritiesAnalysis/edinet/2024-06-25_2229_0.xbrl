&lt;col style="width:64.5pt;min-width:64.5pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:27.8pt;min-height:27.8pt;"&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;line-height:18pt;"&gt;場所&lt;/p&gt;
