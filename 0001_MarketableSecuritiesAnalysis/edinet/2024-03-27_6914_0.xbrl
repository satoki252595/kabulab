&lt;p style="margin-left: 8px; line-height: 1.3333333333333333333333333333px; text-align: left"&gt;　&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 46px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;
&lt;p style="margin-left: 2px; margin-right: 2px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;（注）４&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 59px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;
