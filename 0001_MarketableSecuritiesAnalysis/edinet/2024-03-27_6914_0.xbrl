&lt;col style="width: 167px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr&gt;
&lt;td style="vertical-align: top; width: 70px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 8px; line-height: 16px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;2016年４月&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 8px; line-height: 16px; text-align: left"&gt; &lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 167px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 2px; line-height: 16px; margin-right: 2px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;オプテックス・エフエー株式会社入社&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 16.67px"&gt;
