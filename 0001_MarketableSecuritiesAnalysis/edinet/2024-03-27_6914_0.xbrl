  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E01998-000TatsuyaNakajimaMember">1966-10-11</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock contextRef="FilingDateInstant_jpcrp030000-asr_E01998-000TatsuyaNakajimaMember">
