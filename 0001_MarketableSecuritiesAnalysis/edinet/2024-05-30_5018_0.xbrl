&lt;/td&gt;
&lt;td style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:right;padding-left:0pt;padding-right:0pt;line-height:9pt;"&gt;&lt;span style="font-size:9pt;"&gt;3百万円&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
