&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#bfbfbf;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#bfbfbf;border-left-style:solid;border-left-width:0.75pt;border-left-color:#bfbfbf;border-right-style:solid;border-right-width:0.75pt;border-right-color:#bfbfbf;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:justify;padding-left:3.8pt;padding-right:3.8pt;margin-top:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:0pt;font-family:&amp;apos;ＭＳ ゴシック&amp;apos;;letter-spacing:0pt;line-height:8.5pt;font-size:7.5pt;"&gt;46％削減&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:18pt;min-height:18pt;"&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#bfbfbf;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#bfbfbf;border-left-style:solid;border-left-width:0.75pt;border-left-color:#bfbfbf;border-right-style:solid;border-right-width:0.75pt;border-right-color:#bfbfbf;background-color:#f2f2f2;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;font-family:&amp;apos;ＭＳ ゴシック&amp;apos;;line-height:8.5pt;font-size:7.5pt;"&gt;目標２&lt;/p&gt;
