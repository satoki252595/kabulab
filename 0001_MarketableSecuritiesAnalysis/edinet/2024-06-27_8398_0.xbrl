&lt;col style="width:107.8pt;min-width:107.8pt;"/&gt;
&lt;col style="width:38.5pt;min-width:38.5pt;"/&gt;
&lt;col style="width:107.5pt;min-width:107.5pt;"/&gt;
&lt;col style="width:38.5pt;min-width:38.5pt;"/&gt;
