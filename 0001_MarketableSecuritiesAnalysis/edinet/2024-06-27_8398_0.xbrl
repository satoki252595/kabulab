&lt;col style="width:120pt;min-width:120pt;"/&gt;
&lt;col style="width:147pt;min-width:147pt;"/&gt;
&lt;col style="width:89pt;min-width:89pt;"/&gt;
&lt;col style="width:111pt;min-width:111pt;"/&gt;
&lt;/colgroup&gt;
