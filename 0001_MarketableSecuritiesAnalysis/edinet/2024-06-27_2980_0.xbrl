&lt;/td&gt;
&lt;td rowspan="3" style="vertical-align: bottom; width: 22.666666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 50.666666666666666666666666667px; text-align: center"&gt;＝&lt;/p&gt;
&lt;/td&gt;
&lt;td rowspan="3" style="vertical-align: bottom; width: 87px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
