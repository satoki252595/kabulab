&lt;p style="margin-left: 60px; line-height: 1.3333333333333333333333333333px; margin-right: 6px; text-align: left; text-indent: -60px"&gt; &lt;/p&gt;
&lt;div style="margin-left: 78px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 397.33333333333333333333333333px"&gt;
