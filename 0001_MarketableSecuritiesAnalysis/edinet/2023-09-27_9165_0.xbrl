&lt;tr&gt;
&lt;td style="vertical-align: top; width: 98.86666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="line-height: 21.333333333333333333333333333px; margin-right: 12.066666666666666666666666667px; margin-bottom: 4px; text-align: left"&gt;2004年10月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 556.6px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="line-height: 21.333333333333333333333333333px; margin-right: 12.066666666666666666666666667px; margin-bottom: 4px; text-align: left"&gt;実装材料・工法の研究と開発を開始&lt;/p&gt;
