&lt;col style="width:416.3pt;min-width:416.3pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:15.5pt;min-height:15.5pt;"&gt;
&lt;td style="vertical-align:top;border-top-color:#a9a9a9;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;"&gt;2017年６月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:top;border-top-color:#a9a9a9;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;margin-bottom:2pt;line-height:13pt;"&gt;店舗と公式オンラインストアを連携させたポイントサービス「コックスメンバーズクラブ」を刷新。&lt;/p&gt;
&lt;/td&gt;
