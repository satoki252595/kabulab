  <jpcrp_cor:NotesSignificantEventsAfterReportingPeriodConsolidatedFinancialStatementsTextBlock contextRef="CurrentYearDuration">&lt;p style="page-break-before:always; line-height:0.75pt; width:100%; font-size:0.75pt;"&gt; &lt;/p&gt;
&lt;h6 class="smt_head5" style="padding-left:18pt;"&gt;(重要な後発事象)&lt;/h6&gt;&lt;p class="smt_text3" style="orphans:0;widows:0;text-align:justify;padding-left:18pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:9pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;font-size:9pt;"&gt;該当事項はありません。&lt;/p&gt;&lt;p class="smt_text3" style="orphans:0;widows:0;text-align:justify;padding-left:18pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:9pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;font-size:15pt;"&gt; &lt;/p&gt;</jpcrp_cor:NotesSignificantEventsAfterReportingPeriodConsolidatedFinancialStatementsTextBlock>
  <jpcrp_cor:AnnexedConsolidatedDetailedScheduleOfCorporateBondsTextBlock contextRef="CurrentYearDuration">
&lt;h6 class="smt_head5" style="padding-left:45pt;"&gt;【社債明細表】&lt;/h6&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:63pt;"&gt;該当事項はありません。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;"&gt; &lt;/p&gt;</jpcrp_cor:AnnexedConsolidatedDetailedScheduleOfCorporateBondsTextBlock>
  <jpcrp_cor:AnnexedConsolidatedDetailedScheduleOfBorrowingsTextBlock contextRef="CurrentYearDuration">
&lt;h6 class="smt_head5" style="padding-left:45pt;"&gt;【借入金等明細表】&lt;/h6&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:63pt;"&gt;該当事項はありません。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;"&gt; &lt;/p&gt;</jpcrp_cor:AnnexedConsolidatedDetailedScheduleOfBorrowingsTextBlock>
  <jpcrp_cor:AnnexedConsolidatedDetailedScheduleOfAssetRetirementObligationsTextBlock contextRef="CurrentYearDuration">
&lt;h6 class="smt_head5" style="padding-left:45pt;"&gt;【資産除去債務明細表】&lt;/h6&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:54pt;text-indent:9pt;"&gt;本明細表に記載すべき事項について、連結財務諸表規則第15条の23に規定する注記事項として記載しておりますので、資産除去債務明細表の記載を省略しております。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;"&gt; &lt;/p&gt;</jpcrp_cor:AnnexedConsolidatedDetailedScheduleOfAssetRetirementObligationsTextBlock>
