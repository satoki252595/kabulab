&lt;td style="vertical-align: middle; width: 99px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 20.666666666666666666666666667px; margin-right: 12px; text-align: right"&gt;－&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 99px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 20.666666666666666666666666667px; margin-right: 12px; text-align: right"&gt;－&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 29px"&gt;
&lt;td style="vertical-align: middle; width: 247px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 12px; line-height: 14.4px; margin-right: 12px; text-align: left"&gt;合併、株式交付、会社分割に係る移転を行った取得自己株式&lt;/p&gt;
&lt;/td&gt;
