&lt;td style="vertical-align: middle; width: 126.8px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 1; text-align: center"&gt;氏　名&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 248.46666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 1; text-align: center"&gt;出席回数&lt;/p&gt;
&lt;/td&gt;
