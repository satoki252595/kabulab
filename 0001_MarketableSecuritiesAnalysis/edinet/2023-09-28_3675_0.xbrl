&lt;/colgroup&gt;
&lt;tr style="height:22.5pt;min-height:22.5pt;"&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;text-align:center;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;line-height:10.0pt;font-size:10.0pt;"&gt; &lt;/p&gt;
&lt;/td&gt;
&lt;td colspan="2" style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;text-align:center;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;line-height:10.0pt;font-size:9pt;"&gt;前連結会計年度&lt;br/&gt;(2022年６月30日)&lt;/p&gt;
&lt;/td&gt;
&lt;td colspan="2" style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;text-align:center;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;line-height:10.0pt;font-size:9pt;"&gt;当連結会計年度&lt;br/&gt;(2023年６月30日)&lt;/p&gt;
&lt;/td&gt;
