  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E38453-000NakataYukiyasuMember">1974-03-15</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
