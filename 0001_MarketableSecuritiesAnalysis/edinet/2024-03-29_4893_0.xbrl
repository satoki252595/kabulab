  <jpcrp_cor:TermOfOfficeInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E38453-000HashiokaHironariMember">（注）４</jpcrp_cor:TermOfOfficeInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:OfficialTitleOrPositionInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E38453-000NakataYukiyasuMember">監査役</jpcrp_cor:OfficialTitleOrPositionInformationAboutDirectorsAndCorporateAuditors>
