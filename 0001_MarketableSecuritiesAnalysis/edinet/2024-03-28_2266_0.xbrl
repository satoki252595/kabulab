&lt;/div&gt;
&lt;p style="margin-left: 12px; line-height: 13.333333333333333333333333333px; text-align: left"&gt; &lt;/p&gt;
&lt;p style="margin-left: 12px; line-height: 13.333333333333333333333333333px; text-align: left"&gt; &lt;/p&gt;
&lt;p style="margin-left: 12px; line-height: 13.333333333333333333333333333px; text-align: left"&gt;　合弁契約&lt;/p&gt;
&lt;div style="margin-left: 12px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 636px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 88px"/&gt;
&lt;col style="width: 136.66666666666666666666666667px"/&gt;
&lt;col style="width: 131.33333333333333333333333333px"/&gt;
&lt;col style="width: 168px"/&gt;
&lt;col style="width: 112px"/&gt;
&lt;/colgroup&gt;
&lt;thead&gt;
&lt;tr style="height: 26.67px"&gt;
&lt;td style="vertical-align: middle; width: 88px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt;契約締結先&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 136.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt;契約内容&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 131.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt;出資比率&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 168px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt;合弁会社名&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 112px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt;設立年月&lt;/p&gt;
&lt;/td&gt;
