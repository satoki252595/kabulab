&lt;td style="vertical-align: middle; width: 148.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 17.333333333333333333333333333px; margin-right: 42px; text-align: right"&gt;5,851百万円&lt;/p&gt;
&lt;/td&gt;
