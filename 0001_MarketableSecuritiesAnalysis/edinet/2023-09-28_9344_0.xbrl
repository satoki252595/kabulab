&lt;img alt="0101010_004.png" src="images/0101010_004.png" style="height: 383.47px; width: 619.93px"/&gt;
&lt;/p&gt;
&lt;p style="line-height: 1; text-align: center"&gt; &lt;/p&gt;
&lt;p style="text-align: left"&gt; &lt;/p&gt;
</jpcrp_cor:DescriptionOfBusinessTextBlock>
