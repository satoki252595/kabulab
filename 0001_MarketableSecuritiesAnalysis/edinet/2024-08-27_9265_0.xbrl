&lt;col style="width:42.8pt;min-width:42.8pt;"/&gt;
&lt;col style="width:33pt;min-width:33pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:15pt;min-height:15pt;"&gt;
