&lt;p style="text-align: center"&gt;11回&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 185px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
