&lt;td style="vertical-align: middle; width: 176.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p class="text_align_justify" style="margin-left: 10px; line-height: 16.666666666666666666666666667px; margin-right: 10px"&gt;大南淳二&lt;/p&gt;
