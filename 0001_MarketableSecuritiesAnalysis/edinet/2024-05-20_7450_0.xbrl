&lt;tr style="height: 33.33px"&gt;
&lt;td style="vertical-align: middle; width: 121px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p class="text_align_justify" style="margin-left: 10px; line-height: 16.666666666666666666666666667px; margin-right: 5.6666666666666666666666666667px"&gt;取締役&lt;/p&gt;
&lt;p style="margin-left: 10px; line-height: 16.666666666666666666666666667px; margin-right: 5.6666666666666666666666666667px; text-align: center"&gt;（監査等委員）&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 176.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p class="text_align_justify" style="margin-left: 10px; line-height: 16.666666666666666666666666667px; margin-right: 10px"&gt;大西勝&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 147.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 16.666666666666666666666666667px; margin-right: 15px; text-align: right"&gt;3回&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 149.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 16.666666666666666666666666667px; margin-right: 15px; text-align: right"&gt;3回&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 33.33px"&gt;
&lt;td style="vertical-align: middle; width: 121px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p class="text_align_justify" style="margin-left: 10px; line-height: 16.666666666666666666666666667px; margin-right: 5.6666666666666666666666666667px"&gt;取締役&lt;/p&gt;
&lt;p style="line-height: 16.666666666666666666666666667px; text-align: center"&gt;（監査等委員）&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 176.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p class="text_align_justify" style="margin-left: 10px; line-height: 16.666666666666666666666666667px; margin-right: 10px"&gt;倉成美納里&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 147.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 16.666666666666666666666666667px; margin-right: 15px; text-align: right"&gt;10回&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 149.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 16.666666666666666666666666667px; margin-right: 15px; text-align: right"&gt;9回&lt;/p&gt;
&lt;/td&gt;
