&lt;tr style="height: 1.33px"&gt;
&lt;td style="border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none ; width: 400px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 6px; margin-right: 0px; text-align: right; line-height: 13.333333333333333333333333333px"&gt;（単位：千円）&lt;/p&gt;
