&lt;col style="width:44pt;min-width:44pt;"/&gt;
&lt;col style="width:44pt;min-width:44pt;"/&gt;
&lt;col style="width:64.3pt;min-width:64.3pt;"/&gt;
&lt;col style="width:42pt;min-width:42pt;"/&gt;
&lt;col style="width:42pt;min-width:42pt;"/&gt;
&lt;col style="width:52pt;min-width:52pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:20pt;min-height:20pt;"&gt;
