&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:16.8pt;min-height:16.8pt;"&gt;
&lt;td style="vertical-align:middle;border-top-color:#a9a9a9;border-bottom-color:#a9a9a9;border-left-color:#a9a9a9;border-right-color:#a9a9a9;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:0pt;padding-right:0pt;letter-spacing:0pt;line-height:15pt;"&gt;ファイナンス・リース取引に係る債務の額&lt;/p&gt;
