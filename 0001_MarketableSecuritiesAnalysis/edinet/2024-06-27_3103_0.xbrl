&lt;p style="margin-left: 32px; line-height: 1; text-align: left"&gt; &lt;/p&gt;
&lt;p style="margin-left: 32px; line-height: 1; text-align: left"&gt;
&lt;img alt="0102010_015.png" src="images/0102010_015.png" style="height: 82.07px; width: 333.33px"/&gt;
&lt;/p&gt;
&lt;p style="margin-left: 32px; line-height: 1; text-align: left"&gt; &lt;/p&gt;
&lt;div style="margin-left: 32.133333333333333333333333333px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 420.33333333333333333333333333px"&gt;
