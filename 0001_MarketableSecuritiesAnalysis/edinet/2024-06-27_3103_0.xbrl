&lt;/tr&gt;
&lt;tr style="height: 18.67px"&gt;
&lt;td style="vertical-align: top; width: 127px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 12px; text-align: left"&gt;2016年４月&lt;/p&gt;
