&lt;col style="width:66.7pt;min-width:66.7pt;"/&gt;
&lt;col style="width:66.7pt;min-width:66.7pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:14.3pt;min-height:14.3pt;"&gt;
