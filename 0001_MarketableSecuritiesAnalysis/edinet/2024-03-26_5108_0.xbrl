&lt;td style="vertical-align: middle; width: 85px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;
&lt;p style="line-height: 14px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;1963年９月18日&lt;/span&gt;&lt;span style="font-size: 10px"&gt;生&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 228px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;

&lt;p style="margin-left: 5px; line-height: 13.333333333333333333333333333px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;1986年４月　当社入社&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 5px; line-height: 13.333333333333333333333333333px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;2016年７月　当社タイヤ開発第３本部長&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 5px; line-height: 13.333333333333333333333333333px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;2017年１月　当社執行役員&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 5px; line-height: 13.333333333333333333333333333px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;2018年１月　当社常務執行役員&lt;/span&gt;
