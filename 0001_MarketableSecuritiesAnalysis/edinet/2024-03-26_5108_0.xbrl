  <jpcrp_cor:DateOfBirthInformationAboutExecutiveDirectors contextRef="FilingDateInstant_jpcrp030000-asr_E01086-000BannoMasatoMember">1963-09-18</jpcrp_cor:DateOfBirthInformationAboutExecutiveDirectors>
  <jpcrp_cor:CareerSummaryInformationAboutExecutiveDirectorsTextBlock contextRef="FilingDateInstant_jpcrp030000-asr_E01086-000BannoMasatoMember">
&lt;p style="margin-left: 5px; line-height: 13.333333333333333333333333333px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;1986年４月　当社入社&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 5px; line-height: 13.333333333333333333333333333px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;2016年７月　当社タイヤ開発第３本部長&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 5px; line-height: 13.333333333333333333333333333px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;2017年１月　当社執行役員&lt;/span&gt;
