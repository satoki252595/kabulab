&lt;p style="margin-left: 5px; line-height: 13.333333333333333333333333333px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;2019年１月　当社執行役 専務(現)&lt;/span&gt;
&lt;/p&gt;

&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 25px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;
&lt;p style="line-height: 14px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;注１&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 55px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;
&lt;p style="line-height: 14px; margin-right: 6px; text-align: right"&gt;
&lt;span style="font-size: 10px"&gt;12,400&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 31px"&gt;
&lt;td colspan="5" style="vertical-align: middle; width: 593px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;
