&lt;p style="line-height: 1; text-align: center"&gt;＋&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 84px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none ; background-color: #D9D9D9"&gt;
&lt;p style="line-height: 1; text-align: center"&gt;連結&lt;/p&gt;
&lt;p style="line-height: 1; text-align: center"&gt;ＲＯＥ評価&lt;/p&gt;
&lt;p style="line-height: 1; text-align: center"&gt;(０～200％)&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 24px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 1; text-align: center"&gt;×&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 36px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 1; text-align: center"&gt;20％&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 24px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
