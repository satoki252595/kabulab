  <jpcrp_cor:NotesRegardingDividendTextBlock contextRef="Prior1YearDuration_NonConsolidatedMember">
&lt;p style="margin-left: 72px; text-align: left; text-indent: -12px"&gt;４．配当に関する事項&lt;/p&gt;
&lt;p style="margin-left: 84px; text-align: left; text-indent: -12px"&gt;①　配当金支払額&lt;/p&gt;
&lt;p style="margin-left: 72px; text-align: left"&gt;　　該当事項はありません。&lt;/p&gt;
&lt;p style="margin-left: 84px; text-align: left; text-indent: -12px"&gt;②　基準日が当事業年度に属する配当のうち、配当の効力発生日が翌事業年度となるもの&lt;/p&gt;
&lt;p style="margin-left: 84px; text-align: left; text-indent: -12px"&gt;　　該当事項はありません。&lt;/p&gt;
&lt;p style="margin-left: 84px; text-align: left; text-indent: -12px"&gt; &lt;/p&gt;
</jpcrp_cor:NotesRegardingDividendTextBlock>
  <jpcrp_cor:NotesRegardingIssuedSharesAndTreasurySharesTextBlock contextRef="CurrentYearDuration_NonConsolidatedMember">
