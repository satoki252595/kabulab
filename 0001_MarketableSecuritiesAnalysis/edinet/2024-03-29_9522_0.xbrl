  <jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E37205-000MakinoTatsuakiMember">牧野　達明</jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E37205-000MakinoTatsuakiMember">1963-08-06</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock contextRef="FilingDateInstant_jpcrp030000-asr_E37205-000MakinoTatsuakiMember">
&lt;p style="margin-left: 65px; line-height: 15px; margin-right: 3px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;1989年４月　日本国土開発株式会社入社&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 15px; margin-right: 3px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;2000年11月　株式会社新生銀行（現株式会社SBI新生銀行）入行&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 15px; margin-right: 3px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;2004年８月　株式会社東京スター銀行入行&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 15px; margin-right: 3px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;2006年11月　ドイツ銀行入行&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 15px; margin-right: 3px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;2012年11月　トライフットマネジメント株式会社代表取締役&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 15px; margin-right: 3px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;2016年９月　当社入社 金融事業本部戦略事業部長&lt;/span&gt;
