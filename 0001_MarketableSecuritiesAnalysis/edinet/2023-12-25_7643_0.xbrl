&lt;/tr&gt;
&lt;tr style="height: 19px"&gt;
&lt;td style="vertical-align: top; width: 106px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-right: 6px; text-align: left"&gt;2022年４月&lt;/p&gt;
&lt;/td&gt;
