&lt;td style="vertical-align:top;border-top-color:#a9a9a9;border-bottom-color:#a9a9a9;border-right-color:#a9a9a9;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:2.5pt;padding-right:4.5pt;line-height:11pt;font-size:7.5pt;"&gt;当社取締役開発部長&lt;/p&gt;
