&lt;p style="line-height: 13.333333333333333333333333333px; text-align: left"&gt;月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 16px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: left"&gt;１&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 23.2px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: left"&gt;日&lt;/p&gt;
