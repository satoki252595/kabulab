&lt;p style="line-height: 13.333333333333333333333333333px; margin-right: 24px; text-align: right"&gt;
5,879
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;/div&gt;
&lt;p style="line-height: 12px; text-align: left"&gt; &lt;/p&gt;
