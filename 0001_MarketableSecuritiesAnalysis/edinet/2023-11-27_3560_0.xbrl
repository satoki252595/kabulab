&lt;/table&gt;&lt;p style="clear:both; line-height:0.75pt; width:100%; font-size:0.75pt;"&gt; &lt;/p&gt;
&lt;/div&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:left;padding-left:36pt;padding-right:0pt;margin-top:5pt;margin-bottom:0pt;text-indent:-26.9pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:12pt;font-size:12pt;"&gt; &lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:18pt;"&gt;当事業年度(&lt;span&gt;2023年８月31日&lt;/span&gt;)&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:right;padding-right:16pt;line-height:10pt;"&gt;(単位：千円)&lt;/p&gt;
