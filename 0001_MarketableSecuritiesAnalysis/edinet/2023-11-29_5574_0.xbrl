&lt;colgroup&gt;
&lt;col style="width: 183.66666666666666666666666667px"/&gt;
&lt;col style="width: 400.33333333333333333333333333px"/&gt;
&lt;/colgroup&gt;
&lt;thead&gt;
&lt;tr&gt;
&lt;td style="vertical-align: top; width: 183.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000; background-color: #DBDBDB"&gt;
