&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:14.4pt;min-height:14.4pt;"&gt;
&lt;td style="vertical-align:bottom;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-color:#000000;border-right-color:#000000;overflow:hidden;" valign="bottom"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;"&gt;借入実行残高&lt;/p&gt;
