&lt;td style="vertical-align: middle; width: 254px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;

&lt;p style="margin-left: 60px; line-height: 15px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;1998年４月 大阪ヒルトン株式会社入社&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; line-height: 15px; text-align: left; text-indent: -55px"&gt;
