  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E03456-000MorishitaMasanoriMember">1967-04-01</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
