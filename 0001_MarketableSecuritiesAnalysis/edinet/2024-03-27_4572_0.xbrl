&lt;td style="vertical-align:top;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-right:0pt;line-height:11pt;"&gt;12月&lt;/p&gt;
