&lt;td style="vertical-align:middle;border-bottom-style:solid;border-bottom-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:right;padding-left:0pt;padding-right:9.1pt;"&gt;(単位：千円)&lt;/p&gt;
