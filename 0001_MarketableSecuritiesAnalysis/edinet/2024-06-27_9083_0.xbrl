  <jpcrp_cor:InformationForEachProductOrServiceTextBlock contextRef="Prior1YearDuration">
&lt;p style="margin-left: 66px; line-height: 18px; margin-right: 0px; text-align: left; text-indent: -24px"&gt;１．製品及びサービスごとの情報&lt;/p&gt;
&lt;p style="margin-left: 54px; line-height: 18px; margin-right: 0px; text-align: left; text-indent: 12px"&gt;セグメント情報に同様の内容を開示しているため、記載を省略しております。&lt;/p&gt;
</jpcrp_cor:InformationForEachProductOrServiceTextBlock>
