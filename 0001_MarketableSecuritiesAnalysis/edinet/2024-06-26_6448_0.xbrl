&lt;p style="margin-bottom: 2.6666666666666666666666666667px; margin-top: 2.6666666666666666666666666667px; text-align: center"&gt;
&lt;span style="font-size: 12px"&gt; &lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
