&lt;p style="margin-left: 20px; margin-right: 7.5333333333333333333333333333px; text-align: left; text-indent: 12px"&gt; &lt;/p&gt;
&lt;p style="margin-left: 20px; line-height: 6px; margin-right: 7.5333333333333333333333333333px; text-align: left; text-indent: 13.333333333333333333333333333px"&gt; &lt;/p&gt;
