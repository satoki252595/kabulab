&lt;tr style="height: 15px"&gt;
&lt;td style="vertical-align: top; width: 60px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 5px; line-height: 15px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;2020年５月&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 165.53333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 15px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;当社社外監査役（現任）&lt;/span&gt;
&lt;/p&gt;
