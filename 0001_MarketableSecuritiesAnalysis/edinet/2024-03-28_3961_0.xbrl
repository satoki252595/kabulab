&lt;tr style="height: 26.67px"&gt;
&lt;td style="vertical-align: middle; width: 285.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 12px; margin-right: 10px; text-align: left"&gt;新株予約権の行使時の払込金額（円）　※&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 271px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 18px; margin-right: 16px; text-align: center"&gt;500（注）１．３.&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 26.67px"&gt;
&lt;td style="vertical-align: middle; width: 285.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 12px; margin-right: 10px; text-align: left"&gt;新株予約権の行使期間　※&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 271px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; margin-right: 4px; text-align: center"&gt;自　2016年12月25日&lt;/p&gt;
&lt;p style="margin-left: 6px; margin-right: 4px; text-align: center"&gt;至　2024年12月24日&lt;/p&gt;
