&lt;td style="vertical-align: middle; width: 122.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 36px; text-align: right"&gt;0.4&lt;/p&gt;
&lt;/td&gt;
