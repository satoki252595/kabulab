&lt;div class="tbld" style="margin-left:56.5pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:425.5pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
