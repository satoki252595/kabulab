&lt;td style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblR" style="orphans:0;widows:0;padding-right:4.5pt;"&gt;1,097,922千円&lt;/p&gt;
&lt;/td&gt;
