&lt;tr style="height:62.3pt;min-height:62.3pt;"&gt;
&lt;td style="vertical-align:top;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;line-height:12pt;"&gt;&lt;span style="font-size:9pt;"&gt;(9)&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
