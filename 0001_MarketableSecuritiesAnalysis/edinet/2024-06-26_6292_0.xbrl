&lt;/td&gt;
&lt;td style="vertical-align:top;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;text-align:left;line-height:11pt;"&gt;事業年度&lt;br/&gt;(&lt;span&gt;第74期&lt;/span&gt;)&lt;/p&gt;
&lt;/td&gt;
