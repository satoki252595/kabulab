&lt;td style="vertical-align:top;border-top-color:#a9a9a9;border-bottom-color:#a9a9a9;border-left-color:#a9a9a9;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;font-size:7.5pt;"&gt;1973年４月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:top;border-top-color:#a9a9a9;border-bottom-color:#a9a9a9;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-color:#a9a9a9;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:3pt;padding-right:3pt;font-size:7.5pt;"&gt;当社入社&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:12.8pt;min-height:12.8pt;"&gt;
