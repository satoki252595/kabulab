&lt;col style="width: 136px"/&gt;
&lt;col style="width: 237.33333333333333333333333333px"/&gt;
&lt;col style="width: 274.66666666666666666666666667px"/&gt;
&lt;/colgroup&gt;
&lt;thead&gt;
&lt;tr style="height: 24px"&gt;
