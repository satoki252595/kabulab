&lt;td style="vertical-align: middle; width: 386.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 5px; line-height: 11.333333333333333333333333333px; margin-right: 5px; text-align: justify; text-justify: inter-ideograph"&gt;
&lt;span style="font-size: 10px"&gt;監査部 担当（兼）監査部長&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 40px"&gt;
&lt;td style="vertical-align: middle; width: 106.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 15px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;執 行 役 員&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 100px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 15px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;阿　部　規　行&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 386.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 5px; line-height: 11.333333333333333333333333333px; margin-right: 5px; text-align: justify; text-justify: inter-ideograph"&gt;
&lt;span style="font-size: 10px"&gt;ストラクチャードファイナンス部、不動産ファイナンス営業部 担当（兼）&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 5px; line-height: 11.333333333333333333333333333px; margin-right: 5px; text-align: justify; text-justify: inter-ideograph"&gt;
&lt;span style="font-size: 10px"&gt;ストラクチャードファイナンス部長、不動産ファイナンス営業部長&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
