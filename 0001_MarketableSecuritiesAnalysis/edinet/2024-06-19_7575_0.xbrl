&lt;p style="line-height: 17.866666666666666666666666667px; text-align: left"&gt;委員&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 132px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 17.866666666666666666666666667px; text-align: left"&gt;常務取締役&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 120px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 17.866666666666666666666666667px; text-align: left"&gt;山田　健二&lt;/p&gt;
