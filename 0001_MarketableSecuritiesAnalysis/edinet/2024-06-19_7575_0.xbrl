&lt;td style="vertical-align: top; width: 103.8px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: left"&gt;12回/12回&lt;/p&gt;
&lt;/td&gt;
