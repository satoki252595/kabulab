&lt;p style="margin-left: 12px; margin-right: 4px; text-align: left"&gt;退職給付の支払額&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 157.46666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 48px; text-align: right"&gt;△3&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 157.46666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 48px; text-align: right"&gt;－&lt;/p&gt;
