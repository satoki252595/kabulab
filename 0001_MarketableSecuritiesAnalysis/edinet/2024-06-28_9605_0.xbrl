&lt;p style="line-height: 13.333333333333333333333333333px; margin-right: 6px; text-align: right"&gt;318&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 56px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 2.6666666666666666666666666667px; line-height: 13.333333333333333333333333333px; margin-right: 2.6666666666666666666666666667px; text-align: left"&gt;自己資金及び借入金&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 64px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;2024.1&lt;/p&gt;
