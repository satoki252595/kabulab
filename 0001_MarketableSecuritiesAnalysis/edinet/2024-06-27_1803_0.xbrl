&lt;span style="font-size: 14px"&gt;（管理職総数に占める比率）&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 146.66666666666666666666666667px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 0px; margin-right: 0px; text-align: center"&gt;
&lt;span style="font-size: 14px"&gt;女性管理職比率&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 0px; margin-right: 0px; text-align: center"&gt;
&lt;span style="font-size: 14px"&gt;目標値&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 46.67px"&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 86.66666666666666666666666667px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 6px; margin-right: 0px; text-align: left"&gt;
&lt;span style="font-size: 14px"&gt;女性従業員&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 146.66666666666666666666666667px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 0px; margin-right: 0px; text-align: center"&gt;
&lt;span style="font-size: 14px"&gt;1,995名&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 0px; margin-right: 0px; text-align: center"&gt;
&lt;span style="font-size: 14px"&gt;（18.2％）&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 200px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 0px; margin-right: 0px; text-align: center"&gt;
&lt;span style="font-size: 14px"&gt;167名&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 0px; margin-right: 0px; text-align: center"&gt;
&lt;span style="font-size: 14px"&gt;（3.9％）&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 146.66666666666666666666666667px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 0px; margin-right: 0px; text-align: center"&gt;
&lt;span style="font-size: 14px"&gt;2026年度&lt;/span&gt;&lt;span style="font-size: 14px"&gt;  6&lt;/span&gt;&lt;span style="font-size: 14px"&gt;％&lt;/span&gt;&lt;span style="font-size: 14px"&gt;以上&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 0px; margin-right: 0px; text-align: center"&gt;
&lt;span style="font-size: 14px"&gt;2030年度 10％以上&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
