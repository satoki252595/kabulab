&lt;p style="line-height: 15.333333333333333333333333333px; text-align: justify; text-justify: inter-ideograph"&gt;
&lt;span style="font-size: 14px"&gt; (23)&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 128px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 15.333333333333333333333333333px; text-align: left"&gt;
