  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E31344-000ShibataYujiMember">1961-09-12</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
