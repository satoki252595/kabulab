&lt;div class="tbld" style="margin-left:27pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:315pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
&lt;col style="width:210pt;min-width:210pt;"/&gt;
