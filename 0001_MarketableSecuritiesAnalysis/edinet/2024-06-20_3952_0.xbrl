&lt;p style="line-height: 14.333333333333333333333333333px; margin-right: 25px; text-align: right"&gt;
&lt;span style="font-size: 10px"&gt;－&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
