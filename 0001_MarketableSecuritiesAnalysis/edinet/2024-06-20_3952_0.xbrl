&lt;p style="line-height: 14.333333333333333333333333333px; margin-right: 3.6666666666666666666666666667px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;(注)4&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
