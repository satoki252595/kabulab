&lt;td style="vertical-align: top; width: 136px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6.0666666666666666666666666667px; line-height: 1; margin-right: 6.0666666666666666666666666667px; text-align: left"&gt;緑のノーネットロス&lt;/p&gt;
&lt;p style="margin-left: 6.0666666666666666666666666667px; line-height: 1; margin-right: 6.0666666666666666666666666667px; text-align: left"&gt;（緑の復元）&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 159.46666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6.0666666666666666666666666667px; line-height: 1; margin-right: 6.0666666666666666666666666667px; text-align: center"&gt;14.0ha　以上&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 136.53333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6.0666666666666666666666666667px; line-height: 1; margin-right: 6.0666666666666666666666666667px; text-align: center"&gt;23.0ha　以上&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 152.53333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 21.333333333333333333333333333px; text-align: center"&gt;59.0ha（工場の面積分)&lt;/p&gt;
