&lt;tr style="height: 40.6px"&gt;
&lt;td style="vertical-align: middle; width: 32px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;急性&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 88px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 10px; line-height: 13.333333333333333333333333333px; text-align: left; text-indent: -10px"&gt;
&lt;span style="font-size: 10px"&gt;・異常気象による大規模災害&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 112px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 10px; line-height: 13.333333333333333333333333333px; text-align: left; text-indent: -10px"&gt;
&lt;span style="font-size: 10px"&gt;・河川の氾濫、巨大台風、サプライチェーンの分断、渇水などに&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 10px; line-height: 13.333333333333333333333333333px; text-align: left; text-indent: -10px"&gt;
&lt;span style="font-size: 10px"&gt;  よる生産支障&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 32px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;大&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 136px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 10px; line-height: 13.333333333333333333333333333px; text-align: left; text-indent: -10px"&gt;
&lt;span style="font-size: 10px"&gt;・BCPのレジリエンス強化による盤石な生産体制の確保と競争力の向上&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 32px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;中&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td rowspan="2" style="vertical-align: middle; width: 176px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; margin-top: 4px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;・BCPのレジリエンス体制・訓練の強化&lt;/span&gt;
&lt;/p&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; margin-top: 4px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;・緊急時における重要インフラの確保&lt;/span&gt;
&lt;/p&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; margin-top: 4px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;・土地・建屋の耐久性、浸水リスクの&lt;/span&gt;
&lt;/p&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; margin-top: 4px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;  点検・改修&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 10px; line-height: 13.333333333333333333333333333px; margin-bottom: 5px; text-align: left; text-indent: -10px"&gt;
&lt;span style="font-size: 10px"&gt;・耐久、耐水、耐熱性に優れた機能性材料開発および新製品開発&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 32.4px"&gt;
&lt;td style="vertical-align: middle; width: 32px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;慢性&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 88px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;・気温上昇&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 10px; line-height: 13.333333333333333333333333333px; text-align: left; text-indent: -10px"&gt;
&lt;span style="font-size: 10px"&gt;・降水、気象パターンの変化&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 112px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;・温暖化による製品耐久&lt;/span&gt;
&lt;/p&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;  性の不足で品質不具合&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 32px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;中&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 136px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 10px; line-height: 13.333333333333333333333333333px; text-align: left; text-indent: -10px"&gt;
&lt;span style="font-size: 10px"&gt;・製品の耐久性の充実で付加価値が向上し、収益向上&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 32px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;中&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;/div&gt;
&lt;p style="line-height: 1; text-align: left"&gt; &lt;/p&gt;
