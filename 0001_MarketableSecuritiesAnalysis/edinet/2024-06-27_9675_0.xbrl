&lt;p style="margin-left: 6px; margin-right: 6.4px; text-align: right"&gt;(8)&lt;/p&gt;
&lt;p style="margin-left: 6px; margin-right: 6.4px; text-align: right"&gt;[－]&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 133.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; margin-right: 12px; text-align: right"&gt;4&lt;/p&gt;
&lt;p style="margin-left: 6px; margin-right: 6.4px; text-align: right"&gt;(2)&lt;/p&gt;
&lt;p style="margin-left: 6px; margin-right: 6.4px; text-align: right"&gt;[－]&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 26.67px"&gt;
&lt;td style="vertical-align: middle; width: 173.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: left"&gt;　計&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 133.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; margin-right: 12px; text-align: right"&gt;35,046&lt;/p&gt;
&lt;p style="margin-left: 6px; margin-right: 6.4px; text-align: right"&gt;(25,213)&lt;/p&gt;
&lt;p style="margin-left: 6px; margin-right: 6.4px; text-align: right"&gt;[696]&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 133.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; margin-right: 12px; text-align: right"&gt;33,198&lt;/p&gt;
&lt;p style="margin-left: 6px; margin-right: 6.4px; text-align: right"&gt;(24,227)&lt;/p&gt;
&lt;p style="margin-left: 6px; margin-right: 6.4px; text-align: right"&gt;[231]&lt;/p&gt;
