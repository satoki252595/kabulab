&lt;tr style="height: 17.33px"&gt;
&lt;td style="vertical-align: top; width: 58px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 17.333333333333333333333333333px; text-align: right"&gt;
&lt;span style="font-size: 10px"&gt;2010年４月&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 208.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 2px; line-height: 17.333333333333333333333333333px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;執行役員&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 17.33px"&gt;
