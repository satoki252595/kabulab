&lt;/td&gt;
&lt;td style="vertical-align:middle;background-color:#f2f2f2;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;"&gt;&lt;span style="font-size:7.5pt;"&gt;&lt;b&gt;2&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;
