&lt;/div&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:center;padding-left:35.5pt;padding-right:0pt;margin-top:6pt;margin-bottom:0.0pt;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;font-size:15pt;"&gt; &lt;/p&gt;
&lt;div class="tbld" style="margin-left:0pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
