  <jpcrp_cor:ConsolidatedSubsidiariesMetricsOfConsolidatedSubsidiaries contextRef="CurrentYearInstant_Row1Member">㈱綿半ホームエイド</jpcrp_cor:ConsolidatedSubsidiariesMetricsOfConsolidatedSubsidiaries>
  <jpcrp_cor:ConsolidatedSubsidiariesMetricsOfConsolidatedSubsidiaries contextRef="CurrentYearInstant_Row2Member">㈱綿半Ｊマート</jpcrp_cor:ConsolidatedSubsidiariesMetricsOfConsolidatedSubsidiaries>
