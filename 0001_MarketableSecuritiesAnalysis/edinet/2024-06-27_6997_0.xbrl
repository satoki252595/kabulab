&lt;td colspan="3" style="vertical-align: middle; width: 192px; padding-top: 1px; padding-bottom: 0px; padding-left: 1px; padding-right: 1px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: center"&gt;
&lt;span style="font-family: &amp;apos;ＭＳ ゴシック&amp;apos;"&gt;普通株式１株当たりの時価&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 35.27px"&gt;
&lt;td colspan="5" style="vertical-align: middle; width: 392px; padding-top: 1px; padding-bottom: 0px; padding-left: 1px; padding-right: 1px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: center"&gt;
&lt;span style="font-family: &amp;apos;ＭＳ ゴシック&amp;apos;"&gt;（発行済普通株式数－当社が保有する普通株式の数）&lt;br/&gt;+新たに発行する普通株式の数&lt;/span&gt;
&lt;/p&gt;
