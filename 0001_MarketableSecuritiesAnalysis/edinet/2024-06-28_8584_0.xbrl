&lt;span style="font-size: 14px"&gt;　　　　ROE&lt;/span&gt;
&lt;/p&gt;
&lt;div style="margin-left: 63px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 281.33333333333333333333333333px"&gt;
