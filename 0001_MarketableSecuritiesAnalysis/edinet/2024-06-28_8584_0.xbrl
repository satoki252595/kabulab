&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 287px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 66px"/&gt;
&lt;col style="width: 221px"/&gt;
&lt;/colgroup&gt;
