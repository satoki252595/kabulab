  <jpcrp_cor:NotesRelatedPartiesConsolidatedFinancialStatementsTextBlock contextRef="CurrentYearDuration">
&lt;h6 class="style_lv7"&gt;【関連当事者情報】&lt;/h6&gt;
&lt;p style="margin-left: 14px; line-height: 20px; text-align: left"&gt;
&lt;span style="font-size: 14px"&gt;関連当事者との取引&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 28px; line-height: 20px; text-align: left"&gt;
&lt;span style="font-size: 14px"&gt;連結財務諸表提出会社と関連当事者の取引&lt;/span&gt;
&lt;/p&gt;
&lt;p style="line-height: 18.666666666666666666666666667px; text-align: left"&gt;
&lt;span style="font-size: 14px"&gt;（ア）連結財務諸表提出会社の親会社及び主要株主（会社等の場合に限る。）等&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 14px; line-height: 18.666666666666666666666666667px; text-align: left"&gt;
&lt;span style="font-size: 14px"&gt;前連結会計年度（自　2022年４月１日　至　2023年３月31日）&lt;/span&gt;
&lt;/p&gt;
&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 653.33333333333333333333333334px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 32px"/&gt;
&lt;col style="width: 60px"/&gt;
&lt;col style="width: 50.666666666666666666666666667px"/&gt;
&lt;col style="width: 60px"/&gt;
&lt;col style="width: 60px"/&gt;
&lt;col style="width: 66.666666666666666666666666667px"/&gt;
&lt;col style="width: 50.666666666666666666666666667px"/&gt;
