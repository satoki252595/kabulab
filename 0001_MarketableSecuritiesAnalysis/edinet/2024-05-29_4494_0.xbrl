&lt;p style="margin-right: 6px; text-align: right"&gt;68.73&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 6px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: left"&gt;
&lt;span style="font-size: 12px"&gt; &lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 168px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 3px double #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
