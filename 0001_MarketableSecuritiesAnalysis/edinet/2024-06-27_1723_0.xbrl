&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr style="height: 27px"&gt;
&lt;td rowspan="2" style="vertical-align: middle; width: 173.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;
