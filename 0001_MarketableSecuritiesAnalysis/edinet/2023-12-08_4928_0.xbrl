</jpcrp030000-asr_E24991-000:StrategyTextBlock>
  <jpcrp030000-asr_E24991-000:PolicyOnHumanResourceDevelopmentAndImprovementOfInternalEnvironmentStrategyTextBlock contextRef="FilingDateInstant">
