&lt;colgroup&gt;
&lt;col style="width: 93.33333333333333333333333333px"/&gt;
&lt;col style="width: 62.133333333333333333333333333px"/&gt;
&lt;col style="width: 61.333333333333333333333333333px"/&gt;
