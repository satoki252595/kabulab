&lt;/tr&gt;
&lt;tr style="height: 13.47px"&gt;
&lt;td style="vertical-align: top; width: 96px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt;2024年４月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 528px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 12px; text-align: left"&gt;大阪オフィスを大阪府大阪市北区梅田に移転。&lt;/p&gt;
&lt;/td&gt;
