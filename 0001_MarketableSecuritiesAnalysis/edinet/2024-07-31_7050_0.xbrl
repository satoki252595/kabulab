&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr&gt;
&lt;td rowspan="3" style="border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none ; width: 72px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: left"&gt;調整後&lt;/p&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: left"&gt;行使価額&lt;/p&gt;
&lt;/td&gt;
&lt;td rowspan="3" style="border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none ; width: 32px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
