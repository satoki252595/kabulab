  <jpcrp_cor:NotesSignificantEventsAfterReportingPeriodFinancialStatementsTextBlock contextRef="CurrentYearDuration">
&lt;h6 class="smt_head4" style="padding-left:18pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;text-align:justify;letter-spacing:0pt;line-height:15pt;font-size:9pt;"&gt;(重要な後発事象)&lt;/h6&gt;&lt;p class="smt_text2" style="orphans:0;widows:0;padding-left:13.5pt;"&gt;(自己株式の取得)&lt;/p&gt;&lt;p class="smt_text3" style="orphans:0;widows:0;"&gt;連結財務諸表の「注記事項(重要な後発事象)」に同一の内容を記載しているため、注記を省略しております。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;"&gt; &lt;/p&gt;</jpcrp_cor:NotesSignificantEventsAfterReportingPeriodFinancialStatementsTextBlock>
