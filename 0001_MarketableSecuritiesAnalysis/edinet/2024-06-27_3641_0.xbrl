&lt;p style="margin-left: 27.333333333333333333333333333px; margin-right: 6px; text-align: right; line-height: 16px; text-indent: -21.333333333333333333333333333px"&gt;18,626&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
