  <jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E34994-000OmuraYukikoMember">大村　由紀子</jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors>
