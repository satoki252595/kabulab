&lt;tr style="height: 1.33px"&gt;
&lt;td style="vertical-align: top; width: 79.46666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-right: 6px; text-align: right"&gt;平成16年６月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 568.53333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; margin-right: 4px; text-align: left"&gt;東京都中央区に首都圏営業本部（現東京本社）を開設。&lt;/p&gt;
&lt;/td&gt;
