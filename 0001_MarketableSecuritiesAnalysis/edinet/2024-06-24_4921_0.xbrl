&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-color:#A9A9A9;border-bottom-style:double;border-bottom-width:2.25pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblR" style="orphans:0;widows:0;"&gt;86&lt;/p&gt;
