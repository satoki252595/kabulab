&lt;p style="margin-left: 6px; margin-right: 16px; text-align: right; line-height: 18.666666666666666666666666667px"&gt;3,862&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 24px"&gt;
