&lt;p style="margin-left: 6px; line-height: 1; text-align: left"&gt;テーマ&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 404px; padding-top: 1px; padding-bottom: 0px; padding-left: 1px; padding-right: 1px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
