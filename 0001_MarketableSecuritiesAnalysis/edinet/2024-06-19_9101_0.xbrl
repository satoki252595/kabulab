&lt;p style="margin-left: 0px; margin-right: 0px; text-align: center; line-height: 15px"&gt;
&lt;span style="font-size: 10px"&gt; &lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 0px none #000000; border-top: 0px none #000000; border-right: 0px none #000000; border-bottom: 0px none #000000; width: 200px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center; line-height: 15px"&gt;
&lt;span style="font-family: &amp;apos;ＭＳ ゴシック&amp;apos;; font-size: 10px"&gt;TAYLORED SERVICES PARENT CO., INC.の物流倉庫内&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 0px none #000000; border-top: 0px none #000000; border-right: 0px none #000000; border-bottom: 0px none #000000; width: 200px; vertical-align: top; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 0px; margin-right: 0px; text-align: center; line-height: 15px"&gt;
&lt;span style="font-family: &amp;apos;ＭＳ ゴシック&amp;apos;; font-size: 10px"&gt;自律走行搬送ロボット&lt;/span&gt;
&lt;/p&gt;
