&lt;col style="width:67.8pt;min-width:67.8pt;"/&gt;
&lt;col style="width:67.8pt;min-width:67.8pt;"/&gt;
&lt;col style="width:67.8pt;min-width:67.8pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:0.8pt;min-height:0.8pt;"&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;margin-top:4pt;margin-bottom:4pt;text-justify:inter-ideograph;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:14pt;"&gt;&lt;span style="font-size:6pt;"&gt;会社名&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
