&lt;p style="margin-left: 5px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;同行専務執行役員&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 20px"&gt;
&lt;td style="vertical-align: top; width: 72.733333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 5px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt; &lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 155.26666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 5px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;りそな総合研究所株式会社&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 5px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;代表取締役社長&lt;/span&gt;
