&lt;p style="line-height: 17.333333333333333333333333333px; margin-right: 12px; text-align: left"&gt;1.3％増&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 47.266666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
