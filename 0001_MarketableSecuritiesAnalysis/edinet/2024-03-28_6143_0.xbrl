  <jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E01504-000SanoAyakoMember">佐野　綾子</jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E01504-000SanoAyakoMember">1977-12-09</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
