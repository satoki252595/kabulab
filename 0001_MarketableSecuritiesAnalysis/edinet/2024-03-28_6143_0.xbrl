  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E01504-000GohoraHaruchikaMember">1973-07-20</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock contextRef="FilingDateInstant_jpcrp030000-asr_E01504-000GohoraHaruchikaMember">
&lt;p style="margin-left: 61px; line-height: 15px; text-align: left; text-indent: -56px"&gt;
&lt;span style="font-size: 10px"&gt;2002年10月 中央青山監査法人入所&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 61px; line-height: 15px; text-align: left; text-indent: -56px"&gt;
&lt;span style="font-size: 10px"&gt;2004年９月 監査法人トーマツ(現 有限責任監査法人トーマツ）入所&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 61px; line-height: 15px; text-align: left; text-indent: -56px"&gt;
&lt;span style="font-size: 10px"&gt;2008年８月 郷原会計事務所開設 所長（現）&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 61px; line-height: 15px; text-align: left; text-indent: -56px"&gt;
&lt;span style="font-size: 10px"&gt;2012年11月 株式会社ダイヨシトラスト（現 大和ハウスパーキング株式会社）社外監査役&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 61px; line-height: 15px; text-align: left; text-indent: -56px"&gt;
&lt;span style="font-size: 10px"&gt;2023年３月 当社社外監査役&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 61px; line-height: 15px; text-align: left; text-indent: -56px"&gt;
&lt;span style="font-size: 10px"&gt;2024年３月 当社社外取締役（現）&lt;/span&gt;
&lt;/p&gt;
