&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblR" style="orphans:0;widows:0;padding-right:1.5pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;line-height:9pt;font-size:7.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;130,923,676&lt;/span&gt;&lt;/p&gt;
