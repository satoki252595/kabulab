&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;"&gt;&lt;span style="font-family:&amp;apos;ＭＳ Ｐ明朝&amp;apos;;"&gt;インタレスト・カバレッジ・&lt;/span&gt;&lt;br/&gt;&lt;span style="font-family:&amp;apos;ＭＳ Ｐ明朝&amp;apos;;"&gt;レシオ (倍)&lt;/span&gt;&lt;/p&gt;
