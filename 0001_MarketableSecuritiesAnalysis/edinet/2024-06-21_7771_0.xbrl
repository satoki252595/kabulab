&lt;col style="width:68.8pt;min-width:68.8pt;"/&gt;
&lt;col style="width:68.8pt;min-width:68.8pt;"/&gt;
&lt;col style="width:68.8pt;min-width:68.8pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:13.5pt;min-height:13.5pt;"&gt;
&lt;td rowspan="2" style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;"&gt;&lt;span style="font-family:&amp;apos;ＭＳ Ｐ明朝&amp;apos;;"&gt;役員区分&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td rowspan="2" style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;"&gt;&lt;span style="font-family:&amp;apos;ＭＳ Ｐ明朝&amp;apos;;"&gt;報酬等の総額&lt;/span&gt;&lt;br/&gt;&lt;span style="font-family:&amp;apos;ＭＳ Ｐ明朝&amp;apos;;"&gt;(千円)&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
