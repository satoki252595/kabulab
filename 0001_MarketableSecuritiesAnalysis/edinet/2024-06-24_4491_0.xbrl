  <jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E35466-000TakenakaKatsuakiMember">竹中 勝昭</jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E35466-000TakenakaKatsuakiMember">1944-10-04</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock contextRef="FilingDateInstant_jpcrp030000-asr_E35466-000TakenakaKatsuakiMember">
&lt;p style="margin-left: 75px; line-height: 16.666666666666666666666666667px; margin-right: 3px; text-align: left; text-indent: -70px"&gt;
