&lt;td style="vertical-align: middle; width: 162px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: left"&gt;　当連結会計年度&lt;/p&gt;
&lt;p style="text-align: left"&gt;　（自2023年６月１日&lt;/p&gt;
&lt;p style="text-align: left"&gt;　　至2024年５月31日）&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 225px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: left"&gt;　株式会社ＮＴＴドコモ&lt;/p&gt;
&lt;p style="text-align: left"&gt;　ＵＴグループ株式会社&lt;/p&gt;
&lt;p style="text-align: left"&gt;　トレンドマイクロ株式会社&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 100px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 5.3333333333333333333333333333px; text-align: right"&gt;1,137,690&lt;/p&gt;
&lt;p style="margin-right: 5.3333333333333333333333333333px; text-align: right"&gt;219,625&lt;/p&gt;
&lt;p style="margin-right: 5.3333333333333333333333333333px; text-align: right"&gt;192,540&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 100px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 7.5333333333333333333333333333px; text-align: right"&gt;24.2&lt;/p&gt;
&lt;p style="margin-right: 7.5333333333333333333333333333px; text-align: right"&gt;4.7&lt;/p&gt;
&lt;p style="margin-right: 7.5333333333333333333333333333px; text-align: right"&gt;4.1&lt;/p&gt;
