&lt;td style="vertical-align: middle; width: 375px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 2px solid #000000; border-right: 2px solid #000000; border-bottom: 2px solid #000000; background-color: #D6C6AF"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;主な内容・目的&lt;/p&gt;
