  <jpcrp_cor:ChangesInNumberOfIssuedSharesStatedCapitalEtcTextBlock contextRef="FilingDateInstant">
&lt;h4&gt;（４）【発行済株式総数、資本金等の推移】&lt;/h4&gt;
&lt;p style="line-height: 1.3333333333333333333333333333px; text-align: left"&gt; &lt;/p&gt;
&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 653px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 166px"/&gt;
&lt;col style="width: 102px"/&gt;
&lt;col style="width: 91px"/&gt;
&lt;col style="width: 78px"/&gt;
&lt;col style="width: 72px"/&gt;
&lt;col style="width: 72px"/&gt;
&lt;col style="width: 72px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr style="height: 55px"&gt;
&lt;td style="vertical-align: middle; width: 166px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 2px solid #000000; border-top: 2px solid #000000; border-right: 2px solid #000000; border-bottom: 2px solid #000000; background-color: #D6C6AF"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;年　　月　　日&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 102px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 2px solid #000000; border-top: 2px solid #000000; border-right: 1px solid #000000; border-bottom: 2px solid #000000; background-color: #D6C6AF"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;発行済株式&lt;/p&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;総数増減数&lt;/p&gt;
