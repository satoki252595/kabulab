&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;2024年３月31日&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 20px"&gt;
&lt;td style="vertical-align: middle; width: 288px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 2px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 2px solid #000000"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: justify; text-justify: inter-ideograph"&gt;割引率&lt;/p&gt;
