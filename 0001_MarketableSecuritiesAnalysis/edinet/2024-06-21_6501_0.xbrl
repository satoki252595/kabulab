&lt;p style="line-height: 1; text-align: center"&gt;
&lt;img alt="0104010_002.png" src="images/0104010_002.png" style="height: 80px; width: 73.46px"/&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 108px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 1; text-align: center"&gt;
&lt;img alt="0104010_003.png" src="images/0104010_003.png" style="height: 80px; width: 73.46px"/&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 108px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 1; text-align: center"&gt;
&lt;img alt="0104010_004.png" src="images/0104010_004.png" style="height: 80px; width: 73.4px"/&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 108px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 1; text-align: center"&gt;
&lt;img alt="0104010_005.png" src="images/0104010_005.png" style="height: 75px; width: 68.8px"/&gt;
