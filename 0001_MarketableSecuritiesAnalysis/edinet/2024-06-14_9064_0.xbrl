&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 300.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;

&lt;p style="margin-left: 60px; line-height: 15px; margin-right: 5px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;1986年４月 弁護士および公認会計士登録&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; line-height: 15px; margin-right: 5px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;1992年７月 松田法律事務所開設（現）&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; line-height: 15px; margin-right: 5px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;2007年６月 ㈱スクウェア・エニックス監査役&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; line-height: 15px; margin-right: 5px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;2008年６月 西華産業㈱監査役&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; line-height: 15px; margin-right: 5px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;2012年５月 日本弁護士連合会監事&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; line-height: 15px; margin-right: 5px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;2014年６月 公益財団法人アサヒグループ芸術文化財団（現公益財団法人アサヒグループ財団）監事（現）&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; line-height: 15px; margin-right: 5px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;2020年６月 当社監査役就任（現）&lt;/span&gt;
&lt;/p&gt;

&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 36px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 15px; margin-right: 5px; text-align: right"&gt;
&lt;span style="font-size: 10px"&gt;(注)７&lt;/span&gt;
