&lt;td style="vertical-align: top; width: 91px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 13.333333333333333333333333333px; line-height: 17.333333333333333333333333333px; text-align: left"&gt;2004年11月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 557px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
