&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 70.8px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 11.333333333333333333333333333px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;コントラクト・ロジス&lt;/span&gt;
&lt;/p&gt;
&lt;p style="line-height: 11.333333333333333333333333333px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;ティクス事業&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 58px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 11.333333333333333333333333333px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;グローバル&lt;/span&gt;
