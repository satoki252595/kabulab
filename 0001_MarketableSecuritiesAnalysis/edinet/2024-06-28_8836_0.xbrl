&lt;col style="width:186.8pt;min-width:186.8pt;"/&gt;
&lt;col style="width:28.4pt;min-width:28.4pt;"/&gt;
&lt;col style="width:39.7pt;min-width:39.7pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:18.8pt;min-height:18.8pt;"&gt;
