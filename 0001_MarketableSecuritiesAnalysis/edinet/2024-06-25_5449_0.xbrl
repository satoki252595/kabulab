&lt;/tr&gt;
&lt;tr style="height:20.7pt;min-height:20.7pt;"&gt;
&lt;td style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:0pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;letter-spacing:0.0pt;line-height:10pt;font-size:10pt;"&gt; &lt;/p&gt;
