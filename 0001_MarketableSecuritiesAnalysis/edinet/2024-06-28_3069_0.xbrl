&lt;/div&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;line-height:14pt;"&gt;　&lt;/p&gt;&lt;p class="smt_text3" style="orphans:0;widows:0;padding-left:18pt;text-indent:9pt;line-height:14pt;"&gt;担保に係る債務&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;line-height:9.5pt;font-size:9.5pt;"&gt; &lt;/p&gt;
&lt;div class="tbld" style="text-align:left;margin-left:30.1pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" class="align_left" style="border-collapse:collapse;border:solid 0pt #000000;width:451.9pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
&lt;col style="width:159.9pt;min-width:159.9pt;"/&gt;
