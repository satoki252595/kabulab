&lt;col style="width:178.5pt;min-width:178.5pt;"/&gt;
&lt;col style="width:28.5pt;min-width:28.5pt;"/&gt;
&lt;col style="width:39.8pt;min-width:39.8pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:22.5pt;min-height:22.5pt;"&gt;
