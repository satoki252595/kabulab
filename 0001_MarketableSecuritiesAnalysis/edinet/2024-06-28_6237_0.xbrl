&lt;span style="font-size: 10px"&gt;2014年５月　株式会社東京個別指導学院　社外監査役（現任）&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 14.4px; margin-right: 5px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;2014年12月　株式会社桧家ホールディングス（現　株式会社ヒノキヤグループ）　社外監査役（現任）&lt;/span&gt;
&lt;/p&gt;
</jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock>
  <jpcrp_cor:TermOfOfficeInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E32189-000NagasawaMasahiroMember">(注)４</jpcrp_cor:TermOfOfficeInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:OfficialTitleOrPositionInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E32189-000HosoyaYoshinoriMember">監査役</jpcrp_cor:OfficialTitleOrPositionInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E32189-000HosoyaYoshinoriMember">細谷　義徳</jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E32189-000HosoyaYoshinoriMember">1945-04-09</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock contextRef="FilingDateInstant_jpcrp030000-asr_E32189-000HosoyaYoshinoriMember">
