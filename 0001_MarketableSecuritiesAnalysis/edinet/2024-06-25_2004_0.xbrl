  <jpcrp_cor:ConsolidatedSubsidiariesMetricsOfConsolidatedSubsidiaries contextRef="CurrentYearInstant_Row1Member">ガーデンベーカリー㈱</jpcrp_cor:ConsolidatedSubsidiariesMetricsOfConsolidatedSubsidiaries>
