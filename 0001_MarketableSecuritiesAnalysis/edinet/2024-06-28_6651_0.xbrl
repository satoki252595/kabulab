&lt;tr style="height:33.0pt;min-height:33.0pt;"&gt;
&lt;td style="vertical-align:top;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;line-height:11pt;"&gt;&lt;span&gt;第76期&lt;/span&gt;&lt;br/&gt;第２四半期&lt;/p&gt;
&lt;/td&gt;
