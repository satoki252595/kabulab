dows:0;text-align:justify;padding-left:320pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;font-size:7.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;（単位：千円）&lt;/span&gt;&lt;/p&gt;
&lt;div class="tbld" style="margin-left:30pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
