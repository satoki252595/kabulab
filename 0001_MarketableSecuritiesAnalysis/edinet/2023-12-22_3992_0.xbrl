  <jpcrp030000-asr_E33367-000:DescriptionOfMetricsRelatedToPolicyOnHumanResourceDevelopmentAndImprovementOfInternalEnvironmentAndTargetsAndResultsUsingSuchMetricsMetricsAndTargetsTextBlock contextRef="FilingDateInstant">
&lt;p style="text-align: left"&gt; &lt;/p&gt;
&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 656.79999999999999999999999999px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 218.93333333333333333333333333px"/&gt;
