  <jpcrp030000-asr_E04800-000:NotesRegardingPropertyForLeaseTextBlock contextRef="CurrentYearInstant_NonConsolidatedMember">&lt;p class="smt_text6" style="orphans:0;widows:0;"&gt;※２　リース用資産の内訳&lt;/p&gt;
