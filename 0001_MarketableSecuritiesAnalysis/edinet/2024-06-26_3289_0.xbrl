&lt;col style="width: 78px"/&gt;
&lt;col style="width: 57px"/&gt;
&lt;col style="width: 78px"/&gt;
&lt;col style="width: 68px"/&gt;
&lt;col style="width: 47px"/&gt;
&lt;col style="width: 47px"/&gt;
&lt;col style="width: 47px"/&gt;
&lt;col style="width: 47px"/&gt;
&lt;/colgroup&gt;
&lt;thead&gt;
&lt;tr style="height: 24.33px"&gt;
