  <jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock contextRef="FilingDateInstant_jpcrp030000-asr_E03481-000TamuraEijiMember">
&lt;p style="margin-left: 65px; line-height: 13.333333333333333333333333333px; margin-right: 3px; text-align: left; text-indent: -60px"&gt;
