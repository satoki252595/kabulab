&lt;p style="margin-left: 48px; line-height: 17.333333333333333333333333333px; margin-right: 0px; text-align: left; text-indent: -36px"&gt; &lt;/p&gt;
</jpcrp_cor:FootnotesRegardingSegmentInformationTableTextBlock>
