&lt;td style="vertical-align: middle; width: 189.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;

&lt;p style="margin-left: 62.666666666666666666666666667px; line-height: 15px; margin-right: 2.6666666666666666666666666667px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;1978年４月　運輸省(現　国土交通省)入省 &lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 62.666666666666666666666666667px; line-height: 15px; margin-right: 2.6666666666666666666666666667px; text-align: left; text-indent: -60px"&gt;
