&lt;p style="margin-left: 0px; margin-right: 0px; text-align: center"&gt; &lt;/p&gt;
&lt;p style="margin-left: 0px; margin-right: 0px; text-align: center; line-height: 1"&gt;
&lt;img alt="0102010_001.png" src="images/0102010_001.png" style="height: 366.6px; width: 580px"/&gt;
&lt;/p&gt;
