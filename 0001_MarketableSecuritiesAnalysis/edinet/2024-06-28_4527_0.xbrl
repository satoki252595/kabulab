&lt;/td&gt;
&lt;td style="vertical-align:bottom;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="bottom"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;margin-top:3pt;margin-bottom:3pt;"&gt;関係会社数&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:bottom;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="bottom"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;margin-top:3pt;margin-bottom:3pt;"&gt;主な関係会社&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:39.8pt;min-height:39.8pt;"&gt;
