&lt;p style="line-height: 1; margin-right: 6px; text-align: center"&gt;場所&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 140px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 1; margin-right: 6px; text-align: center"&gt;種類&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 133.13333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="line-height: 1; margin-right: 6px; text-align: center"&gt;減損損失（百万円）&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 26.67px"&gt;
&lt;td rowspan="3" style="vertical-align: middle; width: 159.46666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; line-height: 1; margin-right: 6px; text-align: center"&gt;研究設備及び製造設備&lt;/p&gt;
&lt;/td&gt;
&lt;td rowspan="3" style="vertical-align: middle; width: 159.93333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; line-height: 1; margin-right: 6px; text-align: center"&gt;大阪府八尾市&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 140px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; line-height: 1; margin-right: 6px; text-align: justify; text-justify: inter-ideograph"&gt;建物及び構築物&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 133.13333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="line-height: 1; margin-right: 6px; text-align: right"&gt;30&lt;/p&gt;
&lt;/td&gt;
