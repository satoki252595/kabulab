&lt;tr style="height: 16px"&gt;
&lt;td style="vertical-align: top; width: 86.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; line-height: 17.333333333333333333333333333px; margin-right: 6px; text-align: left"&gt;1968年２月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 560.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; line-height: 17.333333333333333333333333333px; margin-right: 6px; text-align: left"&gt;彦根ゼラチン㈲を設立（現・連結子会社）[2005年12月  彦根ゼラチン㈱に組織変更]&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
