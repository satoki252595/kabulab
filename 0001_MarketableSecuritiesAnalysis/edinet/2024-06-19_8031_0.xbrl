&lt;col style="width: 7px"/&gt;
&lt;col style="width: 64px"/&gt;
&lt;col style="width: 64px"/&gt;
&lt;col style="width: 64px"/&gt;
&lt;col style="width: 64px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr style="height: 18px"&gt;
&lt;td style="vertical-align: middle; width: 43px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: left"&gt;
&lt;span style="font-size: 10px"&gt; &lt;/span&gt;
