&lt;td style="vertical-align: middle; width: 100px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px dashed #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 18px; line-height: 16.666666666666666666666666667px; text-align: left"&gt;内田　康弘&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 413.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px dashed #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; line-height: 16.666666666666666666666666667px; text-align: left"&gt;エネルギーソリューション本部長&lt;/p&gt;
