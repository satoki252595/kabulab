&lt;/table&gt;&lt;p style="clear:both; line-height:0.75pt; width:100%; font-size:0.75pt;"&gt; &lt;/p&gt;
&lt;/div&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;margin-bottom:0pt;line-height:15pt;font-size:15pt;"&gt; &lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:54pt;margin-bottom:0pt;text-indent:-21pt;line-height:15pt;font-size:10.5pt;"&gt;&lt;span style="font-family:&amp;apos;ＭＳ 明朝&amp;apos;;font-size:9pt;"&gt;（ご参考）2024年４月30日時点の自己株式の保有&lt;/span&gt;&lt;/p&gt;
&lt;div class="tbld" style="margin-left:40pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:382.4pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
&lt;col style="width:155.9pt;min-width:155.9pt;"/&gt;
&lt;col style="width:226.5pt;min-width:226.5pt;"/&gt;
