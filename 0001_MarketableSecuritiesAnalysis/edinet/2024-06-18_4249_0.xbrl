&lt;/td&gt;
&lt;td style="vertical-align: top; width: 135.26666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px dashed #000000; border-bottom: 0px none "&gt;
&lt;p class="text_align_justify"&gt;［樹脂加工製品事業］&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 401.8px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px dashed #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; text-align: left"&gt;関東工場を群馬県に設置&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 16px"&gt;
&lt;td style="vertical-align: top; width: 89.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="text-align: center"&gt;1982年10月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 135.26666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px dashed #000000; border-bottom: 0px none "&gt;
