&lt;/table&gt;&lt;p style="clear:both; line-height:0.75pt; width:100%; font-size:0.75pt;"&gt; &lt;/p&gt;
&lt;/div&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;line-height:13pt;font-size:13pt;"&gt; &lt;/p&gt;</jpcrp030000-asr_E05282-000:NotesRegardingProvisionForLossOnOrderReceivedIncludedInCostOfSalesTextBlock>
