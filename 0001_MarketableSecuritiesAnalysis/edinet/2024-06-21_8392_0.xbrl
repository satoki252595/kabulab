  <jpcrp_cor:NotesAssetRetirementObligationsConsolidatedFinancialStatementsTextBlock contextRef="CurrentYearDuration">
&lt;h6 class="smt_head5" style="padding-left:4.5pt;"&gt;(資産除去債務関係)&lt;/h6&gt;&lt;p class="smt_text4" style="orphans:0;widows:0;padding-left:9pt;"&gt;金額に重要性が乏しいため、記載を省略しております。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;"&gt; &lt;/p&gt;</jpcrp_cor:NotesAssetRetirementObligationsConsolidatedFinancialStatementsTextBlock>
  <jpcrp_cor:NotesRealEstateForLeaseEtcConsolidatedFinancialStatementsTextBlock contextRef="CurrentYearDuration">
