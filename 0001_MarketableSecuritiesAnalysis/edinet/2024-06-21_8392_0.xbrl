&lt;col style="width:61pt;min-width:61pt;"/&gt;
&lt;col style="width:64.5pt;min-width:64.5pt;"/&gt;
&lt;col style="width:61pt;min-width:61pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:22.7pt;min-height:22.7pt;"&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;margin-top:0pt;letter-spacing:0pt;line-height:13pt;font-size:13pt;"&gt; &lt;/p&gt;
&lt;/td&gt;
