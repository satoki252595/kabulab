&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 119.93333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 2px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; margin-right: 18px; text-align: right"&gt;74,592&lt;/p&gt;
