&lt;tr style="height: 9.67px"&gt;
&lt;td colspan="2" rowspan="4" style="vertical-align: middle; width: 48px; padding-top: 0px; padding-bottom: 0px; padding-left: 6.6px; padding-right: 6.6px; border-left: 2px solid #000000; border-top: 2px solid #000000; border-right: 2px solid #000000; border-bottom: 2px solid #000000"&gt;
