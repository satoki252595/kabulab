&lt;p style="margin-left: 24px; line-height: 19.333333333333333333333333333px; margin-right: 6px; text-align: right"&gt;
147.6％&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 148.8px; padding-top: 1px; padding-bottom: 0px; padding-left: 1px; padding-right: 1px; border-left: 0px none ; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 24px; line-height: 19.333333333333333333333333333px; margin-right: 6px; text-align: right"&gt;－&lt;/p&gt;
