&lt;col style="width: 120px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr style="height: 56.27px"&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 128px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 0px; margin-right: 0px; text-align: center"&gt;提出会社&lt;/p&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center"&gt;（及び連結子会社）&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 128px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center"&gt;管理職に占める女性労働者の割合&lt;/p&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center"&gt;（注）１&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 120px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center"&gt;男性労働者の育児休業等取得率&lt;/p&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center"&gt;（注）２&lt;/p&gt;
&lt;/td&gt;
