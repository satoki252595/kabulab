&lt;td rowspan="3" style="vertical-align: middle; width: 165.2px; padding-top: 0px; padding-bottom: 0px; padding-left: 6.6px; padding-right: 6.6px; border-left: 0px none ; border-top: 0px none ; border-right: 2px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 1; text-align: left"&gt;
&lt;span style="font-weight: bold"&gt;集約化を含め、物流機能を効率化&lt;/span&gt;
&lt;/p&gt;
&lt;p style="line-height: 1; text-align: left"&gt; &lt;/p&gt;
&lt;p style="line-height: 1; text-align: left"&gt;
&lt;span style="font-weight: bold"&gt;省エネルギー・低炭素製品・遮熱商品・冷凍商品などの開発&lt;/span&gt;
&lt;/p&gt;
&lt;p style="line-height: 1; text-align: left"&gt; &lt;/p&gt;
&lt;p style="line-height: 1; text-align: left"&gt;
&lt;span style="font-weight: bold"&gt;再生可能エネルギー設備を導入&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 8.73px"&gt;
&lt;td style="vertical-align: middle; width: 88px; padding-top: 0px; padding-bottom: 0px; padding-left: 6.6px; padding-right: 6.6px; border-left: 0px none ; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
