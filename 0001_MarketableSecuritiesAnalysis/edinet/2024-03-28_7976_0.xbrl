&lt;p style="text-align: right"&gt;3,298&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 42px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
