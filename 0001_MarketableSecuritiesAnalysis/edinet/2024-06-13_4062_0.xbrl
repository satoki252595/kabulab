&lt;col style="width:340.2pt;min-width:340.2pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:12pt;min-height:12pt;"&gt;
&lt;td style="vertical-align:top;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:0pt;padding-right:0pt;line-height:12pt;"&gt;【株式の種類等】　&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:top;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;text-align:left;padding-left:10.0pt;line-height:11.5pt;"&gt;会社法第155条第７号による普通株式の取得&lt;/p&gt;
&lt;/td&gt;
