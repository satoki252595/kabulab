  <jpcrp_cor:NotesShareOptionsEtcConsolidatedFinancialStatementsTextBlock contextRef="CurrentYearDuration">
&lt;h6 class="smt_head5" style="padding-left:18pt;"&gt;(ストック・オプション等関係)&lt;/h6&gt;&lt;p class="smt_text4" style="orphans:0;widows:0;"&gt;前連結会計年度及び当連結会計年度のいずれにおいても該当事項はありません。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;line-height:11pt;font-size:11pt;"&gt; &lt;/p&gt;</jpcrp_cor:NotesShareOptionsEtcConsolidatedFinancialStatementsTextBlock>
  <jpcrp_cor:NotesTaxEffectAccountingConsolidatedFinancialStatementsTextBlock contextRef="CurrentYearDuration">
