  <jpcrp_cor:NotesRegardingNewShareSubscriptionRightsEtcTextBlock contextRef="Prior1YearDuration_NonConsolidatedMember">&lt;p class="smt_text6" style="orphans:0;widows:0;"&gt;２　新株予約権等に関する事項&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-indent:9pt;"&gt;該当事項はありません。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;"&gt; &lt;/p&gt;</jpcrp_cor:NotesRegardingNewShareSubscriptionRightsEtcTextBlock>
