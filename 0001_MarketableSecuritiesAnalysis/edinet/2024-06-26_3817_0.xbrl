&lt;p style="margin-left: 0px; margin-right: 0px; text-align: right; line-height: 14.666666666666666666666666667px"&gt;2024年３月31日現在&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;/div&gt;
