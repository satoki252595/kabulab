&lt;colgroup&gt;
&lt;col style="width: 220.93333333333333333333333333px"/&gt;
&lt;col style="width: 193.8px"/&gt;
&lt;col style="width: 199.6px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr style="height: 26.87px"&gt;
