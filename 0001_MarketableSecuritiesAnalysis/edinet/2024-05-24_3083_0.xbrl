&lt;colgroup&gt;
&lt;col style="width: 205.53333333333333333333333333px"/&gt;
&lt;col style="width: 221.93333333333333333333333333px"/&gt;
&lt;col style="width: 212.93333333333333333333333333px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr&gt;
