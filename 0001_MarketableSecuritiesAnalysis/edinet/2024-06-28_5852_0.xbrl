&lt;/colgroup&gt;
&lt;thead&gt;
&lt;tr style="height: 36px"&gt;
&lt;td style="vertical-align: middle; width: 238px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;区分&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 93px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 14.666666666666666666666666667px; text-align: center"&gt;当期首残高&lt;/p&gt;
&lt;p style="line-height: 14.666666666666666666666666667px; text-align: center"&gt;（百万円）&lt;/p&gt;
