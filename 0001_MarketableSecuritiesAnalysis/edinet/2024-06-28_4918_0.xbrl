  <jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E01035-000WadaTsukasaMember">和田　司</jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E01035-000WadaTsukasaMember">1964-12-20</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock contextRef="FilingDateInstant_jpcrp030000-asr_E01035-000WadaTsukasaMember">
