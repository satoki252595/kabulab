  <jpcrp_cor:ChangesInNumberOfIssuedSharesStatedCapitalEtcTextBlock contextRef="FilingDateInstant">
&lt;h4&gt;（4）【発行済株式総数、資本金等の推移】&lt;/h4&gt;
&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 650.33333333333333333333333335px; margin-left: auto; margin-right: auto"&gt;
&lt;colgroup&gt;
&lt;col style="width: 93.13333333333333333333333333px"/&gt;
&lt;col style="width: 92.86666666666666666666666667px"/&gt;
&lt;col style="width: 92.86666666666666666666666667px"/&gt;
&lt;col style="width: 92.86666666666666666666666667px"/&gt;
&lt;col style="width: 92.86666666666666666666666667px"/&gt;
