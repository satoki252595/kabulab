&lt;col style="width:145.5pt;min-width:145.5pt;"/&gt;
&lt;col style="width:85.5pt;min-width:85.5pt;"/&gt;
&lt;col style="width:58.5pt;min-width:58.5pt;"/&gt;
&lt;col style="width:85.5pt;min-width:85.5pt;"/&gt;
