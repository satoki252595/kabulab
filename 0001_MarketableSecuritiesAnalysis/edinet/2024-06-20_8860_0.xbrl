&lt;td style="vertical-align: middle; width: 96px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;
&lt;p style="line-height: 15px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;1961年８月30日&lt;/span&gt;&lt;span style="font-size: 10px"&gt;生&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 284px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;

&lt;p style="margin-left: 60px; line-height: 14.666666666666666666666666667px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;1980年10月 堺自動車用品株式会社入社&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; line-height: 14.666666666666666666666666667px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;1985年３月 宮脇電器サービス　自営&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; line-height: 14.666666666666666666666666667px; text-align: left; text-indent: -55px"&gt;
