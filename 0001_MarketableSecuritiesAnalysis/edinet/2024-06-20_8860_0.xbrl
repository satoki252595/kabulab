  <jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E03953-000MiyawakiNobutsunaMember">宮脇　宣綱</jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E03953-000MiyawakiNobutsunaMember">1961-08-30</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock contextRef="FilingDateInstant_jpcrp030000-asr_E03953-000MiyawakiNobutsunaMember">
&lt;p style="margin-left: 60px; line-height: 14.666666666666666666666666667px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;1980年10月 堺自動車用品株式会社入社&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; line-height: 14.666666666666666666666666667px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;1985年３月 宮脇電器サービス　自営&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; line-height: 14.666666666666666666666666667px; text-align: left; text-indent: -55px"&gt;
