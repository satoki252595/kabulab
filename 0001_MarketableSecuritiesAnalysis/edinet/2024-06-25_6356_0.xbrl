&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 386.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;主要製品&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/thead&gt;
&lt;tbody&gt;
&lt;tr style="height: 37px"&gt;
&lt;td style="vertical-align: top; width: 136px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: left"&gt;歯車及び歯車装置事業&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 386.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: left"&gt;バルブ・アクチュエータ、ジャッキ、ミキサー、その他増減速機、&lt;/p&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: left"&gt;自動車用歯車、建設機械用歯車、鉄道・船舶用歯車、その他各種歯車&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 38px"&gt;
&lt;td style="vertical-align: top; width: 136px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: left"&gt;工事事業&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 386.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: left"&gt;バルブ・アクチュエータ、ジャッキ、ミキサー、&lt;/p&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: left"&gt;その他増減速機とこれらに付帯するメンテナンス等&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
