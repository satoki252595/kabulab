&lt;/td&gt;
&lt;td colspan="3" style="vertical-align:middle;border-top-color:#a9a9a9;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-color:#a9a9a9;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblR" style="orphans:0;widows:0;padding-right:9pt;font-size:9pt;"&gt;&lt;span&gt;2023年８月31日&lt;/span&gt;現在&lt;/p&gt;
&lt;/td&gt;
