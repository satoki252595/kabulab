&lt;tr style="height: 26.67px"&gt;
&lt;td style="vertical-align: top; width: 160px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 18px; text-align: center"&gt;佐々木　浩&lt;/p&gt;
