&lt;td style="vertical-align:top;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;line-height:11pt;"&gt;&lt;span style="font-size:7.5pt;"&gt;近藤丸人法律事務所入所&lt;/span&gt;&lt;/p&gt;
