  <jpcrp_cor:DateOfResolutionDividendsOfSurplus contextRef="FilingDateInstant_Row1Member">2023-02-01</jpcrp_cor:DateOfResolutionDividendsOfSurplus>
  <jpcrp_cor:ResolutionDividendsOfSurplus contextRef="FilingDateInstant_Row1Member">取締役会決議</jpcrp_cor:ResolutionDividendsOfSurplus>
  <jpcrp_cor:DateOfResolutionDividendsOfSurplus contextRef="FilingDateInstant_Row2Member">2023-09-14</jpcrp_cor:DateOfResolutionDividendsOfSurplus>
