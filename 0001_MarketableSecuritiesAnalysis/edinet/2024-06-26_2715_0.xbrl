&lt;td style="vertical-align: middle; width: 569px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 12px; line-height: 15.333333333333333333333333333px; margin-right: 3.3333333333333333333333333333px; text-align: left"&gt;ELEMATEC MEXICO S.A.DE C.V.を設立&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 14.67px"&gt;
&lt;td style="vertical-align: top; width: 79px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="line-height: 15.333333333333333333333333333px; text-align: center"&gt;2014年10月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 569px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 12px; line-height: 15.333333333333333333333333333px; margin-right: 3.3333333333333333333333333333px; text-align: left"&gt;豊田通商株式会社の子会社であった株式会社トムキの全株式を取得し、同社を当社の連結子会社化&lt;/p&gt;
&lt;/td&gt;
