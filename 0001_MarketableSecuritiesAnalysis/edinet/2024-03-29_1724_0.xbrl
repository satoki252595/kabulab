&lt;colgroup&gt;
&lt;col style="width:150pt;min-width:150pt;"/&gt;
&lt;col style="width:81pt;min-width:81pt;"/&gt;
&lt;col style="width:81pt;min-width:81pt;"/&gt;
&lt;/colgroup&gt;
