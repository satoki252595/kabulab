&lt;td style="vertical-align:top;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;margin-top:0pt;letter-spacing:0pt;line-height:12pt;font-size:7.5pt;"&gt;2024年４月&lt;/p&gt;
