&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:13.9pt;min-height:13.9pt;"&gt;
&lt;td style="vertical-align:top;border-top-color:#a9a9a9;border-bottom-color:#a9a9a9;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;margin-top:0pt;letter-spacing:0pt;line-height:12pt;font-size:7.5pt;"&gt;1979年３月&lt;/p&gt;
