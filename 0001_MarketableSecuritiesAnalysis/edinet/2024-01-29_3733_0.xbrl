  <jpcrp_cor:InformationAboutEmployeesTextBlock contextRef="FilingDateInstant">
&lt;h3 class="smt_head2" style="padding-left:9pt;"&gt;５【従業員の状況】&lt;/h3&gt;
&lt;h4 class="smt_head3" style="padding-left:18pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;text-align:justify;letter-spacing:0pt;line-height:15pt;font-size:9pt;"&gt;(１) 連結会社の状況&lt;/h4&gt;&lt;p class="smt_unitR" style="orphans:0;widows:0;text-align:right;padding-left:35pt;padding-right:18pt;line-height:10pt;"&gt;&lt;span&gt;2023年10月31日&lt;/span&gt;現在&lt;/p&gt;
&lt;div class="tbld" style="margin-left:8pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
