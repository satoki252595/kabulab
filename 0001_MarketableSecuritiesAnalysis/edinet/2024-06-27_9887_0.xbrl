  <jpcrp_cor:NotesBusinessCombinationsFinancialStatementsTextBlock contextRef="CurrentYearDuration">
&lt;h6&gt;（企業結合等関係）&lt;/h6&gt;
&lt;p style="margin-left: 20px; line-height: 13.333333333333333333333333333px; margin-right: 2px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;当事業年度（自令和５年４月１日　至令和６年３月31日）&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 32px; line-height: 13.333333333333333333333333333px; margin-right: 2px; text-align: justify; text-justify: inter-ideograph"&gt;
