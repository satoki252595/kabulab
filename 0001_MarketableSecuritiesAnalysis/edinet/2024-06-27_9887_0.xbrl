  <jpcrp_cor:TermOfOfficeInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E03164-000TajimaTeruhisaMember">(注)６</jpcrp_cor:TermOfOfficeInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:FootnotesDirectorsAndCorporateAuditorsTextBlock contextRef="FilingDateInstant_Row1Member">&lt;span style="font-size: 10px"&gt;（注）１． 取締役藤原英理は、社外取締役であります。&lt;/span&gt;</jpcrp_cor:FootnotesDirectorsAndCorporateAuditorsTextBlock>
