&lt;p style="margin-left: 6px; line-height: 14.666666666666666666666666667px; margin-right: 6px; text-align: right"&gt;
&lt;span style="font-size: 10px"&gt;48.1％&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
