&lt;td rowspan="2" style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:4.5pt;padding-right:4.5pt;margin-top:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:10pt;"&gt;&lt;span style="font-size:9pt;"&gt;連結&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:9pt;"&gt;財務諸表&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:9pt;"&gt;計上額&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:9pt;"&gt;(注)２&lt;/span&gt;&lt;/p&gt;
