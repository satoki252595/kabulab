  <jpcrp_cor:MajorShareholdersTextBlock contextRef="FilingDateInstant">
&lt;h4 class="smt_head3" style="padding-left:13.5pt;"&gt;(6) 【大株主の状況】&lt;/h4&gt;&lt;p class="smt_unitR" style="orphans:0;widows:0;text-align:right;padding-left:370.3pt;padding-right:10pt;"&gt;&lt;span&gt;2024年３月31日&lt;/span&gt;現在&lt;/p&gt;
&lt;div class="tbld" style="margin-left:0pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:482.3pt;table-layout:fixed;"&gt;
