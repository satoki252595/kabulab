&lt;tr style="height: 523.67px"&gt;
&lt;td style="vertical-align: middle; width: 84.46666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; line-height: 16.666666666666666666666666667px; margin-right: 6px; text-align: left"&gt;1992年12月&lt;/p&gt;
&lt;p style="margin-left: 6px; line-height: 16.666666666666666666666666667px; margin-right: 6px; text-align: left"&gt; &lt;/p&gt;
