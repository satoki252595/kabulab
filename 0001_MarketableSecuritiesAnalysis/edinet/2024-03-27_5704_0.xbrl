&lt;p style="margin-left: 6px; line-height: 16.666666666666666666666666667px; margin-right: 6px; text-align: left"&gt;1999年９月&lt;/p&gt;
&lt;p style="margin-left: 6px; line-height: 16.666666666666666666666666667px; margin-right: 6px; text-align: left"&gt; &lt;/p&gt;
&lt;p style="margin-left: 6px; line-height: 16.666666666666666666666666667px; margin-right: 6px; text-align: left"&gt; &lt;/p&gt;
&lt;p style="margin-left: 6px; line-height: 16.666666666666666666666666667px; margin-right: 6px; text-align: left"&gt; &lt;/p&gt;
