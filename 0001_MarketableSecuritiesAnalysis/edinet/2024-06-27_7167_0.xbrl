&lt;col style="width:27pt;min-width:27pt;"/&gt;
&lt;col style="width:35.4pt;min-width:35.4pt;"/&gt;
&lt;col style="width:27pt;min-width:27pt;"/&gt;
&lt;col style="width:35.4pt;min-width:35.4pt;"/&gt;
&lt;col style="width:39pt;min-width:39pt;"/&gt;
