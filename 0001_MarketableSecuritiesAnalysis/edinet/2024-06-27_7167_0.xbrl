  <jpcrp_cor:NotesRegardingRevenueFromAffiliatedEntitiesTextBlock contextRef="CurrentYearDuration_NonConsolidatedMember">&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:0pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:10pt;font-size:7.5pt;"&gt;※１．営業収益のうち関係会社との取引&lt;/p&gt;
&lt;div class="tbld" style="margin-left:24pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:442.7pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
&lt;col style="width:148.5pt;min-width:148.5pt;"/&gt;
&lt;col style="width:77.3pt;min-width:77.3pt;"/&gt;
