&lt;/td&gt;
&lt;td style="vertical-align:middle;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-color:#a9a9a9;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblR" style="orphans:0;widows:0;"&gt;&lt;span style="font-size:7.5pt;"&gt;[&lt;/span&gt;&lt;span style="font-size:7.5pt;"&gt;136&lt;/span&gt;&lt;span style="font-size:7.5pt;"&gt;]&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-color:#a9a9a9;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblR" style="orphans:0;widows:0;font-size:7.5pt;"&gt;&lt;span style="font-size:7.5pt;"&gt;[&lt;/span&gt;&lt;span style="font-size:7.5pt;"&gt;2,957&lt;/span&gt;&lt;span style="font-size:7.5pt;"&gt;]&lt;/span&gt;&lt;/p&gt;
