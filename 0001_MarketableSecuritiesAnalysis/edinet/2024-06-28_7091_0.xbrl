&lt;col style="width:132pt;min-width:132pt;"/&gt;
&lt;col style="width:132pt;min-width:132pt;"/&gt;
&lt;col style="width:120.8pt;min-width:120.8pt;"/&gt;
&lt;/colgroup&gt;
