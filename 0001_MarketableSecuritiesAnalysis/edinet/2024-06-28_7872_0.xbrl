&lt;/td&gt;
&lt;td style="vertical-align:middle;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:justify;padding-left:5.5pt;padding-right:3pt;line-height:11pt;font-size:7.5pt;"&gt;株式会社おしゃれ工房代表取締役&lt;span style="font-size:7.5pt;"&gt;(現任)&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
