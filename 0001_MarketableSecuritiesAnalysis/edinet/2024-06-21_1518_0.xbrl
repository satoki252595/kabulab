&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:21.9pt;min-height:21.9pt;"&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:1.4pt;padding-right:1.4pt;font-size:7.5pt;"&gt;日本ストロー㈱&lt;/p&gt;
&lt;/td&gt;
