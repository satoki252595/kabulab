&lt;td style="vertical-align: middle; width: 152px; padding-top: 4.8px; padding-bottom: 4.8px; padding-left: 9.6px; padding-right: 9.6px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #EDEDED"&gt;
&lt;p style="line-height: 1; text-align: justify; text-justify: inter-ideograph"&gt;
&lt;span style="font-size: 10px; font-weight: bold"&gt;分析対象先&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 464px; padding-top: 4.8px; padding-bottom: 4.8px; padding-left: 9.6px; padding-right: 9.6px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 1; text-align: justify; text-justify: inter-ideograph"&gt;
&lt;span style="font-size: 10px"&gt;全取引先&lt;/span&gt;
