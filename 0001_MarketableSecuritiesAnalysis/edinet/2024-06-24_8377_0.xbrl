&lt;td style="vertical-align: middle; width: 176px; padding-top: 4.8px; padding-bottom: 4.8px; padding-left: 9.6px; padding-right: 9.6px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000; background-color: #F2F2F2"&gt;
