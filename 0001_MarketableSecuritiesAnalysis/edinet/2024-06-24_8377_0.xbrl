&lt;span style="font-weight: bold"&gt;注3&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 224px; padding-top: 4.8px; padding-bottom: 4.8px; padding-left: 9.6px; padding-right: 9.6px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 1; text-align: justify; text-justify: inter-ideograph"&gt;2021～累計　7,000億円&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 168px; padding-top: 4.8px; padding-bottom: 4.8px; padding-left: 9.6px; padding-right: 9.6px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 1; text-align: center"&gt;2030年&lt;/p&gt;
