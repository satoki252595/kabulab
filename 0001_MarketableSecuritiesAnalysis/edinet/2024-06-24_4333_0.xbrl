&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;padding-left:5.4pt;padding-right:5.4pt;margin-top:1.5pt;margin-bottom:1.5pt;letter-spacing:0pt;line-height:13pt;"&gt;決議年月日&lt;/p&gt;
