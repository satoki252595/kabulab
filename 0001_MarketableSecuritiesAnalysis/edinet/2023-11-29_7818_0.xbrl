&lt;/td&gt;
&lt;td style="vertical-align: top; width: 188.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 5px; line-height: 14px; margin-right: 2.3333333333333333333333333333px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;シグマ光機&lt;/span&gt;&lt;span style="font-family: &amp;apos;Times New Roman&amp;apos;; font-size: 10px"&gt;㈱&lt;/span&gt;&lt;span style="font-size: 10px"&gt;社外取締役（現）&lt;/span&gt;
&lt;/p&gt;
