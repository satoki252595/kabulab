&lt;col style="width:12pt;min-width:12pt;"/&gt;
&lt;col style="width:114pt;min-width:114pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:19.5pt;min-height:19.5pt;"&gt;
&lt;td style="vertical-align:middle;border-top-color:#a9a9a9;border-bottom-color:#a9a9a9;border-left-color:#a9a9a9;border-right-color:#a9a9a9;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:justify;padding-left:0pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:10pt;"&gt;調整後付与株式数&lt;/p&gt;
&lt;/td&gt;
