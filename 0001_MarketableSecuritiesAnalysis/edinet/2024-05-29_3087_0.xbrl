  <jpcrp_cor:NotesRegardingDividendTextBlock contextRef="Prior1YearDuration">
&lt;p style="margin-bottom: 6px; text-align: left"&gt; ２．配当に関する事項&lt;/p&gt;
&lt;p style="margin-bottom: 6px; text-align: left"&gt;（１）配当金支払額&lt;/p&gt;
&lt;div style="margin-left: 6px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 642px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 119px"/&gt;
&lt;col style="width: 84px"/&gt;
