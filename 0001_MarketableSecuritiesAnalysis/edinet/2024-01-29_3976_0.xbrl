&lt;td colspan="3" style="vertical-align: top; width: 304px; padding-top: 6.6666666666666666666666666667px; padding-bottom: 6.6666666666666666666666666667px; padding-left: 6.6666666666666666666666666667px; padding-right: 6.6666666666666666666666666667px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt;労働者の男女の賃金の差異&lt;span style="font-family: &amp;apos;Arial&amp;apos;"&gt;(&lt;/span&gt;％&lt;span style="font-family: &amp;apos;Arial&amp;apos;"&gt;)(&lt;/span&gt;注&lt;span style="font-family: &amp;apos;Arial&amp;apos;"&gt;)&lt;/span&gt;１&lt;/p&gt;
&lt;/td&gt;
&lt;td rowspan="2" style="vertical-align: top; width: 90.26666666666666666666666667px; padding-top: 1px; padding-bottom: 1px; padding-left: 1px; padding-right: 1px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt;エンゲージメントスコア&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 10.6px"&gt;
&lt;td style="vertical-align: top; width: 88px; padding-top: 6.6666666666666666666666666667px; padding-bottom: 6.6666666666666666666666666667px; padding-left: 6.6666666666666666666666666667px; padding-right: 6.6666666666666666666666666667px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt;全労働者&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 96px; padding-top: 6.6666666666666666666666666667px; padding-bottom: 6.6666666666666666666666666667px; padding-left: 6.6666666666666666666666666667px; padding-right: 6.6666666666666666666666666667px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
