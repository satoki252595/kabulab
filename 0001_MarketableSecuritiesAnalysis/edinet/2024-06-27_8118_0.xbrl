  <jpcrp_cor:NotesRegardingDividendTextBlock contextRef="Prior1YearDuration">
&lt;p style="margin-left: 36px; text-align: left; text-indent: -12px"&gt;４　配当に関する事項&lt;/p&gt;
&lt;p style="margin-left: 72px; text-align: left; text-indent: -12px"&gt;(1）配当金支払額&lt;/p&gt;
&lt;div style="margin-left: 48px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 600px"&gt;
&lt;colgroup&gt;
