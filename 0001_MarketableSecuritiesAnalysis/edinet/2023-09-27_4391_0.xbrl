&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:225.5pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
&lt;col style="width:225.5pt;min-width:225.5pt;"/&gt;
&lt;/colgroup&gt;
