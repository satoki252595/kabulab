&lt;td style="vertical-align: middle; width: 171.26666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt;期首残高&lt;/p&gt;
&lt;/td&gt;
