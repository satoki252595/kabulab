&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 544.2px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 2px solid #000000; background-color: #C0C6C9"&gt;
