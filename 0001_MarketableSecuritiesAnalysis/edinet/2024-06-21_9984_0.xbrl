&lt;td style="vertical-align: top; width: 18px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: left"&gt;
&lt;span style="font-size: 12px"&gt; &lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 155.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 12px; margin-right: 4px; text-align: left; text-indent: -6px"&gt;ソフトバンク・ビジョン・ファンド事業&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 234.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 18px; margin-right: 4px; text-align: left; text-indent: -12px"&gt;・SVF１、SVF２およびLatAmファンドによる投資事業&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 240px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 12px; margin-right: 4px; text-align: left; text-indent: -6px"&gt;SB Investment Advisers (UK) Limited&lt;/p&gt;
&lt;p style="margin-left: 6px; margin-right: 4px; text-align: left"&gt;SoftBank Vision Fund L.P.&lt;/p&gt;
