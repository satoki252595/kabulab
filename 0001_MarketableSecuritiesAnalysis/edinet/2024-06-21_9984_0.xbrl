&lt;p style="line-height: 15px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt; &lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 70px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 3px double #000000; border-right: 0px none ; border-bottom: 3px double #000000"&gt;
&lt;p style="line-height: 15px; margin-right: 5px; text-align: right"&gt;
&lt;span style="font-size: 10px"&gt;2,448,840&lt;/span&gt;
&lt;/p&gt;
