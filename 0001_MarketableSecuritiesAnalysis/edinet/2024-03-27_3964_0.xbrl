  <jpcrp_cor:AnnexedConsolidatedDetailedScheduleOfCorporateBondsTextBlock contextRef="CurrentYearDuration">
&lt;h6 class="smt_head5" style="padding-left:9pt;"&gt;【社債明細表】&lt;/h6&gt;&lt;p class="smt_text5" style="orphans:0;widows:0;padding-left:9pt;"&gt;該当事項はありません。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;"&gt; &lt;/p&gt;</jpcrp_cor:AnnexedConsolidatedDetailedScheduleOfCorporateBondsTextBlock>
  <jpcrp_cor:AnnexedConsolidatedDetailedScheduleOfBorrowingsTextBlock contextRef="CurrentYearDuration">
&lt;h6 class="smt_head5" style="padding-left:9pt;"&gt;【借入金等明細表】&lt;/h6&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:9pt;text-indent:9pt;"&gt;リース債務は金額が僅少であり、重要性が乏しいため記載を省略しております。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:9pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:9pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;font-size:15pt;"&gt; &lt;/p&gt;</jpcrp_cor:AnnexedConsolidatedDetailedScheduleOfBorrowingsTextBlock>
  <jpcrp_cor:AnnexedConsolidatedDetailedScheduleOfAssetRetirementObligationsTextBlock contextRef="CurrentYearDuration">
&lt;h6 class="smt_head5" style="padding-left:9pt;"&gt;【資産除去債務明細表】&lt;/h6&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:9pt;text-indent:9pt;"&gt;資産除去債務は金額が僅少であり、重要性が乏しいため記載を省略しております。&lt;/p&gt;&lt;p class="smt_text1" style="orphans:0;widows:0;text-align:justify;padding-left:0pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:9pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;font-size:15pt;"&gt; &lt;/p&gt;</jpcrp_cor:AnnexedConsolidatedDetailedScheduleOfAssetRetirementObligationsTextBlock>
