&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:23.9pt;min-height:23.9pt;"&gt;
&lt;td style="vertical-align:middle;border-top-style:dotted;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;"&gt;&lt;span style="font-family:&amp;apos;ＭＳ 明朝&amp;apos;;font-size:9pt;"&gt;様々なたんぱく質の可能性の探索&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
