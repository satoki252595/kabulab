&lt;col style="width:77.1pt;min-width:77.1pt;"/&gt;
&lt;col style="width:77.1pt;min-width:77.1pt;"/&gt;
&lt;col style="width:77.1pt;min-width:77.1pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:22.5pt;min-height:22.5pt;"&gt;
