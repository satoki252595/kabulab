  <jpcrp_cor:NameOfShareholderTreasurySharesEtc contextRef="CurrentYearInstant_Row1Member">マルハニチロ株式会社</jpcrp_cor:NameOfShareholderTreasurySharesEtc>
  <jpcrp_cor:AddressOfShareholderTreasurySharesEtc contextRef="CurrentYearInstant_Row1Member">東京都江東区豊洲三丁目２番20号</jpcrp_cor:AddressOfShareholderTreasurySharesEtc>
