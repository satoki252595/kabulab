&lt;p style="margin-left: 6px; line-height: 16px; margin-right: 6px; text-align: left"&gt;徳島県徳島市&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 73.133333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; line-height: 16px; margin-right: 6px; text-align: right"&gt;90&lt;/p&gt;
