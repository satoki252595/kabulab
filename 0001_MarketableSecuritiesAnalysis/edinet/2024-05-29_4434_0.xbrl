  <jpcrp_cor:InformationAboutEmployeesTextBlock contextRef="FilingDateInstant">&lt;p style="page-break-before:always; line-height:0.75pt; width:100%; font-size:0.75pt;"&gt; &lt;/p&gt;
&lt;h3 class="smt_head2"&gt;５ 【従業員の状況】&lt;/h3&gt;
&lt;h4 class="smt_head3"&gt;(1) 連結会社の状況&lt;/h4&gt;&lt;p class="smt_unitR" style="orphans:0;widows:0;text-align:justify;padding-left:377.3pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:10pt;font-size:9pt;"&gt;&lt;span&gt;2024年２月29日&lt;/span&gt;現在&lt;/p&gt;
&lt;div class="tbld" style="margin-left:0pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
