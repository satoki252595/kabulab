&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:4pt;padding-right:0pt;font-size:7.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;監査証明業務に&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:9pt;"&gt;基づく報酬（千円）&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:9pt;padding-right:1pt;font-size:7.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;非監査業務に&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:9pt;"&gt;基づく報酬（千円）&lt;/span&gt;&lt;/p&gt;
