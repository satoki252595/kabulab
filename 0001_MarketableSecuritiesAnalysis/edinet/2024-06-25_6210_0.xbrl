&lt;td style="vertical-align: middle; width: 78.666666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: right"&gt;(138.8)&lt;/p&gt;
&lt;/td&gt;
