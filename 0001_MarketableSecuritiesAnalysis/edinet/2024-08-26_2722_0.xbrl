&lt;td style="vertical-align: middle; width: 133.73333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 36px; text-align: right"&gt;26.3&lt;/p&gt;
&lt;/td&gt;
