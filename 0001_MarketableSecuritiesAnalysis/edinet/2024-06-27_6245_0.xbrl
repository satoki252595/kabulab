  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E01548-000OkadaKaoruMember">1958-09-20</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock contextRef="FilingDateInstant_jpcrp030000-asr_E01548-000OkadaKaoruMember">
&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 274.66666666666666666666666666px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 65.333333333333333333333333333px"/&gt;
&lt;col style="width: 209.33333333333333333333333333px"/&gt;
