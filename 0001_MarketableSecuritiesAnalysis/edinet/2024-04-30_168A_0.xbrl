&lt;p style="margin-left: 36px; text-align: left"&gt; &lt;/p&gt;

</jpcrp030000-asr_E39273-000:MetricsAndTargetsTextBlock>
  <jpcrp030000-asr_E39273-000:DescriptionOfMetricsRelatedToPolicyOnHumanResourceDevelopmentAndImprovementOfInternalEnvironmentAndTargetsAndResultsUsingSuchMetricsMetricsAndTargetsTextBlock contextRef="FilingDateInstant">
