&lt;/table&gt;
&lt;/div&gt;
&lt;p style="margin-left: 48px; line-height: 1.3333333333333333333333333333px; text-align: right"&gt; &lt;/p&gt;
&lt;div style="margin-left: 48px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 600px"&gt;
&lt;colgroup&gt;
