&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 255.33333333333333333333333333px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 65.733333333333333333333333333px"/&gt;
&lt;col style="width: 189.6px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr style="height: 15px"&gt;
&lt;td style="vertical-align: top; width: 65.733333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 14px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;2001年４月&lt;/span&gt;
