  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E25263-000NakanoShinjiMember">1961-11-27</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
