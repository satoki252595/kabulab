&lt;/p&gt;
&lt;p style="margin-left: 5px; line-height: 11.333333333333333333333333333px; margin-right: 5px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;及び運搬具&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 53px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 11.333333333333333333333333333px; text-align: center"&gt;
