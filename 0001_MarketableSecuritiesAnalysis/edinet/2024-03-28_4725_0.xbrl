&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblR" style="orphans:0;widows:0;padding-right:3.8pt;font-size:7.5pt;"&gt;100.0&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:3.8pt;padding-right:3.8pt;font-size:7.5pt;"&gt;当社から間接業務を受託&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:3.8pt;padding-right:3.8pt;font-size:7.5pt;"&gt;当社に間接業務を委託&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:3.8pt;padding-right:3.8pt;font-size:7.5pt;"&gt;当社から事務所の賃貸&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:justify;padding-left:3.8pt;padding-right:3.8pt;margin-top:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:10pt;font-size:7.5pt;"&gt;当社から資金貸付&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:3.8pt;padding-right:3.8pt;font-size:7.5pt;"&gt;役員の兼任及び派遣&lt;/p&gt;
&lt;/td&gt;
