&lt;td style="vertical-align:top;border-top-color:#a9a9a9;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-color:#a9a9a9;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:5.7pt;padding-right:5.7pt;line-height:11pt;font-size:7.5pt;"&gt;&lt;span style="font-size:7.5pt;"&gt;CAC AMERICA CORPORATION Director &amp;amp; President &amp;amp; TREASURER&lt;/span&gt;&lt;/p&gt;
