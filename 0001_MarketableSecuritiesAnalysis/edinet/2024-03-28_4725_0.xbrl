&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblR" style="orphans:0;widows:0;padding-right:3.8pt;font-size:7.5pt;"&gt;百万円&lt;/p&gt;&lt;p class="smt_tblR" style="orphans:0;widows:0;padding-right:3.8pt;font-size:7.5pt;"&gt;400&lt;/p&gt;
&lt;/td&gt;
