&lt;col style="width:133.5pt;min-width:133.5pt;"/&gt;
&lt;col style="width:133.5pt;min-width:133.5pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:13.5pt;min-height:13.5pt;"&gt;
