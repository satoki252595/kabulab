&lt;col style="width:93.8pt;min-width:93.8pt;"/&gt;
&lt;col style="width:93.8pt;min-width:93.8pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:15.8pt;min-height:15.8pt;"&gt;
