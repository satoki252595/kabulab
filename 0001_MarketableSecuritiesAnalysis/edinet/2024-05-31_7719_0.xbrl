&lt;col style="width:39.7pt;min-width:39.7pt;"/&gt;
&lt;col style="width:37.9pt;min-width:37.9pt;"/&gt;
&lt;col style="width:44.5pt;min-width:44.5pt;"/&gt;
&lt;col style="width:42.2pt;min-width:42.2pt;"/&gt;
&lt;col style="width:47.3pt;min-width:47.3pt;"/&gt;
&lt;col style="width:56.3pt;min-width:56.3pt;"/&gt;
&lt;col style="width:41.2pt;min-width:41.2pt;"/&gt;
&lt;col style="width:40pt;min-width:40pt;"/&gt;
