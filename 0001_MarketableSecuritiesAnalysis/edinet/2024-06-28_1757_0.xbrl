&lt;td style="vertical-align: middle; width: 75.6px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6.7333333333333333333333333333px; line-height: 1; margin-right: 2.2px; text-align: center; text-indent: -4.6666666666666666666666666667px"&gt;１株当たり&lt;/p&gt;
&lt;p style="margin-left: 6.7333333333333333333333333333px; line-height: 1; margin-right: 2.2px; text-align: center; text-indent: -4.6666666666666666666666666667px"&gt;の払込金額&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 15.13px"&gt;
&lt;td colspan="3" style="vertical-align: middle; width: 170.4px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 2.0666666666666666666666666667px; line-height: 1; margin-right: 2.2px; text-align: center"&gt;１株当たりの時価&lt;/p&gt;
&lt;/td&gt;
