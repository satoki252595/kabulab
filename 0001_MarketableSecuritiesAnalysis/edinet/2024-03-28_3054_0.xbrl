  <jpcrp_cor:ChangesInNumberOfIssuedSharesStatedCapitalEtcTextBlock contextRef="FilingDateInstant">
&lt;h4&gt;（４）【発行済株式総数、資本金等の推移】&lt;/h4&gt;
&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 651.2px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 144.8px"/&gt;
&lt;col style="width: 84.4px"/&gt;
&lt;col style="width: 84.4px"/&gt;
&lt;col style="width: 84.4px"/&gt;
&lt;col style="width: 84.4px"/&gt;
&lt;col style="width: 84.4px"/&gt;
&lt;col style="width: 84.4px"/&gt;
&lt;/colgroup&gt;
&lt;thead&gt;
