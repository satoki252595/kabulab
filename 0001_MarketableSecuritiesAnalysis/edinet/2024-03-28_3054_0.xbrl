&lt;/tr&gt;
&lt;tr style="height: 22.87px"&gt;
&lt;td style="vertical-align: top; width: 82px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="line-height: 16px; text-align: center"&gt;2018年１月&lt;/p&gt;
&lt;p style="line-height: 16px; text-align: center"&gt; &lt;/p&gt;
