&lt;p style="margin-left: 0px; line-height: 1.3333333333333333333333333333px; margin-right: 0px; text-align: left"&gt; &lt;/p&gt;
&lt;div style="margin-left: 72px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 576px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 324px"/&gt;
