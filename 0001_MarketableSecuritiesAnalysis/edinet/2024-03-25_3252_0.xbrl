&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr style="height: 22.73px"&gt;
&lt;td colspan="2" style="vertical-align: top; width: 186.86666666666666666666666667px; padding-top: 1px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #EFEFEF"&gt;
&lt;p style="text-align: center"&gt;分類&lt;/p&gt;
