&lt;col style="width:60.9pt;min-width:60.9pt;"/&gt;
&lt;col style="width:60.9pt;min-width:60.9pt;"/&gt;
&lt;col style="width:60.9pt;min-width:60.9pt;"/&gt;
&lt;col style="width:60.9pt;min-width:60.9pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr&gt;
