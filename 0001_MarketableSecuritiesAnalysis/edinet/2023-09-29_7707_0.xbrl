&lt;col style="width:136.5pt;min-width:136.5pt;"/&gt;
&lt;col style="width:105.8pt;min-width:105.8pt;"/&gt;
&lt;col style="width:84pt;min-width:84pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:13.5pt;min-height:13.5pt;"&gt;
