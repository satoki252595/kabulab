&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 15.666666666666666666666666667px; padding-top: 1px; padding-bottom: 0px; padding-left: 1px; padding-right: 1px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
