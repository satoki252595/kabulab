&lt;/tr&gt;
&lt;tr style="height:10.5pt;min-height:10.5pt;"&gt;
&lt;td style="vertical-align:top;border-top-color:#a9a9a9;border-right-color:#a9a9a9;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;text-align:justify;padding-left:2.5pt;font-size:7.5pt;"&gt;2022年12月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:top;border-top-color:#a9a9a9;border-left-color:#a9a9a9;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:justify;padding-left:0.9pt;padding-right:2.9pt;margin-top:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:10pt;font-size:7.5pt;"&gt;竹内毅公認会計士事務所　代表 (現任)&lt;/p&gt;
