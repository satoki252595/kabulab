&lt;/tr&gt;
&lt;tr style="height:15.6pt;min-height:15.6pt;"&gt;
&lt;td style="vertical-align:middle;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;"&gt;2006年12月&lt;/p&gt;
