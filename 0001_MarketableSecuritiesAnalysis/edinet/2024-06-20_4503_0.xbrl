  <jpcrp_cor:DetailsOfEmployeeShareOptionProgramTextBlock contextRef="FilingDateInstant">
&lt;h4 class="smt_head4" style="padding-left:18pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;text-align:justify;letter-spacing:0pt;line-height:15pt;font-size:9pt;"&gt;① 【ストックオプション制度の内容】&lt;/h4&gt;&lt;p class="smt_text3" style="orphans:0;widows:0;padding-left:18pt;"&gt;会社法に基づき発行した新株予約権&lt;/p&gt;&lt;p class="smt_text3" style="orphans:0;widows:0;"&gt;(a) &lt;span&gt;2009年７月発行&lt;/span&gt;新株予約権 (2009年７月８日発行)&lt;/p&gt;&lt;p class="smt_unitR" style="orphans:0;widows:0;"&gt; &lt;/p&gt;
&lt;div class="tbld" style="margin-left:0pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:484pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
