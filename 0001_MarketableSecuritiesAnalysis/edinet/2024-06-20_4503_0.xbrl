  <jpcrp030000-asr_E00920-000:ReferenceToOtherInformation3StrategyIndicatorAndTargetRelatingToSustainability contextRef="FilingDateInstant">ウェブサイト</jpcrp030000-asr_E00920-000:ReferenceToOtherInformation3StrategyIndicatorAndTargetRelatingToSustainability>
  <jpcrp030000-asr_E00920-000:ReferenceToOtherInformation4StrategyIndicatorAndTargetRelatingToSustainability contextRef="FilingDateInstant">ウェブサイト</jpcrp030000-asr_E00920-000:ReferenceToOtherInformation4StrategyIndicatorAndTargetRelatingToSustainability>
  <jpcrp_cor:MetricsDescriptionOfMetricsRelatedToPolicyOnDevelopmentOfHumanResourcesAndInternalEnvironmentAndTargetsAndPerformanceUsingSuchMetrics contextRef="CurrentYearInstant_Row1Member">社長からの６階層以下の組織の割合</jpcrp_cor:MetricsDescriptionOfMetricsRelatedToPolicyOnDevelopmentOfHumanResourcesAndInternalEnvironmentAndTargetsAndPerformanceUsingSuchMetrics>
  <jpcrp_cor:MetricsUnitDescriptionOfMetricsRelatedToPolicyOnDevelopmentOfHumanResourcesAndInternalEnvironmentAndTargetsAndPerformanceUsingSuchMetrics contextRef="CurrentYearInstant_Row1Member">％</jpcrp_cor:MetricsUnitDescriptionOfMetricsRelatedToPolicyOnDevelopmentOfHumanResourcesAndInternalEnvironmentAndTargetsAndPerformanceUsingSuchMetrics>
