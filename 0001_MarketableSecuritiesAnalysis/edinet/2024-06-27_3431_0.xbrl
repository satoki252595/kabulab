&lt;tr style="height: 22px"&gt;
&lt;td colspan="2" style="vertical-align: top; width: 644px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 5.5333333333333333333333333333px; line-height: 21px; text-align: left"&gt;（旧株式会社宮地鐵工所）&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 43px"&gt;
&lt;td style="vertical-align: top; width: 100px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 5.5333333333333333333333333333px; line-height: 21px; text-align: left"&gt;1908年９月&lt;/p&gt;
&lt;/td&gt;
