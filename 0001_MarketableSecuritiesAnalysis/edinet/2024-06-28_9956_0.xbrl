  <jpcrp_cor:ConsolidatedSubsidiariesMetricsOfConsolidatedSubsidiaries contextRef="CurrentYearInstant_Row16Member">㈱ダイユーエイト</jpcrp_cor:ConsolidatedSubsidiariesMetricsOfConsolidatedSubsidiaries>
  <jpcrp_cor:ConsolidatedSubsidiariesMetricsOfConsolidatedSubsidiaries contextRef="CurrentYearInstant_Row17Member">㈱タイム</jpcrp_cor:ConsolidatedSubsidiariesMetricsOfConsolidatedSubsidiaries>
  <jpcrp_cor:ConsolidatedSubsidiariesMetricsOfConsolidatedSubsidiaries contextRef="CurrentYearInstant_Row18Member">㈱日敷</jpcrp_cor:ConsolidatedSubsidiariesMetricsOfConsolidatedSubsidiaries>
  <jpcrp_cor:ConsolidatedSubsidiariesMetricsOfConsolidatedSubsidiaries contextRef="CurrentYearInstant_Row19Member">㈱ホームセンター・アント</jpcrp_cor:ConsolidatedSubsidiariesMetricsOfConsolidatedSubsidiaries>
  <jpcrp_cor:ConsolidatedSubsidiariesMetricsOfConsolidatedSubsidiaries contextRef="CurrentYearInstant_Row20Member">㈱アクトス</jpcrp_cor:ConsolidatedSubsidiariesMetricsOfConsolidatedSubsidiaries>
  <jpcrp_cor:ConsolidatedSubsidiariesMetricsOfConsolidatedSubsidiaries contextRef="CurrentYearInstant_Row21Member">中部興産㈱</jpcrp_cor:ConsolidatedSubsidiariesMetricsOfConsolidatedSubsidiaries>
  <jpcrp_cor:ConsolidatedSubsidiariesMetricsOfConsolidatedSubsidiaries contextRef="CurrentYearInstant_Row22Member">㈱セイソー</jpcrp_cor:ConsolidatedSubsidiariesMetricsOfConsolidatedSubsidiaries>
