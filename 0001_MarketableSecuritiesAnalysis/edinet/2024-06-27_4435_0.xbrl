&lt;tr style="height: 27px"&gt;
&lt;td style="vertical-align: middle; width: 129.86666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="text-align: left"&gt;（連結子会社）&lt;/p&gt;
&lt;/td&gt;
