&lt;/td&gt;
&lt;td style="vertical-align:top;border-top-color:#a9a9a9;border-bottom-color:#a9a9a9;border-left-style:solid;border-left-width:0.75pt;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:3.1pt;padding-right:3.1pt;line-height:11pt;font-size:7.5pt;"&gt;株式会社三井住友フィナンシャルグループ常務執行役員&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:11pt;min-height:11pt;"&gt;
