&lt;td style="vertical-align: top; width: 166.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-right: 5.3333333333333333333333333333px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;当社入社&lt;/span&gt;
&lt;/p&gt;
