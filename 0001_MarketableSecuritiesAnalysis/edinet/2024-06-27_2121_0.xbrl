&gt; &lt;/p&gt;</jpcrp_cor:AnnexedDetailedScheduleOfPropertyPlantAndEquipmentEtcTextBlock>
  <jpcrp_cor:AnnexedDetailedScheduleOfProvisionsTextBlock contextRef="CurrentYearDuration">
