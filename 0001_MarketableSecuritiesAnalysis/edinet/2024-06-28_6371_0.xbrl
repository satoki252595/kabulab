&lt;div class="tbld" style="text-align:center;margin-left:0pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" class="align_center" style="border-collapse:collapse;border:solid 0pt #000000;width:351.2pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
&lt;col style="width:59.3pt;min-width:59.3pt;"/&gt;
