&lt;/div&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:left;padding-left:27pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;font-size:15pt;"&gt; &lt;/p&gt;</jpcrp_cor:NotesSignificantEventsAfterReportingPeriodFinancialStatementsTextBlock>
  <jpcrp_cor:AnnexedDetailedScheduleOfPropertyPlantAndEquipmentEtcTextBlock contextRef="CurrentYearDuration">
&lt;h6 class="smt_head5" style="padding-left:36pt;"&gt;【有形固定資産等明細表】&lt;/h6&gt;
&lt;div class="tbld" style="margin-left:0pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:480.4pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
&lt;col style="width:48.8pt;min-width:48.8pt;"/&gt;
