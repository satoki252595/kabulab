&lt;/div&gt;
&lt;p style="line-height: 1.3333333333333333333333333333px; text-align: right"&gt; &lt;/p&gt;
&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 505.2px"&gt;
&lt;colgroup&gt;
