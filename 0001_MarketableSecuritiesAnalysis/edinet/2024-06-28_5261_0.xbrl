&lt;td style="vertical-align: top; width: 187px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 17.333333333333333333333333333px; margin-right: 2.6666666666666666666666666667px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;ミサワホーム株式会社入社&lt;/span&gt;
