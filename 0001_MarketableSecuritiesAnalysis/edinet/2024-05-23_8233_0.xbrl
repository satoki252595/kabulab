&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr style="height: 12px"&gt;
&lt;td rowspan="2" style="vertical-align: middle; width: 160px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 1px; text-align: center; text-indent: 1px"&gt;
&lt;span style="font-size: 14px"&gt;指標&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 112px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 1px; text-align: center"&gt;
&lt;span style="font-size: 14px"&gt;実績&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td colspan="3" style="vertical-align: top; width: 344px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 1px; text-align: center"&gt;
&lt;span style="font-size: 14px"&gt;目標&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 12.8px"&gt;
&lt;td style="vertical-align: top; width: 112px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 1px; text-align: center"&gt;
&lt;span style="font-size: 14px"&gt;2023年度&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
