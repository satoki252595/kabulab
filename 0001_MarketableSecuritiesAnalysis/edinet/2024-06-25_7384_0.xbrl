&lt;col style="width:70.5pt;min-width:70.5pt;"/&gt;
&lt;col style="width:69pt;min-width:69pt;"/&gt;
&lt;col style="width:69pt;min-width:69pt;"/&gt;
&lt;col style="width:74.3pt;min-width:74.3pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:0pt;min-height:0pt;"&gt;
