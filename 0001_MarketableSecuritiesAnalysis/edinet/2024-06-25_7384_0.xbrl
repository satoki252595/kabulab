&lt;col style="width:59.3pt;min-width:59.3pt;"/&gt;
&lt;col style="width:59.3pt;min-width:59.3pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:42.8pt;min-height:42.8pt;"&gt;
