&lt;col style="width:51.8pt;min-width:51.8pt;"/&gt;
&lt;col style="width:46.5pt;min-width:46.5pt;"/&gt;
&lt;col style="width:198.8pt;min-width:198.8pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:22.5pt;min-height:22.5pt;"&gt;
