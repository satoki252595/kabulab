  <jpcrp_cor:NotesRegardingNewShareSubscriptionRightsEtcTextBlock contextRef="Prior1YearDuration">&lt;p class="smt_head6" style="orphans:0;widows:0;padding-left:9pt;"&gt;３　新株予約権等に関する事項    &lt;/p&gt;&lt;p class="smt_annoNum1" style="orphans:0;widows:0;"&gt;　　　該当事項はありません。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;line-height:12pt;font-size:12pt;"&gt; &lt;/p&gt;</jpcrp_cor:NotesRegardingNewShareSubscriptionRightsEtcTextBlock>
  <jpcrp_cor:NotesRegardingDividendTextBlock contextRef="Prior1YearDuration">&lt;p class="smt_head6" style="orphans:0;widows:0;padding-left:9pt;"&gt;４　配当に関する事項&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-indent:18pt;"&gt;(1) 配当金支払額&lt;/p&gt;
