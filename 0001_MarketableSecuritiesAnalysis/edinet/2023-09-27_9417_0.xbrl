&lt;h5 class="smt_head4"&gt;②  単価情報&lt;/h5&gt;&lt;p class="smt_unitR" style="orphans:0;widows:0;padding-left:0pt;"&gt; &lt;/p&gt;
&lt;div class="tbld" style="margin-left:0pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:320pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
