&lt;col style="width:46.5pt;min-width:46.5pt;"/&gt;
&lt;col style="width:60.8pt;min-width:60.8pt;"/&gt;
&lt;col style="width:51pt;min-width:51pt;"/&gt;
&lt;col style="width:58pt;min-width:58pt;"/&gt;
&lt;col style="width:37pt;min-width:37pt;"/&gt;
