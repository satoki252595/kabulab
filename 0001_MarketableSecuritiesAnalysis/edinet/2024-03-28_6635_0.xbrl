&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;決議年月日&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 201px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;
