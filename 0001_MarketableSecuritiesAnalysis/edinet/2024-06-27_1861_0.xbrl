</jpcrp_cor:TreasurySharesEtcTextBlock>
  <jpcrp_cor:NameOfShareholderTreasurySharesEtc contextRef="CurrentYearInstant_Row1Member">株式会社熊谷組</jpcrp_cor:NameOfShareholderTreasurySharesEtc>
  <jpcrp_cor:AddressOfShareholderTreasurySharesEtc contextRef="CurrentYearInstant_Row1Member">福井県福井市中央２丁目６番８号</jpcrp_cor:AddressOfShareholderTreasurySharesEtc>
  <jpcrp_cor:NameOfShareholderTreasurySharesEtc contextRef="CurrentYearInstant_Row2Member">株式会社前田工務店</jpcrp_cor:NameOfShareholderTreasurySharesEtc>
  <jpcrp_cor:AddressOfShareholderTreasurySharesEtc contextRef="CurrentYearInstant_Row2Member">東京都江東区東砂５丁目５番10号</jpcrp_cor:AddressOfShareholderTreasurySharesEtc>
