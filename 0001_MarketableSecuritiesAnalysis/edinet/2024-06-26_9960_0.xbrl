&lt;/colgroup&gt;
&lt;tr style="height:15.2pt;min-height:15.2pt;"&gt;
&lt;td style="vertical-align:top;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:21pt;padding-right:5.4pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:10.5pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;line-height:14pt;font-size:10.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;変更前&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:top;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:21pt;padding-right:5.4pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:10.5pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;line-height:14pt;font-size:10.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;変更後&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
