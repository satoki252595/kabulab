&lt;td style="vertical-align:top;border-top-color:#a9a9a9;border-bottom-color:#a9a9a9;border-left-style:solid;border-left-width:0.75pt;border-right-color:#a9a9a9;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:5.4pt;padding-right:4.4pt;line-height:11pt;font-size:6pt;"&gt;&lt;span style="font-size:7.5pt;"&gt;有限会社中山食茸入社&lt;/span&gt;&lt;/p&gt;
