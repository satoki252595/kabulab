&lt;col style="width:97pt;min-width:97pt;"/&gt;
&lt;col style="width:53pt;min-width:53pt;"/&gt;
&lt;col style="width:60pt;min-width:60pt;"/&gt;
&lt;col style="width:60pt;min-width:60pt;"/&gt;
&lt;col style="width:60pt;min-width:60pt;"/&gt;
