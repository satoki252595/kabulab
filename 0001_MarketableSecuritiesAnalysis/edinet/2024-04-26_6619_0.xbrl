&lt;col style="width:56.7pt;min-width:56.7pt;"/&gt;
&lt;col style="width:60.8pt;min-width:60.8pt;"/&gt;
&lt;col style="width:61.4pt;min-width:61.4pt;"/&gt;
&lt;col style="width:61.5pt;min-width:61.5pt;"/&gt;
&lt;col style="width:61.4pt;min-width:61.4pt;"/&gt;
&lt;col style="width:57.8pt;min-width:57.8pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:34pt;min-height:34pt;"&gt;
