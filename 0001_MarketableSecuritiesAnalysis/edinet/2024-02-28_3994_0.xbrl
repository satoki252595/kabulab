&lt;span style="font-size: 12px"&gt; &lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 33.8px; padding-top: 6.6666666666666666666666666667px; padding-bottom: 6.6666666666666666666666666667px; padding-left: 6.6666666666666666666666666667px; padding-right: 6.6666666666666666666666666667px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
