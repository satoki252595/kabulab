&lt;td style="vertical-align: bottom; width: 191.93333333333333333333333333px; padding-top: 2px; padding-bottom: 2px; padding-left: 3px; padding-right: 3px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
