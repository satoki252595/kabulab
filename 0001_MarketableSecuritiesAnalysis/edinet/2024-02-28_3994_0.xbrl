&lt;p style="text-align: left"&gt;のれん&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: bottom; width: 120px; padding-top: 2px; padding-bottom: 2px; padding-left: 3px; padding-right: 3px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: right"&gt;4,504,481&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: bottom; width: 120px; padding-top: 2px; padding-bottom: 2px; padding-left: 3px; padding-right: 3px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: right"&gt;3,843,595&lt;/p&gt;
