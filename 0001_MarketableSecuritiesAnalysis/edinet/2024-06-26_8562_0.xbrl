&lt;col style="width:60.8pt;min-width:60.8pt;"/&gt;
&lt;col style="width:84.8pt;min-width:84.8pt;"/&gt;
&lt;col style="width:60.8pt;min-width:60.8pt;"/&gt;
&lt;/colgroup&gt;
