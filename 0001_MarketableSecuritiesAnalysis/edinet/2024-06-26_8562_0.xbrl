  <jpcrp_cor:DescriptionIssuedSharesVotingRights contextRef="CurrentYearInstant_OrdinarySharesSharesWithFullVotingRightsOtherMember" xsi:nil="true"/>
  <jpcrp_cor:DescriptionIssuedSharesVotingRights contextRef="CurrentYearInstant_OrdinarySharesSharesLessThanOneUnitMember">１単元(100株)未満の株式</jpcrp_cor:DescriptionIssuedSharesVotingRights>
