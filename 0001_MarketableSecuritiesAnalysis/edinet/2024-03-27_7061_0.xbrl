&lt;td style="vertical-align: middle; width: 70px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;
&lt;p style="line-height: 15px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;荒川　暁&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 94px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;
&lt;p style="line-height: 15px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;1974年10月31日&lt;/span&gt;&lt;span style="font-size: 10px"&gt;生&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 237px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;

&lt;p style="margin-left: 60px; line-height: 15px; margin-right: 3px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;1998年４月 株式会社野村総合研究所入社&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; line-height: 15px; margin-right: 3px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;2007年11月 J-STAR株式会社入社（現任）&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; line-height: 15px; margin-right: 3px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;2014年８月 ナースコール株式会社（現・ファミリー・ホスピス株式会社） 取締役就任&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; line-height: 15px; margin-right: 3px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;2015年12月 株式会社プラティア 社外取締役&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; line-height: 15px; margin-right: 3px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;2017年１月 当社取締役就任（現任）&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; line-height: 15px; margin-right: 3px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;2017年11月 株式会社三和サービス 社外取締役（現任）&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; line-height: 15px; margin-right: 3px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;2017年11月 株式会社いろはにほへと 社外取締役（現任）&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; line-height: 15px; margin-right: 3px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;2019年４月 WOLVES HAND株式会社 取締役（現任）&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; line-height: 15px; margin-right: 3px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;2021年４月 株式会社トイファクトリー 社外取締役就任（現任）&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; line-height: 15px; margin-right: 3px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;2022年12月 LE.O.VE株式会社 社外取締役（現任）&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; line-height: 15px; margin-right: 3px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;2023年５月 株式会社Shiftホールディングス 取締役就任（現任）&lt;/span&gt;
&lt;/p&gt;

