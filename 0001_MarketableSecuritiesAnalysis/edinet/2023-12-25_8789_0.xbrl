  <jpcrp_cor:NotesSecuritiesFinancialStatementsTextBlock contextRef="CurrentYearDuration">
&lt;h6 class="smt_head5" style="padding-left:0pt;line-height:13pt;"&gt;(有価証券関係)&lt;/h6&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:0pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:13pt;font-size:9pt;"&gt;前事業年度（&lt;span&gt;2022年９月30日&lt;/span&gt;）&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;line-height:13pt;"&gt;子会社株式&lt;span style="font-size:9pt;"&gt;は、市場価格のない株式等のため、&lt;/span&gt;子会社株式&lt;span style="font-size:9pt;"&gt;の時価を記載しておりません。&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_anno1" style="orphans:0;widows:0;padding-left:31.5pt;line-height:13pt;"&gt;（注）&lt;span style="font-size:9pt;"&gt;市場価格のない株式等の&lt;/span&gt;子会社株式&lt;span style="font-size:9pt;"&gt;及び関連会社株式の貸借対照表計上額&lt;/span&gt;&lt;/p&gt;
&lt;div class="tbld" style="text-align:left;margin-left:31.5pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" class="align_left" style="border-collapse:collapse;border:solid 0pt #000000;width:311.8pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
&lt;col style="width:187pt;min-width:187pt;"/&gt;
&lt;col style="width:124.8pt;min-width:124.8pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:20pt;min-height:20pt;"&gt;
