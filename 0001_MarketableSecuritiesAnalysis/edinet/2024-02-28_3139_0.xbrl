&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;"&gt;自　2017年３月16日&lt;/p&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;"&gt;至　2047年３月15日&lt;/p&gt;
