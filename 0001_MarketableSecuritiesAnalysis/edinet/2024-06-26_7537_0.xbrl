&lt;p style="line-height: 1.3333333333333333333333333333px; text-align: left"&gt; &lt;/p&gt;
&lt;div style="margin-left: 60px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 467.99999999999999999999999999px"&gt;
&lt;colgroup&gt;
