&lt;col style="width: 98.66666666666666666666666667px"/&gt;
&lt;col style="width: 69.333333333333333333333333333px"/&gt;
&lt;/colgroup&gt;
&lt;thead&gt;
&lt;tr style="height: 20px"&gt;
