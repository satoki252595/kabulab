  <jpcrp_cor:InformationForEachProductOrServiceTextBlock contextRef="Prior1YearDuration">
&lt;p style="margin-left: 72px; line-height: 18px; margin-right: 0px; text-align: left; text-indent: -24px"&gt;１．製品及びサービスごとの情報&lt;/p&gt;
&lt;p style="margin-left: 60px; line-height: 18px; margin-right: 3.3333333333333333333333333333px; margin-bottom: 6px; text-align: left; text-indent: 12px"&gt;単一の製品・サービス区分の外部顧客に対する売上高が、連結損益計算書の売上高の90％を超えるため、記載を省略しております。&lt;/p&gt;
</jpcrp_cor:InformationForEachProductOrServiceTextBlock>
  <jpcrp_cor:RevenuesFromExternalCustomersInformationForEachRegionTextBlock contextRef="Prior1YearDuration">
