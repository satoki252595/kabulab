&lt;tr style="height:20pt;min-height:20pt;"&gt;
&lt;td rowspan="5" style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;"&gt;ガ&lt;/p&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;"&gt;ス&lt;/p&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;"&gt;販&lt;/p&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;"&gt;売&lt;/p&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;"&gt;量&lt;/p&gt;
&lt;/td&gt;
