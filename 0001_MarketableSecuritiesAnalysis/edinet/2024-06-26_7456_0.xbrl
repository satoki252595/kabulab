&lt;tr style="height:9.8pt;min-height:9.8pt;"&gt;
&lt;td style="vertical-align:top;border-top-color:#a9a9a9;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;"&gt;2016年２月&lt;/p&gt;
