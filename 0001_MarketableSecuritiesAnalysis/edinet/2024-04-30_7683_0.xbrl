&lt;td rowspan="8" style="vertical-align: top; width: 13.333333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; line-height: 17.333333333333333333333333333px; margin-right: 6px; text-align: left"&gt;
