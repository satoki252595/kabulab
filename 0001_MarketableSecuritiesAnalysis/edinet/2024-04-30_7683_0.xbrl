&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 48px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;
&lt;p style="line-height: 15.333333333333333333333333333px; margin-right: 5px; text-align: right"&gt;
&lt;span style="font-size: 10px"&gt;（注）５&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 60px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;
&lt;p style="line-height: 15.333333333333333333333333333px; margin-right: 5px; text-align: right"&gt;
&lt;span style="font-size: 10px"&gt;5,000&lt;/span&gt;
&lt;/p&gt;
