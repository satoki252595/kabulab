&lt;td style="vertical-align:top;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:right;padding-left:5.0pt;padding-right:0pt;letter-spacing:0pt;line-height:17pt;"&gt;&lt;span style="font-family:&amp;apos;ＭＳ 明朝&amp;apos;;"&gt;13年&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
