  <jpcrp_cor:ClassesOfSharesEtcTextBlock contextRef="FilingDateInstant">
&lt;h4 class="smt_head3" style="padding-left:22.5pt;"&gt;【株式の種類等】&lt;/h4&gt;&lt;p class="smt_text2" style="orphans:0;widows:0;padding-left:28.3pt;text-indent:0pt;"&gt; 普通株式&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;"&gt; &lt;/p&gt;</jpcrp_cor:ClassesOfSharesEtcTextBlock>
  <jpcrp_cor:AcquisitionsByResolutionOfShareholdersMeetingTextBlock contextRef="FilingDateInstant">
&lt;h4 class="smt_head3" style="padding-left:13.5pt;line-height:19pt;"&gt;(1)【株主総会決議による取得の状況】&lt;/h4&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:8.9pt;text-indent:19.3pt;line-height:18pt;"&gt;&lt;span style="font-family:&amp;apos;ＭＳ 明朝&amp;apos;;font-size:9pt;"&gt; 該当事項はありません。&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:0pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:0pt;line-height:18.0pt;font-size:18.0pt;"&gt; &lt;/p&gt;</jpcrp_cor:AcquisitionsByResolutionOfShareholdersMeetingTextBlock>
  <jpcrp_cor:AcquisitionsByResolutionOfBoardOfDirectorsMeetingTextBlock contextRef="FilingDateInstant">
&lt;h4 class="smt_head3" style="padding-left:13.5pt;line-height:18pt;"&gt;(2)【取締役会決議による取得の状況】&lt;/h4&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:8.9pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:19.3pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:18pt;font-size:9pt;"&gt; 該当事項はありません。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:8.9pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:19.3pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:18pt;font-size:18pt;"&gt; &lt;/p&gt;</jpcrp_cor:AcquisitionsByResolutionOfBoardOfDirectorsMeetingTextBlock>
  <jpcrp_cor:AcquisitionsNotBasedOnResolutionOfShareholdersMeetingOrBoardOfDirectorsMeetingTextBlock contextRef="FilingDateInstant">
