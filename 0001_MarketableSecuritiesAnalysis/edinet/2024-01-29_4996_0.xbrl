&lt;td style="vertical-align:top;border-top-color:#a9a9a9;border-left-style:solid;border-left-width:0.75pt;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;letter-spacing:0pt;line-height:9pt;font-size:7.5pt;"&gt;当社監査役（現在）&lt;/p&gt;
&lt;/td&gt;
