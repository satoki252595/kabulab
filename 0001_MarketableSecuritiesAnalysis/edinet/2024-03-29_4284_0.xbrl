&lt;/tr&gt;
&lt;tr style="height: 21.47px"&gt;
&lt;td style="vertical-align: top; width: 87.46666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="line-height: 17.333333333333333333333333333px; text-align: center"&gt;2022年７月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 568px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 12px; line-height: 17.333333333333333333333333333px; margin-right: 12px; text-align: left"&gt;株式会社eek（現連結子会社）を設立　90.9％子会社（現95.2％）とする&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 21.47px"&gt;
&lt;td style="vertical-align: top; width: 87.46666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="line-height: 17.333333333333333333333333333px; text-align: center"&gt;2023年３月&lt;/p&gt;
