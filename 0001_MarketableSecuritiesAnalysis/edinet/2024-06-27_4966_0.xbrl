&lt;td rowspan="2" style="vertical-align: middle; width: 56px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;
&lt;p style="margin-left: 2.6666666666666666666666666667px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;対象となる&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 2.6666666666666666666666666667px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;役員の員数（人）&lt;/span&gt;
