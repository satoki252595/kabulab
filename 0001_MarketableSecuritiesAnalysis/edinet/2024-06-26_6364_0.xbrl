&lt;td style="vertical-align: middle; width: 558px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 7px; line-height: 20px; margin-right: 3.3333333333333333333333333333px; text-align: justify; text-justify: inter-ideograph"&gt;
