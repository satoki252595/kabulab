&lt;p style="margin-left: 12px; line-height: 18px; text-align: left; text-indent: -12px"&gt;（発行可能株式総数）&lt;/p&gt;
&lt;p style="margin-left: 60px; line-height: 18px; text-align: left; text-indent: -48px"&gt;第６条　当会社の発行可能株式総数は、&lt;span style="text-decoration: underline"&gt;24,174,720株&lt;/span&gt;とする。&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;/div&gt;
&lt;p style="margin-left: 84px; line-height: 18px; margin-right: 0px; text-align: left; text-indent: -12px"&gt;（3）日程&lt;/p&gt;
&lt;p style="margin-left: 84px; line-height: 18px; margin-right: 0px; text-align: left"&gt;定款一部変更の効力発生日　　　　　　2024年８月１日&lt;/p&gt;
</jpcrp_cor:NotesSignificantEventsAfterReportingPeriodConsolidatedFinancialStatementsTextBlock>
  <jpcrp_cor:AnnexedConsolidatedDetailedScheduleOfCorporateBondsTextBlock contextRef="CurrentYearDuration">
