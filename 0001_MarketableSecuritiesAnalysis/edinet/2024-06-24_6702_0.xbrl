&lt;p style="margin-left: 12px; line-height: 1; text-align: left; text-indent: 12px"&gt; &lt;/p&gt;
&lt;p style="margin-left: 12px; line-height: 1; text-align: left; text-indent: 12px"&gt;　&lt;span style="font-weight: bold"&gt;リスク&lt;/span&gt;&lt;/p&gt;
&lt;div style="margin-left: 39.466666666666666666666666667px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 611.2px"&gt;
