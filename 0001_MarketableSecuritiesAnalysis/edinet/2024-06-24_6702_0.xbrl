&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center"&gt;-&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 16px"&gt;
&lt;td style="vertical-align: middle; width: 124.46666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 12px; margin-right: 6px; text-align: left"&gt;代表取締役副社長&lt;/p&gt;
