&lt;tr&gt;
&lt;td style="vertical-align: top; width: 135.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-right: 6px; text-align: left"&gt;取得の対価（現金）&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 112px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 18px; margin-right: 6px; text-align: right"&gt;6,300百万円&lt;/p&gt;
