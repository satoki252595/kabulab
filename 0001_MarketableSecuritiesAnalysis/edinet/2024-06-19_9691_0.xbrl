  <jpcrp_cor:NotesShareOptionsEtcConsolidatedFinancialStatementsTextBlock contextRef="CurrentYearDuration">
&lt;h6 class="smt_head5" style="padding-left:13.5pt;"&gt;(ストック・オプション等関係)&lt;/h6&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:27pt;"&gt;該当事項はありません。&lt;/p&gt;&lt;p class="smt_text1" style="orphans:0;widows:0;"&gt; &lt;/p&gt;</jpcrp_cor:NotesShareOptionsEtcConsolidatedFinancialStatementsTextBlock>
  <jpcrp_cor:NotesTaxEffectAccountingConsolidatedFinancialStatementsTextBlock contextRef="CurrentYearDuration">&lt;p style="page-break-before:always; line-height:0.75pt; width:100%; font-size:0.75pt;"&gt; &lt;/p&gt;
&lt;h6 class="smt_head5" style="padding-left:13.5pt;"&gt;(税効果会計関係)&lt;/h6&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:18pt;line-height:13pt;"&gt;１．繰延税金資産及び繰延税金負債の発生の主な原因別の内訳&lt;/p&gt;&lt;p class="smt_unitR" style="orphans:0;widows:0;line-height:1pt;"&gt;　&lt;/p&gt;
