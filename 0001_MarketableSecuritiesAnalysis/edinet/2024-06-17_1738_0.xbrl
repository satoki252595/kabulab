  <jpcrp_cor:NotesRegardingTransactionsWithAffiliatedEntitiesTextBlock contextRef="CurrentYearDuration_NonConsolidatedMember">&lt;p class="smt_text6" style="orphans:0;widows:0;"&gt;※１　関係会社との取引高&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;line-height:9.5pt;font-size:9.5pt;"&gt; &lt;/p&gt;
