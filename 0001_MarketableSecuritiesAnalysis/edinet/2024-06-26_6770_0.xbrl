&lt;tr&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:double;border-bottom-width:2.25pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:5.3pt;padding-right:5.3pt;margin-top:0pt;margin-bottom:0pt;line-height:13.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;委員&lt;/span&gt;&lt;/p&gt;
