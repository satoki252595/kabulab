  <jpcrp_cor:NotesRelatedPartiesFinancialStatementsTextBlock contextRef="CurrentYearDuration">
&lt;h6&gt;【関連当事者情報】&lt;/h6&gt;
&lt;p style="margin-left: 36px; text-align: left; text-indent: 12px"&gt;関連当事者との取引&lt;/p&gt;
&lt;p style="margin-left: 48px; text-align: left; text-indent: 12px"&gt;財務諸表提出会社の親会社及び主要株主（会社等の場合に限る。）等&lt;/p&gt;
&lt;p style="margin-left: 84px; text-align: left; text-indent: -12px"&gt;前事業年度（自　2021年９月１日　至　2022年８月31日）&lt;/p&gt;
&lt;p style="margin-left: 84px; text-align: left; text-indent: -12px"&gt;該当事項はありません。&lt;/p&gt;
&lt;p style="margin-left: 60px; text-align: left; text-indent: -12px"&gt; &lt;/p&gt;
&lt;p style="margin-left: 84px; text-align: left; text-indent: -12px"&gt;当事業年度（自　2022年９月１日　至　2023年８月31日）&lt;/p&gt;
&lt;p style="margin-left: 84px; text-align: left; text-indent: -12px"&gt;１．財務諸表提出会社の親会社及び主要株主（会社等の場合に限る。）等&lt;/p&gt;
&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 652px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 69.333333333333333333333333333px"/&gt;
&lt;col style="width: 66.666666666666666666666666667px"/&gt;
&lt;col style="width: 53.333333333333333333333333333px"/&gt;
&lt;col style="width: 53.333333333333333333333333333px"/&gt;
&lt;col style="width: 53.333333333333333333333333333px"/&gt;
&lt;col style="width: 66.666666666666666666666666667px"/&gt;
&lt;col style="width: 74.666666666666666666666666667px"/&gt;
&lt;col style="width: 58.666666666666666666666666667px"/&gt;
&lt;col style="width: 52px"/&gt;
&lt;col style="width: 52px"/&gt;
&lt;col style="width: 52px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr style="height: 53.33px"&gt;
&lt;td style="vertical-align: middle; width: 69.333333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;種類&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 66.666666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;会社等の名称又は氏名&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 53.333333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;所在地&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 53.333333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;資本金又は出資金&lt;/span&gt;
&lt;/p&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;（千円）&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 53.333333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;事業の内容又は職業&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 66.666666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; line-height: 13.333333333333333333333333333px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;議決権等の所有（被所有）割合&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 74.666666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;関連当事者との関係&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 58.666666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; line-height: 13.333333333333333333333333333px; text-align: left"&gt;
