&lt;td style="vertical-align: middle; width: 348px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 30px; text-align: left"&gt;現金及び現金同等物&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 144px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-right: 6px; text-align: right"&gt;823&lt;/p&gt;
&lt;/td&gt;
