&lt;colgroup&gt;
&lt;col style="width: 156px"/&gt;
&lt;col style="width: 156px"/&gt;
&lt;col style="width: 156px"/&gt;
&lt;col style="width: 156px"/&gt;
&lt;/colgroup&gt;
&lt;thead&gt;
&lt;tr&gt;
