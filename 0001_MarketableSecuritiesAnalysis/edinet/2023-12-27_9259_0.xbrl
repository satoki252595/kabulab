  <jpcrp_cor:NotesRegardingIssuedSharesAndTreasurySharesTextBlock contextRef="Prior1YearDuration_NonConsolidatedMember">
&lt;h4 class="smt_head3" style="padding-left:18pt;"&gt;１  発行済株式に関する事項&lt;/h4&gt;
&lt;div class="tbld" style="margin-left:0pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:483.2pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
&lt;col style="width:96pt;min-width:96pt;"/&gt;
