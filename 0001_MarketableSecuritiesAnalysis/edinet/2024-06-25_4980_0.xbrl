&lt;tr style="height: 40.6px"&gt;
&lt;td style="vertical-align: middle; width: 192px; padding-top: 1px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: justify; text-justify: inter-ideograph; text-indent: 12px"&gt;サステナビリティ戦略目標&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 248px; padding-top: 1px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center; text-indent: 12px"&gt;持続的成長に欠かせないマテリアリティ「技術と人」に対する重要指標の達成度&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 70.333333333333333333333333333px; padding-top: 1px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: right; text-indent: 12px"&gt;20%&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 72.333333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: right; text-indent: 12px"&gt;0～200%&lt;/p&gt;
&lt;/td&gt;
