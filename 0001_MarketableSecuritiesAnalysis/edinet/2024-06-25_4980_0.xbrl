&lt;td style="vertical-align: middle; width: 94.53333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 19.333333333333333333333333333px; margin-right: 6px; text-align: right"&gt;19,167&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 66.133333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 19.333333333333333333333333333px; margin-right: 6px; text-align: right"&gt;19.0％&lt;/p&gt;
