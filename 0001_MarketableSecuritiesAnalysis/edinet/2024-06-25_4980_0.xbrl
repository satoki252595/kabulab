&lt;col style="width: 186.2px"/&gt;
&lt;col style="width: 216.2px"/&gt;
&lt;col style="width: 208.2px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr style="height: 26.67px"&gt;
