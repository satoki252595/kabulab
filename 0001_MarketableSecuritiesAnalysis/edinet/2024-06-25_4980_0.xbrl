&lt;p style="margin-left: 12px; line-height: 13.333333333333333333333333333px; margin-right: 12px; text-align: center"&gt;金額&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 18px"&gt;
&lt;td style="vertical-align: middle; width: 240px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 18px; margin-right: 3.3333333333333333333333333333px; text-align: left"&gt;熱伝導シート関連資産&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 197px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-right: 6px; text-align: right"&gt;11百万円&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 1.33px"&gt;
&lt;td style="vertical-align: middle; width: 240px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 18px; margin-right: 3.3333333333333333333333333333px; text-align: left"&gt;水浄化剤関連資産&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 197px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 42px; text-align: right"&gt;1&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
