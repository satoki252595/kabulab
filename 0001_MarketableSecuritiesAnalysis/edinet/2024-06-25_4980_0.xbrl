&lt;tr style="height: 26.67px"&gt;
&lt;td style="vertical-align: middle; width: 248px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 3px double #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
