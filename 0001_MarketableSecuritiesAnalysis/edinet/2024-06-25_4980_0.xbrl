&lt;p style="margin-left: 6px; line-height: 21.333333333333333333333333333px; margin-right: 6px; text-align: right"&gt;11,892百万円&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 135.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; line-height: 21.333333333333333333333333333px; margin-right: 6px; text-align: right"&gt;16,591百万円&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 126px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 21.333333333333333333333333333px; margin-right: 6px; text-align: right"&gt;4,699百万円&lt;/p&gt;
