&lt;td style="vertical-align: middle; width: 74.666666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; line-height: 18px; margin-right: 6px; text-align: right"&gt;66.4&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 74.666666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; line-height: 18px; margin-right: 6px; text-align: right"&gt;70.2&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 74.666666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; line-height: 18px; margin-right: 6px; text-align: right"&gt;76.3&lt;/p&gt;
