&lt;p style="line-height: 1; text-align: center"&gt;⑨&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 142.73333333333333333333333333px; padding-top: 1.8666666666666666666666666667px; padding-bottom: 1.8666666666666666666666666667px; padding-left: 1.8666666666666666666666666667px; padding-right: 1.8666666666666666666666666667px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
