&lt;td style="vertical-align: middle; width: 222.2px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 66px; line-height: 14.666666666666666666666666667px; text-align: left; text-indent: -60px"&gt;
