  </link:footnoteLink>
  <link:footnoteLink xlink:role="http://disclosure.edinet-fsa.go.jp/role/jppfs/rol_ConsolidatedStatementOfIncome" xlink:type="extended">
    <link:footnote xlink:label="footnote" xlink:role="http://disclosure.edinet-fsa.go.jp/role/jppfs/role/NotesNumber" xlink:type="resource" xml:lang="ja">※２</link:footnote>
    <link:loc xlink:href="#fact3" xlink:label="fact" xlink:type="locator"/>
