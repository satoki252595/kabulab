&lt;p style="text-align: right"&gt;（単位：千円）&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;/div&gt;
&lt;p style="line-height: 1.3333333333333333333333333333px; text-align: left"&gt; &lt;/p&gt;
&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 655.46666666666666666666666667px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 168px"/&gt;
&lt;col style="width: 159.46666666666666666666666667px"/&gt;
&lt;col style="width: 176px"/&gt;
&lt;col style="width: 152px"/&gt;
&lt;/colgroup&gt;
