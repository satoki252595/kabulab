&lt;col style="width:34.5pt;min-width:34.5pt;"/&gt;
&lt;col style="width:121.5pt;min-width:121.5pt;"/&gt;
&lt;col style="width:105.8pt;min-width:105.8pt;"/&gt;
&lt;col style="width:105.8pt;min-width:105.8pt;"/&gt;
&lt;/colgroup&gt;
