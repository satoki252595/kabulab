&lt;tr style="height: 1.33px"&gt;
&lt;td style="vertical-align: middle; width: 254px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 14.666666666666666666666666667px; text-align: justify; text-justify: inter-ideograph"&gt;契約負債（期末残高）&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 112px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 14.666666666666666666666666667px; margin-right: 6px; text-align: right"&gt;5,069&lt;/p&gt;
