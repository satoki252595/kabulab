&lt;p style="line-height: 13.333333333333333333333333333px; margin-right: 10px; text-align: center"&gt;（自 2022年４月１日&lt;/p&gt;
&lt;p style="margin-left: 12px; line-height: 13.333333333333333333333333333px; text-align: center"&gt;至 2023年３月31日）&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 150px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;当連結会計年度&lt;/p&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; margin-right: 10px; text-align: center"&gt;（自 2023年４月１日&lt;/p&gt;
&lt;p style="margin-left: 12px; line-height: 13.333333333333333333333333333px; text-align: center"&gt;至 2024年３月31日）&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 146px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;前年同期比（％）&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/thead&gt;
&lt;tbody&gt;
&lt;tr style="height: 23px"&gt;
&lt;td style="vertical-align: middle; width: 203px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
