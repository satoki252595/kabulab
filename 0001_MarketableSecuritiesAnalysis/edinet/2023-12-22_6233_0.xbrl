  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E34273-000SugaharaMasaoMember">1957-03-03</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock contextRef="FilingDateInstant_jpcrp030000-asr_E34273-000SugaharaMasaoMember">
&lt;p style="margin-left: 75px; line-height: 15px; margin-right: 3px; text-align: left; text-indent: -70px"&gt;
&lt;span style="font-size: 10px"&gt;昭和55年４月　株式会社東食（現株式会社カーギルジャパン）入社&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 75px; line-height: 15px; margin-right: 3px; text-align: left; text-indent: -70px"&gt;
&lt;span style="font-size: 10px"&gt;昭和56年６月　食品輸送株式会社出向&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 75px; line-height: 15px; margin-right: 3px; text-align: left; text-indent: -70px"&gt;
&lt;span style="font-size: 10px"&gt;平成10年７月　グルメフーズ株式会社入社&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 75px; line-height: 15px; margin-right: 3px; text-align: left; text-indent: -70px"&gt;
