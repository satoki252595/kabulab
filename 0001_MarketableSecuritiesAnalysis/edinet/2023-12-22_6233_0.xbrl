&lt;tr style="height: 1.33px"&gt;
&lt;td style="vertical-align: middle; width: 181.53333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center"&gt;
定時株主総会
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
