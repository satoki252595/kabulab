  <jpcrp_cor:ClassesOfSharesEtcTextBlock contextRef="FilingDateInstant">&lt;span style="font-size: 14px"&gt;【株式の種類等】　会社法第155条第７号による普通株式の取得&lt;/span&gt;</jpcrp_cor:ClassesOfSharesEtcTextBlock>
  <jpcrp_cor:AcquisitionsByResolutionOfShareholdersMeetingTextBlock contextRef="FilingDateInstant">
&lt;h4&gt;（１）【株主総会決議による取得の状況】&lt;/h4&gt;
&lt;p style="margin-left: 70px; text-align: left"&gt;
&lt;span style="font-size: 14px"&gt;　該当事項はありません。&lt;/span&gt;
&lt;/p&gt;
&lt;p style="text-align: left"&gt; &lt;/p&gt;
</jpcrp_cor:AcquisitionsByResolutionOfShareholdersMeetingTextBlock>
  <jpcrp_cor:AcquisitionsByResolutionOfBoardOfDirectorsMeetingTextBlock contextRef="FilingDateInstant">
