&lt;colgroup&gt;
&lt;col style="width: 121.26666666666666666666666667px"/&gt;
&lt;col style="width: 167.26666666666666666666666667px"/&gt;
&lt;col style="width: 120px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
