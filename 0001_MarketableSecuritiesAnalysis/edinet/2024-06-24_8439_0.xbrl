  <jpcrp_cor:CriticalContractsForOperationTextBlock contextRef="FilingDateInstant">
&lt;h3 class="smt_head2" style="line-height:15pt;"&gt;５ 【経営上の重要な契約等】&lt;/h3&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:9pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:9pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;font-size:12pt;"&gt;&lt;span style="font-size:9pt;"&gt;該当事項はありません。&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:48.5pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:-24pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:12pt;font-size:12pt;"&gt; &lt;/p&gt;</jpcrp_cor:CriticalContractsForOperationTextBlock>
  <jpcrp_cor:ResearchAndDevelopmentActivitiesTextBlock contextRef="FilingDateInstant">
