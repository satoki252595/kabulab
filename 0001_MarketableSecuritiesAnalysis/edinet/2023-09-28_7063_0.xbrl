&lt;p style="margin-left: 6px; margin-right: 4px; text-align: left"&gt;期間の定めはありません。&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 129.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; margin-right: 4px; text-align: left"&gt;期間の定めはありません。&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 36px"&gt;
&lt;td style="vertical-align: middle; width: 129.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; margin-right: 4px; text-align: left"&gt;権利行使期間&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 129.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 12px; text-align: center"&gt;2018年７月２日&lt;/p&gt;
&lt;p style="text-align: center"&gt;～2026年５月30日&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 129.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 12px; text-align: center"&gt;2019年７月19日&lt;/p&gt;
&lt;p style="margin-right: 12px; text-align: center"&gt;　～2027年７月18日&lt;/p&gt;
&lt;/td&gt;
