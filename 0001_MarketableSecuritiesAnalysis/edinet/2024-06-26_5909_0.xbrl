  </link:footnoteLink>
  <link:footnoteLink xlink:role="http://disclosure.edinet-fsa.go.jp/role/jppfs/rol_ConsolidatedBalanceSheet" xlink:type="extended">
    <link:footnote xlink:label="footnote" xlink:role="http://disclosure.edinet-fsa.go.jp/role/jppfs/role/NotesNumber" xlink:type="resource" xml:lang="ja">※4</link:footnote>
    <link:loc xlink:href="#fact2" xlink:label="fact" xlink:type="locator"/>
    <link:footnoteArc xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="fact" xlink:to="footnote" xlink:type="arc"/>
  </link:footnoteLink>
