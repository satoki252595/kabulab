&lt;tr style="height:17.3pt;min-height:17.3pt;"&gt;
&lt;td colspan="3" style="vertical-align:middle;border-top-color:#a9a9a9;border-left-color:#a9a9a9;border-right-color:#a9a9a9;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:0pt;padding-right:0pt;"&gt;ShoEi Foods(U.S.A.),Inc.&lt;/p&gt;
