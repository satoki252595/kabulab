&lt;td colspan="3" style="vertical-align:middle;border-left-color:#a9a9a9;border-right-color:#a9a9a9;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:10pt;padding-right:0pt;"&gt;３月31日  ＊１&lt;/p&gt;
&lt;/td&gt;
