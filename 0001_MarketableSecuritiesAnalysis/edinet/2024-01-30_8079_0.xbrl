&lt;td style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;padding-left:0pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:11pt;font-size:10.5pt;"&gt;自 &lt;span&gt;2021年11月１日&lt;/span&gt;&lt;br/&gt;至 &lt;span&gt;2022年10月31日&lt;/span&gt;&lt;/p&gt;
