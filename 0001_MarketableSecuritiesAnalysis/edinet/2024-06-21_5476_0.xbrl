&lt;p style="margin-right: 6px; text-align: center"&gt;15回&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 308px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-right: 6px; text-align: center"&gt;－&lt;/p&gt;
