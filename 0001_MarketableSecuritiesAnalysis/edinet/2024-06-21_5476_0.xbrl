&lt;col style="width: 107px"/&gt;
&lt;col style="width: 103px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr style="height: 41px"&gt;
&lt;td style="vertical-align: middle; width: 121px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; line-height: 14px; text-align: left"&gt; &lt;/p&gt;
&lt;p style="margin-left: 6px; line-height: 14px; text-align: center"&gt;（決議）&lt;/p&gt;
&lt;p style="margin-left: 6px; line-height: 14px; text-align: left"&gt; &lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 78px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 14px; text-align: center"&gt;株式の種類&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 84px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
