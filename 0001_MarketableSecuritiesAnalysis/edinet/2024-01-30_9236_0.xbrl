&lt;/td&gt;
&lt;td style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:0pt;padding-right:0pt;line-height:10.5pt;font-size:7.5pt;"&gt;&lt;span style="font-size:7.5pt;"&gt;株&lt;/span&gt;&lt;/p&gt;
