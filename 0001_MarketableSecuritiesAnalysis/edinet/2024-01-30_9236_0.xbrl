  <jpcrp_cor:RevenuesFromExternalCustomersInformationForEachRegionTextBlock contextRef="CurrentYearDuration_NonConsolidatedMember">
&lt;h5 class="smt_head4" style="padding-left:18pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;text-align:justify;line-height:15pt;font-size:9pt;"&gt;(1) 売上高&lt;/h5&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:36pt;line-height:15pt;"&gt;本邦以外の外部顧客への売上高がないため、該当事項はありません。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;line-height:15pt;font-size:15pt;"&gt; &lt;/p&gt;</jpcrp_cor:RevenuesFromExternalCustomersInformationForEachRegionTextBlock>
  <jpcrp_cor:PropertyPlantAndEquipmentInformationForEachRegionTextBlock contextRef="CurrentYearDuration_NonConsolidatedMember">
&lt;h5 class="smt_head4" style="padding-left:18pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;text-align:justify;line-height:14pt;font-size:9pt;"&gt;(2) 有形固定資産&lt;/h5&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:36pt;line-height:14pt;"&gt;本邦以外に所在している有形固定資産がないため、該当事項はありません。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;line-height:14pt;font-size:14pt;"&gt; &lt;/p&gt;</jpcrp_cor:PropertyPlantAndEquipmentInformationForEachRegionTextBlock>
  <jpcrp_cor:InformationForEachOfMainCustomersTextBlock contextRef="CurrentYearDuration_NonConsolidatedMember">&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:9pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;line-height:15pt;font-size:9pt;"&gt;３．主要な顧客ごとの情報&lt;/p&gt;&lt;p class="smt_text3" style="orphans:0;widows:0;"&gt;外部顧客への売上高のうち、損益計算書の売上高10％以上を占める相手先がいないため、記載を省略しております。&lt;/p&gt;</jpcrp_cor:InformationForEachOfMainCustomersTextBlock>
  <jpcrp_cor:DescriptionOfFactorsWhichLedToRecognitionOfGainOnBargainPurchaseTextBlock contextRef="CurrentYearDuration_NonConsolidatedMember">&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:18pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;line-height:15pt;font-size:9pt;"&gt;【報告セグメントごとの負ののれん発生益に関する情報】&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:9pt;text-indent:9pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;line-height:15pt;font-size:9pt;"&gt;該当事項はありません。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;line-height:15pt;font-size:15pt;"&gt; &lt;/p&gt;</jpcrp_cor:DescriptionOfFactorsWhichLedToRecognitionOfGainOnBargainPurchaseTextBlock>
