&lt;tbody&gt;
&lt;tr style="height: 24px"&gt;
&lt;td rowspan="2" style="vertical-align: middle; width: 160px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: left"&gt; スポーツクラブ業&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 160px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: left"&gt; 公衆浴場法&lt;/p&gt;
