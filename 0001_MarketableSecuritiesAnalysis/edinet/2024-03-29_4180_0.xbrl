&lt;td style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblR" style="orphans:0;widows:0;"&gt;&lt;span style="font-size:9pt;"&gt;26,418,004&lt;/span&gt;&lt;/p&gt;
