&lt;p style="margin-left: 6px; line-height: 15.333333333333333333333333333px; margin-right: 6px; text-align: right"&gt;
&lt;span style="font-size: 10px"&gt;944,053&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
