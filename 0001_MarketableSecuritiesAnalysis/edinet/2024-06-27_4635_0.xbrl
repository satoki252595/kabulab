&lt;td style="vertical-align: middle; width: 60px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="line-height: 15px; margin-right: 2.3333333333333333333333333333px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt; &lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
