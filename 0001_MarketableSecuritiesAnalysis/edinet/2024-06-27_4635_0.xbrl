&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 70px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;2013年12月&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 340px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 5px; line-height: 13.333333333333333333333333333px; margin-right: 2px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;第一東京弁護士会登録&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 5px; line-height: 13.333333333333333333333333333px; margin-right: 2px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;山分・島田・西法律事務所入所&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td rowspan="2" style="vertical-align: middle; width: 60px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 15px; margin-right: 5px; text-align: right"&gt;
&lt;span style="font-size: 10px"&gt;－&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 1.33px"&gt;
&lt;td style="vertical-align: top; width: 70px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;2016年６月&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 340px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 5px; line-height: 13.333333333333333333333333333px; margin-right: 2px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;Ｓ&amp;amp;Ｎパートナーズ法律会計事務所（現弁護士法人Ｓ&amp;amp;Ｎパートナーズ法律会計事務所）入所（現在）&lt;/span&gt;
&lt;/p&gt;
