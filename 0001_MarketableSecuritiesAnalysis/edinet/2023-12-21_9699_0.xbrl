&lt;p style="line-height: 17.333333333333333333333333333px; text-align: center"&gt;2012年４月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 557px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
