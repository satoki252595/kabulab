&lt;tr style="height: 18px"&gt;
&lt;td style="vertical-align: top; width: 60px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 5px; line-height: 15px; margin-right: 5px; margin-top: 2px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;2007年４月&lt;/span&gt;
