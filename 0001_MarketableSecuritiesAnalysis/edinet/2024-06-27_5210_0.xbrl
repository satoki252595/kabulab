  <jpcrp_cor:NotesRegardingDividendTextBlock contextRef="CurrentYearDuration">
&lt;p style="margin-left: 48px; line-height: 13.333333333333333333333333333px; margin-bottom: 12px; text-align: left; text-indent: -24px"&gt;２．配当に関する事項&lt;/p&gt;
