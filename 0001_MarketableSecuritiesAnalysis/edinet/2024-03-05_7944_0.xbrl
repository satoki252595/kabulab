  <jpcrp_cor:CriticalContractsForOperationTextBlock contextRef="FilingDateInstant">
&lt;h3 class="smt_head2"&gt;５ 【経営上の重要な契約等】&lt;/h3&gt;&lt;p class="smt_text3" style="orphans:0;widows:0;text-align:justify;padding-left:9pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:9pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;"&gt;(賃貸借契約)&lt;/p&gt;
&lt;div class="tbld"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:484.9pt;table-layout:fixed;"&gt;
