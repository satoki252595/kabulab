&lt;/td&gt;
&lt;td style="vertical-align:top;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:0.0pt;padding-right:0.0pt;margin-top:0.0pt;margin-bottom:0.0pt;letter-spacing:0.0pt;line-height:14pt;"&gt;&lt;span&gt;第82期&lt;/span&gt;事業年度第３四半期&lt;br/&gt;(自&lt;span&gt;2023年10月１日&lt;/span&gt;　至&lt;span&gt;2023年12月31日&lt;/span&gt;)&lt;/p&gt;
