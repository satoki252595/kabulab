&lt;p style="line-height: 1.3333333333333333333333333333px; text-align: left"&gt; &lt;/p&gt;
&lt;div style="margin-left: 6px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 634.66666666666666666666666667px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 229.33333333333333333333333333px"/&gt;
