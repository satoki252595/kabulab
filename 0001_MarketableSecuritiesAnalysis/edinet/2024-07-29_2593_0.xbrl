&lt;td style="vertical-align: middle; width: 383px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt;2004年７月28日&lt;/p&gt;
&lt;p style="text-align: center"&gt;（第２回新株予約権）&lt;/p&gt;
