&lt;td style="vertical-align: middle; width: 172px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-right: 72px; text-align: right"&gt;7,500,000&lt;/p&gt;
