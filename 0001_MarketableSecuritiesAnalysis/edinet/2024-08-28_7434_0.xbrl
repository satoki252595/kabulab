&lt;p style="line-height: 13.333333333333333333333333333px; text-align: left"&gt;　　赤星　知明&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 153px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;６回&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 159px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
