&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 492px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6.0666666666666666666666666667px; margin-right: 6.0666666666666666666666666667px; text-align: center"&gt;─────────&lt;/p&gt;
