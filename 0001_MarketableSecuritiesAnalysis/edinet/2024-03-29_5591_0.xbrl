  <jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E38949-000OhkawaYoheiMember">大川 遥平</jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors>
