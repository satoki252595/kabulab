  <jpcrp_cor:NotesRegardingDividendTextBlock contextRef="Prior1YearDuration">&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:18pt;line-height:15pt;"&gt;２．配当に関する事項&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:27pt;line-height:15pt;"&gt;(1) 配当金支払額&lt;/p&gt;
