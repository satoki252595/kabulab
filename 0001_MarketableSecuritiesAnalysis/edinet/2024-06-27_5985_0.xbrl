&lt;p style="line-height: 16px; text-align: center"&gt;1974年２月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 568px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; line-height: 16px; margin-right: 3.3333333333333333333333333333px; text-align: left"&gt;熊本県菊池市に菊池三興株式会社（現・サンコール菊池株式会社、連結子会社）を設立&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td style="vertical-align: top; width: 80px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 16px; text-align: center"&gt;1981年３月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 568px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; line-height: 16px; margin-right: 3.3333333333333333333333333333px; text-align: left"&gt;山梨県中巨摩郡に山梨三興株式会社（現・サンコールエンジニアリング株式会社、連結子会社）を設立&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td style="vertical-align: top; width: 80px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
