&lt;td style="vertical-align: top; width: 236.6px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: center"&gt;職務執行期間開始日経過時点における&lt;/p&gt;
&lt;p style="text-align: center"&gt;役位に応じた役位ポイント（※１）&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 37.8px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: center"&gt;×&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 264.6px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: center"&gt;ポイント付与日の前事業年度における&lt;/p&gt;
&lt;p style="text-align: center"&gt;業績に応じた業績評価係数（※２）&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;/div&gt;
&lt;p style="text-align: left; text-indent: 72px"&gt; &lt;/p&gt;
&lt;p style="text-align: left; text-indent: 72px"&gt;（※１）役位ポイント&lt;/p&gt;
