&lt;/div&gt;&lt;p class="smt_anno1" style="orphans:0;widows:0;padding-left:27pt;text-justify:inter-ideograph;text-indent:0pt;line-height:10pt;font-size:10pt;"&gt; &lt;/p&gt;</jpcrp_cor:DescriptionOfMetricsRelatedToPolicyOnDevelopmentOfHumanResourcesAndInternalEnvironmentAndTargetsAndPerformanceUsingSuchMetricsMetricsAndTargetsTextBlock>
