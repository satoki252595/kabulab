  <jpcrp_cor:NotesRelatedPartiesConsolidatedFinancialStatementsTextBlock contextRef="CurrentYearDuration">
&lt;h6 class="smt_head5" style="padding-left:9pt;line-height:11pt;"&gt;【関連当事者情報】&lt;/h6&gt;&lt;p class="smt_text3" style="orphans:0;widows:0;line-height:10pt;"&gt;該当事項はありません。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;line-height:7pt;"&gt;　&lt;/p&gt;</jpcrp_cor:NotesRelatedPartiesConsolidatedFinancialStatementsTextBlock>
