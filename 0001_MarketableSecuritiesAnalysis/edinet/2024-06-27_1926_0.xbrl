&lt;td style="vertical-align: top; width: 562px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 12px; line-height: 17.333333333333333333333333333px; text-align: left"&gt;株式会社タフアースを設立（現　非連結子会社）&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 1.33px"&gt;
&lt;td style="vertical-align: top; width: 84px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="line-height: 17.333333333333333333333333333px; margin-right: 12px; text-align: right"&gt;2019年４月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 562px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 12px; line-height: 17.333333333333333333333333333px; text-align: left"&gt;機構改革により２支社（関東、西日本）・７統括支店（北海道、東北、関東防災、関越、中部、中国、九州）２事業本部（建設、海外）制に移行&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 1.33px"&gt;
&lt;td style="vertical-align: top; width: 84px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="line-height: 17.333333333333333333333333333px; margin-right: 12px; text-align: right"&gt;2022年４月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 562px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 12px; line-height: 17.333333333333333333333333333px; text-align: left"&gt;東京証券取引所の市場区分の見直しにより、東京証券取引所の市場第一部からプライム市場に移行&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 1.33px"&gt;
&lt;td style="vertical-align: top; width: 84px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 17.333333333333333333333333333px; margin-right: 12px; text-align: right"&gt;2023年３月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 562px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 12px; line-height: 17.333333333333333333333333333px; text-align: left"&gt;Fecon Raito Underground Construction Joint Stock Companyの株式を取得（現　連結子会社）&lt;/p&gt;
&lt;/td&gt;
