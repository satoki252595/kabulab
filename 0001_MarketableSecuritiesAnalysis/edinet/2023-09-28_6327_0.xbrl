&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 303.33333333333333333333333333px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 70px"/&gt;
&lt;col style="width: 233.33333333333333333333333333px"/&gt;
&lt;/colgroup&gt;
