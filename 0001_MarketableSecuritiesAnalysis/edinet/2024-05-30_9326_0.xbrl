  <jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock contextRef="FilingDateInstant_jpcrp030000-asr_E35493-000AsakuraTomohitoMember">
&lt;p style="margin-left: 75px; line-height: 12px; margin-right: 3px; text-align: left; text-indent: -70px"&gt;
&lt;span style="font-size: 10px"&gt;1998年10月　当社 入社&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 75px; line-height: 12px; margin-right: 3px; text-align: left; text-indent: -70px"&gt;
&lt;span style="font-size: 10px"&gt;2004年５月　当社 取締役物流事業担当&lt;/span&gt;
