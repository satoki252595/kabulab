  <jpcrp_cor:NotesRegardingTransactionsWithAffiliatedEntitiesTextBlock contextRef="CurrentYearDuration_NonConsolidatedMember">&lt;p class="smt_text6" style="orphans:0;widows:0;line-height:14pt;"&gt;※１  関係会社との取引高&lt;/p&gt;&lt;p class="smt_unitR" style="orphans:0;widows:0;text-align:justify;padding-left:359.2pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:9.5pt;"&gt;　&lt;/p&gt;
