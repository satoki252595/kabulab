&lt;p style="margin-left: 6px; margin-right: 3.3333333333333333333333333333px; text-align: center"&gt;評価技法&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 129.6px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
