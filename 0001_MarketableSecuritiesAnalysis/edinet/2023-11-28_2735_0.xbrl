&lt;td style="vertical-align: middle; width: 228px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 12px; line-height: 16.666666666666666666666666667px; text-align: left; text-indent: -6px"&gt;自 2024年４月11日  至 2028年４月10日&lt;/p&gt;
&lt;/td&gt;
