&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:right;padding-left:8pt;padding-right:0pt;line-height:13pt;font-size:7.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;（3,081）&lt;/span&gt;&lt;/p&gt;
