  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E03251-000OkazakiIsamuMember">1942-02-21</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
