&lt;p style="margin-left: 36px; line-height: 16px; margin-right: 6px; text-align: left; text-indent: -36px"&gt; &lt;/p&gt;
&lt;p style="margin-left: 24px; line-height: 16px; margin-right: 6px; text-align: left; text-indent: -24px"&gt; &lt;/p&gt;
</jpcrp_cor:AcquisitionsNotBasedOnResolutionOfShareholdersMeetingOrBoardOfDirectorsMeetingTextBlock>
