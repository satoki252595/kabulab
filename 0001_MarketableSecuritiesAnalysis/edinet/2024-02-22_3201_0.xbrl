&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:222pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
&lt;col style="width:222pt;min-width:222pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:17.9pt;min-height:17.9pt;"&gt;
