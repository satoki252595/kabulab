&lt;col style="width:59pt;min-width:59pt;"/&gt;
&lt;col style="width:59pt;min-width:59pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:17.9pt;min-height:17.9pt;"&gt;
