  <jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E02691-000KasutaniSeiichiMember">糟谷　誠一</jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E02691-000KasutaniSeiichiMember">1962-09-22</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
