  <jpcrp_cor:NotesRegardingImpairmentLossTextBlock contextRef="CurrentYearDuration_NonConsolidatedMember">
&lt;p style="margin-left: 60px; line-height: 18px; margin-right: 0px; text-align: left"&gt;※７　減損損失&lt;/p&gt;
&lt;p style="margin-left: 90px; line-height: 18px; margin-right: 0px; text-align: left"&gt;当社は、以下の資産又は資産グループについて減損損失を計上しております。&lt;/p&gt;
&lt;p style="margin-left: 90px; line-height: 18px; margin-right: 0px; text-align: left"&gt; &lt;/p&gt;
&lt;p style="margin-left: 78px; line-height: 18px; margin-right: 0px; text-align: left"&gt;前事業年度（自　2022年４月１日　至　2023年３月31日）&lt;/p&gt;
&lt;p style="margin-left: 90px; line-height: 18px; margin-right: 0px; text-align: left"&gt;該当事項はありません。&lt;/p&gt;
&lt;p style="margin-left: 90px; line-height: 18px; margin-right: 0px; text-align: left"&gt; &lt;/p&gt;
&lt;p style="margin-left: 78px; line-height: 18px; margin-right: 0px; text-align: left"&gt;当事業年度（自　2023年４月１日　至　2024年３月31日）&lt;/p&gt;
&lt;div style="margin-left: 78px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 554.33333333333333333333333333px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 138.26666666666666666666666667px"/&gt;
&lt;col style="width: 138.33333333333333333333333333px"/&gt;
&lt;col style="width: 138.33333333333333333333333333px"/&gt;
&lt;col style="width: 139.4px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 138.26666666666666666666666667px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center"&gt;場所&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 138.33333333333333333333333333px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
