  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E04950-000DateCyuichiMember">1939-01-20</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
