&lt;col style="width:110pt;min-width:110pt;"/&gt;
&lt;col style="width:55pt;min-width:55pt;"/&gt;
&lt;col style="width:55pt;min-width:55pt;"/&gt;
&lt;col style="width:37pt;min-width:37pt;"/&gt;
&lt;col style="width:76.9pt;min-width:76.9pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:17.9pt;min-height:17.9pt;"&gt;
