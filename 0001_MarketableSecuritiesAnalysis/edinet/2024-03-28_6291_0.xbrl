&lt;p style="margin-left: 90px; line-height: 18px; margin-right: 34.066666666666666666666666667px; text-align: left; text-indent: 8.333333333333333333333333333px"&gt;33.3％&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 20px"&gt;
&lt;td style="vertical-align: middle; width: 221.46666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; line-height: 18px; margin-right: 6px; text-align: left"&gt;労働者の男女の賃金差異&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 187.06666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 90px; line-height: 18px; margin-right: 34.066666666666666666666666667px; text-align: left; text-indent: 8.333333333333333333333333333px"&gt;67.4％&lt;/p&gt;
