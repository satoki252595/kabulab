  <jpigp_cor:NotesCashFlowInformationConsolidatedFinancialStatementsIFRSTextBlock contextRef="CurrentYearDuration">&lt;p class="smt_head6" style="orphans:0;widows:0;line-height:13pt;"&gt;29．キャッシュ・フロー情報&lt;/p&gt;
