&lt;p style="text-align: left"&gt; &lt;/p&gt;
</jpcrp030000-asr_E36100-000:StrategyTextBlock>
  <jpcrp030000-asr_E36100-000:PolicyOnHumanResourceDevelopmentAndImprovementOfInternalEnvironmentStrategyTextBlock contextRef="FilingDateInstant">
