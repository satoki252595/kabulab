&lt;/td&gt;
&lt;td style="vertical-align:middle;border-left-style:solid;border-left-width:1.5pt;border-left-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;"&gt; &lt;/p&gt;
