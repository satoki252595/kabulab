&lt;tbody&gt;
&lt;tr style="height: 19px"&gt;
&lt;td style="vertical-align: top; width: 109px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: left"&gt;発行価格&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 49px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: right"&gt;１&lt;/p&gt;
&lt;/td&gt;
