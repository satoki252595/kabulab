&lt;p style="margin-right: 1.3333333333333333333333333333px; text-align: right"&gt;(1)&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 136px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: left"&gt;有価証券報告書&lt;/p&gt;
&lt;p style="text-align: left"&gt;及びその添付書類並びに確認書&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 104px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: center"&gt;事業年度&lt;/p&gt;
&lt;p style="text-align: center"&gt;(第46期)&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 156px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
