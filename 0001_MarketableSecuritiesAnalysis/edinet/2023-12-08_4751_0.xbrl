&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:21pt;min-height:21pt;"&gt;
&lt;td style="vertical-align:top;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:justify;padding-left:21.6pt;padding-right:0pt;margin-top:1pt;margin-bottom:1pt;text-justify:inter-ideograph;text-indent:-17.1pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;"&gt;&lt;span style="font-family:&amp;apos;ＭＳ 明朝&amp;apos;;"&gt;事業年度　&lt;/span&gt;&lt;span&gt;&lt;span style="font-family:&amp;apos;ＭＳ 明朝&amp;apos;;"&gt;第25期&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
