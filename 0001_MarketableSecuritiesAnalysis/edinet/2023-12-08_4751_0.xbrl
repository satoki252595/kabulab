&lt;td style="vertical-align:top;border-bottom-style:solid;border-bottom-width:0.75pt;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:0pt;padding-right:0pt;letter-spacing:0pt;line-height:15pt;font-size:7.5pt;"&gt;&lt;span style="font-family:&amp;apos;ＭＳ 明朝&amp;apos;;"&gt;×&lt;/span&gt;&lt;/p&gt;
