  <jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditorsProposal contextRef="FilingDateInstant_jpcrp030000-asr_E01708-000TanakaMotokoMember">田中　素子</jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditorsProposal>
  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditorsProposal contextRef="FilingDateInstant_jpcrp030000-asr_E01708-000TanakaMotokoMember">1959-12-13</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditorsProposal>
  <jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsProposalTextBlock contextRef="FilingDateInstant_jpcrp030000-asr_E01708-000TanakaMotokoMember">
&lt;p style="margin-left: 65px; line-height: 14.666666666666666666666666667px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;1989年10月　サンワ・等松青木監査法人(現 有限責任監査法人トーマツ)入所&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 5px; line-height: 14.666666666666666666666666667px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;2003年７月　有限責任監査法人トーマツ パートナー&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 5px; line-height: 14.666666666666666666666666667px; text-align: left"&gt;
