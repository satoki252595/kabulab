  <jpcrp_cor:InformationAboutEmployeesTextBlock contextRef="FilingDateInstant">
&lt;h3 class="smt_head2"&gt;５ 【従業員の状況】&lt;/h3&gt;
&lt;h4 class="smt_head3" style="padding-left:9pt;margin-bottom:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;text-align:justify;line-height:15pt;font-size:9pt;"&gt;(1) 連結会社の状況&lt;/h4&gt;&lt;p class="smt_unitR" style="orphans:0;widows:0;padding-left:150pt;"&gt;&lt;span&gt;2023年６月30日&lt;/span&gt;現在&lt;/p&gt;
&lt;div class="tbld" style="margin-left:0pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
