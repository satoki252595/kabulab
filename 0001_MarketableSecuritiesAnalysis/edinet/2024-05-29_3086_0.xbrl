&lt;col style="width: 18.933333333333333333333333333px"/&gt;
&lt;col style="width: 18.866666666666666666666666667px"/&gt;
&lt;col style="width: 18.933333333333333333333333333px"/&gt;
&lt;col style="width: 132.33333333333333333333333333px"/&gt;
