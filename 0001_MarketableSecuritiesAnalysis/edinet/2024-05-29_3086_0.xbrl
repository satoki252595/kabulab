&lt;tr style="height: 21.33px"&gt;
&lt;td style="vertical-align: middle; width: 102.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 8px; line-height: 13.333333333333333333333333333px; margin-right: 8px; text-align: center"&gt;開催日&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 512.86666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 8px; line-height: 13.333333333333333333333333333px; margin-right: 8px; text-align: center"&gt;主な議題&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 21.33px"&gt;
&lt;td style="vertical-align: middle; width: 102.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 8px; line-height: 13.333333333333333333333333333px; margin-right: 8px; text-align: right"&gt;2023年３月28日&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 512.86666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 8px; line-height: 13.333333333333333333333333333px; margin-right: 8px; text-align: left"&gt;内部統制システム構築の基本方針の運用状況及び財務報告に係る内部統制の評価結果、など&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 21.33px"&gt;
&lt;td style="vertical-align: middle; width: 102.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 8px; line-height: 13.333333333333333333333333333px; margin-right: 8px; text-align: right"&gt;４月11日&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 512.86666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 8px; line-height: 13.333333333333333333333333333px; margin-right: 8px; text-align: left"&gt;決算関連&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 21.33px"&gt;
&lt;td style="vertical-align: middle; width: 102.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 8px; line-height: 13.333333333333333333333333333px; margin-right: 8px; text-align: right"&gt;４月25日&lt;/p&gt;
&lt;/td&gt;
