  <jpcrp030000-asr_E03516-000:GainOnSaleOfSharesOfSubsidiariesAndAssociatesTextBlock contextRef="CurrentYearDuration_NonConsolidatedMember">
&lt;p style="line-height: 18.666666666666666666666666667px; text-align: left"&gt;
