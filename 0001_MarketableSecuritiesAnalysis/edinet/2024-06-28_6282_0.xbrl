&lt;tr style="height: 19px"&gt;
&lt;td style="vertical-align: top; width: 90px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 54px; margin-right: 6px; text-align: left"&gt;10月&lt;/p&gt;
