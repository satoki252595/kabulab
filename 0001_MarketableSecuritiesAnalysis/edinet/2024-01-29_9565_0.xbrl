  <jpcrp_cor:NotesRevenueRecognitionFinancialStatementsTextBlock contextRef="CurrentYearDuration">&lt;p class="smt_head5" style="orphans:0;widows:0;padding-left:27pt;"&gt;(収益認識関係)&lt;/p&gt;
