  <jpcrp_cor:NotesRegardingDividendTextBlock contextRef="Prior1YearDuration">&lt;p class="smt_text5" style="orphans:0;widows:0;padding-left:0pt;text-indent:0pt;"&gt;３．配当に関する事項&lt;/p&gt;&lt;p class="smt_text5" style="orphans:0;widows:0;padding-left:0pt;text-indent:0pt;"&gt;(1) 当連結会計年度中の配当金支払額&lt;/p&gt;
