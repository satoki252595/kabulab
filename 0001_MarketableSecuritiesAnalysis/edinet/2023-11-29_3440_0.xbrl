&lt;p style="margin-left: 12px; margin-right: 12px; text-align: left"&gt;期末残高&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 158.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 50.666666666666666666666666667px; text-align: right"&gt;101,362&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 158.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 50.666666666666666666666666667px; text-align: right"&gt;232,890&lt;/p&gt;
