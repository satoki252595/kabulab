  <jpcrp_cor:InformationForEachProductOrServiceTextBlock contextRef="Prior1YearDuration">
&lt;p style="margin-left: 72px; line-height: 18px; margin-right: 0px; text-align: left; text-indent: -24px"&gt;１．製品及びサービスごとの情報&lt;/p&gt;
&lt;p style="margin-left: 72px; line-height: 18px; margin-right: 0px; margin-bottom: 6px; text-align: left"&gt;セグメント情報に同様の情報を開示しているため、記載を省略しております。&lt;/p&gt;
</jpcrp_cor:InformationForEachProductOrServiceTextBlock>
  <jpcrp_cor:RevenuesFromExternalCustomersInformationForEachRegionTextBlock contextRef="Prior1YearDuration">
&lt;p style="margin-left: 60px; line-height: 18px; margin-right: 0px; text-align: left"&gt;(1）売上高&lt;/p&gt;
&lt;p style="margin-left: 72px; line-height: 18px; margin-right: 0px; margin-bottom: 6px; text-align: left; text-indent: 12px"&gt;本邦の外部顧客への売上高が連結損益計算書の売上高の90％を超えるため、記載を省略しております。&lt;/p&gt;
</jpcrp_cor:RevenuesFromExternalCustomersInformationForEachRegionTextBlock>
  <jpcrp_cor:PropertyPlantAndEquipmentInformationForEachRegionTextBlock contextRef="Prior1YearDuration">
&lt;p style="margin-left: 60px; line-height: 18px; margin-right: 0px; text-align: left"&gt;(2）有形固定資産&lt;/p&gt;
&lt;p style="margin-left: 72px; line-height: 18px; margin-right: 0px; margin-bottom: 6px; text-align: left; text-indent: 12px"&gt;本邦に所在している有形固定資産の金額が連結貸借対照表の有形固定資産の金額の90％を超えるため、記載を省略しております。&lt;/p&gt;
</jpcrp_cor:PropertyPlantAndEquipmentInformationForEachRegionTextBlock>
  <jpcrp_cor:InformationForEachOfMainCustomersTextBlock contextRef="Prior1YearDuration">
&lt;p style="margin-left: 72px; line-height: 18px; margin-right: 0px; text-align: left; text-indent: -24px"&gt;３．主要な顧客ごとの情報&lt;/p&gt;
&lt;p style="margin-left: 60px; line-height: 18px; margin-right: 0px; text-align: left; text-indent: 12px"&gt;外部顧客への売上高のうち、特定の顧客への売上高であって、連結損益計算書の売上高の10％以上を占めるものがないため、記載を省略しております。&lt;/p&gt;
</jpcrp_cor:InformationForEachOfMainCustomersTextBlock>
  <jpcrp_cor:InformationForEachProductOrServiceTextBlock contextRef="CurrentYearDuration">
&lt;p style="margin-left: 72px; line-height: 18px; margin-right: 0px; text-align: left; text-indent: -24px"&gt;１．製品及びサービスごとの情報&lt;/p&gt;
