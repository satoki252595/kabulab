  <jpcrp_cor:NotesEquityInEarningsLossesOfAffiliatesIfEquityMethodIsAppliedFinancialStatementsTextBlock contextRef="CurrentYearDuration">&lt;p style="page-break-before:always; line-height:0.75pt; width:100%; font-size:0.75pt;"&gt; &lt;/p&gt;
&lt;h6 class="smt_head5" style="padding-left:18pt;"&gt;(持分法損益等)&lt;/h6&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:10pt;text-indent:10pt;"&gt;関連会社がないため、持分法の適用はありません。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;line-height:10pt;"&gt;　&lt;/p&gt;</jpcrp_cor:NotesEquityInEarningsLossesOfAffiliatesIfEquityMethodIsAppliedFinancialStatementsTextBlock>
  <jpcrp_cor:NotesRelatedPartiesFinancialStatementsTextBlock contextRef="CurrentYearDuration">
&lt;h6 class="smt_head5" style="padding-left:18pt;"&gt;【関連当事者情報】&lt;/h6&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:20pt;"&gt;前事業年度(自　&lt;span&gt;2022年4月1日&lt;/span&gt;　至　&lt;span&gt;2023年3月31日&lt;/span&gt;)&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;"&gt; &lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:10pt;text-indent:10pt;"&gt;１．関連当事者との取引&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:20pt;text-indent:10pt;"&gt;該当事項はありません。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:20pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:10pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;font-size:15pt;"&gt; &lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:10pt;text-indent:10pt;"&gt;２．親会社又は重要な関連会社に関する注記&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:20pt;text-indent:10pt;"&gt;該当事項はありません。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;"&gt; &lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:20pt;"&gt;当事業年度(自　&lt;span&gt;2023年4月1日&lt;/span&gt;　至　&lt;span&gt;2024年3月31日&lt;/span&gt;)&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;"&gt; &lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:10pt;text-indent:10pt;"&gt;１．関連当事者との取引&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:20pt;text-indent:10pt;"&gt;該当事項はありません。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:20pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:10pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;font-size:15pt;"&gt; &lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:10pt;text-indent:10pt;"&gt;２．親会社又は重要な関連会社に関する注記&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:20pt;text-indent:10pt;"&gt;該当事項はありません。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;"&gt; &lt;/p&gt;</jpcrp_cor:NotesRelatedPartiesFinancialStatementsTextBlock>
  <jpcrp_cor:NotesPerShareInformationFinancialStatementsTextBlock contextRef="CurrentYearDuration">&lt;p style="page-break-before:always; line-height:0.75pt; width:100%; font-size:0.75pt;"&gt; &lt;/p&gt;
