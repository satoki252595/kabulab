&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:183.1pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
&lt;col style="width:51.8pt;min-width:51.8pt;"/&gt;
