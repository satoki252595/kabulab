  <jpcrp_cor:AnnexedDetailedScheduleOfProvisionsTextBlock contextRef="CurrentYearDuration">
&lt;h6 class="smt_head5" style="padding-left:31.5pt;"&gt;【引当金明細表】&lt;/h6&gt;&lt;p class="smt_text1" style="orphans:0;widows:0;text-align:right;"&gt;（単位：百万円）&lt;/p&gt;&lt;p class="smt_unitR" style="orphans:0;widows:0;line-height:1pt;"&gt;　&lt;/p&gt;
&lt;div class="tbld" style="text-align:center;margin-left:0pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
