&lt;/td&gt;
&lt;td style="vertical-align:top;border-top-color:#a9a9a9;border-left-style:solid;border-left-width:0.75pt;border-right-color:#a9a9a9;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:3.4pt;padding-right:3.4pt;line-height:10pt;font-size:7.5pt;"&gt;General Motors Corp. 駐在&lt;/p&gt;
