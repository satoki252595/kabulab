&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:28.3pt;min-height:28.3pt;"&gt;
&lt;td style="vertical-align:top;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:0pt;padding-right:0pt;margin-bottom:0pt;line-height:12pt;font-size:10.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;・太陽光パネル&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:0pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:12pt;font-size:10.5pt;"&gt;　&lt;span style="font-size:9pt;"&gt;大量廃棄への対応&lt;/span&gt;&lt;/p&gt;
