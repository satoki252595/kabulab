&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 13.333333333333333333333333333px; margin-right: 5px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;2023年４月 管理本部長&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 13.333333333333333333333333333px; margin-right: 5px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;2023年６月 執行役員管理本部長（現任）&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 94px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 15px; margin-right: 5px; text-align: right"&gt;
&lt;span style="font-size: 10px"&gt;1,200&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 58.07px"&gt;
&lt;td style="vertical-align: middle; width: 115px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 5px; line-height: 15px; margin-right: 5px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;清水　貴雄&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 125px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 15px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;1970年５月23日生&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 238px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 65px; line-height: 13.333333333333333333333333333px; margin-right: 5px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;1994年３月 昭和パックス株式会社入社&lt;/span&gt;
&lt;/p&gt;
