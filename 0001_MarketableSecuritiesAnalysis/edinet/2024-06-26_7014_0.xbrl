&lt;td colspan="3" style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;line-height:11pt;"&gt;既発行株式数＋新株発行(処分)株式数&lt;/p&gt;
&lt;/td&gt;
