&lt;span style="font-size: 10px"&gt;当社最高財務責任者（ＣＦＯ）&lt;/span&gt;
&lt;/p&gt;
&lt;p style="line-height: 14.266666666666666666666666667px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;当社コンプライアンス・関係会社担当&lt;/span&gt;
&lt;/p&gt;
&lt;p style="line-height: 14.266666666666666666666666667px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;当社経営企画担当&lt;/span&gt;
&lt;/p&gt;
&lt;p style="line-height: 14.266666666666666666666666667px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;当社購買部管掌&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 15px"&gt;
&lt;td style="vertical-align: top; width: 70px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 5px; line-height: 14.266666666666666666666666667px; text-align: left"&gt;
