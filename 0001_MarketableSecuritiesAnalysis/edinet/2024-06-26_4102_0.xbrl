&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 180.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 14.266666666666666666666666667px; text-align: left"&gt;
