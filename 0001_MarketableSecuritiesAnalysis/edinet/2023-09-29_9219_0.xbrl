&lt;p style="margin-left: 12px; line-height: 13.333333333333333333333333333px; margin-right: 10px; text-align: left"&gt;Data-Informed事業本部&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 204px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
