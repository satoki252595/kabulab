  <jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock contextRef="FilingDateInstant_jpcrp030000-asr_E05643-000TanakaAkiraMember">
&lt;p style="margin-left: 65px; line-height: 14.666666666666666666666666667px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;1978年４月　住友商事㈱入社&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 14.666666666666666666666666667px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;1984年２月　イラク支店駐在&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 14.666666666666666666666666667px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;1991年１月　英国住友商事駐在&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 14.666666666666666666666666667px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;1997年１月　本社主計第一部部長代理&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 14.666666666666666666666666667px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;2003年３月　米国住友商事駐在&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 14.666666666666666666666666667px; text-align: left; text-indent: -60px"&gt;
