&lt;p style="margin-left: 0px; margin-right: 0px; text-align: center; line-height: 1"&gt;
&lt;img alt="0102010_002.png" src="images/0102010_002.png" style="height: 199.93px; width: 160px"/&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 0px none #000000; border-top: 0px none #000000; border-right: 0px none #000000; border-bottom: 0px none #000000; width: 36px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
