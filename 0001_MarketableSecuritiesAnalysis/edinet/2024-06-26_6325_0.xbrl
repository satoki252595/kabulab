&lt;tr style="height: 42.33px"&gt;
&lt;td style="vertical-align: top; width: 75px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 12px; text-align: center"&gt;
