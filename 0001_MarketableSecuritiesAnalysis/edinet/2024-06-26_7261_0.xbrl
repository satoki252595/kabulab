&lt;/td&gt;
&lt;td rowspan="6" style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:2pt;padding-right:2pt;margin-top:0pt;text-justify:inter-ideograph;text-indent:0pt;line-height:12pt;font-size:10.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;資源需要、廃棄物量&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:9pt;"&gt;の増加&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:2pt;padding-right:2pt;margin-top:0pt;text-justify:inter-ideograph;text-indent:0pt;line-height:12pt;font-size:10.5pt;"&gt; &lt;br/&gt;&lt;span style="font-size:9pt;"&gt;水資源問題&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:2pt;padding-right:2pt;margin-top:0pt;text-justify:inter-ideograph;text-indent:0pt;line-height:12pt;font-size:10.5pt;"&gt; &lt;br/&gt;&lt;span style="font-size:9pt;"&gt;（サーキュラー・&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:9pt;"&gt;エコノミー）&lt;/span&gt;&lt;/p&gt;
