&lt;col style="width:72.5pt;min-width:72.5pt;"/&gt;
&lt;col style="width:72.5pt;min-width:72.5pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:17.1pt;min-height:17.1pt;"&gt;
