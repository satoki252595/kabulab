  <jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E05697-000SugizakiMasatoMember">杉崎　政人</jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E05697-000SugizakiMasatoMember">1975-10-15</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock contextRef="FilingDateInstant_jpcrp030000-asr_E05697-000SugizakiMasatoMember">
&lt;p style="margin-left: 75px; line-height: 15px; margin-right: 3px; text-align: left; text-indent: -70px"&gt;
&lt;span style="font-size: 10px"&gt;1998年４月　　三井リース事業㈱（現JA三井リース㈱）入社&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 75px; line-height: 15px; margin-right: 3px; text-align: left; text-indent: -70px"&gt;
&lt;span style="font-size: 10px"&gt;2004年３月　　㈱アッカ・ネットワークス（現ソフトバンク㈱）入社&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 75px; line-height: 15px; margin-right: 3px; text-align: left; text-indent: -70px"&gt;
&lt;span style="font-size: 10px"&gt;2009年４月　　当社入社&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 75px; line-height: 15px; margin-right: 3px; text-align: left; text-indent: -70px"&gt;
