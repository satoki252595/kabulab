&lt;tr style="height: 24.2px"&gt;
&lt;td style="vertical-align: top; width: 336px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: left"&gt;繰延税金負債との相殺後の繰延税金資産&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 149.4px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 18px; text-align: right"&gt;1,140&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 149.4px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 18px; text-align: right"&gt;664&lt;/p&gt;
