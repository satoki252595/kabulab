  <jpcrp_cor:NotesRegardingDividendTextBlock contextRef="CurrentYearDuration">&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:45pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;font-size:9pt;"&gt;３．配当に関する事項&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:54pt;line-height:18pt;"&gt;&lt;span style="font-family:&amp;apos;ＭＳ 明朝&amp;apos;;font-size:9pt;"&gt;(1）配当金支払額&lt;/span&gt;&lt;/p&gt;
