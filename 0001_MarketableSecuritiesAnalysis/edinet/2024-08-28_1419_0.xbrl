&lt;td style="vertical-align:top;border-left-color:#a9a9a9;border-right-color:#a9a9a9;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblR" style="orphans:0;widows:0;text-align:right;padding-right:43.1pt;"&gt;1.2&lt;/p&gt;
