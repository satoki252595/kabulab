&lt;col style="width:36pt;min-width:36pt;"/&gt;
&lt;col style="width:36pt;min-width:36pt;"/&gt;
&lt;col style="width:36pt;min-width:36pt;"/&gt;
&lt;col style="width:36.8pt;min-width:36.8pt;"/&gt;
