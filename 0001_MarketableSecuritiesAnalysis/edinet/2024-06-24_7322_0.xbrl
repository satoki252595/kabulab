&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr style="height: 18.67px"&gt;
&lt;td style="vertical-align: middle; width: 301.8px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt;結合当事企業の名称&lt;/p&gt;
&lt;/td&gt;
