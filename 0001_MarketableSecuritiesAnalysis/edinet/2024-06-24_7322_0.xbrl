  <jpcrp_cor:NameOfGroupCompanyHoldingLargestAmountOfInvestmentSharesInGroup contextRef="CurrentYearInstant">株式会社三十三銀行</jpcrp_cor:NameOfGroupCompanyHoldingLargestAmountOfInvestmentSharesInGroup>
