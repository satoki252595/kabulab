&lt;tr style="height: 30px"&gt;
&lt;td style="vertical-align: middle; width: 153.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; line-height: 21.333333333333333333333333333px; margin-right: 3.3333333333333333333333333333px; text-align: left"&gt;１単元の株式数&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 493.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
