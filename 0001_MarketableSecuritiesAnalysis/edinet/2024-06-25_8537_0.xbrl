&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 189.93333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 6.6666666666666666666666666667px; padding-right: 7.2px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;
&lt;p style="text-align: center"&gt;2023年度～2030年度累計&lt;/p&gt;
&lt;p style="text-align: center"&gt;3,000億円以上&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 189.93333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 6.6666666666666666666666666667px; padding-right: 7.2px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;
&lt;p style="line-height: 1; text-align: center"&gt;2023年度（１年間）&lt;/p&gt;
&lt;p style="text-align: center"&gt;264億円&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 42.67px"&gt;
&lt;td style="vertical-align: middle; width: 236.13333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 6.6666666666666666666666666667px; padding-right: 7.2px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;
&lt;p style="line-height: 18px; text-align: left"&gt;CO&lt;sub&gt;2&lt;/sub&gt;排出量（Scope1・Scope2）の削減&lt;/p&gt;
&lt;/td&gt;
