&lt;td style="vertical-align: middle; width: 191.13333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 6.6666666666666666666666666667px; padding-right: 7.2px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;
