  <jpcrp_cor:NotesRegardingAccumulatedDepreciationOfPropertyPlantAndEquipmentTextBlock contextRef="CurrentYearInstant">
&lt;p style="margin-left: 24px; text-align: left; text-indent: -24px"&gt; &lt;/p&gt;
&lt;p style="margin-left: 24px; text-align: left; text-indent: -24px"&gt;※７．有形固定資産の減価償却累計額&lt;/p&gt;
&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 647.99999999999999999999999999px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 253.33333333333333333333333333px"/&gt;
