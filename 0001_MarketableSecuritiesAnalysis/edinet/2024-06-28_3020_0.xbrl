&lt;p style="margin-left: 18px; line-height: 14.666666666666666666666666667px; margin-top: 6.6666666666666666666666666667px; text-align: justify; text-justify: inter-ideograph"&gt;期首残高&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 128px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="line-height: 14.666666666666666666666666667px; margin-right: 6px; margin-top: 6.6666666666666666666666666667px; text-align: right"&gt;1,487&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 128px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
