&lt;col style="width:42.8pt;min-width:42.8pt;"/&gt;
&lt;col style="width:57.8pt;min-width:57.8pt;"/&gt;
&lt;col style="width:40pt;min-width:40pt;"/&gt;
&lt;col style="width:58pt;min-width:58pt;"/&gt;
&lt;col style="width:45pt;min-width:45pt;"/&gt;
&lt;col style="width:38pt;min-width:38pt;"/&gt;
&lt;col style="width:47pt;min-width:47pt;"/&gt;
&lt;col style="width:38.3pt;min-width:38.3pt;"/&gt;
