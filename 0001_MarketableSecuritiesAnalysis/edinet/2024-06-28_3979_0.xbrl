&lt;col style="width:30.2pt;min-width:30.2pt;"/&gt;
&lt;col style="width:65pt;min-width:65pt;"/&gt;
&lt;col style="width:60pt;min-width:60pt;"/&gt;
&lt;col style="width:30.2pt;min-width:30.2pt;"/&gt;
&lt;col style="width:30.2pt;min-width:30.2pt;"/&gt;
&lt;col style="width:44.3pt;min-width:44.3pt;"/&gt;
