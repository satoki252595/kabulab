  <jpigp_cor:NotesInvestmentPropertyConsolidatedFinancialStatementsIFRSTextBlock contextRef="CurrentYearDuration">&lt;p class="smt_head6" style="orphans:0;widows:0;"&gt;13．投資不動産&lt;/p&gt;
