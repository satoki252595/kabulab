&lt;/tr&gt;
&lt;tr style="height: 21.33px"&gt;
&lt;td style="vertical-align: middle; width: 194px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: left"&gt;繰延税金資産（純額）&lt;/p&gt;
