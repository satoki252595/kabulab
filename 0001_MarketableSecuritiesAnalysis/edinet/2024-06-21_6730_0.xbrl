  <jpcrp_cor:NotesRegardingAmountOfContractLiabilitiesTextBlock contextRef="CurrentYearInstant">
&lt;p style="margin-left: 40px; text-align: left; text-indent: -24px"&gt;
&lt;span style="font-family: &amp;apos;Times New Roman&amp;apos;"&gt;※&lt;/span&gt;２　その他のうち&lt;span style="font-family: &amp;apos;Times New Roman&amp;apos;"&gt;、&lt;/span&gt;契約負債の金額は&lt;span style="font-family: &amp;apos;Times New Roman&amp;apos;"&gt;、&lt;/span&gt;以下のとおりであります&lt;span style="font-family: &amp;apos;Times New Roman&amp;apos;"&gt;。&lt;/span&gt;&lt;/p&gt;
&lt;div style="margin-left: 36px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 602.66666666666666666666666667px"&gt;
