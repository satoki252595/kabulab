&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 113.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 17.333333333333333333333333333px; margin-right: 18px; text-align: right"&gt;4,853&lt;/p&gt;
&lt;p style="line-height: 17.333333333333333333333333333px; margin-right: 18px; text-align: right"&gt;2,170&lt;/p&gt;
