  <jpcrp_cor:CompanyHistoryTextBlock contextRef="FilingDateInstant">
&lt;h3&gt;２【沿革】&lt;/h3&gt;
&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 647.46666666666666666666666667px"&gt;
&lt;colgroup&gt;
