&lt;td style="vertical-align: middle; width: 211.46666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: right"&gt;
267
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 112.53333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 60px; text-align: right"&gt;(99)&lt;/p&gt;
&lt;/td&gt;
