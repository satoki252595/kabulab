&lt;td style="vertical-align: middle; width: 82.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 6px; text-align: right"&gt;1,982&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 82.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 6px; text-align: right"&gt;1,849&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 82.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 6px; text-align: right"&gt;1,905&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 82.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 6px; text-align: right"&gt;1,869&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 26.67px"&gt;
&lt;td style="vertical-align: middle; width: 183px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; text-align: left"&gt;最低株価&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 49.333333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt;（円）&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 82.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 6px; text-align: right"&gt;1,461&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 82.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 6px; text-align: right"&gt;1,522&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 82.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 6px; text-align: right"&gt;1,553&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 82.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 6px; text-align: right"&gt;1,750&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 82.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 6px; text-align: right"&gt;1,789&lt;/p&gt;
&lt;/td&gt;
