&lt;p style="line-height: 16.666666666666666666666666667px; text-align: center"&gt;
&lt;span style="font-size: 14px"&gt;(1)&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 193px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 7px; line-height: 16.666666666666666666666666667px; text-align: left"&gt;
&lt;span style="font-size: 14px"&gt;有価証券報告書及び&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 7px; line-height: 16.666666666666666666666666667px; text-align: left"&gt;
&lt;span style="font-size: 14px"&gt;その添付書類並びに確認書&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 82px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 16.666666666666666666666666667px; text-align: center"&gt;
&lt;span style="font-size: 14px"&gt;事業年度&lt;/span&gt;
&lt;/p&gt;
&lt;p style="line-height: 16.666666666666666666666666667px; text-align: center"&gt;
&lt;span style="font-size: 14px"&gt;第58期&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 168px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 7px; line-height: 16.666666666666666666666666667px; text-align: left"&gt;
&lt;span style="font-size: 14px"&gt;自  2022年４月１日&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 7px; line-height: 16.666666666666666666666666667px; text-align: left"&gt;
&lt;span style="font-size: 14px"&gt;至  2023年３月31日&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 156px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 7px; line-height: 16.666666666666666666666666667px; text-align: left"&gt;
&lt;span style="font-size: 14px"&gt;2023年６月23日&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 7px; line-height: 16.666666666666666666666666667px; text-align: left"&gt;
&lt;span style="font-size: 14px"&gt;関東財務局長に提出&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 20px"&gt;
&lt;td style="vertical-align: top; width: 35px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 12px; text-align: center"&gt;
&lt;span style="font-size: 12px"&gt; &lt;/span&gt;
