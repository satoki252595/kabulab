&lt;td style="vertical-align: top; width: 193px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 7px; line-height: 12px; text-align: left"&gt;
&lt;span style="font-size: 12px"&gt; &lt;/span&gt;
