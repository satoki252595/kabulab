p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:left;padding-left:47.5pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:-36pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;font-size:15pt;"&gt; &lt;/p&gt;</jpcrp_cor:NotesRegardingNewShareSubscriptionRightsEtcTextBlock>
  <jpcrp_cor:NotesRegardingDividendTextBlock contextRef="CurrentYearDuration">
