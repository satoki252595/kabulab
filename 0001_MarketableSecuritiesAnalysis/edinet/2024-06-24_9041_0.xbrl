&lt;span style="font-size: 10px"&gt;昭和60年４月&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 218px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 15px; line-height: 15px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;近畿日本鉄道㈱（現 近鉄グループホールディングス㈱）入社&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 15px"&gt;
&lt;td style="vertical-align: top; width: 70px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 5px; line-height: 15px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;令和２年６月&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 218px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 15px; line-height: 15px; text-align: justify; text-justify: inter-ideograph"&gt;
&lt;span style="font-size: 10px"&gt;当社取締役常務執行役員&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 15px"&gt;
&lt;td style="vertical-align: top; width: 70px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 16px; line-height: 15px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;同６年６月&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 218px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 15px; line-height: 15px; text-align: justify; text-justify: inter-ideograph"&gt;
&lt;span style="font-size: 10px"&gt;近鉄グループホールディングス㈱監査役&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 15px; line-height: 15px; text-align: justify; text-justify: inter-ideograph"&gt;
&lt;span style="font-size: 10px"&gt;（常勤）（現在）&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 15px"&gt;
&lt;td style="vertical-align: top; width: 70px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 16px; line-height: 15px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;同６年６月&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 218px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 15px; line-height: 15px; text-align: justify; text-justify: inter-ideograph"&gt;
&lt;span style="font-size: 10px"&gt;当社監査役（現在）&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
