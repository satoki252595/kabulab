&lt;tr style="height:30pt;min-height:30pt;"&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:4.5pt;padding-right:4.5pt;margin-top:0pt;margin-bottom:0pt;"&gt;&lt;span style="font-size:7.5pt;"&gt;人手確保の観点から福利厚生目的の社宅の利用が増加。当社のアウトソーシングサービスの利用も拡大&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
