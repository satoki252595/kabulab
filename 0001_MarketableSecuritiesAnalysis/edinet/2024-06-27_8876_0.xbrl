&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:212pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
&lt;col style="width:53pt;min-width:53pt;"/&gt;
&lt;col style="width:159pt;min-width:159pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:10.5pt;min-height:10.5pt;"&gt;
