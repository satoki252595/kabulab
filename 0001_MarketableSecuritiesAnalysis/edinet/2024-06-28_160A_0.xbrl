&lt;p style="margin-left: 36px; text-align: left"&gt;ショートステイ&lt;/p&gt;
&lt;div style="margin-left: 36px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 612px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 228px"/&gt;
&lt;col style="width: 192px"/&gt;
&lt;col style="width: 192px"/&gt;
