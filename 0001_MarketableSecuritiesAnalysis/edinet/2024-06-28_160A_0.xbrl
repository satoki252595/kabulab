&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 536.66666666666666666666666667px; padding-top: 9.333333333333333333333333333px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
