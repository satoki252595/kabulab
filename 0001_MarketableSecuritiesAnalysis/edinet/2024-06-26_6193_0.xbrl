  <jpcrp_cor:InformationForEachProductOrServiceTextBlock contextRef="Prior1YearDuration">
&lt;p style="margin-left: 44px; line-height: 18px; margin-right: 0px; text-align: left"&gt;１．製品及びサービスごとの情報&lt;/p&gt;
&lt;p style="margin-left: 56px; line-height: 18px; margin-right: 0px; text-align: left"&gt;　セグメント情報に同様の情報を開示しているため、記載を省略しております。&lt;/p&gt;
</jpcrp_cor:InformationForEachProductOrServiceTextBlock>
  <jpcrp_cor:RevenuesFromExternalCustomersInformationForEachRegionTextBlock contextRef="Prior1YearDuration">
&lt;p style="margin-left: 56px; line-height: 18px; margin-right: 0px; text-align: left"&gt;(1）売上高&lt;/p&gt;
