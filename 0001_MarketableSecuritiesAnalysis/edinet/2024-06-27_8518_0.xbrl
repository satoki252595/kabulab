&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 151.73333333333333333333333333px; vertical-align: bottom; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
