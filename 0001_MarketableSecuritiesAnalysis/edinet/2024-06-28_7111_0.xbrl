  <jpigp_cor:NotesFinanceIncomeAndFinanceCostsConsolidatedFinancialStatementsIFRSTextBlock contextRef="CurrentYearDuration">&lt;p style="page-break-before:always; line-height:0.75pt; width:100%; font-size:0.75pt;"&gt; &lt;/p&gt;&lt;p class="smt_head3" style="orphans:0;widows:0;padding-left:0pt;"&gt;24．金融収益及び金融費用&lt;/p&gt;&lt;p class="smt_text2" style="orphans:0;widows:0;padding-left:9pt;"&gt;&lt;span style="font-family:&amp;apos;ＭＳ 明朝&amp;apos;;font-size:9pt;"&gt;金融収益及び金融費用の内訳は、以下のとおりであります。&lt;/span&gt;&lt;/p&gt;
&lt;div class="tbld" style="margin-left:0pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:478.5pt;table-layout:fixed;"&gt;
