&lt;col style="width:99.8pt;min-width:99.8pt;"/&gt;
&lt;col style="width:92.3pt;min-width:92.3pt;"/&gt;
&lt;col style="width:92.3pt;min-width:92.3pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:17.9pt;min-height:17.9pt;"&gt;
&lt;td colspan="5" style="vertical-align:middle;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:15pt;padding-right:0pt;text-justify:inter-ideograph;text-indent:9pt;line-height:11pt;"&gt;&lt;span style="font-size:9pt;"&gt;月間平均稼働時間／年間平均有給消化率&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
