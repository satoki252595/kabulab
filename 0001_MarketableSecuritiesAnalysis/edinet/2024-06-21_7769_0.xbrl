  <jpcrp_cor:NotesRegardingDividendTextBlock contextRef="Prior1YearDuration">&lt;p class="smt_text2" style="orphans:0;widows:0;"&gt;３  配当に関する事項&lt;/p&gt;&lt;p class="smt_text3" style="orphans:0;widows:0;"&gt;(1) 配当金支払額&lt;/p&gt;
