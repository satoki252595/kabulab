&lt;p style="margin-right: 12px; text-align: right"&gt;3,925&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 83.53333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
