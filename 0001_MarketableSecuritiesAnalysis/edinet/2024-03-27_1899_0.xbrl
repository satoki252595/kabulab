&lt;img alt="0102010_005.png" src="images/0102010_005.png" style="height: 314px; width: 461px"/&gt;
&lt;/p&gt;
&lt;p style="text-align: left"&gt; &lt;/p&gt;
&lt;p style="text-align: left"&gt; &lt;/p&gt;
&lt;p style="line-height: 1; text-align: center"&gt;
&lt;img alt="0102010_006.png" src="images/0102010_006.png" style="height: 271.79px; width: 473.77px"/&gt;
&lt;/p&gt;
&lt;p style="line-height: 1; text-align: left"&gt; &lt;/p&gt;
&lt;p style="text-align: left"&gt; &lt;/p&gt;
&lt;p style="line-height: 1; text-align: center"&gt;
&lt;img alt="0102010_007.png" src="images/0102010_007.png" style="height: 325.4px; width: 473.73px"/&gt;
&lt;/p&gt;
