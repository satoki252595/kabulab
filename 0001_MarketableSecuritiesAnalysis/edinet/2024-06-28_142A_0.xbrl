&lt;/thead&gt;
&lt;tbody&gt;
&lt;tr style="height: 36px"&gt;
&lt;td style="vertical-align: middle; width: 127.46666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt;2020年３月30日&lt;/p&gt;
&lt;p style="text-align: center"&gt;（注）１&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 96px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 12px; text-align: right"&gt;Ａ種優先株式&lt;/p&gt;
&lt;p style="margin-right: 12px; text-align: right"&gt;1,800&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 88.53333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 12px; text-align: right"&gt;普通株式&lt;/p&gt;
&lt;p style="margin-right: 12px; text-align: right"&gt;10,000&lt;/p&gt;
&lt;p style="margin-right: 12px; text-align: right"&gt;Ａ種優先株式&lt;/p&gt;
&lt;p style="margin-right: 12px; text-align: right"&gt;1,800&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 84px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
