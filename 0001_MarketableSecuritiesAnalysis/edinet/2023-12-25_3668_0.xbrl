  <jpcrp030000-asr_E27062-000:ReferenceToOtherInformationMetricsAndTargets contextRef="FilingDateInstant">当社ウェブサイト（https://colopl.co.jp/sustainability/environment/）</jpcrp030000-asr_E27062-000:ReferenceToOtherInformationMetricsAndTargets>
  <jpcrp030000-asr_E27062-000:PolicyOnHumanResourceDevelopmentAndImprovementOfInternalEnvironmentStrategyTextBlock contextRef="FilingDateInstant">
