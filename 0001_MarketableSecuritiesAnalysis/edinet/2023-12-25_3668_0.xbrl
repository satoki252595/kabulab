&lt;p style="margin-left: 36px; text-align: left; text-indent: -12px"&gt; &lt;/p&gt;
</jpcrp030000-asr_E27062-000:DisclosureOfSustainabilityRelatedFinancialInformationTextBlock>
  <jpcrp030000-asr_E27062-000:GovernanceTextBlock contextRef="FilingDateInstant">
