</jpcrp_cor:DividendPolicyTextBlock>
  <jpcrp_cor:DateOfResolutionDividendsOfSurplus contextRef="FilingDateInstant_Row1Member">2023-02-10</jpcrp_cor:DateOfResolutionDividendsOfSurplus>
