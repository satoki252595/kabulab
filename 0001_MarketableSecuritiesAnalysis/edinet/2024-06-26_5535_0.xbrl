&lt;p style="line-height: 13.333333333333333333333333333px; margin-right: 6px; text-align: right"&gt;40,130,493&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 110.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
