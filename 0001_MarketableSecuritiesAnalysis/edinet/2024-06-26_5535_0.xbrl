&lt;/tr&gt;
&lt;tr style="height: 25px"&gt;
&lt;td style="vertical-align: middle; width: 224px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; line-height: 14px; margin-right: 21px; text-align: left"&gt;外部顧客への売上高&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 110.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; margin-right: 6px; text-align: right"&gt;2,541,582&lt;/p&gt;
