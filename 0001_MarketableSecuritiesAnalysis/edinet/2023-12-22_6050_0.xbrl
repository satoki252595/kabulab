&lt;tr style="height: 1.33px"&gt;
&lt;td colspan="2" style="vertical-align: top; width: 370.4px; padding-top: 0px; padding-bottom: 0px; padding-left: 3.8px; padding-right: 3.8px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: left"&gt;石原　徹哉&lt;/p&gt;
