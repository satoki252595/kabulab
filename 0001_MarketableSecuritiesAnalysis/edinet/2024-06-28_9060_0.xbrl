  <jpcrp_cor:NotesRegardingImpairmentLossTextBlock contextRef="CurrentYearDuration_NonConsolidatedMember">
&lt;p style="margin-left: 17.333333333333333333333333333px; line-height: 21px; text-align: left"&gt;
&lt;span style="font-size: 14px"&gt;※５．減損損失&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 18px; line-height: 21px; text-align: left"&gt;
&lt;span style="font-size: 14px"&gt;前事業年度（自　2022年４月１日　至　2023年３月31日）&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 18px; line-height: 21px; text-align: left"&gt;（1&lt;span style="font-size: 14px"&gt;）減損損失を認識した資産または資産グループの概要&lt;/span&gt;&lt;/p&gt;
&lt;div style="margin-left: 42px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 600px"&gt;
