  <jpcrp_cor:NotesRegardingPromissoryNotesDueOnBalanceSheetDateTextBlock contextRef="CurrentYearInstant">
&lt;p style="margin-left: 28px; line-height: 1; margin-right: 14px; text-align: left; text-indent: -21px"&gt;
&lt;span style="font-size: 14px"&gt;※７．連結会計年度末日満期手形&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 8px; line-height: 1; margin-right: 3.4px; text-align: left; text-indent: 16px"&gt;
