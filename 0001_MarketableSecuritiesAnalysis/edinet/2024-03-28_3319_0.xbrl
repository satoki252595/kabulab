  <jpcrp_cor:ClassIssuedSharesTotalNumberOfSharesEtc contextRef="FilingDateInstant_ClassAPreferredSharesMember">Ａ種優先株式</jpcrp_cor:ClassIssuedSharesTotalNumberOfSharesEtc>
