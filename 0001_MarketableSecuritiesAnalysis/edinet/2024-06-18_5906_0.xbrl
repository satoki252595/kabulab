&lt;td style="vertical-align: middle; width: 206.66666666666666666666666667px; padding-top: 1px; padding-bottom: 0px; padding-left: 1px; padding-right: 1px; border-left: 0px none ; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: left"&gt;・省エネルギー活動の推進&lt;br/&gt;・代替エネルギーへの転換&lt;br/&gt;・製品VEの推進&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 23.47px"&gt;
&lt;td style="vertical-align: middle; width: 244.6px; padding-top: 1px; padding-bottom: 0px; padding-left: 1px; padding-right: 1px; border-left: 0px none ; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
