&lt;td style="vertical-align: middle; width: 107.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 4px; margin-right: 4px; text-align: center"&gt;ライフ＆サポート事業用資産&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 150px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 24px; margin-right: 12px; text-align: center; text-indent: -12px"&gt;長野県千曲市&lt;/p&gt;
&lt;p style="margin-left: 24px; margin-right: 12px; text-align: center; text-indent: -12px"&gt;長野県埴科郡坂城町&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 156.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
