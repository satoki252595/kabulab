&lt;col style="width:52pt;min-width:52pt;"/&gt;
&lt;col style="width:49.5pt;min-width:49.5pt;"/&gt;
&lt;col style="width:52pt;min-width:52pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:22.5pt;min-height:22.5pt;"&gt;
