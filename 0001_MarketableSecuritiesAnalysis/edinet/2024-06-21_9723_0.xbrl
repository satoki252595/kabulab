&lt;/td&gt;
&lt;td style="vertical-align:bottom;border-bottom-style:solid;border-bottom-width:0.75pt;overflow:hidden;" valign="bottom"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:right;padding-left:4.9pt;padding-right:4.9pt;margin-bottom:0pt;line-height:14pt;font-size:9pt;"&gt;(単位：千円)&lt;/p&gt;
