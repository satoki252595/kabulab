&lt;p style="margin-left: 6px; margin-right: 2px; text-align: left; line-height: 13.066666666666666666666666667px"&gt;
&lt;span style="font-size: 12px"&gt; &lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
