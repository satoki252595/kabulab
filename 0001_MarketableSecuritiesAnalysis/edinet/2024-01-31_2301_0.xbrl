&lt;p style="margin-left: 60px; text-align: left"&gt;
&lt;span style="font-size: 12px"&gt; &lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 160px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt;前事業年度&lt;/p&gt;
&lt;p style="margin-right: 12px; text-align: center"&gt;（自　2021年11月１日&lt;/p&gt;
&lt;p style="margin-left: 12px; text-align: center"&gt;至　2022年10月31日）&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 160px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt;当事業年度&lt;/p&gt;
&lt;p style="margin-right: 12px; text-align: center"&gt;（自　2022年11月１日&lt;/p&gt;
&lt;p style="margin-left: 12px; text-align: center"&gt;至　2023年10月31日）&lt;/p&gt;
&lt;/td&gt;
