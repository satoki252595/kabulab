  <jpcrp_cor:NotesRegardingDividendTextBlock contextRef="Prior1YearDuration">
&lt;p style="text-align: left"&gt; &lt;/p&gt;
&lt;p style="margin-left: 48px; line-height: 14.666666666666666666666666667px; text-align: left"&gt;２．配当に関する事項&lt;/p&gt;
&lt;p style="margin-left: 48px; text-align: left"&gt;（１）配当金支払額&lt;/p&gt;
&lt;div style="margin-left: 6px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 642px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 105.46666666666666666666666667px"/&gt;
&lt;col style="width: 112px"/&gt;
&lt;col style="width: 69.533333333333333333333333333px"/&gt;
&lt;col style="width: 78px"/&gt;
&lt;col style="width: 108px"/&gt;
&lt;col style="width: 108px"/&gt;
&lt;col style="width: 61px"/&gt;
&lt;/colgroup&gt;
&lt;thead&gt;
&lt;tr style="height: 45.33px"&gt;
&lt;td style="vertical-align: middle; width: 105.46666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; line-height: 13.333333333333333333333333333px; text-align: center"&gt;（決　議）&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 112px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;株式の種類&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 69.533333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;配当金の総額&lt;br/&gt;（百万円）&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 78px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;１株当たり&lt;br/&gt;配当額&lt;br/&gt;（円）&lt;/p&gt;
