&lt;span style="font-size: 10px"&gt;（－）&lt;/span&gt;
&lt;/p&gt;
&lt;p style="line-height: 15px; margin-right: 5px; text-align: right"&gt;
&lt;span style="font-size: 10px"&gt;〈26〉&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 52px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 15px; margin-right: 10px; text-align: right"&gt;
&lt;span style="font-size: 10px"&gt;131&lt;/span&gt;
&lt;/p&gt;
&lt;p style="line-height: 15px; margin-right: 10px; text-align: right"&gt; &lt;/p&gt;
&lt;p style="line-height: 15px; margin-right: 10px; text-align: right"&gt; &lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 52px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 15px; margin-right: 10px; text-align: right"&gt;
&lt;span style="font-size: 10px"&gt;1,599&lt;/span&gt;
