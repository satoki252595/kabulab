&lt;tr style="height:11pt;min-height:11pt;"&gt;
&lt;td style="vertical-align:top;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;letter-spacing:0pt;"&gt;1953年 9月&lt;/p&gt;
&lt;/td&gt;
