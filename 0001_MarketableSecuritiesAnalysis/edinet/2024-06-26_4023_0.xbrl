&lt;col style="width:5pt;min-width:5pt;"/&gt;
&lt;col style="width:41pt;min-width:41pt;"/&gt;
&lt;col style="width:5pt;min-width:5pt;"/&gt;
&lt;col style="width:48.8pt;min-width:48.8pt;"/&gt;
