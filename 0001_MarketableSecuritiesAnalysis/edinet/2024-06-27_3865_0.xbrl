&lt;col style="width:40.5pt;min-width:40.5pt;"/&gt;
&lt;col style="width:37.5pt;min-width:37.5pt;"/&gt;
&lt;col style="width:37.5pt;min-width:37.5pt;"/&gt;
&lt;col style="width:40.5pt;min-width:40.5pt;"/&gt;
