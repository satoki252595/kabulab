&lt;col style="width:110pt;min-width:110pt;"/&gt;
&lt;col style="width:73.5pt;min-width:73.5pt;"/&gt;
&lt;col style="width:269.3pt;min-width:269.3pt;"/&gt;
&lt;/colgroup&gt;
