</jpcrp030000-asr_E05716-000:MetricsAndTargetsTextBlock>
  <jpcrp030000-asr_E05716-000:DescriptionOfMetricsRelatedToPolicyOnHumanResourceDevelopmentAndImprovementOfInternalEnvironmentAndTargetsAndResultsUsingSuchMetricsMetricsAndTargetsTextBlock contextRef="FilingDateInstant">
