&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 575.99999999999999999999999999px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 127.2px"/&gt;
&lt;col style="width: 33.333333333333333333333333333px"/&gt;
&lt;col style="width: 111.13333333333333333333333333px"/&gt;
&lt;col style="width: 33.333333333333333333333333333px"/&gt;
&lt;col style="width: 271px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr style="height: 31.33px"&gt;
&lt;td rowspan="2" style="vertical-align: middle; width: 127.2px; padding-top: 0px; padding-bottom: 0px; padding-left: 6.6px; padding-right: 6.6px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 16px; text-align: justify; text-justify: inter-ideograph"&gt;調整後行使価額&lt;/p&gt;
&lt;/td&gt;
&lt;td rowspan="2" style="vertical-align: middle; width: 33.333333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 6.6px; padding-right: 6.6px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 16px; text-align: justify; text-justify: inter-ideograph"&gt;＝&lt;/p&gt;
