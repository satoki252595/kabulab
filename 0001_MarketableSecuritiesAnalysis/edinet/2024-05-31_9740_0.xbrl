&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;text-align:right;padding-right:34pt;"&gt;&lt;span style="font-size:9pt;"&gt;81,433&lt;/span&gt;&lt;span style="font-size:9pt;"&gt;千円&lt;/span&gt;&lt;/p&gt;
