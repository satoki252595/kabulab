&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;line-height:9pt;"&gt;当連結会計年度&lt;/p&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;padding-left:0pt;padding-right:4.6pt;line-height:9pt;"&gt;&lt;span style="font-size:9pt;"&gt;（自　&lt;/span&gt;&lt;span&gt;&lt;span style="font-size:9pt;"&gt;2023年３月１日&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;padding-left:4.6pt;line-height:9pt;"&gt;&lt;span style="font-size:9pt;"&gt;　至　&lt;/span&gt;&lt;span&gt;&lt;span style="font-size:9pt;"&gt;2024年２月29日&lt;/span&gt;&lt;/span&gt;）&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:10.5pt;min-height:10.5pt;"&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:right;padding-left:0pt;padding-right:65pt;margin-top:0pt;margin-bottom:0pt;"&gt; &lt;/p&gt;
&lt;/td&gt;
