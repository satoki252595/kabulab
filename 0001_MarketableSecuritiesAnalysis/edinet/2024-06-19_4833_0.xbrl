&lt;h5 class="smt_head4"&gt;② 【自己株式等】&lt;/h5&gt;&lt;p class="smt_text3" style="orphans:0;widows:0;padding-left:27pt;text-indent:0pt;"&gt;該当事項はありません。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;line-height:10pt;"&gt;　&lt;/p&gt;</jpcrp_cor:TreasurySharesEtcTextBlock>
  <jpcrp_cor:ClassesOfSharesEtcTextBlock contextRef="FilingDateInstant">
