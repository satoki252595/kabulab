&lt;p style="margin-left: 65px; line-height: 17.333333333333333333333333333px; margin-right: 5px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;1969年４月　吉井電器店入社&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 17.333333333333333333333333333px; margin-right: 5px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;1973年１月　当社入社&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 17.333333333333333333333333333px; margin-right: 5px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;1977年４月　資材課長&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 17.333333333333333333333333333px; margin-right: 5px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;1983年３月　取締役就任&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 17.333333333333333333333333333px; margin-right: 5px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;1987年２月　常務取締役就任&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 17.333333333333333333333333333px; margin-right: 5px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;1992年２月　専務取締役就任&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 17.333333333333333333333333333px; margin-right: 5px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;1998年10月　代表取締役専務就任&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 17.333333333333333333333333333px; margin-right: 5px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;1999年６月　代表取締役社長就任&lt;/span&gt;
&lt;/p&gt;
