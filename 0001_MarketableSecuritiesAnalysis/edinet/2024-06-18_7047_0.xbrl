&lt;col style="width:50.6pt;min-width:50.6pt;"/&gt;
&lt;col style="width:19pt;min-width:19pt;"/&gt;
&lt;col style="width:40.6pt;min-width:40.6pt;"/&gt;
&lt;col style="width:15.5pt;min-width:15.5pt;"/&gt;
&lt;col style="width:62.5pt;min-width:62.5pt;"/&gt;
&lt;col style="width:14.2pt;min-width:14.2pt;"/&gt;
&lt;col style="width:74.2pt;min-width:74.2pt;"/&gt;
