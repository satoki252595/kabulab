  <jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E34321-000KazumiTomoyoMember">鹿住　倫世</jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E34321-000KazumiTomoyoMember">1963-09-22</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock contextRef="FilingDateInstant_jpcrp030000-asr_E34321-000KazumiTomoyoMember">
&lt;p style="margin-left: 65px; line-height: 15.333333333333333333333333333px; margin-right: 5px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;1986年４月　中小企業事業団（現独立行政法人中小企業基盤整備機構）入職&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 15.333333333333333333333333333px; margin-right: 5px; text-align: left; text-indent: -60px"&gt;
