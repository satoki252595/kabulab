</jpcrp_cor:NotesRegardingPromissoryNotesDueOnBalanceSheetDateTextBlock>
  <jpcrp_cor:NotesRegardingAssetsAndLiabilitiesIncurredFromTransactionsWithAffiliatedEntitiesTextBlock contextRef="CurrentYearInstant_NonConsolidatedMember">
&lt;p style="margin-left: 84px; text-align: left; text-indent: -24px"&gt;※２　関係会社に対する金銭債権及び金銭債務（区分表示されたものを除く）&lt;/p&gt;
&lt;div style="margin-left: 48px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 600px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 200px"/&gt;
&lt;col style="width: 200px"/&gt;
