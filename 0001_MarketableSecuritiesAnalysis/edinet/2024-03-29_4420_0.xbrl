&lt;p style="margin-left: 5px; line-height: 16px; margin-right: 5px; text-align: center"&gt;イーソル株式会社&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 111.06666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
