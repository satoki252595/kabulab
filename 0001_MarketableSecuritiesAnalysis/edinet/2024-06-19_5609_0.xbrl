&lt;td style="vertical-align: top; width: 324px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 72px; margin-right: 3.3333333333333333333333333333px; text-align: justify; text-justify: inter-ideograph; text-indent: -36px"&gt;※５　同左&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;/div&gt;
</jpcrp_cor:DetailedScheduleOfManufacturingCostTextBlock>
