&lt;col style="width:174.4pt;min-width:174.4pt;"/&gt;
&lt;col style="width:174.4pt;min-width:174.4pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:22.7pt;min-height:22.7pt;"&gt;
