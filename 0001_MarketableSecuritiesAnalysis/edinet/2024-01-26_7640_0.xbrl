&lt;col style="width:142.5pt;min-width:142.5pt;"/&gt;
&lt;col style="width:127.5pt;min-width:127.5pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:16.5pt;min-height:16.5pt;"&gt;
