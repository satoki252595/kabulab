  <jpcrp_cor:InformationForEachProductOrServiceTextBlock contextRef="Prior1YearDuration_NonConsolidatedMember">&lt;p class="smt_text6" style="orphans:0;widows:0;"&gt;１．製品及びサービスごとの情報&lt;/p&gt;&lt;p class="smt_text2" style="orphans:0;widows:0;"&gt;セグメント情報に同様の情報を開示しているため、記載を省略しております。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;line-height:10pt;font-size:10pt;"&gt; &lt;/p&gt;</jpcrp_cor:InformationForEachProductOrServiceTextBlock>
