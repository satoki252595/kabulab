  <jpcrp_cor:NotesRegardingNewShareSubscriptionRightsEtcTextBlock contextRef="Prior1YearDuration">
&lt;p style="margin-left: 48px; line-height: 16px; text-align: left"&gt;２．新株予約権及び自己新株予約権に関する事項&lt;/p&gt;
&lt;p style="margin-left: 72px; line-height: 14px; margin-bottom: 2px; text-align: left"&gt;該当事項はありません。&lt;/p&gt;
</jpcrp_cor:NotesRegardingNewShareSubscriptionRightsEtcTextBlock>
  <jpcrp_cor:NotesRegardingDividendTextBlock contextRef="Prior1YearDuration">
&lt;p style="margin-left: 48px; line-height: 16px; text-align: left"&gt;３．配当に関する事項&lt;/p&gt;
&lt;p style="margin-left: 48px; text-align: left"&gt;（１）配当金支払額&lt;/p&gt;
&lt;p style="margin-left: 60px; text-align: left"&gt;　該当事項はありません。&lt;/p&gt;
&lt;p style="margin-left: 60px; text-align: left"&gt; &lt;/p&gt;
