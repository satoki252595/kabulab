&lt;/td&gt;
&lt;td style="vertical-align:top;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:0pt;padding-right:0pt;line-height:14pt;"&gt;&lt;span style="font-size:9pt;"&gt;東海造機株式会社を東海技術サービス株式会社へ社名変更&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
