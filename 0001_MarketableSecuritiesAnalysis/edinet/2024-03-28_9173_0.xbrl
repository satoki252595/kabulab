&lt;tr style="height:25.5pt;min-height:25.5pt;"&gt;
&lt;td style="vertical-align:top;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:19.9pt;padding-right:0pt;line-height:14pt;"&gt;&lt;span style="font-size:9pt;"&gt;2002年４月&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:top;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:0pt;padding-right:0pt;line-height:14pt;"&gt;&lt;span style="font-size:9pt;"&gt;高速船ジェットフォイル３隻(セブンアイランド「愛」「虹」「夢」)就航。東京～大島～神津島航路の所要時間が大幅に短縮&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
