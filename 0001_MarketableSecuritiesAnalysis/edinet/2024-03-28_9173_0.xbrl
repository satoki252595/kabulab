&lt;/td&gt;
&lt;td style="vertical-align:top;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:0pt;padding-right:0pt;line-height:14pt;"&gt;&lt;span style="font-size:9pt;"&gt;港区海岸(竹芝)に本社を移転&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:11pt;min-height:11pt;"&gt;
&lt;td style="vertical-align:top;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:19.9pt;padding-right:0pt;line-height:14pt;"&gt;&lt;span style="font-size:9pt;"&gt;1974年７月&lt;/span&gt;&lt;/p&gt;
