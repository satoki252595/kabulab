  <jpigp_cor:NotesApprovalOfConsolidatedFinancialStatementsIFRSTextBlock contextRef="CurrentYearDuration">&lt;p class="smt_head6" style="orphans:0;widows:0;font-family:&amp;apos;ＭＳ ゴシック&amp;apos;;"&gt;&lt;span style="font-family:&amp;apos;ＭＳ ゴシック&amp;apos;;"&gt;35．連結財務諸表の承認&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_text2" style="orphans:0;widows:0;font-family:&amp;apos;ＭＳ ゴシック&amp;apos;;"&gt;&lt;span style="font-family:&amp;apos;ＭＳ ゴシック&amp;apos;;"&gt;当社グループの連結財務諸表は、2024年３月８日に開催の取締役会により承認されております。&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:0pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:0pt;font-family:&amp;apos;ＭＳ ゴシック&amp;apos;;letter-spacing:0pt;line-height:15pt;font-size:15pt;"&gt; &lt;/p&gt;</jpigp_cor:NotesApprovalOfConsolidatedFinancialStatementsIFRSTextBlock>
