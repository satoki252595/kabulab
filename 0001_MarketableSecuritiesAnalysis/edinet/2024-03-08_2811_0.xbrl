  <jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock contextRef="FilingDateInstant_jpcrp030000-asr_E00444-000HashimotoTakashiMember">
&lt;div class="tbld" style="margin-left:0pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
