&lt;col style="width: 200px"/&gt;
&lt;/colgroup&gt;
&lt;thead&gt;
&lt;tr style="height: 53px"&gt;
&lt;td style="vertical-align: middle; width: 249px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: left"&gt;
&lt;span style="font-size: 12px"&gt; &lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 200px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;前連結会計年度&lt;/p&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; margin-right: 6px; text-align: center"&gt;(自　2022年４月１日&lt;/p&gt;
&lt;p style="margin-left: 6px; line-height: 13.333333333333333333333333333px; text-align: center"&gt;至　2023年３月31日)&lt;/p&gt;
