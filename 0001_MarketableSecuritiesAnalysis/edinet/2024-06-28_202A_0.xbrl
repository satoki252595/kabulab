&lt;p style="margin-left: 6px; margin-right: 4px; text-align: left"&gt;豆蔵K2TOPホールディングス&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 124px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-right: 6px; text-align: right"&gt;19,389,534千円&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 124px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-right: 6px; text-align: right"&gt;－千円&lt;/p&gt;
