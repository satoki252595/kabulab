&lt;/tr&gt;
&lt;tr style="height: 22.07px"&gt;
&lt;td style="vertical-align: middle; width: 193.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center"&gt;監　査　役（社外）&lt;/p&gt;
