&lt;div style="text-align:center;"&gt;&lt;img alt="" height="279" src="fuzoku/zinzaipolicy2.png" width="610"/&gt;&lt;br/&gt;
&lt;/div&gt;</jpcrp_cor:PolicyOnDevelopmentOfHumanResourcesAndInternalEnvironmentStrategyTextBlock>
  <jpcrp_cor:DescriptionOfMetricsRelatedToPolicyOnDevelopmentOfHumanResourcesAndInternalEnvironmentAndTargetsAndPerformanceUsingSuchMetricsMetricsAndTargetsTextBlock contextRef="FilingDateInstant">&lt;p style="page-break-before:always; line-height:0.75pt; width:100%; font-size:0.75pt;"&gt; &lt;/p&gt;&lt;p class="smt_text3" style="orphans:0;widows:0;text-align:justify;padding-left:0pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:9pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;font-size:9pt;"&gt;③　指標及び目標&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:8pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:9pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;font-size:9pt;"&gt;上記「②戦略」に関する主な指標及び目標は以下のとおりであります。&lt;/p&gt;
&lt;div class="tbld" style="margin-left:2.5pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:474.8pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
&lt;col style="width:55.5pt;min-width:55.5pt;"/&gt;
&lt;col style="width:119.3pt;min-width:119.3pt;"/&gt;
&lt;col style="width:75pt;min-width:75pt;"/&gt;
&lt;col style="width:75pt;min-width:75pt;"/&gt;
&lt;col style="width:75pt;min-width:75pt;"/&gt;
&lt;col style="width:75pt;min-width:75pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:22.5pt;min-height:22.5pt;"&gt;
