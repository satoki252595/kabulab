  <jpcrp_cor:NotesRegardingSubordinatedBondsPayableTextBlock contextRef="CurrentYearInstant_NonConsolidatedMember">&lt;p class="smt_text1" style="orphans:0;widows:0;text-align:justify;padding-left:0pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;"&gt;※２　社債は劣後特約付社債であります。&lt;/p&gt;&lt;p class="smt_text1" style="orphans:0;widows:0;text-align:justify;padding-left:0pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;font-size:15pt;"&gt; &lt;/p&gt;</jpcrp_cor:NotesRegardingSubordinatedBondsPayableTextBlock>
  <jpcrp_cor:NotesRegardingTransactionsWithAffiliatedEntitiesTextBlock contextRef="CurrentYearDuration_NonConsolidatedMember">&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:0pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;"&gt;※１　関係会社との取引高&lt;/p&gt;
&lt;div class="tbld" style="margin-left:27pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:441pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
&lt;col style="width:150pt;min-width:150pt;"/&gt;
&lt;col style="width:84.5pt;min-width:84.5pt;"/&gt;
&lt;col style="width:61pt;min-width:61pt;"/&gt;
