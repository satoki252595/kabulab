&lt;col style="width: 64px"/&gt;
&lt;col style="width: 24px"/&gt;
&lt;col style="width: 64px"/&gt;
&lt;col style="width: 24px"/&gt;
&lt;col style="width: 80px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr&gt;
&lt;td rowspan="2" style="border-left: 0px none #000000; border-top: 0px none #000000; border-right: 0px none #000000; border-bottom: 0px none #000000; width: 66.666666666666666666666666667px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
