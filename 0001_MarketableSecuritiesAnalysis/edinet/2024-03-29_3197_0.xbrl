&lt;/td&gt;
&lt;td style="vertical-align: top; width: 93.2px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 17.333333333333333333333333333px; text-align: right"&gt;△20.7 ％&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 1.33px"&gt;
&lt;td style="vertical-align: top; width: 266.8px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 17.333333333333333333333333333px; text-align: left"&gt;　その他&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 93.2px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 17.333333333333333333333333333px; text-align: right"&gt;△0.1 ％&lt;/p&gt;
