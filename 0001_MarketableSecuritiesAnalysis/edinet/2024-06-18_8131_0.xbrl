</jpcrp_cor:OfficialTitleOrPositionInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E01074-000TajimaKeiMember">田嶋　圭</jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E01074-000TajimaKeiMember">1973-05-16</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock contextRef="FilingDateInstant_jpcrp030000-asr_E01074-000TajimaKeiMember">
&lt;p style="margin-left: 60px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;1996年４月 三井生命保険相互会社（現 大樹生命保険㈱）入社&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;2000年３月 三鱗印刷㈱入社（現㈱オルゴヴェーレ）&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;2007年12月 同社代表取締役社長（現任）&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;2017年５月 三鱗事業㈱社外取締役（現任）&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;2021年６月 当社社外取締役（監査等委員）　（現任）&lt;/span&gt;
&lt;/p&gt;
</jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock>
