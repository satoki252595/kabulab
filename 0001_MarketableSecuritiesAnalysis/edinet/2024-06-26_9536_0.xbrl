&lt;p style="text-align: center"&gt;加藤  卓二&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 149.53333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
