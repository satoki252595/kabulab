&lt;col style="width:117.8pt;min-width:117.8pt;"/&gt;
&lt;col style="width:129pt;min-width:129pt;"/&gt;
&lt;col style="width:234.8pt;min-width:234.8pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:20pt;min-height:20pt;"&gt;
