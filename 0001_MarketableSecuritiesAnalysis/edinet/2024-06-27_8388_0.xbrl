&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;line-height:12pt;"&gt;前連結&lt;br/&gt;会計年度比&lt;br/&gt;(百万円)&lt;br/&gt;(Ｂ)－(Ａ)&lt;/p&gt;
&lt;/td&gt;
