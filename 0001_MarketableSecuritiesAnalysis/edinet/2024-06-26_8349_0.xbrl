&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td style="vertical-align: middle; width: 153.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 18px; margin-right: 3.3333333333333333333333333333px; text-align: left"&gt;うち契約残存期間が&lt;/p&gt;
&lt;p style="margin-left: 18px; margin-right: 3.3333333333333333333333333333px; text-align: left"&gt;１年以内のもの&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 197.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
