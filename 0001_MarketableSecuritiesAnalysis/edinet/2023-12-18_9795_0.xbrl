  <jpcrp_cor:NotesRegardingDividendTextBlock contextRef="Prior1YearDuration_NonConsolidatedMember">&lt;p class="smt_head6" style="orphans:0;widows:0;"&gt;３　配当に関する事項&lt;/p&gt;
