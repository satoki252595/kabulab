  <jpcrp_cor:InformationAboutOfficersTextBlock contextRef="FilingDateInstant">&lt;p style="page-break-before:always; line-height:0.75pt; width:100%; font-size:0.75pt;"&gt; &lt;/p&gt;
&lt;h3 class="smt_head2" style="line-height:13pt;"&gt;(2) 【役員の状況】&lt;/h3&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:9pt;line-height:12pt;"&gt;① 役員一覧&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:0pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:12pt;font-size:9pt;"&gt;男性9名　女性1名　（役員のうち女性の比率10％）&lt;/p&gt;
&lt;div class="tbld" style="margin-left:0pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
