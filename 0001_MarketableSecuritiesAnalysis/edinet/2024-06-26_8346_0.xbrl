  <jpcrp_cor:NameOfSecuritiesInvestmentEquitySecuritiesReclassifiedFromHeldForPurposesOtherThanPureInvestmentToHeldForPureInvestmentReportingCompany contextRef="CurrentYearInstant_Row3Member">株式会社秋田銀行</jpcrp_cor:NameOfSecuritiesInvestmentEquitySecuritiesReclassifiedFromHeldForPurposesOtherThanPureInvestmentToHeldForPureInvestmentReportingCompany>
