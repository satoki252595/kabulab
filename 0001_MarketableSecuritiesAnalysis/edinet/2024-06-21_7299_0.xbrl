&lt;/td&gt;
&lt;td style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;text-align:justify;padding-left:0pt;padding-right:0pt;margin-top:1.5pt;margin-bottom:1.5pt;text-justify:inter-ideograph;text-indent:0pt;letter-spacing:0pt;line-height:11pt;font-size:9.0pt;"&gt;&lt;span style="font-size:9pt;"&gt;会社法第155条第３号および&lt;/span&gt;会社法第155条第７号による普通株式の取得&lt;/p&gt;
&lt;/td&gt;
