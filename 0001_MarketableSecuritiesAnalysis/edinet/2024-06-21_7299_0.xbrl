&lt;td style="vertical-align:top;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:5.6pt;padding-right:5.6pt;margin-top:1.5pt;margin-bottom:1.5pt;text-justify:inter-ideograph;text-indent:0pt;letter-spacing:0pt;line-height:11pt;"&gt;&lt;span style="font-size:7.5pt;"&gt;当社社外取締役監査等委員&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
