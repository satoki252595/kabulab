  <jpcrp_cor:FootnotesRegardingSegmentInformationTableTextBlock contextRef="CurrentYearDuration">&lt;p class="smt_annoNum1" style="orphans:0;widows:0;text-align:left;padding-left:54pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:-45pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;font-size:9pt;"&gt;（注）１．&lt;span style="font-family:&amp;apos;ＭＳ 明朝&amp;apos;;font-size:9pt;"&gt;セグメント資産およびセグメント負債の調整額は、全てセグメント間取引消去であります。&lt;/span&gt;&lt;/p&gt;</jpcrp_cor:FootnotesRegardingSegmentInformationTableTextBlock>
