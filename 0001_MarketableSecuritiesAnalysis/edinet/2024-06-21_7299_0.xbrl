  <jpcrp_cor:AcquisitionsByResolutionOfShareholdersMeetingTextBlock contextRef="FilingDateInstant">
&lt;h4 class="smt_head3"&gt;(1)【株主総会決議による取得の状況】&lt;/h4&gt;&lt;p class="smt_text3" style="orphans:0;widows:0;padding-left:17.8pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:8.9pt;letter-spacing:0pt;line-height:18.0pt;font-size:9.0pt;"&gt;該当事項はありません。&lt;/p&gt;&lt;p class="smt_text3" style="orphans:0;widows:0;padding-left:17.8pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:8.9pt;line-height:10pt;font-size:10pt;"&gt; &lt;/p&gt;</jpcrp_cor:AcquisitionsByResolutionOfShareholdersMeetingTextBlock>
  <jpcrp_cor:AcquisitionsByResolutionOfBoardOfDirectorsMeetingTextBlock contextRef="FilingDateInstant">
