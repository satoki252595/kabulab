&lt;tr&gt;
&lt;td style="vertical-align: middle; width: 142.8px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 19.333333333333333333333333333px; text-align: center"&gt;社外取締役&lt;/p&gt;
&lt;p style="line-height: 19.333333333333333333333333333px; text-align: center"&gt;（監査等委員）&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 142.53333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 19.333333333333333333333333333px; text-align: center"&gt;後藤　研了&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 143.93333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 19.333333333333333333333333333px; text-align: right"&gt;3回&lt;/p&gt;
