&lt;div class="tbld" style="margin-left:35pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:357pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
&lt;col style="width:242pt;min-width:242pt;"/&gt;
