&lt;tr style="height: 19px"&gt;
&lt;td style="vertical-align: top; width: 98px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 12px; margin-right: 12px; text-align: justify; text-justify: inter-ideograph"&gt;2024年１月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 549px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 12px; margin-right: 12px; text-align: justify; text-justify: inter-ideograph"&gt;一般社団法人日本経済団体連合会（経団連）に入会&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
