  <jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E04251-000OtaAkihiroMember">太田　晶宏</jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E04251-000OtaAkihiroMember">1967-09-26</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
