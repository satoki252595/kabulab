  <jpcrp_cor:ShareholdingByShareholderCategoryTextBlock contextRef="FilingDateInstant">&lt;p style="page-break-before:always; line-height:0.75pt; width:100%; font-size:0.75pt;"&gt; &lt;/p&gt;
&lt;h4 class="smt_head3" style="padding-left:13.5pt;"&gt;(5) 【所有者別状況】&lt;/h4&gt;&lt;p class="smt_unitR" style="orphans:0;widows:0;text-align:center;padding-left:368.3pt;line-height:10pt;"&gt;　　&lt;span&gt;2023年12月31日&lt;/span&gt;現在&lt;/p&gt;
&lt;div class="tbld" style="text-align:center;margin-left:0.1pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" class="align_center" style="border-collapse:collapse;border:solid 0pt #000000;width:468pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
