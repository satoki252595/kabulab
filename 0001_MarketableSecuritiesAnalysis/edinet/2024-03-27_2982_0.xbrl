&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-color:#A9A9A9;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;letter-spacing:0pt;line-height:13.5pt;"&gt;エー・ディー・ワークス株主クラブ発足&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:14pt;min-height:14pt;"&gt;
&lt;td style="vertical-align:middle;border-top-color:#A9A9A9;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-right:0pt;text-justify:inter-ideograph;text-indent:2.9pt;letter-spacing:0pt;line-height:13.5pt;"&gt;2017年９月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-color:#A9A9A9;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;letter-spacing:0pt;line-height:13.5pt;"&gt;初の自社開発オフィスビル『AD-O渋谷道玄坂』竣工&lt;/p&gt;
