&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#ffffff;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#ffffff;border-left-style:solid;border-left-width:0.75pt;border-left-color:#ffffff;border-right-style:solid;border-right-width:0.75pt;border-right-color:#ffffff;background-color:#c6d9f0;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:0pt;padding-right:0pt;line-height:11pt;"&gt;FY2022&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:0pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:11pt;font-size:9pt;"&gt;(2022年12月期)&lt;/p&gt;
&lt;/td&gt;
