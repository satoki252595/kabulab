&lt;td rowspan="2" style="vertical-align:bottom;border-top-style:solid;border-top-width:0.75pt;border-top-color:#ffffff;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#ffffff;border-left-style:solid;border-left-width:0.75pt;border-left-color:#ffffff;border-right-style:solid;border-right-width:0.75pt;border-right-color:#ffffff;background-color:#c6d9f0;overflow:hidden;" valign="bottom"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;margin-bottom:3pt;line-height:11pt;"&gt;連結&lt;/p&gt;
