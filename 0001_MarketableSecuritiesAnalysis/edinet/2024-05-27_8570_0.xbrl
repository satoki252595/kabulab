&lt;td style="vertical-align: middle; width: 80.86666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 5px; line-height: 15px; margin-right: 5px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;自己資金&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 5px; line-height: 15px; margin-right: 5px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;及び&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 5px; line-height: 15px; margin-right: 5px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;リース&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;/div&gt;
&lt;p style="text-align: left"&gt; &lt;/p&gt;
&lt;p style="margin-left: 24px; text-align: left"&gt;（2）売却&lt;/p&gt;
&lt;p style="margin-left: 24px; text-align: left"&gt;　　該当事項はありません。&lt;/p&gt;
&lt;p style="text-align: left"&gt; &lt;/p&gt;
</jpcrp_cor:PlannedAdditionsRetirementsEtcOfFacilitiesTextBlock>
