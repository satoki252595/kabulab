  <jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E00118-000TakagiToshiyukiMember">高 木 俊 之</jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors>
