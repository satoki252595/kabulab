&lt;/tr&gt;
&lt;tr style="height:27.8pt;min-height:27.8pt;"&gt;
&lt;td style="vertical-align:top;border-top-color:#a9a9a9;border-bottom-color:#a9a9a9;border-left-color:#a9a9a9;border-right-color:#a9a9a9;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;line-height:14pt;"&gt;1973年 6月&lt;/p&gt;
&lt;/td&gt;
