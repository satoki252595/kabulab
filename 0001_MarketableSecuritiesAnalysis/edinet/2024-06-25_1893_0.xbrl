&lt;col style="width:44.3pt;min-width:44.3pt;"/&gt;
&lt;col style="width:44.3pt;min-width:44.3pt;"/&gt;
&lt;col style="width:72.8pt;min-width:72.8pt;"/&gt;
&lt;col style="width:97.5pt;min-width:97.5pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:15pt;min-height:15pt;"&gt;
