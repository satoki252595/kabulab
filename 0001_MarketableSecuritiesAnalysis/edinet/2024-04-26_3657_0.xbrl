</jpcrp030000-asr_E25898-000:PolicyOnHumanResourceDevelopmentAndImprovementOfInternalEnvironmentStrategyTextBlock>
  <jpcrp030000-asr_E25898-000:RiskManagementTextBlock contextRef="FilingDateInstant">
