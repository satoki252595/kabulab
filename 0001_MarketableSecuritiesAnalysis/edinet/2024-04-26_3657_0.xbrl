&lt;p style="text-align: justify; text-justify: inter-ideograph"&gt; &lt;/p&gt;
</jpcrp030000-asr_E25898-000:GovernanceTextBlock>
  <jpcrp030000-asr_E25898-000:StrategyTextBlock contextRef="FilingDateInstant">
