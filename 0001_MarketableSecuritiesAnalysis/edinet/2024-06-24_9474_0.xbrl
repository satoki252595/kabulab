&lt;td style="vertical-align: top; width: 142px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 12px; text-align: left"&gt;2024年２月１日&lt;/p&gt;
&lt;p style="margin-left: 12px; text-align: left"&gt;関東財務局長に提出&lt;/p&gt;
&lt;p style="text-align: left"&gt; &lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td colspan="3" style="vertical-align: top; width: 471.99999999999999999999999999px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: left"&gt;(4) 臨時報告書&lt;/p&gt;
&lt;p style="margin-left: 24px; text-align: left"&gt;企業内容等の開示に関する内閣府令第19条第２項第９号の２&lt;/p&gt;
&lt;p style="margin-left: 24px; text-align: left"&gt;（株主総会における議決権行使の結果）に基づく臨時報告書であります。&lt;/p&gt;
&lt;p style="margin-left: 24px; text-align: left"&gt; &lt;/p&gt;
&lt;p style="margin-left: 24px; text-align: left"&gt;企業内容等の開示に関する内閣府令第19条第２項第９号の２&lt;/p&gt;
&lt;p style="margin-left: 24px; text-align: left"&gt;（株主総会における議決権行使の結果）に基づく臨時報告書であります。&lt;/p&gt;
&lt;p style="margin-left: 24px; text-align: left"&gt; &lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 142px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 12px; text-align: left"&gt; &lt;/p&gt;
&lt;p style="margin-left: 12px; text-align: left"&gt;2023年６月19日&lt;/p&gt;
&lt;p style="margin-left: 12px; text-align: left"&gt;関東財務局長に提出&lt;/p&gt;
&lt;p style="margin-left: 12px; text-align: left"&gt; &lt;/p&gt;
&lt;p style="margin-left: 12px; text-align: left"&gt;2024年６月24日&lt;/p&gt;
&lt;p style="margin-left: 12px; text-align: left"&gt;関東財務局長に提出&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;/div&gt;
