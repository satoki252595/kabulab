&lt;/td&gt;
&lt;td style="vertical-align:top;border-top-color:#a9a9a9;border-bottom-color:#a9a9a9;border-left-style:solid;border-left-width:0.75pt;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:6.5pt;padding-right:6.5pt;line-height:11pt;font-size:7.5pt;"&gt;取締役営業部長&lt;/p&gt;
