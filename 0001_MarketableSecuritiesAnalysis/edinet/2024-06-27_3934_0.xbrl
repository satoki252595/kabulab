&lt;td style="vertical-align: middle; width: 182px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 36px; margin-right: 12px; text-align: left"&gt;自　2017年３月18日&lt;/p&gt;
&lt;p style="margin-left: 36px; margin-right: 12px; text-align: left"&gt;至　2025年３月16日&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 67px"&gt;
&lt;td style="vertical-align: middle; width: 271px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 12px; margin-right: 3.3333333333333333333333333333px; text-align: left"&gt;新株予約権の行使により株式を発行する場合の株式の発行価格及び資本組入額（円）※&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 183px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 36px; margin-right: 12px; text-align: left"&gt;発行価格　　200&lt;/p&gt;
&lt;p style="margin-left: 36px; margin-right: 12px; text-align: left"&gt;資本組入額　100&lt;/p&gt;
&lt;p style="margin-left: 12px; margin-right: 12px; text-align: center"&gt;（注）５&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 182px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 36px; margin-right: 12px; text-align: left"&gt;発行価格　　200&lt;/p&gt;
&lt;p style="margin-left: 36px; margin-right: 12px; text-align: left"&gt;資本組入額　100&lt;/p&gt;
&lt;p style="margin-left: 12px; margin-right: 12px; text-align: center"&gt;（注）５&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 29px"&gt;
&lt;td style="vertical-align: middle; width: 271px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 12px; margin-right: 3.3333333333333333333333333333px; text-align: left"&gt;新株予約権の行使の条件　※&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 183px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 12px; margin-right: 12px; text-align: center"&gt;（注）３&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 182px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 12px; margin-right: 12px; text-align: center"&gt;（注）３&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
