&lt;td style="vertical-align: middle; width: 239px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;

&lt;p style="margin-left: 75px; line-height: 13.333333333333333333333333333px; margin-right: 3px; text-align: left; text-indent: -70px"&gt;
&lt;span style="font-size: 10px"&gt;1988年11月　株式会社エスピージャパン設立&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 75px; line-height: 13.333333333333333333333333333px; margin-right: 3px; text-align: left; text-indent: -70px"&gt;
&lt;span style="font-size: 10px"&gt;　　　　　　代表取締役社長就任&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 75px; line-height: 13.333333333333333333333333333px; margin-right: 3px; text-align: left; text-indent: -70px"&gt;
&lt;span style="font-size: 10px"&gt;1996年６月　当社設立　代表取締役社長就任&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 75px; line-height: 13.333333333333333333333333333px; margin-right: 3px; text-align: left; text-indent: -70px"&gt;
&lt;span style="font-size: 10px"&gt;　　　　　　（現任）&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 75px; line-height: 13.333333333333333333333333333px; margin-right: 3px; text-align: left; text-indent: -70px"&gt;
&lt;span style="font-size: 10px"&gt;2008年５月　株式会社ライフスタイルウォーター&lt;/span&gt;
