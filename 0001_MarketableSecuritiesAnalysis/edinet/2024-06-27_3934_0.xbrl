&lt;col style="width: 93.33333333333333333333333333px"/&gt;
&lt;col style="width: 93.33333333333333333333333333px"/&gt;
&lt;col style="width: 93.33333333333333333333333333px"/&gt;
&lt;col style="width: 93.33333333333333333333333333px"/&gt;
&lt;col style="width: 93.33333333333333333333333333px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr style="height: 31.33px"&gt;
&lt;td rowspan="2" style="vertical-align: middle; width: 146.4px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt;役員区分&lt;/p&gt;
&lt;/td&gt;
&lt;td rowspan="2" style="vertical-align: middle; width: 93.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt;報酬等の総額&lt;/p&gt;
