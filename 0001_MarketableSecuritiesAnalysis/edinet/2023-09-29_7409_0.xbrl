  <jpcrp_cor:TreasurySharesEtcTextBlock contextRef="FilingDateInstant">
&lt;h5 class="smt_head4"&gt;② 【自己株式等】&lt;/h5&gt;&lt;p class="smt_head6" style="orphans:0;widows:0;padding-left:0pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:0pt;font-family:&amp;apos;ＭＳ ゴシック&amp;apos;;text-align:justify;letter-spacing:0pt;line-height:13pt;"&gt;　　　　&lt;span style="font-family:&amp;apos;ＭＳ 明朝&amp;apos;;"&gt;該当事項はありません。&lt;/span&gt;&lt;br/&gt; &lt;/p&gt;</jpcrp_cor:TreasurySharesEtcTextBlock>
  <jpcrp_cor:ClassesOfSharesEtcTextBlock contextRef="FilingDateInstant">&lt;p class="smt_head6" style="orphans:0;widows:0;line-height:3pt;font-size:3pt;"&gt; &lt;/p&gt;
&lt;div class="tbld" style="margin-left:29.2pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:222pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
&lt;col style="width:96pt;min-width:96pt;"/&gt;
&lt;col style="width:126pt;min-width:126pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:11.2pt;min-height:11.2pt;"&gt;
&lt;td style="vertical-align:top;border-top-color:#a9a9a9;border-bottom-color:#a9a9a9;border-left-color:#a9a9a9;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:0pt;padding-right:0pt;line-height:11.5pt;"&gt;【株式の種類等】&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:top;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;line-height:11.5pt;"&gt;該当事項はありません。&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/table&gt;&lt;p style="clear:both; line-height:0.75pt; width:100%; font-size:0.75pt;"&gt; &lt;/p&gt;
