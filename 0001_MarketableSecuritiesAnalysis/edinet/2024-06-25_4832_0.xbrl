&lt;tr style="height:17.4pt;min-height:17.4pt;"&gt;
&lt;td style="vertical-align:middle;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:4pt;padding-right:0pt;margin-top:0pt;margin-bottom:0.0pt;line-height:12pt;"&gt;&lt;span style="font-size:9pt;"&gt;一定の期間にわたり移転される財又はサービス&lt;/span&gt;&lt;/p&gt;
