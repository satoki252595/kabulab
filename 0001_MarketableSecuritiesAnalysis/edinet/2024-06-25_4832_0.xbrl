&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:17.4pt;min-height:17.4pt;"&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:4pt;padding-right:0pt;margin-top:0pt;margin-bottom:0.0pt;line-height:12pt;"&gt;&lt;span style="font-size:9pt;"&gt;顧客との契約から生じた債権&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
