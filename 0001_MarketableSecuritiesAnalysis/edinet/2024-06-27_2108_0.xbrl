&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:42.5pt;min-height:42.5pt;"&gt;
&lt;td style="vertical-align:middle;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:27pt;padding-right:0pt;"&gt;取扱場所&lt;/p&gt;
