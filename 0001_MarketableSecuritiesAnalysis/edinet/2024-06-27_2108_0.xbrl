  <jpcrp_cor:DescriptionIssuedSharesVotingRights contextRef="CurrentYearInstant_OrdinarySharesSharesWithFullVotingRightsOtherMember">単元株式数は100株</jpcrp_cor:DescriptionIssuedSharesVotingRights>
