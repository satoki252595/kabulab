  <jpcrp_cor:NameOfShareholderTreasurySharesEtc contextRef="CurrentYearInstant_Row1Member" xsi:nil="true"/>
  <jpcrp_cor:AddressOfShareholderTreasurySharesEtc contextRef="CurrentYearInstant_Row1Member" xsi:nil="true"/>
  <jpcrp_cor:ClassesOfSharesEtcTextBlock contextRef="FilingDateInstant">
&lt;div class="tbld" style="margin-left:27pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:203.25pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
