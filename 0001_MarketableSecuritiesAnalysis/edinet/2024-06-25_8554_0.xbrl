  <jpcrp_cor:DescriptionIssuedSharesTotalNumberOfSharesEtc contextRef="FilingDateInstant_jpcrp030000-asr_E03670-000ClassBPreferredStockMember">（注２）</jpcrp_cor:DescriptionIssuedSharesTotalNumberOfSharesEtc>
  <jpcrp_cor:DetailsOfEmployeeShareOptionProgramTextBlock contextRef="FilingDateInstant">
&lt;h4 class="smt_head4" style="padding-left:18pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;text-align:justify;letter-spacing:0pt;line-height:15pt;font-size:9pt;"&gt;① 【ストックオプション制度の内容】&lt;/h4&gt;&lt;p class="smt_text4" style="orphans:0;widows:0;padding-left:36pt;"&gt;該当事項はありません。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;"&gt; &lt;/p&gt;</jpcrp_cor:DetailsOfEmployeeShareOptionProgramTextBlock>
