&lt;td style="vertical-align: bottom; width: 128px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 16px; margin-right: 6px; margin-bottom: 4px; text-align: right"&gt;10,567,740&lt;/p&gt;
