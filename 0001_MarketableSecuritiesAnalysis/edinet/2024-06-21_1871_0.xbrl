&lt;p style="margin-left: 48px; margin-bottom: 12px; text-align: justify; text-justify: inter-ideograph; text-indent: -36px"&gt;150％以上&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 105px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 48px; margin-bottom: 12px; text-align: justify; text-justify: inter-ideograph; text-indent: -36px"&gt;1.25&lt;/p&gt;
