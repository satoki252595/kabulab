&lt;col style="width: 105px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr style="height: 40.2px"&gt;
&lt;td style="vertical-align: middle; width: 246.06666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 48px; margin-bottom: 12px; text-align: justify; text-justify: inter-ideograph; text-indent: -36px"&gt;各業績指標の業績目標達成度&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 105px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 48px; margin-bottom: 12px; text-align: justify; text-justify: inter-ideograph; text-indent: -36px"&gt;係数&lt;/p&gt;
