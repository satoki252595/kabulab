  <jpcrp_cor:NotesRegardingPledgedAssetsTextBlock contextRef="CurrentYearInstant_NonConsolidatedMember">&lt;p class="smt_text6" style="orphans:0;widows:0;"&gt;※２  担保資産&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:27pt;"&gt;担保に供している資産&lt;/p&gt;
