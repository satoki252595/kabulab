&lt;td style="vertical-align: middle; width: 250px; padding-top: 1px; padding-bottom: 1px; padding-left: 1px; padding-right: 1px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
