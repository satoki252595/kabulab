&lt;/td&gt;
&lt;td style="vertical-align: top; width: 313px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 18.066666666666666666666666667px; line-height: 18.666666666666666666666666667px; margin-right: 12px; text-align: justify; text-justify: inter-ideograph; text-indent: -18.066666666666666666666666667px"&gt;
