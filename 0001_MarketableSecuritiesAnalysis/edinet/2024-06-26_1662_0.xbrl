&lt;tbody&gt;
&lt;tr style="height: 20px"&gt;
&lt;td style="vertical-align: top; width: 276.06666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6.3333333333333333333333333333px; line-height: 18.666666666666666666666666667px; margin-right: 12px; text-align: justify; text-justify: inter-ideograph; text-indent: -0.3333333333333333333333333333px"&gt;(1)　有価証券&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 313px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 18.066666666666666666666666667px; line-height: 18.666666666666666666666666667px; margin-right: 12px; text-align: justify; text-justify: inter-ideograph; text-indent: -18.066666666666666666666666667px"&gt;
&lt;span style="font-size: 12px"&gt; &lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 20px"&gt;
&lt;td style="vertical-align: top; width: 276.06666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6.3333333333333333333333333333px; line-height: 18.666666666666666666666666667px; margin-right: 12px; text-align: justify; text-justify: inter-ideograph; text-indent: -0.3333333333333333333333333333px"&gt;　・満期保有目的の債券&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 313px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 18.066666666666666666666666667px; line-height: 18.666666666666666666666666667px; margin-right: 12px; text-align: justify; text-justify: inter-ideograph; text-indent: -18.066666666666666666666666667px"&gt;償却原価法&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 20px"&gt;
&lt;td style="vertical-align: top; width: 276.06666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6.3333333333333333333333333333px; line-height: 18.666666666666666666666666667px; margin-right: 12px; text-align: justify; text-justify: inter-ideograph; text-indent: -0.3333333333333333333333333333px"&gt;　・子会社株式及び関連会社株式&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 313px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 18.066666666666666666666666667px; line-height: 18.666666666666666666666666667px; margin-right: 12px; text-align: justify; text-justify: inter-ideograph; text-indent: -18.066666666666666666666666667px"&gt;移動平均法による原価法&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 20px"&gt;
&lt;td style="vertical-align: top; width: 276.06666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
