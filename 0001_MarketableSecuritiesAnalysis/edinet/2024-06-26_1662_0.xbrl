&lt;td style="vertical-align: top; width: 90.4px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 20px; margin-right: 4px; text-align: left"&gt;本山　博史&lt;/p&gt;
