&lt;td style="vertical-align: top; width: 310.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: left"&gt;１株当たり当期純利益&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 161.8px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 24px; text-align: right"&gt;1,236円65銭&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 161.8px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 24px; text-align: right"&gt;994円43銭&lt;/p&gt;
&lt;/td&gt;
