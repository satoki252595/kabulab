&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 149.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 16px; text-align: right"&gt;17回&lt;/p&gt;
&lt;/td&gt;
