&lt;td rowspan="2" style="vertical-align: middle; width: 37.333333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-top: 13.333333333333333333333333333px; text-align: left"&gt;株式数&lt;/p&gt;
&lt;/td&gt;
