&lt;col style="width:115.5pt;min-width:115.5pt;"/&gt;
&lt;col style="width:65pt;min-width:65pt;"/&gt;
&lt;col style="width:66pt;min-width:66pt;"/&gt;
&lt;/colgroup&gt;
