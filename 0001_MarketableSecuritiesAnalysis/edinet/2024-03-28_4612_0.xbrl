&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center; line-height: 13.333333333333333333333333333px"&gt;日付&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000; width: 226.6px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
