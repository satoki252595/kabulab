&lt;/td&gt;
&lt;td style="border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none ; width: 156px; vertical-align: top; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: justify; line-height: 13.333333333333333333333333333px; text-justify: inter-ideograph"&gt;2023年３月29日&lt;/p&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: justify; line-height: 13.333333333333333333333333333px; text-justify: inter-ideograph"&gt;関東財務局長に提出&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 32.47px"&gt;
