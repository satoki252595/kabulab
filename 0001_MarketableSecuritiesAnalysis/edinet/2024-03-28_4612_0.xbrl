</jpcrp_cor:OfficialTitleOrPositionInformationAboutExecutiveDirectors>
  <jpcrp_cor:NameInformationAboutExecutiveDirectors contextRef="FilingDateInstant_jpcrp030000-asr_E00892-000WakatukiYuichiroMember">若 月 雄 一 郎</jpcrp_cor:NameInformationAboutExecutiveDirectors>
  <jpcrp_cor:DateOfBirthInformationAboutExecutiveDirectors contextRef="FilingDateInstant_jpcrp030000-asr_E00892-000WakatukiYuichiroMember">1966-08-28</jpcrp_cor:DateOfBirthInformationAboutExecutiveDirectors>
