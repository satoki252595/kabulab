&lt;p style="margin-left: 0px; line-height: 13.333333333333333333333333333px; margin-right: 0px; margin-bottom: 0px; text-align: left"&gt;
&lt;span style="font-size: 12px"&gt; &lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
