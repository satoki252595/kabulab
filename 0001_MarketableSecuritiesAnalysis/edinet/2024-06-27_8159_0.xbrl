&lt;/td&gt;
&lt;td rowspan="5" style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;text-align:left;padding-left:2pt;line-height:8.5pt;font-size:7.5pt;"&gt;1970年&lt;br/&gt;７月30日生&lt;/p&gt;
&lt;/td&gt;
