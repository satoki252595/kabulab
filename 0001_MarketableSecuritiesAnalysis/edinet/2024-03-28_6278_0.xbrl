    <link:footnote xlink:label="footnote" xlink:role="http://disclosure.edinet-fsa.go.jp/role/jppfs/role/NotesNumber" xlink:type="resource" xml:lang="ja">※1</link:footnote>
    <link:loc xlink:href="#fact42" xlink:label="fact" xlink:type="locator"/>
