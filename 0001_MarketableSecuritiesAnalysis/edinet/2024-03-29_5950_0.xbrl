&lt;col style="width: 74.666666666666666666666666667px"/&gt;
&lt;col style="width: 67.333333333333333333333333333px"/&gt;
&lt;col style="width: 74.666666666666666666666666667px"/&gt;
&lt;col style="width: 72.666666666666666666666666667px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr style="height: 26px"&gt;
&lt;td rowspan="2" style="vertical-align: middle; width: 189.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
