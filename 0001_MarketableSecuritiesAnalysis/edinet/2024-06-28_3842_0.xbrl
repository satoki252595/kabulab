  <jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E05677-000MimuraSetsuMember">三 村　摂</jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E05677-000MimuraSetsuMember">1963-07-13</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock contextRef="FilingDateInstant_jpcrp030000-asr_E05677-000MimuraSetsuMember">
&lt;p style="margin-left: 65px; line-height: 15px; margin-right: 2px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;1989年10月  有限責任監査法人トーマツ入所&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 15px; margin-right: 2px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;1993年４月  公認会計士登録&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 15px; margin-right: 2px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;1998年８月  三村会計事務所　所長（現任）&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 15px; margin-right: 2px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;1999年３月　宝印刷株式会社顧問&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 15px; margin-right: 2px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;2003年６月　ソマール株式会社取締役（現任）&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 15px; margin-right: 2px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;2015年６月　当社社外監査役&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 15px; margin-right: 2px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;2016年６月　当社社外取締役（監査等委員）（現任）&lt;/span&gt;
&lt;/p&gt;
</jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock>
  <jpcrp_cor:TermOfOfficeInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E05677-000MimuraSetsuMember">（注）３</jpcrp_cor:TermOfOfficeInformationAboutDirectorsAndCorporateAuditors>
