  <jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E05677-000WatanabeToshikazuMember">渡 辺 俊 一</jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E05677-000WatanabeToshikazuMember">1954-12-21</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock contextRef="FilingDateInstant_jpcrp030000-asr_E05677-000WatanabeToshikazuMember">
&lt;p style="margin-left: 65px; line-height: 15px; margin-right: 2px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;1977年４月  日本電信電話公社（現日本電信電話株式会社）入社&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 15px; margin-right: 2px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;1997年４月  NTTコミュニケーションウェア株式会社（現エヌ・ティ・ティ・コムウェア株式会社）入社&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 15px; margin-right: 2px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;2001年７月  フュージョン・コミュニケーションズ株式会社（現楽天コミュニケーションズ株式会社）入社&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 15px; margin-right: 2px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;2002年４月  当社入社　執行役員営業部長CMO&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 15px; margin-right: 2px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;2006年２月　当社人事・総務グループリーダー&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 15px; margin-right: 2px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;2008年１月　当社第一営業本部本部長&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 15px; margin-right: 2px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;2014年１月　当社営業統括本部シニアマネージャー&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 15px; margin-right: 2px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;2014年３月　当社常勤監査役&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 15px; margin-right: 2px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;2016年６月　当社取締役（監査等委員・常勤）（現任）&lt;/span&gt;
&lt;/p&gt;
</jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock>
