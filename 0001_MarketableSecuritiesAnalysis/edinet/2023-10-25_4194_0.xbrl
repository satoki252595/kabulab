&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:18.5pt;min-height:18.5pt;"&gt;
&lt;td style="vertical-align:top;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;margin-top:2pt;"&gt;2019年12月&lt;/p&gt;
