&lt;td style="vertical-align: middle; width: 119.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 6px; text-align: right"&gt;9&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 119.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 5px; text-align: right"&gt;12&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 119.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 6px; text-align: right"&gt;9&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;/div&gt;
</jpcrp_cor:AnnexedDetailedScheduleOfProvisionsTextBlock>
  <jpcrp_cor:ComponentsOfMajorAssetsAndLiabilitiesTextBlock contextRef="CurrentYearDuration">
&lt;h4&gt;（２）【主な資産及び負債の内容】&lt;/h4&gt;
&lt;p style="margin-left: 48px; text-align: left"&gt;　連結財務諸表を作成しているため、記載を省略しております。&lt;/p&gt;
&lt;p style="margin-left: 6px; text-align: left"&gt; &lt;/p&gt;
