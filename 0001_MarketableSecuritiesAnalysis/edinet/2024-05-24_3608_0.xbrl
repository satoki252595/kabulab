&lt;td style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblR" style="orphans:0;widows:0;padding-right:0pt;line-height:13pt;"&gt;2023年２月28日&lt;/p&gt;
&lt;/td&gt;
