&lt;td style="vertical-align:middle;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;line-height:12pt;font-size:10.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;スタートアップ支援プラットフォーム『Booster』新設&lt;/span&gt;&lt;/p&gt;
