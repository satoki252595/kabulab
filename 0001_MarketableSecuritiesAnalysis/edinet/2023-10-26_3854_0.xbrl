  <jpcrp_cor:NameOfShareholderTreasurySharesEtc contextRef="CurrentYearInstant_Row1Member">株式会社アイル</jpcrp_cor:NameOfShareholderTreasurySharesEtc>
  <jpcrp_cor:AddressOfShareholderTreasurySharesEtc contextRef="CurrentYearInstant_Row1Member">大阪市北区大深町３番１号</jpcrp_cor:AddressOfShareholderTreasurySharesEtc>
  <jpcrp_cor:ClassesOfSharesEtcTextBlock contextRef="FilingDateInstant">
&lt;p style="margin-left: 26.666666666666666666666666667px; text-align: left"&gt;【株式の種類等】&lt;/p&gt;
&lt;p style="margin-left: 36px; text-align: left"&gt;会社法第155条第７号に該当する普通株式の取得および会社法第155条第13号に該当する普通株式の取得&lt;/p&gt;
