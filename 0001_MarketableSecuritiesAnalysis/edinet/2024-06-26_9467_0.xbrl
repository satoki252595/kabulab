  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E30908-000KajimotoYusukeMember">1969-12-17</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
