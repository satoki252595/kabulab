&lt;col style="width:191pt;min-width:191pt;"/&gt;
&lt;col style="width:28.5pt;min-width:28.5pt;"/&gt;
&lt;col style="width:42.8pt;min-width:42.8pt;"/&gt;
&lt;/colgroup&gt;
