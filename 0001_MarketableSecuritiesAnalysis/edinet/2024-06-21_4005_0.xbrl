  <jpigp_cor:NotesLeasesConsolidatedFinancialStatementsIFRSTextBlock contextRef="CurrentYearDuration">&lt;p style="page-break-before:always; line-height:0.75pt; width:100%; font-size:0.75pt;"&gt; &lt;/p&gt;&lt;p class="smt_head6" style="orphans:0;widows:0;"&gt;22．リース&lt;/p&gt;
&lt;h4 class="smt_head3" style="padding-left:9pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;line-height:15.8pt;font-size:10.5pt;"&gt;&lt;span style="font-size:9pt;"&gt;(1) リースに関連する損益及びキャッシュ・フロー&lt;/span&gt;
