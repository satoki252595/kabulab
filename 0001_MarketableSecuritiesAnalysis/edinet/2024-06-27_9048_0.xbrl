&lt;/td&gt;
&lt;td style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:right;padding-left:0pt;padding-right:51pt;text-justify:inter-ideograph;text-indent:0pt;"&gt;22,331&lt;/p&gt;
&lt;/td&gt;
