&lt;/td&gt;
&lt;td style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblR" style="orphans:0;widows:0;padding-right:9pt;"&gt;1,790百万円&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
