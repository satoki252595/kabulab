&lt;tr style="height:15pt;min-height:15pt;"&gt;
&lt;td style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:9pt;padding-right:0pt;text-justify:inter-ideograph;text-indent:0pt;"&gt;契約負債（期末残高）&lt;/p&gt;
&lt;/td&gt;
