&lt;p style="margin-left: 8px; line-height: 13.333333333333333333333333333px; text-align: right"&gt;（単位：千円）&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;/div&gt;
&lt;p style="line-height: 1.3333333333333333333333333333px; text-align: left"&gt; &lt;/p&gt;
&lt;div style="margin-left: 37.333333333333333333333333333px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 399.99999999999999999999999999px"&gt;
