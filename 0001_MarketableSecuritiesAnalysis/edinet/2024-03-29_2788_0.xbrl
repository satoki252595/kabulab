&lt;p class="text_align_justify" style="margin-left: 5px; line-height: 16px; margin-right: 5px"&gt;既発行&lt;/p&gt;
&lt;p class="text_align_justify" style="margin-left: 5px; line-height: 16px; margin-right: 5px"&gt;株式数&lt;/p&gt;
&lt;/td&gt;
&lt;td rowspan="2" style="vertical-align: middle; width: 13.333333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 16px; text-align: justify; text-justify: inter-ideograph"&gt;＋&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 73.333333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p class="text_align_justify" style="margin-left: 5px; line-height: 16px; margin-right: 5px"&gt;新規発行&lt;/p&gt;
&lt;p class="text_align_justify" style="margin-left: 5px; line-height: 16px; margin-right: 5px"&gt;株式数&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 13.333333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 16px; text-align: justify; text-justify: inter-ideograph"&gt;×&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 93.53333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p class="text_align_justify" style="margin-left: 6px; line-height: 16px; margin-right: 6px"&gt;１株当たり&lt;/p&gt;
&lt;p class="text_align_justify" style="margin-left: 6px; line-height: 16px; margin-right: 6px"&gt;払込金額&lt;/p&gt;
&lt;/td&gt;
