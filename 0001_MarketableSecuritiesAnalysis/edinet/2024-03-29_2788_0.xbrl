&lt;tr style="height: 26.67px"&gt;
&lt;td rowspan="2" style="vertical-align: middle; width: 66.666666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p class="text_align_justify" style="margin-left: 5px; line-height: 16px; margin-right: 5px"&gt;調整後&lt;/p&gt;
