  <jpcrp_cor:NotesRegardingDividendTextBlock contextRef="Prior1YearDuration_NonConsolidatedMember">&lt;p class="smt_head6" style="orphans:0;widows:0;padding-left:9pt;"&gt;２．配当に関する事項&lt;/p&gt;&lt;p class="smt_head6" style="orphans:0;widows:0;padding-left:18pt;"&gt;(1) 配当金支払額&lt;/p&gt;
&lt;div class="tbld" style="text-align:left;"&gt;
