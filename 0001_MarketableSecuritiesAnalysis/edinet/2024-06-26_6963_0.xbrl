&lt;td style="border-left: 1px solid #000000; border-top: 0px none ; border-right: 0px none #000000; border-bottom: 1px solid #000000; width: 151.2px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: justify; line-height: 1.3333333333333333333333333333px; text-justify: inter-ideograph; text-indent: 12px"&gt;
