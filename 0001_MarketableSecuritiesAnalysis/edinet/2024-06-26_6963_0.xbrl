&lt;tr style="height: 15px"&gt;
&lt;td style="vertical-align: top; width: 60px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 5px; line-height: 14px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;2013年６月&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 200px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 14px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;当社取締役　ＬＳＩ生産本部長&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
