&lt;/td&gt;
&lt;td rowspan="2" style="vertical-align: middle; width: 25.733333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
