&lt;td style="border-left: 1px solid #000000; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none #000000; width: 16.866666666666666666666666667px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
