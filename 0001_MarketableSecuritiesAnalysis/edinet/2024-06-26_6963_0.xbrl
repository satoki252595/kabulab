&lt;tr style="height: 37.53px"&gt;
&lt;td style="vertical-align: bottom; width: 62.933333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
