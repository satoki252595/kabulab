  <jpcrp_cor:ShareholdingByShareholderCategoryTextBlock contextRef="FilingDateInstant">
&lt;h4&gt;（５）【所有者別状況】&lt;/h4&gt;
&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 640px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 73px"/&gt;
&lt;col style="width: 63px"/&gt;
&lt;col style="width: 63px"/&gt;
&lt;col style="width: 63px"/&gt;
&lt;col style="width: 63px"/&gt;
&lt;col style="width: 63px"/&gt;
&lt;col style="width: 63px"/&gt;
&lt;col style="width: 63px"/&gt;
&lt;col style="width: 63px"/&gt;
&lt;col style="width: 63px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr style="height: 15px"&gt;
&lt;td style="vertical-align: middle; width: 73px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;
&lt;p style="line-height: 15px; text-align: right"&gt;
&lt;span style="font-size: 10px"&gt; &lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
