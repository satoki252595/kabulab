&lt;/td&gt;
&lt;td style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:right;padding-left:18.5pt;padding-right:5.5pt;line-height:10pt;"&gt;63,765千円&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
