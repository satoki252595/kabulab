  <jpcrp_cor:NotesRegardingIssuedSharesAndTreasurySharesTextBlock contextRef="Prior1YearDuration">&lt;p class="smt_head6" style="orphans:0;widows:0;padding-left:9pt;line-height:13pt;"&gt;１．発行済株式に関する事項&lt;/p&gt;
