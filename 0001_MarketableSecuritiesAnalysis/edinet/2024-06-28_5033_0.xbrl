  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E37435-000InoueMunehiroMember">1977-12-04</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
