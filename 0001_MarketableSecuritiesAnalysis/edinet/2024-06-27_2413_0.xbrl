&lt;colgroup&gt;
&lt;col style="width: 158.66666666666666666666666667px"/&gt;
&lt;col style="width: 89.33333333333333333333333333px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr&gt;
