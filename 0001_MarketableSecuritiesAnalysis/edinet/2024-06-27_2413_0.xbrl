&lt;p style="margin-left: 6px; margin-right: 4px; text-align: left"&gt;契約負債&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 142.2px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-right: 24px; text-align: right"&gt;11,589&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 142.2px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-right: 24px; text-align: right"&gt;14,399&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 142.2px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
