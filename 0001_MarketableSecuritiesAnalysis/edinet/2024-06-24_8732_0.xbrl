&lt;p style="line-height: 17.333333333333333333333333333px; margin-right: 12px; text-align: right"&gt;12&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 21.33px"&gt;
&lt;td style="vertical-align: middle; width: 111.06666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
