  <jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock contextRef="FilingDateInstant_jpcrp030000-asr_E01704-000KojimaAtsushiMember">
&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 227px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 62px"/&gt;
&lt;col style="width: 165px"/&gt;
