  <jpcrp_cor:InformationForEachProductOrServiceTextBlock contextRef="Prior1YearDuration">
&lt;p style="margin-left: 84px; line-height: 18px; margin-right: 0px; text-align: left"&gt;１．製品及びサービスごとの情報&lt;/p&gt;
&lt;p style="margin-left: 96px; line-height: 18px; margin-right: 0px; text-align: left; text-indent: 12px"&gt;単一の製品・サービスの区分の外部顧客への売上高が連結損益計算書の売上高の90％を超えるため、記載を省略しております。&lt;/p&gt;
</jpcrp_cor:InformationForEachProductOrServiceTextBlock>
  <jpcrp_cor:RevenuesFromExternalCustomersInformationForEachRegionTextBlock contextRef="Prior1YearDuration">
&lt;p style="margin-left: 96px; line-height: 18px; margin-right: 0px; text-align: left"&gt;(1)売上高&lt;/p&gt;
&lt;p style="margin-left: 102px; line-height: 18px; margin-right: 0px; text-align: left; text-indent: 12px"&gt;本邦の外部顧客への売上高が連結損益計算書の売上高の90％を超えるため、記載を省略しております。&lt;/p&gt;
</jpcrp_cor:RevenuesFromExternalCustomersInformationForEachRegionTextBlock>
  <jpcrp_cor:PropertyPlantAndEquipmentInformationForEachRegionTextBlock contextRef="Prior1YearDuration">
