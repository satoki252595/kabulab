&lt;col style="width:61.3pt;min-width:61.3pt;"/&gt;
&lt;col style="width:48pt;min-width:48pt;"/&gt;
&lt;col style="width:48pt;min-width:48pt;"/&gt;
&lt;col style="width:48pt;min-width:48pt;"/&gt;
&lt;col style="width:48pt;min-width:48pt;"/&gt;
