&lt;/colgroup&gt;
&lt;tr style="height:24.6pt;min-height:24.6pt;"&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;background-color:#92cddc;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:6.3pt;padding-right:5.8pt;margin-top:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:-0.6pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;line-height:19.8pt;font-size:9pt;"&gt;&lt;span style="font-size:9pt;"&gt;経営層および重要ポスト後継者候補の開発に関する指標&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
