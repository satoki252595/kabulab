&lt;td style="vertical-align:middle;border-top-color:#a9a9a9;border-bottom-color:#a9a9a9;border-left-color:#a9a9a9;border-right-color:#a9a9a9;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:0pt;padding-right:0pt;line-height:10.5pt;"&gt;米国に現地法人 TOYO DENKI RAILWAY SERVICE,LLC.設立&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
