&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:justify;padding-left:61pt;padding-right:0pt;text-justify:inter-ideograph;text-indent:12pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;line-height:7pt;font-size:9pt;"&gt;&lt;span style="font-size:6pt;"&gt;◎委員長〇委員&lt;/span&gt;&lt;/p&gt;
