  <jpcrp_cor:AnnexedDetailedScheduleOfPropertyPlantAndEquipmentEtcTextBlock contextRef="CurrentYearDuration">
&lt;h6&gt;【有形固定資産等明細表】&lt;/h6&gt;
&lt;p style="text-align: left"&gt; &lt;/p&gt;
&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 642.66666666666666666666666667px"&gt;
&lt;colgroup&gt;
