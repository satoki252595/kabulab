&lt;p style="margin-left: 36px; text-align: left"&gt;2023年12月期&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td style="vertical-align: top; width: 251.46666666666666666666666667px; padding-top: 6.6666666666666666666666666667px; padding-bottom: 6.6666666666666666666666666667px; padding-left: 6.6666666666666666666666666667px; padding-right: 6.6666666666666666666666666667px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
