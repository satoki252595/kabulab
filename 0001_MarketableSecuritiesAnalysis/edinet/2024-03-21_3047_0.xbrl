&lt;span style="font-size: 10px"&gt;当社取締役（監査等委員）&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 5px; line-height: 15px; margin-right: 3px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;就任（現任）&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;/div&gt;

&lt;p style="margin-left: 5px; line-height: 1.3333333333333333333333333333px; margin-right: 3px; text-align: left"&gt;　&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 45.333333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 15px; margin-right: 5px; text-align: right"&gt;
&lt;span style="font-size: 10px"&gt;(注)４&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 60px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 15px; margin-right: 5px; text-align: right"&gt;
-&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 22.67px"&gt;
&lt;td colspan="5" style="vertical-align: middle; width: 588px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 15px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;計&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 60px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 15px; margin-right: 5px; text-align: right"&gt;
&lt;span style="font-size: 10px"&gt;1,151,300&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
