&lt;p style="margin-left: 5px; line-height: 15px; margin-right: 3px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;日本弁護士連合会税制委員会委員&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 15px"&gt;
&lt;td style="vertical-align: top; width: 60px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 5px; line-height: 15px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;2019年３月&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 170px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 5px; line-height: 15px; margin-right: 3px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;租税訴訟学会中四国支部長&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 15px"&gt;
&lt;td style="vertical-align: top; width: 60px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 5px; line-height: 15px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;2021年３月&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 170px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 5px; line-height: 15px; margin-right: 3px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;当社取締役（監査等委員）&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 5px; line-height: 15px; margin-right: 3px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;就任（現任）&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
