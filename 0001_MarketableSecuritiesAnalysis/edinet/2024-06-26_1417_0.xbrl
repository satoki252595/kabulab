&lt;col style="width:40pt;min-width:40pt;"/&gt;
&lt;col style="width:105pt;min-width:105pt;"/&gt;
&lt;col style="width:40pt;min-width:40pt;"/&gt;
&lt;col style="width:40pt;min-width:40pt;"/&gt;
&lt;col style="width:89pt;min-width:89pt;"/&gt;
