&lt;td rowspan="2" style="vertical-align: middle; width: 50px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 11.333333333333333333333333333px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;議決権の所有割合&lt;/span&gt;
&lt;/p&gt;
&lt;p style="line-height: 11.333333333333333333333333333px; text-align: center"&gt;
