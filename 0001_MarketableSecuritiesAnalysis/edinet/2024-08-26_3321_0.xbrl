&lt;span style="font-size: 10px"&gt;110&lt;/span&gt;
&lt;/p&gt;
&lt;p style="text-align: right"&gt;
&lt;span style="font-size: 10px"&gt;(5)&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
