&lt;p style="margin-left: 18px; margin-right: 6px; text-align: left; line-height: 8px"&gt; &lt;/p&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: left"&gt;●期間設定（基準年度：2023年度）&lt;/p&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: left"&gt;　短期：１年　　中期：３年　　長期：３年超&lt;/p&gt;
&lt;p style="margin-left: 18px; margin-right: 6px; text-align: left; line-height: 8px"&gt; &lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;/div&gt;
&lt;p style="margin-left: 12px; line-height: 12px; text-align: justify; text-justify: inter-ideograph; text-indent: 12px"&gt; &lt;/p&gt;
&lt;div style="margin-left: 47.466666666666666666666666667px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 600px"&gt;
&lt;colgroup&gt;
