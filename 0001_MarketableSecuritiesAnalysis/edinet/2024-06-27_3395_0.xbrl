&lt;p style="margin-left: 12px; line-height: 13.333333333333333333333333333px; margin-right: 12px; text-align: left"&gt;
&lt;span style="font-size: 12px"&gt; &lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
