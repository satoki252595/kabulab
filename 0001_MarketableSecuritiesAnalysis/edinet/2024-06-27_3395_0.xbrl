  <jpcrp_cor:ConsolidatedSubsidiariesMetricsOfConsolidatedSubsidiaries contextRef="CurrentYearInstant_Row1Member">㈱鎌倉パスタ</jpcrp_cor:ConsolidatedSubsidiariesMetricsOfConsolidatedSubsidiaries>
