  <jpcrp_cor:DescriptionIssuedSharesVotingRights contextRef="CurrentYearInstant_SharesWithRestrictedVotingRightsOtherMember" xsi:nil="true"/>
  <jpcrp_cor:DescriptionIssuedSharesVotingRights contextRef="CurrentYearInstant_OrdinarySharesTreasurySharesSharesWithFullVotingRightsTreasurySharesEtcMember" xsi:nil="true"/>
  <jpcrp_cor:DescriptionIssuedSharesVotingRights contextRef="CurrentYearInstant_OrdinarySharesReciprocalHoldingSharesWithFullVotingRightsTreasurySharesEtcMember" xsi:nil="true"/>
  <jpcrp_cor:DescriptionIssuedSharesVotingRights contextRef="CurrentYearInstant_OrdinarySharesSharesWithFullVotingRightsOtherMember" xsi:nil="true"/>
  <jpcrp_cor:DescriptionIssuedSharesVotingRights contextRef="CurrentYearInstant_OrdinarySharesSharesLessThanOneUnitMember" xsi:nil="true"/>
  <jpcrp_cor:TreasurySharesEtcTextBlock contextRef="FilingDateInstant">
&lt;h5 class="smt_head4"&gt;② 【自己株式等】&lt;/h5&gt;&lt;p class="smt_unitR" style="orphans:0;widows:0;padding-left:386.3pt;"&gt;   &lt;span&gt;2024年３月31日&lt;/span&gt;現在&lt;/p&gt;
