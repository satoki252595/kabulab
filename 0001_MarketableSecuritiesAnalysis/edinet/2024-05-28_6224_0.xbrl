&lt;/td&gt;
&lt;td style="vertical-align:top;border-top-color:#000000;border-bottom-color:#000000;border-left-color:#000000;border-right-color:#000000;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:right;padding-left:0pt;padding-right:27pt;margin-top:0pt;margin-bottom:0pt;line-height:15pt;font-size:9pt;"&gt;230,366&lt;/p&gt;
