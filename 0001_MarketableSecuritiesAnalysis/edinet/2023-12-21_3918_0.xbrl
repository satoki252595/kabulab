&lt;td style="vertical-align:top;border-top-color:#000000;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;text-align:left;padding-left:4.5pt;padding-right:4.5pt;line-height:15pt;"&gt;株式会社インフィニテックの当社保有全株式を、株式会社プリバテックへ譲渡&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:10pt;min-height:10pt;"&gt;
&lt;td style="vertical-align:top;border-top-color:#000000;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;line-height:15pt;"&gt;　　　　10月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:top;border-top-color:#000000;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;text-align:left;padding-left:4.5pt;padding-right:4.5pt;line-height:15pt;"&gt;株式会社プリバテックが株式会社インフィニテックを吸収合併&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:10pt;min-height:10pt;"&gt;
&lt;td style="vertical-align:top;border-top-color:#000000;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;line-height:15pt;"&gt;　2022年４月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:top;border-top-color:#000000;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;text-align:left;padding-left:4.5pt;padding-right:3.5pt;line-height:15pt;"&gt;東京証券取引所の市場区分の見直しにより、東京証券取引所市場第一部からプライム市場に移行&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:10pt;min-height:10pt;"&gt;
&lt;td style="vertical-align:top;border-top-color:#000000;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;text-align:center;padding-left:0pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;font-size:9pt;"&gt;        10月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:top;border-top-color:#000000;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;text-align:left;padding-left:4.5pt;padding-right:3.5pt;line-height:15pt;"&gt;ＰＣＩソリューションズ株式会社が株式会社シー・エル・シーを吸収合併&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:10pt;min-height:10pt;"&gt;
&lt;td style="vertical-align:top;border-top-color:#000000;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;line-height:15pt;"&gt;　2023年９月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:top;border-top-color:#000000;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;text-align:left;padding-left:4.5pt;padding-right:3.5pt;line-height:15pt;"&gt;株式会社りーふねっとの全株式を譲渡&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:10pt;min-height:10pt;"&gt;
&lt;td style="vertical-align:top;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;line-height:15pt;"&gt;　　　　10月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:top;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;text-align:left;padding-left:4.5pt;padding-right:4.5pt;line-height:15pt;"&gt;東京証券取引所スタンダード市場に移行&lt;/p&gt;
&lt;/td&gt;
