&lt;tbody&gt;
&lt;tr&gt;
&lt;td style="vertical-align: middle; width: 247.13333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 18px; margin-bottom: 6.6666666666666666666666666667px; margin-top: 6.6666666666666666666666666667px; text-align: center"&gt;
&lt;img alt="0101010_007.png" src="images/0101010_007.png" style="height: 169.55px; width: 225.26px"/&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td style="vertical-align: middle; width: 247.13333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: center"&gt;非常用動力装置&lt;/p&gt;
