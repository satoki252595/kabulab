&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 189.46666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 30px; text-align: right"&gt;－&lt;/p&gt;
&lt;/td&gt;
