&lt;td style="vertical-align: middle; width: 241.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 12px; margin-right: 24px; text-align: left"&gt;当座貸越極度額&lt;/p&gt;
