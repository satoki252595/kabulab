&lt;td style="vertical-align: middle; width: 195.46666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 30px; margin-right: 6px; text-align: left; text-indent: -24px"&gt;　　　その他有価証券（※2）&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 177.86666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
