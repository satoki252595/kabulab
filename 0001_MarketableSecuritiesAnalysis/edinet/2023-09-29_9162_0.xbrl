&lt;tr style="height: 26.67px"&gt;
&lt;td style="vertical-align: middle; width: 123.53333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt;
18,600
&lt;/p&gt;
