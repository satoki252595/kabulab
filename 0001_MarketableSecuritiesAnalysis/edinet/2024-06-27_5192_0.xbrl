&lt;td style="vertical-align: middle; width: 216px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 3px double #000000"&gt;
&lt;p style="margin-right: 24px; text-align: right"&gt;2,079,845&lt;/p&gt;
&lt;/td&gt;
