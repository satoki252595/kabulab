&lt;td style="vertical-align: middle; width: 97.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 3px double #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 20.666666666666666666666666667px; margin-right: 12px; text-align: right"&gt;1,556&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 97.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 3px double #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 20.666666666666666666666666667px; margin-right: 12px; text-align: right"&gt;－&lt;/p&gt;
