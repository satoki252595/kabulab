&lt;p style="margin-top: 13.333333333333333333333333333px; text-align: center"&gt;既発行普通株式数＋&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 96px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: left"&gt;交付普通株式数×&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 72px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; margin-bottom: 2.3333333333333333333333333333px; margin-top: 2.3333333333333333333333333333px; text-align: left"&gt;１株当たり&lt;/p&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; margin-bottom: 2.3333333333333333333333333333px; margin-top: 2.3333333333333333333333333333px; text-align: left"&gt;払込金額&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 1.33px"&gt;
&lt;td rowspan="2" style="vertical-align: middle; width: 72px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
