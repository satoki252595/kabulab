  <jpcrp_cor:NotesRegardingGuaranteeObligationsTextBlock contextRef="CurrentYearInstant_NonConsolidatedMember">
&lt;p style="margin-left: 24px; line-height: 24px; text-align: left; text-indent: -24px"&gt;
&lt;span style="font-size: 14px"&gt;　２　保証債務&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 26.666666666666666666666666667px; line-height: 24px; text-align: left"&gt;
&lt;span style="font-size: 14px"&gt;　関係会社の金融機関等からの借入に対し、債務保証を行っております。&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 26.666666666666666666666666667px; line-height: 24px; text-align: left"&gt;
&lt;span style="font-size: 14px"&gt;保証債務&lt;/span&gt;
&lt;/p&gt;
