  <jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E26625-000KurataKiyoshiMember">倉田　潔</jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E26625-000KurataKiyoshiMember">1954-08-07</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock contextRef="FilingDateInstant_jpcrp030000-asr_E26625-000KurataKiyoshiMember">
&lt;p style="margin-left: 65px; line-height: 15px; margin-right: 5px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;1981年11月　山一證券株式会社入社&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 15px; margin-right: 5px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;1988年２月　UBS証券株式会社入社 機関投資家営業部長&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 15px; margin-right: 5px; text-align: left; text-indent: -60px"&gt;
