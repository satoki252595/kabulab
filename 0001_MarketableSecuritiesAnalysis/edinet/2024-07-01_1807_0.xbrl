  <jpcrp_cor:DescriptionIssuedSharesTotalNumberOfSharesEtc contextRef="FilingDateInstant_OrdinaryShareMember">単元株式数は100株であります。</jpcrp_cor:DescriptionIssuedSharesTotalNumberOfSharesEtc>
  <jpcrp_cor:DetailsOfEmployeeShareOptionProgramTextBlock contextRef="FilingDateInstant">
&lt;h4 class="smt_head4" style="padding-left:13.5pt;"&gt;① 【ストックオプション制度の内容】&lt;/h4&gt;&lt;p class="smt_text3" style="orphans:0;widows:0;padding-left:22.5pt;text-indent:9pt;"&gt;該当事項はありません。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;"&gt; &lt;/p&gt;</jpcrp_cor:DetailsOfEmployeeShareOptionProgramTextBlock>
  <jpcrp_cor:DescriptionOfRightsPlanTextBlock contextRef="FilingDateInstant">
