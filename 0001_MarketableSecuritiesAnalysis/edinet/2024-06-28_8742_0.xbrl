  <jpcrp_cor:NotesRegardingNewShareSubscriptionRightsEtcTextBlock contextRef="Prior1YearDuration">
&lt;p style="margin-left: 12px; line-height: 16px; text-align: left; text-indent: -6px"&gt; &lt;/p&gt;
&lt;p style="margin-left: 12px; line-height: 16px; text-align: left; text-indent: -6px"&gt;２．新株予約権及び自己新株予約権に関する事項&lt;/p&gt;
&lt;p style="margin-left: 30px; margin-bottom: 16px; text-align: left"&gt;該当事項はありません。&lt;/p&gt;
</jpcrp_cor:NotesRegardingNewShareSubscriptionRightsEtcTextBlock>
