  <jpcrp030000-asr_E36659-000:NotesRegardingSyndicatedLoansTextBlock contextRef="CurrentYearInstant_NonConsolidatedMember">
&lt;p style="margin-left: 84px; text-align: left; text-indent: -24px"&gt;※２　シンジケートローン&lt;/p&gt;
