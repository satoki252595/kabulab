&lt;td style="vertical-align: middle; width: 290.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: left; text-indent: 12px"&gt;顧客との契約から生じた債権(期末残高)&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 150.93333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 66px; text-align: left; text-indent: 12px"&gt;206&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 150.93333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 66px; text-align: left; text-indent: 12px"&gt;168&lt;/p&gt;
&lt;/td&gt;
