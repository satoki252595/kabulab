&lt;col style="width: 135.66666666666666666666666667px"/&gt;
&lt;col style="width: 153.6px"/&gt;
&lt;col style="width: 153.6px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr&gt;
&lt;td colspan="3" style="vertical-align: middle; width: 307.13333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt;決議年月日&lt;/p&gt;
&lt;/td&gt;
