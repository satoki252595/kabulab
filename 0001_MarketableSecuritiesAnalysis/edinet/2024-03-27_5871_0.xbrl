  <jpcrp_cor:CriticalContractsForOperationTextBlock contextRef="FilingDateInstant">
&lt;h3&gt;５【経営上の重要な契約等】&lt;/h3&gt;
&lt;p style="margin-left: 36px; text-align: left"&gt;代理店契約&lt;/p&gt;
&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 648.79999999999999999999999998px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 90.13333333333333333333333333px"/&gt;
&lt;col style="width: 148.13333333333333333333333333px"/&gt;
&lt;col style="width: 38.133333333333333333333333333px"/&gt;
&lt;col style="width: 64.133333333333333333333333333px"/&gt;
&lt;col style="width: 115.13333333333333333333333333px"/&gt;
&lt;col style="width: 193.13333333333333333333333333px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr style="height: 26.67px"&gt;
