&lt;p style="line-height: 15.333333333333333333333333333px; text-align: center"&gt;2012年４月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 555.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 5.5333333333333333333333333333px; line-height: 15.333333333333333333333333333px; text-align: left"&gt;ツルハグループが店舗数1,000店となる&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 1.33px"&gt;
&lt;td style="vertical-align: top; width: 94px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="line-height: 15.333333333333333333333333333px; text-align: center"&gt;2012年７月&lt;/p&gt;
