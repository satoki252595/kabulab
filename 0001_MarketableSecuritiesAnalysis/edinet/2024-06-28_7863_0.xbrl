  <jpcrp_cor:NotesRevenueRecognitionFinancialStatementsTextBlock contextRef="CurrentYearDuration">&lt;p style="page-break-before:always; line-height:0.75pt; width:100%; font-size:0.75pt;"&gt; &lt;/p&gt;&lt;p class="smt_head5" style="orphans:0;widows:0;padding-left:18pt;"&gt;(収益認識関係)&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:left;padding-left:18pt;text-indent:-18pt;line-height:10.5pt;"&gt;１.&lt;span style="font-size:7.5pt;"&gt;  &lt;/span&gt;顧客との契約から生じる収益を分解した情報　　　　&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:right;padding-left:18pt;text-indent:-18pt;line-height:10.5pt;"&gt;（単位：千円）&lt;/p&gt;
