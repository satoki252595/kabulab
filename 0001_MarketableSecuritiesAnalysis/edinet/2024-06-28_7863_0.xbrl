&lt;/colgroup&gt;
&lt;tr style="height:105.8pt;min-height:105.8pt;"&gt;
&lt;td colspan="2" style="vertical-align:top;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;"&gt;＜財務諸表ベース＞&lt;/p&gt;
&lt;div class="tbld" style="margin-left:0pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:438pt;table-layout:fixed;"&gt;
