&lt;col style="width:63pt;min-width:63pt;"/&gt;
&lt;col style="width:57.8pt;min-width:57.8pt;"/&gt;
&lt;col style="width:82.5pt;min-width:82.5pt;"/&gt;
&lt;col style="width:82.5pt;min-width:82.5pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:18pt;min-height:18pt;"&gt;
