  <jpcrp_cor:NotesRegardingTreasurySharesTextBlock contextRef="CurrentYearDuration_NonConsolidatedMember">&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:9pt;line-height:15pt;"&gt;当事業年度(自　&lt;span&gt;2023年４月１日&lt;/span&gt;　至　&lt;span&gt;2024年３月31日&lt;/span&gt;)&lt;/p&gt;
