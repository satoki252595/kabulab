&lt;/td&gt;
&lt;td style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;margin-top:0pt;line-height:15pt;"&gt;２回&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
