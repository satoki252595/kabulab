&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 153px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 2px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt;影響度&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 153px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 2px solid #000000; border-right: 2px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt;重要性&lt;/p&gt;
&lt;/td&gt;
