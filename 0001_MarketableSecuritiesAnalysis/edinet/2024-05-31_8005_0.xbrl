&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 301.46666666666666666666666666px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 165.33333333333333333333333333px"/&gt;
&lt;col style="width: 136.13333333333333333333333333px"/&gt;
