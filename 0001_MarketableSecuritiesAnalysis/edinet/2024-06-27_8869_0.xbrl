&lt;tr style="height: 19px"&gt;
&lt;td style="vertical-align: top; width: 82.73333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 12px; line-height: 24px; margin-right: 6px; text-align: center"&gt;1990年４月&lt;/p&gt;
