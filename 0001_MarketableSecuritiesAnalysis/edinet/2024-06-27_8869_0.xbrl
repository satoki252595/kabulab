&lt;/td&gt;
&lt;td style="vertical-align: top; width: 565.26666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 12px; line-height: 24px; margin-right: 12px; text-align: left"&gt;東京証券取引所　スタンダード市場へ市場区分を変更&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
