&lt;p style="text-align: justify; text-justify: inter-ideograph"&gt; &lt;/p&gt;

</jpcrp030000-asr_E36078-000:StrategyTextBlock>
  <jpcrp030000-asr_E36078-000:PolicyOnHumanResourceDevelopmentAndImprovementOfInternalEnvironmentStrategyTextBlock contextRef="FilingDateInstant">
