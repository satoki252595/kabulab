&lt;col style="width:90pt;min-width:90pt;"/&gt;
&lt;col style="width:90pt;min-width:90pt;"/&gt;
&lt;col style="width:37.5pt;min-width:37.5pt;"/&gt;
&lt;/colgroup&gt;
