  <jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock contextRef="FilingDateInstant_jpcrp030000-asr_E33519-000NishijimaYasutakaMember">
&lt;div class="tbld" style="margin-left:0pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:219pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
&lt;col style="width:47pt;min-width:47pt;"/&gt;
&lt;col style="width:172pt;min-width:172pt;"/&gt;
