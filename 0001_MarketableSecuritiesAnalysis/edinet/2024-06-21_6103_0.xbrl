&lt;col style="width:69.0pt;min-width:69.0pt;"/&gt;
&lt;col style="width:90.8pt;min-width:90.8pt;"/&gt;
&lt;col style="width:90.8pt;min-width:90.8pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:21.8pt;min-height:21.8pt;"&gt;
