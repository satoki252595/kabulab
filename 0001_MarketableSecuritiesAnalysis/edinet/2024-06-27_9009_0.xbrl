&lt;col style="width:80pt;min-width:80pt;"/&gt;
&lt;col style="width:80pt;min-width:80pt;"/&gt;
&lt;col style="width:80pt;min-width:80pt;"/&gt;
&lt;col style="width:50pt;min-width:50pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:17.3pt;min-height:17.3pt;"&gt;
&lt;td colspan="2" style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:0pt;padding-right:0pt;"&gt;&lt;span style="font-size:7.5pt;"&gt;単位：百万円、％&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
