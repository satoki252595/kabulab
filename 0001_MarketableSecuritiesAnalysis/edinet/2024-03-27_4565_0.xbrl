&lt;tr style="height: 20px"&gt;
&lt;td style="vertical-align: top; width: 89.73333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 12px; margin-right: 12px; text-align: center"&gt;1990年６月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 555.26666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 12px; margin-right: 12px; text-align: justify; text-justify: inter-ideograph"&gt;バイオ医薬品の研究開発と技術移転事業を目的として、東京都文京区に株式会社そーせいを設立&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 36px"&gt;
&lt;td style="vertical-align: top; width: 89.73333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 12px; margin-right: 12px; text-align: center"&gt;1999年３月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 555.26666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 12px; margin-right: 12px; text-align: justify; text-justify: inter-ideograph"&gt;DRP（ドラッグ・リプロファイリング・プラットフォーム）プロジェクトを発足し医薬品開発事業を本格的に開始&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 20px"&gt;
&lt;td style="vertical-align: top; width: 89.73333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
