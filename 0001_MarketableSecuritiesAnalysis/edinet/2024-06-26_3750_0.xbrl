&lt;col style="width: 188px"/&gt;
&lt;/colgroup&gt;
&lt;thead&gt;
&lt;tr style="height: 40px"&gt;
&lt;td style="vertical-align: middle; width: 183px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;
&lt;span style="font-size: 12px"&gt; &lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 188px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;前連結会計年度&lt;/p&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;（2023年３月31日）&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 188px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;当連結会計年度&lt;/p&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;（2024年３月31日）&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/thead&gt;
&lt;tbody&gt;
&lt;tr style="height: 18px"&gt;
