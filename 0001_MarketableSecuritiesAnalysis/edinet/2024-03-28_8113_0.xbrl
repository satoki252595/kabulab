&lt;colgroup&gt;
&lt;col style="width: 195px"/&gt;
&lt;col style="width: 146.33333333333333333333333333px"/&gt;
&lt;col style="width: 306.66666666666666666666666667px"/&gt;
&lt;/colgroup&gt;
&lt;thead&gt;
&lt;tr style="height: 26.67px"&gt;
