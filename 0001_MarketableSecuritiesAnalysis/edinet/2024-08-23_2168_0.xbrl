&lt;td colspan="2" style="border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:5pt;padding-right:0pt;margin-top:0.5pt;font-family:&amp;apos;ＭＳ Ｐゴシック&amp;apos;;line-height:14pt;"&gt;&lt;b&gt;ライフソリューション&lt;/b&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:top;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-right-color:#a9a9a9;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:4pt;padding-right:0pt;margin-top:1pt;font-family:&amp;apos;ＭＳ Ｐ明朝&amp;apos;;line-height:12pt;"&gt;(株)パソナフォスター&lt;/p&gt;
