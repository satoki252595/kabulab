</jpcrp030000-asr_E02227-000:NotesRegardingGainOnSalesOfSharesOfSubsidiariesAndAssociatesTextBlock>
  <jpcrp030000-asr_E02227-000:NotesRegardingGainOnSalesOfInvestmentSecuritiesTextBlock contextRef="CurrentYearDuration">
