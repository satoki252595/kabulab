  <jpcrp_cor:NotesAssetRetirementObligationsFinancialStatementsTextBlock contextRef="CurrentYearDuration">
&lt;h6 class="smt_head5" style="padding-left:13.5pt;"&gt;(資産除去債務関係)&lt;/h6&gt;&lt;p class="smt_text2" style="orphans:0;widows:0;text-indent:0pt;line-height:12pt;"&gt;前事業年度末(&lt;span&gt;2022年12月31日&lt;/span&gt;)&lt;/p&gt;&lt;p class="smt_text3" style="orphans:0;widows:0;padding-left:9pt;line-height:12pt;"&gt;該当事項はありません。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:0pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:12pt;font-size:12pt;"&gt; &lt;/p&gt;&lt;p class="smt_text2" style="orphans:0;widows:0;text-indent:0pt;line-height:12pt;"&gt;当事業年度末(&lt;span&gt;2023年12月31日&lt;/span&gt;)&lt;/p&gt;&lt;p class="smt_text3" style="orphans:0;widows:0;padding-left:9pt;line-height:12pt;"&gt;該当事項はありません。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;line-height:12pt;font-size:12pt;"&gt; &lt;/p&gt;</jpcrp_cor:NotesAssetRetirementObligationsFinancialStatementsTextBlock>
