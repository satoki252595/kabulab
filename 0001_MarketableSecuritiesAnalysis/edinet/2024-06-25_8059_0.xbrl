&lt;tr style="height:13pt;min-height:13pt;"&gt;
&lt;td style="vertical-align:top;border-top-color:#a9a9a9;border-bottom-color:#a9a9a9;border-left-color:#a9a9a9;border-right-color:#a9a9a9;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:19.2pt;padding-right:0pt;text-justify:inter-ideograph;text-indent:-19.2pt;line-height:10.5pt;"&gt;2023年７月&lt;/p&gt;
