&lt;col style="width:108pt;min-width:108pt;"/&gt;
&lt;col style="width:108pt;min-width:108pt;"/&gt;
&lt;col style="width:136.9pt;min-width:136.9pt;"/&gt;
&lt;col style="width:54.9pt;min-width:54.9pt;"/&gt;
&lt;/colgroup&gt;
