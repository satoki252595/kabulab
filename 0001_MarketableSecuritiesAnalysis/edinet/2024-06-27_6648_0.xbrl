&lt;p style="margin-right: 36px; text-align: right"&gt;1940年６月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 508px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 12px; text-align: left"&gt;東京都目黒区原町に東京営業部開設&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 37px"&gt;
&lt;td style="vertical-align: top; width: 137px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
