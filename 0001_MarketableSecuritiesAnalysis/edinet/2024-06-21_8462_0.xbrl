&lt;td style="vertical-align: top; width: 153.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; margin-right: 24px; text-align: right"&gt;0.6&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
