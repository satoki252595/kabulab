&lt;p style="margin-left: 84px; line-height: 18px; margin-right: 0px; text-align: left; text-indent: -24px"&gt; &lt;/p&gt;
</jpcrp_cor:NotesRegardingAmountOfRevenueFromContractsWithCustomersTextBlock>
