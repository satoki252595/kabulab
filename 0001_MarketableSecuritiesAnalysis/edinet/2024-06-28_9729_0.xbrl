  <jpcrp_cor:AnnexedConsolidatedDetailedScheduleOfCorporateBondsTextBlock contextRef="CurrentYearDuration">
&lt;h6 class="smt_head5" style="padding-left:31.5pt;line-height:12pt;"&gt;【社債明細表】&lt;/h6&gt;
&lt;div class="tbld" style="margin-left:0pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:483.2pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
&lt;col style="width:47.3pt;min-width:47.3pt;"/&gt;
&lt;col style="width:124.5pt;min-width:124.5pt;"/&gt;
&lt;col style="width:74.3pt;min-width:74.3pt;"/&gt;
&lt;col style="width:49.5pt;min-width:49.5pt;"/&gt;
&lt;col style="width:49.5pt;min-width:49.5pt;"/&gt;
