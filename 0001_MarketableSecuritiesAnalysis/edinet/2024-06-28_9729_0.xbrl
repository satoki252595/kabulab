&lt;td style="vertical-align:bottom;border-top-color:#a9a9a9;border-bottom-color:#a9a9a9;border-left-color:#a9a9a9;border-right-color:#a9a9a9;overflow:hidden;" valign="bottom"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;"&gt;(計画比        111百万円増、&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:bottom;border-top-color:#a9a9a9;border-bottom-color:#a9a9a9;border-left-color:#a9a9a9;border-right-color:#a9a9a9;overflow:hidden;" valign="bottom"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:right;"&gt;9.8％増)&lt;/p&gt;
