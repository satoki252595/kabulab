&lt;td style="vertical-align: middle; width: 79.8px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 4.8px; line-height: 13.333333333333333333333333333px; margin-right: 4.8px; text-align: left"&gt;人材育成&lt;/p&gt;
&lt;p style="margin-left: 4.8px; line-height: 13.333333333333333333333333333px; margin-right: 4.8px; text-align: left"&gt;投資&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 111.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 4.8px; line-height: 13.333333333333333333333333333px; margin-right: 4.8px; text-align: left"&gt;教育研修費&lt;/p&gt;
