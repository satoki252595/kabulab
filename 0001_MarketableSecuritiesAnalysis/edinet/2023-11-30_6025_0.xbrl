&lt;td style="vertical-align: middle; width: 291.2px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 5px; line-height: 14.666666666666666666666666667px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;2017年５月　当社入社&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 5px; line-height: 14.666666666666666666666666667px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;2021年３月　当社FS加盟店事業部企業・技術サポート課課長&lt;/span&gt;
&lt;/p&gt;
