  <jpcrp_cor:NotesRegardingDividendTextBlock contextRef="Prior1YearDuration">
&lt;p style="margin-left: 72px; text-align: left; text-indent: -12px"&gt;４　配当に関する事項&lt;/p&gt;
&lt;p style="margin-left: 84px; text-align: left; text-indent: -12px"&gt;(1）配当金支払額&lt;/p&gt;
