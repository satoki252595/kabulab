&lt;td style="vertical-align: middle; width: 181px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 36px; text-align: right"&gt;209,197&lt;/p&gt;
