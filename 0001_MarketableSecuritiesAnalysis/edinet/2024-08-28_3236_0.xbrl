&lt;td style="vertical-align: top; width: 114px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; line-height: 17.333333333333333333333333333px; text-align: center; text-indent: -6px"&gt;2006年10月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 536px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
