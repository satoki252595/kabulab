&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 133.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 48px; text-align: right"&gt;1,150&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;/div&gt;
&lt;p style="margin-left: 60px; text-align: left"&gt; &lt;/p&gt;
&lt;p style="margin-left: 60px; text-align: left"&gt;（3）退職給付費用&lt;/p&gt;
&lt;div style="margin-left: 72px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 440px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 306.66666666666666666666666667px"/&gt;
&lt;col style="width: 133.33333333333333333333333333px"/&gt;
&lt;/colgroup&gt;
