&lt;td style="vertical-align: middle; width: 142.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 16px; margin-right: 14.666666666666666666666666667px; margin-bottom: 2.6666666666666666666666666667px; margin-top: 2.6666666666666666666666666667px; text-align: right"&gt;
&lt;span style="font-size: 14px"&gt;12.9%&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 142.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 16px; margin-right: 14.666666666666666666666666667px; margin-bottom: 2.6666666666666666666666666667px; margin-top: 2.6666666666666666666666666667px; text-align: right"&gt;
&lt;span style="font-size: 14px"&gt;－&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 33.33px"&gt;
&lt;td style="vertical-align: middle; width: 173.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 14.666666666666666666666666667px; line-height: 16px; margin-bottom: 2.6666666666666666666666666667px; margin-top: 2.6666666666666666666666666667px; text-align: justify; text-justify: inter-ideograph"&gt;
&lt;span style="font-size: 14px"&gt;比率（役員賞与除く）&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 142.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 16px; margin-right: 14.666666666666666666666666667px; margin-bottom: 2.6666666666666666666666666667px; margin-top: 2.6666666666666666666666666667px; text-align: right"&gt;
&lt;span style="font-size: 14px"&gt;87.1%&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 142.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 16px; margin-right: 14.666666666666666666666666667px; margin-bottom: 2.6666666666666666666666666667px; margin-top: 2.6666666666666666666666666667px; text-align: right"&gt;
&lt;span style="font-size: 14px"&gt;12.9%&lt;/span&gt;
&lt;/p&gt;
