&lt;p style="margin-right: 3.3333333333333333333333333333px; text-align: left"&gt; 繰延税金資産&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 200px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-right: 6px; text-align: right"&gt;1,117百万円&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 200px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-right: 6px; text-align: right"&gt;1,870百万円&lt;/p&gt;
