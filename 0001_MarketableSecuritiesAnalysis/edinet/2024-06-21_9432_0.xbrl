&lt;p style="margin-left: 6px; margin-right: 12px; text-align: right"&gt;
&lt;sup&gt;※5&lt;/sup&gt;&lt;span style="font-size: 14px"&gt;&lt;sup&gt; &lt;/sup&gt;&lt;/span&gt;363,645&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 154.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
