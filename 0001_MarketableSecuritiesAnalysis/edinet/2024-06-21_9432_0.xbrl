  <jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock contextRef="FilingDateInstant_jpcrp030000-asr_E04430-000KawazoeKatsuhikoMember">
&lt;p style="line-height: 14.666666666666666666666666667px; text-align: left; text-indent: 5px"&gt;
&lt;span style="font-size: 10px"&gt;1987年 4月　当社入社　&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 56px; line-height: 14.666666666666666666666666667px; text-align: left; text-indent: -50px"&gt;
&lt;span style="font-size: 10px"&gt;2003年 8月　当社 サイバーコミュニケーション総合研究所&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 56px; line-height: 14.666666666666666666666666667px; text-align: left; text-indent: -50px"&gt;
&lt;span style="font-size: 10px"&gt;　　　　　　サイバースペース研究所　主幹研究員&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 31px; line-height: 14.666666666666666666666666667px; text-align: left; text-indent: -25px"&gt;
