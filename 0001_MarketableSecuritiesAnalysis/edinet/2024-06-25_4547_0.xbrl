&lt;col style="width:127pt;min-width:127pt;"/&gt;
&lt;col style="width:120pt;min-width:120pt;"/&gt;
&lt;col style="width:120pt;min-width:120pt;"/&gt;
&lt;col style="width:101pt;min-width:101pt;"/&gt;
&lt;/colgroup&gt;
