&lt;col style="width: 111.6px"/&gt;
&lt;/colgroup&gt;
&lt;thead&gt;
&lt;tr style="height: 18px"&gt;
&lt;td style="vertical-align: middle; width: 223.2px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center"&gt;氏　　名&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 111.6px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-right: 6px; text-align: center"&gt;開催回数&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 111.6px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center"&gt;出席回数&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 111.6px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center"&gt;出席率（％）&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/thead&gt;
