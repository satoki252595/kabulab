&lt;/td&gt;
&lt;td style="vertical-align:top;border-top-color:#a9a9a9;border-right-color:#a9a9a9;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:5.7pt;padding-right:5.7pt;line-height:10pt;font-size:7.5pt;"&gt;当社　執行役　グローバルCTO&lt;/p&gt;
&lt;/td&gt;
