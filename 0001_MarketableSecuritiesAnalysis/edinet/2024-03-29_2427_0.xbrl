&lt;td style="vertical-align: middle; width: 3.3333333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt; &lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
