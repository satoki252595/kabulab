&lt;p style="margin-left: 0.6666666666666666666666666667px; margin-right: 0.6666666666666666666666666667px; text-align: center; line-height: 16px; margin-bottom: 0.6666666666666666666666666667px; margin-top: 0.6666666666666666666666666667px"&gt;財務インパクト※１&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 32px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 0px; margin-right: 0px; text-align: center; line-height: 16px"&gt;発現&lt;/p&gt;
