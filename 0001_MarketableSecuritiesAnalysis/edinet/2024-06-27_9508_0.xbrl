  <jpcrp_cor:AddressOfShareholderTreasurySharesEtc contextRef="CurrentYearInstant_Row4Member">福岡県福津市花見が浜二丁目１番１号</jpcrp_cor:AddressOfShareholderTreasurySharesEtc>
