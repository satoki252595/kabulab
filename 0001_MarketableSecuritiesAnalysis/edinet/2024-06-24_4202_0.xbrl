&lt;td style="vertical-align:bottom;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-color:#000000;overflow:hidden;" valign="bottom"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:3.8pt;padding-right:3.8pt;margin-top:0pt;margin-bottom:0pt;line-height:11.3pt;"&gt;&lt;span style="font-size:7.5pt;"&gt;（連結子会社）&lt;/span&gt;&lt;/p&gt;
