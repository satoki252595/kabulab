&lt;tr style="height: 24px"&gt;
&lt;td style="vertical-align: middle; width: 220.13333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 5.3333333333333333333333333333px; line-height: 18px; margin-right: 6px; text-align: left"&gt;財務活動によるキャッシュ・フロー&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 196px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; line-height: 18px; margin-right: 6px; text-align: right"&gt;△17,247&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 196px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; line-height: 18px; margin-right: 6px; text-align: right"&gt;△48,046&lt;/p&gt;
