&lt;col style="width: 78.666666666666666666666666667px"/&gt;
&lt;col style="width: 66.666666666666666666666666667px"/&gt;
&lt;col style="width: 66.666666666666666666666666667px"/&gt;
&lt;col style="width: 66.666666666666666666666666667px"/&gt;
&lt;col style="width: 46.666666666666666666666666667px"/&gt;
&lt;/colgroup&gt;
&lt;thead&gt;
&lt;tr style="height: 27px"&gt;
