&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;2023年４月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 553.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: justify; text-justify: inter-ideograph"&gt;郊外型ゲストハウス『アマンダンブルー青島』(宮崎県宮崎市)を開店&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 18px"&gt;
&lt;td style="vertical-align: middle; width: 86.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;2023年６月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 553.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: justify; text-justify: inter-ideograph"&gt;東京証券取引所スタンダード市場に株式を上場&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
