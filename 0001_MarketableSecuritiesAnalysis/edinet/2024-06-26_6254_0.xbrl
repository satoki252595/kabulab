&lt;p style="margin-left: 6px; line-height: 16px; text-align: left"&gt;（注）２、３&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 130.13333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
