&lt;col style="width: 195.06666666666666666666666667px"/&gt;
&lt;col style="width: 195.06666666666666666666666667px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr style="height: 3px"&gt;
