&lt;col style="width:172.5pt;min-width:172.5pt;"/&gt;
&lt;col style="width:90.8pt;min-width:90.8pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:17.9pt;min-height:17.9pt;"&gt;
