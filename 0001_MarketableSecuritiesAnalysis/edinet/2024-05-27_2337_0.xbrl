&lt;p style="margin-left: 0px; margin-right: 0px; text-align: center; line-height: 1"&gt;
&lt;img alt="0102010_004.png" src="images/0102010_004.png" style="height: 593.13px; width: 600px"/&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td style="border-left: 0px none #000000; border-top: 0px none #000000; border-right: 0px none #000000; border-bottom: 0px none #000000; width: 602.66666666666666666666666667px; vertical-align: top; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 0px; margin-right: 0px; text-align: center; line-height: 1"&gt;
&lt;img alt="0102010_005.png" src="images/0102010_005.png" style="height: 557px; width: 600px"/&gt;
