&lt;/td&gt;
&lt;td style="vertical-align: top; width: 102.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 12px; text-align: center"&gt;
&lt;img alt="0102010_020.png" src="images/0102010_020.png" style="height: 88px; width: 88px"/&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 102.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 12px; text-align: center"&gt;
&lt;img alt="0102010_021.png" src="images/0102010_021.png" style="height: 88px; width: 88px"/&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 102.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 12px; text-align: center"&gt;
&lt;img alt="0102010_022.png" src="images/0102010_022.png" style="height: 88px; width: 88px"/&gt;
&lt;/p&gt;
