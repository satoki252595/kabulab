&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 35px"&gt;
&lt;td style="vertical-align: top; width: 86.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt;2016年４月&lt;/p&gt;
&lt;p style="text-align: center"&gt;2016年８月&lt;/p&gt;
&lt;p style="text-align: center"&gt; &lt;/p&gt;
&lt;p style="text-align: center"&gt;2016年９月&lt;/p&gt;
&lt;p style="text-align: center"&gt; &lt;/p&gt;
