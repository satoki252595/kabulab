  <jpcrp_cor:NotesLeasesFinancialStatementsTextBlock contextRef="CurrentYearDuration">
&lt;h6&gt;（リース取引関係）&lt;/h6&gt;
&lt;p style="margin-left: 2px; line-height: 21px; text-align: left"&gt;
&lt;span style="font-size: 14px"&gt;１　ファイナンス・リース取引&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 18px; line-height: 21px; text-align: left"&gt;
&lt;span style="font-size: 14px"&gt;　該当事項はありません。&lt;/span&gt;
&lt;/p&gt;
&lt;p style="line-height: 21px; text-align: left"&gt; &lt;/p&gt;
&lt;p style="margin-left: 14px; line-height: 21px; text-align: left; text-indent: -12px"&gt;
&lt;span style="font-size: 14px"&gt;２　オペレーティング・リース取引（借主側）&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 18px; line-height: 21px; text-align: left"&gt;
&lt;span style="font-size: 14px"&gt;　オペレーティング・リース取引のうち解約不能のものに係る未経過リース料&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 18px; line-height: 21px; text-align: left"&gt;
&lt;span style="font-size: 14px"&gt;　該当事項はありません。&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 14px; line-height: 21px; text-align: left; text-indent: -12px"&gt; &lt;/p&gt;
&lt;p style="margin-left: 14px; line-height: 21px; text-align: left; text-indent: -12px"&gt;
&lt;span style="font-size: 14px"&gt;３　オペレーティング・リース取引（貸主側）&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 18px; line-height: 21px; text-align: left"&gt;
&lt;span style="font-size: 14px"&gt;　オペレーティング・リース取引のうち解約不能のものに係る未経過リース料&lt;/span&gt;
&lt;/p&gt;
