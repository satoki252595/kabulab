&lt;/div&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;"&gt; &lt;/p&gt;</jpcrp_cor:NotesRegardingAmountsOfNotesAndAccountsReceivableTradeAndContractAssetsTextBlock>
  <jpcrp_cor:NotesRegardingInventoriesTextBlock contextRef="CurrentYearInstant">&lt;p class="smt_text1" style="orphans:0;widows:0;"&gt;※２　棚卸資産の内訳&lt;/p&gt;
&lt;div class="tbld" style="margin-left:30.1pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:438.3pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
