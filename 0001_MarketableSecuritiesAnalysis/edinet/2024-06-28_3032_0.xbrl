  <jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E03474-000MatsudaYoshihisaMember">松田　芳久</jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E03474-000MatsudaYoshihisaMember">1958-08-21</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
