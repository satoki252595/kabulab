  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E03474-000SakumaIsaoMember">1974-12-16</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock contextRef="FilingDateInstant_jpcrp030000-asr_E03474-000SakumaIsaoMember">
&lt;p style="margin-left: 60.666666666666666666666666667px; line-height: 13.666666666666666666666666667px; margin-right: 5px; text-align: left; text-indent: -55.666666666666666666666666667px"&gt;
&lt;span style="font-size: 10px"&gt;2000年６月 株式会社アサヒトレーディング入社&lt;/span&gt;
&lt;/p&gt;
