&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 196.06666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; line-height: 16.666666666666666666666666667px; text-align: justify; text-justify: inter-ideograph"&gt;株式会社ゴルフ・ドゥ&lt;/p&gt;
&lt;p style="line-height: 16.666666666666666666666666667px; text-align: center"&gt;埼玉県公安委員会&lt;/p&gt;
&lt;p style="line-height: 16.666666666666666666666666667px; text-align: center"&gt; &lt;/p&gt;
&lt;p style="margin-left: 6px; line-height: 16.666666666666666666666666667px; text-align: justify; text-justify: inter-ideograph"&gt;スクエアツウ・ジャパン株式会社&lt;/p&gt;
&lt;p style="line-height: 16.666666666666666666666666667px; text-align: center"&gt;埼玉県公安委員会&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 185.26666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 16.666666666666666666666666667px; text-align: center"&gt; &lt;/p&gt;
&lt;p style="line-height: 16.666666666666666666666666667px; text-align: center"&gt;第431010007249号&lt;/p&gt;
&lt;p style="line-height: 16.666666666666666666666666667px; text-align: center"&gt; &lt;/p&gt;
&lt;p style="line-height: 16.666666666666666666666666667px; text-align: center"&gt; &lt;/p&gt;
&lt;p style="line-height: 16.666666666666666666666666667px; text-align: center"&gt;第431060030268号&lt;/p&gt;
