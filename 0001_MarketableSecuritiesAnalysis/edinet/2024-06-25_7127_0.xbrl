&lt;h5 class="smt_head4"&gt;② 【自己株式等】&lt;/h5&gt;&lt;p class="smt_text4" style="orphans:0;widows:0;padding-left:31.5pt;"&gt;該当事項はありません。&lt;/p&gt;&lt;p class="smt_text4" style="orphans:0;widows:0;text-align:justify;padding-left:31.5pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:9pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;font-size:15pt;"&gt; &lt;/p&gt;</jpcrp_cor:TreasurySharesEtcTextBlock>
  <jpcrp_cor:ClassesOfSharesEtcTextBlock contextRef="FilingDateInstant">&lt;p class="smt_head6" style="orphans:0;widows:0;line-height:3pt;font-size:3pt;"&gt; &lt;/p&gt;
&lt;div class="tbld" style="margin-left:29.3pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
