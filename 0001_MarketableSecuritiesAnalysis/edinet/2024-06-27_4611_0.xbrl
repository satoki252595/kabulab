  <jpcrp_cor:ShareholdingByShareholderCategoryTextBlock contextRef="FilingDateInstant">
&lt;h4&gt;（５）【所有者別状況】&lt;/h4&gt;
&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 647.8px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 85px"/&gt;
&lt;col style="width: 70.466666666666666666666666667px"/&gt;
&lt;col style="width: 55px"/&gt;
&lt;col style="width: 63.466666666666666666666666667px"/&gt;
&lt;col style="width: 59.733333333333333333333333333px"/&gt;
&lt;col style="width: 59.2px"/&gt;
&lt;col style="width: 60px"/&gt;
&lt;col style="width: 68.733333333333333333333333333px"/&gt;
&lt;col style="width: 54.2px"/&gt;
&lt;col style="width: 72px"/&gt;
