&lt;p style="margin-left: 78.666666666666666666666666667px; line-height: 16px; text-align: left; text-indent: -21.333333333333333333333333333px"&gt;２．市場価格のない株式等&lt;/p&gt;
&lt;div style="margin-left: 63.466666666666666666666666667px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 591.99999999999999999999999999px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 152.53333333333333333333333333px"/&gt;
&lt;col style="width: 219.73333333333333333333333333px"/&gt;
&lt;col style="width: 219.73333333333333333333333333px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr style="height: 16px"&gt;
&lt;td style="vertical-align: bottom; width: 152.53333333333333333333333333px; padding-top: 1px; padding-bottom: 0px; padding-left: 1px; padding-right: 1px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 16px; text-align: center"&gt;区分&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: bottom; width: 219.73333333333333333333333333px; padding-top: 1px; padding-bottom: 0px; padding-left: 1px; padding-right: 1px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
