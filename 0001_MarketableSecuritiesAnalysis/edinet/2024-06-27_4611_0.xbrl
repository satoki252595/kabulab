  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E00891-000NaganoTatsuhikoMember">1963-09-22</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock contextRef="FilingDateInstant_jpcrp030000-asr_E00891-000NaganoTatsuhikoMember">
&lt;p style="margin-left: 75px; line-height: 13.666666666666666666666666667px; margin-right: 5px; text-align: left; text-indent: -70px"&gt;
&lt;span style="font-size: 10px"&gt;1987年４月　株式会社三菱銀行［現　株式会社&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 75px; line-height: 13.666666666666666666666666667px; margin-right: 5px; text-align: left; text-indent: -70px"&gt;
&lt;span style="font-size: 10px"&gt;　　　　　　三菱ＵＦＪ銀行］入行&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 75px; line-height: 13.666666666666666666666666667px; margin-right: 5px; text-align: left; text-indent: -70px"&gt;
&lt;span style="font-size: 10px"&gt;2012年５月　同行営業第二本部営業第五部長&lt;/span&gt;
