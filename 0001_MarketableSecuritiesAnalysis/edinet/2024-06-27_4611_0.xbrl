&lt;tr style="height: 16px"&gt;
&lt;td style="vertical-align: bottom; width: 152.53333333333333333333333333px; padding-top: 1px; padding-bottom: 0px; padding-left: 1px; padding-right: 1px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 16px; text-align: center"&gt;非上場株式&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: bottom; width: 219.73333333333333333333333333px; padding-top: 1px; padding-bottom: 0px; padding-left: 1px; padding-right: 1px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
