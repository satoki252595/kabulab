&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:3.7pt;padding-right:3.7pt;font-size:7.5pt;"&gt;粉砕・分級装置&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:3.7pt;padding-right:3.7pt;font-size:7.5pt;"&gt;微粉砕機（ACMパルベライザ、グラシス等）&lt;br/&gt;超微粉砕機（ACMパルベライザCR、カウンタジェットミルAFG、プルビス等）&lt;br/&gt;分級機（ミクロンセパレータ、ターボプレックス、セラサス等）&lt;/p&gt;
&lt;/td&gt;
