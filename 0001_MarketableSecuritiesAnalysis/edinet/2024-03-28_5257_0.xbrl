</jpcrp030000-asr_E38335-000:MetricsAndTargetsTextBlock>
  <jpcrp030000-asr_E38335-000:DescriptionOfMetricsRelatedToPolicyOnHumanResourceDevelopmentAndImprovementOfInternalEnvironmentAndTargetsAndResultsUsingSuchMetricsMetricsAndTargetsTextBlock contextRef="FilingDateInstant">
