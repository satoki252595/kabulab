&lt;tr style="height: 26.67px"&gt;
&lt;td style="vertical-align: middle; width: 96px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt;2022年11月&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 528px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 12px; text-align: justify; text-justify: inter-ideograph"&gt;東京証券取引所グロース市場に株式を上場&lt;/p&gt;
&lt;/td&gt;
