&lt;td rowspan="2" style="vertical-align: middle; width: 66px; padding-top: 0px; padding-bottom: 0px; padding-left: 7.2px; padding-right: 7.2px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 17.333333333333333333333333333px; text-align: left"&gt;調整後&lt;/p&gt;
&lt;p style="line-height: 17.333333333333333333333333333px; text-align: left"&gt;行使価額&lt;/p&gt;
&lt;/td&gt;
