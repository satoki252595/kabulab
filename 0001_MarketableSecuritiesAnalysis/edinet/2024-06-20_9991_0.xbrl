&lt;td style="vertical-align:top;border-top-color:#a9a9a9;border-bottom-color:#a9a9a9;border-left-color:#a9a9a9;border-right-color:#a9a9a9;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:9pt;line-height:13.5pt;"&gt;仙台営業所(現 東北支店)開設&lt;/p&gt;
&lt;/td&gt;
