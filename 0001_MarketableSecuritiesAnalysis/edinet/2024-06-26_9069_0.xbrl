&lt;p style="margin-left: 12px; text-align: left"&gt;　　合　計&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 197.6px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 18px; text-align: right"&gt;100&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 197.6px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
