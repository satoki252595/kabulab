&lt;tbody&gt;
&lt;tr style="height: 27px"&gt;
&lt;td style="vertical-align: middle; width: 324px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 48px; text-align: left; text-indent: -12px"&gt;指定有限責任社員　業務執行社員　荒井　　　巌&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 191px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt;４年&lt;/p&gt;
&lt;/td&gt;
