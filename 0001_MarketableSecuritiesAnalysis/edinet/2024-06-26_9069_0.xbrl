&lt;td style="vertical-align: middle; width: 173.86666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 24px; margin-right: 6px; text-align: left"&gt;東京都江東区&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 147.86666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 24px; margin-right: 6px; text-align: left"&gt;建物&lt;/p&gt;
