&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 280.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 12px; line-height: 17.333333333333333333333333333px; margin-right: 6.6666666666666666666666666667px; text-align: left"&gt;18,413,123 [18,621,974]　(注)２&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 27px"&gt;
&lt;td style="vertical-align: middle; width: 356.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 12px; line-height: 17.333333333333333333333333333px; margin-right: 12px; text-align: left"&gt;新株予約権の行使時の払込金額　（円）(注)１&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 280.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 12px; line-height: 17.333333333333333333333333333px; margin-right: 6.6666666666666666666666666667px; text-align: left"&gt;１株当たり 1,194.80 [1,181.40]　(注)３&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 35px"&gt;
&lt;td style="vertical-align: middle; width: 356.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 12px; line-height: 17.333333333333333333333333333px; margin-right: 12px; text-align: left"&gt;新株予約権の行使期間(注)１&lt;/p&gt;
