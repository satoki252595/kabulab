&lt;td rowspan="2" style="vertical-align:middle;border-top-color:#000000;border-bottom-color:#000000;border-left-color:#000000;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:6.9pt;padding-right:5.4pt;margin-top:0pt;margin-bottom:0.0pt;line-height:14pt;"&gt;連結ROE&lt;/p&gt;
