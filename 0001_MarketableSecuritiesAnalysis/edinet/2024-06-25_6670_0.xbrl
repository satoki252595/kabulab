  <jpcrp_cor:ConsolidatedSubsidiariesMetricsOfConsolidatedSubsidiaries contextRef="CurrentYearInstant_Row3Member">㈱アユート</jpcrp_cor:ConsolidatedSubsidiariesMetricsOfConsolidatedSubsidiaries>
