&lt;/td&gt;
&lt;td rowspan="2" style="vertical-align:middle;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-color:#000000;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblR" style="orphans:0;widows:0;text-align:center;"&gt;&lt;span style="font-size:9pt;"&gt;＋&lt;/span&gt;&lt;/p&gt;
