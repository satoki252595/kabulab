&lt;/tr&gt;
&lt;tr style="height:17.9pt;min-height:17.9pt;"&gt;
&lt;td style="vertical-align:top;border-top-color:#a9a9a9;border-bottom-color:#a9a9a9;border-left-color:#a9a9a9;border-right-color:#a9a9a9;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:18pt;padding-right:0pt;line-height:18pt;"&gt;事業年度(&lt;span&gt;第159期&lt;/span&gt;)(自  &lt;span&gt;2022年４月１日&lt;/span&gt;  至  &lt;span&gt;2023年３月31日&lt;/span&gt;)&lt;/p&gt;
