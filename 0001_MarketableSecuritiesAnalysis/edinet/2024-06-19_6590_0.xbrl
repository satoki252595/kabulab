  <jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E01757-000ImamuraKeigoMember">今村　圭吾</jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E01757-000ImamuraKeigoMember">1962-09-30</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock contextRef="FilingDateInstant_jpcrp030000-asr_E01757-000ImamuraKeigoMember">
&lt;p style="margin-left: 60px; line-height: 14px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;1985年４月 ㈱東芝入社&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 60px; line-height: 14px; text-align: left; text-indent: -55px"&gt;
&lt;span style="font-size: 10px"&gt;1996年８月 当社入社&lt;/span&gt;
&lt;/p&gt;
