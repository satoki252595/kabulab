&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:24.0pt;min-height:24.0pt;"&gt;
&lt;td style="vertical-align:middle;border-left-style:solid;border-left-width:0.75pt;border-right-style:solid;border-right-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:27.0pt;padding-right:9.1pt;"&gt;株主名簿管理人&lt;/p&gt;
