&lt;p style="margin-left: 12px; text-align: left"&gt;販売用不動産&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 109px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-right: 12px; text-align: right"&gt;196,439千円&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 18px"&gt;
&lt;td style="vertical-align: top; width: 157px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 12px; text-align: left"&gt;仕掛販売用不動産&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 109px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-right: 12px; text-align: right"&gt;174,719千円&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 18px"&gt;
&lt;td style="vertical-align: top; width: 157px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 12px; text-align: left"&gt;投資有価証券&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 109px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-right: 12px; text-align: right"&gt;40,000千円&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;/div&gt;
&lt;p style="text-align: left; text-indent: 12px"&gt; &lt;/p&gt;
&lt;p style="margin-left: 60px; text-align: left"&gt;当連結会計年度（2024年２月29日）&lt;/p&gt;
