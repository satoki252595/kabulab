  <jpcrp_cor:NotesRegardingImpairmentLossTextBlock contextRef="CurrentYearDuration">&lt;p style="page-break-before:always; line-height:0.75pt; width:100%; font-size:0.75pt;"&gt; &lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:0pt;padding-right:10pt;margin-top:0pt;margin-bottom:0pt;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:13pt;font-size:10.5pt;"&gt;&lt;span style="font-family:&amp;apos;ＭＳ 明朝&amp;apos;;font-size:9pt;"&gt;※３&lt;/span&gt;　&lt;span style="font-size:9pt;"&gt;減損損失&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:21pt;padding-right:10pt;margin-top:0pt;margin-bottom:0pt;text-indent:10.5pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:13pt;font-size:10.5pt;"&gt;&lt;span style="font-family:&amp;apos;ＭＳ 明朝&amp;apos;;font-size:9pt;"&gt;当社グループは以下の資産グループについて減損損失を計上いたしました。&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:21pt;padding-right:10pt;margin-top:0pt;margin-bottom:0pt;text-indent:10.5pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:13pt;font-size:9pt;"&gt;&lt;span style="font-size:9pt;"&gt;前連結会計年度（自　&lt;/span&gt;&lt;span&gt;&lt;span style="font-size:9pt;"&gt;2022年４月１日&lt;/span&gt;&lt;/span&gt;&lt;span style="font-size:9pt;"&gt;　至　&lt;/span&gt;&lt;span&gt;&lt;span style="font-size:9pt;"&gt;2023年３月31日&lt;/span&gt;&lt;/span&gt;&lt;span style="font-size:9pt;"&gt;）&lt;/span&gt;&lt;/p&gt;
