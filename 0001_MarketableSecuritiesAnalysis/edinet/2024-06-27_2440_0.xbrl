&lt;col style="width:43pt;min-width:43pt;"/&gt;
&lt;col style="width:103pt;min-width:103pt;"/&gt;
&lt;col style="width:43pt;min-width:43pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:33.8pt;min-height:33.8pt;"&gt;
