&lt;p style="line-height: 13.333333333333333333333333333px; text-align: justify; text-justify: inter-ideograph"&gt;
&lt;span style="font-size: 12px"&gt; &lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
