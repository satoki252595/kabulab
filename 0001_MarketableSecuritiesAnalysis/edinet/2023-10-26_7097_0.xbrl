&lt;/tr&gt;
&lt;tr style="height: 28.13px"&gt;
&lt;td style="vertical-align: middle; width: 95.06666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
