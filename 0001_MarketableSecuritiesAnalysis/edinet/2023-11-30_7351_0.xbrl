&lt;/td&gt;
&lt;td rowspan="2" style="vertical-align:middle;border-bottom-style:solid;border-bottom-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;"&gt;&lt;span style="font-family:&amp;apos;ＭＳ 明朝&amp;apos;;"&gt;既発行株式数&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
