&lt;tr style="height:18.0pt;min-height:18.0pt;"&gt;
&lt;td style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:0pt;padding-right:0pt;line-height:11pt;"&gt;&lt;span style="font-size:9pt;"&gt;1975年10月&lt;/span&gt;&lt;/p&gt;
