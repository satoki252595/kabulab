&lt;/div&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;"&gt; &lt;/p&gt;&lt;p class="smt_text5" style="orphans:0;widows:0;"&gt; &lt;/p&gt;</jpcrp_cor:NotesRegardingTradeNotesReceivableDiscountedOrTransferredByEndorsementTextBlock>
  <jpcrp_cor:NotesRegardingGainOnSalesOfPropertyPlantAndEquipmentTextBlock contextRef="CurrentYearDuration_NonConsolidatedMember">&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:0pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;"&gt;※２　固定資産売却益の内訳は次のとおりであります。&lt;/p&gt;
&lt;div class="tbld" style="margin-left:30.1pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:451.9pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
&lt;col style="width:159.9pt;min-width:159.9pt;"/&gt;
&lt;col style="width:94pt;min-width:94pt;"/&gt;
&lt;col style="width:52pt;min-width:52pt;"/&gt;
&lt;col style="width:94pt;min-width:94pt;"/&gt;
&lt;col style="width:52pt;min-width:52pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:34pt;min-height:34pt;"&gt;
