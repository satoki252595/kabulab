&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center; line-height: 17.333333333333333333333333333px"&gt;＝&lt;/p&gt;
&lt;/td&gt;
&lt;td rowspan="2" style="border-left: 0px none #000000; border-top: 0px none #000000; border-right: 0px none #000000; border-bottom: 0px none #000000; width: 103px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center; line-height: 17.333333333333333333333333333px"&gt;調整前行使価額&lt;/p&gt;
&lt;/td&gt;
&lt;td rowspan="2" style="border-left: 0px none #000000; border-top: 0px none #000000; border-right: 0px none #000000; border-bottom: 0px none #000000; width: 25px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center; line-height: 17.333333333333333333333333333px"&gt;×&lt;/p&gt;
