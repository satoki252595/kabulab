&lt;tr style="height: 18px"&gt;
&lt;td style="vertical-align: middle; width: 284px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 24px; margin-right: 3.3333333333333333333333333333px; text-align: left"&gt;商品及び製品（配給権及び制作品を含む）&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 176px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-right: 12px; text-align: right"&gt;
3,970百万円&lt;/p&gt;
&lt;/td&gt;
