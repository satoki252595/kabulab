&lt;p style="text-align: left"&gt; &lt;/p&gt;
</jpcrp030000-asr_E37987-000:StrategyTextBlock>
  <jpcrp030000-asr_E37987-000:PolicyOnHumanResourceDevelopmentAndImprovementOfInternalEnvironmentStrategyTextBlock contextRef="FilingDateInstant">
