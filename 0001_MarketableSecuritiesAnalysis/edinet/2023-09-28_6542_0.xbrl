&lt;col style="width:59.4pt;min-width:59.4pt;"/&gt;
&lt;col style="width:59.4pt;min-width:59.4pt;"/&gt;
&lt;col style="width:59.4pt;min-width:59.4pt;"/&gt;
&lt;col style="width:59.4pt;min-width:59.4pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:17.9pt;min-height:17.9pt;"&gt;
