&lt;col style="width:13.6pt;min-width:13.6pt;"/&gt;
&lt;col style="width:55pt;min-width:55pt;"/&gt;
&lt;col style="width:13.6pt;min-width:13.6pt;"/&gt;
&lt;col style="width:185.7pt;min-width:185.7pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr&gt;
&lt;td rowspan="3" style="vertical-align:middle;border-top-color:#000000;border-bottom-color:#000000;border-left-color:#000000;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:0pt;padding-right:0pt;line-height:13pt;"&gt; &lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:0pt;padding-right:0pt;line-height:13pt;"&gt;調整後払込金額&lt;/p&gt;
&lt;/td&gt;
&lt;td rowspan="3" style="vertical-align:middle;border-top-color:#000000;border-bottom-color:#000000;border-left-color:#000000;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:0pt;padding-right:0pt;line-height:13pt;"&gt; &lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:0pt;padding-right:0pt;line-height:13pt;"&gt;＝&lt;/p&gt;
