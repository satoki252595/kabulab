&lt;td style="vertical-align:middle;border-top-color:#a9a9a9;border-bottom-color:#a9a9a9;border-left-color:#a9a9a9;border-right-color:#a9a9a9;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:0pt;padding-right:0pt;line-height:12pt;font-size:10.5pt;"&gt;&lt;b&gt;リース：キャッシュ・フロー&lt;/b&gt;&lt;/p&gt;
&lt;/td&gt;
