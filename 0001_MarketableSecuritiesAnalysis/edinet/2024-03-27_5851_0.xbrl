&lt;/div&gt;
&lt;p style="line-height: 1; text-align: left"&gt; &lt;/p&gt;
&lt;p style="margin-left: 8px; line-height: 1; text-align: left; text-indent: 28.333333333333333333333333333px"&gt;b．健康について&lt;/p&gt;
&lt;div style="margin-left: 28.266666666666666666666666667px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 579.2px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 307.2px"/&gt;
&lt;col style="width: 272px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 307.2px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: center; line-height: 1"&gt;指標&lt;/p&gt;
&lt;/td&gt;
