&lt;td style="vertical-align: middle; width: 276px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 12px; text-align: left"&gt;長期期待運用収益率&lt;/p&gt;
&lt;p style="margin-left: 12px; text-align: left"&gt;予想昇給率&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 158px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-right: 24px; text-align: right"&gt;3.0～7.0％&lt;/p&gt;
&lt;p style="margin-right: 24px; text-align: right"&gt;1.4～10.0％&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 158px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-right: 24px; text-align: right"&gt;3.0～7.0％&lt;/p&gt;
&lt;p style="margin-right: 24px; text-align: right"&gt;1.6～10.2％&lt;/p&gt;
