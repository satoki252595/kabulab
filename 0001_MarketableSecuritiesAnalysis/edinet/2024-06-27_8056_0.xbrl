&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 405.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: left"&gt;当社取締役                     　 　　　 　5人&lt;/p&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: left"&gt;当社使用人（執行役員）        　　　　　  13人&lt;/p&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: left"&gt;当社子会社取締役　　　　　　　　　　　　　 3人&lt;/p&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: left"&gt;当社子会社使用人（執行役員）        　　   6人&lt;/p&gt;
&lt;/td&gt;
