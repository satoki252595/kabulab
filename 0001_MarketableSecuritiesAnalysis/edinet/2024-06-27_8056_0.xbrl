&lt;span style="font-size: 14px"&gt;2020年 7月 1日&lt;/span&gt;
&lt;/p&gt;
&lt;p style="line-height: 19.333333333333333333333333333px; text-align: left"&gt;
&lt;span style="font-size: 14px"&gt;2021年 5月25日&lt;/span&gt;
&lt;/p&gt;
&lt;p style="line-height: 19.333333333333333333333333333px; text-align: left"&gt;
&lt;span style="font-size: 14px"&gt;2022年 4月 1日&lt;/span&gt;
&lt;/p&gt;
