  <jpcrp_cor:NotesRegardingDividendTextBlock contextRef="CurrentYearDuration">
&lt;p style="margin-left: 72px; text-align: left; text-indent: -12px"&gt;２　配当に関する事項&lt;/p&gt;
&lt;p style="margin-left: 84px; text-align: left; text-indent: -12px"&gt;(1）配当金支払額&lt;/p&gt;
&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 588.93333333333333333333333333px; margin-left: auto"&gt;
