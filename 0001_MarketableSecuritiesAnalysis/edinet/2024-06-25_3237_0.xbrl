&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:12pt;min-height:12pt;"&gt;
&lt;td style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:26pt;padding-right:4.5pt;margin-top:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:0pt;letter-spacing:0pt;line-height:12pt;font-size:9pt;"&gt;&lt;span style="font-size:9pt;"&gt;③資本準備金の増加額&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
