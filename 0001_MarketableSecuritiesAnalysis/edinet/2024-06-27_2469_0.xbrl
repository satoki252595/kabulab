&lt;/td&gt;
&lt;td style="vertical-align: top; width: 104px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="line-height: 15.466666666666666666666666667px; margin-right: 36px; text-align: right"&gt;900,000千円&lt;/p&gt;
