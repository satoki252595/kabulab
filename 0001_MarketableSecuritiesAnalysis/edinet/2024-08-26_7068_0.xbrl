  <jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E34995-000TsukadaKojiMember">塚田　耕司</jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E34995-000TsukadaKojiMember">1968-07-05</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
  <jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock contextRef="FilingDateInstant_jpcrp030000-asr_E34995-000TsukadaKojiMember">
&lt;p style="margin-left: 65px; line-height: 13.333333333333333333333333333px; margin-right: 3px; margin-top: 1.3333333333333333333333333333px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;1992年４月　安田信託銀行㈱（現　みずほ信託銀行㈱）　入行&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 13.333333333333333333333333333px; margin-right: 3px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;1996年10月　㈱ルートコミュニケーションズ設立&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 13.333333333333333333333333333px; margin-right: 3px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;　　　　　　代表取締役就任&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 13.333333333333333333333333333px; margin-right: 3px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;2006年３月　当社設立　代表取締役社長就任（現任）&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 13.333333333333333333333333333px; margin-right: 3px; margin-bottom: 1.3333333333333333333333333333px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;2020年２月　アナグラム㈱　取締役就任（現任）&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 13.333333333333333333333333333px; margin-right: 3px; margin-bottom: 1.3333333333333333333333333333px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;2021年６月　㈱フィードフォース分割準備会社（現㈱フィードフォース）代表取締役就任（現任）&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 13.333333333333333333333333333px; margin-right: 3px; margin-bottom: 1.3333333333333333333333333333px; text-align: left; text-indent: -60px"&gt;
