&lt;col style="width:66pt;min-width:66pt;"/&gt;
&lt;col style="width:15pt;min-width:15pt;"/&gt;
&lt;col style="width:66pt;min-width:66pt;"/&gt;
&lt;col style="width:15pt;min-width:15pt;"/&gt;
&lt;col style="width:75pt;min-width:75pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:15pt;min-height:15pt;"&gt;
&lt;td rowspan="2" style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;padding-left:1.5pt;padding-right:1.5pt;margin-top:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:12pt;"&gt;調整後払込金額&lt;/p&gt;
&lt;/td&gt;
