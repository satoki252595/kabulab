&lt;tr style="height: 26.67px"&gt;
&lt;td style="vertical-align: middle; width: 166.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p class="text_align_justify" style="margin-left: 6px; margin-right: 6px"&gt;黒田　愛&lt;/p&gt;
