&lt;p style="line-height: 17.333333333333333333333333333px; margin-right: 24px; text-align: right"&gt;631,668&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 33.33px"&gt;
&lt;td style="vertical-align: middle; width: 313.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 12px; line-height: 17.333333333333333333333333333px; margin-right: 12px; text-align: left"&gt;当該期間の権利行使に係る平均行使価額等（円）&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 167.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 17.333333333333333333333333333px; margin-right: 24px; text-align: right"&gt;2,122&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 167.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 17.333333333333333333333333333px; margin-right: 24px; text-align: right"&gt;2,122&lt;/p&gt;
&lt;/td&gt;
