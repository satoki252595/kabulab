&lt;/td&gt;
&lt;td colspan="5" style="vertical-align: middle; width: 234px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="text-align: center"&gt;時価&lt;/p&gt;
&lt;/td&gt;
