&lt;td style="vertical-align:middle;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:9pt;padding-right:0pt;line-height:10.5pt;"&gt;&lt;span style="font-size:7.5pt;"&gt;日本弁護士連合会常務理事&lt;/span&gt;&lt;/p&gt;
