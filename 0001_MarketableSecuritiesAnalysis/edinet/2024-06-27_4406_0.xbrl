  <jpcrp_cor:NotesRegardingAmountOfContractLiabilitiesTextBlock contextRef="CurrentYearInstant">
&lt;p style="margin-left: 84px; text-align: left; text-indent: -24px"&gt;※３　流動負債のその他のうち、契約負債の金額&lt;/p&gt;
&lt;div style="margin-left: 66px"&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 587px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 227px"/&gt;
&lt;col style="width: 180px"/&gt;
&lt;col style="width: 180px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr style="height: 40px"&gt;
&lt;td style="vertical-align: middle; width: 227px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;
&lt;span style="font-size: 12px"&gt; &lt;/span&gt;
