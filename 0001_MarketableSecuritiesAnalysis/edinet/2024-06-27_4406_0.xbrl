&lt;td style="vertical-align: top; width: 143px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 24px; margin-right: 4px; text-align: left; text-indent: -24px"&gt;(2）内部統制報告書及びその添付書類&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 169px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 24px; text-align: center"&gt;事業年度&lt;/p&gt;
&lt;p style="margin-left: 24px; text-align: center"&gt;（第151期）&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 132px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="text-align: left"&gt;自　2022年４月１日&lt;/p&gt;
