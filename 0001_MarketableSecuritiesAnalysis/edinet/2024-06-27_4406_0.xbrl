&lt;tr style="height: 1.33px"&gt;
&lt;td style="vertical-align: middle; width: 110px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;

&lt;p style="line-height: 15px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;代表取締役&lt;/span&gt;
&lt;/p&gt;
&lt;p style="line-height: 15px; text-align: center"&gt;
