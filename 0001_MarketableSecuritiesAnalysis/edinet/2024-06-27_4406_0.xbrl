&lt;td style="vertical-align: top; width: 201.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 5px; margin-right: 3px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;at FOREST㈱社外取締役（現任）&lt;/span&gt;
&lt;/p&gt;
