  <jpcrp_cor:NameOfShareholderTreasurySharesEtc contextRef="CurrentYearInstant_Row1Member">株式会社買取王国 </jpcrp_cor:NameOfShareholderTreasurySharesEtc>
  <jpcrp_cor:AddressOfShareholderTreasurySharesEtc contextRef="CurrentYearInstant_Row1Member">名古屋市港区川西通５丁目12番地</jpcrp_cor:AddressOfShareholderTreasurySharesEtc>
  <jpcrp_cor:ClassesOfSharesEtcTextBlock contextRef="FilingDateInstant">&lt;p class="smt_head3" style="orphans:0;widows:0;padding-left:9pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-justify:inter-ideograph;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;text-align:justify;letter-spacing:0pt;line-height:15pt;font-size:9pt;"&gt;【株式の種類等】&lt;/p&gt;&lt;p class="smt_text2" style="orphans:0;widows:0;padding-left:18pt;"&gt;会社法第155条第13号による普通株式の取得です。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:0pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:10pt;font-size:10pt;"&gt; &lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:0pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:10pt;font-size:10pt;"&gt; &lt;/p&gt;</jpcrp_cor:ClassesOfSharesEtcTextBlock>
  <jpcrp_cor:AcquisitionsByResolutionOfShareholdersMeetingTextBlock contextRef="FilingDateInstant">
&lt;h4 class="smt_head3"&gt;(１) 【株主総会決議による取得の状況】&lt;/h4&gt;&lt;p class="smt_text2" style="orphans:0;widows:0;padding-left:18pt;"&gt;該当事項はありません。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;"&gt; &lt;/p&gt;</jpcrp_cor:AcquisitionsByResolutionOfShareholdersMeetingTextBlock>
  <jpcrp_cor:AcquisitionsByResolutionOfBoardOfDirectorsMeetingTextBlock contextRef="FilingDateInstant">
&lt;h4 class="smt_head3"&gt;(２) 【取締役会決議による取得の状況】&lt;/h4&gt;&lt;p class="smt_text2" style="orphans:0;widows:0;padding-left:18pt;"&gt;該当事項はありません。&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;"&gt; &lt;/p&gt;</jpcrp_cor:AcquisitionsByResolutionOfBoardOfDirectorsMeetingTextBlock>
