  <jpcrp_cor:NotesRegardingIssuedSharesAndTreasurySharesTextBlock contextRef="CurrentYearDuration_NonConsolidatedMember">&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:13.5pt;line-height:14pt;"&gt;１.  発行済株式に関する事項&lt;/p&gt;
