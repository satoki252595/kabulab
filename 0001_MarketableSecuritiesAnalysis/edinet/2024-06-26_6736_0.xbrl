&lt;col style="width:42pt;min-width:42pt;"/&gt;
&lt;col style="width:43.5pt;min-width:43.5pt;"/&gt;
&lt;col style="width:42pt;min-width:42pt;"/&gt;
&lt;col style="width:60pt;min-width:60pt;"/&gt;
&lt;col style="width:71.3pt;min-width:71.3pt;"/&gt;
