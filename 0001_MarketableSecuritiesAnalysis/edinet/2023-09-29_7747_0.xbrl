  <jpcrp_cor:NotesPerShareInformationConsolidatedFinancialStatementsTextBlock contextRef="CurrentYearDuration">&lt;p style="page-break-before:always; line-height:0.75pt; width:100%; font-size:0.75pt;"&gt; &lt;/p&gt;
&lt;h6 class="smt_head5" style="padding-left:9pt;"&gt;(１株当たり情報)&lt;/h6&gt;
&lt;div class="tbld" style="text-align:left;"&gt;
&lt;table cellpadding="0" cellspacing="0" class="align_left" style="border-collapse:collapse;border:solid 0pt #000000;width:468.0pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
&lt;col style="width:234.0pt;min-width:234.0pt;"/&gt;
&lt;col style="width:234.0pt;min-width:234.0pt;"/&gt;
