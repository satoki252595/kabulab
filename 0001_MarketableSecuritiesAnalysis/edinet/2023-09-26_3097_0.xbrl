&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 173.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6.6666666666666666666666666667px; line-height: 17.333333333333333333333333333px; margin-right: 6.6666666666666666666666666667px; text-align: left"&gt;１店目         　   5.00％&lt;/p&gt;
