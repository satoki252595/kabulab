  <jpcrp_cor:NameOfShareholderTreasurySharesEtc contextRef="CurrentYearInstant_Row1Member">株式会社物語コーポレーション</jpcrp_cor:NameOfShareholderTreasurySharesEtc>
  <jpcrp_cor:AddressOfShareholderTreasurySharesEtc contextRef="CurrentYearInstant_Row1Member">愛知県豊橋市西岩田五丁目７番地の11</jpcrp_cor:AddressOfShareholderTreasurySharesEtc>
