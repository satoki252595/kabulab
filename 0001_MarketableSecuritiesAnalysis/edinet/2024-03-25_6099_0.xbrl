&lt;p style="margin-left: 24px; line-height: 17.333333333333333333333333333px; text-align: right"&gt;2023年12月31日現在&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;/div&gt;
&lt;p style="line-height: 1.3333333333333333333333333333px; text-align: left"&gt; &lt;/p&gt;
&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 647.93333333333333333333333334px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 100.46666666666666666666666667px"/&gt;
