&lt;col style="width: 61.4px"/&gt;
&lt;col style="width: 61.466666666666666666666666667px"/&gt;
&lt;/colgroup&gt;
&lt;thead&gt;
&lt;tr style="height: 16.2px"&gt;
&lt;td colspan="2" rowspan="2" style="vertical-align: middle; width: 96px; padding-top: 2.6666666666666666666666666667px; padding-bottom: 2.6666666666666666666666666667px; padding-left: 2.6666666666666666666666666667px; padding-right: 2.6666666666666666666666666667px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #999999"&gt;
&lt;p style="text-align: center"&gt;区分&lt;/p&gt;
&lt;/td&gt;
&lt;td colspan="2" style="vertical-align: bottom; width: 424px; padding-top: 2.6666666666666666666666666667px; padding-bottom: 2.6666666666666666666666666667px; padding-left: 2.6666666666666666666666666667px; padding-right: 2.6666666666666666666666666667px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #999999"&gt;
&lt;p style="text-align: center"&gt;事業インパクト&lt;/p&gt;
&lt;/td&gt;
&lt;td colspan="2" style="vertical-align: bottom; width: 122.86666666666666666666666667px; padding-top: 2.6666666666666666666666666667px; padding-bottom: 2.6666666666666666666666666667px; padding-left: 2.6666666666666666666666666667px; padding-right: 2.6666666666666666666666666667px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; background-color: #999999"&gt;
&lt;p style="text-align: center"&gt;財務影響&lt;/p&gt;
&lt;/td&gt;
