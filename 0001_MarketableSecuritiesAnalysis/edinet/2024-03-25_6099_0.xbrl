  <jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E30929-000TakagiNobuyukiMember">1953-02-25</jpcrp_cor:DateOfBirthInformationAboutDirectorsAndCorporateAuditors>
