&lt;/div&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;line-height:10pt;font-size:10pt;"&gt; &lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;padding-left:27pt;line-height:14pt;"&gt;(担保付債務)&lt;/p&gt;
&lt;div class="tbld" style="text-align:left;margin-left:30.1pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" class="align_left" style="border-collapse:collapse;border:solid 0pt #000000;width:438.1pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
&lt;col style="width:145.5pt;min-width:145.5pt;"/&gt;
&lt;col style="width:146.3pt;min-width:146.3pt;"/&gt;
