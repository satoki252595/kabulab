&lt;td style="vertical-align:middle;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;"&gt;&lt;b&gt;連結営業利益&lt;/b&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:middle;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;"&gt;&lt;b&gt;100億円以上&lt;/b&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
