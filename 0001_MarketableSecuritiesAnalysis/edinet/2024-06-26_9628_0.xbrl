&lt;p style="margin-left: 8px; margin-right: 6px; text-align: justify; line-height: 17.333333333333333333333333333px; text-justify: inter-ideograph"&gt;有形固定資産&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 133.33333333333333333333333333px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 8px; margin-right: 6px; text-align: right; line-height: 17.333333333333333333333333333px"&gt;21,398&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 133.33333333333333333333333333px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 8px; margin-right: 6px; text-align: right; line-height: 17.333333333333333333333333333px"&gt;21,455&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 103.46666666666666666666666667px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 8px; margin-right: 6px; text-align: justify; line-height: 17.333333333333333333333333333px; text-justify: inter-ideograph"&gt;無形固定資産&lt;/p&gt;
&lt;/td&gt;
