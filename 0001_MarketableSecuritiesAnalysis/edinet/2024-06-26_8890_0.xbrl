&lt;/tr&gt;
&lt;tr style="height: 1.33px"&gt;
&lt;td style="vertical-align: top; width: 58.666666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 5px; line-height: 11.333333333333333333333333333px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;2023年６月&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: top; width: 261.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 5px; line-height: 11.333333333333333333333333333px; text-align: justify; text-justify: inter-ideograph"&gt;
&lt;span style="font-size: 10px"&gt;当社 社外取締役（監査等委員）（現任）&lt;/span&gt;
&lt;/p&gt;
