  <jpcrp_cor:ClassesOfSharesEtcTextBlock contextRef="FilingDateInstant">
&lt;h4 class="smt_head3" style="padding-left:27pt;"&gt;【株式の種類等】　　&lt;/h4&gt;&lt;p class="smt_text4" style="orphans:0;widows:0;text-align:justify;padding-left:27pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:9pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;"&gt;&lt;span style="text-decoration:underline;"&gt;会社法第155条第３号&lt;span style="text-decoration:underline;"&gt;&lt;span style="text-decoration:underline;"&gt;、&lt;/span&gt;&lt;/span&gt;会社法第155条第７号及び会社法第155条第13号による普通株式の取得&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:0pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:15pt;font-size:15pt;"&gt; &lt;/p&gt;</jpcrp_cor:ClassesOfSharesEtcTextBlock>
  <jpcrp_cor:AcquisitionsByResolutionOfShareholdersMeetingTextBlock contextRef="FilingDateInstant">
