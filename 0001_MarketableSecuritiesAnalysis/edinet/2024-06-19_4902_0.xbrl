&lt;/td&gt;
&lt;td style="vertical-align: top; width: 448.53333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 18px; margin-right: 6px; text-align: justify; text-justify: inter-ideograph; text-indent: -12px"&gt;
&lt;span style="font-size: 14px"&gt;＜ヘルスケアユニット＞&lt;/span&gt;
