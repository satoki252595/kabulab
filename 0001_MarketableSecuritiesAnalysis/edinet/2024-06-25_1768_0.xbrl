&lt;p style="margin-left: 6px; margin-right: 6px; text-align: right; line-height: 15.333333333333333333333333333px"&gt;15,636,222&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
