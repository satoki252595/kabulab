&lt;p style="margin-left: 5px; line-height: 11.333333333333333333333333333px; margin-right: 3px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;セグメント&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 5px; line-height: 11.333333333333333333333333333px; margin-right: 3px; text-align: center"&gt;
