&lt;span style="font-size: 10px"&gt;1,500&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 2.6666666666666666666666666667px; margin-right: 1.3333333333333333333333333333px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;千t-CO&lt;sub&gt;2&lt;/sub&gt;&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 68.2px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 2.6666666666666666666666666667px; margin-right: 1.3333333333333333333333333333px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;－&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 68.2px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 2.6666666666666666666666666667px; margin-right: 1.3333333333333333333333333333px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;－&lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000; width: 75.066666666666666666666666667px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 2.6666666666666666666666666667px; margin-right: 1.3333333333333333333333333333px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;279&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 2.6666666666666666666666666667px; margin-right: 1.3333333333333333333333333333px; text-align: center"&gt;
