&lt;td style="vertical-align: top; width: 222.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 5px; line-height: 14.666666666666666666666666667px; margin-right: 5px; text-align: left"&gt;
&lt;span style="font-size: 10px"&gt;当社欧米リージョン統括本部長（現任）&lt;/span&gt;
