&lt;p style="line-height: 1.3333333333333333333333333333px; text-align: left"&gt; &lt;/p&gt;
&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 650.33333333333333333333333334px; margin-left: auto; margin-right: auto"&gt;
&lt;colgroup&gt;
