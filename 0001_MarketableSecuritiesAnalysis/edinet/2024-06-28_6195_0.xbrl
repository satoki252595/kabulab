  <jpcrp_cor:NotesPerShareInformationConsolidatedFinancialStatementsTextBlock contextRef="CurrentYearDuration">
&lt;h6&gt;（１株当たり情報）&lt;/h6&gt;
&lt;p style="margin-left: 0px; line-height: 18px; margin-right: 0px; text-align: left"&gt; &lt;/p&gt;
&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 648px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 276px"/&gt;
&lt;col style="width: 186px"/&gt;
&lt;col style="width: 186px"/&gt;
&lt;/colgroup&gt;
