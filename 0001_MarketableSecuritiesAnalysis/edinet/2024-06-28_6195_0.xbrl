  <jpcrp_cor:InformationAboutEmployeesTextBlock contextRef="FilingDateInstant">
&lt;h3&gt;５【従業員の状況】&lt;/h3&gt;
&lt;p style="margin-left: 24px; text-align: left"&gt;(1）連結会社の状況&lt;/p&gt;
&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 373.33333333333333333333333333px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 373.33333333333333333333333333px"/&gt;
&lt;/colgroup&gt;
&lt;tbody&gt;
&lt;tr style="height: 1.33px"&gt;
&lt;td style="border-left: 0px none #000000; border-top: 0px none #000000; border-right: 0px none #000000; border-bottom: 0px none #000000; width: 373.33333333333333333333333333px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 0px; margin-right: 0px; text-align: right"&gt;2024年３月31日現在&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;/div&gt;
&lt;p style="line-height: 1.3333333333333333333333333333px; text-align: left"&gt; &lt;/p&gt;
&lt;div&gt;
&lt;table cellpadding="0" cellspacing="0" style="table-layout: fixed; width: 373.33333333333333333333333334px"&gt;
&lt;colgroup&gt;
&lt;col style="width: 200px"/&gt;
&lt;col style="width: 106.66666666666666666666666667px"/&gt;
&lt;col style="width: 66.666666666666666666666666667px"/&gt;
&lt;/colgroup&gt;
