  <jpcrp_cor:InformationForEachProductOrServiceTextBlock contextRef="CurrentYearDuration">
&lt;p style="margin-left: 24px; line-height: 18px; margin-right: 0px; text-align: left"&gt;１．製品及びサービスごとの情報&lt;/p&gt;
&lt;p style="margin-left: 36px; line-height: 18px; margin-right: 0px; text-align: left; text-indent: 12px"&gt;単一の製品・サービスの区分の外部顧客への売上高が連結損益計算書の売上高の90％を超えるため、記載を省略しております。&lt;/p&gt;
</jpcrp_cor:InformationForEachProductOrServiceTextBlock>
  <jpcrp_cor:RevenuesFromExternalCustomersInformationForEachRegionTextBlock contextRef="CurrentYearDuration">
&lt;p style="margin-left: 30px; line-height: 18px; margin-right: 0px; text-align: left"&gt;(1)売上高&lt;/p&gt;
&lt;p style="margin-left: 36px; line-height: 18px; margin-right: 0px; text-align: left; text-indent: 12px"&gt;本邦の外部顧客への売上高が連結損益計算書の売上高の90％を超えるため、記載を省略しております。&lt;/p&gt;
</jpcrp_cor:RevenuesFromExternalCustomersInformationForEachRegionTextBlock>
  <jpcrp_cor:PropertyPlantAndEquipmentInformationForEachRegionTextBlock contextRef="CurrentYearDuration">
&lt;p style="margin-left: 30px; line-height: 18px; margin-right: 0px; text-align: left"&gt;(2）有形固定資産&lt;/p&gt;
&lt;p style="margin-left: 36px; line-height: 18px; margin-right: 0px; text-align: left; text-indent: 12px"&gt;本邦に所在している有形固定資産の金額が連結貸借対照表の有形固定資産の金額の90％を超えるため、記載を省略しております。&lt;/p&gt;
</jpcrp_cor:PropertyPlantAndEquipmentInformationForEachRegionTextBlock>
  <jpcrp_cor:InformationForEachOfMainCustomersTextBlock contextRef="CurrentYearDuration">
&lt;p style="margin-left: 24px; line-height: 18px; margin-right: 0px; text-align: left"&gt;３．主要な顧客ごとの情報&lt;/p&gt;
&lt;p style="margin-left: 36px; line-height: 18px; margin-right: 0px; text-align: left; text-indent: 12px"&gt;外部顧客への売上高のうち、連結損益計算書の売上高の10％以上を占める相手先がないため、記載を省略しております。&lt;/p&gt;
</jpcrp_cor:InformationForEachOfMainCustomersTextBlock>
  <jpcrp_cor:NotesRelatedPartiesConsolidatedFinancialStatementsTextBlock contextRef="CurrentYearDuration">
