  <jpcrp_cor:NameOfShareholderTreasurySharesEtc contextRef="CurrentYearInstant_Row1Member">㈱帝国ホテル</jpcrp_cor:NameOfShareholderTreasurySharesEtc>
  <jpcrp_cor:AddressOfShareholderTreasurySharesEtc contextRef="CurrentYearInstant_Row1Member">東京都千代田区内幸町１－１－１</jpcrp_cor:AddressOfShareholderTreasurySharesEtc>
  <jpcrp_cor:NameOfShareholderTreasurySharesEtc contextRef="CurrentYearInstant_Row2Member">㈱帝国ホテルキッチン</jpcrp_cor:NameOfShareholderTreasurySharesEtc>
