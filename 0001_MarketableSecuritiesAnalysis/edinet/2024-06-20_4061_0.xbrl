&lt;col style="width:110pt;min-width:110pt;"/&gt;
&lt;col style="width:110pt;min-width:110pt;"/&gt;
&lt;col style="width:110pt;min-width:110pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:11.9pt;min-height:11.9pt;"&gt;
