&lt;tr style="height: 40px"&gt;
&lt;td style="vertical-align: middle; width: 248px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;
&lt;span style="font-size: 12px"&gt; &lt;/span&gt;
&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 200px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; margin-top: 2.6666666666666666666666666667px; text-align: center"&gt;前連結会計年度&lt;/p&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; margin-right: 12px; text-align: center"&gt;（自　2022年４月１日&lt;/p&gt;
&lt;p style="margin-left: 12px; line-height: 13.333333333333333333333333333px; margin-bottom: 2.6666666666666666666666666667px; text-align: center"&gt;至　2023年３月31日）&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 200px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; margin-top: 2.6666666666666666666666666667px; text-align: center"&gt;当連結会計年度&lt;/p&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; margin-right: 12px; text-align: center"&gt;（自　2023年４月１日&lt;/p&gt;
&lt;p style="margin-left: 12px; line-height: 13.333333333333333333333333333px; margin-bottom: 2.6666666666666666666666666667px; text-align: center"&gt;至　2024年３月31日）&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/thead&gt;
&lt;tbody&gt;
&lt;tr style="height: 22.67px"&gt;
&lt;td style="vertical-align: middle; width: 248px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 13.333333333333333333333333333px; margin-right: 18px; text-align: left"&gt;期首残高&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 200px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-right: 26.666666666666666666666666667px; margin-top: 2.6666666666666666666666666667px; text-align: right"&gt;509百万円&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 200px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-right: 26.666666666666666666666666667px; margin-top: 2.6666666666666666666666666667px; text-align: right"&gt;516百万円&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
