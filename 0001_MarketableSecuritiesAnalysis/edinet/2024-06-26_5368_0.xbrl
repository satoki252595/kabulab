&lt;col style="width:68.1pt;min-width:68.1pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:9.8pt;min-height:9.8pt;"&gt;
&lt;td style="vertical-align:middle;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblR" style="orphans:0;widows:0;padding-right:9pt;"&gt; &lt;/p&gt;
&lt;/td&gt;
