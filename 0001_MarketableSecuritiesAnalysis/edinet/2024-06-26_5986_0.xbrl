&lt;col style="width:382.5pt;min-width:382.5pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr style="height:36pt;min-height:36pt;"&gt;
&lt;td style="vertical-align:top;border-top-color:#a9a9a9;border-bottom-color:#a9a9a9;border-left-color:#a9a9a9;border-right-color:#a9a9a9;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:0pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;letter-spacing:0.0pt;line-height:13pt;"&gt;1943年５月&lt;/p&gt;
&lt;/td&gt;
