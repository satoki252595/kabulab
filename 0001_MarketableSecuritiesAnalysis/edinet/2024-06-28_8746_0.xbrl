&lt;tr style="height: 40.27px"&gt;
&lt;td style="vertical-align: middle; width: 66.666666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 2px solid #000000; border-top: 2px solid #000000; border-right: 1px solid #000000; border-bottom: 2px solid #000000; background-color: #FFFFFF"&gt;
&lt;p style="line-height: 13.333333333333333333333333333px; text-align: center"&gt;
&lt;span style="font-size: 10px"&gt;役職名&lt;/span&gt;
&lt;/p&gt;
