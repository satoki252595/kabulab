&lt;p style="margin-left: 0px; margin-right: 6px; text-align: left"&gt;流動資産&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-left: 0px none ; border-top: 0px none #000000; border-right: 0px none #000000; border-bottom: 0px none ; width: 112px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: left"&gt;　4,480,209千円&lt;/p&gt;
