&lt;p style="margin-right: 24px; text-align: right"&gt;495円88銭&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 186px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 2px solid #000000; border-bottom: 1px solid #000000"&gt;
