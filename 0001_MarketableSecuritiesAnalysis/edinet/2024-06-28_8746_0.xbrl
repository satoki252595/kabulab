&lt;td style="vertical-align: middle; width: 40px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 2px solid #000000; border-right: 1px solid #000000; border-bottom: 2px solid #000000; background-color: #FFFFFF"&gt;
