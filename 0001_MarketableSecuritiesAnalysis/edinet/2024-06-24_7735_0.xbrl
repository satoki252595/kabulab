&lt;td style="vertical-align: top; width: 79.33333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 0px none ; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 5px; line-height: 17.333333333333333333333333333px; margin-right: 5px; text-align: left"&gt;
