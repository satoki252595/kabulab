&lt;p style="margin-left: 1.3333333333333333333333333333px; line-height: 13.333333333333333333333333333px; margin-right: 1.3333333333333333333333333333px; text-align: justify; text-justify: inter-ideograph"&gt;：&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 181px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 1.3333333333333333333333333333px; line-height: 13.333333333333333333333333333px; margin-right: 6.0666666666666666666666666667px; text-align: justify; text-justify: inter-ideograph"&gt;通算 19%以上&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 18.53px"&gt;
&lt;td style="vertical-align: middle; width: 112px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 3.3333333333333333333333333333px; line-height: 13.333333333333333333333333333px; margin-right: 6.0666666666666666666666666667px; text-align: justify; text-justify: inter-ideograph"&gt;・ROIC&lt;/p&gt;
