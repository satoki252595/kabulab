&lt;tr style="height: 25px"&gt;
&lt;td colspan="9" style="vertical-align: middle; width: 648px; padding-top: 1px; padding-bottom: 0px; padding-left: 1px; padding-right: 1px; border-left: 0px none ; border-top: 0px none ; border-right: 0px none ; border-bottom: 1px solid #000000; background-color: #FFFFFF"&gt;
&lt;p style="line-height: 17.333333333333333333333333333px; text-align: left"&gt;
