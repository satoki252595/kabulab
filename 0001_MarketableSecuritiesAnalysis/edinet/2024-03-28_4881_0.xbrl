&lt;p style="margin-left: 6px; line-height: 13.333333333333333333333333333px; text-align: left"&gt;局所療法&lt;/p&gt;
&lt;p style="margin-left: 6px; line-height: 13.333333333333333333333333333px; text-align: left"&gt; &lt;/p&gt;
&lt;p style="margin-left: 6px; line-height: 13.333333333333333333333333333px; text-align: left"&gt; &lt;/p&gt;
&lt;p style="margin-left: 6px; line-height: 13.333333333333333333333333333px; text-align: left"&gt; &lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 186.66666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-left: 6px; line-height: 13.333333333333333333333333333px; margin-right: 6px; text-align: left"&gt;ビタミンD3外用薬&lt;/p&gt;
&lt;p style="margin-left: 6px; line-height: 13.333333333333333333333333333px; margin-right: 6px; text-align: left"&gt;ステロイド外用薬&lt;/p&gt;
&lt;p style="margin-left: 6px; line-height: 13.333333333333333333333333333px; margin-right: 6px; text-align: left"&gt;アンスラリン外用薬&lt;/p&gt;
&lt;p style="margin-left: 6px; line-height: 13.333333333333333333333333333px; margin-right: 6px; text-align: left"&gt;レチノイド外用薬&lt;/p&gt;
