&lt;td style="vertical-align:top;border-top-color:#a9a9a9;border-bottom-color:#a9a9a9;border-left-color:#a9a9a9;border-right-color:#a9a9a9;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:13.6pt;line-height:14pt;"&gt;(1) 商品及び製品&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:13.6pt;line-height:3pt;font-size:3pt;"&gt; &lt;/p&gt;
