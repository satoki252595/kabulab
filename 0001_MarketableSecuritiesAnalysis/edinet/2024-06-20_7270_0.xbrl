  <jpcrp_cor:DescriptionIssuedSharesVotingRights contextRef="CurrentYearInstant_SharesWithRestrictedVotingRightsOtherMember" xsi:nil="true"/>
  <jpcrp_cor:DescriptionIssuedSharesVotingRights contextRef="CurrentYearInstant_OrdinarySharesTreasurySharesSharesWithFullVotingRightsTreasurySharesEtcMember">権利内容に何らの限定のない当社における標準となる株式</jpcrp_cor:DescriptionIssuedSharesVotingRights>
  <jpcrp_cor:DescriptionIssuedSharesVotingRights contextRef="CurrentYearInstant_OrdinarySharesReciprocalHoldingSharesWithFullVotingRightsTreasurySharesEtcMember">同上</jpcrp_cor:DescriptionIssuedSharesVotingRights>
  <jpcrp_cor:DescriptionIssuedSharesVotingRights contextRef="CurrentYearInstant_OrdinarySharesSharesWithFullVotingRightsOtherMember">同上</jpcrp_cor:DescriptionIssuedSharesVotingRights>
  <jpcrp_cor:DescriptionIssuedSharesVotingRights contextRef="CurrentYearInstant_OrdinarySharesSharesLessThanOneUnitMember">同上</jpcrp_cor:DescriptionIssuedSharesVotingRights>
  <jpcrp_cor:TreasurySharesEtcTextBlock contextRef="FilingDateInstant">
