  <jpcrp_cor:NotesRegardingGuaranteeObligationsTextBlock contextRef="CurrentYearInstant_NonConsolidatedMember">&lt;p class="smt_text6" style="orphans:0;widows:0;"&gt;　３　保証債務&lt;/p&gt;
