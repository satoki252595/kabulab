&lt;p style="margin-left: 6px; margin-right: 6px; text-align: left"&gt;東京都千代田区&lt;/p&gt;
&lt;/td&gt;
&lt;td rowspan="3" style="vertical-align: middle; width: 60px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 0px none ; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 1px solid #000000"&gt;
&lt;p style="margin-right: 6px; text-align: right"&gt;500&lt;/p&gt;
