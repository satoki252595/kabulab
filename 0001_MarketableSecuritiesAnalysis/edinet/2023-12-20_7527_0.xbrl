&lt;td style="vertical-align:top;border-top-color:#a9a9a9;border-left-style:solid;border-left-width:0.75pt;border-right-color:#a9a9a9;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:5.4pt;padding-right:6pt;line-height:11pt;font-size:7.5pt;"&gt;プライスウォーターハウス・ホノルル事務所&lt;/p&gt;
