&lt;td style="vertical-align: middle; width: 97.93333333333333333333333333px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: left"&gt;中国&lt;/p&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: left"&gt;香港特別行政区&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 95.4px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-right: 6px; text-align: right"&gt;10百万香港ドル&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 112.8px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: left"&gt;アパレル関連事業&lt;/p&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: left"&gt;衣料品等の小売&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 80.6px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 0px none ; border-bottom: 0px none "&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: right"&gt;100.0％&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align: middle; width: 97.46666666666666666666666667px; padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px; border-left: 1px solid #000000; border-top: 1px solid #000000; border-right: 1px solid #000000; border-bottom: 0px none "&gt;
