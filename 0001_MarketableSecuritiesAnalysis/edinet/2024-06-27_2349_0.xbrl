  <jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E05322-000KomoriKouichiMember">小森　孝一</jpcrp_cor:NameInformationAboutDirectorsAndCorporateAuditors>
