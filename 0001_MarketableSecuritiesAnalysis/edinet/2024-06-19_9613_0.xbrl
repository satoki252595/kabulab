&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;text-align:center;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;line-height:10.0pt;font-size:9pt;"&gt;前事業年度&lt;br/&gt;(2023年3月31日現在)&lt;/p&gt;
&lt;/td&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-bottom-style:solid;border-bottom-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblC" style="orphans:0;widows:0;text-align:center;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;line-height:10.0pt;font-size:9pt;"&gt;当事業年度&lt;br/&gt;(2024年3月31日現在)&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height:14.3pt;min-height:14.3pt;"&gt;
