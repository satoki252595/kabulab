&lt;/div&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;"&gt; &lt;/p&gt;&lt;p class="smt_text3" style="orphans:0;widows:0;font-size:7.5pt;"&gt;（※）配当性向：配当総額／当社株主に帰属する当期利益&lt;/p&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;"&gt; &lt;/p&gt;</jpcrp_cor:DividendPolicyTextBlock>
  <jpcrp_cor:DateOfResolutionDividendsOfSurplus contextRef="FilingDateInstant_Row1Member">2023-11-06</jpcrp_cor:DateOfResolutionDividendsOfSurplus>
