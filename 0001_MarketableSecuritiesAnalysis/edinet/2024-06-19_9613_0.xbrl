  <jpcrp_cor:PlannedAdditionsRetirementsEtcOfFacilitiesTextBlock contextRef="FilingDateInstant">
&lt;h3 class="smt_head2"&gt;3 【設備の新設、除却等の計画】&lt;/h3&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;text-align:justify;padding-left:0pt;padding-right:0pt;margin-top:0pt;margin-bottom:0pt;text-indent:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;letter-spacing:0pt;line-height:3pt;"&gt;　&lt;/p&gt;
