&lt;td colspan="9" style="vertical-align:bottom;border-top-color:#000000;border-bottom-color:#000000;border-left-color:#000000;border-right-color:#000000;overflow:hidden;" valign="bottom"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:right;padding-left:0pt;padding-right:0pt;margin-bottom:0.0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;line-height:10pt;font-size:9pt;"&gt;&lt;span&gt;2023年７月31日&lt;/span&gt;現在&lt;/p&gt;
