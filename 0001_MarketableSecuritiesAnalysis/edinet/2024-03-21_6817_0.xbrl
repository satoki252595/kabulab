&lt;colgroup&gt;
&lt;col style="width: 172px"/&gt;
&lt;col style="width: 156.33333333333333333333333333px"/&gt;
&lt;col style="width: 171.66666666666666666666666667px"/&gt;
&lt;col style="width: 148px"/&gt;
&lt;/colgroup&gt;
