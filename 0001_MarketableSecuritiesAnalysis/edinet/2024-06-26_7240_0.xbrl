  <jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock contextRef="FilingDateInstant_jpcrp030000-asr_E02176-000TsuruMasaoMember">
&lt;p style="margin-left: 65px; line-height: 15px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;2005年４月　当社入社&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 15px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;2017年４月　執行役員&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 15px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;2020年４月　常務執行役員&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 15px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;2020年４月　事業推進本部長&lt;/span&gt;
