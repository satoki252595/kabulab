&lt;p style="margin-left: 65px; line-height: 15px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;2024年６月　取締役就任（監査等委員）&lt;/span&gt;
&lt;/p&gt;
&lt;p style="margin-left: 65px; line-height: 15px; text-align: left; text-indent: -60px"&gt;
&lt;span style="font-size: 10px"&gt;　　　　　　（現任）&lt;/span&gt;
&lt;/p&gt;
</jpcrp_cor:CareerSummaryInformationAboutDirectorsAndCorporateAuditorsTextBlock>
  <jpcrp_cor:TermOfOfficeInformationAboutDirectorsAndCorporateAuditors contextRef="FilingDateInstant_jpcrp030000-asr_E02176-000ShimadaNaokiMember">（注）５</jpcrp_cor:TermOfOfficeInformationAboutDirectorsAndCorporateAuditors>
