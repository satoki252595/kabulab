&lt;col style="width:175.5pt;min-width:175.5pt;"/&gt;
&lt;col style="width:136.5pt;min-width:136.5pt;"/&gt;
&lt;col style="width:138pt;min-width:138pt;"/&gt;
&lt;/colgroup&gt;
