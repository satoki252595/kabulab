  <jpcrp_cor:NotesValuationDifferenceOnAvailableForSaleSecuritiesConsolidatedFinancialStatementsTextBlock contextRef="CurrentYearDuration">&lt;p style="page-break-before:always; line-height:0.75pt; width:100%; font-size:0.75pt;"&gt; &lt;/p&gt;
