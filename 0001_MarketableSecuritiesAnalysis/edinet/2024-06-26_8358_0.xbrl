&lt;/table&gt;&lt;p style="clear:both; line-height:0.75pt; width:100%; font-size:0.75pt;"&gt; &lt;/p&gt;
&lt;/div&gt;&lt;p class="smt_text6" style="orphans:0;widows:0;line-height:13pt;"&gt;　&lt;/p&gt;</jpcrp_cor:NotesRegardingAccumulatedDepreciationOfPropertyPlantAndEquipmentTextBlock>
  <jpcrp_cor:NotesRegardingAmountsOfReductionEntryOfPropertyPlantAndEquipmentTextBlock contextRef="CurrentYearInstant">&lt;p class="smt_text4" style="orphans:0;widows:0;padding-left:0pt;text-indent:0pt;"&gt;※８  有形固定資産の圧縮記帳額&lt;/p&gt;
&lt;div class="tbld" style="text-align:left;margin-left:17.9pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" class="align_left" style="border-collapse:collapse;border:solid 0pt #000000;width:450.0pt;table-layout:fixed;"&gt;
