&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblR" style="orphans:0;widows:0;padding-right:48.5pt;line-height:11pt;"&gt;7,036百万円&lt;/p&gt;
&lt;/td&gt;
