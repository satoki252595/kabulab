&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:left;padding-left:5.0pt;padding-right:5.0pt;line-height:15pt;font-size:10.5pt;"&gt;&lt;span style="font-size:7.5pt;"&gt;自律的なキャリア形成への支援&lt;/span&gt;&lt;/p&gt;
