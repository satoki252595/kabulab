  <jpcrp_cor:NotesRegardingSharesAndBondsEtcOfUnconsolidatedSubsidiariesAndAssociatesTextBlock contextRef="CurrentYearInstant">&lt;p class="smt_text1" style="orphans:0;widows:0;padding-left:9pt;text-indent:0pt;"&gt;※２　非連結子会社及び関連会社に対するものは、次のとおりであります。&lt;/p&gt;
&lt;div class="tbld" style="margin-left:18pt;margin-right:0pt;margin-top:0pt;margin-bottom:0pt;"&gt;
&lt;table cellpadding="0" cellspacing="0" style="border-collapse:collapse;border:solid 0pt #000000;width:466pt;table-layout:fixed;"&gt;
&lt;colgroup&gt;
&lt;col style="width:144pt;min-width:144pt;"/&gt;
&lt;col style="width:116pt;min-width:116pt;"/&gt;
