&lt;col style="width:176.3pt;min-width:176.3pt;"/&gt;
&lt;col style="width:46.2pt;min-width:46.2pt;"/&gt;
&lt;col style="width:47.2pt;min-width:47.2pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr&gt;
&lt;td colspan="5" rowspan="2" style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:5.4pt;padding-right:5.4pt;line-height:10pt;"&gt;&lt;span style="font-size:7.5pt;"&gt;リスク・機会&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td colspan="2" style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:5.4pt;padding-right:5.4pt;line-height:10pt;"&gt;&lt;span style="font-size:7.5pt;"&gt;事業及び財務への&lt;/span&gt;&lt;/p&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:5.4pt;padding-right:5.4pt;line-height:10pt;"&gt;&lt;span style="font-size:7.5pt;"&gt;影響有無&lt;/span&gt;&lt;/p&gt;
