&lt;col style="width:63.8pt;min-width:63.8pt;"/&gt;
&lt;col style="width:177.2pt;min-width:177.2pt;"/&gt;
&lt;/colgroup&gt;
&lt;tr&gt;
&lt;td colspan="2" style="vertical-align:top;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="top"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;text-align:center;padding-left:5.4pt;padding-right:5.4pt;line-height:10pt;"&gt;&lt;span style="font-size:7.5pt;"&gt;選定シナリオ&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
