&lt;tr style="height:24.1pt;min-height:24.1pt;"&gt;
&lt;td style="vertical-align:middle;border-top-style:solid;border-top-width:0.75pt;border-top-color:#000000;border-bottom-style:solid;border-bottom-width:0.75pt;border-bottom-color:#000000;border-left-style:solid;border-left-width:0.75pt;border-left-color:#000000;border-right-style:solid;border-right-width:0.75pt;border-right-color:#000000;overflow:hidden;" valign="middle"&gt;&lt;p class="smt_tblL" style="orphans:0;widows:0;padding-left:4.5pt;padding-right:4.5pt;margin-top:0pt;margin-bottom:0pt;font-family:&amp;apos;ＭＳ 明朝&amp;apos;;"&gt;&lt;span style="font-size:9pt;"&gt;取締役&lt;/span&gt;&lt;br/&gt;&lt;span style="font-size:9pt;"&gt;(社外取締役を除く。)&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
